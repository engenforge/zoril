// 04: All control flow constructs including expression-oriented if and match.
// expected exit code: 54
// Demonstrates: if/else/else if, while, for..in, break, continue, expression blocks.

fn classify(n: i32) -> i32 {
    // if as an expression — the last expression in each block is the value
    let category = if n < 0 {
        0
    } else if n == 0 {
        1
    } else if n < 100 {
        2
    } else {
        3
    };
    return category;
}

fn sum_range(start: i32, end: i32) -> i32 {
    let mut total = 0;
    for i in start..end {
        total += i;
    }
    return total;
}

fn find_first_even(limit: i32) -> i32 {
    let mut i = 1;
    while i < limit {
        if i % 2 == 0 {
            break;
        }
        i += 1;
    }
    return i;
}

fn count_odd(limit: i32) -> i32 {
    let mut count = 0;
    for i in 0..limit {
        if i % 2 == 0 {
            continue;
        }
        count += 1;
    }
    return count;
}

#[must_use]
fn must_use_example() -> i32 {
    return 42;
}

fn main() -> i32 {
    // Block expressions: the last expression is the block's value
    let result = {
        let a = classify(50);
        let b = sum_range(0, 10);
        // legitimate use of must_use function
        let c = must_use_example();

        // explicitly discarding a must_use result via wildcard
        let _ = must_use_example();

        a + b + c - 42
    };

    let even = find_first_even(20);
    let odds = count_odd(10);

    return result + even + odds;
}
