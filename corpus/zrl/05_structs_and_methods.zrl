// expected exit code: 52
// 05: Structs with methods, field access, and trailing commas.
// Demonstrates: struct, impl, self, method calls, trailing commas, mutable fields.

struct Vec2 {
    x: f64,
    y: f64,
}

impl Vec2 {
    #[must_use]
    fn new(x: f64, y: f64) -> Vec2 {
        return Vec2 { x: x, y: y };
    }

    fn magnitude_squared(self: &Vec2) -> f64 {
        return self.x * self.x + self.y * self.y;
    }

    #[must_use]
    fn add(self: &Vec2, other: &Vec2) -> Vec2 {
        return Vec2 {
            x: self.x + other.x,
            y: self.y + other.y,
        };
    }

    fn scale(self: &Vec2, factor: f64) -> Vec2 {
        return Vec2 {
            x: self.x * factor,
            y: self.y * factor,
        };
    }
}

fn dot(a: &Vec2, b: &Vec2) -> f64 {
    return a.x * b.x + a.y * b.y;
}

fn main() -> i32 {
    let a = Vec2.new(3.0, 4.0);
    let b = Vec2 { x: 1.0, y: 2.0 };

    let sum = a.add(&b);
    let p_sum = &sum;
    // Test parenthesized pointer dereference method call
    let mag2 = (*p_sum).magnitude_squared();
    
    let scaled = a.scale(2.0);
    let d = dot(&a, &b);

    return mag2 as i32;
}
