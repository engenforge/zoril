// 16: Defer for cleanup actions — LIFO execution order at scope exit.
// expected exit code: 107
// Demonstrates: defer, cleanup ordering, resource management pattern.

static mut cleanup_order: i32 = 0;

fn record(step: i32) {
    cleanup_order = cleanup_order * 10 + step;
}

fn demonstrate_order() -> i32 {
    defer record(1);  // executed third (LIFO)
    defer record(2);  // executed second
    defer record(3);  // executed first

    // Normal code runs before any defers
    record(0);

    return 0;
    // At scope exit: record(3), record(2), record(1)
    // cleanup_order = 0321
}

fn guarded_operation() -> i32 {
    let mut acquired = false;

    // Simulate resource acquisition
    acquired = true;
    defer {
        // This always runs, even on early return
        acquired = false;
    };

    // Do work that might return early
    if acquired {
        return 42;
    }

    return 0;
    // defer block runs after return value is evaluated
}

fn main() -> i32 {
    demonstrate_order();
    let result = guarded_operation();
    return result + cleanup_order;
}
