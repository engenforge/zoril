// 27: Direct syscall interface for Linux I/O without libc.
// Demonstrates: @syscall, typed wrappers, string operations, exit codes.

const STDOUT: u64 = 1;
const STDERR: u64 = 2;

// POSIX x86_64 syscall numbers (Linux/OpenBSD compatible where applicable)
const SYS_WRITE: u64 = 1;
const SYS_EXIT: u64 = 60;

fn write(fd: u64, msg: &[u8]) -> i64 {
    return unsafe { @syscall(SYS_WRITE, fd, msg.ptr, msg.len as u64) };
}

fn exit(code: u64) {
    unsafe { @syscall(SYS_EXIT, code) };
}

fn write_line(fd: u64, msg: &[u8]) {
    write(fd, msg);
    write(fd, "\n");
}

fn write_i32(fd: u64, n: i32) {
    // Convert a small positive integer to its decimal string
    if n == 0 {
        write(fd, "0");
        return;
    }

    let mut buf: [u8; 10] = [
        0 as u8,
        0 as u8,
        0 as u8,
        0 as u8,
        0 as u8,
        0 as u8,
        0 as u8,
        0 as u8,
        0 as u8,
        0 as u8
    ];
    let mut pos = 9;
    let mut val = n;

    while val > 0 {
        buf[pos] = (val % 10) as u8 + '0';
        val /= 10;
        pos -= 1;
    }

    // Write only the digits (skip leading zeros)
    for i in (pos + 1)..10 {
        let digit = [buf[i]];
        write(fd, &digit);
    }
}

fn main() {
    write_line(STDOUT, "=== Zoril Syscall Demo ===");
    write(STDOUT, "The answer is: ");
    write_i32(STDOUT, 42);
    write(STDOUT, "\n");
    exit(0);
}
