// expected exit code: 0
// 39: Range patterns in match expressions
// Demonstrates: inclusive ranges (..=), exclusive ranges (..), char ranges, combined with OR patterns.

fn classify_score(score: i32) -> i32 {
    return match score {
        90..=100 => 4, // A
        80..90   => 3, // B
        70..80   => 2, // C
        60..70   => 1, // D
        _        => 0, // F
    };
}

fn is_alphanumeric(c: u8) -> bool {
    return match c {
        'a'..='z' | 'A'..='Z' => true,
        '0'..='9' => true,
        _ => false,
    };
}

fn main() -> i32 {
    if classify_score(95) != 4 { return 1; }
    if classify_score(90) != 4 { return 2; }
    if classify_score(89) != 3 { return 3; }
    if classify_score(80) != 3 { return 4; }
    if classify_score(75) != 2 { return 5; }
    if classify_score(50) != 0 { return 6; }

    if !is_alphanumeric('g' as u8) { return 10; }
    if !is_alphanumeric('B' as u8) { return 11; }
    if !is_alphanumeric('5' as u8) { return 12; }
    if is_alphanumeric('!' as u8)  { return 13; }

    return 0;
}
