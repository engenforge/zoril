// Filesystem operations, directory listing, and file locking
//
//
// Linux syscall wrappers a build driver needs and file.zrl does not provide: unlink, rename,
// directory listing, wall-clock time, the running executable's directory, and PATH lookup.
//
// Every function that allocates has two entry points, as the collections do: the public one
// takes `&Arena`, so the value it returns is tied to the arena by the borrow checker, and the
// `_raw` one takes the raw header for compiler and tool internals that plumb `*mut ArenaHeader`.

import "core.zrl";
import "mem.zrl";
import "mem_raw.zrl";
import "vec.zrl";
import "io.zrl";
import "file.zrl";
use file::read_file_raw;
import "os/linux.zrl" as os_linux;
import "os/unix.zrl" as os_unix;
use io::{Error, Fd, close};
use os_linux::{O_CLOEXEC, O_CREAT, O_DIRECTORY, O_RDONLY, O_RDWR};
use os_unix::{LOCK_EX, LOCK_UN};
use mem::{Arena, arena_raw};
use mem_raw::{ArenaHeader, heap_alloc, heap_free, memcpy, zoril_allocator_alloc};
use vec::Vec;

fn has_interior_nul(s: [u8]) -> bool {
    let mut len = s.len;
    if len > 0 as usize && s[len - 1 as usize] == 0 as u8 {
        len = len - 1 as usize;
    }
    let mut i = 0 as usize;
    while i < len {
        if s[i] == 0 as u8 {
            return true;
        }
        i = i + 1 as usize;
    }
    return false;
}

// Internal: a NUL-terminated copy of `s` in the arena.
unsafe fn fsys_cstr(s: [u8], arena: *mut ArenaHeader) -> [u8] {
    let p = zoril_allocator_alloc(arena, (s.len + 1) as u64) as *mut u8;
    let mut dst = @slice(p, s.len + 1);
    let mut i = 0 as usize;
    while i < s.len {
        dst[i] = s[i];
        i = i + 1;
    }
    dst[s.len] = 0;
    return dst;
}

// Internal: a NUL-terminated copy of `s` on the heap for acquire_file_lock.
unsafe fn fsys_cstr_heap(s: [u8]) -> *mut u8 {
    let p = heap_alloc((s.len + 1) as u64);
    memcpy(p, s.ptr, s.len);
    *((p as usize + s.len) as *mut u8) = 0;
    return p;
}

// Deletes the filesystem entry at path.
pub fn unlink_path(path: [u8], a: &Arena) -> Result<(), Error> {
    // SAFETY: `a` is the live, borrowed arena the result is tied to, which is the raw entry
    // point's contract.
    return unsafe { unlink_path_raw(path, arena_raw(a)) };
}

// Deletes the filesystem entry at path using a raw arena.
//
// CALLER OBLIGATION: arena must be valid and path must contain no interior NUL bytes.
//
// INTERNAL: unsafe raw-pointer escape hatch for bootstrap compiler and internal modules
pub unsafe fn unlink_path_raw(path: [u8], arena: *mut ArenaHeader) -> Result<(), Error> {
    if has_interior_nul(path) {
        return Result.Err(Error.from_linux_errno(22));
    }
    let c = fsys_cstr(path, arena);
    let ret = @syscall(87, c.ptr as u64) as i64;
    if ret < 0 {
        return Result.Err(Error.from_linux_errno((0 as i64 - ret) as i32));
    }
    return Result.Ok(());
}

// Renames or moves a filesystem entry from path from to path to.
pub fn rename_path(from: [u8], to: [u8], a: &Arena) -> Result<(), Error> {
    // SAFETY: `a` is the live, borrowed arena the result is tied to, which is the raw entry
    // point's contract.
    return unsafe { rename_path_raw(from, to, arena_raw(a)) };
}

// Renames a filesystem entry using a raw arena.
//
// CALLER OBLIGATION: arena must be valid and paths must contain no interior NUL bytes.
//
// INTERNAL: unsafe raw-pointer escape hatch for bootstrap compiler and internal modules
pub unsafe fn rename_path_raw(from: [u8], to: [u8], arena: *mut ArenaHeader) -> Result<(), Error> {
    if has_interior_nul(from) || has_interior_nul(to) {
        return Result.Err(Error.from_linux_errno(22));
    }
    let a = fsys_cstr(from, arena);
    let b = fsys_cstr(to, arena);
    let ret = @syscall(82, a.ptr as u64, b.ptr as u64) as i64;
    if ret < 0 {
        return Result.Err(Error.from_linux_errno((0 as i64 - ret) as i32));
    }
    return Result.Ok(());
}

// Names (without "." and "..") of the entries in a directory, or an error if it cannot be read.
#[borrows(a)]
pub fn list_dir(path: [u8], a: &Arena) -> Result<Vec<[u8]>, Error> {
    // SAFETY: `a` is the live, borrowed arena the result is tied to, which is the raw entry
    // point's contract.
    let mut res = unsafe { list_dir_raw(path, arena_raw(a)) };
    match res {
        Result.Ok(mut names) => {
            names.anchor = Option.Some(a);
            return Result.Ok(names);
        },
        Result.Err(e) => {
            return Result.Err(e);
        },
    }
}

// Lists entries in a directory using a raw arena.
//
// CALLER OBLIGATION: arena must be valid and path must contain no interior NUL bytes.
//
// INTERNAL: unsafe raw-pointer escape hatch for bootstrap compiler and internal modules
pub unsafe fn list_dir_raw(path: [u8], arena: *mut ArenaHeader) -> Result<Vec<[u8]>, Error> {
    if has_interior_nul(path) {
        return Result.Err(Error.from_linux_errno(22));
    }
    let c = fsys_cstr(path, arena);
    let fd = @syscall(2, c.ptr as u64, (O_RDONLY | O_DIRECTORY) as u64, 0 as u64) as i64;
    if fd < 0 {
        return Result.Err(Error.from_linux_errno((0 as i64 - fd) as i32));
    }
    defer close(Fd.from_unix_raw(fd as i32));
    let cap = 32768 as usize;
    let p = heap_alloc(cap as u64);
    defer heap_free(p as *u8, cap as u64);
    let buf = @slice(p, cap);
    let mut names = Vec::<[u8]>.new_in_raw(arena);
    while true {
        let n = @syscall(217, fd as u64, p as u64, cap as u64) as i64; // getdents64
        if n < 0 {
            return Result.Err(Error.from_linux_errno((0 as i64 - n) as i32));
        }
        if n == 0 { break; }
        let mut off = 0 as usize;
        while off < n as usize {
            let reclen = (buf[off + 16] as usize) | ((buf[off + 17] as usize) << 8);
            let name_start = off + 19;
            let mut name_end = name_start;
            while name_end < off + reclen && buf[name_end] != 0 {
                name_end = name_end + 1;
            }
            let name_len = name_end - name_start;
            let dot = name_len == 1 && buf[name_start] == '.' as u8;
            let dotdot = name_len == 2
                && buf[name_start] == '.' as u8
                && buf[name_start + 1] == '.' as u8;
            if !dot && !dotdot {
                let name_p = zoril_allocator_alloc(arena, name_len as u64) as *mut u8;
                memcpy(name_p, (p as usize + name_start) as *u8, name_len as u64);
                let name = @slice(name_p, name_len);
                names.push(name);
            }
            off = off + reclen;
        }
    }
    return Result.Ok(names);
}

// Nanoseconds since the Unix epoch (CLOCK_REALTIME), comparable with file mtimes.
pub fn realtime_ns() -> i64 {
    // SAFETY: `@alloca` hands back one uninitialized `[i64; 2]` slot in this frame and the
    // clock_gettime syscall (228) fills it, so nothing reads it before it is written.
    let ts = unsafe { @alloca<[i64; 2]>(1) };
    // SAFETY: `ts` points at the two-word slot above, which the kernel writes.
    let r = unsafe { @syscall(228, 0 as u64, ts as u64) } as i64;
    if r != 0 { return 0; }
    let sec = ts[0 as usize];
    let nsec = ts[1 as usize];
    return sec * 1000000000 + nsec;
}

// Returns true if the file at path exists and has executable permissions for the current user.
pub fn path_is_executable(path: [u8], a: &Arena) -> bool {
    // SAFETY: `a` is the live, borrowed arena the result is tied to, which is the raw entry
    // point's contract.
    return unsafe { path_is_executable_raw(path, arena_raw(a)) };
}

// Checks if path is executable using a raw arena.
//
// CALLER OBLIGATION: arena must be valid and path must contain no interior NUL bytes.
//
// INTERNAL: unsafe raw-pointer escape hatch for bootstrap compiler and internal modules
pub unsafe fn path_is_executable_raw(path: [u8], arena: *mut ArenaHeader) -> bool {
    if has_interior_nul(path) { return false; }
    let c = fsys_cstr(path, arena);
    return @syscall(21, c.ptr as u64, 1 as u64) as i64 == 0; // access(path, X_OK)
}

// Directory of the running executable ("" if it cannot be determined).
pub fn exe_dir(a: &Arena) -> [u8] {
    // SAFETY: `a` is the live, borrowed arena the result is tied to, which is the raw entry
    // point's contract.
    return unsafe { exe_dir_raw(arena_raw(a)) };
}

// Returns the directory containing the current executable.
//
// CALLER OBLIGATION: arena must be valid and initialized.
//
// INTERNAL: unsafe raw-pointer escape hatch for bootstrap compiler and internal modules
pub unsafe fn exe_dir_raw(arena: *mut ArenaHeader) -> [u8] {
    let link = fsys_cstr("/proc/self/exe", arena);
    let cap = 4096 as usize;
    let p = zoril_allocator_alloc(arena, cap as u64) as *mut u8;
    let n = @syscall(89, link.ptr as u64, p as u64, cap as u64) as i64; // readlink
    if n <= 0 { return ""; }
    let buf = @slice(p, n as usize);
    let mut last = 0 as usize;
    let mut found = false;
    let mut i = 0 as usize;
    while i < buf.len {
        if buf[i] == '/' as u8 { last = i; found = true; }
        i = i + 1;
    }
    if !found { return ""; }
    return subslice(buf, 0, last);
}

// Value of an environment variable, read from /proc/self/environ.
#[borrows(a)]
pub fn env_var(name: [u8], a: &Arena) -> Option<[u8]> {
    // SAFETY: `a` is the live, borrowed arena the result is tied to, which is the raw entry
    // point's contract.
    return unsafe { env_var_raw(name, arena_raw(a)) };
}

// Reads an environment variable using a raw arena.
//
// CALLER OBLIGATION: arena must be valid and name must contain no interior NUL bytes.
//
// INTERNAL: unsafe raw-pointer escape hatch for bootstrap compiler and internal modules
pub unsafe fn env_var_raw(name: [u8], arena: *mut ArenaHeader) -> Option<[u8]> {
    let res = read_file_raw("/proc/self/environ", arena);
    if res.is_err() { return Option.None; }
    let data = res.ok().unwrap();
    let mut start = 0 as usize;
    let mut i = 0 as usize;
    while i <= data.len {
        if i == data.len || data[i] == 0 {
            let entry = subslice(data, start, i - start);
            if entry.len > name.len
                && entry[name.len] == '=' as u8
                && subslice(entry, 0, name.len) == name {
                return Option.Some(subslice_from(entry, name.len + 1));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return Option.None;
}

// Resolves a bare command name by searching $PATH; names containing '/' are returned as given.
pub fn find_in_path(name: [u8], a: &Arena) -> Option<[u8]> {
    // SAFETY: `a` is the live, borrowed arena the result is tied to, which is the raw entry
    // point's contract.
    return unsafe { find_in_path_raw(name, arena_raw(a)) };
}

// Locates a binary in the system PATH using a raw arena.
//
// CALLER OBLIGATION: arena must be valid and name must contain no interior NUL bytes.
//
// INTERNAL: unsafe raw-pointer escape hatch for bootstrap compiler and internal modules
pub unsafe fn find_in_path_raw(name: [u8], arena: *mut ArenaHeader) -> Option<[u8]> {
    let mut i = 0 as usize;
    while i < name.len {
        if name[i] == '/' as u8 { return Option.Some(name); }
        i = i + 1;
    }
    let path_opt = env_var_raw("PATH", arena);
    if path_opt.is_none() { return Option.None; }
    let path = path_opt.unwrap();
    let mut start = 0 as usize;
    let mut j = 0 as usize;
    while j <= path.len {
        if j == path.len || path[j] == ':' as u8 {
            let dir = subslice(path, start, j - start);
            let mut cand = Vec::<u8>.new_in_raw(arena);
            if dir.len == 0 {
                cand.push('.' as u8);
            } else {
                let mut k = 0 as usize;
                while k < dir.len { cand.push(dir[k]); k = k + 1; }
            }
            cand.push('/' as u8);
            let mut k2 = 0 as usize;
            while k2 < name.len { cand.push(name[k2]); k2 = k2 + 1; }
            if path_is_executable_raw(cand.as_slice(), arena) {
                return Option.Some(cand.as_slice());
            }
            start = j + 1;
        }
        j = j + 1;
    }
    return Option.None;
}

// mkdir -p: create `path` and any missing parents (mode 0755).
pub fn make_dir_all(path: [u8], a: &Arena) -> Result<(), Error> {
    // SAFETY: `a` is the live, borrowed arena the result is tied to, which is the raw entry
    // point's contract.
    return unsafe { make_dir_all_raw(path, arena_raw(a)) };
}

// Recursively creates directories using a raw arena.
//
// CALLER OBLIGATION: arena must be valid and path must contain no interior NUL bytes.
//
// INTERNAL: unsafe raw-pointer escape hatch for bootstrap compiler and internal modules
pub unsafe fn make_dir_all_raw(path: [u8], arena: *mut ArenaHeader) -> Result<(), Error> {
    if has_interior_nul(path) {
        return Result.Err(Error.from_linux_errno(22));
    }
    let mut first_err: i32 = 0;
    let mut i = 0 as usize;
    while i <= path.len {
        if i == path.len || path[i] == '/' as u8 {
            if i > 0 {
                let c = fsys_cstr(subslice(path, 0, i), arena);
                let ret = @syscall(83, c.ptr as u64, 493 as u64) as i64;
                if ret < 0 {
                    let err = (0 as i64 - ret) as i32;
                    if err == 20 { // 20 is ENOTDIR
                        if first_err == 0 { first_err = err; }
                    } else if err != 17 { // 17 is EEXIST
                        // If it is already an existing directory, ignore the mkdir error (e.g. EROFS/EACCES on root/ancestor)
                        let check_fd = @syscall(
                            2,
                            c.ptr as u64,
                            (O_RDONLY | O_DIRECTORY) as u64,
                            0 as u64
                        ) as i64;
                        if check_fd >= 0 {
                            let _ = close(Fd.from_unix_raw(check_fd as i32));
                        } else if first_err == 0 {
                            first_err = err;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    let c_full = fsys_cstr(path, arena);
    let fd = @syscall(2, c_full.ptr as u64, (O_RDONLY | O_DIRECTORY) as u64, 0 as u64) as i64;
    if fd < 0 {
        let open_err = (0 as i64 - fd) as i32;
        let final_err = if first_err != 0 { first_err } else { open_err };
        return Result.Err(Error.from_linux_errno(final_err));
    }
    let _ = close(Fd.from_unix_raw(fd as i32));
    return Result.Ok(());
}

// Advisory file lock guard providing RAII unlocking on drop.
pub struct FileLock {
    fd: Fd,
}

impl FileLock {
    // Returns the file descriptor associated with this file lock.
    pub fn fd(self: &FileLock) -> Fd {
        return self.fd;
    }
}

impl Drop for FileLock {
    // Releases the advisory file lock.
    pub fn drop(self: FileLock) {
        if self.fd.unix_raw() >= 0 {
            // SAFETY: flock(73) with LOCK_UN on the owned file descriptor releases the lock.
            let _ = unsafe { @syscall(73, self.fd.unix_raw() as u64, LOCK_UN) };
            let _ = close(self.fd);
        }
    }
}

// Opens `path` (creating it if needed with mode 0644) and acquires an exclusive lock via flock.
// Returns a FileLock guard that unlocks and closes the descriptor on drop.
pub fn acquire_file_lock(path: [u8]) -> Result<FileLock, Error> {
    if has_interior_nul(path) {
        return Result.Err(Error.from_linux_errno(22));
    }
    // SAFETY: fsys_cstr_heap allocates on the heap and copies path bytes with a NUL terminator.
    let p = unsafe { fsys_cstr_heap(path) };
    // SAFETY: p was allocated by heap_alloc with size (path.len + 1) above.
    defer unsafe { heap_free(p, (path.len + 1) as u64) };
    // flags: O_RDWR | O_CREAT | O_CLOEXEC, mode: 0644 (420)
    // SAFETY: open(2) takes the valid NUL-terminated heap buffer p.
    let fd = unsafe {
        @syscall(2, p as u64, (O_RDWR | O_CREAT | O_CLOEXEC) as u64, 420 as u64)
    } as i64;
    if fd < 0 {
        return Result.Err(Error.from_linux_errno((0 as i64 - fd) as i32));
    }
    let mut lock_res = -4 as i64;
    while lock_res == -4 as i64 {
        // SAFETY: flock(73) takes the newly opened valid file descriptor fd; retries on EINTR.
        lock_res = unsafe { @syscall(73, fd as u64, LOCK_EX) } as i64;
    }
    if lock_res < 0 {
        let err = (0 as i64 - lock_res) as i32;
        // SAFETY: fd is the open descriptor returned above to be closed on failure.
        let _ = close(unsafe { Fd.from_unix_raw(fd as i32) });
        return Result.Err(Error.from_linux_errno(err));
    }
    // SAFETY: fd is the open, locked descriptor returned above.
    return Result.Ok(FileLock { fd: unsafe { Fd.from_unix_raw(fd as i32) } });
}
