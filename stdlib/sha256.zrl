// Cryptographic SHA-256 digest computation (Sha256)
//
//
// Pure safe Zoril implementation with zero unsafe markers.
// Provides both streaming (Sha256 struct: new, update, finalize)
// and one-shot (sha256, sha256_hex, sha256_hex_arr) APIs.

// Streaming cryptographic SHA-256 digest hasher.
pub struct Sha256 {
    pub state: [u32; 8],
    pub buffer: [u8; 64],
    pub buf_len: usize,
    pub total_len: u64,
    pub k: [u32; 64],
}

impl Sha256 {
    // Creates a new Sha256 hasher initialized to the standard FIPS 180-4 constants.
    pub fn new() -> Sha256 {
        let mut s = Sha256 {
            state: [
                0x6a09e667,
                0xbb67ae85,
                0x3c6ef372,
                0xa54ff53a,
                0x510e527f,
                0x9b05688c,
                0x1f83d9ab,
                0x5be0cd19,
            ],
            buffer: [0; 64],
            buf_len: 0,
            total_len: 0,
            k: [
                0x428a2f98,
                0x71374491,
                0xb5c0fbcf,
                0xe9b5dba5,
                0x3956c25b,
                0x59f111f1,
                0x923f82a4,
                0xab1c5ed5,
                0xd807aa98,
                0x12835b01,
                0x243185be,
                0x550c7dc3,
                0x72be5d74,
                0x80deb1fe,
                0x9bdc06a7,
                0xc19bf174,
                0xe49b69c1,
                0xefbe4786,
                0x0fc19dc6,
                0x240ca1cc,
                0x2de92c6f,
                0x4a7484aa,
                0x5cb0a9dc,
                0x76f988da,
                0x983e5152,
                0xa831c66d,
                0xb00327c8,
                0xbf597fc7,
                0xc6e00bf3,
                0xd5a79147,
                0x06ca6351,
                0x14292967,
                0x27b70a85,
                0x2e1b2138,
                0x4d2c6dfc,
                0x53380d13,
                0x650a7354,
                0x766a0abb,
                0x81c2c92e,
                0x92722c85,
                0xa2bfe8a1,
                0xa81a664b,
                0xc24b8b70,
                0xc76c51a3,
                0xd192e819,
                0xd6990624,
                0xf40e3585,
                0x106aa070,
                0x19a4c116,
                0x1e376c08,
                0x2748774c,
                0x34b0bcb5,
                0x391c0cb3,
                0x4ed8aa4a,
                0x5b9cca4f,
                0x682e6ff3,
                0x748f82ee,
                0x78a5636f,
                0x84c87814,
                0x8cc70208,
                0x90befffa,
                0xa4506ceb,
                0xbef9a3f7,
                0xc67178f2,
            ],
        };
        return s;
    }

    // Resets the hasher back to initial state for computing a new digest.
    pub fn reset(self: &mut Sha256) {
        self.state[0] = 0x6a09e667;
        self.state[1] = 0xbb67ae85;
        self.state[2] = 0x3c6ef372;
        self.state[3] = 0xa54ff53a;
        self.state[4] = 0x510e527f;
        self.state[5] = 0x9b05688c;
        self.state[6] = 0x1f83d9ab;
        self.state[7] = 0x5be0cd19;
        self.buf_len = 0;
        self.total_len = 0;
    }

    fn compress(self: &mut Sha256) {
        let mut w: [u32; 64] = [0; 64];
        let mut t = 0 as usize;
        while t < 16 {
            let idx = t * 4;
            let b0 = self.buffer[idx] as u32;
            let b1 = self.buffer[idx + 1] as u32;
            let b2 = self.buffer[idx + 2] as u32;
            let b3 = self.buffer[idx + 3] as u32;
            w[t] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
            t = t + 1;
        }

        while t < 64 {
            let w15 = w[t - 15];
            let g0 = ((w15 >> 7) | (w15 << 25)) ^ ((w15 >> 18) | (w15 << 14)) ^ (w15 >> 3);
            let w2 = w[t - 2];
            let g1 = ((w2 >> 17) | (w2 << 15)) ^ ((w2 >> 19) | (w2 << 13)) ^ (w2 >> 10);
            w[t] = g1 + w[t - 7] + g0 + w[t - 16];
            t = t + 1;
        }

        let mut a = self.state[0];
        let mut b = self.state[1];
        let mut c = self.state[2];
        let mut d = self.state[3];
        let mut e = self.state[4];
        let mut f = self.state[5];
        let mut g = self.state[6];
        let mut h = self.state[7];

        let mut i = 0 as usize;
        while i < 64 {
            let s1 = ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7));
            let ch = (e & f) ^ ((!e) & g);
            let t1 = h + s1 + ch + self.k[i] + w[i];
            let s0 = ((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10));
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = s0 + maj;

            h = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;

            i = i + 1;
        }

        self.state[0] = self.state[0] + a;
        self.state[1] = self.state[1] + b;
        self.state[2] = self.state[2] + c;
        self.state[3] = self.state[3] + d;
        self.state[4] = self.state[4] + e;
        self.state[5] = self.state[5] + f;
        self.state[6] = self.state[6] + g;
        self.state[7] = self.state[7] + h;
    }

    // Feeds a byte slice of data into the running SHA-256 state.
    pub fn update(self: &mut Sha256, data: [u8]) {
        self.total_len = self.total_len + (data.len as u64);
        let mut i = 0 as usize;
        while i < data.len {
            self.buffer[self.buf_len] = data[i];
            self.buf_len = self.buf_len + 1;
            if self.buf_len == 64 {
                self.compress();
                self.buf_len = 0;
            }
            i = i + 1;
        }
    }

    // Completes the hash computation and returns the 32-byte binary digest.
    pub fn finalize(self: &mut Sha256) -> [u8; 32] {
        self.buffer[self.buf_len] = 0x80;
        self.buf_len = self.buf_len + 1;

        if self.buf_len > 56 {
            while self.buf_len < 64 {
                self.buffer[self.buf_len] = 0;
                self.buf_len = self.buf_len + 1;
            }
            self.compress();
            self.buf_len = 0;
        }

        while self.buf_len < 56 {
            self.buffer[self.buf_len] = 0;
            self.buf_len = self.buf_len + 1;
        }

        let bit_len = self.total_len * 8;
        self.buffer[56] = ((bit_len >> 56) & 0xff) as u8;
        self.buffer[57] = ((bit_len >> 48) & 0xff) as u8;
        self.buffer[58] = ((bit_len >> 40) & 0xff) as u8;
        self.buffer[59] = ((bit_len >> 32) & 0xff) as u8;
        self.buffer[60] = ((bit_len >> 24) & 0xff) as u8;
        self.buffer[61] = ((bit_len >> 16) & 0xff) as u8;
        self.buffer[62] = ((bit_len >> 8) & 0xff) as u8;
        self.buffer[63] = (bit_len & 0xff) as u8;
        self.compress();

        let mut out: [u8; 32] = [0; 32];
        let mut j = 0 as usize;
        while j < 8 {
            let v = self.state[j];
            let out_idx = j * 4;
            out[out_idx] = ((v >> 24) & 0xff) as u8;
            out[out_idx + 1] = ((v >> 16) & 0xff) as u8;
            out[out_idx + 2] = ((v >> 8) & 0xff) as u8;
            out[out_idx + 3] = (v & 0xff) as u8;
            j = j + 1;
        }
        return out;
    }

    // Completes the hash computation and writes the 64-character lowercase hex digest into out.
    pub fn finalize_hex(self: &mut Sha256, out: &mut [u8; 64]) {
        let dig = self.finalize();
        sha256_to_hex(&dig, out);
    }
}

// One-shot helper computing the 32-byte SHA-256 digest of data.
pub fn sha256(data: [u8]) -> [u8; 32] {
    let mut h = Sha256.new();
    h.update(data);
    return h.finalize();
}

// Formats a 32-byte binary digest into a 64-character hex string allocated in arena a.
pub fn sha256_to_hex(digest: &[u8; 32], out: &mut [u8; 64]) {
    let hex_chars: [u8; 16] = [
        '0' as u8,
        '1' as u8,
        '2' as u8,
        '3' as u8,
        '4' as u8,
        '5' as u8,
        '6' as u8,
        '7' as u8,
        '8' as u8,
        '9' as u8,
        'a' as u8,
        'b' as u8,
        'c' as u8,
        'd' as u8,
        'e' as u8,
        'f' as u8
    ];
    let mut i = 0 as usize;
    while i < 32 {
        let b = digest[i] as usize;
        let hi = (b >> 4) & 0x0f;
        let lo = b & 0x0f;
        out[i * 2] = hex_chars[hi];
        out[i * 2 + 1] = hex_chars[lo];
        i = i + 1;
    }
}

// One-shot helper computing the 64-character hex SHA-256 digest of data in arena a.
pub fn sha256_hex(data: [u8], out: &mut [u8; 64]) {
    let d = sha256(data);
    sha256_to_hex(&d, out);
}

// One-shot helper computing the 64-character hex SHA-256 digest into an array.
pub fn sha256_hex_arr(data: [u8]) -> [u8; 64] {
    let mut out: [u8; 64] = [0; 64];
    sha256_hex(data, &mut out);
    return out;
}
