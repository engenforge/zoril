// expected exit code: 0
// Verifies that all fields of a large struct (48 bytes) survive a method
// call pass-by-value. Regression for Bug 4 (large enum/struct corruption).
struct BigStruct { a: u64, b: u64, c: u64, d: u64, e: u64, f: u64 }

struct Sink { last_c: u64, last_f: u64 }

impl Sink {
    fn store(self: *mut Sink, s: BigStruct) {
        unsafe {
            self.last_c = s.c;
            self.last_f = s.f;
        }
    }
}

fn main() -> i32 {
    let big = BigStruct { a: 1, b: 2, c: 99, d: 4, e: 5, f: 77 };
    let mut s = Sink { last_c: 0, last_f: 0 };
    (&mut s).store(big);
    if s.last_c != 99 { return 1; }
    if s.last_f != 77 { return 2; }
    return 0;
}
