import "io.zrl";
import "fmt.zrl";
use io::{stdout, write};
use fmt::write_i64;

enum Decl {
    Fn(i32),
    Struct(i32),
    Enum(i32),
    Impl(i32),
    Typedef(i32),
    Const(i32),
}

impl Decl {
    pub fn get_tag(self: &Decl) -> u32 { return unsafe { *(self as *u32) }; }
}

fn write_str(s: [u8]) {
    let out = stdout();
    write(out, s);
}

fn test_match(p_decl: &Decl) {
    let tag = p_decl.get_tag();
    write_str("Tag is: ");
    let mut out = stdout();
    let _ = write_i64(&mut out, tag as i64);
    write_str("\n");

    match *p_decl {
        Decl.Fn(v) => { write_str("Matched Fn\n"); },
        Decl.Struct(v) => { write_str("Matched Struct\n"); },
        Decl.Enum(v) => { write_str("Matched Enum\n"); },
        Decl.Impl(v) => { write_str("Matched Impl\n"); },
        Decl.Typedef(v) => { write_str("Matched Typedef\n"); },
        Decl.Const(v) => { write_str("Matched Const\n"); },
    }
}

fn main() -> i32 {
    let d = Decl.Impl(42);
    test_match(&d);
    return 0;
}
