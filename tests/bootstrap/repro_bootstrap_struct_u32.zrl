pub struct SyscallInstr {
    pub num: u32,
    pub args: [u32],
}

fn process_syscall(s: &SyscallInstr) -> u32 {
    return s.num;
}

fn main() -> i32 {
    let mut args = [0 as u32, 0 as u32];
    let mut s = SyscallInstr { num: 42 as u32, args: &args };

    let n = process_syscall(&s);

    if n == 42 as u32 {
        unsafe { @syscall(60, 0) }; // exit(0)
    }
    if n == 0 as u32 {
        unsafe { @syscall(60, 2) }; // exit(2)
    }
    unsafe { @syscall(60, 1) }; // exit(1)
    return 0;
}
