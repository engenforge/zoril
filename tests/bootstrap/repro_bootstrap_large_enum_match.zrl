import "io.zrl";
import "fmt.zrl";
use io::{stderr, write};
use fmt::write_u64;

struct PayloadSlice {
    a: u64,
    b: [u64],
}

enum LargeSlice {
    V0, V1, V2, V3, V4, V5, V6, V7, V8, V9,
    V10, V11, V12, V13, V14, V15, V16, V17, V18, V19,
    V20, V21, V22, V23, V24, V25, V26, V27, V28, V29,
    V30, V31, V32, V33, V34, V35, V36, V37, V38, V39,
    V40, V41, V42, V43, V44(PayloadSlice), V45, V46, V47, V48, V49,
}

fn test_match(l: &LargeSlice) {
    let mut err = stderr();
    match *l {
        LargeSlice.V44(p) => {
            write(err, "Matched V44: a=");
            let _ = write_u64(&mut err, p.a);
            write(err, " len=");
            let _ = write_u64(&mut err, p.b.len);
            write(err, "\n");
        },
        _ => {
            write(err, "Failed to match V44 (Hit default arm)\n");
        }
    }
}

fn main() {
    let mut b_data = [10 as u64, 20 as u64];
    let p = PayloadSlice { a: 123, b: &mut b_data };
    let val = LargeSlice.V44(p);
    test_match(&val);
}
