import "io.zrl";
import "fmt.zrl";
use io::{close, exit, print, stdout};
use fmt::write_u64;

enum Status {
    Ok(i32),
    Error,
    Fatal,
}

fn diverging_func() -> never {
    let stdout_fd = stdout();
    print("Diverging!\n");
    let _ = close(stdout_fd);
    exit(1);
    while true {}
}

fn test_match_diverge(s: Status) -> i32 {
    let res = match s {
        Status.Ok(val) => {
            val
        },
        Status.Error => {
            diverging_func();
            0
        },
        Status.Fatal => {
            diverging_func();
            1
        }
    };
    return res;
}

fn main() -> i32 {
    let s = Status.Ok(42);
    let val = test_match_diverge(s);
    let mut stdout_fd = stdout();
    print("val: ");
    let _ = write_u64(&mut stdout_fd, val as u64);
    print("\n");
    let _ = close(stdout_fd);
    return 0;
}
