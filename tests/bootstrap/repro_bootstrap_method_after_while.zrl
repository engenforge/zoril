// Regression test: a method call after a `while` loop inside an `if` block. An earlier
// zoril-c.release reported "Unresolved method or variant" on this shape; the program below
// checks that the method resolves and stores 2.

pub struct Buf { pub data: u32 }
impl Buf {
    pub fn push(self: &mut Buf, b: u8) { self.data = b as u32; }
}

fn test(buf: *mut Buf, x: u8) {
    if x == 1u8 {
        let mut h = 0 as u32;
        let mut j = 0;
        while j < 2 {
            h = h + 1 as u32;
            j = j + 1;
        }
        unsafe { (*buf).push(h as u8); }
    }
}

fn main() -> i32 {
    let mut b = Buf { data: 0 as u32 };
    test(&mut b, 1u8);
    if b.data != 2 as u32 { return 1; }
    return 0;
}
