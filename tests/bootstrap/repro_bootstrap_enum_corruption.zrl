import "core.zrl";

pub enum Big {
    A(u64),
    B(u64, u64, u64, u64),
    C(u32),
}

fn check(b: Big) -> u32 {
    unsafe { return *( (&b) as *u32 ); }
}

fn dirty_stack() {
    let mut x = [0xDEADBEEF as u64, 0xDEADBEEF as u64, 0xDEADBEEF as u64, 0xDEADBEEF as u64, 0xDEADBEEF as u64];
    let p = &x as *u64;
    // do nothing
}

fn main() -> i32 {
    dirty_stack();
    let tag = check(Big.C(42 as u32));
    if tag != 2 as u32 {
        return 1;
    }
    return 0;
}
