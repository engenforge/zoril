import "io.zrl";
use io::{stdout, write};

enum LargeEnum {
    V1(i32), V2(i32), V3(i32), V4(i32), V5(i32),
    V6(i32), V7(i32), V8(i32), V9(i32), V10(i32),
    V11(i32), V12(i32), V13(i32), V14(i32), V15(i32),
    V16(i32), V17(i32), V18(i32), V19(i32), V20(i32),
}

fn write_str(s: [u8]) {
    let out = stdout();
    write(out, s);
}

fn check_match(e: &LargeEnum, expected: i32) {
    // Force register pressure
    let a1 = 1; let a2 = 2; let a3 = 3; let a4 = 4; let a5 = 5;
    let a6 = 6; let a7 = 7; let a8 = 8; let a9 = 9; let a10 = 10;

    let result = match *e {
        LargeEnum.V1(v) => v,
        LargeEnum.V2(v) => v,
        LargeEnum.V3(v) => v,
        LargeEnum.V4(v) => v,
        LargeEnum.V5(v) => v,
        LargeEnum.V6(v) => v,
        LargeEnum.V7(v) => v,
        LargeEnum.V8(v) => v,
        LargeEnum.V9(v) => v,
        LargeEnum.V10(v) => v,
        LargeEnum.V11(v) => v,
        LargeEnum.V12(v) => v,
        LargeEnum.V13(v) => v,
        LargeEnum.V14(v) => v,
        LargeEnum.V15(v) => v,
        LargeEnum.V16(v) => v,
        LargeEnum.V17(v) => v,
        LargeEnum.V18(v) => v,
        LargeEnum.V19(v) => v,
        LargeEnum.V20(v) => v,
    };

    let sum = a1+a2+a3+a4+a5+a6+a7+a8+a9+a10;
    if sum != 55 { write_str("Sum corrupted!\n"); }

    if result != expected {
        write_str("MATCH CORRUPTION DETECTED!\n");
    }
}

fn main() -> i32 {
    let e = LargeEnum.V20(20);
    check_match(&e, 20);
    return 0;
}
