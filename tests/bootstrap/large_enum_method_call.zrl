// expected exit code: 0
// Verifies that all fields of a large enum (56+ bytes) survive a method
// call pass-by-value. Regression for Bug 4 (large enum/struct corruption).
enum BigEnum {
    Small(u64),
    Big(u64, u64, u64, u64, u64, u64),
}

struct Sink { a: u64, b: u64, c: u64, d: u64, e: u64, f: u64 }

impl Sink {
    fn load(self: *mut Sink, e: BigEnum) {
        match e {
            BigEnum.Big(a, b, c, d, ee, f) => {
                unsafe {
                    self.a = a; self.b = b; self.c = c;
                    self.d = d; self.e = ee; self.f = f;
                }
            },
            _ => {}
        }
    }
}

fn main() -> i32 {
    let v = BigEnum.Big(10, 20, 30, 40, 50, 60);
    let mut s = Sink { a: 0, b: 0, c: 0, d: 0, e: 0, f: 0 };
    (&mut s).load(v);
    if s.a != 10 { return 1; }
    if s.b != 20 { return 2; }
    if s.c != 30 { return 3; }
    if s.d != 40 { return 4; }
    if s.e != 50 { return 5; }
    if s.f != 60 { return 6; }
    return 0;
}
