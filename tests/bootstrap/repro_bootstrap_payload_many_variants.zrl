import "io.zrl";

pub struct Payload {
    pub num: u32,
    pub args: [u32],
}

pub enum Container {
    V0, V1, V2, V3, V4, V5, V6, V7, V8, V9,
    V10, V11, V12, V13, V14, V15, V16, V17, V18, V19,
    V20, V21, V22, V23, V24, V25, V26, V27, V28, V29,
    V30, V31, V32, V33, V34, V35, V36, V37, V38, V39,
    V40, V41, V42, V43, V44, V45, V46, V47, V48, V49,
    Target(Payload),
}

impl Container {
    pub fn get_num(self: &Container) -> u32 {
        let p = unsafe { &*((self as usize + 8) as *Payload) };
        return p.num;
    }
}

fn main() -> i32 {
    let mut args = [0 as u32, 0 as u32];
    let mut p = Payload { num: 42 as u32, args: &args };
    let mut c = Container.Target(p);

    let n = c.get_num();

    if n == 42 as u32 {
        unsafe { @syscall(60, 0) };
    }
    if n == 0 as u32 {
        unsafe { @syscall(60, 2) };
    }
    unsafe { @syscall(60, 1) };
    return 0;
}
