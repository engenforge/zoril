import "io.zrl";
import "fmt.zrl";
use io::{stdout, write};
use fmt::write_i64;

enum LargeEnum {
    V1(i32), V2(i32), V3(i32), V4(i32), V5(i32),
    V6(i32), V7(i32), V8(i32), V9(i32), V10(i32),
    V11(i32), V12(i32), V13(i32), V14(i32), V15(i32),
    V16(i32), V17(i32), V18(i32), V19(i32), V20(i32),
    V21(i32), V22(i32), V23(i32), V24(i32), V25(i32),
    V26(i32), V27(i32), V28(i32), V29(i32), V30(i32),
}

impl LargeEnum {
    pub fn get_tag(self: &LargeEnum) -> u32 { return unsafe { *(self as *u32) }; }
}

fn write_str(s: [u8]) {
    let out = stdout();
    write(out, s);
}

fn test_match(e: &LargeEnum, expected_tag: u32, expected_val: i32) {
    // Force register pressure
    let a1 = 1; let a2 = 2; let a3 = 3; let a4 = 4; let a5 = 5;
    let a6 = 6; let a7 = 7; let a8 = 8; let a9 = 9; let a10 = 10;
    let a11 = 11; let a12 = 12; let a13 = 13; let a14 = 14; let a15 = 15;

    let tag = e.get_tag();
    if tag != expected_tag {
        let mut out = stdout();
        write_str("Tag mismatch! Expected ");
        let _ = write_i64(&mut out, expected_tag as i64);
        write_str(" got ");
        let _ = write_i64(&mut out, tag as i64);
        write_str("\n");
    }

    let mut result = -1;
    match *e {
        LargeEnum.V1(v) => { result = v; },
        LargeEnum.V2(v) => { result = v; },
        LargeEnum.V3(v) => { result = v; },
        LargeEnum.V4(v) => { result = v; },
        LargeEnum.V5(v) => { result = v; },
        LargeEnum.V6(v) => { result = v; },
        LargeEnum.V7(v) => { result = v; },
        LargeEnum.V8(v) => { result = v; },
        LargeEnum.V9(v) => { result = v; },
        LargeEnum.V10(v) => { result = v; },
        LargeEnum.V11(v) => { result = v; },
        LargeEnum.V12(v) => { result = v; },
        LargeEnum.V13(v) => { result = v; },
        LargeEnum.V14(v) => { result = v; },
        LargeEnum.V15(v) => { result = v; },
        LargeEnum.V16(v) => { result = v; },
        LargeEnum.V17(v) => { result = v; },
        LargeEnum.V18(v) => { result = v; },
        LargeEnum.V19(v) => { result = v; },
        LargeEnum.V20(v) => { result = v; },
        LargeEnum.V21(v) => { result = v; },
        LargeEnum.V22(v) => { result = v; },
        LargeEnum.V23(v) => { result = v; },
        LargeEnum.V24(v) => { result = v; },
        LargeEnum.V25(v) => { result = v; },
        LargeEnum.V26(v) => { result = v; },
        LargeEnum.V27(v) => { result = v; },
        LargeEnum.V28(v) => { result = v; },
        LargeEnum.V29(v) => { result = v; },
        LargeEnum.V30(v) => { result = v; },
    }

    let sum = a1+a2+a3+a4+a5+a6+a7+a8+a9+a10+a11+a12+a13+a14+a15;
    if sum != 120 { write_str("Sum corrupted!\n"); }

    if result != expected_val {
        let mut out = stdout();
        write_str("MATCH CORRUPTION DETECTED! Expected val ");
        let _ = write_i64(&mut out, expected_val as i64);
        write_str(" got ");
        let _ = write_i64(&mut out, result as i64);
        write_str(" for tag ");
        let _ = write_i64(&mut out, tag as i64);
        write_str("\n");
    }
}

fn main() -> i32 {
    let e1 = LargeEnum.V1(1);
    let e30 = LargeEnum.V30(30);
    test_match(&e1, 0, 1);
    test_match(&e30, 29, 30);
    write_str("Done\n");
    return 0;
}
