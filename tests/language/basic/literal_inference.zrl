// expected exit 0
// An integer literal takes its type from its context, also when the expression around it is
// made only of literals (`(1 + 2) * 3000000000`, `1 << 40` with a u64 expected), and on the
// left of a typed operand (`5000000000 > x`). Those fell back to i32: an out-of-range error or
// a shift count past 32 bits.
struct S { mask: u64, small: u8 }
fn wide() -> u64 { return 3 * (1 << 34); }
fn take(x: u64) -> u64 { return x; }

fn main() -> i32 {
    let s: u64 = 1 << 40;
    if s != 1099511627776 { return 1; }
    let y: u64 = (1 + 2) * 3000000000;
    if y != 9000000000 { return 2; }
    if take(1 << 33) != 8589934592 { return 3; }
    let a: [u64; 2] = [1 << 40, 2];
    if a[0] != 1099511627776 { return 4; }
    if wide() != 51539607552 { return 5; }
    let n: i64 = 0 - 5000000000;
    if n != -5000000000 { return 6; }
    let x: u64 = 7;
    if 5000000000 < x { return 7; }
    let z = 4294967296 + x;
    if z != 4294967303 { return 8; }
    let st = S { mask: (1 << 63) | 1, small: 2 * 100 };
    if st.mask & 1 != 1 || st.small != 200 { return 9; }
    let i: usize = 3;
    if i + 1 != 4 { return 10; }
    // Unconstrained literals keep the i32 default.
    let d = 1 + 2;
    let d32: i32 = d;
    if d32 != 3 { return 11; }
    return 0;
}
