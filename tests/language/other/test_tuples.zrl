fn divmod(a: i32, b: i32) -> (i32, i32) {
    return (a / b, a % b);
}

fn swap_pair(p: (i32, i32)) -> (i32, i32) {
    return (p.1, p.0);
}

fn main() -> i32 {
    let result = divmod(17, 5);
    let quotient = result.0;   // 3
    let remainder = result.1;  // 2

    let flipped = swap_pair((100_i32, 200_i32));
    let f0 = flipped.0; // 200
    let f1 = flipped.1; // 100

    if quotient != 3 { return 10; }
    if remainder != 2 { return 11; }
    if f0 != 200 { return 12; }
    if f1 != 100 { return 13; }
    
    return 0;
}
