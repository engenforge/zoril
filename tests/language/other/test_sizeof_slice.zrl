import "core.zrl";

pub struct Span {
    pub start: u32,
    pub end: u32,
    pub line: u32,
    pub col: u32,
}

pub enum Token {
    Ident(u32), Int(u64), Float(f64), Char(u32), String(u32),
    Bool(bool),
    LParen, RParen, LBrace, RBrace, LBracket, RBracket,
    Comma, Semi, Question, At, DoubleColon, Hash,
    Dot, DotDot, DotDotDot,
    Plus, PlusEqual, PlusPercent, PlusPercentEqual,
    Minus, MinusEqual, MinusPercent, MinusPercentEqual,
    Star, StarEqual, StarPercent, StarPercentEqual,
    Slash, SlashEqual,
    Percent, PercentEqual,
    Amp, AmpEqual, AmpAmp,
    Pipe, PipeEqual, PipePipe,
    Caret, CaretEqual,
    Less, LessEqual, LessLess, LessLessEqual,
    Greater, GreaterEqual, GreaterGreater, GreaterGreaterEqual,
    Equal, EqualEqual,
    Bang, BangEqual,
    Arrow, FatArrow,
    KFn, KStruct, KEnum, KTrait, KImpl,
    KLet, KMut,
    KIf, KElse, KMatch,
    KWhile, KFor, KIn,
    KReturn, KBreak, KContinue, KDefer,
    KType, KPub, KExtern,
    KBox, KTry, KSizeof, KAlignof, KAs, KConst, KStatic, KImport,
    Underscore,
    Eof,
    Invalid(u32),
}

pub struct TokenWithSpan {
    pub token: Token,
    pub span: Span,
}

fn main() -> i32 {
    // TokenWithSpan: Token(tag4+pad4+payload8=16) + Span(4*u32=16) = 32
    if sizeof(TokenWithSpan) != 32 { return 1; }
    return 0;
}
