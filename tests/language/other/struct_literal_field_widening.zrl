// expected exit 0
// A field value of a narrower integer type is converted to the field's type, as for `let`: an i32
// -1 in an i64 field was stored without sign extension.
struct Q { x: i64, y: i32 }
fn main() -> i32 {
    let n = -1 as i32;
    let q = Q { x: n, y: 7 };
    if q.x != -1 { return 1; }
    let m = 3000000000 as u32;
    let r = Q { x: m, y: 7 };
    if r.x != 3000000000 { return 2; }
    return 0;
}
