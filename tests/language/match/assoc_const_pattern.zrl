// expected exit 0
// An associated constant as a match pattern compares the scrutinee with its value.
struct Limits { v: i32 }
impl Limits {
    const LOW: u32 = 1;
    const HIGH: u32 = 9;
}
fn classify(x: u32) -> i32 {
    return match x {
        Limits.LOW => 1,
        Limits.HIGH => 2,
        _ => 0,
    };
}
fn main() -> i32 {
    if classify(1) != 1 || classify(9) != 2 || classify(5) != 0 { return 1; }
    return 0;
}
