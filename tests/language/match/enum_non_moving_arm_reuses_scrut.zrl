// expected exit 0
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

enum Result<T, E> { Ok(T), Err(E) }
struct S { p: i32 }
impl Drop for S { fn drop(self: &mut S) {} }
enum Q { A(S), B(i32) }
enum QB { A(Vec<i32>), B }

fn consume_q(q: Q) -> i32 {
    match q {
        Q.A(s) => { return s.p; },
        Q.B(n) => { return n; },
    }
}

fn test_non_moving_arm_reuse() -> i32 {
    let e = Q.B(7);
    match e {
        Q.A(s) => { return s.p; },
        Q.B(_) => { return consume_q(e); },
    }
}

fn test_owned_enum_with_borrow(a: &Arena) -> i32 {
    let mut v = Vec::<i32>.new_in(a);
    v.push(11);
    let r: Result<QB, i32> = Result.Ok(QB.A(v));
    match r {
        Result.Ok(QB.A(v2)) => { return v2.len() as i32; },
        _ => { return 0; },
    }
}

fn test_partial_non_moving_destructure() -> i32 {
    let t = (S { p: 5 }, 9);
    let (_, n) = t;
    return n + t.0.p;
}

fn main() -> i32 {
    if test_non_moving_arm_reuse() != 7 { return 1; }
    let a = Arena.new(4096).unwrap();
    if test_owned_enum_with_borrow(&a) != 1 { return 2; }
    if test_partial_non_moving_destructure() != 14 { return 3; }
    return 0;
}
