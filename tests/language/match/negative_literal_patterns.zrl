// expected exit 0
// Negative integer literals as patterns and range ends (`-1 =>`, `-5..=-2 =>`); they were
// a parse error. Ranges compare by the scrutinee's signedness.
fn f(x: i32) -> i32 { return match x { -1 => 10, 0 => 20, -5..=-2 => 40, -100..0 => 50, _ => 30 }; }
fn g(x: i64) -> i64 { return match x { -9000000000 => 1, _ => 2 }; }
fn h(x: i8) -> i32 { return match x { -128 => 1, -1 => 2, _ => 3 }; }
fn main() -> i32 {
    if f(-1) != 10 || f(0) != 20 || f(-3) != 40 || f(-50) != 50 || f(5) != 30 || f(-200) != 30 { return 1; }
    if g(-9000000000) != 1 || g(9000000000) != 2 { return 2; }
    if h(-128 as i8) != 1 || h(-1 as i8) != 2 || h(127) != 3 { return 3; }
    return 0;
}
