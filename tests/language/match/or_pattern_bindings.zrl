// expected exit 26
// Or-patterns whose alternatives bind the same names with the same types, by value and by
// reference (match ergonomics), with single and multiple payload bindings.
enum E { A(i32), B(i32), C((i32, i32)), D((i32, i32)), N }
fn f(e: E) -> i32 {
    return match e {
        E.A(x) | E.B(x) => x,
        E.C(p, q) | E.D(p, q) => p + q,
        E.N => 0,
    };
}
fn g(e: &E) -> i32 {
    return match e { E.A(x) | E.B(x) => *x, E.C(_) | E.D(_) | E.N => 0 };
}
fn main() -> i32 {
    let b = E.B(5);
    return f(E.A(1)) + f(E.B(2)) + f(E.C((3, 4))) + f(E.D((5, 6))) + g(&b);
}
