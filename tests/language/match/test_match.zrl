import "io.zrl";
use io::{write, stdout};

// --- Single module tests ---

// From repro_match_bare.zrl and repro_match_qual.zrl
enum BareMyEnum { Variant(u32) }
fn test_match_bare() -> i32 {
    let e = BareMyEnum.Variant(10u32);
    match e {
        BareMyEnum.Variant(v) => { if v == 10u32 { return 0; } }
    };
    return 1;
}

// From repro_match_binding.zrl
enum BindingToken { String(u32), Other }
fn get_binding_id(t: BindingToken) -> u32 {
    let mut id_out = 0 as u32;
    match t {
        BindingToken.String(id) => { id_out = id; },
        BindingToken.Other => {}
    }
    return id_out;
}
fn test_match_binding() -> i32 {
    if get_binding_id(BindingToken.String(42)) != 42 { return 1; }
    return 0;
}

// From repro_match_large_enum.zrl and repro_match_large_wildcard.zrl
pub enum LargeToken {
    K1, K2, K3, K4, K5, K6, K7, K8, K9, K10,
    K11, K12, K13, K14, K15, K16, K17, K18, K19, K20,
    K21, K22, K23, K24, K25,
    Ident(u32),
    Int(u64),
    Float(f64),
    Char(u32),
    String(u32),
    Bool(bool),
    Plus, Minus, Star, Slash, Percent,
    PlusEqual, MinusEqual, StarEqual, SlashEqual, PercentEqual,
    PlusPercent, MinusPercent, StarPercent,
    Equal, EqualEqual, BangEqual,
    Less, Greater, LessEqual, GreaterEqual,
    Amp, Pipe, Caret, Bang,
    AmpAmp, PipePipe,
    AmpEqual, PipeEqual, CaretEqual,
    LessLess, GreaterGreater,
    LessLessEqual, GreaterGreaterEqual,
    Dot, Comma, Colon, Semi, Arrow,
    LParen, RParen, LBrace, RBrace, LBracket, RBracket,
    Question, Underscore, At, DoubleColon,
    Eof,
    Invalid(u32),
}
fn test_match_large() -> i32 {
    let t = LargeToken.K1;
    let res1 = match t {
        LargeToken.Eof => 1,
        LargeToken.K1 => 0,
        _ => 99,
    };
    if res1 != 0 { return 1; }
    
    let res2 = match t {
        LargeToken.Eof => 1,
        _ => 0,
    };
    if res2 != 0 { return 2; }
    return 0;
}

// From repro_match_method_call_2.zrl
struct MatchAST { count: u32 }
impl MatchAST {
    fn alloc(self: &mut MatchAST) -> u32 {
        self.count = self.count + 1;
        return self.count;
    }
}
struct MatchParser {
    ast: *mut MatchAST,
}
enum MatchKind { A, B }
impl MatchParser {
    fn test(self: &mut MatchParser, k: MatchKind, b: bool) -> u32 {
        return match k {
            MatchKind.A => {
                if b {
                    return unsafe { (*self.ast).alloc() };
                };
                unsafe { (*self.ast).alloc() }
            },
            MatchKind.B => 0,
        };
    }
}
fn test_match_method_call() -> i32 {
    let mut ast = MatchAST { count: 0 };
    let mut p = MatchParser { ast: &mut ast as *mut MatchAST };
    if p.test(MatchKind.A, true) != 1 { return 1; }
    if p.test(MatchKind.A, false) != 2 { return 2; }
    return 0;
}

