enum ND { A(D), B }
fn mk(fp: *mut u8) -> S { return S { p: fp }; }
fn consume(s: S) {}
fn bound(fp: *mut u8) { let e = E.A(mk(fp)); match e { E.A(s) => { let n = 1; }, E.B => {}, } }
