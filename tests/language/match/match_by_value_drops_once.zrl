// A value matched by value is dropped once: by the arm's binding when the arm moves it out, or
// with the scrutinee when the arm binds nothing. Once, an arm's bindings were dropped after its
// jump to the match exit, so never, and every arm marked the scrutinee moved, so a value matched
// by value was never dropped (gap_81). Each case returns its drop count.
// expected exit 0
struct S { p: *mut u8 }
impl Drop for S {
    fn drop(self: &mut S) { unsafe { *self.p = *self.p + 1 as u8; } }
