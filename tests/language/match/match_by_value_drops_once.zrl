static mut DROP_FLAG: u8 = 0 as u8;
fn count(f: fn(*mut u8)) -> u8 {
    DROP_FLAG = 0 as u8;
    f(&mut DROP_FLAG as *mut u8);
    return DROP_FLAG;
}
fn main() -> i32 {
    if count(bound) != 1 as u8 { return 1; }
    if count(passed_on) != 1 as u8 { return 2; }
    if count(wild_payload) != 1 as u8 { return 3; }
    if count(wild_arm) != 1 as u8 { return 4; }
    if count(other_arm) != 1 as u8 { return 5; }
    if count(nested) != 1 as u8 { return 6; }
