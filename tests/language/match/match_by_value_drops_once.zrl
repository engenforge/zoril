fn temporary(fp: *mut u8) { match E.A(mk(fp)) { E.A(s) => {}, E.B => {}, } }
fn param(e: E) { match e { E.A(s) => {}, E.B => {}, } }
fn by_param(fp: *mut u8) { param(E.A(mk(fp))); }
fn guard_fails(fp: *mut u8) {
