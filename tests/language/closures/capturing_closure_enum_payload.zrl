// expected exit 7
// A capturing closure is a function value carrying its environment, so it works anywhere a
// `fn` value does (enum payload). Until 2026-10-05 this was rejected: the environment was
// bound to the variable statically.
enum E { A(fn(i32) -> i32), B }

fn main() -> i32 {
    let k = 5;
    let e = E.A(|x: i32| -> i32 { x + k });
    match e { E.A(f) => { return f(2); }, E.B => { return 0; } }
}
