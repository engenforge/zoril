// expected exit 7
// A capturing closure is a function value carrying its environment, so it works anywhere a
// `fn` value does (to fn). Until 2026-10-05 this was rejected: the environment was
// bound to the variable statically.

fn apply(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}

fn main() -> i32 {
    let k = 5;
    return apply(|x: i32| -> i32 { x + k }, 2);
}
