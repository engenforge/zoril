// A closure capturing an owning value (moved) along with another variable
// (owning or Copy) compiles and runs correctly (task 2g.4).

import "vec.zrl";
use vec::Vec;

// Reproducer 1: owning Vec + Copy n (v declared first)
fn test_repro1() -> i32 {
    let mut v = Vec::<i32>.new();
    let n = 3;
    let mut f = |k: i32| -> i32 {
        v.push(k + n);
        return *v.get(0).unwrap();
    };
    let val = f(1);
    if val != 4 { return 1; }
    if n != 3 { return 2; }
    return 0;
}

// Reproducer 2: n declared first
fn test_repro2() -> i32 {
    let n = 3;
    let mut v = Vec::<i32>.new();
    let mut f = |k: i32| -> i32 {
        v.push(k + n);
        return *v.get(0).unwrap();
    };
    let val = f(1);
    if val != 4 { return 1; }
    if n != 3 { return 2; }
    return 0;
}

// Reproducer 3: two captured Vecs
fn test_repro3() -> i32 {
    let mut v = Vec::<i32>.new();
    let mut w = Vec::<i32>.new();
    let mut f = |k: i32| -> i32 {
        v.push(k);
        w.push(k * 2);
        return *v.get(0).unwrap() + *w.get(0).unwrap();
    };
    let sum = f(1); // 1 + 2 = 3
    if sum != 3 { return 1; }
    return 0;
}

// Reproducer 4: read-only closure capturing Vec + n
fn test_repro4() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(10);
    let n = 3;
    let f = |k: i32| -> i32 {
        return v.len() as i32 + n + k;
    };
    let res = f(2); // 1 + 3 + 2 = 6
    if res != 6 { return 1; }
    if n != 3 { return 2; }
    return 0;
}

// Case 5: two owning values and a Copy value
fn test_case5() -> i32 {
    let mut v = Vec::<i32>.new();
    let mut w = Vec::<i32>.new();
    let n = 5;
    let mut f = |k: i32| -> i32 {
        v.push(k + n);
        w.push(k * n);
        return *v.get(0).unwrap() + *w.get(0).unwrap();
    };
    let sum = f(2); // (2+5) + (2*5) = 7 + 10 = 17
    if sum != 17 { return 1; }
    if n != 5 { return 2; }
    return 0;
}

fn main() -> i32 {
    let r1 = test_repro1();
    if r1 != 0 { return 10 + r1; }
    let r2 = test_repro2();
    if r2 != 0 { return 20 + r2; }
    let r3 = test_repro3();
    if r3 != 0 { return 30 + r3; }
    let r4 = test_repro4();
    if r4 != 0 { return 40 + r4; }
    let r5 = test_case5();
    if r5 != 0 { return 50 + r5; }
    return 0;
}
