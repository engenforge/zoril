// expected exit 0
struct P { x: i64 }

impl P {
    pub fn get(self: &P) -> i64 { return self.x; }
}

fn P_get(p: &P) -> i64 { return 100; }

pub fn main() -> i32 {
    let p = P { x: 5 };
    if p.get() != 5 { return 1; }
    if P::get(&p) != 5 { return 2; }
    if P_get(&p) != 100 { return 3; }
    return 0;
}
