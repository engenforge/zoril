import "core.zrl";

pub struct Span {
    pub start: u32,
    pub end: u32,
    pub line: u32,
    pub col: u32,
}

pub enum Token {
    Semi,
}

pub struct TokenWithSpan {
    pub token: Token,
    pub span: Span,
}

pub struct Parser {
    pub cur: TokenWithSpan,
    pub peek: TokenWithSpan,
}

fn test_field_assignment() -> i32 {
    let mut p = Parser {
        cur: TokenWithSpan { token: Token.Semi, span: Span { start: 0, end: 0, line: 0, col: 0 } },
        peek: TokenWithSpan { token: Token.Semi, span: Span { start: 1, end: 2, line: 42, col: 100 } },
    };
    
    // Perform the assignment
    p.cur = p.peek;
    
    if p.cur.span.line != 42 {
        return 1; // Failed!
    }
    return 0; // Success!
}

fn main() -> i32 {
    return test_field_assignment();
}
