// A borrow held by a named local ends at the borrower's last use, not at the end of its scope: a
// `Vec` built with `Vec::new_in(&a)` holds the arena, and once `w` has been used for the last time
// the arena can be moved (`arena_destroy`) again. The move check does not reject it with
// "cannot move borrowed value 'a'". `Vec` has no `Drop` impl - only `Arena` does - so nothing touches the freed
// arena after the destroy.
import "vec.zrl";
import "mem.zrl";
use mem::Arena;
use vec::Vec;

fn consume(a: Arena) {}

pub fn main() -> i32 {
    let a = Arena.new(65536).unwrap();
    let mut v = Vec::<u64>.new_in(&a);
    v.push(7 as u64);
    let w = v;
    if w.len() != 1 as usize { return 1; }
    if w[0] != 7 as u64 { return 2; }
    consume(a);
    return 0;
}
