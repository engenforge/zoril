// A field read or write through a reference to a Box reaches the boxed value, not the Box's own slot.
struct Point { x: i64, y: i64 }

struct Holder { b: Box<Point> }

fn read(h: &Holder) -> i64 {
    return h.b.x + h.b.y;
}

fn main() -> i32 {
    let h = Holder { b: box Point { x: 20, y: 22 } };
    if read(&h) != 42 { return 1; }
    return 0;
}
