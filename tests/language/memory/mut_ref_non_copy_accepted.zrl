import "vec.zrl";
use vec::Vec;

fn test_mut_ref_moved_not_used_again() -> bool {
    let mut x = 42;
    let a = &mut x;
    let b = a;
    *b = 100;
    return *b == 100 && x == 100;
}

fn test_sequential_reborrows() -> bool {
    let mut x = 42;
    let a = &mut x;
    {
        let b = &mut *a;
        *b = 10;
    }
    {
        let c = &mut *a;
        *c = 20;
    }
    return *a == 20 && x == 20;
}

fn test_push_len() -> bool {
    let mut v = Vec::<usize>.new();
    v.push(v.len());
    v.push(v.len());
    v.push(v.len());
    let ok = v.len() == 3 as usize
        && *v.get(0 as usize).unwrap() == 0 as usize
        && *v.get(1 as usize).unwrap() == 1 as usize
        && *v.get(2 as usize).unwrap() == 2 as usize;
    v.free();
    return ok;
}

fn main() -> i32 {
    if !test_mut_ref_moved_not_used_again() {
        return 1;
    }
    if !test_sequential_reborrows() {
        return 2;
    }
    if !test_push_len() {
        return 3;
    }
    return 0;
}
