// The read-through rule's twin: through `r`, a view of a local Vec reaches the storage the Vec owns,
// which it took over from `Vec.new()`'s result, so the result is a Frame origin.
// ORIGINS: f got O={Frame(_2)} S={}
// expected compile fail
import "vec.zrl";
use vec::Vec;
fn f(out: &mut [i32]) {
    let mut v = Vec::<i32>.new();
    v.push(42);
    let r = &v;
    let got = r.as_slice();
    *out = got;
}
fn main() -> i32 {
    let mut dest: [i32] = @slice(0 as *i32, 0);
    f(&mut dest);
    return dest[0] - 42;
}
