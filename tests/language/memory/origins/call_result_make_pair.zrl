// An owning call result that holds a Drop type (`Arena`) by value owns fresh storage of this frame,
// the call's own Frame, even when it is tied to an argument that cannot reach an `Arena` (§3,
// _Details the transfer needs_): before Z-0048, S(pair) was the tie's Param alone.
// ORIGINS: f pair O={Param(0)} S={Frame(_2)}
// flags: --provenance
// expected exit 0
import "mem.zrl";
use mem::Arena;
fn make_pair(s: [i32]) -> Result<(Arena, [i32]), i32> {
    let a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return Result.Err(1); } };
    return Result.Ok((a, s));
}
fn f(s: [i32]) -> i32 {
    let pair = make_pair(s);
    return match pair { Result.Ok(p) => p.1[0], Result.Err(e) => e };
}
fn main() -> i32 {
    let data = [42, 0];
    return f(&data) - 42;
}
