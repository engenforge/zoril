// A call through a local bound to one `fn` item applies that item's summary (§3, _Calls through a
// known callee_), so the result holds `&x`'s Frame (gap_16), without the Static that a call through
// an unknown `fn` value adds (_Calls through a `fn` value_; Unknown until Z-0092).
// ORIGINS: main routed O={Frame(x)} S={}
// expected exit 0
fn forward(v: &i32) -> &i32 { return v; }
fn main() -> i32 {
    let x = 42;
    let f: fn(&i32) -> &i32 = forward;
    let routed = f(&x);
    return *routed - *forward(&x);
}
