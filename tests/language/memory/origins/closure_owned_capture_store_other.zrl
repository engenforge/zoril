// An owned capture outlives the frame (the store rule), so a closure storing another capture's
// value into it records an edge into a global: a caller applying the summary checks what the
// environment holds for that value. The two captures have bits of their own in the body, folded
// into ParamContents(`__env`) in the summary (§3, _A closure body's summary is stated over `__env`_).
// ORIGINS: _closure_0 store ParamContents(0) -> ParamContents(0) global
// expected exit 0
import "vec.zrl";
use vec::Vec;
struct Holder { s: [i32], keep: Vec<i32> }
fn main() -> i32 {
    let data = [1, 2];
    let view: [i32] = &data;
    let mut h = Holder { s: @slice(0 as *i32, 0), keep: Vec::<i32>.new() };
    let mut cl = || { h = Holder { s: view, keep: Vec::<i32>.new() }; };
    return 0;
}
