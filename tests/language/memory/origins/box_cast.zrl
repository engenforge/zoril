// A box cast to a raw pointer is an address into the storage the box owns, so the pointer holds it
// (in O, which the store and return rules read). A raw pointer owns nothing (§3, _Ownership_), so
// its S is empty.
// ORIGINS: f p O={Frame(_3)} S={}
// expected compile fail
fn f(out: &mut *i32) {
    let b = box 42;
    let p = b as *i32;
    *out = p;
}
fn main() -> i32 {
    let mut d: *i32 = 0 as *i32;
    f(&mut d);
    return 0;
}
