// A by-value `Vec` parameter is a local: its storage is Frame(v), not the caller's (gap_32).
// ORIGINS: store_view v O={Param(1)} S={Frame(v)}
// expected exit 42
import "vec.zrl";
use vec::Vec;
fn store_view(out: &mut [i32], v: Vec<i32>) {
    *out = v.as_slice();
}
fn main() -> i32 {
    let mut s: [i32] = @slice(0 as *i32, 0);
    let mut v = Vec::<i32>.new();
    v.push(42);
    store_view(&mut s, v);
    return s[0];
}
