// The read-through rule through an identity call: `id_ref` returns its argument (`ret_storage`), so
// the reference keeps Frame(c), and `take_ref` reads through it to the view's origin (Z-0045).
// ORIGINS: f got O={Param(1), ParamContents(1)} S={}
// expected compile fail
struct Carrier { v: [i32] }
fn take_ref(c: &Carrier) -> [i32] { return c.v; }
fn id_ref(c: &Carrier) -> &Carrier { return c; }
fn f(out: &mut [i32], view: [i32]) {
    let c = Carrier { v: view };
    let got = take_ref(id_ref(&c));
    *out = got;
}
fn main() -> i32 {
    let data = [42, 0];
    let mut dest: [i32] = @slice(0 as *i32, 0);
    f(&mut dest, &data);
    return dest[0] - 42;
}
