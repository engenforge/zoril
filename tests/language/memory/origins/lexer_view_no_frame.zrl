// A raw pointer owns nothing (§3, _Ownership_), so a struct holding one is no owner, and a
// by-value `Lexer` parameter owns no storage of this frame: a view read through `&lex` is the view
// the struct holds (its Param), with no Frame(lex).
// ORIGINS: f t O={Param(1)} S={}
// flags: --provenance
// expected exit 0
struct Lexer { text: [u8], cur: *u8 }
fn text_of(l: &Lexer) -> [u8] { return l.text; }
fn f(out: &mut [u8], lex: Lexer) {
    let t = text_of(&lex);
    *out = t;
}
fn main() -> i32 {
    let mut d: [u8] = "";
    f(&mut d, Lexer { text: "lexer", cur: 0 as *u8 });
    return d.len as i32 - 5;
}
