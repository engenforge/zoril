// The read-through rule (doc/design/provenance.md §3): `take_ref` returns what `c` holds, reached
// through `r`, so the result is the view's origin, not Frame(c) (Z-0045's reproducer).
// ORIGINS: f got O={Param(1)} S={}
// expected compile fail
struct Carrier { v: [i32] }
fn take_ref(c: &Carrier) -> [i32] { return c.v; }
fn f(out: &mut [i32], view: [i32]) {
    let c = Carrier { v: view };
    let r = &c;
    let got = take_ref(r);
    *out = got;
}
fn main() -> i32 {
    let data = [42, 0];
    let mut dest: [i32] = @slice(0 as *i32, 0);
    f(&mut dest, &data);
    return dest[0] - 42;
}
