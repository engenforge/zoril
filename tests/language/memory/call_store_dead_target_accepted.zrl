// Dead-target twin for holder three (gap_96): after put(&mut s, &v), if s is never read
// again before kill(&mut v), kill(&mut v) is accepted.
// expected exit 0
import "vec.zrl";
use vec::Vec;

fn put(out: &mut [i32], v: &Vec<i32>) { *out = v.as_slice(); }
fn kill(v: &mut Vec<i32>) { v.free(); }

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut s: [i32] = @slice(0 as *i32, 0);
    put(&mut s, &v);
    let _first = s[0];
    kill(&mut v);
    return 0;
}
