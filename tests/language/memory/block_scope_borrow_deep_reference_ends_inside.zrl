// expected exit 0
// The twin of err_block_scope_borrow_deep_reference: the same nine-level type and the same
// propagated borrow, read inside `x`'s scope. The strict reading only removes the `Drop`
// exemption, so a borrow that ends in time still compiles - a deeply nested type is not a
// reason to reject a program that reads its reference in time.
struct S1 { r: &i32 }
struct S2 { s: S1 }
struct S3 { s: S2 }
struct S4 { s: S3 }
struct S5 { s: S4 }
struct S6 { s: S5 }
struct S7 { s: S6 }
struct S8 { s: S7 }
struct S9 { s: S8 }
fn main() -> i32 {
    let x: i32 = 7;
    let deep = S9 { s: S8 { s: S7 { s: S6 { s: S5 { s: S4 { s: S3 { s: S2 { s: S1 { r: &x } } } } } } } } };
    let out: &i32 = deep.s.s.s.s.s.s.s.s.r;
    if *out != 7 { return 1; }
    return 0;
}
