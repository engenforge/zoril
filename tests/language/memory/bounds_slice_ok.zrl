// expected exit 7
// In-bounds slice indexing must still return the element. Guards against a
// bounds check that rejects correct code -- the failure mode that matters,
// since the compiler's own source indexes slices everywhere.
fn main() -> i32 {
    let mut arr = [1 as u8, 2, 7];
    let s: [u8] = &mut arr;
    return s[2 as usize] as i32;
}
