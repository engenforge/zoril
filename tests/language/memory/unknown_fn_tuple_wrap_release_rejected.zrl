// Regression test: sibling route of Bug 5 — (Wrap, i32) tuple carrying &mut Vec<i32>
// passed to an unknown fn value must be treated as releasable.
// expected compile fail
// EXPECT: cannot mutably borrow 'v' while it is already borrowed
import "vec.zrl";
use vec::Vec;

struct Wrap {
    v: &mut Vec<i32>,
}

fn kill_tuple_wrap(t: (Wrap, i32)) {
    t.0.v.free();
}

fn run(f: fn((Wrap, i32)), t: (Wrap, i32)) {
    f(t);
}

fn store_and_kill(out: &mut [i32], v: &mut Vec<i32>) {
    *out = v.as_slice();
    run(kill_tuple_wrap, (Wrap { v: v }, 1));
}

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut s: [i32] = @slice(0 as *i32, 0);
    store_and_kill(&mut s, &mut v);
    return s[0] - 42;
}
