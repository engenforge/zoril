// A --checked build poisons a value when it is dropped and traps (exit 134, the bounds-check trap
// status) when a drop finds the value already poisoned, which is what a second drop of the same
// storage looks like. Without --checked both drops run and the program exits 0.
// flags: --checked
// expected exit 134
static mut DROPS: i32 = 0;

struct D {
    x: u64,
}

trait Drop {
    fn drop(self: D);
}

impl Drop for D {
    fn drop(self: D) {
        DROPS = DROPS + 1;
    }
}

fn main() -> i32 {
    let mut d = D { x: 7 as u64 };
    let p = &mut d as *mut D;
    // SAFETY: dropping the same storage twice on purpose; a checked build traps on the second.
    unsafe { @drop(*p); }
    if DROPS != 1 { return 1; }
    unsafe { @drop(*p); }
    return 0;
}
