// Moving a Drop element out of a slice via let is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

struct S { p: i32 }
impl Drop for S { fn drop(self: &mut S) {} }

fn g(a: [S]) { let s = a[0]; }

fn main() -> i32 {
    let a = [S { p: 1 }];
    g(&a);
    return 0;
}
