// Moving a Drop payload out of a slice element via if let is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

struct S { p: i32 }
impl Drop for S { fn drop(self: &mut S) {} }
enum Q { A(S), B }

fn g(a: [Q]) {
    if let Q.A(s) = a[0] {}
}

fn main() -> i32 {
    let a = [Q.A(S { p: 1 })];
    g(&a);
    return 0;
}
