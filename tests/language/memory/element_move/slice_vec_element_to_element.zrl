// Assigning one Vec slice element to another by value is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

import "vec.zrl";
use vec::Vec;

fn g(a: [mut Vec<i32>]) { a[1] = a[0]; }

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    let w = Vec::<i32>.new();
    let mut a = [v, w];
    g(&mut a);
    return 0;
}
