// Returning a Vec slice element by value is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

import "vec.zrl";
use vec::Vec;

fn g(a: [Vec<i32>]) -> Vec<i32> { return a[0]; }

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(1);
    let mut a = [v];
    let x = g(&a);
    a[0].free();
    return 0;
}
