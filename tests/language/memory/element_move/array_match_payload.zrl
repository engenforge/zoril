// Moving a Drop payload out of an array element via match is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

struct S { p: i32 }
impl Drop for S { fn drop(self: &mut S) {} }
enum Q { A(S), B }

fn main() -> i32 {
    let a = [Q.A(S { p: 1 })];
    match a[0] {
        Q.A(s) => {},
        _ => {}
    }
    return 0;
}
