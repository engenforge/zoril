// Moving a Drop payload out of a nested-index slice element is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

struct S { p: i32 }
impl Drop for S { fn drop(self: &mut S) {} }
enum Q { A(S), B }

fn g(a: [[Q; 1]]) {
    match a[0][0] {
        Q.A(s) => {},
        _ => {}
    }
}

fn main() -> i32 {
    let a = [[Q.A(S { p: 1 })]];
    g(&a);
    return 0;
}
