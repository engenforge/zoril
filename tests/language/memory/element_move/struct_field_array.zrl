// Moving a Drop payload out of an array field element is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

struct S { p: i32 }
impl Drop for S { fn drop(self: &mut S) {} }
enum Q { A(S), B }
struct W { a: [Q; 1] }

fn main() -> i32 {
    let w = W { a: [Q.A(S { p: 1 })] };
    match w.a[0] {
        Q.A(s) => {},
        _ => {}
    }
    return 0;
}
