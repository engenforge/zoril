// A generic function that returns a slice element by value is rejected when the element is a Vec.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

import "vec.zrl";
use vec::Vec;

fn first<T>(a: [T]) -> T { return a[0]; }

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(1);
    let mut a = [v];
    let x = first::<Vec<i32>>(&a);
    a[0].free();
    return 0;
}
