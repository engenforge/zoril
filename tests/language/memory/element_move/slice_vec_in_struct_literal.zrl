// Building a struct from a Vec slice element by value is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

import "vec.zrl";
use vec::Vec;

struct N { v: Vec<i32>, n: i32 }

fn g(a: [Vec<i32>]) { let s = N { v: a[0], n: 1 }; }

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(1);
    let mut a = [v];
    g(&a);
    a[0].free();
    return 0;
}
