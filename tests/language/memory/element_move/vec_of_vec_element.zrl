// Reading an inner Vec by value out of a Vec of Vecs is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

import "vec.zrl";
use vec::Vec;

fn main() -> i32 {
    let mut inner = Vec::<i32>.new();
    inner.push(1);
    let mut outer = Vec::<Vec<i32>>.new();
    outer.push(inner);
    let x = outer[0];
    return 0;
}
