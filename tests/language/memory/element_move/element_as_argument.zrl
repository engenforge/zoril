// Moving a Drop element out of a local array as a call argument is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

struct S { p: i32 }
impl Drop for S { fn drop(self: &mut S) {} }

fn sink(s: S) {}

fn main() -> i32 {
    let a = [S { p: 1 }];
    sink(a[0]);
    return 0;
}
