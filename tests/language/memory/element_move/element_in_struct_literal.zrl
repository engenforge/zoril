// Moving a Drop element out of an array into a struct literal is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

struct S { p: i32 }
impl Drop for S { fn drop(self: &mut S) {} }
struct W { s: S }

fn main() -> i32 {
    let a = [S { p: 1 }];
    let w = W { s: a[0] };
    return 0;
}
