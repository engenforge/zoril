// Assigning a Vec slice element by value to a local is rejected.
// expected compile fail
// EXPECT: cannot move out of an array or slice element

import "vec.zrl";
use vec::Vec;

fn g(a: [Vec<i32>]) { let mut x = Vec::<i32>.new(); x = a[0]; }

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(1);
    let mut a = [v];
    g(&a);
    a[0].free();
    return 0;
}
