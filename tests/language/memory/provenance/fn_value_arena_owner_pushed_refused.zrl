// A `Vec` a `fn` value builds in the local arena it is handed holds what that argument reaches, the
// arena's Frame, so pushing it into a parameter is refused (§3, _Calls through a `fn` value_; the
// `fn`-value twin of push_arena_vec_refused.zrl). The refusal rests on the result's O: it holds
// with the result's S reduced to fresh storage of this frame (Z-0092's review).
// flags: --provenance
// EXPECT: call store rule
// expected compile fail
import "vec.zrl";
import "mem.zrl";
use vec::Vec;
use mem::Arena;
fn mk_vec(a: &Arena) -> Vec<i32> { let mut v = Vec::<i32>.new_in(a); v.push(1); return v; }
fn f(out: &mut Vec<Vec<i32>>) {
    let a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return; } };
    let g: fn(&Arena) -> Vec<i32> = mk_vec;
    let w = g(&a);
    out.push(w);
}
fn main() -> i32 { let mut v: Vec<Vec<i32>> = Vec.new(); f(&mut v); return 0; }
