// The safe twin: the raw pointer names a local slot, so the frame address stays in the frame.
// flags: --provenance
// expected exit 0
struct S { p: *mut *i32 }
fn put(s: &S, r: &i32) { unsafe { *s.p = r as *i32; } }
fn main() -> i32 {
    let x = 42;
    let mut slot: *i32 = 0 as *i32;
    let s = S { p: &mut slot as *mut *i32 };
    put(&s, &x);
    return unsafe { *slot } - 42;
}
