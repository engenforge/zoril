// Some(view of a stack array) pushed into the caller's Vec: an enum payload carries the view (doc/design/provenance.md §3).
// EXPECT: call store rule
// expected compile fail
import "vec.zrl";
use vec::Vec;
import "core.zrl";
fn fill(out: &mut Vec<Option<[u8]>>) {
    let buf = [42 as u8; 16];
    let s: [u8] = &buf;
    out.push(Option.Some(s));
}
fn main() -> i32 { let mut v: Vec<Option<[u8]>> = Vec.new(); fill(&mut v); return 0; }
