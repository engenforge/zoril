// A `Vec` built by a callee in a local arena it reaches through two struct references, then
// stored out: the arena is what the second reference's field points to, a local, so the store is
// refused (§3, _Details the transfer needs_).
// flags: --provenance
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// expected compile fail
import "vec.zrl";
import "mem.zrl";
import "clone.zrl";
use vec::Vec;
use mem::Arena;
struct W { inner: &H }
struct H { a: &Arena }
fn mk(w: &W) -> Vec<i32> { let mut v = Vec::<i32>.new_in(w.inner.a); v.push(1); return v; }
fn bad(out: &mut Vec<i32>) { let ar = Arena.new(4096).unwrap(); let h = H { a: &ar }; let w = W { inner: &h }; let v = mk(&w); *out = v; }
fn main() -> i32 { let mut o = Vec::<i32>.new(); bad(&mut o); return 0; }
