// A frame address stored inside `unsafe` through a heap block from the allocator's null-arena
// path, and the block returned. Outside the provenance guarantee (safety_model.md §3.2,
// unsafe_policy.md §1); only the old region rule refuses this today. Flip to an accept test when
// the old region rule is retired.
// flags: --provenance
// expected compile fail
// EXPECT: region escape: a pointer to local stack storage is written to memory that outlives this function
import "mem_raw.zrl";
use mem_raw::{ArenaHeader, zoril_allocator_alloc};

fn f() -> *mut &i32 {
    let x = 5;
    let p = unsafe { zoril_allocator_alloc(0 as *mut ArenaHeader, 8 as u64) } as *mut &i32;
    unsafe { *p = &x; }
    return p;
}

fn main() -> i32 {
    let p = f();
    return 0;
}
