// gap_94's closure handed to a function that calls it: the closure rule reads one level through the
// environment for the target a capture names, so the global the captured raw pointer reaches is
// memory that outlives the frame (§3, _A closure made into a value_).
// EXPECT: provenance: the closure made here stores an address of this frame into memory that outlives it when it is called (closure rule)
// expected compile fail
static mut G: *i32 = 0 as *i32;
fn run(f: fn() -> unit) { f(); }
fn stash() {
    let x = 42;
    let r = &x;
    let gp = &mut G as *mut *i32;
    run(|| { unsafe { *gp = r as *i32; } });
}
fn main() -> i32 {
    stash();
    return 0;
}
