// A Vec holding a view of this frame, moved through an identity function into the caller's slot:
// still a store of this frame's address into memory that outlives it (Z-0083).
// flags: --provenance
// expected compile fail
// EXPECT: a value holding an address of this frame is stored into memory that outlives it (store rule)
import "vec.zrl";
use vec::Vec;

fn id(v: Vec<&i32>) -> Vec<&i32> {
    return v;
}

fn g(out: &mut Vec<&i32>) {
    let x = 5;
    let mut v = Vec::<&i32>.new();
    v.push(&x);
    *out = id(v);
}

fn main() -> i32 {
    let mut o = Vec::<&i32>.new();
    g(&mut o);
    return 0;
}
