// The unsafe twin of literal_beside_mut_ref_accepted: the callee stores a view of its own array
// through the `&mut` that sits beside a literal.
// expected compile fail
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
struct W { name: [u8], out: &mut [i32] }
fn inner(out: &mut [i32]) {
    let mine = [42, 7];
    let w = W { name: "lit", out: out };
    *w.out = &mine;
}
fn main() -> i32 {
    let mut s: [i32] = @slice(0 as *i32, 0);
    inner(&mut s);
    return s[0] - 42;
}
