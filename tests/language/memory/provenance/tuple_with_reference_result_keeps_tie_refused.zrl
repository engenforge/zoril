// A tuple of a count and a reference read through a reference to a tuple holding a local's
// address: the reference keeps the result tied, so storing it out is refused (§3, _Scalars, casts
// and `extern`_).
// flags: --provenance
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// expected compile fail
fn get(p: &(&i32, usize)) -> (usize, &i32) { return (p.1, p.0); }
fn bad(out: &mut &i32) {
    let x = 5;
    let t = (&x, 1 as usize);
    let r = get(&t);
    *out = r.1;
}
fn main() -> i32 { let y = 2; let mut o = &y; bad(&mut o); return *o; }
