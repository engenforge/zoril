// gap_64's safe twin: the closure stores the address its maker was handed into the global, and
// `main` hands it a static's, so no frame address reaches the global (§3, _A closure made into a
// value_).
// flags: --provenance
// expected exit 0
static mut G: *i32 = 0 as *i32;
static K: i32 = 7;
fn run(f: fn() -> unit) { f(); }
fn stash(p: &i32) {
    let r = p;
    run(|| { G = r as *i32; });
}
fn main() -> i32 {
    stash(&K);
    return 0;
}
