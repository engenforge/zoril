// A tuple built from a local's address and copied whole before its slot is overwritten: the copy
// keeps the placeholder, and storing it out is refused (§3, _Transfer_).
// flags: --provenance
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// expected compile fail
fn bad(out: &mut &i32, p: &i32) { let seed = 0; let mut t = (&seed, 1); let c = t; t.0 = p; *out = c.0; }
fn main() -> i32 { let y = 2; let mut o = &y; bad(&mut o, &y); return *o; }
