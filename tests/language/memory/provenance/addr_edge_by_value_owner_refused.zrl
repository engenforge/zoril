// An `addr` edge from a by-value owner keeps the owner's storage as an address: `keep` stores the
// buffer pointer of a `Buf` it then drops (freeing the buffer), so the caller's slot would dangle,
// and the call store rule refuses it. Before Z-0071 every ParamAddr edge dropped the argument's
// owned storage.
// flags: --provenance
// EXPECT: call store rule
// expected compile fail
import "mem_raw.zrl";
struct Buf { data: *mut u8 }
impl Buf {
    fn new() -> Buf {
        // SAFETY: a fresh 16-byte heap block, freed once by drop.
        return Buf { data: unsafe { mem_raw::heap_alloc(16 as u64) } };
    }
}
impl Drop for Buf {
    fn drop(self: &mut Buf) {
        // SAFETY: the block new allocated, freed once.
        unsafe { mem_raw::heap_free(self.data as *u8, 16 as u64); }
    }
}
fn keep(out: &mut *mut u8, b: Buf) { *out = b.data; }
fn f(out: &mut *mut u8) { let b = Buf.new(); keep(out, b); }
fn main() -> i32 { return 0; }
