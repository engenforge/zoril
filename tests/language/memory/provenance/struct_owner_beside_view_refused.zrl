// A struct holding an owner beside a view of a parameter's buffer, built in the callee and stored
// into the caller's slot: the view is an address of `v`'s buffer whatever the struct owns, and the
// call store rule refuses it (Z-0071's review, Z-0072). The old rules refuse it too; this test
// keeps the provenance refusal once they are deleted (Z-0012).
// flags: --provenance
// EXPECT: call store rule
// expected compile fail
import "vec.zrl";
use vec::Vec;
struct Both { own_v: Vec<i32>, view: [i32] }
fn leak_both(out: &mut Both, v: &Vec<i32>) {
    *out = Both { own_v: Vec::<i32>.new(), view: v.as_slice() };
}
fn f(out: &mut Both) { let mut v = Vec::<i32>.new(); v.push(7); leak_both(out, &v); }
fn main() -> i32 { return 0; }
