// A callee storing into a local struct's field through `&mut w`: the destination is Frame(w), and
// `w` holds no mutable handle, so a view of this frame's arena may go there (§3, _Destination
// reach_).
// flags: --provenance
// expected exit 0
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;
struct S { s: [u8] }
fn set_s(w: &mut S, s: [u8]) { w.s = s; }
fn main() -> i32 {
    let a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 2; } };
    let mut bytes = Vec::<u8>.new_in(&a);
    bytes.push(42 as u8);
    let arena_str = bytes.as_slice();
    let mut w = S { s: "" };
    set_s(&mut w, arena_str);
    return w.s[0] as i32 - 42;
}
