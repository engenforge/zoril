// A `Vec` built by a callee in a local arena it reaches through an `&Arena` held in a struct
// field, then stored out: the arena is what the field points to, a local, so the store is refused
// (§3, _Details the transfer needs_).
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// expected compile fail
import "vec.zrl";
import "mem.zrl";
import "clone.zrl";
use vec::Vec;
use mem::Arena;
struct H { a: &Arena }
fn mk(h: &H) -> Vec<i32> { let mut v = Vec::<i32>.new_in(h.a); v.push(1); return v; }
fn bad(out: &mut [i32]) { let ar = Arena.new(4096).unwrap(); let h = H { a: &ar }; let v = mk(&h); *out = v.as_slice(); }
fn main() -> i32 { let z = [0]; let mut o: [i32] = &z; bad(&mut o); return o[0]; }
