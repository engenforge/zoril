// gap_64 with the closure kept in a struct field and the struct handed to a function that calls it
// (§3, _A closure made into a value_).
// flags: --provenance
// EXPECT: provenance: the closure made here stores an address of this frame into a global when it is called (closure rule)
// expected compile fail
static mut G: *i32 = 0 as *i32;
struct S { f: fn() -> unit }
fn run(s: S) {
    let g = s.f;
    g();
}
fn stash() {
    let x = 42;
    let r = &x;
    let s = S { f: || { G = r as *i32; } };
    run(s);
}
fn main() -> i32 {
    stash();
    return 0;
}
