// A tuple parameter carrying both a `&mut fn` destination and the `fn` value stored into it: the
// field-insensitive summary stores the destination into itself, so the local holds its own
// address, but a `fn` value's environment is always a closure's tuple, so the call through it
// reaches nothing of this frame (§3, _Calls through a `fn` value_).
// expected exit 42
fn default_fn() -> i32 { return 0; }
fn twin_fn() -> i32 { return 42; }
fn stash_pair(p: (&mut fn() -> i32, fn() -> i32)) { *p.0 = p.1; }
fn route(out: &mut fn() -> i32, g: fn() -> i32) { stash_pair((out, g)); }
fn main() -> i32 {
    let mut dest_val: fn() -> i32 = default_fn;
    route(&mut dest_val, twin_fn);
    return dest_val();
}
