// A `fn` item passed where a callee calls it: the callee's edge into the `fn` argument's
// environment names no memory for a `fn` item, whose Static is its code, so frame addresses passed
// beside it are not stored into a global (§3, _Calls through a `fn` value_).
// flags: --provenance
// expected exit 0
fn pick(a: &i32, b: &i32) -> &i32 { return a; }
fn first(f: fn(&i32, &i32) -> &i32, a: &i32, b: &i32) -> &i32 { return f(a, b); }
fn main() -> i32 {
    let x = 1;
    let y = 2;
    let r = first(pick, &x, &y);
    return *r - 1;
}
