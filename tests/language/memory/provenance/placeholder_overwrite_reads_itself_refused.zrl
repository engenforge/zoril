// A slot overwritten by a value read from the same tuple's placeholder slot: the assignment reads
// the old value, so the local's address reaches the store (§3, _Transfer_).
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// expected compile fail
fn bad(out: &mut &i32, p: &i32) { let seed = 0; let mut t = (&seed, p); t.1 = t.0; *out = t.1; }
fn main() -> i32 { let y = 2; let mut o = &y; bad(&mut o, &y); return *o; }
