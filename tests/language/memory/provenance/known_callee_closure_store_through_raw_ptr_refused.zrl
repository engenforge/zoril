// gap_94: a closure stores a frame address through a captured raw pointer to a global. The store's
// target is the memory the capture's value names, so the caller reads one level through the
// capture's local, whose raw pointer reaches the global (§3, _Calls through a known callee_).
// EXPECT: provenance: the callee stores an address of this frame into memory that outlives it (call store rule)
// expected compile fail
static mut G: *i32 = 0 as *i32;
fn stash() {
    let x = 42;
    let r = &x;
    let gp = &mut G as *mut *i32;
    let cl = || { unsafe { *gp = r as *i32; } };
    cl();
}
fn main() -> i32 {
    stash();
    return 0;
}
