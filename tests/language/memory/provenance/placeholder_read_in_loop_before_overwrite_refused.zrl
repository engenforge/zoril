// A tuple built in a loop from a local's address and stored out before its slot is overwritten in
// the same iteration: refused (§3, _Transfer_).
// flags: --provenance
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// expected compile fail
fn bad(out: &mut &i32, p: &i32) { let seed = 0; let mut i = 0; while i < 2 { let mut t = (&seed, 1); if i == 1 { *out = t.0; } t.0 = p; i = i + 1; } }
fn main() -> i32 { let y = 2; let mut o = &y; bad(&mut o, &y); return *o; }
