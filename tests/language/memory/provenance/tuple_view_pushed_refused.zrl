// A tuple element carries the view of a stack array into the caller's Vec (doc/design/provenance.md §3).
// EXPECT: call store rule
// expected compile fail
import "vec.zrl";
use vec::Vec;
fn fill(out: &mut Vec<([u8], i32)>) {
    let buf = [42 as u8; 16];
    let s: [u8] = &buf;
    out.push((s, 1));
}
fn main() -> i32 { let mut v: Vec<([u8], i32)> = Vec.new(); fill(&mut v); return 0; }
