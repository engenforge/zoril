// A `#[borrows(..)]` that names less than the body returns is refused: `view` returns a slice
// `s` holds, so a caller holding no borrow of `s` could let the result outlive it (§3, _Checked
// contracts_, tier 2). A reviewed narrowing is spelled `#[unsafe(borrows(..))]`.
// EXPECT: provenance: #[borrows(..)] leaves out 's', which the result may point into
// expected compile fail

struct S { a: [u8] }

#[borrows()]
fn view(s: &S) -> [u8] { return s.a; }

fn main() -> i32 {
    let s = S { a: "hi" };
    return view(&s).len as i32 - 2;
}
