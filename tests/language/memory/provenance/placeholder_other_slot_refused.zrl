// One slot of a two-element array overwritten at a constant index: the other still holds the
// local's address, and storing it out is refused (§3, _Transfer_).
// flags: --provenance
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// expected compile fail
fn bad(out: &mut &i32, p: &i32) { let seed = 0; let mut a = [&seed, &seed]; let k = 0; a[k] = p; *out = a[1]; }
fn main() -> i32 { let y = 2; let mut o = &y; bad(&mut o, &y); return *o; }
