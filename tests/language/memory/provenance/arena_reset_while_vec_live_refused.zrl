// A local Arena reset while a Vec in it is still used: the borrow rules refuse the reset; the
// arena being this frame's storage (Z-0076) changes nothing here.
// flags: --provenance
// expected compile fail
// EXPECT: cannot mutably borrow 'a' while it is already borrowed
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn main() -> i32 {
    let mut a = Arena.new(4096).unwrap();
    let mut v = Vec::<u64>.new_in(&a);
    v.push(1 as u64);
    a.reset();
    v.push(2 as u64);
    return 0;
}
