// A tuple slot built from a local's address, read through a reborrow of a `&mut` to the tuple and
// stored out before the slot is overwritten: refused (§3, _Transfer_).
// EXPECT: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// expected compile fail
fn bad(out: &mut &i32, p: &i32) { let seed = 0; let mut t = (&seed, 1); let r = &mut t; let r2 = &mut *r; *out = r2.0; t.0 = p; }
fn main() -> i32 { let y = 2; let mut o = &y; bad(&mut o, &y); return *o; }
