// A Vec clone still holds what the original holds: it is made in the original's arena, so
// resetting that arena while the clone lives is refused.
// expected compile fail
// EXPECT: cannot mutably borrow 'a' while it is already borrowed
import "vec.zrl";
import "clone.zrl";
import "mem.zrl";
use vec::Vec;
use mem::Arena;

fn main() -> i32 {
    let mut a = Arena.new(4096).unwrap();
    let mut v = Vec::<u8>.new_in(&a);
    v.push(1);
    let c = v.clone();
    a.reset();
    return c.len() as i32;
}
