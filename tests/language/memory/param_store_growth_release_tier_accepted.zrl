// Release-tier twin of gap_87: pushing after *out = v.as_slice() is growth, not a release
// (Vec.push keeps the old buffer), so the store-then-push is accepted.
// expected exit 0
import "vec.zrl";
use vec::Vec;

fn store_then_push(out: &mut [i32], v: &mut Vec<i32>) {
    *out = v.as_slice();
    v.push(1);
}

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut s: [i32] = @slice(0 as *i32, 0);
    store_then_push(&mut s, &mut v);
    let diff = s[0] - 42;
    v.free();
    return diff;
}
