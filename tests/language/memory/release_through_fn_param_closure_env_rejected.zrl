// Regression test: os_unknown_call_effects must include ParamContents for the closure
// environment argument so `fn run(f: fn()) { f(); }` records `releases 0` and refuses
// calling `run(|| { v.free(); })` while `v` has a live release-tier borrow.
// expected compile fail
// EXPECT: cannot mutably borrow 'v' while it is already borrowed
import "vec.zrl";
use vec::Vec;

fn run(f: fn()) {
    f();
}

fn store_and_kill(out: &mut [i32], v: &mut Vec<i32>) {
    *out = v.as_slice();
    run(|| { v.free(); });
}

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut s: [i32] = @slice(0 as *i32, 0);
    store_and_kill(&mut s, &mut v);
    return s[0] - 42;
}
