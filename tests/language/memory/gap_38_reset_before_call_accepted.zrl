// Reset-before-call twin of gap_38: resetting the arena before storing the view through
// set_fn(&mut w, v.as_slice()) leaves w reading only the post-reset allocation and is accepted.
// expected exit 0
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct W { s: [i32], t: i32, }

fn mk() -> W { return W { s: @slice(0 as *i32, 0), t: 0 }; }

fn set_fn(w: &mut W, s: [i32]) { w.s = s; }

fn main() -> i32 {
    let mut a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut w = mk();
    a.reset();
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    set_fn(&mut w, v.as_slice());
    return w.s[0] - 42;
}
