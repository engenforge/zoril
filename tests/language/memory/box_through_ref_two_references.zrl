// A field read or write through a reference to a Box reaches the boxed value, not the Box's own slot.
struct Point { x: i64, y: i64 }

fn read(p: &&Box<Point>) -> i64 {
    return p.y;
}

fn main() -> i32 {
    let b = box Point { x: 20, y: 22 };
    let r = &b;
    let rr = &r;
    if read(rr) != 22 { return 1; }
    return 0;
}
