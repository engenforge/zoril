// Regression test: check_call_ptr_releases must check closure environments even when the
// callee is a projected place (e.g. a struct field holding a closure).
// expected compile fail
// EXPECT: cannot mutably borrow 'v' while it is already borrowed
import "vec.zrl";
use vec::Vec;

struct Runner {
    f: fn(),
}

fn store_and_kill(out: &mut [i32], v: &mut Vec<i32>) {
    *out = v.as_slice();
    let r = Runner { f: || { v.free(); } };
    (r.f)();
}

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut s: [i32] = @slice(0 as *i32, 0);
    store_and_kill(&mut s, &mut v);
    return s[0] - 42;
}
