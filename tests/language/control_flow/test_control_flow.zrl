fn test_if(b: bool) -> i32 {
    if b {
        return 0;
    } else {
        return 1;
    }
}

fn test_while() -> i32 {
    let mut i = 0;
    while i < 2 {
        if i == 1 { return 0; }
        i = i + 1;
    }
    return 1;
}

fn test_for() -> i32 {
    let mut total = 0;
    for i in 0..10 {
        total += i;
    }
    if total != 45 {
        return total;
    }
    return 0;
}

fn test_for_range() -> i32 {
    let start = 0;
    let end = 10;
    let mut total = 0;
    for i in start..end {
        total += i;
    }
    if total != 45 {
        return total;
    }
    return 0;
}

fn main() -> i32 {
    if test_if(true) != 0 { return 1; }
    if test_while() != 0 { return 2; }
    if test_for() != 0 { return 3; }
    if test_for_range() != 0 { return 4; }
    return 0;
}
