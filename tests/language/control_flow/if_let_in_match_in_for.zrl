// expected exit 0
// An `if let` in a `match` arm inside a `for` loop (range-for and iterator-for) inside a
// function returning a non-unit value (`i32`). The loop body is in statement position, so
// the match does not inherit the enclosing function's return type.
// Also covers match and if expressions returning unit `()`, as well as diverging loops
// (`loop {}`, `while true {}`) in value-position arms and branches.

enum Option<T> {
    Some(T),
    None,
}

fn get_val(i: i32) -> Option<i32> {
    if i == 1 {
        return Option.Some(42);
    }
    return Option.None;
}

fn test_range_for() -> i32 {
    let mut sum = 0;
    for i in 0..3 {
        match i {
            1 => {
                if let Option.Some(x) = get_val(i) {
                    sum = sum + x;
                }
            }
            _ => {}
        }
    }
    return sum;
}

fn test_iter_for(slice: [i32]) -> i32 {
    let mut sum = 0;
    for x in slice {
        match *x {
            1 => {
                if let Option.Some(v) = get_val(*x) {
                    sum = sum + v;
                }
            }
            _ => {}
        }
    }
    return sum;
}

fn dummy() {}

fn test_unit_match(i: u32) -> () {
    match i {
        1 => {
            dummy();
        }
        _ => {}
    }
}

fn test_unit_let(i: u32) {
    let u: () = match i {
        1 => {},
        _ => {}
    };
    let u2: () = if i == 1 { () } else { () };
}

fn test_diverging_loop(i: u32) -> i32 {
    match i {
        1 => { return 7; },
        2 => { loop {} },
        3 => { while true {} },
        _ => 42
    }
}

fn test_diverging_if(c: bool) -> i32 {
    if c { loop {} } else { 1 }
}

fn main() -> i32 {
    if test_range_for() != 42 {
        return 1;
    }
    let arr = [0, 1, 2];
    if test_iter_for(&arr) != 42 {
        return 2;
    }
    test_unit_match(1);
    test_unit_match(2);
    test_unit_let(1);
    test_unit_let(2);
    if test_diverging_loop(1) != 7 {
        return 3;
    }
    if test_diverging_loop(0) != 42 {
        return 4;
    }
    if test_diverging_if(false) != 1 {
        return 5;
    }
    return 0;
}
