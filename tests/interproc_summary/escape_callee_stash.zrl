// expected compile fail
// flags: --interproc-summary
// EXPECT: error: provenance: the returned value holds an address of this frame (return rule)
// Interprocedural summary pass test: callee stash escape

struct S { a: i32 }

fn stash(p: *mut S) -> *mut S {
    return p;
}

fn leak() -> *mut S {
    let mut s = S { a: 42 as i32 };
    return stash(&mut s);
}

fn main() -> i32 {
    let p = leak();
    if unsafe { (*p).a } != 42 as i32 {
        return 1;
    }
    return 0;
}
