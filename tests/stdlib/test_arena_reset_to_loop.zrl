import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn main() -> i32 {
    let mut a = match Arena.new(65536) {
        Ok(arena) => arena,
        Err(_) => { return 1; },
    };

    let mut i = 0;
    while i < 10 {
        let mut v_pre = Vec::<u64>.new_in(&a);
        v_pre.push(42);
        let m = a.mark();
        let mut tmp = Vec::<u64>.new_in(&a);
        tmp.push(100 + i as u64);
        tmp.push(200 + i as u64);
        if tmp.len() != 2 {
            return 2;
        }
        a.reset_to(m);
        if v_pre.len() != 1 || v_pre[0] != 42 {
            return 3;
        }
        i = i + 1;
    }

    return 0;
}
