// Tests basic Vec<T> operations without an explicit arena (global allocator).
// Vec.new() should work with no arguments, using the global allocator.

import "vec.zrl";
use vec::Vec;

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(10);
    v.push(20);
    v.push(30);

    if v.len() != 3 as u64 { return 1; }

    let first = *v.get(0 as u64).unwrap();
    if first != 10 { return 2; }

    let second = *v.get(1 as u64).unwrap();
    if second != 20 { return 3; }

    let third = *v.get(2 as u64).unwrap();
    if third != 30 { return 4; }

    return 0;
}
