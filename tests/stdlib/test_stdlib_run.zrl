// Test stdlib combined

struct ArenaHeader {
    start: *u8,
    offset: u64,
    capacity: u64
}

pub fn arena_init(capacity: u64) -> Box<ArenaHeader> {
    let start_ptr = unsafe { @syscall(9, 0, capacity, 3, 0x22, 0xFFFFFFFFFFFFFFFF, 0) as *u8 };
    let mut a = box ArenaHeader {
        start: start_ptr,
        offset: 0,
        capacity: capacity
    };
    return a;
}

pub fn zoril_allocator_alloc(arena: &mut ArenaHeader, size: u64) -> *u8 {
    if (arena as u64) == 0 {
        return unsafe { @syscall(9, 0, size, 3, 0x22, 0xFFFFFFFFFFFFFFFF, 0) as *u8 };
    }
    if arena.offset + size > arena.capacity {
        return 0 as *u8;
    }
    let ptr = (arena.start as u64 + arena.offset) as *u8;
    arena.offset = arena.offset + size;
    return ptr;
}

fn arena_free(arena: &mut ArenaHeader) {
    unsafe { @syscall(11, arena.start as u64, arena.capacity) };
}

fn write(fd: u64, buf: &[u8]) -> i64 {
    let p = buf.ptr;
    let l = buf.len as u64;
    return unsafe { @syscall(1, fd, p, l) } as i64;
}

fn read(fd: u64, buf: [mut u8]) -> i64 {
    let p = buf.ptr;
    let l = buf.len as u64;
    return unsafe { @syscall(0, fd, p, l) } as i64;
}

fn exit(code: u64) {
    unsafe { @syscall(60, code) };
}

fn main() -> i32 {
    let mut arena = arena_init(1024);
    let mut res = 0;
    if arena.capacity != 1024 {
        res = 1;
    } else if arena.offset != 0 {
        res = 1;
    }
    arena_free(&mut *arena);
    @drop(arena);
    return res;
}
