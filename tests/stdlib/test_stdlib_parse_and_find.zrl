// expected exit 0
// Tests for [u8]::parse_i64, [u8]::parse_u64, and find/find_byte on [u8] and Str.

import "string.zrl";
import "str.zrl";
use str::Str;

fn main() -> i32 {
    // 1. parse_i64 boundary & overflow tests
    let min_i64_str = "-9223372036854775808";
    match min_i64_str.parse_i64() {
        Option.Some(v) => {
            // i64::MIN = -9223372036854775807 - 1
            let expected = (0 as u64 -% 9223372036854775808 as u64) as i64;
            if v != expected { return 1; }
        },
        Option.None => { return 2; },
    }

    let max_i64_str = "9223372036854775807";
    match max_i64_str.parse_i64() {
        Option.Some(v) => {
            if v != 9223372036854775807 as i64 { return 3; }
        },
        Option.None => { return 4; },
    }

    if "-9223372036854775809".parse_i64().is_some() { return 5; }
    if "9223372036854775808".parse_i64().is_some() { return 6; }
    if "99999999999999999999".parse_i64().is_some() { return 7; }
    if "-99999999999999999999".parse_i64().is_some() { return 8; }

    // 2. parse_u64 boundary & overflow tests
    let max_u64_str = "18446744073709551615";
    match max_u64_str.parse_u64() {
        Option.Some(v) => {
            if v != 18446744073709551615 as u64 { return 9; }
        },
        Option.None => { return 10; },
    }

    if "18446744073709551616".parse_u64().is_some() { return 11; }
    if "99999999999999999999".parse_u64().is_some() { return 12; }

    match "+42".parse_u64() {
        Option.Some(v) => {
            if v != 42 as u64 { return 13; }
        },
        Option.None => { return 14; },
    }

    // 3. [u8]::find (subslice search)
    let s = "hello world";
    match s.find("world") {
        Option.Some(idx) => { if idx != 6 as usize { return 15; } },
        Option.None => { return 16; },
    }
    match s.find("") {
        Option.Some(idx) => { if idx != 0 as usize { return 17; } },
        Option.None => { return 18; },
    }
    if s.find("xyz").is_some() { return 19; }
    if s.find("hello world extra").is_some() { return 20; }

    // 4. [u8]::find_byte
    match s.find_byte('w' as u8) {
        Option.Some(idx) => { if idx != 6 as usize { return 21; } },
        Option.None => { return 22; },
    }
    if s.find_byte('z' as u8).is_some() { return 23; }

    // 5. Str::find (UTF-8 subslice search)
    let st = @str("café au lait");
    match st.find("fé") {
        Option.Some(idx) => { if idx != 2 as usize { return 24; } },
        Option.None => { return 25; },
    }
    match st.find("") {
        Option.Some(idx) => { if idx != 0 as usize { return 26; } },
        Option.None => { return 27; },
    }
    if st.find("tea").is_some() { return 28; }

    // Continuation byte in 'é' (0xC3 0xA9) must not match as a character boundary
    let cont_buf: [u8; 1] = [0xa9 as u8];
    let cont_slice: [u8] = &cont_buf;
    if st.find(cont_slice).is_some() { return 29; }

    return 0;
}
