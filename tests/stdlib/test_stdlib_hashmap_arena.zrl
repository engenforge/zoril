// HashMap's arena constructors, both entry points: the safe `new(&Arena)` path and the
// `unsafe fn new_raw` escape hatch the compiler and tools use.
// expected exit 0

import "hashmap.zrl";
import "mem.zrl";
use hashmap::HashMap;
use mem::{Arena, arena_raw};

fn main() -> i32 {
    let arena = Arena.new(65536).unwrap();

    let mut safe = HashMap::<u64, u64>.new(&arena);
    let k1 = 1 as u64;
    safe.insert(k1, 11 as u64);
    if *safe.get(&k1).unwrap() != 11 { return 1; }

    let mut raw = unsafe { HashMap::<u64, u64>.new_raw(arena_raw(&arena)) };
    let k2 = 2 as u64;
    raw.insert(k2, 22 as u64);
    if *raw.get(&k2).unwrap() != 22 { return 2; }

    // The table grows past its initial capacity through the same allocator.
    let mut grown = HashMap::<u64, u64>.new(&arena);
    let mut i = 0 as u64;
    while i < 64 {
        grown.insert(i, i * 3 as u64);
        i = i + 1;
    }
    let k63 = 63 as u64;
    if *grown.get(&k63).unwrap() != 189 { return 3; }
    return 0;
}
