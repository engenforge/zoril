// Clone duplicates explicitly and deeply; Copy names the types that duplicate
// implicitly. #[derive(Clone)] writes a struct's field-by-field clone.
// expected exit 0

import "clone.zrl";
import "string.zrl";
import "vec.zrl";
use string::String;
use vec::Vec;

#[derive(Clone)]
struct Named {
    name: String,
    id: i32,
}

#[derive(Clone)]
struct Pair<A, B> {
    first: A,
    second: B,
}

struct Coord { x: i32, y: i32 }

// Accepted: Coord owns nothing that implements Drop.
impl Copy for Coord {}

fn dup<T: Clone>(x: &T) -> T {
    return x.clone();
}

fn twice<T: Copy>(x: T) -> (T, T) {
    return (x, x);
}

fn main() -> i32 {
    let n = 5;
    if dup(&n) != 5 { return 1; }

    let mut s = String.new();
    s.push_str("ab");
    let mut c = s.clone();
    c.push_str("c");
    if s.as_slice() != "ab" || c.as_slice() != "abc" { return 2; }

    let mut words = Vec::<String>.new();
    words.push(s.clone());
    let mut copied = words.clone();
    copied.get_mut(0).unwrap().push_str("!");
    if words.get(0).unwrap().as_slice() != "ab" { return 3; }
    if copied.get(0).unwrap().as_slice() != "ab!" { return 4; }

    let maybe = Option.Some(s.clone());
    let maybe_copy = maybe.clone();
    if !maybe_copy.is_some() { return 5; }

    let a = Named { name: s.clone(), id: 7 };
    let mut b = a.clone();
    b.name.push_str("x");
    if a.name.as_slice() != "ab" || b.name.as_slice() != "abx" { return 6; }
    if b.id != 7 { return 7; }

    let p = Pair { first: 1, second: s.clone() };
    let q = p.clone();
    if q.first != 1 || q.second.as_slice() != "ab" { return 8; }

    let t = twice(3);
    if t.0 != 3 || t.1 != 3 { return 9; }
    let c = twice(Coord { x: 1, y: 2 });
    if c.0.x != 1 || c.1.y != 2 { return 10; }
    return 0;
}
