// `[u8].sub` clamps a length that runs past the end of the string, and the clamp must survive a
// length near usize's maximum: `start + len` used to wrap, which skipped it and returned a slice
// claiming 2^64-1 bytes. Covered by the stdlib-invariant tests in the safety model.
import "string.zrl";

fn main() -> i32 {
    let s: [u8] = "abcd";

    // A length past the end clamps to the rest of the string.
    let a = s.sub(1 as usize, 2 as usize);
    if a.len != 2 as usize { return 1; }
    if a[0 as usize] != 'b' as u8 { return 2; }

    // usize's maximum must clamp, not wrap.
    let b = s.sub(2 as usize, 18446744073709551615 as usize);
    if b.len != 2 as usize { return 3; }
    if b[0 as usize] != 'c' as u8 { return 4; }

    // A start past the end is the empty slice.
    let c = s.sub(9 as usize, 1 as usize);
    if c.len != 0 as usize { return 5; }

    return 0;
}
