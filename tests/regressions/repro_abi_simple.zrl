pub fn use_u64(v: u64) -> u64 {
    return v;
}
fn main() -> i32 {
    // Was `fn main() {}` -- the test could not fail. Now asserts the u64 makes
    // the round trip through the ABI intact, including the high word.
    if use_u64(0x1234_5678_9abc_def0) != 0x1234_5678_9abc_def0 { return 1; }
    return 0;
}
