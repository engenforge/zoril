import "vec.zrl";
import "mem_raw.zrl";
use mem_raw::arena_init;
use vec::Vec;

fn test_ref(v: &Vec<i32>) -> i32 {
    return (*v)[1];
}

pub fn main() -> i32 {
    let arena = unsafe { arena_init(65536) };
    let mut v = unsafe { Vec::<i32>.new_in_raw(arena) };
    v.push(10);
    v.push(20);
    v.push(30);

    if v[0] != 10 { return 1; }
    if v[1] != 20 { return 2; }
    if v[2] != 30 { return 3; }

    v[1] = 99;
    if v[1] != 99 { return 4; }

    let p: &i32 = &v[2];
    if *p != 30 { return 5; }

    let pm: &mut i32 = &mut v[0];
    *pm = 77;
    if v[0] != 77 { return 6; }

    if test_ref(&v) != 99 { return 7; }

    return 0;
}
