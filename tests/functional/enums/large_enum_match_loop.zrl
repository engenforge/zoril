// expected exit code: 0
import "io.zrl";
use io::print;
struct Large { a: u64, b: u64, c: u64, d: u64, e: u64 }
enum BigEnum { Small(u32), Large(Large) }
fn test_match(e: BigEnum) {
    match e {
        BigEnum.Small(s) => { print("Small\n"); },
        BigEnum.Large(l) => { if l.a == 42 as u64 {} else {} }
    }
}
fn main() -> i32 {
    let mut i = 0 as u64;
    while i < 100 as u64 {
        let e = BigEnum.Large(Large {
            a: 42 as u64,
            b: 1 as u64,
            c: 2 as u64,
            d: 3 as u64,
            e: 4 as u64
        });
        test_match(e);
        i += 1 as u64;
    }
    return 0;
}
