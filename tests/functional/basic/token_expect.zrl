// expected exit code: 0
import "io.zrl";
enum Token { Eof, KConst, KMut, KPub, KFn, KLet, KIf, KElse, KWhile, KFor, KReturn, KMatch, KImpl, Ident(u32), Int(u64), Float(f64), Plus, Minus, Star, Slash, Equal, EqualEqual, NotEqual, Less, Greater, Dot, Comma, Colon, Semi, Arrow, FatArrow, LParen, RParen, LBrace, RBrace, LBracket, RBracket }
impl Token {
    fn get_tag(self: &Token) -> u32 {
        match *self {
            Token.Eof => 0 as u32, Token.KConst => 1 as u32, Token.KMut => 2 as u32, Token.KPub => 3 as u32, Token.KFn => 4 as u32, Token.KLet => 5 as u32, Token.KIf => 6 as u32, Token.KElse => 7 as u32, Token.KWhile => 8 as u32, Token.KFor => 9 as u32, Token.KReturn => 10 as u32, Token.KMatch => 11 as u32, Token.KImpl => 12 as u32, Token.Ident(_) => 13 as u32, Token.Int(_) => 14 as u32, Token.Float(_) => 15 as u32,
            _ => 99 as u32,
        }
    }
}
fn expect(cur: Token, kind: Token) -> bool { return cur.get_tag() == kind.get_tag(); }
fn main() -> i32 {
    let t1 = Token.KConst;
    let t2 = Token.KConst;
    let t3 = Token.Int(12345 as u64);
    let t4 = Token.Int(99999 as u64);
    if expect(t1, t2) && expect(t3, t4) { return 0; } else { return 1; }
}
