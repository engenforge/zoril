// A private function whose first caller is a Drop impl's `drop`: `drop` is exported for the
// importer's drop glue, the callee stays local to this module.
pub static mut HITS: i32 = 0;
struct S { a: i32 }
impl Drop for S { fn drop(self: &mut S) { helper(); } }
fn helper() { HITS = HITS + 1; }
pub fn make() -> i32 {
    helper();
    let s = S { a: 1 };
    return s.a;
}
