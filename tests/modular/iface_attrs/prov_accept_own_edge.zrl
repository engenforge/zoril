// expected exit 0
// An owner moved into a caller's Vec through a callee read from the interface: its `own` edge
// (edge = 131) keeps the moved Vec's storage owned, so the call is accepted; read back as an `addr`
// edge, the storage would be an address of this frame and the call store rule would refuse it
// (Z-0071).
import "lib_summary.zrl";
import "vec.zrl";
use vec::Vec;

fn add_via(out: &mut Vec<Vec<i32>>) { let w = Vec::<i32>.new(); lib_summary::put_owned(out, w); }

fn main() -> i32 {
    let mut v: Vec<Vec<i32>> = Vec.new();
    add_via(&mut v);
    return v.len() as i32 - 1;
}
