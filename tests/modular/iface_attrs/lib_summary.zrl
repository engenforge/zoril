// Callees whose pairwise store edges and result origins `--provenance` reads from the interface
// (Z-0057); scripts/test_interface_attrs.sh checks the interface text and builds the prov_* programs.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

pub struct H { pub r: [i32], pub t: [i32] }
pub struct V { pub v: i32 }

pub fn forward(v: [i32]) -> [i32] { return v; }

// Two independent edges, a -> x and b -> y, not the product of the two masks.
#[stores(a -> x, b -> y)]
pub fn pair(a: [i32], b: [i32], x: &mut H, y: &mut H) { x.r = a; y.r = b; }

// A parameter stored into itself: its contents into its own memory.
pub fn same(x: &mut H) { x.r = x.t; }

// The result points into the parameter (ret_addr), not at what it holds (ret_contents).
pub fn fld(h: &V) -> &i32 { return &h.v; }
pub fn first(h: &H) -> [i32] { return h.r; }

// A result no parameter owns, so the caller treats it as fresh storage.
// A Static result: ret_flags = 1.
pub fn lit() -> [u8] { return "abc"; }

// A Raw result (`@ptr_from_int`): ret_flags = 8, so a caller still treats it as outside memory.
pub fn raw(n: u64) -> *mut *i32 { return @ptr_from_int<*mut *i32>(n); }

// A result no parameter owns, so the caller treats it as fresh storage.
pub fn fresh() -> Vec<i32> { return Vec::<i32>.new(); }

// Parameter 64 is stored through parameter 65: both share the overflow bit 63.
pub fn p65(x0: &[i32], x1: &[i32], x2: &[i32], x3: &[i32], x4: &[i32], x5: &[i32], x6: &[i32], x7: &[i32], x8: &[i32], x9: &[i32], x10: &[i32], x11: &[i32], x12: &[i32], x13: &[i32], x14: &[i32], x15: &[i32], x16: &[i32], x17: &[i32], x18: &[i32], x19: &[i32], x20: &[i32], x21: &[i32], x22: &[i32], x23: &[i32], x24: &[i32], x25: &[i32], x26: &[i32], x27: &[i32], x28: &[i32], x29: &[i32], x30: &[i32], x31: &[i32], x32: &[i32], x33: &[i32], x34: &[i32], x35: &[i32], x36: &[i32], x37: &[i32], x38: &[i32], x39: &[i32], x40: &[i32], x41: &[i32], x42: &[i32], x43: &[i32], x44: &[i32], x45: &[i32], x46: &[i32], x47: &[i32], x48: &[i32], x49: &[i32], x50: &[i32], x51: &[i32], x52: &[i32], x53: &[i32], x54: &[i32], x55: &[i32], x56: &[i32], x57: &[i32], x58: &[i32], x59: &[i32], x60: &[i32], x61: &[i32], x62: &[i32], x63: &[i32], x64: &[i32], out: &mut H) { out.r = *x64; }

// Fresh storage on one path and the arena's on the other: the result ties to `a`, and only
// ret_fresh tells a caller that it also owns storage of its own.
pub fn mix(a: &Arena, pick: bool) -> Vec<i32> {
    if pick { return Vec::<i32>.new_in(a); }
    return Vec::<i32>.new();
}

// An owner stored by value: an `own` edge (code 130 + 1), which a caller must read back as one.
pub fn put_owned(o: &mut Vec<Vec<i32>>, w: Vec<i32>) { o.push(w); }
