import "core.zrl";
import "mem_raw.zrl";
import "token.zrl";
import "intern.zrl";
import "lexer.zrl";
import "io.zrl";
import "fmt.zrl";
use intern::InternTable;
use io::{write, stdout};
use fmt::write_u64;
use lexer::Lexer;
use mem_raw::arena_init;

fn main(argc: i32, argv: **u8) -> i32 {
    let arena = unsafe { arena_init(1024 * 1024) };
    let table = unsafe { InternTable.new_raw(arena) };
    let mut lexer = Lexer.new(@slice(0 as *u8, 0 as usize), table, arena);
    
    let mut out = stdout();
    write(stdout(), "lexer.line = ");
    let _ = write_u64(&mut out, lexer.line as u64);
    write(stdout(), "\nlexer.col = ");
    let _ = write_u64(&mut out, lexer.col as u64);
    write(stdout(), "\n");
    return 0;
}
