// expected exit code: 0
//
// Exercises ZilParser::parse_type against the type grammar in
// doc/spec/intermediate_language.md S1, covering one case from each
// alternative in the `type` production: primitive, Ptr (with region
// annotation, which must be parsed and discarded), Slice, array, tuple,
// fn (variadic), user_type (with generic args), and var_type.

import "core.zrl";
import "mem_raw.zrl";
import "intern.zrl";
import "il_instr.zrl";
import "il_type.zrl";
import "il_cfg.zrl";
import "zil_parse.zrl";
import "io.zrl";
use il_cfg::ILModule;
use il_type::{ILPrimitive, ILType};
use intern::InternTable;
use io::{write, stdout};
use mem_raw::arena_init;
use zil_parse::ZilParser;

fn type_def_at(module: &ILModule, type_id: u32) -> ILType {
    let p = module.types.get(type_id as usize - 1).unwrap();
    return (*p).def;
}

fn main() -> i32 {
    let arena = unsafe { arena_init((1024 as u64) * 1024 * 64) };
    let mut table = unsafe { InternTable.new_raw(arena) };
    let module = unsafe { &mut *ILModule.new(arena, 0) };

    // primitive
    let mut p1 = ZilParser.new("u32", module, table);
    let t1 = p1.parse_type();
    match type_def_at(module, t1) {
        ILType.Primitive(prim) => {
            if prim.get_tag() != ILPrimitive.U32.get_tag() { return 1; }
        },
        _ => { return 2; },
    }

    // Ptr<T, region> -- region is parsed and discarded
    let mut p2 = ZilParser.new("Ptr<u8, 'r0>", module, table);
    let t2 = p2.parse_type();
    match type_def_at(module, t2) {
        ILType.Ptr(inner) => {
            match type_def_at(module, inner) {
                ILType.Primitive(prim) => {
                    if prim.get_tag() != ILPrimitive.U8.get_tag() { return 3; }
                },
                _ => { return 4; },
            }
        },
        _ => { return 5; },
    }

    // Slice<T, region>
    let mut p3 = ZilParser.new("Slice<bool, 'static>", module, table);
    let t3 = p3.parse_type();
    match type_def_at(module, t3) {
        ILType.Slice(s) => {
            match type_def_at(module, s.element) {
                ILType.Primitive(prim) => {
                    if prim.get_tag() != ILPrimitive.Bool.get_tag() { return 6; }
                },
                _ => { return 7; },
            }
        },
        _ => { return 8; },
    }

    // array
    let mut p4 = ZilParser.new("[u8; 16]", module, table);
    let t4 = p4.parse_type();
    match type_def_at(module, t4) {
        ILType.Array(a) => {
            if a.size != 16 { return 9; }
            match type_def_at(module, a.element) {
                ILType.Primitive(prim) => {
                    if prim.get_tag() != ILPrimitive.U8.get_tag() { return 10; }
                },
                _ => { return 11; },
            }
        },
        _ => { return 12; },
    }

    // tuple
    let mut p5 = ZilParser.new("(u32, bool)", module, table);
    let t5 = p5.parse_type();
    match type_def_at(module, t5) {
        ILType.Tuple(elems) => {
            if elems.len != 2 { return 13; }
            match type_def_at(module, elems[0 as usize]) {
                ILType.Primitive(prim) => {
                    if prim.get_tag() != ILPrimitive.U32.get_tag() { return 14; }
                },
                _ => { return 15; },
            }
            match type_def_at(module, elems[1 as usize]) {
                ILType.Primitive(prim) => {
                    if prim.get_tag() != ILPrimitive.Bool.get_tag() { return 16; }
                },
                _ => { return 17; },
            }
        },
        _ => { return 18; },
    }

    // variadic fn type
    let mut p6 = ZilParser.new("fn(i32, ...) -> bool", module, table);
    let t6 = p6.parse_type();
    match type_def_at(module, t6) {
        ILType.Fn(f) => {
            if !f.is_variadic { return 19; }
            if f.params.len != 1 { return 20; }
            match type_def_at(module, f.params[0 as usize]) {
                ILType.Primitive(prim) => {
                    if prim.get_tag() != ILPrimitive.I32.get_tag() { return 21; }
                },
                _ => { return 22; },
            }
            match type_def_at(module, f.ret_ty) {
                ILType.Primitive(prim) => {
                    if prim.get_tag() != ILPrimitive.Bool.get_tag() { return 23; }
                },
                _ => { return 24; },
            }
        },
        _ => { return 25; },
    }

    // user_type with generic args
    let mut p7 = ZilParser.new("T3<u32>", module, table);
    let t7 = p7.parse_type();
    match type_def_at(module, t7) {
        ILType.User(u) => {
            if u.id != 3 { return 26; }
            if u.type_args.len != 1 { return 27; }
            match type_def_at(module, u.type_args[0 as usize]) {
                ILType.Primitive(prim) => {
                    if prim.get_tag() != ILPrimitive.U32.get_tag() { return 28; }
                },
                _ => { return 29; },
            }
        },
        _ => { return 30; },
    }

    // var_type
    let mut p8 = ZilParser.new("Elem", module, table);
    let t8 = p8.parse_type();
    match type_def_at(module, t8) {
        ILType.Var(v) => {
            let s = table.lookup(v.name);
            if !is_str_eq(s, "Elem") { return 31; }
        },
        _ => { return 32; },
    }

    write(stdout(), "all parse_type cases passed\n");
    return 0;
}
