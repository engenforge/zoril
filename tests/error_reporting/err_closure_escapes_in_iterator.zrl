// expected compile fail
// EXPECT: region escape
// An iterator adapter holding a capturing closure cannot outlive the frame the closure's
// environment lives in.
import "iter.zrl";
import "vec.zrl";
use iter::{Map, VecIter};
use vec::Vec;
fn adder(v: &Vec<i32>, k: i32) -> Map<VecIter<i32>, i32> {
    return v.iter().map(|x: &i32| -> i32 { *x + k });
}
fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(1);
    return adder(&v, 2).fold(0, |a: i32, x: i32| -> i32 { a + x });
}
