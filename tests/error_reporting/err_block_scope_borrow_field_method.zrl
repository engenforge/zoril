// expected compile fail
// EXPECT: tests/error_reporting/err_block_scope_borrow_field_method.zrl:28:5: error: cannot let 'x' go out of scope while it is still borrowed

// A method reached through a field of `self`: `outer_get` hands back what `self.w.peek()` hands
// back, whose receiver is `self.w` - field steps from `self`, so an address into `self`'s own
// storage. The receiver's type is followed field by field to find `peek`.
struct W {
    inner: i32,
}

struct Outer {
    w: W,
}

impl W {
    fn peek(self: &W) -> &i32 { return &self.inner; }
}

impl Outer {
    fn outer_get(self: &Outer) -> &i32 { return self.w.peek(); }
}

fn main() -> i32 {
    let mut r: &i32 = &0;
    {
        let x = Outer { w: W { inner: 5 } };
        r = x.outer_get();
    }
    return *r;
}
