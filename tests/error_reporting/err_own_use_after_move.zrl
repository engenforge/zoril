// expected compile fail
// EXPECT: error: use of moved value
struct Data {
    x: i32,
    handle: Box<i32>,
}

fn main() -> i32 {
    let d = Data { x: 42, handle: box 0 };
    let y = d.handle; // Moves d (Data is non-copy due to Box field, handle is non-copy)
    let z = d.x; // Error: d was already moved!
    return 0;
}
