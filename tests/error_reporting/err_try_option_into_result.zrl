// `?` on an `Option` returns its `None`, which a `Result` cannot hold (probe gap_69).
import "core.zrl";
fn inner() -> Option<i32> { return Option.None; }
fn outer() -> Result<i32, i32> { let v = inner()?; return Result.Ok(v); }
fn main() -> i32 { return match outer() { Ok(v) => v, Err(_) => 1 }; }
