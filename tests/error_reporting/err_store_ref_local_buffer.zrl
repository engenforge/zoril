// expected compile fail
// EXPECT: error: cannot store 'v' a reference into storage owned by this frame (a collection, a box or an arena) cannot outlive the frame
// A reference into a local collection's or arena's buffer stored through a parameter or outliving place is rejected.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn store_out(out: &mut [i32]) {
    let a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => { return; }
    };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(7);
    *out = v.as_slice();
}

fn main() -> i32 {
    let e: [i32] = @slice(0 as *i32, 0);
    let mut s = e;
    store_out(&mut s);
    return 0;
}
