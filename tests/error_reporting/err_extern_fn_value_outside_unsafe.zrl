// A call through a `fn` value is never marked, so naming an `extern` as a value claims every call
// through it is sound, as `unsafe` does for an `unsafe fn` (gap_65, gap_67). Every site is listed.
extern fn external_add(a: i32, b: i32) -> i32;
struct H { f: fn(i32, i32) -> i32 }
fn call(f: fn(i32, i32) -> i32) -> i32 { return f(1, 2); }
fn ret() -> fn(i32, i32) -> i32 { return external_add; }
fn main() -> i32 {
    let mut f: fn(i32, i32) -> i32 = external_add;
    let h = H { f: external_add };
    let n = call(external_add);
    f = external_add;
    let g = external_add;
    let c = || -> fn(i32, i32) -> i32 { return external_add; };
    return 0;
}
