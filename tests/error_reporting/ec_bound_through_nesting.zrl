// expected compile fail
// EXPECT: tests/error_reporting/ec_bound_through_nesting.zrl:11:12: error: type `W<NoWrap>` does not implement trait `Wrap`
// The impl covers W<T> only when T: Wrap, so the call is rejected where it names the type.
trait Wrap { fn get(self: &Self) -> i32; }
struct W<T> { v: T }
impl<T: Wrap> Wrap for W<T> { fn get(self: &W<T>) -> i32 { return self.v.get() + 1; } }
struct NoWrap { x: i32 }
fn use_it<T: Wrap>(t: &T) -> i32 { return t.get(); }
fn main() -> i32 {
    let w = W { v: NoWrap { x: 1 } };
    return use_it(&w);
}
