// expected compile fail
// EXPECT: error: cannot mutably borrow 'a' while it is already borrowed
// A Vec built with `Vec::new_in(&arena)` holds the arena: resetting the arena while the
// Vec is live is a compile error (Stage 4 tie).
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn main() -> i32 {
    let mut a = Arena.new(65536).unwrap();
    let mut v = Vec::<u64>.new_in(&a);
    v.push(1);
    a.reset(); // @error "cannot mutably borrow 'a' while it is already borrowed"
    v.push(2);
    return 0;
}
