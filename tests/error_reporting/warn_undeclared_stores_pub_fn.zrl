// EXPECT: tests/error_reporting/warn_undeclared_stores_pub_fn.zrl:5:5: warning: this `pub fn` stores the reference parameter 'x' where its signature does not declare it; add `#[stores(x -> h)]`

struct H { p: &i32 }

pub fn put(h: &mut H, x: &i32) {
    h.p = x;
}

fn main() -> i32 {
    let a = 42;
    let mut h = H { p: &a };
    let b = 10;
    put(&mut h, &b);
    if *h.p != 10 { return 1; }
    return 0;
}
