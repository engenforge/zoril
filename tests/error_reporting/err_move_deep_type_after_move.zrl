// expected compile fail
// Probe 176 as a located test: the `Arena` is eleven struct levels down, past the recursion limit of
// `is_copy_type_internal`, so the value used to read as `Copy` and a second use of it was not a move.
// Its one-level sibling `struct Holder { a: Arena }` is rejected either way; the depth is the point.
// EXPECT: tests/error_reporting/err_move_deep_type_after_move.zrl:24:5: error: use of moved value 'v'
import "mem.zrl";
use mem::Arena;

struct L1 { a: Arena }
struct L2 { a: L1 }
struct L3 { a: L2 }
struct L4 { a: L3 }
struct L5 { a: L4 }
struct L6 { a: L5 }
struct L7 { a: L6 }
struct L8 { a: L7 }
struct L9 { a: L8 }
struct L10 { a: L9 }
struct L11 { a: L10 }

fn main() -> i32 {
    let v = L11 { a: L10 { a: L9 { a: L8 { a: L7 { a: L6 { a: L5 { a: L4 { a: L3 { a: L2 { a: L1 { a: Arena.new(4096).unwrap() } } } } } } } } } } };
    let w = v;
    let u = v;
    return 0;
}
