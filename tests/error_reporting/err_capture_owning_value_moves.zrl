// expected compile fail
// EXPECT: use of moved value 's'
// An owning value captured by a closure is moved into its environment, so the outer binding
// cannot be used afterwards (doc/spec/surface_syntax.md §5.2; probe 298).
import "string.zrl";
use string::String;

fn main() -> i32 {
    let mut s = String.new();
    s.push_str("abc");
    let f = || { return s.as_slice()[0] as i32; };
    let seen = f();
    return s.len() as i32 + seen;
}
