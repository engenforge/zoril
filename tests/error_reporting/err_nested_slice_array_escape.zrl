fn get_sub(s: [[u8]]) -> [[u8]] {
    return s;
}

fn main() -> i32 {
    let mut outer: [[u8]] = @slice(0 as *[u8], 0 as usize);
    {
        let s1: [u8] = "hello";
        let s2: [u8] = "world";
        let arr: [[u8]; 2] = [s1, s2];
        let s: [[u8]] = &arr;
        outer = get_sub(s);
    }
    return outer.len as i32;
}
