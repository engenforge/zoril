// expected compile fail
// The same through a reference. The lookup peels `&S` to `S` before reading the field, so the check has
// to peel too: answering only for a struct value left this crashing in the ZIL half.
// EXPECT: tests/error_reporting/err_unknown_field_through_reference.zrl:7:29: error: no field 'nope' on '&S'

struct S { a: i32 }
fn f(p: &S) -> i32 { return p.nope; }
fn main() -> i32 { let s = S { a: 1 }; return f(&s); }
