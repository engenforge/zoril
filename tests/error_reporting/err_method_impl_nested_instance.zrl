// expected compile fail
// EXPECT: tests/error_reporting/err_method_impl_nested_instance.zrl:9:55: error: `Outer<i32>` has no method `peek`: the impl that has one is for another instance of the type
// `impl<N> Outer<Box2<N>>` covers only Outers of a Box2; an Outer<i32> was passed to it as one.
struct Box2<T> { v: T }
struct Outer<T> { inner: T }
impl<N: Copy> Outer<Box2<N>> {
    fn peek(self: &Outer<Box2<N>>) -> N { return self.inner.v; }
}
fn main() -> i32 { let o = Outer { inner: 5 }; return o.peek(); }
