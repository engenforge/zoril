// expected compile fail
// EXPECT: cannot compare structs, tuples, arrays or payload-carrying enums with == or !=
// == on a struct compared addresses (or one word), not contents.
struct P { a: i64, b: i64, c: i64 }

fn main() -> i32 {
    let x = P { a: 1, b: 2, c: 3 };
    let y = P { a: 1, b: 2, c: 4 };
    if x == y { return 1; }
    return 0;
}
