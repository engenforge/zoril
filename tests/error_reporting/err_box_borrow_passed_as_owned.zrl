// EXPECT: note: a `Box<T>` owns what it points at, so a reference cannot stand in for one: pass an owned box (`box x`)

fn take(b: Box<i32>) -> i32 { return *b; }

fn main() -> i32 {
    let x: i32 = 7;
    let mut y: i32 = 8;
    return take(&x) + take(&mut y);
}
