// expected compile fail
// An owning capture moved into a multi-capturing closure leaves the outer binding unusable.
// EXPECT: error: use of moved value 'v'

import "vec.zrl";
use vec::Vec;

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    let n = 3;
    let mut f = |k: i32| {
        v.push(k + n);
    };
    f(1);
    v.push(2);
    return 0;
}
