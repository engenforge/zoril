// expected compile fail
// EXPECT: tests/error_reporting/err_arena_premark_bytevec_growth.zrl:16:5: error: cannot mutably borrow 'a' while it is already borrowed
import "mem.zrl";
import "bytevec.zrl";
use mem::Arena;
use bytevec::ByteVec;

fn main() -> i32 {
    let mut a = match Arena.new(65536) {
        Ok(arena) => arena,
        Err(_) => { return 1; },
    };
    let bv = ByteVec.new(&a);
    let m = a.mark();
    bv.push(42);
    a.reset_to(m);
    return bv.len() as i32;
}
