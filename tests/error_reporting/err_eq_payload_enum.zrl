// expected compile fail
// EXPECT: cannot compare structs, tuples, arrays or payload-carrying enums with == or !=
// == on an enum with payloads compared only the discriminant: Some(1) == Some(2).
enum O { Some(i32), None }

fn main() -> i32 {
    let a = O.Some(1);
    let b = O.Some(2);
    if a == b { return 1; }
    return 0;
}
