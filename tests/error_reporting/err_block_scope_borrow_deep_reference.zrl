// expected compile fail
// EXPECT: tests/error_reporting/err_block_scope_borrow_deep_reference.zrl:23:5: error: cannot let 'x' go out of scope while it is still borrowed

// The reference sits nine levels down, past the recursion limit of `type_holds_reference` (probe
// 174): the limit used to answer "cannot hold a reference", so the borrow was not propagated and
// `out` outlived `x`. Its siblings at one, three and eight levels were already rejected; what this
// pins is that the boundary no longer leaks.
struct S1 { r: &i32 }
struct S2 { s: S1 }
struct S3 { s: S2 }
struct S4 { s: S3 }
struct S5 { s: S4 }
struct S6 { s: S5 }
struct S7 { s: S6 }
struct S8 { s: S7 }
struct S9 { s: S8 }
fn main() -> i32 {
    let mut out: &i32 = &0;
    {
        let x: i32 = 7;
        let deep = S9 { s: S8 { s: S7 { s: S6 { s: S5 { s: S4 { s: S3 { s: S2 { s: S1 { r: &x } } } } } } } } };
        out = deep.s.s.s.s.s.s.s.s.r;
    }
    return *out;
}
