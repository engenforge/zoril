// expected compile fail
// EXPECT: #[borrows(..)] does not list a parameter this function returns a pointer into
// The attribute says the result points into b only; the body returns an address in a.
struct T { v: i32 }
#[borrows(b)]
fn pick(a: &T, b: &T) -> &i32 { return &a.v; }
fn main() -> i32 { let x = T { v: 1 }; let y = T { v: 2 }; return *pick(&x, &y); }
