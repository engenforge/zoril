// A match guard may borrow pattern bindings, never move out of them while the scrutinee
// still owns them.
// expected compile fail
// EXPECT: cannot move out of a pattern binding in a match guard
struct S { p: *mut u8 }
impl Drop for S {
    fn drop(self: &mut S) { unsafe { *self.p = *self.p + 1 as u8; } }
}
enum P { A(S, S), B }
fn f(e: P) {
    match e { P.A(s, _) if { let t = s; false } => {}, _ => {}, }
}
fn main() -> i32 { return 0; }
