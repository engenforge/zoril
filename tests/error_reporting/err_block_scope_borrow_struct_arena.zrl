// expected compile fail
// Probe 166 as a located test: `Holder` has no `Drop` impl of its own, but its field does, so the
// derived borrow cannot outlive it.
// EXPECT: tests/error_reporting/err_block_scope_borrow_struct_arena.zrl:21:5: error: cannot let 'h' go out of scope while it is still borrowed
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct Holder {
    a: Arena,
}

fn main() -> i32 {
    let mut out: Option<&u64> = Option.None;
    {
        let h = Holder { a: Arena.new(4096).unwrap() };
        let mut v = Vec::<u64>.new_in(&h.a);
        v.push(42 as u64);
        out = v.get(0 as u64);
    }
    return match out {
        Option.Some(r) => *r as i32,
        Option.None => 0,
    };
}
