// expected compile fail
// EXPECT: tests/error_reporting/err_method_impl_other_instance.zrl:7:57: error: `W<i64>` has no method `deref`: the impl that has one is for another instance of the type
// An impl for one instance (`W<&i32>`) has no methods for another (`W<i64>`). It was matched by
// the type's name alone, so this read the integer 4096 as a reference and dereferenced it.
struct W<T> { v: T }
impl W<&i32> { fn deref(self: &W<&i32>) -> i32 { return *self.v; } }
fn main() -> i32 { let w = W { v: 4096 as i64 }; return w.deref(); }
