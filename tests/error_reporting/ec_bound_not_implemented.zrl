// expected compile fail
// EXPECT: error: type `Plain` does not implement trait `Named`
trait Named { fn name(self: &Self) -> i32; }

struct Plain { x: i32 }

fn label<T: Named>(x: &T) -> i32 { return 1; }

fn main() -> i32 {
    let p = Plain { x: 1 };
    return label(&p); // @error "type `Plain` does not implement trait `Named`"
}
