// expected compile fail
// Returning a pointer to this frame's stack storage must be rejected.
// EXPECT: error: region escape: returning a pointer to local stack storage
struct S { a: i32 }
fn dangle() -> *mut S {
    let mut s = S { a: 1 as i32 };
    return &mut s;
}
fn main() -> i32 { let p = dangle(); return unsafe { (*p).a }; }
