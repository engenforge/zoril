// expected compile fail
// The derived-borrow half of the scope-end rule: `view(&h)` hands back a slice built from a
// pointer *loaded* out of `h` (`h.p`), so the callee's storage mask says it points into memory
// the argument reaches, not into the argument's own storage - the inherited borrow is derived.
// A derived borrow is exempt at the local's scope end unless the local frees storage, and
// `Holder` does through its `Arena` field. `type_has_drop` must follow the fields for that
// exemption to stay sound (mutation M95).
// EXPECT: tests/error_reporting/err_block_scope_borrow_struct_arena_derived.zrl:27:5: error: cannot let 'h' go out of scope while it is still borrowed
import "mem.zrl";
use mem::Arena;

struct Holder {
    a: Arena,
    p: *u8,
    n: usize,
}

fn view(h: &Holder) -> [u8] {
    return unsafe { @slice(h.p, h.n) };
}

fn main() -> i32 {
    let mut out: [u8] = @slice(0 as *u8, 0);
    {
        let h = Holder { a: Arena.new(4096).unwrap(), p: 0 as *u8, n: 0 as usize };
        out = view(&h);
    }
    return out.len as i32;
}
