// expected compile fail
// EXPECT: tests/error_reporting/err_closure_escapes_into_vec.zrl:6:47: error: region escape: a pointer to local stack storage is written to memory that outlives this function
// Pushing a capturing closure into the caller's Vec stores this frame's environment there.
import "vec.zrl";
use vec::Vec;
fn add(v: &mut Vec<fn(i32) -> i32>, k: i32) { v.push(|x: i32| -> i32 { x + k }); }
fn main() -> i32 { let mut v = Vec::<fn(i32) -> i32>.new(); add(&mut v, 5); return (*v.get(0 as usize).unwrap())(2); }
