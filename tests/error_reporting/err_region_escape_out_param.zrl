// expected compile fail
// EXPECT: error: provenance: a value holding an address of this frame is stored into memory that outlives it (store rule)
// Writing a local's address through an out-parameter leaves the caller holding it after return.
fn leak(out: &mut *mut i32) {
    let mut x: i32 = 42;
    *out = &mut x;
}
fn main() -> i32 {
    let mut p: *mut i32 = 0 as *mut i32;
    leak(&mut p);
    if p as usize == 0 as usize { return 1; }
    return 0;
}
