// expected compile fail
// EXPECT: tests/error_reporting/err_block_scope_borrow_aggregate_ref_field.zrl:18:5: error: cannot let 'x' go out of scope while it is still borrowed

// A struct literal that holds a reference to a local: `Holder { r: &x }` holds `x`'s own storage,
// and `y = h.r` outlives `x`. The construction cases recorded the inherited borrow as derived,
// which exempted it at `x`'s scope end (probe 172); the copy keeps the operand borrow's own flag
// now, so a field holding `&x` counts and a field holding what a call derived still does not.
struct Holder {
    r: &i32,
}

fn main() -> i32 {
    let mut y: &i32 = &0;
    {
        let x: i32 = 7;
        let h = Holder { r: &x };
        y = h.r;
    }
    return *y;
}
