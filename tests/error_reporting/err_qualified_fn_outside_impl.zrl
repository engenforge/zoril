// expected compile fail
// EXPECT: qualified function name: define methods inside an `impl` block
// A free function spelled `P::get` would otherwise silently replace the method below.
struct P { x: i64 }

impl P {
    pub fn get(self: &P) -> i64 { return self.x; }
}

fn P::get(p: &P) -> i64 { return 999; }

pub fn main() -> i32 {
    let p = P { x: 5 };
    return p.get() as i32;
}
