// Moving a non-Copy part out of a value whose type implements Drop is rejected: it would consume
// the outer value and skip its Drop impl.
// expected compile fail
// EXPECT: cannot move out of type
struct S { p: *mut u8 }
impl Drop for S {
    fn drop(self: &mut S) { unsafe { *self.p = *self.p + 1 as u8; } }
}
enum D { A(S), B }
impl Drop for D {
    fn drop(self: &mut D) {}
}
enum N { A(D), B }
enum NS { A(S), B }
enum D2 { A(NS), B }
impl Drop for D2 {
    fn drop(self: &mut D2) {}
}
struct WD { s: S }
impl Drop for WD {
    fn drop(self: &mut WD) {}
}

fn direct_match(d: D) {
