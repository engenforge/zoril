}
fn nested_drop_outer(d2: D2) {
    match d2 { D2.A(NS.A(s)) => {}, D2.A(NS.B) => {}, D2.B => {}, }
}
fn in_if_let(d: D) {
    if let D.A(s) = d { let x = 1; }
}
fn in_while_let(mut d: D) {
    while let D.A(s) = d { d = D.B; }
}
fn struct_match(w: WD) {
    match w { WD { s: s } => {}, }
}
