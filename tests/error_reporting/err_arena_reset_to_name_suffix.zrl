// expected compile fail
// EXPECT: tests/error_reporting/err_arena_reset_to_name_suffix.zrl:22:5: error: cannot mutably borrow 'ma' while it is already borrowed
// A user-defined type ending with "Arena" that implements `reset_to` must not
// receive the epoch exemption reserved for stdlib `mem::Arena`.
import "mem.zrl";
import "vec.zrl";
use mem::{Arena, ArenaMark};
use vec::Vec;

struct MyArena { inner: Arena }

impl MyArena {
    fn mark(self: &MyArena) -> ArenaMark { return self.inner.mark(); }
    fn reset_to(self: &mut MyArena, m: ArenaMark) { self.inner.reset(); }
}

fn main() -> i32 {
    let mut ma = MyArena { inner: Arena.new(65536 as u64).unwrap() };
    let mut v = Vec::<u64>.new_in(&ma.inner);
    v.push(7 as u64);
    let m = ma.mark();
    ma.reset_to(m);
    let mut w = Vec::<u64>.new_in(&ma.inner);
    w.push(99 as u64);
    return v.as_slice()[0] as i32;
}
