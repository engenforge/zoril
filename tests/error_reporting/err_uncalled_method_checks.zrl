// module that did not write it). The accepted twin is
// tests/language/structs/uncalled_method_checked.zrl.
struct S { a: i32 }
impl S {
    fn never_called(self: &S) -> i32 {
        return self.nope + undefined_name;
    }
}

fn main() -> i32 {
    return 0;
}
