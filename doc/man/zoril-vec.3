.SH NAME
.PP
zoril\-vec \- Growable generic arrays (Vec) with arena and allocator support
.PP
.SH SYNOPSIS
.PP
\fBimport\fR "vec.\&zrl";
.PP
.nf
.RS 4
pub struct Vec<T> {
