// The lexer: source bytes to tokens. It also collects `//` comment blocks, which the parser
// attaches to the declaration that follows them.

import "core.zrl";
import "intern.zrl";
import "bytevec.zrl";
import "token.zrl";
import "ast.zrl";
import "decimal.zrl";
import "mem_raw.zrl";
import "vec.zrl";
use ast::Span;
use bytevec::ByteVec;
use decimal::decimal_to_f64;
use intern::InternTable;
use mem_raw::ArenaHeader;
use token::{NO_SUFFIX, RESERVED_BASE, Token, TokenKind, TokenWithSpan};
use vec::Vec;

pub struct Lexer {
    pub source: [u8],
    pub pos: u64,
    pub line: u32,
    pub col: u32,
    pub intern_table: *mut InternTable,
    pub arena: *mut ArenaHeader,
    pub pending_block: u32, // the `//` block read since the last blank line or token
    pub module_doc: u32,    // the first comment block, if a blank line follows it before any token
    pub token_count: u32,
    // `pending_block` as it was when the token just returned was lexed: the parser reads it
    // after `next_token`, which has already cleared `pending_block` unless the token can
    // start a declaration.
    pub last_lexed_comment: u32,
    // Where every comment is (`//` and `/* */`, delimiters included), when set: the
    // formatter keeps them. Null for the compiler.
    pub comment_sink: *mut Vec<Span>,
}

impl Lexer {
    // The table and the arena are kept as raw pointers, which hold no reference, so the only
    // parameter the result points into is the source buffer.
    #[borrows(source)]
    pub fn new(source: [u8], table: &mut InternTable, arena: *mut ArenaHeader) -> Lexer {
        return Lexer {
            source: source,
            pos: 0 as u64,
            line: 1 as u32,
            col: 1 as u32,
            intern_table: table as *mut InternTable,
            arena: arena,
            pending_block: 0 as u32,
            module_doc: 0 as u32,
            token_count: 0 as u32,
            last_lexed_comment: 0 as u32,
            comment_sink: 0 as *mut Vec<Span>,
        };
    }

    pub fn next_token(self: &mut Lexer) -> TokenWithSpan {
        self.skip_whitespace();
        let start = self.pos;
        let line = self.line;
        let col = self.col;
        let token = if self.at_end() { Token.Eof } else { self.lex_token(start) };
        self.token_count = self.token_count + 1 as u32;
        self.last_lexed_comment = self.pending_block;
        if !is_decl_start_token(token.kind()) {
            self.pending_block = 0 as u32;
        }
        return TokenWithSpan {
            token: token,
            span: Span { start: start as u32, end: self.pos as u32, line: line, col: col }
        };
    }

    fn lex_token(self: &mut Lexer, start: u64) -> Token {
        let c = self.advance();
        return match c {
            '(' => Token.LParen,
            ')' => Token.RParen,
            '{' => Token.LBrace,
            '}' => Token.RBrace,
            '[' => Token.LBracket,
            ']' => Token.RBracket,
            ',' => Token.Comma,
            ';' => Token.Semi,
            '?' => Token.Question,
            '@' => Token.At,
            '#' => Token.Hash,
            ':' => { if self.eat(':') { Token.DoubleColon } else { Token.Colon } },
            '.' => {
                if !self.eat('.') {
                    Token.Dot
                } else if self.eat('.') {
                    Token.DotDotDot
                } else {
                    Token.DotDot
                }
            },
            '=' => {
                if self.eat('=') {
                    Token.EqualEqual
                } else if self.eat('>') {
                    Token.FatArrow
                } else {
                    Token.Equal
                }
            },
            '!' => { if self.eat('=') { Token.BangEqual } else { Token.Bang } },
            '+' => self.arith_op(
                Token.Plus,
                Token.PlusEqual,
                Token.PlusPercent,
                Token.PlusPercentEqual
            ),
            '-' => {
                if self.eat('>') {
                    Token.Arrow
                } else {
                    self.arith_op(
                        Token.Minus,
                        Token.MinusEqual,
                        Token.MinusPercent,
                        Token.MinusPercentEqual
                    )
                }
            },
            '*' => self.arith_op(
                Token.Star,
                Token.StarEqual,
                Token.StarPercent,
                Token.StarPercentEqual
            ),
            '/' => { if self.eat('=') { Token.SlashEqual } else { Token.Slash } },
            '%' => { if self.eat('=') { Token.PercentEqual } else { Token.Percent } },
            '^' => { if self.eat('=') { Token.CaretEqual } else { Token.Caret } },
            '<' => {
                if self.eat('=') {
                    Token.LessEqual
                } else if self.eat('<') {
                    if self.eat('=') { Token.LessLessEqual } else { Token.LessLess }
                } else {
                    Token.Less
                }
            },
            '>' => {
                if self.eat('=') {
                    Token.GreaterEqual
                } else if self.eat('>') {
                    if self.eat('=') { Token.GreaterGreaterEqual } else { Token.GreaterGreater }
                } else {
                    Token.Greater
                }
            },
            '&' => {
                if self.eat('&') {
                    Token.AmpAmp
                } else if self.eat('=') {
                    Token.AmpEqual
                } else {
                    Token.Amp
                }
            },
            '|' => {
                if self.eat('|') {
                    Token.PipePipe
                } else if self.eat('=') {
                    Token.PipeEqual
                } else {
                    Token.Pipe
                }
            },
            '_' => { if self.at_ident_char() { self.lex_word(start) } else { Token.Underscore } },
            '0'..='9' => self.lex_number(start, c),
            'a'..='z' | 'A'..='Z' => {
                if c == 'r' as u8 && self.eat('"') {
                    self.lex_raw_string()
                } else {
                    self.lex_word(start)
                }
            },
            '"' => self.lex_string(),
            '\'' => self.lex_char(),
            _ => Token.Invalid(0 as u32),
        };
    }

    // `+`, `+=`, `+%` or `+%=` (and the same for `-` and `*`), the operator's first byte read.
    fn arith_op(
        self: &mut Lexer,
        plain: Token,
        assign: Token,
        wrapping: Token,
        wrapping_assign: Token
    ) -> Token {
        if self.eat('=') { return assign; }
        if !self.eat('%') { return plain; }
        return if self.eat('=') { wrapping_assign } else { wrapping };
    }

    // ── Bytes ───────────────────────────────────────────────────────────────

    fn at_end(self: &Lexer) -> bool {
        return self.pos >= self.source.len;
    }

    // The byte OFFSET bytes ahead, or 0 past the end.
    fn peek(self: &Lexer, offset: u64) -> u8 {
        if self.pos + offset >= self.source.len { return 0 as u8; }
        return self.source[self.pos + offset];
    }

    fn advance(self: &mut Lexer) -> u8 {
        if self.at_end() { return 0 as u8; }
        let c = self.source[self.pos];
        self.pos = self.pos + 1 as u64;
        if c == '\n' as u8 {
            self.line = self.line + 1 as u32;
            self.col = 1 as u32;
        } else {
            self.col = self.col + 1 as u32;
        }
        return c;
    }

    // Consumes the next byte if it is C.
    fn eat(self: &mut Lexer, c: u8) -> bool {
        if self.at_end() || self.source[self.pos] != c { return false; }
        self.advance();
        return true;
    }

    fn at_ident_char(self: &Lexer) -> bool {
        return !self.at_end()
            && (is_alpha(self.source[self.pos]) || is_digit(self.source[self.pos]));
    }

    // A view of the source text, read into the compilation's arena and never freed while it runs,
    // so it outlives the lexer and a caller may intern while holding it (reviewed in 2i.13).
    #[borrows()]
    fn text_from(self: &Lexer, start: u64) -> [u8] {
        return subslice(self.source, start as usize, (self.pos - start) as usize);
    }

    fn intern(self: &mut Lexer, s: [u8]) -> u32 {
        return unsafe { (*self.intern_table).intern(s) };
    }

    // ── Words and literals ──────────────────────────────────────────────────

    // A keyword or an identifier, its first byte read.
    fn lex_word(self: &mut Lexer, start: u64) -> Token {
        while self.at_ident_char() { self.advance(); }
        let word = self.text_from(start);
        if word == "fn" { return Token.KFn; }
        if word == "struct" { return Token.KStruct; }
        if word == "enum" { return Token.KEnum; }
        if word == "trait" { return Token.KTrait; }
        if word == "impl" { return Token.KImpl; }
        if word == "let" { return Token.KLet; }
        if word == "mut" { return Token.KMut; }
        if word == "if" { return Token.KIf; }
        if word == "else" { return Token.KElse; }
        if word == "match" { return Token.KMatch; }
        if word == "while" { return Token.KWhile; }
        if word == "for" { return Token.KFor; }
        if word == "loop" { return Token.KLoop; }
        if word == "unsafe" { return Token.KUnsafe; }
        if word == "in" { return Token.KIn; }
        if word == "return" { return Token.KReturn; }
        if word == "break" { return Token.KBreak; }
        if word == "continue" { return Token.KContinue; }
        if word == "defer" { return Token.KDefer; }
        if word == "type" { return Token.KType; }
        if word == "pub" { return Token.KPub; }
        if word == "extern" { return Token.KExtern; }
        if word == "box" { return Token.KBox; }
        if word == "try" { return Token.KTry; }
        if word == "sizeof" { return Token.KSizeof; }
        if word == "alignof" { return Token.KAlignof; }
        if word == "as" { return Token.KAs; }
        if word == "const" { return Token.KConst; }
        if word == "static" { return Token.KStatic; }
        if word == "import" { return Token.KImport; }
        if word == "use" { return Token.KUse; }
        if word == "true" { return Token.Bool(true); }
        if word == "false" { return Token.Bool(false); }
        // Reserved for a future feature, never an identifier (token.zrl RESERVED_BASE).
        if word == "async" {
            return Token.Invalid(RESERVED_BASE);
        }
        if word == "await" { return Token.Invalid(RESERVED_BASE + 1 as u32); }
        if word == "dyn" { return Token.Invalid(RESERVED_BASE + 2 as u32); }
        if word == "move" { return Token.Invalid(RESERVED_BASE + 3 as u32); }
        if word == "where" { return Token.Invalid(RESERVED_BASE + 4 as u32); }
        if word == "yield" { return Token.Invalid(RESERVED_BASE + 5 as u32); }
        if word == "macro" { return Token.Invalid(RESERVED_BASE + 6 as u32); }
        if word == "union" { return Token.Invalid(RESERVED_BASE + 7 as u32); }
        if word == "super" { return Token.Invalid(RESERVED_BASE + 8 as u32); }
        return Token.Ident(self.intern(word));
    }

    // A number, its first digit read: `0x`, `0b` and `0o` integers, decimal integers, and
    // decimal floats (`1.5`, but `1..` is an integer and a range).
    fn lex_number(self: &mut Lexer, start: u64, first: u8) -> Token {
        if first == '0' as u8 {
            if self.eat('x') { return self.lex_radix_int(16 as u64); }
            if self.eat('b') { return self.lex_radix_int(2 as u64); }
            if self.eat('o') { return self.lex_radix_int(8 as u64); }
        }
        let mut val = (first - '0' as u8) as u64;
        while self.at_digit_or_underscore() {
            let c = self.advance();
            if c != '_' as u8 { val = val * 10 +% (c - '0' as u8) as u64; }
        }
        if self.peek(0 as u64) != '.' as u8 || !is_digit(self.peek(1 as u64)) {
            return Token.Int((val, self.lex_numeric_suffix()));
        }
        self.advance();
        let mut fraction_digits = 0 as i32;
        while self.at_digit_or_underscore() {
            if self.advance() != '_' as u8 { fraction_digits = fraction_digits + 1; }
        }
        let mut digits = unsafe { ByteVec.new_raw(self.arena) };
        for c in self.text_from(start) {
            if is_digit(*c) { digits.push(*c); }
        }
        let value = decimal_to_f64(digits.as_slice(), 0 - fraction_digits, self.arena);
        return Token.Float((value, self.lex_numeric_suffix()));
    }

    fn at_digit_or_underscore(self: &Lexer) -> bool {
        return !self.at_end()
            && (is_digit(self.peek(0 as u64)) || self.peek(0 as u64) == '_' as u8);
    }

    // The digits of a `0x` / `0b` / `0o` integer, its prefix read.
    fn lex_radix_int(self: &mut Lexer, radix: u64) -> Token {
        let mut val = 0 as u64;
        while !self.at_end() {
            let c = self.peek(0 as u64);
            if c != '_' as u8 {
                let digit = digit_value(c);
                if digit >= radix { break; }
                val = val * radix +% digit;
            }
            self.advance();
        }
        return Token.Int((val, self.lex_numeric_suffix()));
    }

    // A type suffix right after a number (`10u8`): its ILPRIM_* tag (the order below), or
    // NO_SUFFIX (consuming nothing) when the word that follows is not one.
    fn lex_numeric_suffix(self: &mut Lexer) -> u32 {
        let start = self.pos;
        let mut end = start;
        while end < self.source.len && (is_alpha(self.source[end]) || is_digit(self.source[end])) {
            end = end + 1 as u64;
        }
        let word = subslice(self.source, start as usize, (end - start) as usize);
        let suffixes = [
            "u8",
            "u16",
            "u32",
            "u64",
            "usize",
            "i8",
            "i16",
            "i32",
            "i64",
            "isize",
            "f32",
            "f64"
        ];
        let mut index = 0 as u32;
        for suffix in suffixes {
            if word == *suffix {
                while self.pos < end { self.advance(); }
                return index;
            }
            index = index + 1 as u32;
        }
        return NO_SUFFIX;
    }

    // `"..."`, its opening quote read; Invalid(1) if it is not closed.
    fn lex_string(self: &mut Lexer) -> Token {
        let mut decoded = unsafe { ByteVec.new_raw(self.arena) };
        while !self.at_end() && self.peek(0 as u64) != '"' as u8 {
            let c = self.advance();
            if c == '\\' as u8 { decoded.push(self.lex_escape() as u8); } else { decoded.push(c); }
        }
        if !self.eat('"') { return Token.Invalid(1 as u32); }
        return Token.String(self.intern(decoded.as_slice()));
    }

    // `r"..."`, its `r"` read: no escapes. Invalid(1) if it is not closed.
    fn lex_raw_string(self: &mut Lexer) -> Token {
        let start = self.pos;
        while !self.at_end() && self.peek(0 as u64) != '"' as u8 { self.advance(); }
        let text = self.text_from(start);
        if !self.eat('"') { return Token.Invalid(1 as u32); }
        return Token.String(self.intern(text));
    }

    // `'c'`, its opening quote read. The closing quote is optional.
    fn lex_char(self: &mut Lexer) -> Token {
        let mut val = 0 as u32;
        if !self.at_end() {
            let c = self.advance();
            val = if c == '\\' as u8 { self.lex_escape() } else { c as u32 };
        }
        self.eat('\'');
        return Token.Char(val);
    }

    // The byte an escape stands for, its backslash read: `\n`, `\t`, `\r`, `\0`, `\xHH`
    // (two bytes taken as hex digits), and any other byte for itself (`\\`, `\"`, `\'`).
    fn lex_escape(self: &mut Lexer) -> u32 {
        if self.at_end() { return 0 as u32; }
        let e = self.advance();
        return match e {
            'n' => 10 as u32,
            't' => 9 as u32,
            'r' => 13 as u32,
            '0' => 0 as u32,
            'x' => {
                let mut val = 0 as u32;
                for _digit in 0..2 {
                    if !self.at_end() {
                        val = val * 16 as u32 + hex_digit_val(self.advance()) as u32;
                    }
                }
                val
            },
            _ => e as u32,
        };
    }

    // ── Whitespace and comments ─────────────────────────────────────────────

    // Skips whitespace and comments. `//` lines accumulate into `pending_block`; a blank line
    // drops it (saving it as `module_doc` if no token has been read yet).
    fn skip_whitespace(self: &mut Lexer) {
        let mut newlines = 0;
        while !self.at_end() {
            let c = self.peek(0 as u64);
            if c == ' ' as u8 || c == '\t' as u8 || c == '\r' as u8 {
                self.advance();
            } else if c == '\n' as u8 {
                self.advance();
                newlines = newlines + 1;
                if newlines >= 2 {
                    if self.token_count == 0 as u32
                        && self.module_doc == 0 as u32
                        && self.pending_block != 0 as u32 {
                        self.module_doc = self.pending_block;
                    }
                    self.pending_block = 0 as u32;
                }
            } else if c == '/' as u8 && self.peek(1 as u64) == '/' as u8 {
                newlines = 0;
                let start = self.pos;
                self.skip_line_comment();
                self.note_comment(start);
            } else if c == '/' as u8 && self.peek(1 as u64) == '*' as u8 {
                let start = self.pos;
                self.skip_block_comment();
                self.note_comment(start);
            } else {
                break;
            }
        }
    }

    fn note_comment(self: &mut Lexer, start: u64) {
        if self.comment_sink as usize == 0 as usize { return; }
        unsafe {
            (*self.comment_sink).push(Span {
                start: start as u32,
                end: self.pos as u32,
                line: 0 as u32,
                col: 0 as u32
            });
        }
    }

    // `// text`: appends `text` (without one leading space) to `pending_block`.
    fn skip_line_comment(self: &mut Lexer) {
        self.advance();
        self.advance();
        self.eat(' ');
        let start = self.pos;
        while !self.at_end() && self.peek(0 as u64) != '\n' as u8 { self.advance(); }
        let mut block = unsafe { ByteVec.new_raw(self.arena) };
        if self.pending_block != 0 as u32 {
            block.push_slice(unsafe { (*self.intern_table).lookup(self.pending_block) });
            block.push('\n' as u8);
        }
        block.push_slice(self.text_from(start));
        self.pending_block = self.intern(block.as_slice());
    }

    // `/* ... */`, which nests.
    fn skip_block_comment(self: &mut Lexer) {
        self.advance();
        self.advance();
        let mut depth = 1;
        while self.pos + 1 as u64 < self.source.len && depth > 0 {
            if self.peek(0 as u64) == '*' as u8 && self.peek(1 as u64) == '/' as u8 {
                depth = depth - 1;
                self.advance();
                self.advance();
            } else if self.peek(0 as u64) == '/' as u8 && self.peek(1 as u64) == '*' as u8 {
                depth = depth + 1;
                self.advance();
                self.advance();
            } else {
                self.advance();
            }
        }
    }
}

// Tokens that can begin a declaration; a comment block before one is kept for it.
fn is_decl_start_token(kind: TokenKind) -> bool {
    return match kind {
        TokenKind.KFn
            | TokenKind.KStruct
            | TokenKind.KEnum
            | TokenKind.KTrait
            | TokenKind.KImpl
            | TokenKind.KType
            | TokenKind.KPub
            | TokenKind.KExtern
            | TokenKind.KConst
            | TokenKind.KStatic
            | TokenKind.KImport
            | TokenKind.KUse
            | TokenKind.Hash
            | TokenKind.Eof
            | TokenKind.KLoop => true,
        _ => false,
    };
}

// A digit's value in bases up to 16, or 255 for a byte that is not one.
fn digit_value(c: u8) -> u64 {
    if is_digit(c) || (c >= 'a' as u8 && c <= 'f' as u8) || (c >= 'A' as u8 && c <= 'F' as u8) {
        return hex_digit_val(c) as u64;
    }
    return 255 as u64;
}
