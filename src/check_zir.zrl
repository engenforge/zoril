// Zoril ZIR Borrow Checker

import "diag.zrl";
import "zir.zrl";
import "ast.zrl";
import "intern.zrl";
import "vec.zrl";
import "mem_raw.zrl";
import "io.zrl";
import "fmt.zrl";
import "il_type.zrl";
import "il_cfg.zrl";
import "bytevec.zrl";
import "route_set.zrl";
use ast::Span;
use bytevec::ByteVec;
use diag::diag_start;
use il_cfg::{ILFunction, ILModule};
use il_type::{is_raw_pointer_tag, is_reference_tag, type_name_is, ILPRIM_BOOL, ILPRIM_CHAR, ILPRIM_F32, ILPRIM_I16, ILPRIM_I32, ILPRIM_I8, ILPRIM_NEVER, ILPRIM_U16, ILPRIM_U32, ILPRIM_U8, ILPRIM_UNIT, ILPRIM_USIZE, ILTYPE_ARRAY, ILTYPE_BOXED, ILTYPE_BOXEDMUT, ILTYPE_FD, ILTYPE_FN, ILTYPE_IORING, ILTYPE_PRIMITIVE, ILTYPE_PTR, ILTYPE_PTRMUT, ILTYPE_RAWPTR, ILTYPE_RAWPTRMUT, ILTYPE_SLICE, ILTYPE_TUPLE, ILTYPE_USER, ILType, ILTypeDecl, IL_TYPEDEF_ENUM, IL_TYPEDEF_STRUCT, is_any_pointer_tag, is_mut_pointer_tag, is_shared_pointer_tag};
use intern::InternTable;
use io::{eprint, stderr};
use fmt::write_u64;
use mem_raw::{ArenaHeader, memcpy, memset, zoril_allocator_alloc};
use vec::Vec;
use route_set::{ROUTE_BACKEDGE, ROUTE_JOIN, ROUTE_RV_BASE, ROUTE_RV_REF, ROUTE_RV_REFMUT, route_bit, rv_bit, stmt_bit, term_bit};
use zir::{LOCAL_KIND_LET, LOCAL_KIND_TMP, Local, PROJ_DEREF, PROJ_FIELD, PROJ_INDEX, PROJ_TUPLEINDEX, Place, Projection, ZirBlock, ZirFunction, ZirModule, ZirRvalue, ZirStmt, ZirTerminator};

pub struct ActiveBorrow {
    pub base: Place,
    pub is_mut: bool,
    pub region: u32,
    pub borrower: u32,
    pub span: Span, // where the borrow was taken, for "note: borrow of 'x' taken here"
    // Inherited by a call's or literal's result from its inputs (inherit_rv_borrows) rather
    // than taken by `&`/`&mut`. It only counts once a named local holds it: in a compiler
    // temporary it lives within one statement (`v.set(j, v.as_slice()[k])`).
    pub derived: bool,
    // Whether this borrow is of BORROWER's own referent (`&x` held by a reference local), as
    // opposed to one inherited from a value the borrower was built from. Structural provenance,
    // replacing the type comparison `is_direct_referent_borrow` used to guess it (which could not
    // tell a same-type indirect borrow, and could not see through a field or element step).
    pub direct: bool,
    pub epoch: u32,
    // The routes that carried this borrow to its current holder: the rvalue that created it, the
    // rvalue at every propagation step, and the cfg:join / cfg:backedge flags the borrow crossed.
    // Bookkeeping only - no accept/reject decision reads it. `report_borrow_conflict` adds it to
    // the verifier's `reject_via` set, which `--emit-zir-stats` prints.
    pub via: u64,
}

pub struct EnumPayloadAlias {
    pub local_id: u32,
    pub source: Place,
}

pub struct MarkInfo {
    pub mark_local: u32,
    pub arena_base: u32,
    pub epoch: u32,
}

// compute_liveness: no successor block.
const NO_SUCC: usize = 0xffffffffffffffff;

// A local's ownership state.
pub const OWN_UNINIT: u8 = 0;
pub const OWN_OWNED: u8 = 1;
pub const OWN_MOVED: u8 = 2;  // moved on some path (maybe_live: still owned on another)
pub const OWN_DROPPED: u8 = 3;

pub struct ZirAnalysisState {
    pub ownership: [mut u8], // len = locals_len + 1
    // Moved, but still owned on some path into here (the merge of a moved and an owned
    // state). For a linear resource that means it is not closed on every path.
    pub maybe_live: [mut bool], // len = locals_len + 1
    pub borrows: Vec<ActiveBorrow>,
    pub enum_aliases: Vec<EnumPayloadAlias>,
    pub mark_infos: Vec<MarkInfo>,
}

impl ZirAnalysisState {
    #[stores(arena -> arena)]
    pub fn clone(
        self: &ZirAnalysisState,
        arena: *mut ArenaHeader,
        locals_len: usize
    ) -> *mut ZirAnalysisState {
        let dest = unsafe {
            zoril_allocator_alloc(arena, sizeof(ZirAnalysisState))
        } as *mut ZirAnalysisState;
        let own_ptr = unsafe { zoril_allocator_alloc(arena, locals_len + 1) } as *mut u8;
        let own = unsafe { @slice(own_ptr, locals_len + 1 as usize) };
        let ml_ptr = unsafe { zoril_allocator_alloc(arena, locals_len + 1) } as *mut bool;
        let ml = unsafe { @slice(ml_ptr, locals_len + 1 as usize) };
        unsafe {
            memcpy(own_ptr, self.ownership.ptr as *u8, (locals_len + 1) as u64);
            memcpy(ml_ptr as *mut u8, self.maybe_live.ptr as *u8, (locals_len + 1) as u64);
        }

        let mut bor = unsafe { self.borrows.clone_in_raw(arena) };
        let mut ea = unsafe { self.enum_aliases.clone_in_raw(arena) };
        let mut mi = unsafe { self.mark_infos.clone_in_raw(arena) };

        unsafe {
            *dest = ZirAnalysisState {
                ownership: own,
                maybe_live: ml,
                borrows: bor,
                enum_aliases: ea,
                mark_infos: mi,
            };
        }
        return dest;
    }
}

pub struct ZirVerifier {
    pub arena: *mut ArenaHeader,
    pub module: &mut ZirModule,
    pub zil_module: &mut ILModule,
    pub intern_table: &mut InternTable,
    pub had_error: bool,
    pub reporting_enabled: bool,
    // Set by place_last_deref_is_readonly: the read-only layer was a `[T]` slice.
    pub readonly_is_slice: bool,
    pub file_path: [u8],
    // Non-lexical borrows: which locals are used again after the statement being
    // checked (bit per local id; null = treat every local as live). A borrow counts only
    // while its borrower is live, so `let r = v.get(0); use(r); v.push(1);` is accepted.
    pub live_words: usize,
    pub live_out: *mut u64,   // per block: live after its terminator's successors begin
    pub live_rows: *mut u64,  // the current block: row k = live after statement k
    pub live_rows_cap: usize,
    pub cur_live: *mut u64,
    pub next_borrow_epoch: u32,
    // The body being verified. `write_local_name` reads its `Let` statements for the span that
    // produced a compiler temporary, so a diagnostic never has to print an internal id.
    pub cur_blocks: [ZirBlock],
    // The routes a reported rejection travelled through: the union of the conflicting borrow's
    // `via` and the rvalue/statement/terminator being checked when the error was reported. Only
    // accumulated while `reporting_enabled` is true (the fixed-point pass sees no errors).
    pub reject_via: u64,
    // The current rvalue, statement and terminator route bits, set by the check_* entry points
    // so a report can say where it happened. A terminator check clears the statement bit, and
    // vice versa.
    pub cur_rv: u64,
    pub cur_stmt: u64,
    pub cur_term: u64,
}

impl ZirVerifier {
    pub fn new(
        arena: *mut ArenaHeader,
        module: &mut ZirModule,
        zil_module: &mut ILModule,
        intern_table: &mut InternTable
    ) -> ZirVerifier {
        return ZirVerifier {
            arena: arena,
            module: module,
            zil_module: zil_module,
            intern_table: intern_table,
            had_error: false,
            reporting_enabled: false,
            readonly_is_slice: false,
            file_path: "",
            live_words: 0 as usize,
            live_out: 0 as *mut u64,
            live_rows: 0 as *mut u64,
            live_rows_cap: 0 as usize,
            cur_live: 0 as *mut u64,
            next_borrow_epoch: 1 as u32,
            cur_blocks: unsafe { @slice(0 as *mut ZirBlock, 0 as usize) },
            reject_via: 0 as u64,
            cur_rv: 0 as u64,
            cur_stmt: 0 as u64,
            cur_term: 0 as u64,
        };
    }

    fn diag_file(self: &ZirVerifier) -> [u8] {
        return if self.file_path.len > 0 as usize { self.file_path } else { "unknown" };
    }

    fn report_error(self: &mut ZirVerifier, msg: [u8], span: Span) {
        self.had_error = true;
        if !self.reporting_enabled { return; }

        diag_start(self.diag_file(), span, "error");
        eprint(msg);
        eprint("\n");
    }

    fn report_var_error(
        self: &mut ZirVerifier,
        msg_pre: [u8],
        local_id: u32,
        msg_post: [u8],
        span: Span,
        locals: [Local]
    ) {
        self.had_error = true;
        if !self.reporting_enabled { return; }

        diag_start(self.diag_file(), span, "error");
        eprint(msg_pre);
        eprint(" '");
        self.write_local_name(local_id, locals);
        eprint("'");

        if msg_post.len > 0 as usize {
            eprint(" ");
            eprint(msg_post);
        }
        eprint("\n");
    }

    // Prints a local's declared name, or "variable (id: N)" if it has none (a compiler-generated
    // temporary). Shared by `report_var_error` and `write_place_path` below so the two spellings
    // of "which local" never drift apart.
    fn write_local_name(self: &ZirVerifier, local_id: u32, locals: [Local]) {
        let mut found = false;
        let mut name_id = 0 as u32;
        let mut closure_line = 0 as u32;
        let mut closure_col = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == local_id {
                name_id = locals[li].name_id;
                closure_line = locals[li].closure_span.line;
                closure_col = locals[li].closure_span.col;
                found = true;
                break;
            }
            li = li + 1 as usize;
        }

        if found && name_id != 0 as u32 {
            eprint(self.intern_table.lookup(name_id));
        } else if found && closure_line != 0 as u32 {
            // The compiler-generated local behind a capturing closure is its environment. Name
            // the closure the user wrote, not an internal temporary id.
            eprint("the environment of the closure created at ");
            let mut err = stderr();
            let _ = write_u64(&mut err, closure_line as u64);
            eprint(":");
            let _ = write_u64(&mut err, closure_col as u64);
        } else {
            // A compiler temporary. Name the expression whose value it holds - the span on the
            // `Let` that produced it - so the message says where to look even though the local
            // has no name in the source. An id is the last resort, and the error-reporting
            // tests reject it in a committed expectation.
            let mut origin = Span {
                start: 0 as u32,
                end: 0 as u32,
                line: 0 as u32,
                col: 0 as u32
            };
            let mut have_origin = false;
            let mut bi = 0 as usize;
            while bi < self.cur_blocks.len && !have_origin {
                let b = &self.cur_blocks[bi];
                let mut si = 0 as usize;
                while si < b.statements.len {
                    match b.statements[si] {
                        ZirStmt.Let(target, _, stmt_span) => {
                            if target == local_id && stmt_span.line != 0 as u32 {
                                origin = stmt_span;
                                have_origin = true;
                                break;
                            }
                        },
                        _ => {},
                    }
                    si = si + 1 as usize;
                }
                bi = bi + 1 as usize;
            }
            if have_origin {
                eprint("the value of the expression at ");
                let mut err = stderr();
                let _ = write_u64(&mut err, origin.line as u64);
                eprint(":");
                let _ = write_u64(&mut err, origin.col as u64);
            } else {
                eprint("a temporary");
            }
        }
    }

    // Prints a place's user-facing path -- the base local's name, followed by a `.field` or `.N`
    // for each `Field`/`TupleIndex` projection, stopping at the first `Deref`/`Index` (neither has
    // a stable "friendly" spelling the way a field name does: `*p` and `arr[i]` don't name one
    // fixed piece of storage). This is what lets a borrow conflict on `self.resolver` read as
    // exactly that, rather than as `self` -- which reads as if the whole struct conflicted, not
    // one field of it.
    fn write_place_path(self: &ZirVerifier, place: &Place, locals: [Local]) {
        self.write_local_name(place.base, locals);
        let mut pi = 0 as usize;
        while pi < place.projections.len {
            let proj = &place.projections[pi];
            let tag = proj.get_tag();
            if tag == PROJ_FIELD {
                eprint(".");
                eprint(self.intern_table.lookup(proj.get_Field()));
            } else if tag == PROJ_TUPLEINDEX {
                eprint(".");
                let mut err = stderr();
                let _ = write_u64(&mut err, proj.get_TupleIndex() as u64);
            } else {
                return;
            }
            pi = pi + 1 as usize;
        }
    }

    // Same shape as `report_var_error`, but for a full `&Place` (base + projections) rather than
    // a bare local id, so a conflict on one field of a struct doesn't get spelled as if the
    // struct itself were the point of conflict.
    fn report_place_error(
        self: &mut ZirVerifier,
        msg_pre: [u8],
        place: &Place,
        msg_post: [u8],
        span: Span,
        locals: [Local]
    ) {
        self.had_error = true;
        if !self.reporting_enabled { return; }

        diag_start(self.diag_file(), span, "error");
        eprint(msg_pre);
        eprint(" '");
        self.write_place_path(place, locals);
        eprint("'");

        if msg_post.len > 0 as usize {
            eprint(" ");
            eprint(msg_post);
        }
        eprint("\n");
    }

    // `report_place_error` plus a second `note:` line naming *where* the conflicting borrow was
    // taken -- without it, a programmer sees that something conflicts but not which borrow, or
    // where. `conflicting`/`conflict_span` are the overlapping `ActiveBorrow`'s own `base`/`span`.
    fn report_borrow_conflict(
        self: &mut ZirVerifier,
        msg_pre: [u8],
        place: &Place,
        msg_post: [u8],
        span: Span,
        conflicting: &Place,
        conflict_span: Span,
        conflict_via: u64,
        locals: [Local]
    ) {
        self.report_place_error(msg_pre, place, msg_post, span, locals);
        if !self.reporting_enabled { return; }

        // Record the routes this rejection travelled through: where the borrow was created and
        // carried, where the conflict was reported, and the rvalue being checked. Only the
        // reporting pass counts; the fixed-point pass suppresses every diagnostic.
        self.reject_via = self.reject_via
            | conflict_via
            | self.cur_rv
            | self.cur_stmt
            | self.cur_term;

        diag_start(self.diag_file(), conflict_span, "note");
        eprint("borrow of '");
        self.write_place_path(conflicting, locals);
        eprint("' taken here\n");
    }

    // True if writing to `pl` (or creating a `&mut` through it) means dereferencing a read-only
    // pointer: the *last* pointer layer dereferenced while resolving `pl` has IL type `Ptr`,
    // which covers both `&T` and non-mut `*T` (the two erase to the same tag). `PtrMut` is the
    // only writable pointer type, matching Rust's `&T`/`*const T` vs `&mut T`/`*mut T` split.
    // `Boxed`/`BoxedMut` are deliberately excluded: both permit stores (see
    // `doc/spec/intermediate_language.md` §6.6 and `doc/spec/surface_syntax.md` §3.3), so that
    // pair is not a read/write split.
    //
    // The chain is walked rather than searched for an explicit `Deref`, because a field or index
    // projection on a pointer auto-derefs: `r.x` carries no `Deref` projection while `(*r).x`
    // does, and the two reach the same storage. Only the last dereference decides, which is what
    // makes `(*(*cur).inner).v = 5` writable when `inner` is a `*mut Inner` behind a `&Scope`.
    // A place that never dereferences a pointer is governed by the let/let-mut rules instead.
    fn writes_immutable_binding(self: &mut ZirVerifier, place: &Place, locals: [Local]) -> bool {
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == place.base {
                return locals[li].kind == LOCAL_KIND_LET
                    && !self.place_has_deref(place)
                    && (place.projections.len == 0 as usize
                        || !self.is_pointer_like_type(locals[li].ty));
            }
            li = li + 1 as usize;
        }
        return false;
    }

    fn place_has_deref(self: &mut ZirVerifier, place: &Place) -> bool {
        let mut pi = 0 as usize;
        while pi < place.projections.len {
            if place.projections[pi].get_tag() == PROJ_DEREF { return true; }
            pi = pi + 1 as usize;
        }
        return false;
    }

    // Whether a write to PL reaches its target through a pointer, a box or a slice view: an explicit
    // dereference, or a field, tuple or index step out of a value of such a type (a field access
    // through a reference dereferences it implicitly, as place_last_deref_is_readonly reads it).
    // That write stores into the referent, not into the base local, so what the value borrows is
    // not the base local's to hold. The steps are the ones place_last_deref_is_readonly takes.
    fn place_writes_through_pointer(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> bool {
        let mut curr_ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == (*pl).base {
                curr_ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        let mut i = 0 as usize;
        while i < (*pl).projections.len {
            let proj = &(*pl).projections[i];
            let tag = proj.get_tag();
            if tag == PROJ_DEREF { return true; }
            if curr_ty != 0 as u32 {
                let layer_tag = self.get_type_decl(curr_ty).def.get_tag();
                if is_any_pointer_tag(layer_tag)
                    || layer_tag == ILTYPE_BOXED
                    || layer_tag == ILTYPE_BOXEDMUT
                    || layer_tag == ILTYPE_SLICE {
                    return true;
                }
            }
            if tag == PROJ_FIELD {
                let field_idx = self.get_field_index(curr_ty, proj.get_Field());
                curr_ty = self.get_field_type(curr_ty, field_idx);
            } else if tag == PROJ_TUPLEINDEX {
                curr_ty = self.get_tuple_elem_type(curr_ty, proj.get_TupleIndex());
            } else {
                curr_ty = self.get_slice_element_type(curr_ty);
            }
            i = i + 1 as usize;
        }
        return false;
    }

    fn is_pointer_like_type(self: &mut ZirVerifier, ty: u32) -> bool {
        if ty == 0 as u32 || ty as usize > self.zil_module.types.len() { return false; }
        let tag = self.zil_module.types[ty as usize - 1 as usize].def.get_tag();
        return is_any_pointer_tag(tag)
            || tag == ILTYPE_BOXED
            || tag == ILTYPE_BOXEDMUT
            || tag == ILTYPE_SLICE;
    }

    // Why the place place_last_deref_is_readonly just judged cannot be written.
    fn readonly_reason(self: &ZirVerifier) -> [u8] {
        if self.readonly_is_slice {
            return "through a read-only slice (`[T]`; writing needs `[mut T]`)";
        }
        return "because it is behind a shared reference";
    }

    fn place_last_deref_is_readonly(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> bool {
        let mut curr_ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == (*pl).base {
                curr_ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if curr_ty == 0 as u32 { return false; }

        let mut saw_deref = false;
        let mut last_was_readonly = false;
        self.readonly_is_slice = false;

        let mut i = 0 as usize;
        while i < (*pl).projections.len {
            let proj = &(*pl).projections[i];
            let tag = proj.get_tag();

            if tag == PROJ_DEREF {
                if curr_ty != 0 as u32 {
                    let p_ty = self.get_type_decl(curr_ty);
                    saw_deref = true;
                    last_was_readonly = is_shared_pointer_tag(p_ty.def.get_tag());
                    self.readonly_is_slice = false;
                }
                curr_ty = self.get_ptr_inner_type(curr_ty);
            } else if tag == PROJ_FIELD || tag == PROJ_TUPLEINDEX || tag == PROJ_INDEX {
                // Strip every pointer/box layer before the field/tuple/index access, exactly as
                // get_field_index/get_field_type/get_slice_element_type do internally -- the
                // last layer stripped is the one whose dereference actually reaches the
                // aggregate, so it is the one whose read-only-ness governs this step.
                if curr_ty != 0 as u32 {
                    let mut p_ty = self.get_type_decl(curr_ty);
                    let mut layer_tag = p_ty.def.get_tag();
                    while is_any_pointer_tag(layer_tag)
                        || layer_tag == ILTYPE_BOXED
                        || layer_tag == ILTYPE_BOXEDMUT {
                        saw_deref = true;
                        last_was_readonly = is_shared_pointer_tag(layer_tag);
                        self.readonly_is_slice = false;
                        curr_ty = self.get_ptr_inner_type(curr_ty);
                        if curr_ty == 0 as u32 { break; }
                        p_ty = self.get_type_decl(curr_ty);
                        layer_tag = p_ty.def.get_tag();
                    }
                }

                if tag == PROJ_FIELD {
                    let field_idx = self.get_field_index(curr_ty, proj.get_Field());
                    curr_ty = self.get_field_type(curr_ty, field_idx);
                } else if tag == PROJ_TUPLEINDEX {
                    curr_ty = self.get_tuple_elem_type(curr_ty, proj.get_TupleIndex());
                } else {
                    // Indexing a slice reaches its elements through the slice's pointer: a
                    // `[T]` is a read-only view, as a `&T` is; a `[mut T]` may write.
                    if curr_ty != 0 as u32 {
                        let p_sl = self.get_type_decl(curr_ty);
                        if p_sl.def.get_tag() == ILTYPE_SLICE {
                            saw_deref = true;
                            last_was_readonly = !p_sl.def.get_Slice().mutable;
                            self.readonly_is_slice = true;
                        }
                    }
                    curr_ty = self.get_slice_element_type(curr_ty);
                }
            }
            i = i + 1 as usize;
        }

        if !saw_deref { return false; }
        return last_was_readonly;
    }

    // Whether two places name storage that may overlap. They do when they share a base and one
    // projection path is a prefix of the other, comparing the steps they have in common: distinct
    // fields of the same aggregate (`self.module.blocks` and `self.module.arena`) are disjoint,
    // while a shared prefix down to a deref or index is not. Comparing only the first projection
    // made every field of a local conflict with every other once indexing became a real borrow
    // (Unified Solution A), which is false: `tools/zilc` borrows one field and allocates from
    // another in the same statement.
    // Exact structural equality of two places, used to key a borrow in the dataflow merge.
    fn places_equal(self: &ZirVerifier, p1: &Place, p2: &Place) -> bool {
        if p1.base != p2.base { return false; }
        if p1.projections.len != p2.projections.len { return false; }
        let mut i = 0 as usize;
        while i < p1.projections.len {
            let a = &p1.projections[i];
            let b = &p2.projections[i];
            let tag = a.get_tag();
            if tag != b.get_tag() { return false; }
            if tag == PROJ_FIELD {
                if a.get_Field() != b.get_Field() { return false; }
            } else if tag == PROJ_TUPLEINDEX {
                if a.get_TupleIndex() != b.get_TupleIndex() { return false; }
            } else if tag == PROJ_INDEX {
                if a.get_Index() != b.get_Index() { return false; }
            }
            i = i + 1 as usize;
        }
        return true;
    }

    fn places_overlap(self: &ZirVerifier, p1: &Place, p2: &Place) -> bool {
        if p1.base != p2.base { return false; }
        let n = if p1.projections.len < p2.projections.len {
            p1.projections.len
        } else {
            p2.projections.len
        };
        let mut i = 0 as usize;
        while i < n {
            let pr1 = &p1.projections[i];
            let pr2 = &p2.projections[i];
            let tag1 = pr1.get_tag();
            let tag2 = pr2.get_tag();
            if tag1 != tag2 { return true; }
            if tag1 == PROJ_FIELD {
                if pr1.get_Field() != pr2.get_Field() { return false; }
            } else if tag1 == PROJ_TUPLEINDEX {
                if pr1.get_TupleIndex() != pr2.get_TupleIndex() { return false; }
            } else if tag1 == PROJ_INDEX {
                // Two index expressions may name the same element; only a shared index local is
                // known to, but not knowing is not a proof of disjointness.
                if pr1.get_Index() != pr2.get_Index() {
                    return true;
                }
            }
            i = i + 1 as usize;
        }
        return true;
    }

    fn check_place_use(
        self: &mut ZirVerifier,
        place: &Place,
        is_move: bool,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if place.base == 0 as u32 { return; }
        // Local ids run 1..=locals.len, in order (the state arrays have locals.len + 1 entries);
        // a `>=` here skipped the last local of every function, so `fn f(b: &B) -> R {
        // return b.r; }` moved out of the borrow unchecked.
        if place.base > locals.len as u32 {
            return;
        }

        let st = state.ownership[place.base as usize];
        if st == OWN_UNINIT {
            self.report_var_error("use of uninitialized variable", place.base, "", span, locals);
            return;
        }
        if st == OWN_MOVED {
            self.report_var_error("use of moved value", place.base, "", span, locals);
            return;
        }
        if st == OWN_DROPPED {
            self.report_var_error("use of dropped value", place.base, "", span, locals);
            return;
        }

        // Any use conflicts with a live mutable borrow.
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            let b = &state.borrows[i];
            if self.borrow_counts(b, &*state, locals)
                && b.is_mut
                && self.places_overlap(place, &b.base) {
                self.report_borrow_conflict(
                    "cannot use",
                    place,
                    "while it is mutably borrowed",
                    span,
                    &b.base,
                    b.span,
                    b.via,
                    locals
                );
            }
            i = i + 1 as usize;
        }
        if !is_move { return; }

        let loc = &locals[place.base as usize - 1 as usize];
        // A temporary holding a raw pointer, a `&mut`, or a box is moved even when its type is
        // Copy: those are the linear, ownership-like forms. A *shared* reference is Copy in the
        // ordinary sense, and a repeat `[&x; n]` reuses one element temporary for every element;
        // moving it would report `use of moved value` for element 2..n although each use is a
        // copy. The unrolled lowering therefore leaves a Copy element place in place, and this
        // is where a `&mut` element still ends up linear (and so `[&mut x; 2]` stays rejected).
        let is_temp = (loc.kind == LOCAL_KIND_TMP || loc.name_id == 0 as u32)
            && place.projections.len == 0 as usize
            && self.is_moved_temp_type(loc.ty);
        let is_copy = self.is_copy_type(self.get_place_type(place, locals))
            || (place.projections.len == 0 as usize && loc.is_copy);
        if is_copy && !is_temp { return; }

        // A closure body's alias for a captured value is not an owner: moving the value out would
        // leave the environment holding it as well, and both would drop it (Unified Solution D).
        if loc.is_capture_alias && place.projections.len == 0 as usize {
            self.report_error("cannot move out of a closure capture", span);
            return;
        }

        if place.projections.len > 0 as usize && self.local_is_pointer(loc) {
            // Moving out through a named reference moves out of what it borrows. Through a
            // temporary pointer (a field or payload address) it is a move out of the owner,
            // unless that is borrowed: the source of an enum payload address.
            let out_of_borrow = loc.name_id != 0 as u32
                || self.enum_payload_source_borrowed(place.base, state, locals);
            if out_of_borrow {
                self.report_error("cannot move out of borrow", span);
                return;
            }
        }
        if self.is_borrowed_by_other(place, state, locals) {
            self.report_var_error("cannot move borrowed value", place.base, "", span, locals);
            return;
        }
        if !loc.is_copy || is_temp {
            state.ownership[place.base as usize] = OWN_MOVED;
            state.maybe_live[place.base as usize] = false;
        }
    }

    fn is_moved_temp_type(self: &mut ZirVerifier, ty: u32) -> bool {
        if ty == 0 as u32 { return false; }
        let tag = self.get_type_decl(ty).def.get_tag();
        return is_raw_pointer_tag(tag)
            || tag == ILTYPE_PTRMUT
            || tag == ILTYPE_BOXED
            || tag == ILTYPE_BOXEDMUT;
    }

    // Whether LOC holds a reference or pointer.
    fn local_is_pointer(self: &mut ZirVerifier, loc: &Local) -> bool {
        if loc.ty == 0 as u32 { return false; }
        let tag = self.get_type_decl(loc.ty).def.get_tag();
        return is_any_pointer_tag(tag);
    }

    // Whether a borrow that still constrains PLACE overlaps it: one whose borrower is owned and
    // live and that is not a temporary's derived borrow - exactly `borrow_counts`. Liveness is
    // what keeps a value with a `Drop` impl immovable: `ZirStmt.Drop` counts as a use (see
    // `place_uses`), so such a borrower is still live here, and a use of the borrower after the
    // move keeps it live too. Counting to the borrower's scope end instead made this check
    // stricter than the borrow-conflict check about the same borrow.
    fn is_borrowed_by_other(
        self: &mut ZirVerifier,
        place: &Place,
        state: &ZirAnalysisState,
        locals: [Local]
    ) -> bool {
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            let b = &state.borrows[i];
            if self.borrow_counts(b, state, locals) && self.places_overlap(place, &b.base) {
                return true;
            }
            i = i + 1 as usize;
        }
        return false;
    }

    // Whether a value of TY owns storage the frame releases at its scope end: drop glue (an
    // `Arena` handle, a `Box`, a user `Drop`), or one of the standard library's growable
    // collections, whose buffer is freed through a raw-pointer field the field walk cannot see.
    // Recursive through tuple, array, struct and enum fields. Past the depth limit the answer is
    // "owns": the strict side, since "owns nothing" is what lets a reference escape.
    fn type_owns_storage(self: &mut ZirVerifier, ty: u32, depth: usize) -> bool {
        if depth > 8 as usize { return true; }
        if ty == 0 as u32 { return false; }
        let p_ty = self.type_decl_copy(ty);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT { return true; }
        if tag == ILTYPE_TUPLE {
            let elems = p_ty.def.get_Tuple();
            let mut i = 0 as usize;
            while i < elems.len {
                if self.type_owns_storage(elems[i], depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
            return false;
        }
        if tag == ILTYPE_ARRAY {
            return self.type_owns_storage(p_ty.def.get_Array().element, depth + 1 as usize);
        }
        if tag != ILTYPE_USER { return false; }
        let user = p_ty.def.get_User();
        if self.is_collection_type_name(user.name) { return true; }
        if self.has_drop_impl(user.name) { return true; }
        let user_id = user.id;
        if user_id == 0xffffffff as u32 || user_id as usize >= self.zil_module.typedefs.len() {
            return false;
        }
        let p_def = self.zil_module.typedefs[user_id as usize];
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            let fields = p_def.get_Struct().fields;
            let mut i = 0 as usize;
            while i < fields.len {
                if self.type_owns_storage(fields[i].ty, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            let variants = p_def.get_Enum().variants;
            let mut i = 0 as usize;
            while i < variants.len {
                if self.type_owns_storage(variants[i].payload, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        }
        return false;
    }

    fn is_closure_env(self: &ZirVerifier, id: u32, locals: [Local]) -> bool {
        if id == 0 as u32 { return false; }
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == id { return locals[li].closure_span.line != 0 as u32; }
            li = li + 1 as usize;
        }
        return false;
    }

    fn local_type_owns_storage(self: &mut ZirVerifier, local_id: u32, locals: [Local]) -> bool {
        let mut ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == local_id {
                ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if ty == 0 as u32 { return false; }
        return self.type_owns_storage(ty, 0 as usize);
    }

    // The four collections whose buffer lives behind a raw-pointer field, so the field walk above
    // stops at the struct. A specialized instance carries its arguments in the name (`Vec_i32`).
    fn is_collection_type_name(self: &mut ZirVerifier, name_id: u32) -> bool {
        if name_id == 0 as u32 { return false; }
        let s = self.intern_table.lookup(name_id);
        return type_name_is(s, "Vec")
            || type_name_is(s, "String")
            || type_name_is(s, "ByteVec")
            || type_name_is(s, "HashMap");
    }

    // Whether LOCAL_ID's storage belongs to a frame that outlives this one, proved by provenance: a
    // parameter, a value copied from one, a collection a standard-library raw constructor took
    // (`*_raw`, `unsafe`, the caller's buffer), or one anchored to a `&Arena` argument that itself
    // outlives the frame. Must-external - one binding this frame owns makes the local this frame's,
    // so a reference into its buffer cannot escape. Anything else, including a call the checker
    // cannot classify (a helper that returns a collection), is not external: the strict side.
    fn local_storage_external(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        local_id: u32,
        depth: usize
    ) -> bool {
        if depth > 8 as usize { return false; }
        if local_id == 0 as u32 || (local_id as usize) > locals.len { return false; }
        for p in func.params {
            if p.id == local_id { return true; }
        }
        let mut any = false;
        let mut bi = 0 as usize;
        while bi < func.blocks.len {
            let b = &func.blocks[bi];
            let mut si = 0 as usize;
            while si < b.statements.len {
                match b.statements[si] {
                    ZirStmt.Let(id, rv, _) => {
                        if id == local_id {
                            any = true;
                            if !self.rvalue_storage_external(
                                func,
                                locals,
                                &rv,
                                depth + 1 as usize
                            ) {
                                return false;
                            }
                        }
                    },
                    ZirStmt.Assign(pl, rv, _) => {
                        if pl.base == local_id && pl.projections.len == 0 as usize {
                            any = true;
                            if !self.rvalue_storage_external(
                                func,
                                locals,
                                &rv,
                                depth + 1 as usize
                            ) {
                                return false;
                            }
                        }
                    },
                    _ => {},
                }
                si = si + 1 as usize;
            }
            bi = bi + 1 as usize;
        }
        return any;
    }

    fn rvalue_storage_external(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        rv: &ZirRvalue,
        depth: usize
    ) -> bool {
        match *rv {
            // A copy of a place (a bare copy, a reborrow, a box, a match binding's payload, a
            // cast) is as external as the place it came from; a `match` binding is the route a
            // `&Option<T>` parameter's payload takes (`Clone for Option<T>`).
            ZirRvalue.Use(p)
                | ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.Boxed(p)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.Cast(p, _) => {
                return self.place_storage_external(func, locals, &p, depth);
            },
            ZirRvalue.Call(fn_id, args) => {
                // An `unsafe fn` hands the caller an obligation rather than a guarantee: the raw
                // constructors are where the standard library's callers take it, so what they
                // return is not read as this frame's. It has to be the callee's own attribute,
                // not the (`-I stdlib=`-only) standard-library identity the flags need, or a
                // build with a plain `-I stdlib` would reject the stdlib's own code.
                if self.is_unsafe_call(fn_id) {
                    return true;
                }
                if self.is_buffer_external_call(fn_id) { return true; }
                if self.is_buffer_anchored_call(fn_id) {
                    // `new_in(a: &Arena)`, `Command::new(program, a: &Arena)`: the `&Arena`
                    // argument, the (only) reference-typed one, decides whose buffer the
                    // collection holds.
                    let mut ai = 0 as usize;
                    while ai < args.len {
                        let aty = self.get_place_type(&args[ai], locals);
                        if aty != 0 as u32
                            && is_reference_tag(self.get_type_decl(aty).def.get_tag()) {
                            return self.place_storage_external(func, locals, &args[ai], depth);
                        }
                        ai = ai + 1 as usize;
                    }
                }
                return false;
            },
            // A literal lives in the program image, not in this frame.
            ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_) => { return true; },
            ZirRvalue.StructLiteral(_, args) | ZirRvalue.Tuple(args) => {
                let mut any = false;
                for a in args {
                    if self.place_storage_external(func, locals, a, depth + 1 as usize) {
                        any = true;
                    }
                }
                return any;
            },
            _ => { return false; },
        }
    }

    fn place_storage_external(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        p: &Place,
        depth: usize
    ) -> bool {
        if p.base == 0 as u32 { return false; }
        return self.local_storage_external(func, locals, p.base, depth);
    }

    // Whether temporary LOCAL_ID is an enum payload address whose source is borrowed: by a
    // live borrow, or because the source is behind a named reference (a parameter's `&T`,
    // borrowed from the caller).
    fn enum_payload_source_borrowed(
        self: &mut ZirVerifier,
        local_id: u32,
        state: &ZirAnalysisState,
        locals: [Local]
    ) -> bool {
        let mut i = 0 as usize;
        while i < state.enum_aliases.len() {
            let ea = &state.enum_aliases[i];
            if ea.local_id == local_id {
                if self.is_borrowed_by_other(&ea.source, state, locals) { return true; }
                if ea.source.base == 0 as u32 || ea.source.base > locals.len as u32 {
                    return false;
                }
                let src = &locals[ea.source.base as usize - 1 as usize];
                return src.name_id != 0 as u32 && self.local_is_pointer(src);
            }
            i = i + 1 as usize;
        }
        return false;
    }

    fn get_borrow_base(self: &ZirVerifier, borrower: u32, state: &ZirAnalysisState) -> u32 {
        let mut cur = borrower;
        let mut depth = 0 as usize;
        while depth < 8 as usize {
            let mut found = false;
            let mut i = 0 as usize;
            while i < state.borrows.len() {
                if state.borrows[i].borrower == cur {
                    cur = state.borrows[i].base.base;
                    found = true;
                    break;
                }
                i = i + 1 as usize;
            }
            if !found { return cur; }
            depth = depth + 1 as usize;
        }
        return cur;
    }

    // The arena lifecycle primitives are identified by the flag the driver set on the callee when
    // it declared it, which it derives from the module the declaration was loaded from (the
    // standard library) and the item's name - never from the callee's file name or its own list of
    // name spellings here. A user library file called `mem.zrl` used to win this and the resulting
    // epoch exemption excused a use-after-free (third-pass item 1;
    // doc/spec/modular_compilation.md, probe 218_fake_mem_arena_spoof.zrl).
    fn is_arena_mark_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].arena_mark;
    }

    fn is_arena_reset_to_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].arena_reset_to;
    }

    fn is_buffer_external_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].buffer_external;
    }

    fn is_buffer_anchored_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].buffer_anchored;
    }

    fn is_unsafe_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].is_unsafe;
    }

    fn get_reset_to_exempt_epoch(
        self: &ZirVerifier,
        b: &ZirBlock,
        start_si: usize,
        tmp_local: u32,
        arena_base: u32,
        state: &ZirAnalysisState
    ) -> u32 {
        let mut i = start_si + 1 as usize;
        while i < b.statements.len {
            match b.statements[i] {
                ZirStmt.Let(_, rv, _) | ZirStmt.Assign(_, rv, _) => {
                    if let ZirRvalue.Call(fn_id, args) = rv {
                        if args.len >= 2 as usize
                            && args[0].base == tmp_local
                            && self.is_arena_reset_to_call(fn_id) {
                            let mark_local = args[1].base;
                            let mut resolved_mark = mark_local;
                            let mut j = start_si + 1 as usize;
                            while j < i {
                                match b.statements[j] {
                                    ZirStmt.Let(lid, m_rv, _) => {
                                        if lid == resolved_mark {
                                            if let ZirRvalue.Use(p) = m_rv {
                                                resolved_mark = p.base;
                                            }
                                        }
                                    },
                                    _ => {},
                                }
                                j = j + 1 as usize;
                            }
                            let mut mi = 0 as usize;
                            while mi < state.mark_infos.len() {
                                let info = &state.mark_infos[mi];
                                if info.mark_local == resolved_mark
                                    && info.arena_base == arena_base {
                                    return info.epoch;
                                }
                                mi = mi + 1 as usize;
                            }
                        }
                    }
                },
                _ => {},
            }
            i = i + 1 as usize;
        }
        return 0 as u32;
    }

    fn set_mark_info(
        self: &mut ZirVerifier,
        state: &mut ZirAnalysisState,
        mark_local: u32,
        arena_base: u32,
        epoch: u32
    ) {
        let mut i = 0 as usize;
        while i < state.mark_infos.len() {
            if state.mark_infos[i].mark_local == mark_local {
                state.mark_infos[i].arena_base = arena_base;
                state.mark_infos[i].epoch = epoch;
                return;
            }
            i = i + 1 as usize;
        }
        state.mark_infos.push(MarkInfo {
            mark_local: mark_local,
            arena_base: arena_base,
            epoch: epoch,
        });
    }

    fn remove_mark_info(self: &mut ZirVerifier, state: &mut ZirAnalysisState, mark_local: u32) {
        let mut i = 0 as usize;
        while i < state.mark_infos.len() {
            if state.mark_infos[i].mark_local == mark_local {
                state.mark_infos.remove(i);
                return;
            }
            i = i + 1 as usize;
        }
    }

    fn advance_container_mutation_epoch(
        self: &mut ZirVerifier,
        target_local: u32,
        state: &mut ZirAnalysisState
    ) {
        if target_local == 0 as u32 { return; }
        let mut affected = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        affected.push(target_local);

        let mut changed = true;
        while changed {
            changed = false;
            let mut i = 0 as usize;
            while i < state.borrows.len() {
                let b = &state.borrows[i];
                if b.is_mut {
                    let mut borrower_in = false;
                    let mut base_in = false;
                    let mut j = 0 as usize;
                    while j < affected.len() {
                        if affected[j] == b.borrower { borrower_in = true; }
                        if affected[j] == b.base.base { base_in = true; }
                        j = j + 1 as usize;
                    }
                    if borrower_in && !base_in && b.base.base != 0 as u32 {
                        affected.push(b.base.base);
                        changed = true;
                    }
                    if base_in && !borrower_in && b.borrower != 0 as u32 {
                        affected.push(b.borrower);
                        changed = true;
                    }
                }
                i = i + 1 as usize;
            }
        }

        let mut bi = 0 as usize;
        while bi < state.borrows.len() {
            let b = &mut state.borrows[bi];
            let mut aff = false;
            let mut j = 0 as usize;
            while j < affected.len() {
                if affected[j] == b.borrower {
                    aff = true;
                    break;
                }
                j = j + 1 as usize;
            }
            if aff {
                b.epoch = self.next_borrow_epoch;
            }
            bi = bi + 1 as usize;
        }
        self.next_borrow_epoch = self.next_borrow_epoch + 1 as u32;
    }

    fn check_borrow_creation(
        self: &mut ZirVerifier,
        place: &Place,
        is_mut: bool,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        borrower: u32,
        region: u32,
        exempt_epoch: u32
    ) {
        if place.base == 0 as u32 { return; }

        let p_st_idx = place.base as usize;
        let st = state.ownership[p_st_idx];
        if st == OWN_UNINIT {
            self.report_var_error(
                "cannot borrow uninitialized variable",
                place.base,
                "",
                span,
                locals
            );
            return;
        } else if st == OWN_MOVED {
            self.report_var_error("use of moved value", place.base, "", span, locals);
            return;
        } else if st == OWN_DROPPED {
            self.report_var_error("cannot borrow dropped value", place.base, "", span, locals);
            return;
        }

        if is_mut {
            if place.base != 0 as u32 && (place.base as usize) <= locals.len {
                let loc = &locals[place.base as usize - 1 as usize];
                if loc.is_capture_alias
                    && loc.is_copy
                    && !self.place_has_deref(place)
                    && (place.projections.len == 0 as usize || !self.is_pointer_like_type(loc.ty)) {
                    let mut msg = unsafe { ByteVec.new_raw(self.arena) };
                    msg.push_slice("the closure holds a copy of '");
                    msg.push_slice(self.intern_table.lookup(loc.name_id));
                    msg.push_slice(
                        "'; borrowing it mutably borrows only the copy; capture a '&mut' reference instead"
                    );
                    self.report_error(msg.as_slice(), span);
                    return;
                }
            }
            if self.writes_immutable_binding(place, locals) {
                self.report_var_error(
                    "cannot mutably borrow",
                    place.base,
                    "because it is immutable",
                    span,
                    locals
                );
                return;
            }

            // A `&mut` cannot be created by dereferencing a read-only pointer (`let r: &T =
            // &expr; &mut *r`, or the same one level deeper through a field, `&mut *h.r`) --
            // which is what a `&mut self` method call through a `&T` lowers to. Raw pointers
            // stay the documented unchecked escape hatch. Re-borrowing `r` itself (`&mut r`, no
            // projections) is a different, permitted concern handled by the conflict check below.
            if place.projections.len > 0 as usize {
                if self.place_last_deref_is_readonly(place, locals) {
                    self.report_var_error(
                        "cannot mutably borrow",
                        place.base,
                        self.readonly_reason(),
                        span,
                        locals
                    );
                    return;
                }
            }
        }

        // Conflict check
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            let b = &state.borrows[i];
            if self.borrow_counts(b, &*state, locals) {
                if self.places_overlap(place, &b.base) {
                    let is_exempt = exempt_epoch != 0 as u32 && !b.is_mut && b.epoch < exempt_epoch;
                    if !is_exempt {
                        if is_mut && b.is_mut {
                            self.report_borrow_conflict(
                                "cannot mutably borrow",
                                place,
                                "more than once",
                                span,
                                &b.base,
                                b.span,
                                b.via,
                                locals
                            );
                        } else if is_mut {
                            self.report_borrow_conflict(
                                "cannot mutably borrow",
                                place,
                                "while it is already borrowed",
                                span,
                                &b.base,
                                b.span,
                                b.via,
                                locals
                            );
                        } else if b.is_mut {
                            self.report_borrow_conflict(
                                "cannot borrow",
                                place,
                                "while it is mutably borrowed",
                                span,
                                &b.base,
                                b.span,
                                b.via,
                                locals
                            );
                        }
                    }
                }
            }
            i = i + 1 as usize;
        }

        if is_mut {
            self.advance_container_mutation_epoch(place.base, state);
        }

        // The borrow was created by this `&`/`&mut` rvalue; that is the first route it travelled.
        let mut via = route_bit(ROUTE_RV_BASE + ROUTE_RV_REF);
        if is_mut { via = route_bit(ROUTE_RV_BASE + ROUTE_RV_REFMUT); }
        state.borrows.push(ActiveBorrow {
            base: *place,
            is_mut: is_mut,
            region: region,
            borrower: borrower,
            span: span,
            derived: false,
            direct: true,
            epoch: self.next_borrow_epoch,
            via: via,
        });
        self.next_borrow_epoch = self.next_borrow_epoch + 1 as u32;
    }

    // Checks the places RV reads: moved operands (MOVE) must be owned, and borrowed ones not
    // moved out. Exhaustive, so a new rvalue cannot go unchecked (tuple and array literals
    // once did, which let a moved value be used again).
    // exhaustive: every rvalue must decide how each of its operands is read (move vs read),
    // so a new construct cannot silently skip the ownership and mutability checks.
    fn check_rvalue_use(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        self.cur_rv = rv_bit(rv);
        match *rv {
            ZirRvalue.Use(p)
                | ZirRvalue.UnaryOp(_, p)
                | ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.Boxed(p) => {
                self.check_place_use(&p, true, span, state, locals);
            },
            ZirRvalue.BinaryOp(_, a, b) => {
                self.check_place_use(&a, true, span, state, locals);
                self.check_place_use(&b, true, span, state, locals);
            },
            ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.VariantCheck(p, _, _)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.ArrayRepeat(p, _, _) => {
                self.check_place_use(&p, false, span, state, locals);
            },
            ZirRvalue.Call(fn_id, args) => {
                self.check_places_moved(args, span, state, locals);
                self.check_call_arg_mutability(fn_id, args, span, state, locals);
                self.check_call_stores_escapes(fn_id, args, span, state, locals, func);
            },
            ZirRvalue.CallPtr(f, args) => {
                self.check_place_use(&f, false, span, state, locals);
                self.check_places_moved(args, span, state, locals);
                self.check_call_ptr_arg_mutability(&f, args, span, state, locals);
            },
            ZirRvalue.StructLiteral(_, args)
                | ZirRvalue.Syscall(args)
                | ZirRvalue.Intrinsic(_, args) => {
                self.check_places_moved(args, span, state, locals);
            },
            ZirRvalue.Tuple(elems) | ZirRvalue.Array(_, elems) => {
                self.check_places_moved(elems, span, state, locals);
            },
            ZirRvalue.Cast(p, _) | ZirRvalue.PtrFromInt(p, _) => {
                // A cast moves out of a compiler temporary, and only reads a named value.
                let is_temp = p.projections.len == 0 as usize && self.is_temp_local(p.base, locals);
                self.check_place_use(&p, is_temp, span, state, locals);
            },
            ZirRvalue.Const(_, _)
                | ZirRvalue.Sizeof(_)
                | ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_)
                | ZirRvalue.GetEnv => {},
            ZirRvalue.FuncAddr(_, env_ptr) => {
                if env_ptr != 0 as u32 {
                    let env_pl = Place {
                        base: env_ptr,
                        projections: @slice(0 as *mut Projection, 0 as usize)
                    };
                    self.check_place_use(&env_pl, false, span, state, locals);
                }
            },
        }
    }

    fn check_places_moved(
        self: &mut ZirVerifier,
        places: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        for p in places { self.check_place_use(p, true, span, state, locals); }
    }

    pub fn verify(self: &mut ZirVerifier) {
        let mut i = 0 as usize;
        while i < self.module.funcs.len {
            let func = self.module.funcs[i];
            self.verify_function(&func);
            i = i + 1 as usize;
        }
    }

    fn is_never_type(self: &ZirVerifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        if ty_id as usize > self.zil_module.types.len() { return false; }
        let p_ty = &self.zil_module.types[ty_id as usize - 1 as usize];
        if p_ty.def.get_tag() == ILTYPE_PRIMITIVE {
            return p_ty.def.get_Primitive().get_tag() == ILPRIM_NEVER;
        }
        return false;
    }

    fn func_returns_never(self: &ZirVerifier, func_idx: u32) -> bool {
        if func_idx as usize >= self.zil_module.functions.len() { return false; }
        let p_func = &self.zil_module.functions[func_idx as usize];
        return self.is_never_type(p_func.ret_ty);
    }

    fn call_ptr_returns_never(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> bool {
        let fn_ty = self.get_place_type(pl, locals);
        if fn_ty == 0 as u32 { return false; }
        let p_ty = self.get_type_decl(fn_ty);
        let tag = p_ty.def.get_tag();
        let mut actual_fn_ty = 0 as u32;
        if tag == ILTYPE_FN {
            actual_fn_ty = fn_ty;
        } else if is_any_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(fn_ty);
            if inner != 0 as u32 {
                let p_inner = self.get_type_decl(inner);
                if p_inner.def.get_tag() == ILTYPE_FN {
                    actual_fn_ty = inner;
                }
            }
        }
        if actual_fn_ty != 0 as u32 {
            let p_fty = self.get_type_decl(actual_fn_ty);
            let f_def = p_fty.def.get_Fn();
            return self.is_never_type(f_def.ret_ty);
        }
        return false;
    }

    // Whether STMT never returns: a call to a function returning `!` (directly, through a
    // pointer, or bound by a `let` of type `!`).
    fn stmt_terminates_path(self: &mut ZirVerifier, stmt: &ZirStmt, locals: [Local]) -> bool {
        match *stmt {
            ZirStmt.Let(local_id, rv, _) => {
                for l in locals {
                    if l.id == local_id && self.is_never_type(l.ty) { return true; }
                }
                return self.rv_never_returns(&rv, locals);
            },
            ZirStmt.Assign(_, rv, _) => { return self.rv_never_returns(&rv, locals); },
            _ => { return false; },
        }
    }

    fn rv_never_returns(self: &mut ZirVerifier, rv: &ZirRvalue, locals: [Local]) -> bool {
        return match *rv {
            ZirRvalue.Call(fn_id, _) => self.func_returns_never(fn_id),
            ZirRvalue.CallPtr(f, _) => self.call_ptr_returns_never(&f, locals),
            _ => false,
        };
    }

    fn block_terminates_path(self: &mut ZirVerifier, b: &ZirBlock, locals: [Local]) -> bool {
        let mut si = 0 as usize;
        while si < b.statements.len {
            if self.stmt_terminates_path(&b.statements[si], locals) {
                return true;
            }
            si = si + 1 as usize;
        }
        return false;
    }

    // ---- liveness (non-lexical borrows) ------------------------------------------------

    fn is_live(self: &ZirVerifier, id: u32) -> bool {
        if self.cur_live as usize == 0 as usize { return true; }
        let w = (id as usize) / 64 as usize;
        if w >= self.live_words { return true; }
        let word = unsafe { *((self.cur_live as usize + w * 8) as *u64) };
        return ((word >> ((id as u64) % 64 as u64)) & 1 as u64) != 0 as u64;
    }

    fn bits_set(self: &ZirVerifier, set: *mut u64, id: u32) {
        let w = (id as usize) / 64 as usize;
        if id == 0 as u32 || w >= self.live_words { return; }
        let p = (set as usize + w * 8) as *mut u64;
        unsafe { *p = *p | ((1 as u64) << ((id as u64) % 64 as u64)); }
    }

    fn bits_clear(self: &ZirVerifier, set: *mut u64, id: u32) {
        let w = (id as usize) / 64 as usize;
        if id == 0 as u32 || w >= self.live_words { return; }
        let p = (set as usize + w * 8) as *mut u64;
        unsafe { *p = *p & !((1 as u64) << ((id as u64) % 64 as u64)); }
    }

    fn place_uses(self: &ZirVerifier, pl: &Place, set: *mut u64) {
        self.bits_set(set, pl.base);
        let mut i = 0 as usize;
        while i < pl.projections.len {
            if pl.projections[i].get_tag() == PROJ_INDEX {
                self.bits_set(set, pl.projections[i].get_Index());
            }
            i = i + 1 as usize;
        }
    }

    fn places_uses(self: &ZirVerifier, pls: [Place], set: *mut u64) {
        let mut i = 0 as usize;
        while i < pls.len { self.place_uses(&pls[i], set); i = i + 1 as usize; }
    }

    // exhaustive: liveness must count every operand a construct reads; a new construct cannot
    // silently keep an operand's borrow alive or let it die early.
    fn rv_uses(self: &ZirVerifier, rv: &ZirRvalue, set: *mut u64) {
        match *rv {
            ZirRvalue.Use(p)
                | ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.UnaryOp(_, p)
                | ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.Cast(p, _)
                | ZirRvalue.VariantCheck(p, _, _)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.ArrayRepeat(p, _, _)
                | ZirRvalue.PtrFromInt(p, _) => { self.place_uses(&p, set); },
            ZirRvalue.BinaryOp(_, a, b) => {
                self.place_uses(&a, set);
                self.place_uses(&b, set);
            },
            ZirRvalue.Call(_, args)
                | ZirRvalue.StructLiteral(_, args)
                | ZirRvalue.Syscall(args)
                | ZirRvalue.Intrinsic(_, args)
                | ZirRvalue.Tuple(args)
                | ZirRvalue.Array(_, args) => { self.places_uses(args, set); },
            ZirRvalue.CallPtr(f, args) => {
                self.place_uses(&f, set);
                self.places_uses(args, set);
            },
            ZirRvalue.Boxed(p) => { self.place_uses(&p, set); },
            ZirRvalue.Const(_, _)
                | ZirRvalue.Sizeof(_)
                | ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_)
                | ZirRvalue.GetEnv => {},
            ZirRvalue.FuncAddr(_, env_ptr) => {
                if env_ptr != 0 as u32 { self.bits_set(set, env_ptr); }
            },
        }
    }

    // Transfer one statement backwards: live-before = (live-after - def) + uses.
    // Liveness backwards through ST: what it defines is dead before it, what it reads is live.
    // exhaustive: every statement must state what it defines and what it makes live.
    fn stmt_live_transfer(self: &ZirVerifier, st: &ZirStmt, set: *mut u64) {
        match *st {
            ZirStmt.Let(id, rv, _) => {
                self.bits_clear(set, id);
                self.rv_uses(&rv, set);
            },
            ZirStmt.Assign(pl, rv, _) => {
                if pl.projections.len == 0 as usize {
                    self.bits_clear(set, pl.base);
                } else {
                    self.place_uses(&pl, set);
                }
                self.rv_uses(&rv, set);
            },
            ZirStmt.Drop(pl, _) | ZirStmt.DropIfLive(pl, _) => { self.place_uses(&pl, set); },
            ZirStmt.Intrinsic(_, args, _) => { self.places_uses(args, set); },
            ZirStmt.EndBorrow(_, _) => {},
        }
    }

    // exhaustive: every terminator must state which operands it reads.
    fn term_uses(self: &ZirVerifier, term: &ZirTerminator, set: *mut u64) {
        match *term {
            ZirTerminator.Branch(cond, _, _) => { self.place_uses(&cond, set); },
            ZirTerminator.Ret(p) => { self.place_uses(&p, set); },
            ZirTerminator.Jmp(_) | ZirTerminator.Unreachable => {},
        }
    }

    fn live_out_of(self: &ZirVerifier, block: usize) -> *mut u64 {
        return (self.live_out as usize + block * self.live_words * 8) as *mut u64;
    }

    // live-after of the last statement: the terminator's uses plus the block's live-out.
    fn block_tail_live(self: &ZirVerifier, b: &ZirBlock, block: usize, set: *mut u64) {
        unsafe {
            memcpy(set as *mut u8, self.live_out_of(block) as *u8, (self.live_words * 8) as u64);
        }
        self.term_uses(&b.terminator, set);
    }

    // Backward dataflow to a fixpoint: live-out(b) = union of live-in over b's successors.
    fn compute_liveness(self: &mut ZirVerifier, func: &ZirFunction, locals_len: usize) {
        let blocks_len = (*func).blocks.len;
        self.live_words = locals_len / 64 as usize + 1 as usize;
        let bytes = blocks_len * self.live_words * 8;
        self.live_out = unsafe { zoril_allocator_alloc(self.arena, bytes as u64) } as *mut u64;
        let live_in = unsafe { zoril_allocator_alloc(self.arena, bytes as u64) } as *mut u64;
        unsafe {
            memset(self.live_out as *mut u8, 0, bytes as u64);
            memset(live_in as *mut u8, 0, bytes as u64);
        }
        let tmp = unsafe {
            zoril_allocator_alloc(self.arena, (self.live_words * 8) as u64)
        } as *mut u64;
        let mut changed = true;
        let mut iter = 0 as usize;
        while changed && iter < 200 as usize {
            changed = false;
            let mut bi = blocks_len;
            while bi > 0 as usize {
                bi = bi - 1 as usize;
                let b = &(*func).blocks[bi];
                // live-out = union of the successors' live-in
                let out = self.live_out_of(bi);
                // The block's successors (NO_SUCC when it has fewer than two).
                let (s1, s2) = match b.terminator {
                    ZirTerminator.Jmp(t) => (t as usize, NO_SUCC),
                    ZirTerminator.Branch(_, t1, t2) => (t1 as usize, t2 as usize),
                    ZirTerminator.Ret(_) | ZirTerminator.Unreachable => (NO_SUCC, NO_SUCC),
                };
                let mut w = 0 as usize;
                while w < self.live_words {
                    let mut acc = unsafe { *((out as usize + w * 8) as *u64) };
                    if s1 < blocks_len {
                        acc = acc
                            | unsafe {
                                *((live_in as usize + (s1 * self.live_words + w) * 8) as *u64)
                            };
                    }
                    if s2 < blocks_len {
                        acc = acc
                            | unsafe {
                                *((live_in as usize + (s2 * self.live_words + w) * 8) as *u64)
                            };
                    }
                    unsafe { *((out as usize + w * 8) as *mut u64) = acc; }
                    w = w + 1 as usize;
                }
                // live-in = transfer backwards through the statements
                self.block_tail_live(b, bi, tmp);
                let mut si = b.statements.len;
                while si > 0 as usize {
                    si = si - 1 as usize;
                    self.stmt_live_transfer(&b.statements[si], tmp);
                }
                let inb = (live_in as usize + bi * self.live_words * 8) as *mut u64;
                if !unsafe { is_mem_eq(inb as *u8, tmp as *u8, (self.live_words * 8) as u64) } {
                    unsafe { memcpy(inb as *mut u8, tmp as *u8, (self.live_words * 8) as u64); }
                    changed = true;
                }
            }
            iter = iter + 1 as usize;
        }
    }

    // Rows for the current block: row k (k < n) = live after statement k; row n = the
    // block's live-out, for its terminator.
    fn compute_block_rows(self: &mut ZirVerifier, b: &ZirBlock, block: usize) {
        let n = b.statements.len;
        let wbytes = self.live_words * 8;
        let need = (n + 1 as usize) * self.live_words;
        if need > self.live_rows_cap {
            self.live_rows = unsafe {
                zoril_allocator_alloc(self.arena, (need * 8) as u64)
            } as *mut u64;
            self.live_rows_cap = need;
        }
        unsafe {
            memcpy(self.live_row(n) as *mut u8, self.live_out_of(block) as *u8, wbytes as u64);
        }
        if n == 0 as usize { return; }
        self.block_tail_live(b, block, self.live_row(n - 1 as usize));
        let mut k = n - 1 as usize;
        while k > 0 as usize {
            // live after statement k-1 = live before statement k
            unsafe {
                memcpy(
                    self.live_row(k - 1 as usize) as *mut u8,
                    self.live_row(k) as *u8,
                    wbytes as u64
                );
            }
            self.stmt_live_transfer(&b.statements[k], self.live_row(k - 1 as usize));
            k = k - 1 as usize;
        }
    }

    fn live_row(self: &ZirVerifier, k: usize) -> *mut u64 {
        return (self.live_rows as usize + k * self.live_words * 8) as *mut u64;
    }

    fn verify_function(self: &mut ZirVerifier, func: &ZirFunction) {
        self.next_borrow_epoch = 1 as u32;
        self.reject_via = 0 as u64;
        self.cur_rv = 0 as u64;
        self.cur_stmt = 0 as u64;
        self.cur_term = 0 as u64;
        self.cur_blocks = (*func).blocks;
        let locals_len = (*func).locals.len;
        let blocks_len = (*func).blocks.len;
        if blocks_len == 0 as usize { return; }
        let locals = (*func).locals;

        let block_entry_states = unsafe {
            @slice(
                zoril_allocator_alloc(self.arena, blocks_len * 8) as *mut *mut ZirAnalysisState,
                blocks_len
            )
        };
        let block_exit_states = unsafe {
            @slice(
                zoril_allocator_alloc(self.arena, blocks_len * 8) as *mut *mut ZirAnalysisState,
                blocks_len
            )
        };
        for k in 0 as usize..blocks_len {
            block_entry_states[k] = 0 as *mut ZirAnalysisState;
            block_exit_states[k] = 0 as *mut ZirAnalysisState;
        }
        block_entry_states[0] = self.initial_state(func);
        let preds = self.predecessors(func);
        self.compute_liveness(func, locals_len);

        // Each block's entry state is the merge of its predecessors' exit states, iterated to
        // a fixed point with no errors reported.
        self.reporting_enabled = false;
        let mut changed = true;
        let mut iter = 0 as usize;
        while changed && iter < 100 as usize {
            changed = false;
            for bj in 0 as usize..blocks_len {
                if bj > 0 as usize {
                    let new_entry = self.merge_states(
                        bj,
                        preds[bj],
                        &block_exit_states,
                        locals_len
                    );
                    // A block with no live predecessor has no entry. Counting null to null as
                    // a change would never reach the fixed point (all 100 iterations, ~40s on
                    // the compiler's own source).
                    if new_entry as usize != 0 as usize {
                        let old_entry = block_entry_states[bj];
                        if old_entry as usize == 0 as usize
                            || !self.states_equal(new_entry, old_entry, locals_len) {
                            block_entry_states[bj] = new_entry;
                            changed = true;
                        }
                    }
                }
                let exit = self.run_block(func, bj, block_entry_states[bj]);
                if exit as usize != 0 as usize {
                    let old_exit = block_exit_states[bj];
                    if old_exit as usize == 0 as usize
                        || !self.states_equal(exit, old_exit, locals_len) {
                        block_exit_states[bj] = exit;
                        changed = true;
                    }
                }
            }
            iter = iter + 1 as usize;
        }

        // Then once more from the fixed point, reporting.
        self.reporting_enabled = true;
        for bk in 0 as usize..blocks_len { self.run_block(func, bk, block_entry_states[bk]); }
        self.cur_live = 0 as *mut u64;
    }

    // The state at function entry: the parameters owned, everything else uninitialized.
    fn initial_state(self: &mut ZirVerifier, func: &ZirFunction) -> *mut ZirAnalysisState {
        let n = (*func).locals.len + 1 as usize;
        let own = unsafe { @slice(zoril_allocator_alloc(self.arena, n) as *mut u8, n) };
        let ml = unsafe { @slice(zoril_allocator_alloc(self.arena, n) as *mut bool, n) };
        unsafe {
            memset(own.ptr as *mut u8, 0, n as u64);
            memset(ml.ptr as *mut u8, 0, n as u64);
        }
        for p in (*func).params { own[p.id as usize] = OWN_OWNED; }
        let state = unsafe {
            zoril_allocator_alloc(self.arena, sizeof(ZirAnalysisState))
        } as *mut ZirAnalysisState;
        unsafe {
            *state = ZirAnalysisState {
                ownership: own,
                maybe_live: ml,
                borrows: unsafe { Vec::<ActiveBorrow>.new_in_raw(self.arena) },
                enum_aliases: unsafe { Vec::<EnumPayloadAlias>.new_in_raw(self.arena) },
                mark_infos: unsafe { Vec::<MarkInfo>.new_in_raw(self.arena) },
            };
        }
        return state;
    }

    // Each block's predecessors: the blocks whose terminator can reach it. Scratch-arena lists, so
    // holding the result does not keep the verifier borrowed.
    #[borrows()]
    fn predecessors(self: &mut ZirVerifier, func: &ZirFunction) -> [mut Vec<u32>] {
        let n = (*func).blocks.len;
        let preds = unsafe {
            @slice(zoril_allocator_alloc(self.arena, n * sizeof(Vec<u32>)) as *mut Vec<u32>, n)
        };
        for k in 0 as usize..n { preds[k] = unsafe { Vec::<u32>.new_in_raw(self.arena) }; }
        for bi in 0 as usize..n {
            let b = &(*func).blocks[bi];
            if self.block_terminates_path(b, (*func).locals) { continue; }
            match b.terminator {
                ZirTerminator.Jmp(t) => {
                    if (t as usize) < n { preds[t as usize].push(bi as u32); }
                },
                ZirTerminator.Branch(_, t1, t2) => {
                    if (t1 as usize) < n { preds[t1 as usize].push(bi as u32); }
                    if (t2 as usize) < n { preds[t2 as usize].push(bi as u32); }
                },
                ZirTerminator.Ret(_) | ZirTerminator.Unreachable => {},
            }
        }
        return preds;
    }

    // Checks block BI from (a copy of) state ENTRY: its exit state, or null when it has no
    // entry or a statement ends its path.
    fn run_block(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        bi: usize,
        entry: *mut ZirAnalysisState
    ) -> *mut ZirAnalysisState {
        if entry as usize == 0 as usize { return 0 as *mut ZirAnalysisState; }
        let locals = (*func).locals;
        let state = unsafe { (*entry).clone(self.arena, locals.len) };
        let b = &(*func).blocks[bi];
        self.compute_block_rows(b, bi);
        for si in 0 as usize..b.statements.len {
            self.cur_live = self.live_row(si);
            self.next_borrow_epoch = (bi as u32 + 1 as u32) * 100000 as u32
                + (si as u32 + 1 as u32) * 50 as u32;
            self.check_stmt(&b.statements[si], unsafe { &mut *state }, locals, b, si, func);
            if self.stmt_terminates_path(&b.statements[si], locals) {
                return 0 as *mut ZirAnalysisState;
            }
        }
        self.cur_live = self.live_row(b.statements.len);
        self.next_borrow_epoch = (bi as u32 + 1 as u32) * 100000 as u32
            + (b.statements.len as u32 + 1 as u32) * 50 as u32;
        self.check_terminator(&b.terminator, unsafe { &mut *state }, locals, func);
        return state;
    }

    fn propagate_borrow(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        state: &mut ZirAnalysisState,
        dest_id: u32,
        locals: [Local]
    ) {
        if dest_id != 0 as u32 {
            let mut li = 0 as usize;
            while li < locals.len {
                if locals[li].id == dest_id {
                    if locals[li].ty != 0 as u32
                        && is_raw_pointer_tag(
                            self.zil_module.types[locals[li].ty as usize - 1 as usize].def.get_tag()
                        ) {
                        return;
                    }
                    break;
                }
                li = li + 1 as usize;
            }
        }

        let src_id = match *rv {
            ZirRvalue.Use(p) => p.base,
            _ => 0 as u32,
        };
        // A bare local-to-local copy of the reference itself keeps pointing at the same
        // referent; reading a field, element or deref out of a value does not.
        let direct_copy = match *rv {
            ZirRvalue.Use(p) => p.projections.len == 0 as usize,
            _ => false,
        };

        // A borrow follows a value only into something that can hold a reference:
        // `let y = *r` or `let n = v.as_slice()[i]` copies a value out; it does not keep
        // the borrowed place borrowed. (Matters now that borrows end at their last use.)
        if src_id == 0 as u32 || !self.local_holds_reference(dest_id, locals) {
            return;
        }
        // Every borrow the source holds follows it, not just the first: a value built from
        // two references (`(&a, &b)`, or `&r.f`, which borrows `r` and what `r` borrows)
        // keeps both places borrowed. Propagating an existing borrow to a new borrower does
        // not create a new one, so each keeps its original span ("taken here").
        let n = state.borrows.len();
        let mut i = 0 as usize;
        while i < n {
            let b = state.borrows[i];
            if b.borrower == src_id {
                state.borrows.push(ActiveBorrow {
                    base: b.base,
                    is_mut: b.is_mut,
                    region: b.region,
                    borrower: dest_id,
                    span: b.span,
                    derived: b.derived,
                    direct: direct_copy && b.direct,
                    epoch: self.next_borrow_epoch,
                    via: b.via | rv_bit(rv),
                });
            }
            i = i + 1 as usize;
        }
    }

    fn local_holds_reference(self: &mut ZirVerifier, id: u32, locals: [Local]) -> bool {
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == id {
                // A raw pointer local holds no reference: the type says so, since
                // `type_holds_reference` refuses `RawPtr`/`RawPtrMut` the way it refuses an integer.
                return self.type_holds_reference(locals[li].ty);
            }
            li = li + 1 as usize;
        }
        return false;
    }

    fn is_temp_local(self: &ZirVerifier, id: u32, locals: [Local]) -> bool {
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == id {
                return locals[li].kind == LOCAL_KIND_TMP || locals[li].name_id == 0 as u32;
            }
            li = li + 1 as usize;
        }
        return false;
    }

    // Does this borrow constrain the borrowed place right now? Its borrower must still own
    // it, and an inherited borrow counts only once a named local holds it.
    fn borrow_counts(
        self: &ZirVerifier,
        b: &ActiveBorrow,
        state: &ZirAnalysisState,
        locals: [Local]
    ) -> bool {
        if state.ownership[b.borrower as usize] != OWN_OWNED { return false; }
        if !self.is_live(b.borrower) { return false; }
        return !(b.derived && self.is_temp_local(b.borrower, locals));
    }

    // A borrow of a place reached through a local (`&r.f`, a pattern binding through `&e`)
    // points into what that local borrows, explicitly dereferenced or not (a field access
    // auto-derefs a reference): DEST keeps those borrows after the local itself dies.
    // Without it, `if let E.A(x) = &e { e = E.B; **x }` read a freed payload. The copies keep
    // each borrow's own flag, like every other value built from an operand (inherit_borrows_keeping):
    // the pointer still points at the place, so a borrow of a local's own storage still counts at
    // that local's scope end - forcing `derived` here is what let a closure keep a reference into a
    // dead local (see inherit_borrows_captured).
    fn inherit_reborrow(
        self: &mut ZirVerifier,
        p: &Place,
        dest: u32,
        via: u64,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        self.inherit_borrows_keeping(p.base, dest, via, state);
    }

    // The same, for a closure's environment: the captures' borrows are what the closure keeps. One
    // exception, and it is what makes a by-value capture work: a borrow whose *base* is a compiler
    // temporary is the environment's own storage (`&env`, the tuple build_closure_env makes), which
    // lives in the enclosing frame - its lifetime is the escape analysis's business
    // (`returns_local_stack` / `stashes_param_mask`, src/summary_pass.zrl), and counting it here
    // rejected every closure that captures anything by value
    // (tests/language/closures/capturing_closure_if_expr.zrl). Recording a reference *inside* the
    // environment (base = the local it came from) is what must keep its flag.
    fn inherit_borrows_captured(
        self: &mut ZirVerifier,
        src: u32,
        dest: u32,
        via: u64,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if src == 0 as u32 || dest == 0 as u32 || src == dest { return; }
        let n = state.borrows.len();
        let mut bi = 0 as usize;
        while bi < n {
            if state.borrows[bi].borrower == src {
                let b = state.borrows[bi];
                state.borrows.push(ActiveBorrow {
                    base: b.base,
                    is_mut: b.is_mut,
                    region: b.region,
                    borrower: dest,
                    span: b.span,
                    // The environment's own storage is the closure's, not the caller's: keeping
                    // the flag means a closure whose environment ends at an inner scope is
                    // rejected while the closure is still live (Unified Solution D). A block-tail
                    // closure has its environment promoted to the enclosing scope instead
                    // (lower_block, promote_local_to_parent_scope).
                    derived: b.derived,
                    direct: false,
                    epoch: self.next_borrow_epoch,
                    via: b.via | via,
                });
            }
            bi = bi + 1 as usize;
        }
    }

    // DEST gets a copy of every borrow SRC holds (SRC's value now lives on in DEST).
    fn inherit_borrows(
        self: &mut ZirVerifier,
        src: u32,
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if src == 0 as u32 || dest == 0 as u32 || src == dest { return; }
        let n = state.borrows.len();
        let mut bi = 0 as usize;
        while bi < n {
            if state.borrows[bi].borrower == src {
                let b = state.borrows[bi];
                state.borrows.push(ActiveBorrow {
                    base: b.base,
                    is_mut: b.is_mut,
                    region: b.region,
                    borrower: dest,
                    span: b.span,
                    derived: true,
                    direct: false,
                    epoch: self.next_borrow_epoch,
                    via: b.via,
                });
            }
            bi = bi + 1 as usize;
        }
    }

    // The same, for a value *built* from SRC (a field of a struct or tuple literal, an array
    // element, a variant payload): each copy keeps the flag the borrow it copies already had. A
    // value that holds the operand keeps pointing wherever the operand pointed - `Holder { r: &x }`
    // holds `x`'s own storage (`&x` is a fresh borrow, derived=false), while `Holder { r: v.get(0) }`
    // holds what the call derived (derived=true, still exempt at `v`'s scope end). Forcing `true`
    // here, as the construction cases used to, read the first as the second: a field holding `&x`
    // outlived `x` (exit 7 reading its dead slot) because a derived borrow is exempt for a local
    // without `Drop`.
    fn inherit_borrows_keeping(
        self: &mut ZirVerifier,
        src: u32,
        dest: u32,
        via: u64,
        state: &mut ZirAnalysisState
    ) {
        if src == 0 as u32 || dest == 0 as u32 || src == dest { return; }
        let n = state.borrows.len();
        let mut bi = 0 as usize;
        while bi < n {
            if state.borrows[bi].borrower == src {
                let b = state.borrows[bi];
                state.borrows.push(ActiveBorrow {
                    base: b.base,
                    is_mut: b.is_mut,
                    region: b.region,
                    borrower: dest,
                    span: b.span,
                    derived: b.derived,
                    direct: false,
                    epoch: self.next_borrow_epoch,
                    via: b.via | via,
                });
            }
            bi = bi + 1 as usize;
        }
    }

    // DERIVED=false records the inherited borrow as one of the local's own storage, which
    // check_scope_end_borrowed counts without asking for the local's `Drop` (see the call case in
    // inherit_rv_borrows for when a call's result should be read that way). Any non-derived borrow
    // of an underlying local's own stack storage retains derived: false.
    fn inherit_borrows_as(
        self: &mut ZirVerifier,
        src: u32,
        dest: u32,
        via: u64,
        state: &mut ZirAnalysisState,
        as_derived: bool,
        locals: [Local]
    ) {
        if src == 0 as u32 || dest == 0 as u32 || src == dest { return; }
        let n = state.borrows.len();
        let mut bi = 0 as usize;
        while bi < n {
            if state.borrows[bi].borrower == src {
                let b = state.borrows[bi];
                // Whether SRC's value points at what it borrows, rather than at something it
                // was built from. That is recorded when the borrow is created and carried by a
                // bare copy, so it does not have to be guessed from the types.
                let is_direct = b.direct;
                let derived = if !as_derived {
                    false
                } else if is_direct || b.derived {
                    true
                } else if !b.derived && self.borrowed_storage_is_local(&b.base, locals) {
                    false
                } else {
                    true
                };
                state.borrows.push(ActiveBorrow {
                    base: b.base,
                    is_mut: b.is_mut,
                    region: b.region,
                    borrower: dest,
                    span: b.span,
                    derived: derived,
                    direct: false,
                    epoch: self.next_borrow_epoch,
                    via: b.via | via,
                });
            }
            bi = bi + 1 as usize;
        }
    }

    // A call, struct, tuple, array or enum value built from borrowed operands holds those
    // borrows, when the destination can hold a reference (a reference, a slice, or a struct, enum
    // or tuple containing one). For a call, the inputs are the callee's `ret_ties`: the parameters
    // named by `#[borrows(..)]`, or by default `self` if it is a reference, otherwise every
    // reference/pointer parameter; a call through a pointer inherits from all of them. Lexical,
    // like every borrow here.
    // exhaustive: every rvalue must say which of its operands' borrows its result inherits.
    fn inherit_rv_borrows(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if dest == 0 as u32 || !self.local_holds_reference(dest, locals) { return; }
        match *rv {
            ZirRvalue.Call(fn_id, args) => {
                let mut ties = 0xffffffffffffffff as u64;
                let mut storage = 0 as u64;
                // A callee whose storage masks are unknown (`storage_known` false: an import whose
                // `.zri` carried no storage keys, the fail-open case the audit found) is read as
                // handing back a pointer into *each* argument's own storage. That is the strict
                // side: the borrow stays live lexically, so `check_scope_end_borrowed` applies it
                // without the `Drop` exemption instead of skipping it.
                let mut storage_unknown = true;
                if (fn_id as usize) < self.zil_module.functions.len() {
                    ties = self.zil_module.functions[fn_id as usize].ret_ties;
                    storage = self.zil_module.functions[fn_id as usize].ret_storage;
                    storage_unknown = !self.zil_module.functions[fn_id as usize].storage_known;
                }
                for i in 0 as usize..args.len {
                    if i >= 64 as usize || ((ties >> (i as u64)) & 1 as u64) != 0 as u64 {
                        // Does the callee hand back a pointer into this argument's own storage
                        // (`id(&x)`), or one built out of what the argument references
                        // (`v.as_slice()` returns a slice of the buffer it points at)? The summary
                        // says: the `.zri` field for an import, the ZIR-level reading of the body
                        // for a function of this module. Unknown reads as the argument's own
                        // storage - the strict side (doc/SAFETY.md §4.4).
                        // A bit for a slice parameter says the result points into the bytes the
                        // slice covers; the whole-program walk keeps those in the contents mask, so
                        // an import is read the same way: derived, not the header's own storage
                        // (`"a,b".split_raw(..)` holds pointers into the literal's bytes, not into
                        // the temporary that holds its header).
                        let own_storage = storage_unknown
                            || (i < 64 as usize
                                && ((storage >> (i as u64)) & 1 as u64) != 0 as u64
                                && !self.callee_param_is_slice(fn_id, i));
                        self.inherit_borrows_as(
                            args[i].base,
                            dest,
                            rv_bit(rv),
                            state,
                            !own_storage,
                            locals
                        );
                    }
                }
            },
            // A call through a value (`let f = cb; f(&x)`) has no summary, so its result may point
            // into the callee value's own captured environment or *any* argument's own storage.
            // Own storage, not derived: reading it as derived exempted the borrow at the local's
            // scope end and `y = f(&x)` outlived `x`; the callee value's environment is what a
            // closure returning a capture hands back (probe 208).
            ZirRvalue.CallPtr(f, args) => {
                self.inherit_borrows_as(f.base, dest, rv_bit(rv), state, false, locals);
                for a in args {
                    self.inherit_borrows_as(a.base, dest, rv_bit(rv), state, false, locals);
                }
            },
            // A value built from operands holds what they hold: a struct, tuple or array literal,
            // a variant payload, a box, a repeated array or a cast. The copy keeps each operand
            // borrow's own flag (see inherit_borrows_keeping).
            ZirRvalue.StructLiteral(_, args)
                | ZirRvalue.Array(_, args) => {
                for a in args { self.inherit_borrows_keeping(a.base, dest, rv_bit(rv), state); }
            },
            ZirRvalue.Tuple(elems) => {
                for e in elems { self.inherit_borrows_keeping(e.base, dest, rv_bit(rv), state); }
            },
            ZirRvalue.EnumVariant(_, _, payload) | ZirRvalue.EnumPayload(payload, _, _) => {
                self.inherit_borrows_keeping(payload.base, dest, rv_bit(rv), state);
            },
            ZirRvalue.Boxed(p) | ZirRvalue.ArrayRepeat(p, _, _) => {
                self.inherit_borrows_keeping(p.base, dest, rv_bit(rv), state);
            },
            // A cast to a *raw* pointer ends the borrow: a raw pointer carries no lifetime, and
            // the cast is the documented escape hatch (`&mut x as *mut T` keeps `x` usable,
            // tests/language/memory/raw_ptr_element_assignment.zrl). Any other cast (to a
            // reference or an aggregate) carries the operand's borrows.
            ZirRvalue.Cast(p, target) => {
                if target == 0 as u32
                    || !is_raw_pointer_tag(self.get_type_decl(target).def.get_tag()) {
                    self.inherit_borrows_keeping(p.base, dest, rv_bit(rv), state);
                }
            },
            ZirRvalue.PtrFromInt(_, _) => {},
            ZirRvalue.Syscall(args) | ZirRvalue.Intrinsic(_, args) => {
                for a in args {
                    self.inherit_borrows_as(a.base, dest, rv_bit(rv), state, false, locals);
                }
            },
            ZirRvalue.FuncAddr(_, env_ptr) => {
                if env_ptr != 0 as u32 {
                    self.inherit_borrows_captured(env_ptr, dest, rv_bit(rv), state, locals);
                }
            },
            // A borrow of a place (`&p`) is recorded by check_let/check_assign, and a copy of a
            // reference by propagate_borrow; nothing is inherited here.
            ZirRvalue.Use(_)
                | ZirRvalue.Ref(_, _)
                | ZirRvalue.RefMut(_, _)
                // Scalars: no reference result.
                | ZirRvalue.Const(_, _)
                | ZirRvalue.Sizeof(_)
                | ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_)
                | ZirRvalue.GetEnv
                | ZirRvalue.UnaryOp(_, _)
                | ZirRvalue.BinaryOp(_, _, _) => {},
            // A variant test reads only the discriminant, and the same scrutinee temporary is
            // read again by the `EnumPayload` that binds the payload: its borrows must survive
            // this statement (they end at the payload extraction or the scope).
            ZirRvalue.VariantCheck(_, _, _) => {},
        }
    }

    // A compiler temporary lives for the statement that uses it, so once used, its borrows
    // end (any that matter were passed on to the destination first). Named locals keep
    // theirs until they go out of scope.
    fn end_temp_borrows(
        self: &mut ZirVerifier,
        base: u32,
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if base == 0 as u32 || base == dest || !self.is_temp_local(base, locals) { return; }
        let mut bi = 0 as usize;
        while bi < state.borrows.len() {
            if state.borrows[bi].borrower == base {
                let _ = state.borrows.remove(bi);
            } else {
                bi = bi + 1 as usize;
            }
        }
    }

    fn end_places_temp_borrows(
        self: &mut ZirVerifier,
        places: [Place],
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        let mut i = 0 as usize;
        while i < places.len {
            self.end_temp_borrows(places[i].base, dest, state, locals);
            i = i + 1 as usize;
        }
    }

    // Borrows held by the compiler temporaries RV consumes end with this statement (the value
    // that inherited them keeps them).
    // exhaustive: every rvalue must say which temporary operands stop holding borrows.
    fn end_rv_temp_borrows(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        match *rv {
            ZirRvalue.Use(p)
                | ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.Boxed(p)
                | ZirRvalue.ArrayRepeat(p, _, _)
                | ZirRvalue.Cast(p, _)
                | ZirRvalue.PtrFromInt(p, _)
                | ZirRvalue.UnaryOp(_, p) => {
                self.end_temp_borrows(p.base, dest, state, locals);
            },
            ZirRvalue.BinaryOp(_, a, b) => {
                self.end_temp_borrows(a.base, dest, state, locals);
                self.end_temp_borrows(b.base, dest, state, locals);
            },
            ZirRvalue.Call(_, args)
                | ZirRvalue.StructLiteral(_, args)
                | ZirRvalue.Tuple(args)
                | ZirRvalue.Array(_, args)
                | ZirRvalue.Syscall(args)
                | ZirRvalue.Intrinsic(_, args) => {
                self.end_places_temp_borrows(args, dest, state, locals);
            },
            ZirRvalue.CallPtr(f, args) => {
                self.end_temp_borrows(f.base, dest, state, locals);
                self.end_places_temp_borrows(args, dest, state, locals);
            },
            ZirRvalue.FuncAddr(_, env_ptr) => {
                if env_ptr != 0 as u32 {
                    self.end_temp_borrows(env_ptr, dest, state, locals);
                }
            },
            ZirRvalue.Const(_, _)
                | ZirRvalue.Sizeof(_)
                | ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_)
                | ZirRvalue.GetEnv
                // Reads only the discriminant; the same scrutinee temporary is read again by
                // the `EnumPayload` that binds the payload, so its borrows must survive this
                // statement.
                | ZirRvalue.VariantCheck(_, _, _) => {},
        }
    }

    // exhaustive: every statement must state its ownership and borrow effect.
    fn check_stmt(
        self: &mut ZirVerifier,
        stmt: &ZirStmt,
        state: &mut ZirAnalysisState,
        locals: [Local],
        b: &ZirBlock,
        si: usize,
        func: &ZirFunction
    ) {
        self.cur_rv = 0 as u64;
        self.cur_stmt = stmt_bit(stmt);
        self.cur_term = 0 as u64;
        match *stmt {
            ZirStmt.Let(local_id, rv, span) => {
                self.check_let(local_id, &rv, span, state, locals, b, si, func);
            },
            ZirStmt.Assign(place, rv, span) => {
                self.check_assign(&place, &rv, span, state, locals, b, si, func);
            },
            ZirStmt.Drop(place, span) => { self.check_drop(&place, false, span, state, locals); },
            ZirStmt.DropIfLive(place, span) => {
                self.check_drop(&place, true, span, state, locals);
            },
            ZirStmt.Intrinsic(name_id, args, span) => {
                if self.intern_table.lookup(name_id) == "explicit_drop" {
                    self.check_explicit_drop(args, span, state, locals);
                } else {
                    self.check_places_moved(args, span, state, locals);
                }
            },
            ZirStmt.EndBorrow(borrower, span) => {
                // The local's storage ends here (lowering emits this for every local whose scope
                // exits), so nothing that outlives the scope may still borrow it.
                self.check_scope_end_borrowed(borrower, span, state, locals);
                self.end_borrow_of(borrower, state);
            },
        }
    }

    // `let local = rv`: a reference makes a borrow; anything else is checked as a use, and
    // borrows and ownership pass to the new local.
    fn check_let(
        self: &mut ZirVerifier,
        local_id: u32,
        rv: &ZirRvalue,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        b: &ZirBlock,
        si: usize,
        func: &ZirFunction
    ) {
        self.cur_rv = rv_bit(rv);
        match *rv {
            ZirRvalue.Ref(p, region) => {
                self.check_borrow_creation(
                    &p,
                    false,
                    span,
                    state,
                    locals,
                    local_id,
                    region,
                    0 as u32
                );
                self.inherit_reborrow(&p, local_id, rv_bit(rv), state, locals);
            },
            ZirRvalue.RefMut(p, region) => {
                let exempt_epoch = self.get_reset_to_exempt_epoch(b, si, local_id, p.base, state);
                self.check_borrow_creation(
                    &p,
                    true,
                    span,
                    state,
                    locals,
                    local_id,
                    region,
                    exempt_epoch
                );
                self.inherit_reborrow(&p, local_id, rv_bit(rv), state, locals);
            },
            _ => {
                let is_cap_alias = local_id != 0 as u32
                    && (local_id as usize) <= locals.len
                    && locals[local_id as usize - 1 as usize].is_capture_alias;
                if is_cap_alias {
                    if let ZirRvalue.Use(p) = *rv {
                        self.cur_rv = rv_bit(rv);
                        self.check_place_use(&p, false, span, state, locals);
                    } else {
                        self.check_rvalue_use(rv, span, state, locals, func);
                    }
                } else {
                    self.check_rvalue_use(rv, span, state, locals, func);
                }
                // A closure's environment owns what it captures: an owning value (a collection, a
                // `Box`, an `Arena`) is moved into it, so the outer binding cannot be used or
                // dropped afterwards (probe 298). The environment is the tuple the lowerer marks
                // with the closure's span.
                if let ZirRvalue.Tuple(args) = *rv {
                    if self.is_closure_env(local_id, locals) {
                        let mut ai = 0 as usize;
                        while ai < args.len {
                            let a = args[ai];
                            if a.base != 0 as u32
                                && (a.base as usize) <= locals.len
                                && self.local_type_owns_storage(a.base, locals) {
                                state.ownership[a.base as usize] = OWN_MOVED;
                            }
                            ai = ai + 1 as usize;
                        }
                    }
                }
                if let ZirRvalue.Call(fn_id, args) = *rv {
                    if self.is_arena_mark_call(fn_id) && args.len >= 1 as usize {
                        let arena_base = self.get_borrow_base(args[0].base, state);
                        self.set_mark_info(state, local_id, arena_base, self.next_borrow_epoch);
                    }
                }
                if let ZirRvalue.Use(p) = *rv {
                    let mut mi = 0 as usize;
                    while mi < state.mark_infos.len() {
                        if state.mark_infos[mi].mark_local == p.base {
                            let info = state.mark_infos[mi];
                            self.set_mark_info(state, local_id, info.arena_base, info.epoch);
                            break;
                        }
                        mi = mi + 1 as usize;
                    }
                }
                // The local points into the enum it was taken from: later moves through it
                // are checked against borrows of that place.
                if let ZirRvalue.EnumPayload(source, _, _) = *rv {
                    if local_id != 0 as u32 {
                        state.enum_aliases.push(EnumPayloadAlias {
                            local_id: local_id,
                            source: source
                        });
                    }
                }
            },
        }
        self.inherit_rv_borrows(rv, local_id, state, locals);
        self.propagate_borrow(rv, state, local_id, locals);
        self.end_rv_temp_borrows(rv, local_id, state, locals);
        state.ownership[local_id as usize] = OWN_OWNED;
        state.maybe_live[local_id as usize] = false;
    }

    fn check_assign(
        self: &mut ZirVerifier,
        place: &Place,
        rv: &ZirRvalue,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        b: &ZirBlock,
        si: usize,
        func: &ZirFunction
    ) {
        self.cur_rv = rv_bit(rv);
        if place.base != 0 as u32 && (place.base as usize) <= locals.len {
            let loc = &locals[place.base as usize - 1 as usize];
            if loc.is_capture_alias
                && loc.is_copy
                && !self.place_has_deref(place)
                && (place.projections.len == 0 as usize || !self.is_pointer_like_type(loc.ty)) {
                let mut msg = unsafe { ByteVec.new_raw(self.arena) };
                msg.push_slice("the closure holds a copy of '");
                msg.push_slice(self.intern_table.lookup(loc.name_id));
                msg.push_slice(
                    "'; assigning to it changes only the copy; capture a '&mut' reference instead"
                );
                self.report_error(msg.as_slice(), span);
                return;
            }
        }
        if self.writes_immutable_binding(place, locals) {
            self.report_var_error(
                "cannot assign to",
                place.base,
                "because it is immutable",
                span,
                locals
            );
            return;
        }
        // Writing through a read-only pointer anywhere along the place is rejected: `&T` means
        // read-only, whether the `&T` is the base (`(*r).x = 5`) or a field on the way
        // (`h.r.x = 5`). Raw pointers stay the unchecked escape hatch.
        if place.projections.len > 0 as usize {
            if self.place_last_deref_is_readonly(place, locals) {
                self.report_var_error(
                    "cannot assign to",
                    place.base,
                    self.readonly_reason(),
                    span,
                    locals
                );
                return;
            }
            let st = state.ownership[place.base as usize];
            if st == OWN_UNINIT {
                self.report_var_error(
                    "use of uninitialized variable",
                    place.base,
                    "",
                    span,
                    locals
                );
                return;
            }
            if st == OWN_MOVED {
                self.report_var_error("use of moved value", place.base, "", span, locals);
                return;
            }
            // `@drop(b); *b = 5;` would write into freed storage (check_place_use rejects the read).
            if st == OWN_DROPPED {
                self.report_var_error("use of dropped value", place.base, "", span, locals);
                return;
            }
        }
        // The old value's borrow, if it was a borrower, ends - but only when the place being
        // assigned *is* the binding. A write through a reference (`*rm = 5`, `rm.f = v`) has
        // `place.base == rm`, and the borrow that would be ended there is the one `rm` itself holds
        // (`&mut x`), which is still live. Ending it let a later `&x` pass the conflict scan while
        // `rm` went on being used: the shared borrow then observed writes made through the `&mut`
        // (with a `Drop` value that is a use after free - a segfault in safe code).
        let borrower_id = place.base;
        // Only when the place being assigned *is* the binding: a write through a reference
        // (`*rm = 5`, `rm.f = v`) has `place.base == rm`, and the borrow that ends there is the one
        // `rm` itself holds (`&mut x`), which is still live. Ending it let a later `&x` pass the
        // conflict scan while `rm` went on being used, so the shared borrow observed writes made
        // through the `&mut` - with a `Drop` value, a use after free.
        let assigning_the_binding = place.projections.len == 0 as usize;
        if assigning_the_binding {
            self.end_borrow_of(borrower_id, state);
        }
        self.advance_container_mutation_epoch(place.base, state);
        match *rv {
            ZirRvalue.Ref(p, region) => {
                self.check_borrow_creation(
                    &p,
                    false,
                    span,
                    state,
                    locals,
                    borrower_id,
                    region,
                    0 as u32
                );
                self.inherit_reborrow(&p, borrower_id, rv_bit(rv), state, locals);
            },
            ZirRvalue.RefMut(p, region) => {
                let exempt_epoch = self.get_reset_to_exempt_epoch(
                    b,
                    si,
                    borrower_id,
                    p.base,
                    state
                );
                self.check_borrow_creation(
                    &p,
                    true,
                    span,
                    state,
                    locals,
                    borrower_id,
                    region,
                    exempt_epoch
                );
                self.inherit_reborrow(&p, borrower_id, rv_bit(rv), state, locals);
            },
            _ => {
                self.check_rvalue_use(rv, span, state, locals, func);
                if place.projections.len == 0 as usize {
                    let mut handled_mark = false;
                    if let ZirRvalue.Call(fn_id, args) = *rv {
                        if self.is_arena_mark_call(fn_id) && args.len >= 1 as usize {
                            let arena_base = self.get_borrow_base(args[0].base, state);
                            self.set_mark_info(
                                state,
                                borrower_id,
                                arena_base,
                                self.next_borrow_epoch
                            );
                            handled_mark = true;
                        }
                    }
                    if let ZirRvalue.Use(p) = *rv {
                        let mut mi = 0 as usize;
                        while mi < state.mark_infos.len() {
                            if state.mark_infos[mi].mark_local == p.base {
                                let info = state.mark_infos[mi];
                                self.set_mark_info(state, borrower_id, info.arena_base, info.epoch);
                                handled_mark = true;
                                break;
                            }
                            mi = mi + 1 as usize;
                        }
                    }
                    if !handled_mark {
                        self.remove_mark_info(state, borrower_id);
                    }
                    self.inherit_rv_borrows(rv, borrower_id, state, locals);
                } else if !self.place_writes_through_pointer(place, locals) {
                    // A write into a field, element or tuple slot of the local (`x.f = ..`,
                    // `x[i] = ..`, `x.0 = ..`) stores the value in x: x holds what the value
                    // holds. A write through a pointer stores into the referent instead, which
                    // the escape rules judge.
                    self.inherit_rv_borrows(rv, borrower_id, state, locals);
                }
            },
        }
        if self.place_outlives_frame(func, locals, place) {
            if self.check_rvalue_escapes_frame("cannot store", rv, span, state, locals, func) {
                return;
            }
        }
        // The place itself must not be borrowed.
        for i in 0 as usize..state.borrows.len() {
            let b = &state.borrows[i];
            if self.borrow_counts(b, &*state, locals) && self.places_overlap(&b.base, place) {
                self.report_borrow_conflict(
                    "cannot assign to",
                    place,
                    "because it is borrowed",
                    span,
                    &b.base,
                    b.span,
                    b.via,
                    locals
                );
                return;
            }
        }
        if place.projections.len == 0 as usize {
            self.propagate_borrow(rv, state, place.base, locals);
            state.ownership[place.base as usize] = OWN_OWNED;
            state.maybe_live[place.base as usize] = false;
        } else if !self.place_writes_through_pointer(place, locals) {
            // The borrows of a copied reference join x's: x keeps each borrow it already holds
            // and the old value's borrow is not ended, because the other fields are still live.
            // The copy lands in a field or slot, not in x itself, so it is not a direct borrow.
            let before = state.borrows.len();
            self.propagate_borrow(rv, state, place.base, locals);
            let mut bi = before;
            while bi < state.borrows.len() {
                state.borrows[bi].direct = false;
                bi = bi + 1 as usize;
            }
        }
        self.end_rv_temp_borrows(rv, place.base, state, locals);
    }

    // A scope-exit drop (IF_LIVE: guarded by a runtime drop flag, so a value already moved or
    // dropped on this path is fine). Linear resources (fd, ioring) must be closed, not dropped.
    fn check_drop(
        self: &mut ZirVerifier,
        place: &Place,
        if_live: bool,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if place.base == 0 as u32 || place.base > locals.len as u32 { return; }
        let loc = &locals[place.base as usize - 1 as usize];
        if loc.is_capture_alias { return; }
        let idx = place.base as usize;
        let st = state.ownership[idx];
        if st == OWN_UNINIT || st == OWN_DROPPED {
            if !if_live {
                self.report_var_error(
                    "cannot drop value",
                    place.base,
                    "that is not owned",
                    span,
                    locals
                );
            }
            return;
        }
        // Still owned on some path into this drop: not closed on every path (`if c { close(f); }`).
        if st == OWN_MOVED && state.maybe_live[idx] {
            let ty = self.get_place_type(place, locals);
            if ty != 0 as u32 && self.type_holds_linear(ty) {
                self.report_var_error(
                    "linear resource",
                    place.base,
                    "is not closed on every path",
                    span,
                    locals
                );
            }
        }
        if st == OWN_OWNED { self.check_drop_not_linear(place, span, locals); }
        // Only the binding's own drop is recorded on the local. A drop of a *projected* place -
        // `*rm = a` drops the old `*rm` before storing - is a drop of the referent, which is not a
        // local and cannot be named here. Recording it against `rm` marked the pointer local dropped,
        // and `borrow_counts` stops counting a borrow whose borrower is not owned, so the live `&mut`
        // went invisible and the right-hand side's read of the same place passed the conflict scan:
        // the value was moved out of itself, and with an owning type that is a use after free (the
        // arena form exits 139).
        let dropping_the_binding = place.projections.len == 0 as usize;
        if dropping_the_binding {
            state.ownership[idx] = OWN_DROPPED;
            state.maybe_live[idx] = false;
        }
    }

    fn check_drop_not_linear(self: &mut ZirVerifier, place: &Place, span: Span, locals: [Local]) {
        let ty_id = self.get_place_type(place, locals);
        if ty_id == 0 as u32 { return; }
        if !self.is_linear_tag(ty_id) && self.type_holds_linear(ty_id) {
            // A struct, tuple or enum holding an fd: dropping it would drop the fd.
            self.report_var_error(
                "value",
                place.base,
                "holds a linear resource (fd or ioring) that must be explicitly closed, not dropped",
                span,
                locals
            );
        }
        let ty_tag = self.get_type_decl(ty_id).def.get_tag();
        if ty_tag != ILTYPE_FD && ty_tag != ILTYPE_IORING { return; }
        let mut name_id = 0 as u32;
        for l in locals { if l.id == place.base { name_id = l.name_id; } }
        let mut msg: &mut ByteVec = unsafe { ByteVec.new_raw(self.arena) };
        msg.push_slice("linear resource");
        if name_id != 0 as u32 {
            msg.push_slice(" '");
            msg.push_slice(self.intern_table.lookup(name_id));
            msg.push_slice("'");
        }
        msg.push_slice(if ty_tag == ILTYPE_FD { " (type fd)" } else { " (type ioring)" });
        msg.push_slice(" must be explicitly closed, not dropped");
        self.report_error(msg.as_slice(), span);
    }

    // The user's `@drop(x)` (lowering emits this marker before it): unlike a scope-exit drop,
    // the value must be definitely live here.
    fn check_explicit_drop(
        self: &mut ZirVerifier,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if args.len != 1 as usize || args[0].base == 0 as u32 || args[0].base > locals.len as u32 {
            return;
        }
        let loc = &locals[args[0].base as usize - 1 as usize];
        if loc.is_capture_alias && args[0].projections.len == 0 as usize {
            self.report_error("cannot move out of a closure capture", span);
            return;
        }
        let drop_st = state.ownership[args[0].base as usize];
        if drop_st == OWN_MOVED {
            self.report_var_error(
                "cannot drop value",
                args[0].base,
                "that may have been moved",
                span,
                locals
            );
        } else if drop_st == OWN_DROPPED {
            self.report_var_error(
                "cannot drop value",
                args[0].base,
                "that is already dropped",
                span,
                locals
            );
        }
        // Dropping a value a live reference points into frees what the reference reads (`@drop(b)`
        // then `*r`), the same escape a scope end reports; the explicit form needs it here because
        // no EndBorrow runs at an intrinsic.
        let mut bi = 0 as usize;
        while bi < state.borrows.len() {
            let b = &state.borrows[bi];
            if b.borrower != args[0].base
                && self.borrow_counts(b, state, locals)
                && self.places_overlap(&args[0], &b.base) {
                self.report_var_error(
                    "cannot drop value",
                    args[0].base,
                    "while it is still borrowed",
                    span,
                    locals
                );
                return;
            }
            bi = bi + 1 as usize;
        }
    }

    fn end_borrow_of(self: &mut ZirVerifier, borrower: u32, state: &mut ZirAnalysisState) {
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            if state.borrows[i].borrower == borrower {
                state.borrows.remove(i);
            } else {
                i = i + 1 as usize;
            }
        }
    }

    // Whether the storage a borrow is rooted at is the local's own, as opposed to storage
    // behind a pointer or reference, which belongs to whoever allocated it and may outlive the
    // local. `&x` and `&x.field` borrow the local's storage; a `Box` deref is storage the local
    // owns and whose `Drop` frees it, so it counts; a deref of a pointer, reference or slice
    // (`&*p`, `&*self.current_func`) does not, however many field steps come first.
    fn borrowed_storage_is_local(
        self: &mut ZirVerifier,
        borrowed: &Place,
        locals: [Local]
    ) -> bool {
        let mut curr_ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == borrowed.base {
                curr_ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if curr_ty == 0 as u32 { return false; }
        // A reference, pointer or slice local owns nothing behind it: `&*s.b` through an `&S`
        // points into the caller's storage, not this local's. The first projection (or an
        // auto-deref `s.b`) goes through the pointer, so nothing beyond it is this local's.
        let base_tag = self.get_type_decl(curr_ty).def.get_tag();
        if borrowed.projections.len > 0 as usize
            && (is_any_pointer_tag(base_tag) || base_tag == ILTYPE_SLICE) {
            return false;
        }
        for proj in borrowed.projections {
            match *proj {
                Projection.Deref => {
                    let d_tag = self.get_type_decl(curr_ty).def.get_tag();
                    if d_tag != ILTYPE_BOXED && d_tag != ILTYPE_BOXEDMUT { return false; }
                    curr_ty = self.get_ptr_inner_type(curr_ty);
                },
                Projection.Field(name) => {
                    curr_ty = self.get_field_type(curr_ty, self.get_field_index(curr_ty, name));
                },
                Projection.TupleIndex(idx) => {
                    curr_ty = self.get_tuple_elem_type(curr_ty, idx);
                },
                Projection.Index(_) => {
                    curr_ty = self.get_slice_element_type(curr_ty);
                },
            }
        }
        return true;
    }

    // Whether ending LOCAL_ID's scope releases storage it owns: true for a type with a `Drop`
    // impl (an `Arena` handle unmaps its region, a `Box` frees its pointee) - *including* one
    // reached through a struct, enum, tuple, array or `Box` field, since a value whose field
    // frees storage frees storage when it goes out of scope. A `Vec` frees nothing, so the
    // buffer a slice into it points at outlives the `Vec` itself.
    fn local_type_has_drop(self: &mut ZirVerifier, local_id: u32, locals: [Local]) -> bool {
        let mut ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == local_id {
                ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if ty == 0 as u32 { return false; }
        return self.type_has_drop(ty, 0 as usize);
    }

    // As `type_holds_linear`, for `Drop`: a user type with its own `Drop` impl, or one whose
    // struct, enum, tuple, array or `Box` field has one. Reading only the local's own type made a
    // struct holding an `Arena` read as "frees nothing", so a derived borrow outliving it was
    // accepted and read freed memory (probe 166).
    //
    // Past the recursion limit the answer is *unknown*, which must read as "it does free
    // storage": "frees nothing" is what exempts a derived borrow at the local's scope end, so a
    // `false` there leaves the borrow live and reads the region a `Drop` freed (a value holding
    // an `Arena` nine struct levels down, exit 139, probe 175). `ty_id == 0` stays false: that is
    // the absent type, not a deep one. A recursive type is over-approximated, which never removes
    // a rejection.
    fn type_has_drop(self: &mut ZirVerifier, ty_id: u32, depth: usize) -> bool {
        // (`past_limit_drop`: a name of its own so the mutation harness can revert this answer on its
        // own, as it does the one above for the reference question.)
        let past_limit_drop = depth > 8 as usize;
        if past_limit_drop { return true; }
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.type_decl_copy(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_TUPLE {
            let elems = p_ty.def.get_Tuple();
            let mut i = 0 as usize;
            while i < elems.len {
                if self.type_has_drop(elems[i], depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
            return false;
        }
        if tag == ILTYPE_ARRAY {
            return self.type_has_drop(p_ty.def.get_Array().element, depth + 1 as usize);
        }
        if tag == ILTYPE_BOXED {
            return self.type_has_drop(p_ty.def.get_Boxed(), depth + 1 as usize);
        }
        if tag == ILTYPE_BOXEDMUT {
            return self.type_has_drop(p_ty.def.get_BoxedMut(), depth + 1 as usize);
        }
        if tag != ILTYPE_USER { return false; }
        if self.has_drop_impl(p_ty.def.get_User().name) { return true; }
        let user_id = p_ty.def.get_User().id;
        if user_id == 0xffffffff as u32 || user_id as usize >= self.zil_module.typedefs.len() {
            return false;
        }
        let p_def = self.zil_module.typedefs[user_id as usize];
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            let fields = p_def.get_Struct().fields;
            let mut i = 0 as usize;
            while i < fields.len {
                if self.type_has_drop(fields[i].ty, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            let variants = p_def.get_Enum().variants;
            let mut i = 0 as usize;
            while i < variants.len {
                if self.type_has_drop(variants[i].payload, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        }
        return false;
    }

    // A local's storage ends here (lowering emits `EndBorrow` for every local whose scope
    // exits): if anything that outlives the scope still borrows it, the borrower would point at
    // dead storage — "does not live long enough". `borrow_counts` skips borrows whose borrower
    // is dead, moved or a compiler temporary, so this rejects only a live named borrower.
    //
    // A borrow a call or method derived (`v.as_slice()`, `Vec::new_in(&a)`) points wherever that
    // result points, which for a local whose type frees nothing (a `Vec` over an arena buffer)
    // is storage that outlives the local, so those need LOCAL_ID's own `Drop` to count.
    fn check_scope_end_borrowed(
        self: &mut ZirVerifier,
        local_id: u32,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local]
    ) {
        if local_id == 0 as u32 { return; }
        let place = Place {
            base: local_id,
            projections: @slice(0 as *mut Projection, 0 as usize)
        };
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            let b = &state.borrows[i];
            if b.borrower != local_id
                && self.borrow_counts(b, state, locals)
                && self.places_overlap(&place, &b.base)
                && self.borrowed_storage_is_local(&b.base, locals)
                && (!b.derived || self.local_type_has_drop(local_id, locals)) {
                self.report_borrow_conflict(
                    "cannot let",
                    &place,
                    "go out of scope while it is still borrowed",
                    span,
                    &b.base,
                    b.span,
                    b.via,
                    locals
                );
                return;
            }
            i = i + 1 as usize;
        }
    }

    // The unifying store rule:
    // A store is rejected when the value stored carries a borrow of frame-owned storage
    // (a collection, a box, an arena, or a closure's owned capture) and the destination outlives the frame
    // (a pointer or reference parameter, a captured &mut, another capture, or a global).
    //
    // This applies both to direct assignments (`*dst = val`, `dst.field = val`) where
    // `place_outlives_frame` holds, and to calls (`callee(dst, val)`) where callee
    // storage summaries indicate a value passed via one argument is stored into a target
    // that outlives the caller's frame (including loads and derefs through reference parameters).
    fn check_borrow_escapes_frame(
        self: &mut ZirVerifier,
        action: [u8],
        borrower_local: u32,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) -> bool {
        return self.check_borrow_escapes_frame_depth(
            action,
            borrower_local,
            span,
            state,
            locals,
            func,
            0 as usize
        );
    }

    fn check_borrow_escapes_frame_depth(
        self: &mut ZirVerifier,
        action: [u8],
        borrower_local: u32,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction,
        depth: usize
    ) -> bool {
        if borrower_local == 0 as u32 || depth > 8 as usize { return false; }
        let mut vi = 0 as usize;
        while vi < state.borrows.len() {
            let b = &state.borrows[vi];
            if b.borrower == borrower_local && b.base.base != 0 as u32 {
                if self.borrowed_storage_is_local(&b.base, locals)
                    && self.local_type_owns_storage(b.base.base, locals)
                    && !self.local_storage_external(func, locals, b.base.base, 0 as usize) {
                    self.report_borrow_conflict(
                        action,
                        &b.base,
                        "a reference into storage owned by this frame (a collection, a box or an arena) cannot outlive the frame",
                        span,
                        &b.base,
                        b.span,
                        b.via,
                        locals
                    );
                    return true;
                }
                if b.base.base != borrower_local
                    && self.check_borrow_escapes_frame_depth(
                        action,
                        b.base.base,
                        span,
                        state,
                        locals,
                        func,
                        depth + 1 as usize
                    ) {
                    return true;
                }
            }
            vi = vi + 1 as usize;
        }
        return false;
    }

    fn local_is_ref_or_ptr(self: &ZirVerifier, local_id: u32, locals: [Local]) -> bool {
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == local_id {
                let ty = locals[li].ty;
                if ty == 0 as u32 || (ty as usize) > self.zil_module.types.len() { return false; }
                let tag = self.zil_module.types[ty as usize - 1 as usize].def.get_tag();
                return is_any_pointer_tag(tag);
            }
            li = li + 1 as usize;
        }
        return false;
    }

    fn rvalue_is_external_target(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        local_id: u32,
        rv: &ZirRvalue,
        depth: usize
    ) -> bool {
        match *rv {
            ZirRvalue.Use(p)
                | ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.Cast(p, _)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.Boxed(p) => {
                return self.local_is_external_target(func, locals, p.base, depth + 1 as usize);
            },
            ZirRvalue.Tuple(args) | ZirRvalue.StructLiteral(_, args) | ZirRvalue.Array(_, args) => {
                for a in args {
                    if self.local_is_external_target(func, locals, a.base, depth + 1 as usize) {
                        return true;
                    }
                }
                return false;
            },
            ZirRvalue.Call(fn_id, args) => {
                let is_ref = self.local_is_ref_or_ptr(local_id, locals);
                let is_opt_ref = !is_ref && self.local_holds_reference(local_id, locals);
                if is_ref || is_opt_ref {
                    if is_opt_ref {
                        let mut li = 0 as usize;
                        let mut is_enum = false;
                        while li < locals.len {
                            if locals[li].id == local_id {
                                let ty = locals[li].ty;
                                if ty != 0 as u32 && (ty as usize) <= self.zil_module.types.len() {
                                    let tag = self.zil_module.types[ty as usize
                                        - 1 as usize].def.get_tag();
                                    if tag == ILTYPE_USER {
                                        let uid = self.zil_module.types[ty as usize
                                            - 1 as usize].def.get_User().id;
                                        if uid != 0 as u32
                                            && (uid as usize) < self.zil_module.typedefs.len() {
                                            if let ILTypeDef.Enum(_) = self.zil_module.typedefs[uid as usize] {
                                                is_enum = true;
                                            }
                                        }
                                    }
                                }
                                break;
                            }
                            li = li + 1 as usize;
                        }
                        if !is_enum { return false; }
                    }
                    let mut ties = 0xffffffffffffffff as u64;
                    if (fn_id as usize) < self.zil_module.functions.len() {
                        ties = self.zil_module.functions[fn_id as usize].ret_ties;
                    }
                    let mut i = 0 as usize;
                    while i < args.len {
                        if i >= 64 as usize || ((ties >> (i as u64)) & 1 as u64) != 0 as u64 {
                            if self.local_is_external_target(
                                func,
                                locals,
                                args[i].base,
                                depth + 1 as usize
                            ) {
                                return true;
                            }
                        }
                        i = i + 1 as usize;
                    }
                }
                return false;
            },
            ZirRvalue.CallPtr(_, args) => {
                if self.local_is_ref_or_ptr(local_id, locals) {
                    for a in args {
                        if self.local_is_external_target(func, locals, a.base, depth + 1 as usize) {
                            return true;
                        }
                    }
                }
                return false;
            },
            ZirRvalue.GlobalAddr(_) => {
                return true;
            },
            _ => { return false; },
        }
    }

    fn local_is_external_target(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        local_id: u32,
        depth: usize
    ) -> bool {
        if depth > 8 as usize { return false; }
        if local_id == 0 as u32 || (local_id as usize) > locals.len { return false; }
        for p in func.params {
            if p.id == local_id { return true; }
        }
        if locals[local_id as usize - 1 as usize].is_capture_alias {
            return true;
        }
        let mut bi = 0 as usize;
        while bi < func.blocks.len {
            let b = &func.blocks[bi];
            let mut si = 0 as usize;
            while si < b.statements.len {
                match b.statements[si] {
                    ZirStmt.Let(id, rv, _) => {
                        if id == local_id {
                            if self.rvalue_is_external_target(func, locals, id, &rv, depth) {
                                return true;
                            }
                        }
                    },
                    ZirStmt.Assign(pl, rv, _) => {
                        if pl.base == local_id && pl.projections.len == 0 as usize {
                            if self.rvalue_is_external_target(func, locals, pl.base, &rv, depth) {
                                return true;
                            }
                        }
                    },
                    _ => {},
                }
                si = si + 1 as usize;
            }
            bi = bi + 1 as usize;
        }
        return false;
    }

    fn place_carries_borrow(self: &mut ZirVerifier, p: &Place, locals: [Local]) -> bool {
        let ty = self.get_place_type(p, locals);
        if ty == 0 as u32 { return true; }
        return self.type_holds_reference(ty) || self.type_owns_storage(ty, 0 as usize);
    }

    fn place_outlives_frame(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        place: &Place
    ) -> bool {
        if place.projections.len == 0 as usize { return false; }
        return self.local_is_external_target(func, locals, place.base, 0 as usize);
    }

    fn check_rvalue_escapes_frame(
        self: &mut ZirVerifier,
        action: [u8],
        rv: &ZirRvalue,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) -> bool {
        match *rv {
            ZirRvalue.Use(p) => {
                if !self.place_carries_borrow(&p, locals) { return false; }
                return self.check_borrow_escapes_frame(action, p.base, span, state, locals, func);
            },
            ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => {
                if self.check_borrow_escapes_frame(action, p.base, span, state, locals, func) {
                    return true;
                }
                if p.base != 0 as u32
                    && self.borrowed_storage_is_local(&p, locals)
                    && self.local_type_owns_storage(p.base, locals)
                    && !self.local_storage_external(func, locals, p.base, 0 as usize) {
                    self.report_borrow_conflict(
                        action,
                        &p,
                        "a reference into storage owned by this frame (a collection, a box or an arena) cannot outlive the frame",
                        span,
                        &p,
                        span,
                        0 as u64,
                        locals
                    );
                    return true;
                }
                return false;
            },
            ZirRvalue.Tuple(elems) => {
                for e in elems {
                    if self.check_borrow_escapes_frame(action, e.base, span, state, locals, func) {
                        return true;
                    }
                }
                return false;
            },
            ZirRvalue.StructLiteral(_, args) | ZirRvalue.Array(_, args) => {
                for a in args {
                    if self.check_borrow_escapes_frame(action, a.base, span, state, locals, func) {
                        return true;
                    }
                }
                return false;
            },
            ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.Boxed(p)
                | ZirRvalue.Cast(p, _)
                | ZirRvalue.ArrayRepeat(p, _, _) => {
                return self.check_borrow_escapes_frame(action, p.base, span, state, locals, func);
            },
            _ => { return false; },
        }
    }

    fn check_call_stores_escapes(
        self: &mut ZirVerifier,
        fn_id: u32,
        args: [Place],
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        if fn_id as usize >= self.zil_module.functions.len() { return; }
        let p_func = self.zil_module.functions[fn_id as usize];

        if p_func.has_stores_declared {
            let decl_from = p_func.stores_declared_from;
            let decl_to = p_func.stores_declared_to;
            let targets = decl_to;
            let to_global = (decl_to & (0x8000000000000000 as u64)) != 0 as u64;
            let mut i = 0 as usize;
            while i < args.len {
                if i < 64 as usize && ((decl_from >> (i as u64)) & 1 as u64) != 0 as u64 {
                    let mut escapes = to_global;
                    if !escapes {
                        let mut j = 0 as usize;
                        while j < args.len {
                            if j != i
                                && j < 64 as usize
                                && ((decl_to >> (j as u64)) & 1 as u64) != 0 as u64 {
                                if self.local_is_external_target(
                                    func,
                                    locals,
                                    args[j].base,
                                    0 as usize
                                ) {
                                    escapes = true;
                                    break;
                                }
                            }
                            j = j + 1 as usize;
                        }
                    }
                    if escapes && self.place_carries_borrow(&args[i], locals) {
                        if self.check_borrow_escapes_frame(
                            "cannot store",
                            args[i].base,
                            span,
                            state,
                            locals,
                            func
                        ) {
                            return;
                        }
                    }
                }
                i = i + 1 as usize;
            }
        }

        if p_func.stores_storage != 0 as u64 {
            let stored = p_func.stores_storage;
            let targets = p_func.store_targets;
            let to_global = (targets & (0x8000000000000000 as u64)) != 0 as u64;
            let mut i = 0 as usize;
            while i < args.len {
                if i < 64 as usize && ((stored >> (i as u64)) & 1 as u64) != 0 as u64 {
                    let mut escapes = to_global;
                    if !escapes {
                        let mut j = 0 as usize;
                        while j < args.len {
                            if j != i
                                && j < 64 as usize
                                && ((targets >> (j as u64)) & 1 as u64) != 0 as u64 {
                                if self.local_is_external_target(
                                    func,
                                    locals,
                                    args[j].base,
                                    0 as usize
                                ) {
                                    escapes = true;
                                    break;
                                }
                            }
                            j = j + 1 as usize;
                        }
                    }
                    if escapes && self.place_carries_borrow(&args[i], locals) {
                        if self.check_borrow_escapes_frame(
                            "cannot store",
                            args[i].base,
                            span,
                            state,
                            locals,
                            func
                        ) {
                            return;
                        }
                    }
                }
                i = i + 1 as usize;
            }
        }
    }

    // exhaustive: every terminator must state its operand, ownership and linearity effect.
    fn check_terminator(
        self: &mut ZirVerifier,
        term: &ZirTerminator,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        let span = func.span;
        self.cur_rv = 0 as u64;
        self.cur_stmt = 0 as u64;
        self.cur_term = term_bit(term);
        match *term {
            ZirTerminator.Ret(ret_pl) => {
                if ret_pl.base == 0 as u32 {
                    if func.ret_ty != 0 as u32 && !self.is_unit_type(func.ret_ty) {
                        self.report_error(
                            "control reaches end of non-void function without a return value",
                            span
                        );
                    }
                }
                // A return ends every scope, and this path has never run the block-end rule
                // (`emit_scope_cleanup` skips the marker: the region verifier was trusted to see
                // an escape). It does not see a buffer reached through a local - `v.get(i)` /
                // `v.as_slice()` hand back `self.data`, which is not derived from `self` - so a
                // reference into a buffer owned by this frame (a collection, a box or an arena)
                // would leave with the frame and read invalid memory. Default-deny: any borrow the
                // returned value holds whose root is a local owning storage is rejected unless the
                // local's provenance proves that storage outlives the frame (a parameter, a `*_raw`
                // constructor, or a constructor anchored to a parameter's arena). Before
                // `check_place_use`: that marks the returned value moved, and a moved borrower no
                // longer counts.
                if self.place_carries_borrow(&ret_pl, locals) {
                    self.check_borrow_escapes_frame(
                        "cannot return",
                        ret_pl.base,
                        span,
                        state,
                        locals,
                        func
                    );
                }
                self.check_place_use(&ret_pl, true, span, state, locals);
                // A linear resource consumed on some paths into this return but not others is
                // leaked on those others (`if c { close(f); } return 0;`). Lowering emits no
                // scope-exit drop for a value moved in a branch, so this is checked here.
                for l in locals {
                    let id = l.id;
                    if id != 0 as u32
                        && id != ret_pl.base
                        && (id as usize) < state.ownership.len
                        && state.ownership[id as usize] == OWN_MOVED
                        && state.maybe_live[id as usize]
                        && self.type_holds_linear(l.ty) {
                        self.report_var_error(
                            "linear resource",
                            id,
                            "is not closed on every path",
                            span,
                            locals
                        );
                    }
                }
            },
            ZirTerminator.Branch(cond, _, _) => {
                self.check_place_use(&cond, false, span, state, locals);
            },
            ZirTerminator.Jmp(_) | ZirTerminator.Unreachable => {},
        }
    }

    fn merge_states(
        self: &mut ZirVerifier,
        target: usize,
        predecessors: Vec<u32>,
        exit_states: &[*mut ZirAnalysisState],
        locals_len: usize
    ) -> *mut ZirAnalysisState {
        if predecessors.len() == 0 as usize { return 0 as *mut ZirAnalysisState; }

        // Seed the merge from the first predecessor that has a computed exit.
        // Predecessors whose exit is still null (orphan or not yet processed) are
        // skipped: giving up on a null first predecessor would never analyze a
        // reachable block whose first predecessor comes later.
        let mut seed: *mut ZirAnalysisState = 0 as *mut ZirAnalysisState;
        let mut si = 0 as usize;
        while si < predecessors.len() {
            let idx = &predecessors[si];
            let ex = exit_states[(*idx) as usize];
            if ex as usize != 0 as usize { seed = ex; break; }
            si = si + 1 as usize;
        }
        if seed as usize == 0 as usize { return 0 as *mut ZirAnalysisState; }

        let seed_ref: &ZirAnalysisState = unsafe { &*seed };
        let res = seed_ref.clone(self.arena, locals_len);
        let res_ref: &mut ZirAnalysisState = unsafe { &mut *res };
        let mut i = 0 as usize;
        while i < predecessors.len() {
            let pred_idx = &predecessors[i];
            let pred_exit = exit_states[(*pred_idx) as usize];
            if pred_exit as usize != 0 as usize {
                let pred_exit_ref: &ZirAnalysisState = unsafe { &*pred_exit };
                // Ownership merge
                let mut j = 0 as usize;
                while j <= locals_len {
                    let st1 = res_ref.ownership[j];
                    let st2 = pred_exit_ref.ownership[j];
                    let ml = res_ref.maybe_live[j] || pred_exit_ref.maybe_live[j];
                    if st1 != st2 {
                        if st1 == OWN_UNINIT || st2 == OWN_UNINIT {
                            res_ref.ownership[j] = OWN_UNINIT;
                            res_ref.maybe_live[j] = false;
                        } else {
                            res_ref.ownership[j] = OWN_MOVED;  // Moved/Dropped confusion -> Moved
                            res_ref.maybe_live[j] = ml || st1 == OWN_OWNED || st2 == OWN_OWNED;
                        }
                    } else {
                        res_ref.maybe_live[j] = ml;
                    }

                    j = j + 1 as usize;
                }

                // Borrows merge: union, keyed by (borrower, base). A borrow live on only one
                // incoming path is live here too (may-analysis): intersecting the paths let a
                // branch-conditional borrow disappear at the join, and the arena it borrowed
                // was then reset while the value still held the reference (probe 203). Where
                // both paths have the same borrow, the merged answer is the conservative one:
                // mutable if either is, derived only if both are, direct if either is, and the
                // later epoch (so a post-mark borrow cannot be exempted as pre-mark).
                let mut l = 0 as usize;
                while l < pred_exit_ref.borrows.len() {
                    let b2 = pred_exit_ref.borrows[l];
                    let mut found = false;
                    let mut k = 0 as usize;
                    while k < res_ref.borrows.len() {
                        if res_ref.borrows[k].borrower == b2.borrower
                            && self.places_equal(&res_ref.borrows[k].base, &b2.base) {
                            found = true;
                            let mut merged = res_ref.borrows[k];
                            merged.is_mut = merged.is_mut || b2.is_mut;
                            merged.derived = merged.derived && b2.derived;
                            merged.direct = merged.direct || b2.direct;
                            merged.via = merged.via | b2.via;
                            if b2.epoch > merged.epoch { merged.epoch = b2.epoch; }
                            res_ref.borrows[k] = merged;
                            break;
                        }
                        k = k + 1 as usize;
                    }
                    if !found {
                        res_ref.borrows.push(ActiveBorrow {
                            base: b2.base,
                            is_mut: b2.is_mut,
                            region: b2.region,
                            borrower: b2.borrower,
                            span: b2.span,
                            derived: b2.derived,
                            direct: b2.direct,
                            epoch: b2.epoch,
                            via: b2.via,
                        });
                    }
                    l = l + 1 as usize;
                }

                // Every borrow in the merged state has crossed this block's join (two or more
                // predecessors), and a predecessor at or after the target block is a back-edge.
                // Those are routes a rejection can travel through, so record them on the borrow.
                let mut flags = 0 as u64;
                if predecessors.len() >= 2 as usize { flags = flags | route_bit(ROUTE_JOIN); }
                let mut pi = 0 as usize;
                while pi < predecessors.len() {
                    if (predecessors[pi] as usize) >= target {
                        flags = flags | route_bit(ROUTE_BACKEDGE);
                        break;
                    }
                    pi = pi + 1 as usize;
                }
                if flags != 0 as u64 {
                    let mut bj = 0 as usize;
                    while bj < res_ref.borrows.len() {
                        let mut b = res_ref.borrows[bj];
                        b.via = b.via | flags;
                        res_ref.borrows[bj] = b;
                        bj = bj + 1 as usize;
                    }
                }

                // EnumPayload aliases merge: Union
                let mut m = 0 as usize;
                while m < pred_exit_ref.enum_aliases.len() {
                    let ea = &pred_exit_ref.enum_aliases[m];
                    let mut found = false;
                    let mut n = 0 as usize;
                    while n < res_ref.enum_aliases.len() {
                        if res_ref.enum_aliases[n].local_id == ea.local_id {
                            found = true;
                            break;
                        }
                        n = n + 1 as usize;
                    }
                    if !found {
                        res_ref.enum_aliases.push(EnumPayloadAlias {
                            local_id: ea.local_id,
                            source: ea.source
                        });
                    }
                    m = m + 1 as usize;
                }

                // MarkInfos merge: Intersection taking minimum epoch when arena_base matches
                let mut mi_idx = 0 as usize;
                while mi_idx < res_ref.mark_infos.len() {
                    let r_info = &res_ref.mark_infos[mi_idx];
                    let mut matched = false;
                    let mut min_epoch = r_info.epoch;
                    let mut n = 0 as usize;
                    while n < pred_exit_ref.mark_infos.len() {
                        let p_info = &pred_exit_ref.mark_infos[n];
                        if p_info.mark_local == r_info.mark_local {
                            if p_info.arena_base == r_info.arena_base {
                                matched = true;
                                if p_info.epoch < min_epoch {
                                    min_epoch = p_info.epoch;
                                }
                            }
                            break;
                        }
                        n = n + 1 as usize;
                    }
                    if matched {
                        res_ref.mark_infos[mi_idx].epoch = min_epoch;
                        mi_idx = mi_idx + 1 as usize;
                    } else {
                        res_ref.mark_infos.remove(mi_idx);
                    }
                }
            }
            i = i + 1 as usize;
        }
        return res;
    }

    fn states_equal(
        self: &ZirVerifier,
        s1: *mut ZirAnalysisState,
        s2: *mut ZirAnalysisState,
        locals_len: usize
    ) -> bool {
        if s1 == s2 { return true; }
        if s1 as usize == 0 as usize || s2 as usize == 0 as usize { return false; }

        // Both are non-null per the check above; the block states are a nullable
        // raw array, so this is where the two become references.
        let a: &ZirAnalysisState = unsafe { &*s1 };
        let b: &ZirAnalysisState = unsafe { &*s2 };

        if !unsafe { is_mem_eq(a.ownership.ptr, b.ownership.ptr, (locals_len + 1) as u64) } {
            return false;
        }
        if !unsafe {
            is_mem_eq(a.maybe_live.ptr as *u8, b.maybe_live.ptr as *u8, (locals_len + 1) as u64)
        } {
            return false;
        }

        if a.borrows.len() != b.borrows.len() { return false; }
        let mut i = 0 as usize;
        while i < a.borrows.len() {
            // Every field that can change a later decision: stopping at `borrower` (as this did)
            // ended a loop's fixed point one pass early, so a loop-carried borrow's epoch or
            // mutability never reached the header (probe 204).
            let b1 = &a.borrows[i];
            let b2 = &b.borrows[i];
            if b1.borrower != b2.borrower
                || !self.places_equal(&b1.base, &b2.base)
                || b1.is_mut != b2.is_mut
                || b1.derived != b2.derived
                || b1.direct != b2.direct
                || b1.epoch != b2.epoch {
                return false;
            }
            i = i + 1 as usize;
        }
        if a.enum_aliases.len() != b.enum_aliases.len() { return false; }
        let mut ei = 0 as usize;
        while ei < a.enum_aliases.len() {
            if a.enum_aliases[ei].local_id != b.enum_aliases[ei].local_id
                || !self.places_equal(&a.enum_aliases[ei].source, &b.enum_aliases[ei].source) {
                return false;
            }
            ei = ei + 1 as usize;
        }
        if a.mark_infos.len() != b.mark_infos.len() { return false; }
        let mut mi = 0 as usize;
        while mi < a.mark_infos.len() {
            let m1 = &a.mark_infos[mi];
            let m2 = &b.mark_infos[mi];
            if m1.mark_local != m2.mark_local
                || m1.arena_base != m2.arena_base
                || m1.epoch != m2.epoch {
                return false;
            }
            mi = mi + 1 as usize;
        }
        return true;
    }

    fn get_type_decl(self: &ZirVerifier, ty_id: u32) -> &ILTypeDecl {
        if ty_id == 0 as u32 {
            ICE("ZirVerifier.get_type_decl: ty_id is 0");
        }
        if ty_id as usize > self.zil_module.types.len() {
            ICE("ZirVerifier.get_type_decl: ty_id out of bounds");
        }
        return &self.zil_module.types[ty_id as usize - 1 as usize];
    }

    // A copy of the declaration, for a caller that keeps it across its own `&mut self` calls: the
    // borrowed result of `get_type_decl` would keep the verifier borrowed throughout.
    #[borrows()]
    fn type_decl_copy(self: &mut ZirVerifier, ty_id: u32) -> ILTypeDecl {
        return *self.get_type_decl(ty_id);
    }

    // Mirrors ZirLowerer.get_zil_sret_offset (lower_zir/utils.zrl) -- duplicated rather than
    // shared because the two run over different module handles (ZilModule vs ILModule) despite
    // the same struct shapes. sret is detected by param name, not by inspecting ret_ty: the
    // builder stage is what decides whether to insert the slot and names it "__sret" when it
    // does, so that name is the only authoritative signal here.
    fn call_get_sret_offset(self: &ZirVerifier, p_func: &ILFunction) -> usize {
        if p_func.params_len == 0 as usize { return 0 as usize; }
        let sret_name = self.intern_table.intern("__sret");
        let p_param0 = p_func.param(0);
        if p_param0.name == sret_name { return 1 as usize; }
        return 0 as usize;
    }

    // Index into `p_func.params` where the ZIR call's user-visible `args[0]` lands -- i.e. past
    // the compiler-inserted sret slot. Mirrors the `direct_param_base` /
    // `param_base_idx` computation in lower_zir/expr.zrl's call-lowering, which is what actually
    // built the alignment between ZIR args and IL params being relied on here.
    fn call_param_base(self: &ZirVerifier, p_func: &ILFunction) -> usize {
        // A closure's environment parameter comes last, after the source parameters.
        return self.call_get_sret_offset(p_func);
    }

    // Rejects passing a place declared as a non-mut pointer/reference (`&T` / `*T`, IL tags Ptr
    // or Boxed) where the callee's parameter is PtrMut/BoxedMut while that place's base local
    // holds an active *shared* borrow. It is the call-argument counterpart of the assignment and
    // borrow-creation checks: `&T` must not become a `&mut T` receiver just because it is passed
    // positionally. What is checked is the argument's own resolved type (`get_place_type`), not
    // something one deref below it, because `h.r` where `h.r: &P` hands over the reference value
    // itself. A raw pointer from `as *T` or arithmetic stays the documented escape hatch.
    fn check_call_arg_mutability(
        self: &mut ZirVerifier,
        fn_id: u32,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if fn_id as usize >= self.zil_module.functions.len() { return; }
        let p_func = self.zil_module.functions[fn_id as usize];
        let param_base = self.call_param_base(p_func);

        let mut i = 0 as usize;
        while i < args.len {
            let param_idx = param_base + i;
            if param_idx >= p_func.params_len {
                i = i + 1 as usize;
                continue;
            }
            let param_ty = p_func.param(param_idx).ty;
            if param_ty != 0 as u32 {
                let p_param_ty = self.get_type_decl(param_ty);
                let param_tag = p_param_ty.def.get_tag();
                if is_mut_pointer_tag(param_tag) || param_tag == ILTYPE_BOXEDMUT {
                    let arg_place = &args[i];
                    self.advance_container_mutation_epoch(arg_place.base, state);
                    let arg_ty = self.get_place_type(arg_place, locals);
                    if arg_ty != 0 as u32 {
                        let p_arg_ty = self.get_type_decl(arg_ty);
                        if is_shared_pointer_tag(p_arg_ty.def.get_tag()) {
                            self.report_var_error(
                                "cannot pass",
                                arg_place.base,
                                "as a mutable reference because it is behind a shared reference",
                                span,
                                locals
                            );
                        }
                    }
                }
            }
            i = i + 1 as usize;
        }
    }

    // The argument rules of a direct call (`check_call_arg_mutability`), for a call through a
    // function value: its parameter types are in the `fn` type the value carries. A `&mut`
    // argument is a container mutation like any other, so it advances the mutation epoch (a
    // mark taken before the call must not exempt a borrow after it, probe 207), and a shared
    // reference passed where `&mut` is expected is rejected.
    fn check_call_ptr_arg_mutability(
        self: &mut ZirVerifier,
        f: &Place,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        let fn_ty = self.get_place_type(f, locals);
        if fn_ty == 0 as u32 { return; }
        let mut actual_fn_ty = 0 as u32;
        let tag = self.get_type_decl(fn_ty).def.get_tag();
        if tag == ILTYPE_FN {
            actual_fn_ty = fn_ty;
        } else if is_any_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(fn_ty);
            if inner != 0 as u32 && self.get_type_decl(inner).def.get_tag() == ILTYPE_FN {
                actual_fn_ty = inner;
            }
        }
        if actual_fn_ty == 0 as u32 { return; }
        // Copy the parameter types out: the slice borrows the module, and the checks below take
        // `&mut self`, which the checker cannot split from a field borrow.
        let mut param_tys = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        for pty in self.get_type_decl(actual_fn_ty).def.get_Fn().params {
            param_tys.push(*pty);
        }
        let mut i = 0 as usize;
        while i < args.len && i < param_tys.len() {
            let param_ty = param_tys[i];
            if param_ty != 0 as u32 {
                let param_tag = self.get_type_decl(param_ty).def.get_tag();
                if is_mut_pointer_tag(param_tag) || param_tag == ILTYPE_BOXEDMUT {
                    self.advance_container_mutation_epoch(args[i].base, state);
                    let arg_ty = self.get_place_type(&args[i], locals);
                    if arg_ty != 0 as u32 {
                        let arg_tag = self.get_type_decl(arg_ty).def.get_tag();
                        if is_shared_pointer_tag(arg_tag) {
                            self.report_var_error(
                                "cannot pass",
                                args[i].base,
                                "as a mutable reference because it is behind a shared reference",
                                span,
                                locals
                            );
                        }
                    }
                }
            }
            i = i + 1 as usize;
        }
    }

    fn get_usize_type(self: &ZirVerifier) -> u32 {
        return self.get_primitive_type(ILPRIM_USIZE);
    }

    fn is_unit_type(self: &ZirVerifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return true; }
        if ty_id as usize > self.zil_module.types.len() { return false; }
        let p_t = &self.zil_module.types[ty_id as usize - 1 as usize];
        if p_t.def.get_tag() == ILTYPE_PRIMITIVE {
            return p_t.def.get_Primitive().get_tag() == ILPRIM_UNIT;
        }
        if p_t.def.get_tag() == ILTYPE_TUPLE {
            return p_t.def.get_Tuple().len == 0 as usize;
        }
        return false;
    }

    fn get_primitive_type(self: &ZirVerifier, prim_tag: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len() {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_PRIMITIVE {
                if p_t.def.get_Primitive().get_tag() == prim_tag {
                    return p_t.id;
                }
            }
            i = i + 1 as usize;
        }
        return 0 as u32;
    }

    fn get_ptr_type(self: &mut ZirVerifier, inner: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len() {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_PTR { // a reference type is built here (Phase D step 2 adds the raw twin)
                if p_t.def.get_Ptr() == inner { return p_t.id; }
            }
            i = i + 1 as usize;
        }
        return self.zil_module.alloc_type(ILTypeDecl {
            id: 0,
            name: 0,
            def: ILType.Ptr(inner),
            source_file: 0 as u32
        });
    }

    fn get_raw_ptr_type(self: &mut ZirVerifier, inner: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len() {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_RAWPTR {
                if p_t.def.get_Ptr() == inner { return p_t.id; }
            }
            i = i + 1 as usize;
        }
        return self.zil_module.alloc_type(ILTypeDecl {
            id: 0, name: 0, def: ILType.RawPtr(inner), source_file: 0 as u32
        });
    }

    fn get_raw_ptr_mut_type(self: &mut ZirVerifier, inner: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len() {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_RAWPTRMUT {
                if p_t.def.get_PtrMut() == inner { return p_t.id; }
            }
            i = i + 1 as usize;
        }
        return self.zil_module.alloc_type(ILTypeDecl {
            id: 0, name: 0, def: ILType.RawPtrMut(inner), source_file: 0 as u32
        });
    }

    // Whether source argument I of function FN_ID is a slice, or a reference to one.
    fn callee_param_is_slice(self: &ZirVerifier, fn_id: u32, i: usize) -> bool {
        if (fn_id as usize) >= self.zil_module.functions.len() { return false; }
        let p_f = &self.zil_module.functions[fn_id as usize];
        let pi = i + self.call_param_base(p_f);
        if pi >= p_f.params_len { return false; }
        let mut ty = p_f.param(pi).ty;
        if ty == 0 as u32 || ty as usize > self.zil_module.types.len() { return false; }
        if is_any_pointer_tag(self.zil_module.types[ty as usize - 1 as usize].def.get_tag()) {
            ty = self.get_ptr_inner_type(ty);
            if ty == 0 as u32 || ty as usize > self.zil_module.types.len() { return false; }
        }
        return self.zil_module.types[ty as usize - 1 as usize].def.get_tag() == ILTYPE_SLICE;
    }

    fn get_ptr_inner_type(self: &ZirVerifier, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = &self.zil_module.types[ty_id as usize - 1 as usize];
        match p_ty.def {
            ILType.Ptr(inner)
                | ILType.PtrMut(inner)
                | ILType.RawPtr(inner)
                | ILType.RawPtrMut(inner)
                | ILType.Boxed(inner)
                | ILType.BoxedMut(inner) => { return inner; },
            ILType.Slice(s) => { return s.element; },
            _ => { return 0 as u32; },
        }
    }

    fn get_field_index(self: &mut ZirVerifier, ty_id: u32, field_name: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }

        let mut curr_ty = ty_id;
        let mut p_ty = self.get_type_decl(curr_ty);
        let mut tag = p_ty.def.get_tag();

        while is_any_pointer_tag(tag) || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            curr_ty = self.get_ptr_inner_type(curr_ty);
            if curr_ty == 0 as u32 { break; }
            p_ty = self.get_type_decl(curr_ty);
            tag = p_ty.def.get_tag();
        }

        if tag == ILTYPE_SLICE {
            let ptr_id = self.intern_table.intern("ptr");
            let data_id = self.intern_table.intern("data");
            let len_id = self.intern_table.intern("len");
            if field_name == ptr_id || field_name == data_id { return 0 as u32; }
            if field_name == len_id { return 1 as u32; }
            return 0 as u32;
        }

        let mut user_id = 0xffffffff as u32;
        if tag == ILTYPE_USER {
            user_id = p_ty.def.get_User().id;
        }

        if user_id != 0xffffffff as u32 {
            let p_def = &self.zil_module.typedefs[user_id as usize];
            if p_def.get_tag() == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                let mut fi = 0 as usize;
                while fi < s.fields.len {
                    if s.fields[fi].name == field_name {
                        return fi as u32;
                    }
                    fi = fi + 1 as usize;
                }
            }
        }
        return 0 as u32;
    }

    fn get_field_type(self: &mut ZirVerifier, ty_id: u32, field_idx: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }

        let mut curr_ty = ty_id;
        let mut p_ty = self.get_type_decl(curr_ty);
        let mut tag = p_ty.def.get_tag();

        while is_any_pointer_tag(tag) || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            curr_ty = self.get_ptr_inner_type(curr_ty);
            if curr_ty == 0 as u32 { break; }
            p_ty = self.get_type_decl(curr_ty);
            tag = p_ty.def.get_tag();
        }

        if tag == ILTYPE_SLICE {
            if field_idx == 0 as u32 {
                let elem_ty = p_ty.def.get_Slice().element;
                if p_ty.def.get_Slice().mutable { return self.get_raw_ptr_mut_type(elem_ty); }
                return self.get_raw_ptr_type(elem_ty);
            }
            if field_idx == 1 as u32 { return self.get_usize_type(); }
            return 0 as u32;
        }

        let mut user_id = 0xffffffff as u32;
        if tag == ILTYPE_USER {
            user_id = p_ty.def.get_User().id;
        }

        if user_id != 0xffffffff as u32 {
            let p_def = &self.zil_module.typedefs[user_id as usize];
            if p_def.get_tag() == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                if (field_idx as usize) < s.fields.len {
                    return s.fields[field_idx as usize].ty;
                }
            }
        }
        return 0 as u32;
    }

    // Whether a value of TY_ID can hold a reference (and so a borrow): the walk lives on the IL
    // module (`ILModule.type_holds_reference`, src/il_cfg.zrl), shared with the driver's signature
    // ties and its `static mut` rule - one walk replacing three near-copies that had drifted apart.
    fn type_holds_reference(self: &mut ZirVerifier, ty_id: u32) -> bool {
        return self.zil_module.type_holds_reference(ty_id, 0 as usize);
    }

    fn is_linear_tag(self: &ZirVerifier, ty_id: u32) -> bool {
        let tag = self.get_type_decl(ty_id).def.get_tag();
        return tag == ILTYPE_FD || tag == ILTYPE_IORING;
    }

    // Is this a linear resource, or an aggregate that holds one by value?
    //
    // The walk follows tuple elements, array elements, struct fields, enum payloads and boxes. A
    // depth limit used to double as the cycle breaker and answered `false` past eight levels - the
    // fail-open side - so an `fd` nested deeper was dropped without complaint and leaked (an
    // `fd<w>` nine struct levels down was accepted where eight was rejected). The cycle breaker is
    // the set of types already entered, so the answer is exact at any depth, and a recursive type
    // that holds none is not read as holding one (a conservative answer at the limit rejected
    // every linked list in `corpus/`).
    fn type_holds_linear(self: &mut ZirVerifier, ty_id: u32) -> bool {
        let mut seen = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        return self.type_holds_linear_walk(ty_id, 0 as usize, &mut seen);
    }

    // The walk itself. `depth` is vestigial - the recursion terminates on `seen`, not on a limit -
    // and stays as the mutation harness's anchor, where the old `|| depth > 8` answer goes back.
    fn type_holds_linear_walk(
        self: &mut ZirVerifier,
        ty_id: u32,
        depth: usize,
        seen: &mut Vec<u32>
    ) -> bool {
        // Named, like every guard the mutation harness targets: this line alone is where the old
        // `|| depth > 8` answer goes back.
        let absent_type = ty_id == 0 as u32;
        if absent_type { return false; }
        if self.linear_walk_entered(seen, ty_id) { return false; }
        seen.push(ty_id);
        let p_ty = self.type_decl_copy(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_FD || tag == ILTYPE_IORING { return true; }
        if tag == ILTYPE_TUPLE {
            let elems = p_ty.def.get_Tuple();
            let mut i = 0 as usize;
            while i < elems.len {
                if self.type_holds_linear_walk(elems[i], depth + 1 as usize, seen) { return true; }
                i = i + 1 as usize;
            }
            return false;
        }
        if tag == ILTYPE_ARRAY {
            return self.type_holds_linear_walk(
                p_ty.def.get_Array().element,
                depth + 1 as usize,
                seen
            );
        }
        if tag == ILTYPE_BOXED {
            return self.type_holds_linear_walk(p_ty.def.get_Boxed(), depth + 1 as usize, seen);
        }
        if tag == ILTYPE_BOXEDMUT {
            return self.type_holds_linear_walk(p_ty.def.get_BoxedMut(), depth + 1 as usize, seen);
        }
        if tag != ILTYPE_USER { return false; }
        let user_id = p_ty.def.get_User().id;
        if user_id == 0xffffffff as u32 || user_id as usize >= self.zil_module.typedefs.len() {
            return false;
        }
        let p_def = self.zil_module.typedefs[user_id as usize];
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            let fields = p_def.get_Struct().fields;
            let mut i = 0 as usize;
            while i < fields.len {
                if self.type_holds_linear_walk(fields[i].ty, depth + 1 as usize, seen) {
                    return true;
                }
                i = i + 1 as usize;
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            let variants = p_def.get_Enum().variants;
            let mut i = 0 as usize;
            while i < variants.len {
                if self.type_holds_linear_walk(variants[i].payload, depth + 1 as usize, seen) {
                    return true;
                }
                i = i + 1 as usize;
            }
        }
        return false;
    }

    // Whether TY_ID is already on this walk: what makes a recursive type terminate, since the fields
    // that would be examined on re-entry are the ones being examined right now.
    fn linear_walk_entered(self: &mut ZirVerifier, seen: &mut Vec<u32>, ty_id: u32) -> bool {
        for v in seen.as_slice() {
            if *v == ty_id { return true; }
        }
        return false;
    }

    fn get_tuple_elem_type(self: &mut ZirVerifier, ty_id: u32, idx: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = self.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        let mut base_ty = p_ty;
        if is_any_pointer_tag(tag) {
            let inner_ty = p_ty.def.get_Ptr();
            if inner_ty != 0 as u32 {
                base_ty = self.get_type_decl(inner_ty);
            }
        }

        let base_tag = base_ty.def.get_tag();
        if base_tag == ILTYPE_TUPLE {
            let elements = base_ty.def.get_Tuple();
            if (idx as usize) < elements.len {
                return elements[idx as usize];
            }
        }
        return 0 as u32;
    }

    fn is_vec_type(self: &mut ZirVerifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_USER {
            let user = p_ty.def.get_User();
            let name = self.intern_table.lookup(user.name);
            let is_vec = (name.len == 3 as usize
                && name[0] == 'V' as u8
                && name[1] == 'e' as u8
                && name[2] == 'c' as u8)
                || (name.len > 3 as usize
                    && name[0] == 'V' as u8
                    && name[1] == 'e' as u8
                    && name[2] == 'c' as u8
                    && name[3] == '_' as u8);
            return is_vec && user.type_args.len > 0 as usize;
        }
        return false;
    }

    fn get_slice_element_type(self: &mut ZirVerifier, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = self.type_decl_copy(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_SLICE {
            return p_ty.def.get_Slice().element;
        } else if tag == ILTYPE_ARRAY {
            return p_ty.def.get_Array().element;
        } else if self.is_vec_type(ty_id) {
            return p_ty.def.get_User().type_args[0];
        } else if is_shared_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(ty_id);
            if inner != 0 as u32 {
                let p_inner = self.get_type_decl(inner);
                let inner_tag = p_inner.def.get_tag();
                if inner_tag == ILTYPE_SLICE
                    || inner_tag == ILTYPE_ARRAY
                    || self.is_vec_type(inner) {
                    return self.get_slice_element_type(inner);
                }
                return inner;
            }
        } else if is_mut_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(ty_id);
            if inner != 0 as u32 {
                let p_inner = self.get_type_decl(inner);
                let inner_tag = p_inner.def.get_tag();
                if inner_tag == ILTYPE_SLICE || inner_tag == ILTYPE_ARRAY {
                    return self.get_slice_element_type(inner);
                }
                return inner;
            }
        }
        return ty_id;
    }

    fn has_drop_impl(self: &mut ZirVerifier, type_name_id: u32) -> bool {
        if type_name_id == 0 as u32 { return false; }
        let type_str = self.intern_table.lookup(type_name_id);
        let mut name_buf: &mut ByteVec = unsafe { ByteVec.new_raw(self.arena) };
        name_buf.push_slice(type_str);
        name_buf.push(':' as u8);
        name_buf.push(':' as u8);
        name_buf.push_slice("drop");
        let mangled = self.intern_table.intern(name_buf.as_slice());

        let mut fi = 0 as usize;
        while fi < self.zil_module.functions.len() {
            let p_func = &self.zil_module.functions[fi];
            if p_func.name == mangled {
                return true;
            }
            fi = fi + 1 as usize;
        }
        return false;
    }

    pub fn is_copy_type(self: &mut ZirVerifier, type_id: u32) -> bool {
        return self.is_copy_type_internal(type_id, 0 as usize);
    }

    fn is_copy_type_internal(self: &mut ZirVerifier, type_id: u32, depth: usize) -> bool {
        if type_id == 0 as u32 { return true; }
        // Past the recursion limit the answer is *unknown*, and unknown has to read as "not `Copy`":
        // that is the conservative side for this question (a use is then a move, so a value used
        // after it was moved out of is rejected), while "`Copy`" is what stops the checker tracking
        // the move (doc/SAFETY.md §4.4). The limit is a backstop for
        // `is_implicit_aggregate_ptr`, the one recursion that follows a pointer; the walk is
        // otherwise finite. The name is its own so the mutation harness can revert this answer alone.
        let past_limit_copy = depth > 10 as usize;
        if past_limit_copy { return false; }

        if self.is_implicit_aggregate_ptr(type_id) {
            let inner = self.get_ptr_inner_type(type_id);
            return self.is_copy_type_internal(inner, depth + 1 as usize);
        }

        let p_ty = self.zil_module.types[type_id as usize - 1 as usize];
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_PRIMITIVE {
            let prim_tag = p_ty.def.get_Primitive().get_tag();
            return prim_tag != ILPRIM_NEVER;
        }
        if is_any_pointer_tag(tag) && tag != ILTYPE_PTRMUT { return true; }
        if tag == ILTYPE_SLICE { return true; }
        if tag == ILTYPE_FN { return true; }

        if tag == ILTYPE_ARRAY {
            return self.is_copy_type_internal(p_ty.def.get_Array().element, depth + 1 as usize);
        }
        if tag == ILTYPE_TUPLE {
            let elements = p_ty.def.get_Tuple();
            let mut i = 0 as usize;
            while i < elements.len {
                if !self.is_copy_type_internal(elements[i], depth + 1 as usize) { return false; }
                i = i + 1 as usize;
            }
            return true;
        }
        if tag == ILTYPE_USER {
            let u = p_ty.def.get_User();
            if self.has_drop_impl(u.name) { return false; }
            let user_id = u.id;
            if user_id as usize >= self.zil_module.typedefs.len() { return true; }
            let p_def = self.zil_module.typedefs[user_id as usize];
            let d_tag = p_def.get_tag();
            if d_tag == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                if s.is_copy_opt_out { return false; }
                let mut i = 0 as usize;
                while i < s.fields.len {
                    if !self.is_copy_type_internal(s.fields[i].ty, depth + 1 as usize) {
                        return false;
                    }
                    i = i + 1 as usize;
                }
                return true;
            } else if d_tag == IL_TYPEDEF_ENUM {
                let e = p_def.get_Enum();
                if e.is_copy_opt_out { return false; }
                let mut i = 0 as usize;
                while i < e.variants.len {
                    if e.variants[i].payload != 0 as u32 {
                        if !self.is_copy_type_internal(e.variants[i].payload, depth + 1 as usize) {
                            return false;
                        }
                    }
                    i = i + 1 as usize;
                }
                return true;
            }
        }
        return false;
    }

    fn is_implicit_aggregate_ptr(self: &mut ZirVerifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = &self.zil_module.types[ty_id as usize - 1 as usize];
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_PTR { // a shared reference, not a raw pointer (see src/lower_zir/utils.zrl)
            let inner = self.get_ptr_inner_type(ty_id);
            if inner == 0 as u32 { return false; }
            let p_inner = &self.zil_module.types[inner as usize - 1 as usize];
            let inner_tag = p_inner.def.get_tag();
            if inner_tag == ILTYPE_USER || inner_tag == ILTYPE_TUPLE {
                return p_inner.name == 0 as u32;
            }
        }
        return false;
    }

    fn get_place_type(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> u32 {
        if pl.base == 0 as u32 { return 0 as u32; }

        let mut curr_ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == pl.base {
                curr_ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if curr_ty == 0 as u32 { return 0 as u32; }

        for proj in pl.projections {
            curr_ty = match *proj {
                Projection.Field(name) => self.get_field_type(
                    curr_ty,
                    self.get_field_index(curr_ty, name)
                ),
                Projection.TupleIndex(idx) => self.get_tuple_elem_type(curr_ty, idx),
                Projection.Deref => self.get_ptr_inner_type(curr_ty),
                Projection.Index(_) => self.get_slice_element_type(curr_ty),
            };
        }
        return curr_ty;
    }
}

// Which of FUNC's parameters' own storage the value it returns may point into
// (`ILFunction.ret_storage`), computed from the canonical ZIR before the borrow checker runs.
// The surface-AST walk it replaces named only a handful of expression shapes, so an alias local,
// a `match`, a struct or tuple literal or a field read read as "points into nothing" and the
// checker treated a direct borrow as a derived one (Unified Solution C).
//
// A flow over locals, each carrying the parameters whose storage it may point into. A call
// contributes what its callee's mask says about that argument; a callee whose mask is unknown (a
// cycle, an interface without storage keys) contributes every argument, the strict reading, and
// the answer is *unknown* - never silently empty - when such a callee was read.
pub struct ZirStorageFacts {
    pub mask: u64,
    pub known: bool,
    pub stored: u64,
    pub targets: u64,
}

fn storage_type_tag(module: &mut ILModule, ty: u32) -> u32 {
    if ty == 0 as u32 || ty as usize > module.types.len() { return 0 as u32; }
    return module.types[ty as usize - 1 as usize].def.get_tag();
}

fn storage_at(work: [mut u64], base: u32) -> u64 {
    if base == 0 as u32 || (base as usize) >= work.len { return 0 as u64; }
    return work[base as usize];
}

// Union WORK into block TO's entry; true when that changed it.
fn storage_join(
    entries: [mut u64],
    cmask_entries: [mut u64],
    reach_entries: [mut u64],
    to: usize,
    work: [mut u64],
    cmask: [mut u64],
    reach: [mut u64],
    nl: usize,
    nb: usize
) -> bool {
    if to >= nb { return false; }
    let mut changed = false;
    let mut i = 0 as usize;
    while i < nl {
        let old = entries[to * nl + i];
        let new = old | work[i];
        if new != old {
            entries[to * nl + i] = new;
            changed = true;
        }
        let old_c = cmask_entries[to * nl + i];
        let new_c = old_c | cmask[i];
        if new_c != old_c {
            cmask_entries[to * nl + i] = new_c;
            changed = true;
        }
        let old_r = reach_entries[to * nl + i];
        let new_r = old_r | reach[i];
        if new_r != old_r {
            reach_entries[to * nl + i] = new_r;
            changed = true;
        }
        i = i + 1 as usize;
    }
    return changed;
}

// The type of field FIELD_NAME in struct/user type TY, 0 when TY is not a struct or has no such
// field.
fn storage_field_type(module: &mut ILModule, ty: u32, field_name: u32) -> u32 {
    if ty == 0 as u32 { return 0 as u32; }
    let tag = storage_type_tag(module, ty);
    let mut base_ty = ty;
    if is_any_pointer_tag(tag) || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
        let p_def = &module.types[base_ty as usize - 1 as usize].def;
        base_ty = match *p_def {
            ILType.Ptr(inner)
                | ILType.PtrMut(inner)
                | ILType.RawPtr(inner)
                | ILType.RawPtrMut(inner)
                | ILType.Boxed(inner)
                | ILType.BoxedMut(inner) => inner,
            _ => 0 as u32,
        };
        if base_ty == 0 as u32 { return 0 as u32; }
    }
    if storage_type_tag(module, base_ty) != ILTYPE_USER { return 0 as u32; }
    let uid = module.types[base_ty as usize - 1 as usize].def.get_User().id;
    if uid == 0 as u32 || uid as usize >= module.typedefs.len() { return 0 as u32; }
    match module.typedefs[uid as usize] {
        ILTypeDef.Struct(st) => {
            for f in st.fields {
                if f.name == field_name { return f.ty; }
            }
            return 0 as u32;
        },
        _ => { return 0 as u32; },
    }
}

fn storage_place_type(module: &mut ILModule, locals: [Local], p: &Place) -> u32 {
    let mut ty = 0 as u32;
    let mut li = 0 as usize;
    while li < locals.len {
        if locals[li].id == p.base {
            ty = locals[li].ty;
            break;
        }
        li = li + 1 as usize;
    }
    let mut i = 0 as usize;
    while i < p.projections.len {
        if ty == 0 as u32 { return 0 as u32; }
        let tag = storage_type_tag(module, ty);
        match p.projections[i] {
            Projection.Field(name) => {
                ty = storage_field_type(module, ty, name);
            },
            Projection.TupleIndex(idx) => {
                if tag == ILTYPE_TUPLE {
                    let elems = module.types[ty as usize - 1 as usize].def.get_Tuple();
                    ty = if (idx as usize) < elems.len { elems[idx as usize] } else { 0 as u32 };
                } else if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else {
                    ty = 0 as u32;
                }
            },
            Projection.Index(_) => {
                if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else if tag == ILTYPE_SLICE {
                    ty = module.types[ty as usize - 1 as usize].def.get_Slice().element;
                } else {
                    ty = 0 as u32;
                }
            },
            Projection.Deref => {
                let p_def = &module.types[ty as usize - 1 as usize].def;
                ty = match *p_def {
                    ILType.Ptr(inner)
                        | ILType.PtrMut(inner)
                        | ILType.RawPtr(inner)
                        | ILType.RawPtrMut(inner)
                        | ILType.Boxed(inner)
                        | ILType.BoxedMut(inner) => inner,
                    ILType.Slice(s) => s.element,
                    _ => 0 as u32,
                };
            },
        }
        i = i + 1 as usize;
    }
    return ty;
}

// Whether reading the place P loads through a pointer, box or slice at some step: then the value
// comes from memory the base reaches, not from the base's own storage. This is the distinction
// the IL's storage_facts draws between `mask` (an address into the argument's own storage,
// `&self.v`) and `reach` (one built from a load, `self.data`, or a Vec's buffer). Reading
// `self.data` out of a `&Vec` is reachable memory, so `as_slice` does not hand back the
// argument's own storage - marking it would tie every slice to the Vec variable and reject an
// arena-backed `Vec` whose buffer outlives its handle.
fn storage_read_crosses_pointer(module: &mut ILModule, locals: [Local], p: &Place) -> bool {
    let mut ty = 0 as u32;
    let mut li = 0 as usize;
    while li < locals.len {
        if locals[li].id == p.base {
            ty = locals[li].ty;
            break;
        }
        li = li + 1 as usize;
    }
    let mut i = 0 as usize;
    while i < p.projections.len {
        let tag = storage_type_tag(module, ty);
        if is_any_pointer_tag(tag)
            || tag == ILTYPE_BOXED
            || tag == ILTYPE_BOXEDMUT
            || tag == ILTYPE_SLICE {
            return true;
        }
        match p.projections[i] {
            Projection.Field(name) => { ty = storage_field_type(module, ty, name); },
            Projection.TupleIndex(idx) => {
                if tag == ILTYPE_TUPLE {
                    let elems = module.types[ty as usize - 1 as usize].def.get_Tuple();
                    ty = if (idx as usize) < elems.len { elems[idx as usize] } else { 0 as u32 };
                } else if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else {
                    ty = 0 as u32;
                }
            },
            Projection.Index(_) => {
                if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else if tag == ILTYPE_SLICE {
                    ty = module.types[ty as usize - 1 as usize].def.get_Slice().element;
                } else {
                    ty = 0 as u32;
                }
            },
            Projection.Deref => {
                ty = if ty != 0 as u32 {
                    module.types[ty as usize - 1 as usize].def.get_Ptr()
                } else {
                    0 as u32
                };
            },
        }
        i = i + 1 as usize;
    }
    return false;
}

// The mask of the value READ from place P: the base's own-storage mask unless the read loads
// through a pointer (see storage_read_crosses_pointer).
fn storage_value_mask(module: &mut ILModule, locals: [Local], work: [mut u64], p: &Place) -> u64 {
    if storage_read_crosses_pointer(module, locals, p) { return 0 as u64; }
    return storage_at(work, p.base);
}

// The parameter-storage mask of the value RV produces, given each local's current mask.
fn storage_transfer_rv(
    module: &mut ILModule,
    locals: [Local],
    rv: &ZirRvalue,
    work: [mut u64],
    param_bits: [u64],
    known: &mut bool
) -> u64 {
    let mut m = 0 as u64;
    match *rv {
        // A bare copy - or a projection out of an aggregate, the strict reading - may point
        // wherever the source's storage points.
        ZirRvalue.Use(p) => { m = storage_value_mask(module, locals, work, &p); },
        ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => {
            m = storage_at(work, p.base);
            if (p.base as usize) < param_bits.len { m = m | param_bits[p.base as usize]; }
        },
        ZirRvalue.Call(fn_id, args) => {
            let mut callee_known = false;
            let mut storage = 0 as u64;
            if (fn_id as usize) < module.functions.len() {
                callee_known = module.functions[fn_id as usize].storage_known;
                storage = module.functions[fn_id as usize].ret_storage;
                if !callee_known { *known = false; }
            } else {
                *known = false;
            }
            let mut i = 0 as usize;
            while i < args.len {
                // The callee's mask names the arguments whose own storage the result may point
                // into. An unknown callee may hand back any of them.
                let own = !callee_known
                    || (i < 64 as usize && ((storage >> (i as u64)) & 1 as u64) != 0 as u64);
                if own { m = m | storage_value_mask(module, locals, work, &args[i]); }
                i = i + 1 as usize;
            }
        },
        ZirRvalue.CallPtr(f, args) => {
            // No summary: the result may point into the callee value's own storage (its captured
            // environment) or any argument's.
            m = storage_value_mask(module, locals, work, &f);
            for a in args { m = m | storage_value_mask(module, locals, work, a); }
        },
        ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args)
            | ZirRvalue.Syscall(args)
            | ZirRvalue.Intrinsic(_, args) => {
            for a in args { m = m | storage_value_mask(module, locals, work, a); }
        },
        ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.EnumPayload(p, _, _)
            | ZirRvalue.Boxed(p)
            | ZirRvalue.ArrayRepeat(p, _, _)
            | ZirRvalue.Cast(p, _)
            | ZirRvalue.PtrFromInt(p, _)
            | ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.VariantCheck(p, _, _) => {
            m = storage_value_mask(module, locals, work, &p);
        },
        ZirRvalue.BinaryOp(_, a, b) => {
            m = storage_value_mask(module, locals, work, &a)
                | storage_value_mask(module, locals, work, &b);
        },
        ZirRvalue.FuncAddr(_, env_ptr) => {
            if env_ptr != 0 as u32 {
                let ep = Place {
                    base: env_ptr,
                    projections: @slice(0 as *mut Projection, 0 as usize)
                };
                m = storage_value_mask(module, locals, work, &ep);
            }
        },
        ZirRvalue.Const(_, _)
            | ZirRvalue.Sizeof(_)
            | ZirRvalue.StringConst(_)
            | ZirRvalue.GlobalAddr(_)
            | ZirRvalue.GetEnv => {},
    }
    return m;
}

fn storage_transfer_cmask(
    module: &mut ILModule,
    locals: [Local],
    rv: &ZirRvalue,
    cmask: [mut u64],
    param_bits: [u64]
) -> u64 {
    let mut m = 0 as u64;
    match *rv {
        ZirRvalue.Use(p) => {
            if !storage_read_crosses_pointer(module, locals, &p) {
                m = storage_at(cmask, p.base);
            }
        },
        ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => {
            m = storage_at(cmask, p.base);
            if (p.base as usize) < param_bits.len {
                m = m | param_bits[p.base as usize];
            }
        },
        ZirRvalue.Call(fn_id, args) => {
            let mut callee_known = false;
            let mut storage = 0 as u64;
            let mut ties = 0xffffffffffffffff as u64;
            if (fn_id as usize) < module.functions.len() {
                callee_known = module.functions[fn_id as usize].storage_known;
                storage = module.functions[fn_id as usize].ret_storage;
                ties = module.functions[fn_id as usize].ret_ties;
            }
            let mut i = 0 as usize;
            while i < args.len {
                let own = !callee_known
                    || (i < 64 as usize && ((storage >> (i as u64)) & 1 as u64) != 0 as u64)
                    || (i < 64 as usize && ((ties >> (i as u64)) & 1 as u64) != 0 as u64);
                if own {
                    if !storage_read_crosses_pointer(module, locals, &args[i]) {
                        m = m | storage_at(cmask, args[i].base);
                    }
                }
                i = i + 1 as usize;
            }
        },
        ZirRvalue.CallPtr(f, args) => {
            if !storage_read_crosses_pointer(module, locals, &f) {
                m = m | storage_at(cmask, f.base);
            }
            for a in args {
                if !storage_read_crosses_pointer(module, locals, a) {
                    m = m | storage_at(cmask, a.base);
                }
            }
        },
        ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args)
            | ZirRvalue.Syscall(args)
            | ZirRvalue.Intrinsic(_, args) => {
            for a in args {
                if !storage_read_crosses_pointer(module, locals, a) {
                    m = m | storage_at(cmask, a.base);
                }
            }
        },
        ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.EnumPayload(p, _, _)
            | ZirRvalue.Boxed(p)
            | ZirRvalue.ArrayRepeat(p, _, _)
            | ZirRvalue.Cast(p, _)
            | ZirRvalue.PtrFromInt(p, _)
            | ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.VariantCheck(p, _, _) => {
            if !storage_read_crosses_pointer(module, locals, &p) {
                m = storage_at(cmask, p.base);
            }
        },
        ZirRvalue.BinaryOp(_, a, b) => {
            if !storage_read_crosses_pointer(module, locals, &a) {
                m = m | storage_at(cmask, a.base);
            }
            if !storage_read_crosses_pointer(module, locals, &b) {
                m = m | storage_at(cmask, b.base);
            }
        },
        ZirRvalue.FuncAddr(_, env_ptr) => {
            if env_ptr != 0 as u32 {
                m = storage_at(cmask, env_ptr);
            }
        },
        ZirRvalue.Const(_, _)
            | ZirRvalue.Sizeof(_)
            | ZirRvalue.StringConst(_)
            | ZirRvalue.GlobalAddr(_)
            | ZirRvalue.GetEnv => {},
    }
    return m;
}

fn storage_transfer_reach(
    module: &ILModule,
    rv: &ZirRvalue,
    reach: [mut u64],
    param_bits: [u64]
) -> u64 {
    let mut r = 0 as u64;
    match *rv {
        ZirRvalue.Use(p)
            | ZirRvalue.Ref(p, _)
            | ZirRvalue.RefMut(p, _)
            | ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.EnumPayload(p, _, _)
            | ZirRvalue.Boxed(p)
            | ZirRvalue.ArrayRepeat(p, _, _)
            | ZirRvalue.Cast(p, _)
            | ZirRvalue.PtrFromInt(p, _)
            | ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.VariantCheck(p, _, _) => {
            if (p.base as usize) < reach.len {
                r = reach[p.base as usize];
                if (p.base as usize) < param_bits.len {
                    r = r | param_bits[p.base as usize];
                }
            }
        },
        ZirRvalue.BinaryOp(_, a, b) => {
            if (a.base as usize) < reach.len {
                r = r | reach[a.base as usize];
                if (a.base as usize) < param_bits.len {
                    r = r | param_bits[a.base as usize];
                }
            }
            if (b.base as usize) < reach.len {
                r = r | reach[b.base as usize];
                if (b.base as usize) < param_bits.len {
                    r = r | param_bits[b.base as usize];
                }
            }
        },
        ZirRvalue.GlobalAddr(_) => {
            r = 0x8000000000000000 as u64;
        },
        ZirRvalue.Call(fn_id, args) => {
            let mut ties = 0xffffffffffffffff as u64;
            if (fn_id as usize) < module.functions.len() {
                ties = module.functions[fn_id as usize].ret_ties;
            }
            let mut i = 0 as usize;
            while i < args.len {
                if i < 64 as usize && ((ties >> (i as u64)) & 1 as u64) != 0 as u64 {
                    if (args[i].base as usize) < reach.len {
                        r = r | reach[args[i].base as usize];
                        if (args[i].base as usize) < param_bits.len {
                            r = r | param_bits[args[i].base as usize];
                        }
                    }
                }
                i = i + 1 as usize;
            }
        },
        ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args)
            | ZirRvalue.Syscall(args)
            | ZirRvalue.Intrinsic(_, args) => {
            for a in args {
                if (a.base as usize) < reach.len {
                    r = r | reach[a.base as usize];
                    if (a.base as usize) < param_bits.len {
                        r = r | param_bits[a.base as usize];
                    }
                }
            }
        },
        ZirRvalue.CallPtr(f, args) => {
            if (f.base as usize) < reach.len {
                r = r | reach[f.base as usize];
                if (f.base as usize) < param_bits.len {
                    r = r | param_bits[f.base as usize];
                }
            }
            for a in args {
                if (a.base as usize) < reach.len {
                    r = r | reach[a.base as usize];
                    if (a.base as usize) < param_bits.len {
                        r = r | param_bits[a.base as usize];
                    }
                }
            }
        },
        ZirRvalue.FuncAddr(_, env_ptr) => {
            if env_ptr != 0 as u32 && (env_ptr as usize) < reach.len {
                r = reach[env_ptr as usize];
                if (env_ptr as usize) < param_bits.len {
                    r = r | param_bits[env_ptr as usize];
                }
            }
        },
        ZirRvalue.Const(_, _)
            | ZirRvalue.Sizeof(_)
            | ZirRvalue.StringConst(_)
            | ZirRvalue.GetEnv => {},
    }
    return r;
}

// A primitive too narrow to hold an address (an integer of 32 bits or fewer, a float of 32, a `bool`,
// a `char`): a value of it carries no pointer, however it was computed from one, so a store of it
// is no store of its provenance. `u64`/`usize` and wider stay tracked (`p as usize` launders one).
fn type_is_narrow_scalar(module: &ILModule, ty: u32) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() { return false; }
    let t = &module.types[ty as usize - 1 as usize];
    if t.def.get_tag() != ILTYPE_PRIMITIVE { return false; }
    let p = t.def.get_Primitive().get_tag();
    return p == ILPRIM_U8
        || p == ILPRIM_U16
        || p == ILPRIM_U32
        || p == ILPRIM_I8
        || p == ILPRIM_I16
        || p == ILPRIM_I32
        || p == ILPRIM_F32
        || p == ILPRIM_BOOL
        || p == ILPRIM_CHAR;
}

fn note_call_stores_zir(
    module: &mut ILModule,
    locals: [Local],
    fn_id: u32,
    args: [Place],
    work: [mut u64],
    cmask: [mut u64],
    reach: [mut u64],
    param_bits: [u64],
    from_call: [bool],
    facts: &mut ZirStorageFacts
) {
    if (fn_id as usize) >= module.functions.len() { return; }
    let p_func = &module.functions[fn_id as usize];
    let mut stored_mask = p_func.stores_storage;
    let mut targets_mask = p_func.store_targets;
    if p_func.has_stores_declared {
        stored_mask = stored_mask | p_func.stores_declared_from;
        targets_mask = targets_mask | p_func.stores_declared_to;
    }
    if stored_mask == 0 as u64 { return; }
    let to_global = (targets_mask & (0x8000000000000000 as u64)) != 0 as u64;
    let mut i = 0 as usize;
    while i < args.len {
        if i < 64 as usize && ((stored_mask >> (i as u64)) & 1 as u64) != 0 as u64 {
            let ab = args[i].base as usize;
            let arg_ty = storage_place_type(module, locals, &args[i]);
            if type_is_narrow_scalar(module, arg_ty) {
                i = i + 1 as usize;
                continue;
            }
            let m_arg = (if ab < cmask.len { cmask[ab] } else { 0 as u64 })
                | (if ab < work.len { work[ab] } else { 0 as u64 })
                | (if ab < param_bits.len { param_bits[ab] } else { 0 as u64 })
                | (if ab < reach.len { reach[ab] } else { 0 as u64 });
            if m_arg != 0 as u64 {
                if to_global {
                    facts.stored = facts.stored | m_arg;
                    facts.targets = facts.targets | (0x8000000000000000 as u64);
                }
                let mut j = 0 as usize;
                while j < args.len {
                    if j != i
                        && j < 64 as usize
                        && ((targets_mask >> (j as u64)) & 1 as u64) != 0 as u64 {
                        let jb = args[j].base as usize;
                        let jb_ty = if jb < locals.len { locals[jb].ty } else { 0 as u32 };
                        let jb_is_ref = jb_ty != 0 as u32
                            && module.type_holds_reference(jb_ty, 0 as usize);
                        let t_reach = if jb < reach.len
                            && ((jb < from_call.len && !from_call[jb]) || jb_is_ref) {
                            reach[jb]
                        } else {
                            0 as u64
                        };
                        let t_arg = (if jb < param_bits.len { param_bits[jb] } else { 0 as u64 })
                            | (if jb < work.len { work[jb] } else { 0 as u64 })
                            | t_reach;
                        let t_filtered = t_arg & !m_arg;
                        if t_filtered != 0 as u64 {
                            facts.stored = facts.stored | m_arg;
                            facts.targets = facts.targets | t_filtered;
                        }
                    }
                    j = j + 1 as usize;
                }
            }
        }
        i = i + 1 as usize;
    }
}

fn storage_walk_zir(
    arena: *mut ArenaHeader,
    module: &mut ILModule,
    func: &ZirFunction
) -> ZirStorageFacts {
    let mut facts = ZirStorageFacts {
        mask: 0 as u64,
        known: true,
        stored: 0 as u64,
        targets: 0 as u64,
    };
    let locals = (*func).locals;
    let nl = locals.len + 1 as usize;
    let nb = (*func).blocks.len;
    if nb == 0 as usize { return facts; }
    // entry[bi * nl + local]: the parameter-storage mask each local holds on entry to block bi.
    let entries = unsafe { @slice(zoril_allocator_alloc(arena, nb * nl * 8) as *mut u64, nb * nl) };
    let cmask_entries = unsafe {
        @slice(zoril_allocator_alloc(arena, nb * nl * 8) as *mut u64, nb * nl)
    };
    let reach_entries = unsafe {
        @slice(zoril_allocator_alloc(arena, nb * nl * 8) as *mut u64, nb * nl)
    };
    let work = unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) };
    let cmask = unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) };
    let reach = unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) };
    let from_call = unsafe { @slice(zoril_allocator_alloc(arena, nl) as *mut bool, nl) };
    // param_bits[local] = that parameter's bit. A reference parameter's own storage is the
    // storage it points into (what the caller passed), so its bit starts in the flow; a
    // non-reference parameter's bit is added when an address into it is taken.
    let param_bits = unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) };
    unsafe {
        memset(entries.ptr as *mut u8, 0, (nb * nl * 8) as u64);
        memset(cmask_entries.ptr as *mut u8, 0, (nb * nl * 8) as u64);
        memset(reach_entries.ptr as *mut u8, 0, (nb * nl * 8) as u64);
        memset(param_bits.ptr as *mut u8, 0, (nl * 8) as u64);
        memset(work.ptr as *mut u8, 0, (nl * 8) as u64);
        memset(cmask.ptr as *mut u8, 0, (nl * 8) as u64);
        memset(reach.ptr as *mut u8, 0, (nl * 8) as u64);
        memset(from_call.ptr as *mut u8, 0, nl as u64);
    }
    let mut pi = 0 as usize;
    while pi < (*func).params.len && pi < 64 as usize {
        let p = (*func).params[pi];
        if (p.id as usize) < nl {
            let bit = (1 as u64) << (pi as u64);
            param_bits[p.id as usize] = bit;
            reach[p.id as usize] = bit;
            reach_entries[p.id as usize] = bit;
            if p.ty != 0 as u32 {
                if is_reference_tag(storage_type_tag(module, p.ty)) {
                    entries[p.id as usize] = entries[p.id as usize] | bit;
                    work[p.id as usize] = work[p.id as usize] | bit;
                }
                if module.type_holds_reference(p.ty, 0 as usize) {
                    cmask_entries[p.id as usize] = cmask_entries[p.id as usize] | bit;
                    cmask[p.id as usize] = cmask[p.id as usize] | bit;
                }
            }
        }
        pi = pi + 1 as usize;
    }

    let mut changed = true;
    while changed {
        changed = false;
        let mut bi = 0 as usize;
        while bi < nb {
            unsafe {
                memcpy(
                    work.ptr as *mut u8,
                    ((entries.ptr as usize) + bi * nl * 8) as *u8,
                    (nl * 8) as u64
                );
                memcpy(
                    cmask.ptr as *mut u8,
                    ((cmask_entries.ptr as usize) + bi * nl * 8) as *u8,
                    (nl * 8) as u64
                );
                memcpy(
                    reach.ptr as *mut u8,
                    ((reach_entries.ptr as usize) + bi * nl * 8) as *u8,
                    (nl * 8) as u64
                );
            }
            let b = &(*func).blocks[bi];
            let mut si = 0 as usize;
            while si < b.statements.len {
                match b.statements[si] {
                    ZirStmt.Let(id, rv, _) => {
                        if id != 0 as u32 && (id as usize) < nl {
                            let m = storage_transfer_rv(
                                module,
                                locals,
                                &rv,
                                work,
                                param_bits,
                                &mut facts.known
                            );
                            work[id as usize] = m;
                            let cm = storage_transfer_cmask(module, locals, &rv, cmask, param_bits);
                            cmask[id as usize] = cm;
                            let r = storage_transfer_reach(module, &rv, reach, param_bits);
                            reach[id as usize] = r;
                            let mut fc = false;
                            match rv {
                                ZirRvalue.Call(_, _) => { fc = true; },
                                ZirRvalue.Use(p)
                                    | ZirRvalue.Ref(p, _)
                                    | ZirRvalue.RefMut(p, _)
                                    | ZirRvalue.Cast(p, _)
                                    | ZirRvalue.EnumVariant(_, _, p)
                                    | ZirRvalue.EnumPayload(p, _, _)
                                    | ZirRvalue.Boxed(p)
                                    | ZirRvalue.ArrayRepeat(p, _, _)
                                    | ZirRvalue.UnaryOp(_, p)
                                    | ZirRvalue.VariantCheck(p, _, _) => {
                                    if (p.base as usize) < from_call.len {
                                        fc = from_call[p.base as usize];
                                    }
                                },
                                ZirRvalue.BinaryOp(_, a, b) => {
                                    let fca = if (a.base as usize) < from_call.len {
                                        from_call[a.base as usize]
                                    } else {
                                        false
                                    };
                                    let fcb = if (b.base as usize) < from_call.len {
                                        from_call[b.base as usize]
                                    } else {
                                        false
                                    };
                                    fc = fca || fcb;
                                },
                                _ => {},
                            }
                            from_call[id as usize] = fc;
                        }
                        if let ZirRvalue.Call(fn_id, args) = rv {
                            note_call_stores_zir(
                                module,
                                locals,
                                fn_id,
                                args,
                                work,
                                cmask,
                                reach,
                                param_bits,
                                from_call,
                                &mut facts
                            );
                        }
                    },
                    ZirStmt.Assign(pl, rv, _) => {
                        if pl.base != 0 as u32 && (pl.base as usize) < nl {
                            let m = storage_transfer_rv(
                                module,
                                locals,
                                &rv,
                                work,
                                param_bits,
                                &mut facts.known
                            );
                            let cm = storage_transfer_cmask(module, locals, &rv, cmask, param_bits);
                            let r = storage_transfer_reach(module, &rv, reach, param_bits);
                            if pl.projections.len == 0 as usize {
                                work[pl.base as usize] = m;
                                cmask[pl.base as usize] = cm;
                                reach[pl.base as usize] = r;
                                let mut fc = false;
                                match rv {
                                    ZirRvalue.Call(_, _) => { fc = true; },
                                    ZirRvalue.Use(p)
                                        | ZirRvalue.Ref(p, _)
                                        | ZirRvalue.RefMut(p, _)
                                        | ZirRvalue.Cast(p, _)
                                        | ZirRvalue.EnumVariant(_, _, p)
                                        | ZirRvalue.EnumPayload(p, _, _)
                                        | ZirRvalue.Boxed(p)
                                        | ZirRvalue.ArrayRepeat(p, _, _)
                                        | ZirRvalue.UnaryOp(_, p)
                                        | ZirRvalue.VariantCheck(p, _, _) => {
                                        if (p.base as usize) < from_call.len {
                                            fc = from_call[p.base as usize];
                                        }
                                    },
                                    ZirRvalue.BinaryOp(_, a, b) => {
                                        let fca = if (a.base as usize) < from_call.len {
                                            from_call[a.base as usize]
                                        } else {
                                            false
                                        };
                                        let fcb = if (b.base as usize) < from_call.len {
                                            from_call[b.base as usize]
                                        } else {
                                            false
                                        };
                                        fc = fca || fcb;
                                    },
                                    _ => {},
                                }
                                from_call[pl.base as usize] = fc;
                            } else {
                                work[pl.base as usize] = work[pl.base as usize] | m;
                                cmask[pl.base as usize] = cmask[pl.base as usize] | cm;
                                if storage_read_crosses_pointer(module, locals, &pl) {
                                    let pl_base_ty = if (pl.base as usize) < locals.len {
                                        locals[pl.base as usize].ty
                                    } else {
                                        0 as u32
                                    };
                                    let base_is_ref = pl_base_ty != 0 as u32
                                        && module.type_holds_reference(pl_base_ty, 0 as usize);
                                    let target_reach = if (pl.base as usize) < reach.len
                                        && (((pl.base as usize) < from_call.len
                                            && !from_call[pl.base as usize])
                                            || base_is_ref) {
                                        reach[pl.base as usize]
                                    } else {
                                        0 as u64
                                    };
                                    let target = param_bits[pl.base as usize]
                                        | work[pl.base as usize]
                                        | target_reach;
                                    let mut stored_val = (cm | m) & !target;
                                    let pl_ty = storage_place_type(module, locals, &pl);
                                    if pl_ty != 0 as u32
                                        && module.type_holds_reference(pl_ty, 0 as usize) {
                                        stored_val = (cm | m | r) & !target;
                                    }
                                    if target != 0 as u64 && stored_val != 0 as u64 {
                                        facts.stored = facts.stored | stored_val;
                                        facts.targets = facts.targets | target;
                                    }
                                }
                            }
                        }
                        if let ZirRvalue.Call(fn_id, args) = rv {
                            note_call_stores_zir(
                                module,
                                locals,
                                fn_id,
                                args,
                                work,
                                cmask,
                                reach,
                                param_bits,
                                from_call,
                                &mut facts
                            );
                        }
                    },
                    ZirStmt.Drop(_, _)
                        | ZirStmt.DropIfLive(_, _)
                        | ZirStmt.EndBorrow(_, _)
                        | ZirStmt.Intrinsic(_, _, _) => {},
                }
                si = si + 1 as usize;
            }
            match b.terminator {
                ZirTerminator.Ret(rp) => {
                    if rp.base != 0 as u32 && (rp.base as usize) < nl {
                        facts.mask = facts.mask | work[rp.base as usize];
                    }
                },
                ZirTerminator.Jmp(t) => {
                    if storage_join(
                        entries,
                        cmask_entries,
                        reach_entries,
                        t as usize,
                        work,
                        cmask,
                        reach,
                        nl,
                        nb
                    ) {
                        changed = true;
                    }
                },
                ZirTerminator.Branch(_, t1, t2) => {
                    if storage_join(
                        entries,
                        cmask_entries,
                        reach_entries,
                        t1 as usize,
                        work,
                        cmask,
                        reach,
                        nl,
                        nb
                    ) {
                        changed = true;
                    }
                    if storage_join(
                        entries,
                        cmask_entries,
                        reach_entries,
                        t2 as usize,
                        work,
                        cmask,
                        reach,
                        nl,
                        nb
                    ) {
                        changed = true;
                    }
                },
                ZirTerminator.Unreachable => {},
            }
            bi = bi + 1 as usize;
        }
    }
    return facts;
}

pub fn compute_ret_storage_zir(
    arena: *mut ArenaHeader,
    module: &mut ILModule,
    func: &ZirFunction,
    il_func_idx: u32
) {
    let facts = storage_walk_zir(arena, module, func);
    if (il_func_idx as usize) < module.functions.len() {
        module.functions[il_func_idx as usize].ret_storage = facts.mask;
        module.functions[il_func_idx as usize].storage_known = facts.known;
        module.functions[il_func_idx as usize].stores_storage = facts.stored;
        module.functions[il_func_idx as usize].store_targets = facts.targets;
    }
}
