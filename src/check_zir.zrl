// Zoril ZIR Borrow Checker

import "diag.zrl";
import "zir.zrl";
import "ast.zrl";
import "intern.zrl";
import "vec.zrl";
import "mem_raw.zrl";
import "io.zrl";
import "fmt.zrl";
import "il_type.zrl";
import "il_cfg.zrl";
import "bytevec.zrl";
import "route_set.zrl";
use ast::Span;
use bytevec::ByteVec;
use diag::diag_start;
use il_cfg::{ILFunction, ILModule, NO_DROP_FN};
use il_type::{is_raw_pointer_tag, is_reference_tag, type_name_is, ILPRIM_BOOL, ILPRIM_CHAR, ILPRIM_F32, ILPRIM_I16, ILPRIM_I32, ILPRIM_I64, ILPRIM_I8, ILPRIM_ISIZE, ILPRIM_NEVER, ILPRIM_U16, ILPRIM_U32, ILPRIM_U64, ILPRIM_U8, ILPRIM_UNIT, ILPRIM_USIZE, ILTYPE_ARRAY, ILTYPE_BOXED, ILTYPE_BOXEDMUT, ILTYPE_FD, ILTYPE_FN, ILTYPE_IORING, ILTYPE_PRIMITIVE, ILTYPE_PTR, ILTYPE_PTRMUT, ILTYPE_RAWPTR, ILTYPE_RAWPTRMUT, ILTYPE_SLICE, ILTYPE_TUPLE, ILTYPE_USER, ILType, ILTypeDecl, IL_TYPEDEF_ENUM, IL_TYPEDEF_STRUCT, is_any_pointer_tag, is_mut_pointer_tag, is_shared_pointer_tag};
use intern::InternTable;
use io::{eprint, print, stderr, stdout};
use fmt::write_u64;
use mem_raw::{ArenaHeader, memcpy, memset, zoril_allocator_alloc};
use vec::Vec;
use route_set::{ROUTE_BACKEDGE, ROUTE_JOIN, ROUTE_RV_BASE, ROUTE_RV_REF, ROUTE_RV_REFMUT, route_bit, rv_bit, stmt_bit, term_bit};
use zir::{LOCAL_KIND_LET, LOCAL_KIND_TMP, Local, PROJ_DEREF, PROJ_FIELD, PROJ_INDEX, PROJ_TUPLEINDEX, Place, Projection, ZirBlock, ZirFunction, ZirModule, ZirRvalue, ZirStmt, ZirTerminator};

// The frame's outside holder (§3.1, holder two): memory outside the frame's locals, live until return.
pub const OUTSIDE_BORROWER: u32 = 0xffffffff as u32;

pub struct ActiveBorrow {
    pub base: Place,
    pub is_mut: bool,
    pub region: u32,
    pub borrower: u32,
    pub span: Span, // where the borrow was taken, for "note: borrow of 'x' taken here"
    // Inherited by a call's or literal's result from its inputs (inherit_rv_borrows) rather
    // than taken by `&`/`&mut`. It only counts once a named local holds it: in a compiler
    // temporary it lives within one statement (`v.set(j, v.as_slice()[k])`).
    pub derived: bool,
    // Whether this borrow is of BORROWER's own referent (`&x` held by a reference local), as
    // opposed to one inherited from a value the borrower was built from. Structural provenance,
    // replacing the type comparison `is_direct_referent_borrow` used to guess it (which could not
    // tell a same-type indirect borrow, and could not see through a field or element step).
    pub direct: bool,
    // Release tier (§3.1, item 2): conflicts only with a release, not with other `&mut` uses.
    pub release_only: bool,
    pub epoch: u32,
    // The routes that carried this borrow to its current holder: the rvalue that created it, the
    // rvalue at every propagation step, and the cfg:join / cfg:backedge flags the borrow crossed.
    // Bookkeeping only - no accept/reject decision reads it. `report_borrow_conflict` adds it to
    // the verifier's `reject_via` set, which `--emit-zir-stats` prints.
    pub via: u64,
}

pub struct EnumPayloadAlias {
    pub local_id: u32,
    pub source: Place,
}

pub struct MarkInfo {
    pub mark_local: u32,
    pub arena_base: u32,
    pub epoch: u32,
}

// compute_liveness: no successor block.
const NO_SUCC: usize = 0xffffffffffffffff;

// A local's ownership state.
pub const OWN_UNINIT: u8 = 0;
pub const OWN_OWNED: u8 = 1;
pub const OWN_MOVED: u8 = 2;  // moved on some path (maybe_live: still owned on another)
pub const OWN_DROPPED: u8 = 3;

pub struct ZirAnalysisState {
    pub ownership: [mut u8], // len = locals_len + 1
    // Moved, but still owned on some path into here (the merge of a moved and an owned
    // state). For a linear resource that means it is not closed on every path.
    pub maybe_live: [mut bool], // len = locals_len + 1
    pub borrows: Vec<ActiveBorrow>,
    pub enum_aliases: Vec<EnumPayloadAlias>,
    pub mark_infos: Vec<MarkInfo>,
}

impl ZirAnalysisState {
    #[borrows(arena)]
    #[stores(arena -> arena)]
    pub fn clone(
        self: &ZirAnalysisState,
        arena: *mut ArenaHeader,
        locals_len: usize
    ) -> *mut ZirAnalysisState {
        let dest = unsafe {
            zoril_allocator_alloc(arena, sizeof(ZirAnalysisState))
        } as *mut ZirAnalysisState;
        let own_ptr = unsafe { zoril_allocator_alloc(arena, locals_len + 1) } as *mut u8;
        let own = unsafe { @slice(own_ptr, locals_len + 1 as usize) };
        let ml_ptr = unsafe { zoril_allocator_alloc(arena, locals_len + 1) } as *mut bool;
        let ml = unsafe { @slice(ml_ptr, locals_len + 1 as usize) };
        unsafe {
            memcpy(own_ptr, self.ownership.ptr as *u8, (locals_len + 1) as u64);
            memcpy(ml_ptr as *mut u8, self.maybe_live.ptr as *u8, (locals_len + 1) as u64);
        }

        let mut bor = unsafe { self.borrows.clone_in_raw(arena) };
        let mut ea = unsafe { self.enum_aliases.clone_in_raw(arena) };
        let mut mi = unsafe { self.mark_infos.clone_in_raw(arena) };

        unsafe {
            *dest = ZirAnalysisState {
                ownership: own,
                maybe_live: ml,
                borrows: bor,
                enum_aliases: ea,
                mark_infos: mi,
            };
        }
        return dest;
    }
}

pub struct ZirVerifier {
    pub arena: *mut ArenaHeader,
    pub module: &mut ZirModule,
    pub zil_module: &mut ILModule,
    pub intern_table: &mut InternTable,
    pub had_error: bool,
    pub reporting_enabled: bool,
    // Set by place_last_deref_is_readonly: the read-only layer was a `[T]` slice.
    pub readonly_is_slice: bool,
    pub file_path: [u8],
    // Non-lexical borrows: which locals are used again after the statement being
    // checked (bit per local id; null = treat every local as live). A borrow counts only
    // while its borrower is live, so `let r = v.get(0); use(r); v.push(1);` is accepted.
    pub live_words: usize,
    pub live_out: *mut u64,   // per block: live after its terminator's successors begin
    pub live_rows: *mut u64,  // the current block: row k = live after statement k
    pub live_rows_cap: usize,
    pub cur_live: *mut u64,
    pub next_borrow_epoch: u32,
    // The body being verified. `write_local_name` reads its `Let` statements for the span that
    // produced a compiler temporary, so a diagnostic never has to print an internal id.
    pub cur_blocks: [ZirBlock],
    // The routes a reported rejection travelled through: the union of the conflicting borrow's
    // `via` and the rvalue/statement/terminator being checked when the error was reported. Only
    // accumulated while `reporting_enabled` is true (the fixed-point pass sees no errors).
    pub reject_via: u64,
    // The current rvalue, statement and terminator route bits, set by the check_* entry points
    // so a report can say where it happened. A terminator check clears the statement bit, and
    // vice versa.
    pub cur_rv: u64,
    pub cur_stmt: u64,
    pub cur_term: u64,
    pub origins: *mut OriginSets,
}

impl ZirVerifier {
    pub fn new(
        arena: *mut ArenaHeader,
        module: &mut ZirModule,
        zil_module: &mut ILModule,
        intern_table: &mut InternTable,
        origins: *mut OriginSets
    ) -> ZirVerifier {
        return ZirVerifier {
            arena: arena,
            module: module,
            zil_module: zil_module,
            intern_table: intern_table,
            had_error: false,
            reporting_enabled: false,
            readonly_is_slice: false,
            file_path: "",
            live_words: 0 as usize,
            live_out: 0 as *mut u64,
            live_rows: 0 as *mut u64,
            live_rows_cap: 0 as usize,
            cur_live: 0 as *mut u64,
            next_borrow_epoch: 1 as u32,
            cur_blocks: unsafe { @slice(0 as *mut ZirBlock, 0 as usize) },
            reject_via: 0 as u64,
            cur_rv: 0 as u64,
            cur_stmt: 0 as u64,
            cur_term: 0 as u64,
            origins: origins,
        };
    }

    fn diag_file(self: &ZirVerifier) -> [u8] {
        return if self.file_path.len > 0 as usize { self.file_path } else { "unknown" };
    }

    fn report_error(self: &mut ZirVerifier, msg: [u8], span: Span) {
        self.had_error = true;
        if !self.reporting_enabled { return; }

        diag_start(self.diag_file(), span, "error");
        eprint(msg);
        eprint("\n");
    }

    fn report_var_error(
        self: &mut ZirVerifier,
        msg_pre: [u8],
        local_id: u32,
        msg_post: [u8],
        span: Span,
        locals: [Local]
    ) {
        self.had_error = true;
        if !self.reporting_enabled { return; }

        diag_start(self.diag_file(), span, "error");
        eprint(msg_pre);
        eprint(" '");
        self.write_local_name(local_id, locals);
        eprint("'");

        if msg_post.len > 0 as usize {
            eprint(" ");
            eprint(msg_post);
        }
        eprint("\n");
    }

    // Prints a local's declared name, or "variable (id: N)" if it has none (a compiler-generated
    // temporary). Shared by `report_var_error` and `write_place_path` below so the two spellings
    // of "which local" never drift apart.
    fn write_local_name(self: &ZirVerifier, local_id: u32, locals: [Local]) {
        let mut found = false;
        let mut name_id = 0 as u32;
        let mut closure_line = 0 as u32;
        let mut closure_col = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == local_id {
                name_id = locals[li].name_id;
                closure_line = locals[li].closure_span.line;
                closure_col = locals[li].closure_span.col;
                found = true;
                break;
            }
            li = li + 1 as usize;
        }

        if found && name_id != 0 as u32 {
            eprint(self.intern_table.lookup(name_id));
        } else if found && closure_line != 0 as u32 {
            // The compiler-generated local behind a capturing closure is its environment. Name
            // the closure the user wrote, not an internal temporary id.
            eprint("the environment of the closure created at ");
            let mut err = stderr();
            let _ = write_u64(&mut err, closure_line as u64);
            eprint(":");
            let _ = write_u64(&mut err, closure_col as u64);
        } else {
            // A compiler temporary. Name the expression whose value it holds - the span on the
            // `Let` that produced it - so the message says where to look even though the local
            // has no name in the source. An id is the last resort, and the error-reporting
            // tests reject it in a committed expectation.
            let mut origin = Span {
                start: 0 as u32,
                end: 0 as u32,
                line: 0 as u32,
                col: 0 as u32
            };
            let mut have_origin = false;
            let mut bi = 0 as usize;
            while bi < self.cur_blocks.len && !have_origin {
                let b = &self.cur_blocks[bi];
                let mut si = 0 as usize;
                while si < b.statements.len {
                    match b.statements[si] {
                        ZirStmt.Let(target, _, stmt_span) => {
                            if target == local_id && stmt_span.line != 0 as u32 {
                                origin = stmt_span;
                                have_origin = true;
                                break;
                            }
                        },
                        _ => {},
                    }
                    si = si + 1 as usize;
                }
                bi = bi + 1 as usize;
            }
            if have_origin {
                eprint("the value of the expression at ");
                let mut err = stderr();
                let _ = write_u64(&mut err, origin.line as u64);
                eprint(":");
                let _ = write_u64(&mut err, origin.col as u64);
            } else {
                eprint("a temporary");
            }
        }
    }

    // Prints a place's user-facing path -- the base local's name, followed by a `.field` or `.N`
    // for each `Field`/`TupleIndex` projection, stopping at the first `Deref`/`Index` (neither has
    // a stable "friendly" spelling the way a field name does: `*p` and `arr[i]` don't name one
    // fixed piece of storage). This is what lets a borrow conflict on `self.resolver` read as
    // exactly that, rather than as `self` -- which reads as if the whole struct conflicted, not
    // one field of it.
    fn write_place_path(self: &ZirVerifier, place: &Place, locals: [Local]) {
        self.write_local_name(place.base, locals);
        let mut pi = 0 as usize;
        while pi < place.projections.len {
            let proj = &place.projections[pi];
            let tag = proj.get_tag();
            if tag == PROJ_FIELD {
                eprint(".");
                eprint(self.intern_table.lookup(proj.get_Field()));
            } else if tag == PROJ_TUPLEINDEX {
                eprint(".");
                let mut err = stderr();
                let _ = write_u64(&mut err, proj.get_TupleIndex() as u64);
            } else {
                return;
            }
            pi = pi + 1 as usize;
        }
    }

    // Same shape as `report_var_error`, but for a full `&Place` (base + projections) rather than
    // a bare local id, so a conflict on one field of a struct doesn't get spelled as if the
    // struct itself were the point of conflict.
    fn report_place_error(
        self: &mut ZirVerifier,
        msg_pre: [u8],
        place: &Place,
        msg_post: [u8],
        span: Span,
        locals: [Local]
    ) {
        self.had_error = true;
        if !self.reporting_enabled { return; }

        diag_start(self.diag_file(), span, "error");
        eprint(msg_pre);
        eprint(" '");
        self.write_place_path(place, locals);
        eprint("'");

        if msg_post.len > 0 as usize {
            eprint(" ");
            eprint(msg_post);
        }
        eprint("\n");
    }

    // `report_place_error` plus a second `note:` line naming *where* the conflicting borrow was
    // taken -- without it, a programmer sees that something conflicts but not which borrow, or
    // where. `conflicting`/`conflict_span` are the overlapping `ActiveBorrow`'s own `base`/`span`.
    fn report_borrow_conflict(
        self: &mut ZirVerifier,
        msg_pre: [u8],
        place: &Place,
        msg_post: [u8],
        span: Span,
        conflicting: &Place,
        conflict_span: Span,
        conflict_via: u64,
        locals: [Local]
    ) {
        self.report_place_error(msg_pre, place, msg_post, span, locals);
        if !self.reporting_enabled { return; }

        // Record the routes this rejection travelled through: where the borrow was created and
        // carried, where the conflict was reported, and the rvalue being checked. Only the
        // reporting pass counts; the fixed-point pass suppresses every diagnostic.
        self.reject_via = self.reject_via
            | conflict_via
            | self.cur_rv
            | self.cur_stmt
            | self.cur_term;

        diag_start(self.diag_file(), conflict_span, "note");
        eprint("borrow of '");
        self.write_place_path(conflicting, locals);
        eprint("' taken here\n");
    }

    // True if writing to `pl` (or creating a `&mut` through it) means dereferencing a read-only
    // pointer: the *last* pointer layer dereferenced while resolving `pl` has IL type `Ptr`,
    // which covers both `&T` and non-mut `*T` (the two erase to the same tag). `PtrMut` is the
    // only writable pointer type, matching Rust's `&T`/`*const T` vs `&mut T`/`*mut T` split.
    // `Boxed`/`BoxedMut` are deliberately excluded: both permit stores (see
    // `doc/spec/intermediate_language.md` §6.6 and `doc/spec/surface_syntax.md` §3.3), so that
    // pair is not a read/write split.
    //
    // The chain is walked rather than searched for an explicit `Deref`, because a field or index
    // projection on a pointer auto-derefs: `r.x` carries no `Deref` projection while `(*r).x`
    // does, and the two reach the same storage. Only the last dereference decides, which is what
    // makes `(*(*cur).inner).v = 5` writable when `inner` is a `*mut Inner` behind a `&Scope`.
    // A place that never dereferences a pointer is governed by the let/let-mut rules instead.
    fn writes_immutable_binding(self: &mut ZirVerifier, place: &Place, locals: [Local]) -> bool {
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == place.base {
                return locals[li].kind == LOCAL_KIND_LET
                    && !self.place_has_deref(place)
                    && (place.projections.len == 0 as usize
                        || !self.is_pointer_like_type(locals[li].ty));
            }
            li = li + 1 as usize;
        }
        return false;
    }

    fn place_has_deref(self: &mut ZirVerifier, place: &Place) -> bool {
        let mut pi = 0 as usize;
        while pi < place.projections.len {
            if place.projections[pi].get_tag() == PROJ_DEREF { return true; }
            pi = pi + 1 as usize;
        }
        return false;
    }

    fn place_has_index(self: &mut ZirVerifier, place: &Place) -> bool {
        let mut pi = 0 as usize;
        while pi < place.projections.len {
            if place.projections[pi].get_tag() == PROJ_INDEX { return true; }
            pi = pi + 1 as usize;
        }
        return false;
    }

    // Whether a write to PL reaches its target through a pointer, a box or a slice view: an explicit
    // dereference, or a field, tuple or index step out of a value of such a type (a field access
    // through a reference dereferences it implicitly, as place_last_deref_is_readonly reads it).
    // That write stores into the referent, not into the base local, so what the value borrows is
    // not the base local's to hold. The steps are the ones place_last_deref_is_readonly takes.
    fn place_writes_through_pointer(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> bool {
        let mut curr_ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == (*pl).base {
                curr_ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        let mut i = 0 as usize;
        while i < (*pl).projections.len {
            let proj = &(*pl).projections[i];
            let tag = proj.get_tag();
            if tag == PROJ_DEREF { return true; }
            if curr_ty != 0 as u32 {
                let layer_tag = self.get_type_decl(curr_ty).def.get_tag();
                if is_any_pointer_tag(layer_tag)
                    || layer_tag == ILTYPE_BOXED
                    || layer_tag == ILTYPE_BOXEDMUT
                    || layer_tag == ILTYPE_SLICE {
                    return true;
                }
            }
            if tag == PROJ_FIELD {
                let field_idx = self.get_field_index(curr_ty, proj.get_Field());
                curr_ty = self.get_field_type(curr_ty, field_idx);
            } else if tag == PROJ_TUPLEINDEX {
                curr_ty = self.get_tuple_elem_type(curr_ty, proj.get_TupleIndex());
            } else {
                curr_ty = self.get_slice_element_type(curr_ty);
            }
            i = i + 1 as usize;
        }
        return false;
    }

    fn is_pointer_like_type(self: &mut ZirVerifier, ty: u32) -> bool {
        if ty == 0 as u32 || ty as usize > self.zil_module.types.len() { return false; }
        let tag = self.zil_module.types[ty as usize - 1 as usize].def.get_tag();
        return is_any_pointer_tag(tag)
            || tag == ILTYPE_BOXED
            || tag == ILTYPE_BOXEDMUT
            || tag == ILTYPE_SLICE;
    }

    // Why the place place_last_deref_is_readonly just judged cannot be written.
    fn readonly_reason(self: &ZirVerifier) -> [u8] {
        if self.readonly_is_slice {
            return "through a read-only slice (`[T]`; writing needs `[mut T]`)";
        }
        return "because it is behind a shared reference";
    }

    fn place_last_deref_is_readonly(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> bool {
        let mut curr_ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == (*pl).base {
                curr_ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if curr_ty == 0 as u32 { return false; }

        let mut saw_deref = false;
        let mut last_was_readonly = false;
        self.readonly_is_slice = false;

        let mut i = 0 as usize;
        while i < (*pl).projections.len {
            let proj = &(*pl).projections[i];
            let tag = proj.get_tag();

            if tag == PROJ_DEREF {
                if curr_ty != 0 as u32 {
                    let p_ty = self.get_type_decl(curr_ty);
                    saw_deref = true;
                    last_was_readonly = is_shared_pointer_tag(p_ty.def.get_tag());
                    self.readonly_is_slice = false;
                }
                curr_ty = self.get_ptr_inner_type(curr_ty);
            } else if tag == PROJ_FIELD || tag == PROJ_TUPLEINDEX || tag == PROJ_INDEX {
                // Strip every pointer/box layer before the field/tuple/index access, exactly as
                // get_field_index/get_field_type/get_slice_element_type do internally -- the
                // last layer stripped is the one whose dereference actually reaches the
                // aggregate, so it is the one whose read-only-ness governs this step.
                if curr_ty != 0 as u32 {
                    let mut p_ty = self.get_type_decl(curr_ty);
                    let mut layer_tag = p_ty.def.get_tag();
                    while is_any_pointer_tag(layer_tag)
                        || layer_tag == ILTYPE_BOXED
                        || layer_tag == ILTYPE_BOXEDMUT {
                        saw_deref = true;
                        last_was_readonly = is_shared_pointer_tag(layer_tag);
                        self.readonly_is_slice = false;
                        curr_ty = self.get_ptr_inner_type(curr_ty);
                        if curr_ty == 0 as u32 { break; }
                        p_ty = self.get_type_decl(curr_ty);
                        layer_tag = p_ty.def.get_tag();
                    }
                }

                if tag == PROJ_FIELD {
                    let field_idx = self.get_field_index(curr_ty, proj.get_Field());
                    curr_ty = self.get_field_type(curr_ty, field_idx);
                } else if tag == PROJ_TUPLEINDEX {
                    curr_ty = self.get_tuple_elem_type(curr_ty, proj.get_TupleIndex());
                } else {
                    // Indexing a slice reaches its elements through the slice's pointer: a
                    // `[T]` is a read-only view, as a `&T` is; a `[mut T]` may write.
                    if curr_ty != 0 as u32 {
                        let p_sl = self.get_type_decl(curr_ty);
                        if p_sl.def.get_tag() == ILTYPE_SLICE {
                            saw_deref = true;
                            last_was_readonly = !p_sl.def.get_Slice().mutable;
                            self.readonly_is_slice = true;
                        }
                    }
                    curr_ty = self.get_slice_element_type(curr_ty);
                }
            }
            i = i + 1 as usize;
        }

        if !saw_deref { return false; }
        return last_was_readonly;
    }

    // Whether two places name storage that may overlap. They do when they share a base and one
    // projection path is a prefix of the other, comparing the steps they have in common: distinct
    // fields of the same aggregate (`self.module.blocks` and `self.module.arena`) are disjoint,
    // while a shared prefix down to a deref or index is not. Comparing only the first projection
    // made every field of a local conflict with every other once indexing became a real borrow
    // (Unified Solution A), which is false: `tools/zilc` borrows one field and allocates from
    // another in the same statement.
    // Exact structural equality of two places, used to key a borrow in the dataflow merge.
    fn places_equal(self: &ZirVerifier, p1: &Place, p2: &Place) -> bool {
        if p1.base != p2.base { return false; }
        if p1.projections.len != p2.projections.len { return false; }
        let mut i = 0 as usize;
        while i < p1.projections.len {
            let a = &p1.projections[i];
            let b = &p2.projections[i];
            let tag = a.get_tag();
            if tag != b.get_tag() { return false; }
            if tag == PROJ_FIELD {
                if a.get_Field() != b.get_Field() { return false; }
            } else if tag == PROJ_TUPLEINDEX {
                if a.get_TupleIndex() != b.get_TupleIndex() { return false; }
            } else if tag == PROJ_INDEX {
                if a.get_Index() != b.get_Index() { return false; }
            }
            i = i + 1 as usize;
        }
        return true;
    }

    fn places_overlap(self: &ZirVerifier, p1: &Place, p2: &Place) -> bool {
        if p1.base != p2.base { return false; }
        let n = if p1.projections.len < p2.projections.len {
            p1.projections.len
        } else {
            p2.projections.len
        };
        let mut i = 0 as usize;
        while i < n {
            let pr1 = &p1.projections[i];
            let pr2 = &p2.projections[i];
            let tag1 = pr1.get_tag();
            let tag2 = pr2.get_tag();
            if tag1 != tag2 { return true; }
            if tag1 == PROJ_FIELD {
                if pr1.get_Field() != pr2.get_Field() { return false; }
            } else if tag1 == PROJ_TUPLEINDEX {
                if pr1.get_TupleIndex() != pr2.get_TupleIndex() { return false; }
            } else if tag1 == PROJ_INDEX {
                // Two index expressions may name the same element; only a shared index local is
                // known to, but not knowing is not a proof of disjointness.
                if pr1.get_Index() != pr2.get_Index() {
                    return true;
                }
            }
            i = i + 1 as usize;
        }
        return true;
    }

    fn check_place_use(
        self: &mut ZirVerifier,
        place: &Place,
        is_move: bool,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if place.base == 0 as u32 { return; }
        // Local ids run 1..=locals.len, in order (the state arrays have locals.len + 1 entries);
        // a `>=` here skipped the last local of every function, so `fn f(b: &B) -> R {
        // return b.r; }` moved out of the borrow unchecked.
        if place.base > locals.len as u32 {
            return;
        }

        let st = state.ownership[place.base as usize];
        if st == OWN_UNINIT {
            self.report_var_error("use of uninitialized variable", place.base, "", span, locals);
            return;
        }
        if st == OWN_MOVED {
            self.report_var_error("use of moved value", place.base, "", span, locals);
            return;
        }
        if st == OWN_DROPPED {
            self.report_var_error("use of dropped value", place.base, "", span, locals);
            return;
        }

        // Any use conflicts with a live mutable borrow.
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            let b = &state.borrows[i];
            if self.borrow_counts(b, &*state, locals)
                && !b.release_only
                && b.is_mut
                && self.places_overlap(place, &b.base) {
                self.report_borrow_conflict(
                    "cannot use",
                    place,
                    "while it is mutably borrowed",
                    span,
                    &b.base,
                    b.span,
                    b.via,
                    locals
                );
            }
            i = i + 1 as usize;
        }
        if !is_move { return; }

        let loc = &locals[place.base as usize - 1 as usize];
        // A temporary holding a raw pointer, a `&mut`, or a box is moved even when its type is
        // Copy: those are the linear, ownership-like forms. A *shared* reference is Copy in the
        // ordinary sense, and a repeat `[&x; n]` reuses one element temporary for every element;
        // moving it would report `use of moved value` for element 2..n although each use is a
        // copy. The unrolled lowering therefore leaves a Copy element place in place, and this
        // is where a `&mut` element still ends up linear (and so `[&mut x; 2]` stays rejected).
        let is_temp = (loc.kind == LOCAL_KIND_TMP || loc.name_id == 0 as u32)
            && place.projections.len == 0 as usize
            && self.is_moved_temp_type(loc.ty);
        let is_copy = self.is_copy_type(self.get_place_type(place, locals))
            || (place.projections.len == 0 as usize && loc.is_copy);
        if is_copy && !is_temp { return; }

        // A closure body's alias for a captured value is not an owner: moving the value out would
        // leave the environment holding it as well, and both would drop it (Unified Solution D).
        if loc.is_capture_alias && place.projections.len == 0 as usize {
            self.report_error("cannot move out of a closure capture", span);
            return;
        }

        if place.projections.len > 0 as usize && self.local_is_pointer(loc) {
            // Moving out through a named reference moves out of what it borrows. Through a
            // temporary pointer (a field or payload address) it is a move out of the owner,
            // unless that is borrowed: the source of an enum payload address.
            let is_enum_ptr = self.is_enum_payload_alias(place.base, state);
            let why = if is_enum_ptr {
                self.enum_payload_source_refusal(place.base, state, locals)
            } else {
                0 as u32
            };
            if why == 2 as u32 {
                self.report_error("cannot move out of a closure capture", span);
                return;
            }
            if why == 3 as u32 {
                self.report_error("cannot move out of an array or slice element", span);
                return;
            }
            let out_of_borrow = loc.name_id != 0 as u32
                || (!is_enum_ptr && self.local_holds_borrow(place.base, state))
                || why == 1 as u32;
            if out_of_borrow {
                self.report_error("cannot move out of borrow", span);
                return;
            }
        }
        if loc.is_capture_alias {
            self.report_error("cannot move out of a closure capture", span);
            return;
        }
        if self.place_has_index(place) {
            self.report_error("cannot move out of an array or slice element", span);
            return;
        }
        if self.is_borrowed_by_other(place, state, locals) {
            self.report_var_error("cannot move borrowed value", place.base, "", span, locals);
            return;
        }
        if !loc.is_copy || is_temp {
            state.ownership[place.base as usize] = OWN_MOVED;
            state.maybe_live[place.base as usize] = false;
        }
    }

    fn is_moved_temp_type(self: &mut ZirVerifier, ty: u32) -> bool {
        if ty == 0 as u32 { return false; }
        let tag = self.get_type_decl(ty).def.get_tag();
        return is_raw_pointer_tag(tag)
            || tag == ILTYPE_PTRMUT
            || tag == ILTYPE_BOXED
            || tag == ILTYPE_BOXEDMUT;
    }

    // Whether LOC holds a reference or pointer.
    fn local_is_pointer(self: &mut ZirVerifier, loc: &Local) -> bool {
        if loc.ty == 0 as u32 { return false; }
        let tag = self.get_type_decl(loc.ty).def.get_tag();
        return is_any_pointer_tag(tag);
    }

    fn local_is_reference(self: &ZirVerifier, loc: &Local) -> bool {
        if loc.ty == 0 as u32 { return false; }
        return is_reference_tag(self.get_type_decl(loc.ty).def.get_tag());
    }

    fn is_enum_payload_alias(self: &ZirVerifier, local_id: u32, state: &ZirAnalysisState) -> bool {
        let mut i = 0 as usize;
        while i < state.enum_aliases.len() {
            if state.enum_aliases[i].local_id == local_id { return true; }
            i = i + 1 as usize;
        }
        return false;
    }

    fn local_holds_borrow(self: &ZirVerifier, local_id: u32, state: &ZirAnalysisState) -> bool {
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            if state.borrows[i].borrower == local_id { return true; }
            i = i + 1 as usize;
        }
        return false;
    }

    // Whether a borrow that still constrains PLACE overlaps it: one whose borrower is owned and
    // live and that is not a temporary's derived borrow - exactly `borrow_counts`. Liveness is
    // what keeps a value with a `Drop` impl immovable: `ZirStmt.Drop` counts as a use (see
    // `place_uses`), so such a borrower is still live here, and a use of the borrower after the
    // move keeps it live too. Counting to the borrower's scope end instead made this check
    // stricter than the borrow-conflict check about the same borrow.
    fn is_borrowed_by_other(
        self: &mut ZirVerifier,
        place: &Place,
        state: &ZirAnalysisState,
        locals: [Local]
    ) -> bool {
        let is_owner = self.type_owns_storage(self.get_place_type(place, locals), 0 as usize);
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            let b = &state.borrows[i];
            if self.borrow_counts(b, state, locals)
                && (!b.release_only || is_owner)
                && self.places_overlap(place, &b.base) {
                return true;
            }
            i = i + 1 as usize;
        }
        return false;
    }

    // Whether a value of TY owns storage the frame releases at its scope end: drop glue (an
    // `Arena` handle, a `Box`, a user `Drop`), or one of the standard library's growable
    // collections, whose buffer is freed through a raw-pointer field the field walk cannot see.
    // Recursive through tuple, array, struct and enum fields. Past the depth limit the answer is
    // "owns": the strict side, since "owns nothing" is what lets a reference escape.
    fn type_owns_storage(self: &mut ZirVerifier, ty: u32, depth: usize) -> bool {
        if depth > 8 as usize { return true; }
        if ty == 0 as u32 { return false; }
        let p_ty = self.type_decl_copy(ty);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT { return true; }
        if tag == ILTYPE_TUPLE {
            let elems = p_ty.def.get_Tuple();
            let mut i = 0 as usize;
            while i < elems.len {
                if self.type_owns_storage(elems[i], depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
            return false;
        }
        if tag == ILTYPE_ARRAY {
            return self.type_owns_storage(p_ty.def.get_Array().element, depth + 1 as usize);
        }
        if tag != ILTYPE_USER { return false; }
        let user = p_ty.def.get_User();
        if self.is_collection_type_name(user.name) { return true; }
        if self.has_drop_impl(ty) { return true; }
        let user_id = user.id;
        if user_id == 0xffffffff as u32 || user_id as usize >= self.zil_module.typedefs.len() {
            return false;
        }
        let p_def = self.zil_module.typedefs[user_id as usize];
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            let fields = p_def.get_Struct().fields;
            let mut i = 0 as usize;
            while i < fields.len {
                if self.type_owns_storage(fields[i].ty, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            let variants = p_def.get_Enum().variants;
            let mut i = 0 as usize;
            while i < variants.len {
                if self.type_owns_storage(variants[i].payload, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        }
        return false;
    }

    fn is_closure_env(self: &ZirVerifier, id: u32, locals: [Local]) -> bool {
        if id == 0 as u32 { return false; }
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == id { return locals[li].closure_span.line != 0 as u32; }
            li = li + 1 as usize;
        }
        return false;
    }

    fn local_type_owns_storage(self: &mut ZirVerifier, local_id: u32, locals: [Local]) -> bool {
        let mut ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == local_id {
                ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if ty == 0 as u32 { return false; }
        return self.type_owns_storage(ty, 0 as usize);
    }

    // The four collections whose buffer lives behind a raw-pointer field, so the field walk above
    // stops at the struct. A specialized instance carries its arguments in the name (`Vec_i32`).
    fn is_collection_type_name(self: &mut ZirVerifier, name_id: u32) -> bool {
        if name_id == 0 as u32 { return false; }
        let s = self.intern_table.lookup(name_id);
        return type_name_is(s, "Vec")
            || type_name_is(s, "String")
            || type_name_is(s, "ByteVec")
            || type_name_is(s, "HashMap");
    }

    // Whether LOCAL_ID's storage belongs to a frame that outlives this one, proved by provenance: a
    // parameter, a value copied from one, a collection a standard-library raw constructor took
    // (`*_raw`, `unsafe`, the caller's buffer), or one anchored to a `&Arena` argument that itself
    // outlives the frame. Must-external - one binding this frame owns makes the local this frame's,
    // so a reference into its buffer cannot escape. Anything else, including a call the checker
    // cannot classify (a helper that returns a collection), is not external: the strict side.
    fn local_storage_external(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        local_id: u32,
        depth: usize
    ) -> bool {
        if depth > 8 as usize { return false; }
        if local_id == 0 as u32 || (local_id as usize) > locals.len { return false; }
        for p in func.params {
            if p.id == local_id { return true; }
        }
        let mut any = false;
        let mut bi = 0 as usize;
        while bi < func.blocks.len {
            let b = &func.blocks[bi];
            let mut si = 0 as usize;
            while si < b.statements.len {
                match b.statements[si] {
                    ZirStmt.Let(id, rv, _) => {
                        if id == local_id {
                            any = true;
                            if !self.rvalue_storage_external(
                                func,
                                locals,
                                &rv,
                                depth + 1 as usize
                            ) {
                                return false;
                            }
                        }
                    },
                    ZirStmt.Assign(pl, rv, _) => {
                        if pl.base == local_id && pl.projections.len == 0 as usize {
                            any = true;
                            if !self.rvalue_storage_external(
                                func,
                                locals,
                                &rv,
                                depth + 1 as usize
                            ) {
                                return false;
                            }
                        }
                    },
                    _ => {},
                }
                si = si + 1 as usize;
            }
            bi = bi + 1 as usize;
        }
        return any;
    }

    fn rvalue_storage_external(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        rv: &ZirRvalue,
        depth: usize
    ) -> bool {
        match *rv {
            // A copy of a place (a bare copy, a reborrow, a box, a match binding's payload, a
            // cast) is as external as the place it came from; a `match` binding is the route a
            // `&Option<T>` parameter's payload takes (`Clone for Option<T>`).
            ZirRvalue.Use(p)
                | ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.Boxed(p)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.Cast(p, _) => {
                return self.place_storage_external(func, locals, &p, depth);
            },
            ZirRvalue.Call(fn_id, args) => {
                // An `unsafe fn` hands the caller an obligation rather than a guarantee: the raw
                // constructors are where the standard library's callers take it, so what they
                // return is not read as this frame's. It has to be the callee's own attribute,
                // not the (`-I stdlib=`-only) standard-library identity the flags need, or a
                // build with a plain `-I stdlib` would reject the stdlib's own code.
                if self.is_unsafe_call(fn_id) {
                    return true;
                }
                if self.is_buffer_external_call(fn_id) { return true; }
                if self.is_buffer_anchored_call(fn_id) {
                    // `new_in(a: &Arena)`, `Command::new(program, a: &Arena)`: the `&Arena`
                    // argument, the (only) reference-typed one, decides whose buffer the
                    // collection holds.
                    let mut ai = 0 as usize;
                    while ai < args.len {
                        let aty = self.get_place_type(&args[ai], locals);
                        if aty != 0 as u32
                            && is_reference_tag(self.get_type_decl(aty).def.get_tag()) {
                            return self.place_storage_external(func, locals, &args[ai], depth);
                        }
                        ai = ai + 1 as usize;
                    }
                }
                return false;
            },
            // A literal lives in the program image, not in this frame.
            ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_) => { return true; },
            ZirRvalue.StructLiteral(_, args) | ZirRvalue.Tuple(args) => {
                let mut any = false;
                for a in args {
                    if self.place_storage_external(func, locals, a, depth + 1 as usize) {
                        any = true;
                    }
                }
                return any;
            },
            _ => { return false; },
        }
    }

    fn place_storage_external(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        p: &Place,
        depth: usize
    ) -> bool {
        if p.base == 0 as u32 { return false; }
        return self.local_storage_external(func, locals, p.base, depth);
    }

    // Why moving out of temporary LOCAL_ID (an enum payload address) is refused: 0 if not
    // refused, 1 if its source is borrowed (by a live borrow, or because the source is behind
    // a named reference), 2 if its source is a closure capture, 3 if its source is an array
    // or slice element. The walk is bounded by the alias table's length plus one because any
    // longer chain must cycle, and running out answers borrowed so a cycle cannot bypass the
    // check.
    fn enum_payload_source_refusal(
        self: &mut ZirVerifier,
        local_id: u32,
        state: &ZirAnalysisState,
        locals: [Local]
    ) -> u32 {
        let mut cur = local_id;
        let mut depth = 0 as usize;
        let limit = state.enum_aliases.len() + 1 as usize;
        while depth < limit {
            let mut found = false;
            let mut src = Place {
                base: 0 as u32,
                projections: @slice(0 as *mut Projection, 0 as usize)
            };
            let mut i = 0 as usize;
            while i < state.enum_aliases.len() {
                if state.enum_aliases[i].local_id == cur {
                    src = state.enum_aliases[i].source;
                    found = true;
                    break;
                }
                i = i + 1 as usize;
            }
            if !found { return 0 as u32; }
            if self.is_borrowed_by_other(&src, state, locals) { return 1 as u32; }
            if src.base == 0 as u32 || src.base > locals.len as u32 { return 0 as u32; }
            let src_loc = &locals[src.base as usize - 1 as usize];
            if src_loc.is_capture_alias { return 2 as u32; }
            if self.place_has_index(&src) { return 3 as u32; }
            if (!self.is_enum_payload_alias(src.base, state) || src.projections.len > 1 as usize)
                && self.local_is_pointer(src_loc)
                && (src_loc.name_id != 0 as u32
                    || self.local_holds_borrow(src.base, state)
                    || self.local_is_reference(src_loc)) {
                return 1 as u32;
            }
            if src.projections.len == 0 as usize || src.projections[0].get_tag() != PROJ_DEREF {
                return 0 as u32;
            }
            cur = src.base;
            depth = depth + 1 as usize;
        }
        return 1 as u32;
    }

    fn get_borrow_base(self: &ZirVerifier, borrower: u32, state: &ZirAnalysisState) -> u32 {
        let mut cur = borrower;
        let mut depth = 0 as usize;
        while depth < 8 as usize {
            let mut found = false;
            let mut i = 0 as usize;
            while i < state.borrows.len() {
                if state.borrows[i].borrower == cur {
                    cur = state.borrows[i].base.base;
                    found = true;
                    break;
                }
                i = i + 1 as usize;
            }
            if !found { return cur; }
            depth = depth + 1 as usize;
        }
        return cur;
    }

    // The arena lifecycle primitives are identified by the flag the driver set on the callee when
    // it declared it, which it derives from the module the declaration was loaded from (the
    // standard library) and the item's name - never from the callee's file name or its own list of
    // name spellings here. A user library file called `mem.zrl` used to win this and the resulting
    // epoch exemption excused a use-after-free (third-pass item 1;
    // doc/spec/modular_compilation.md, probe 218_fake_mem_arena_spoof.zrl).
    fn is_arena_mark_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].arena_mark;
    }

    fn is_arena_reset_to_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].arena_reset_to;
    }

    fn is_buffer_external_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].buffer_external;
    }

    fn is_buffer_anchored_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].buffer_anchored;
    }

    fn is_unsafe_call(self: &ZirVerifier, fn_id: u32) -> bool {
        if fn_id as usize >= self.zil_module.functions.len() { return false; }
        return self.zil_module.functions[fn_id as usize].is_unsafe;
    }

    fn get_reset_to_exempt_epoch(
        self: &ZirVerifier,
        b: &ZirBlock,
        start_si: usize,
        tmp_local: u32,
        arena_base: u32,
        state: &ZirAnalysisState
    ) -> u32 {
        let mut i = start_si + 1 as usize;
        while i < b.statements.len {
            match b.statements[i] {
                ZirStmt.Let(_, rv, _) | ZirStmt.Assign(_, rv, _) => {
                    if let ZirRvalue.Call(fn_id, args) = rv {
                        if args.len >= 2 as usize
                            && args[0].base == tmp_local
                            && self.is_arena_reset_to_call(fn_id) {
                            let mark_local = args[1].base;
                            let mut resolved_mark = mark_local;
                            let mut j = start_si + 1 as usize;
                            while j < i {
                                match b.statements[j] {
                                    ZirStmt.Let(lid, m_rv, _) => {
                                        if lid == resolved_mark {
                                            if let ZirRvalue.Use(p) = m_rv {
                                                resolved_mark = p.base;
                                            }
                                        }
                                    },
                                    _ => {},
                                }
                                j = j + 1 as usize;
                            }
                            let mut mi = 0 as usize;
                            while mi < state.mark_infos.len() {
                                let info = &state.mark_infos[mi];
                                if info.mark_local == resolved_mark
                                    && info.arena_base == arena_base {
                                    return info.epoch;
                                }
                                mi = mi + 1 as usize;
                            }
                        }
                    }
                },
                _ => {},
            }
            i = i + 1 as usize;
        }
        return 0 as u32;
    }

    fn set_mark_info(
        self: &mut ZirVerifier,
        state: &mut ZirAnalysisState,
        mark_local: u32,
        arena_base: u32,
        epoch: u32
    ) {
        let mut i = 0 as usize;
        while i < state.mark_infos.len() {
            if state.mark_infos[i].mark_local == mark_local {
                state.mark_infos[i].arena_base = arena_base;
                state.mark_infos[i].epoch = epoch;
                return;
            }
            i = i + 1 as usize;
        }
        state.mark_infos.push(MarkInfo {
            mark_local: mark_local,
            arena_base: arena_base,
            epoch: epoch,
        });
    }

    fn remove_mark_info(self: &mut ZirVerifier, state: &mut ZirAnalysisState, mark_local: u32) {
        let mut i = 0 as usize;
        while i < state.mark_infos.len() {
            if state.mark_infos[i].mark_local == mark_local {
                state.mark_infos.remove(i);
                return;
            }
            i = i + 1 as usize;
        }
    }

    fn advance_container_mutation_epoch(
        self: &mut ZirVerifier,
        target_local: u32,
        state: &mut ZirAnalysisState
    ) {
        if target_local == 0 as u32 { return; }
        let mut affected = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        affected.push(target_local);

        let mut changed = true;
        while changed {
            changed = false;
            let mut i = 0 as usize;
            while i < state.borrows.len() {
                let b = &state.borrows[i];
                if b.is_mut {
                    let mut borrower_in = false;
                    let mut base_in = false;
                    let mut j = 0 as usize;
                    while j < affected.len() {
                        if affected[j] == b.borrower { borrower_in = true; }
                        if affected[j] == b.base.base { base_in = true; }
                        j = j + 1 as usize;
                    }
                    if borrower_in && !base_in && b.base.base != 0 as u32 {
                        affected.push(b.base.base);
                        changed = true;
                    }
                    if base_in && !borrower_in && b.borrower != 0 as u32 {
                        affected.push(b.borrower);
                        changed = true;
                    }
                }
                i = i + 1 as usize;
            }
        }

        let mut bi = 0 as usize;
        while bi < state.borrows.len() {
            let b = &mut state.borrows[bi];
            let mut aff = false;
            let mut j = 0 as usize;
            while j < affected.len() {
                if affected[j] == b.borrower {
                    aff = true;
                    break;
                }
                j = j + 1 as usize;
            }
            if aff {
                b.epoch = self.next_borrow_epoch;
            }
            bi = bi + 1 as usize;
        }
        self.next_borrow_epoch = self.next_borrow_epoch + 1 as u32;
    }

    fn check_borrow_creation(
        self: &mut ZirVerifier,
        place: &Place,
        is_mut: bool,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        borrower: u32,
        region: u32,
        exempt_epoch: u32
    ) {
        if place.base == 0 as u32 { return; }

        let p_st_idx = place.base as usize;
        let st = state.ownership[p_st_idx];
        if st == OWN_UNINIT {
            self.report_var_error(
                "cannot borrow uninitialized variable",
                place.base,
                "",
                span,
                locals
            );
            return;
        } else if st == OWN_MOVED {
            self.report_var_error("use of moved value", place.base, "", span, locals);
            return;
        } else if st == OWN_DROPPED {
            self.report_var_error("cannot borrow dropped value", place.base, "", span, locals);
            return;
        }

        if is_mut {
            if place.base != 0 as u32 && (place.base as usize) <= locals.len {
                let loc = &locals[place.base as usize - 1 as usize];
                if loc.is_capture_alias
                    && loc.is_copy
                    && !self.place_has_deref(place)
                    && (place.projections.len == 0 as usize || !self.is_pointer_like_type(loc.ty)) {
                    let mut msg = unsafe { ByteVec.new_raw(self.arena) };
                    msg.push_slice("the closure holds a copy of '");
                    msg.push_slice(self.intern_table.lookup(loc.name_id));
                    msg.push_slice(
                        "'; borrowing it mutably borrows only the copy; capture a '&mut' reference instead"
                    );
                    self.report_error(msg.as_slice(), span);
                    return;
                }
            }
            if self.writes_immutable_binding(place, locals) {
                self.report_var_error(
                    "cannot mutably borrow",
                    place.base,
                    "because it is immutable",
                    span,
                    locals
                );
                return;
            }

            // A `&mut` cannot be created by dereferencing a read-only pointer (`let r: &T =
            // &expr; &mut *r`, or the same one level deeper through a field, `&mut *h.r`) --
            // which is what a `&mut self` method call through a `&T` lowers to. Raw pointers
            // stay the documented unchecked escape hatch. Re-borrowing `r` itself (`&mut r`, no
            // projections) is a different, permitted concern handled by the conflict check below.
            if place.projections.len > 0 as usize {
                if self.place_last_deref_is_readonly(place, locals) {
                    self.report_var_error(
                        "cannot mutably borrow",
                        place.base,
                        self.readonly_reason(),
                        span,
                        locals
                    );
                    return;
                }
            }
        }

        // Conflict check
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            let b = &state.borrows[i];
            if self.borrow_counts(b, &*state, locals) && !b.release_only {
                if self.places_overlap(place, &b.base) {
                    let is_exempt = exempt_epoch != 0 as u32 && !b.is_mut && b.epoch < exempt_epoch;
                    if !is_exempt {
                        if is_mut && b.is_mut {
                            self.report_borrow_conflict(
                                "cannot mutably borrow",
                                place,
                                "more than once",
                                span,
                                &b.base,
                                b.span,
                                b.via,
                                locals
                            );
                        } else if is_mut {
                            self.report_borrow_conflict(
                                "cannot mutably borrow",
                                place,
                                "while it is already borrowed",
                                span,
                                &b.base,
                                b.span,
                                b.via,
                                locals
                            );
                        } else if b.is_mut {
                            self.report_borrow_conflict(
                                "cannot borrow",
                                place,
                                "while it is mutably borrowed",
                                span,
                                &b.base,
                                b.span,
                                b.via,
                                locals
                            );
                        }
                    }
                }
            }
            i = i + 1 as usize;
        }

        if is_mut {
            self.advance_container_mutation_epoch(place.base, state);
        }

        // The borrow was created by this `&`/`&mut` rvalue; that is the first route it travelled.
        let mut via = route_bit(ROUTE_RV_BASE + ROUTE_RV_REF);
        if is_mut { via = route_bit(ROUTE_RV_BASE + ROUTE_RV_REFMUT); }
        state.borrows.push(ActiveBorrow {
            base: *place,
            is_mut: is_mut,
            region: region,
            borrower: borrower,
            span: span,
            derived: false,
            direct: true,
            release_only: false,
            epoch: self.next_borrow_epoch,
            via: via,
        });
        // A borrow through an enum payload's address (a pattern binding through a reference,
        // `match e { Q.A(s) => .. }` with `e: &mut Q`) points into the enum the address was taken
        // from, but its place is rooted at the address temporary, which nothing writes. It is
        // recorded on that enum as well, so a write through `e` conflicts while `s` is live.
        // Only for a named borrower, a binding: the compiler's own address of a skipped part,
        // which the arm drops after moving another part out, would otherwise forbid that move.
        let root = self.enum_payload_borrow_root(place, state, locals);
        if root.base != 0 as u32 && !self.is_temp_local(borrower, locals) {
            state.borrows.push(ActiveBorrow {
                base: root,
                is_mut: is_mut,
                region: region,
                borrower: borrower,
                span: span,
                derived: false,
                direct: false,
                release_only: false,
                epoch: self.next_borrow_epoch,
                via: via,
            });
        }
        self.next_borrow_epoch = self.next_borrow_epoch + 1 as u32;
    }

    // The enum PLACE is a borrow of, when PLACE is `*t..` with `t` an enum payload address
    // (`t = EnumPayload(src)`): `*src` when `src` is a reference, else `src`, followed through
    // nested payloads. The whole enum stands for the payload part, which no projection names.
    // Base 0 when PLACE is not such a place. The result is always a copy in the scratch arena,
    // so it holds no borrow of PLACE, STATE or the verifier.
    #[borrows()]
    fn enum_payload_borrow_root(
        self: &mut ZirVerifier,
        place: &Place,
        state: &ZirAnalysisState,
        locals: [Local]
    ) -> Place {
        let mut cur = *place;
        let mut found = false;
        let mut depth = 0 as usize;
        while depth < 8 as usize {
            if cur.projections.len == 0 as usize || cur.projections[0].get_tag() != PROJ_DEREF {
                break;
            }
            let mut hit = false;
            let mut src = cur;
            let mut i = 0 as usize;
            while i < state.enum_aliases.len() {
                if state.enum_aliases[i].local_id == cur.base {
                    src = state.enum_aliases[i].source;
                    hit = true;
                    break;
                }
                i = i + 1 as usize;
            }
            if !hit || src.base == 0 as u32 { break; }
            let src_ty = self.get_place_type(&src, locals);
            let src_is_pointer = src_ty != 0 as u32
                && is_any_pointer_tag(self.type_decl_copy(src_ty).def.get_tag());
            cur = if src_is_pointer {
                self.place_in_arena(&src, true)
            } else {
                src
            };
            found = true;
            depth = depth + 1 as usize;
        }
        if !found {
            return Place { base: 0 as u32, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        return self.place_in_arena(&cur, false);
    }

    // PL, with one more `Deref` projection when DEREF, its projections copied into the verifier's
    // scratch arena, so the result does not point into the verifier.
    // SAFETY: the result is scratch-arena data, reset only once the verifier is gone.
    #[unsafe(borrows())]
    fn place_in_arena(self: &mut ZirVerifier, pl: &Place, deref: bool) -> Place {
        let new_len = if deref { pl.projections.len + 1 as usize } else { pl.projections.len };
        if new_len == 0 as usize {
            return Place { base: pl.base, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        let new_projs = unsafe {
            zoril_allocator_alloc(self.arena, (new_len * sizeof(Projection)) as u64)
        } as *mut Projection;
        unsafe {
            if pl.projections.len > 0 as usize {
                memcpy(
                    new_projs as *mut u8,
                    pl.projections.ptr as *u8,
                    (pl.projections.len * sizeof(Projection)) as u64
                );
            }
            if deref {
                *((new_projs as usize
                    + pl.projections.len
                        * sizeof(Projection)) as *mut Projection) = Projection.Deref;
            }
            return Place { base: pl.base, projections: @slice(new_projs, new_len) };
        }
    }

    // Checks the places RV reads: moved operands (MOVE) must be owned, and borrowed ones not
    // moved out. Exhaustive, so a new rvalue cannot go unchecked (tuple and array literals
    // once did, which let a moved value be used again).
    // exhaustive: every rvalue must decide how each of its operands is read (move vs read),
    // so a new construct cannot silently skip the ownership and mutability checks.
    fn check_rvalue_use(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        self.cur_rv = rv_bit(rv);
        match *rv {
            ZirRvalue.Use(p)
                | ZirRvalue.UnaryOp(_, p)
                | ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.Boxed(p) => {
                self.check_place_use(&p, true, span, state, locals);
            },
            ZirRvalue.BinaryOp(_, a, b) => {
                self.check_place_use(&a, true, span, state, locals);
                self.check_place_use(&b, true, span, state, locals);
            },
            ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.VariantCheck(p, _, _)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.ArrayRepeat(p, _, _) => {
                self.check_place_use(&p, false, span, state, locals);
            },
            ZirRvalue.Call(fn_id, args) => {
                self.check_places_moved(args, span, state, locals);
                self.check_call_releases(fn_id, args, span, state, locals, func);
                self.check_call_arg_mutability(fn_id, args, span, state, locals);
                self.check_call_stores_escapes(fn_id, args, span, state, locals, func);
            },
            ZirRvalue.CallPtr(f, args) => {
                self.check_place_use(&f, false, span, state, locals);
                self.check_places_moved(args, span, state, locals);
                self.check_call_ptr_releases(&f, args, span, state, locals, func);
                self.check_call_ptr_arg_mutability(&f, args, span, state, locals);
                self.check_call_ptr_stores(&f, args, span, state, locals, func);
            },
            ZirRvalue.StructLiteral(_, args)
                | ZirRvalue.Syscall(args)
                | ZirRvalue.Intrinsic(_, args) => {
                self.check_places_moved(args, span, state, locals);
            },
            ZirRvalue.Tuple(elems) | ZirRvalue.Array(_, elems) => {
                self.check_places_moved(elems, span, state, locals);
            },
            ZirRvalue.Cast(p, _) | ZirRvalue.PtrFromInt(p, _) => {
                // A cast moves out of a compiler temporary, and only reads a named value.
                let is_temp = p.projections.len == 0 as usize && self.is_temp_local(p.base, locals);
                self.check_place_use(&p, is_temp, span, state, locals);
            },
            ZirRvalue.Const(_, _)
                | ZirRvalue.Sizeof(_)
                | ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_)
                | ZirRvalue.GetEnv => {},
            ZirRvalue.FuncAddr(_, env_ptr) => {
                if env_ptr != 0 as u32 {
                    let env_pl = Place {
                        base: env_ptr,
                        projections: @slice(0 as *mut Projection, 0 as usize)
                    };
                    self.check_place_use(&env_pl, false, span, state, locals);
                }
            },
        }
    }

    fn check_places_moved(
        self: &mut ZirVerifier,
        places: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        for p in places { self.check_place_use(p, true, span, state, locals); }
    }

    fn check_places_consumed(
        self: &mut ZirVerifier,
        places: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        for p in places {
            if p.base == 0 as u32 || p.base > locals.len as u32 { continue; }
            let st = state.ownership[p.base as usize];
            if st == OWN_UNINIT {
                self.report_var_error("use of uninitialized variable", p.base, "", span, locals);
                continue;
            }
            if st == OWN_DROPPED {
                self.report_var_error("use of dropped value", p.base, "", span, locals);
                continue;
            }
            if st != OWN_MOVED && self.is_borrowed_by_other(p, state, locals) {
                self.report_var_error("cannot move borrowed value", p.base, "", span, locals);
                continue;
            }
            let loc = &locals[p.base as usize - 1 as usize];
            if loc.is_capture_alias && !loc.is_copy {
                self.report_error("cannot move out of a closure capture", span);
                continue;
            }
            if !loc.is_copy {
                state.ownership[p.base as usize] = OWN_MOVED;
                state.maybe_live[p.base as usize] = false;
            }
        }
    }

    pub fn verify(self: &mut ZirVerifier) {
        let mut i = 0 as usize;
        while i < self.module.funcs.len {
            let func = self.module.funcs[i];
            self.verify_function(&func);
            i = i + 1 as usize;
        }
    }

    fn is_never_type(self: &ZirVerifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        if ty_id as usize > self.zil_module.types.len() { return false; }
        let p_ty = &self.zil_module.types[ty_id as usize - 1 as usize];
        if p_ty.def.get_tag() == ILTYPE_PRIMITIVE {
            return p_ty.def.get_Primitive().get_tag() == ILPRIM_NEVER;
        }
        return false;
    }

    fn func_returns_never(self: &ZirVerifier, func_idx: u32) -> bool {
        if func_idx as usize >= self.zil_module.functions.len() { return false; }
        let p_func = &self.zil_module.functions[func_idx as usize];
        return self.is_never_type(p_func.ret_ty);
    }

    fn call_ptr_returns_never(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> bool {
        let fn_ty = self.get_place_type(pl, locals);
        if fn_ty == 0 as u32 { return false; }
        let p_ty = self.get_type_decl(fn_ty);
        let tag = p_ty.def.get_tag();
        let mut actual_fn_ty = 0 as u32;
        if tag == ILTYPE_FN {
            actual_fn_ty = fn_ty;
        } else if is_any_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(fn_ty);
            if inner != 0 as u32 {
                let p_inner = self.get_type_decl(inner);
                if p_inner.def.get_tag() == ILTYPE_FN {
                    actual_fn_ty = inner;
                }
            }
        }
        if actual_fn_ty != 0 as u32 {
            let p_fty = self.get_type_decl(actual_fn_ty);
            let f_def = p_fty.def.get_Fn();
            return self.is_never_type(f_def.ret_ty);
        }
        return false;
    }

    // Whether STMT never returns: a call to a function returning `!` (directly, through a
    // pointer, or bound by a `let` of type `!`).
    fn stmt_terminates_path(self: &mut ZirVerifier, stmt: &ZirStmt, locals: [Local]) -> bool {
        match *stmt {
            ZirStmt.Let(local_id, rv, _) => {
                for l in locals {
                    if l.id == local_id && self.is_never_type(l.ty) { return true; }
                }
                return self.rv_never_returns(&rv, locals);
            },
            ZirStmt.Assign(_, rv, _) => { return self.rv_never_returns(&rv, locals); },
            _ => { return false; },
        }
    }

    fn rv_never_returns(self: &mut ZirVerifier, rv: &ZirRvalue, locals: [Local]) -> bool {
        return match *rv {
            ZirRvalue.Call(fn_id, _) => self.func_returns_never(fn_id),
            ZirRvalue.CallPtr(f, _) => self.call_ptr_returns_never(&f, locals),
            _ => false,
        };
    }

    fn block_terminates_path(self: &mut ZirVerifier, b: &ZirBlock, locals: [Local]) -> bool {
        let mut si = 0 as usize;
        while si < b.statements.len {
            if self.stmt_terminates_path(&b.statements[si], locals) {
                return true;
            }
            si = si + 1 as usize;
        }
        return false;
    }

    // ---- liveness (non-lexical borrows) ------------------------------------------------

    fn is_live(self: &ZirVerifier, id: u32) -> bool {
        if self.cur_live as usize == 0 as usize { return true; }
        let w = (id as usize) / 64 as usize;
        if w >= self.live_words { return true; }
        let word = unsafe { *((self.cur_live as usize + w * 8) as *u64) };
        return ((word >> ((id as u64) % 64 as u64)) & 1 as u64) != 0 as u64;
    }

    fn bits_set(self: &ZirVerifier, set: *mut u64, id: u32) {
        let w = (id as usize) / 64 as usize;
        if id == 0 as u32 || w >= self.live_words { return; }
        let p = (set as usize + w * 8) as *mut u64;
        unsafe { *p = *p | ((1 as u64) << ((id as u64) % 64 as u64)); }
    }

    fn bits_clear(self: &ZirVerifier, set: *mut u64, id: u32) {
        let w = (id as usize) / 64 as usize;
        if id == 0 as u32 || w >= self.live_words { return; }
        let p = (set as usize + w * 8) as *mut u64;
        unsafe { *p = *p & !((1 as u64) << ((id as u64) % 64 as u64)); }
    }

    fn place_uses(self: &ZirVerifier, pl: &Place, set: *mut u64) {
        self.bits_set(set, pl.base);
        let mut i = 0 as usize;
        while i < pl.projections.len {
            if pl.projections[i].get_tag() == PROJ_INDEX {
                self.bits_set(set, pl.projections[i].get_Index());
            }
            i = i + 1 as usize;
        }
    }

    fn places_uses(self: &ZirVerifier, pls: [Place], set: *mut u64) {
        let mut i = 0 as usize;
        while i < pls.len { self.place_uses(&pls[i], set); i = i + 1 as usize; }
    }

    // exhaustive: liveness must count every operand a construct reads; a new construct cannot
    // silently keep an operand's borrow alive or let it die early.
    fn rv_uses(self: &ZirVerifier, rv: &ZirRvalue, set: *mut u64) {
        match *rv {
            ZirRvalue.Use(p)
                | ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.UnaryOp(_, p)
                | ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.Cast(p, _)
                | ZirRvalue.VariantCheck(p, _, _)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.ArrayRepeat(p, _, _)
                | ZirRvalue.PtrFromInt(p, _) => { self.place_uses(&p, set); },
            ZirRvalue.BinaryOp(_, a, b) => {
                self.place_uses(&a, set);
                self.place_uses(&b, set);
            },
            ZirRvalue.Call(_, args)
                | ZirRvalue.StructLiteral(_, args)
                | ZirRvalue.Syscall(args)
                | ZirRvalue.Intrinsic(_, args)
                | ZirRvalue.Tuple(args)
                | ZirRvalue.Array(_, args) => { self.places_uses(args, set); },
            ZirRvalue.CallPtr(f, args) => {
                self.place_uses(&f, set);
                self.places_uses(args, set);
            },
            ZirRvalue.Boxed(p) => { self.place_uses(&p, set); },
            ZirRvalue.Const(_, _)
                | ZirRvalue.Sizeof(_)
                | ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_)
                | ZirRvalue.GetEnv => {},
            ZirRvalue.FuncAddr(_, env_ptr) => {
                if env_ptr != 0 as u32 { self.bits_set(set, env_ptr); }
            },
        }
    }

    // Transfer one statement backwards: live-before = (live-after - def) + uses.
    // Liveness backwards through ST: what it defines is dead before it, what it reads is live.
    // exhaustive: every statement must state what it defines and what it makes live.
    fn stmt_live_transfer(self: &ZirVerifier, st: &ZirStmt, set: *mut u64) {
        match *st {
            ZirStmt.Let(id, rv, _) => {
                self.bits_clear(set, id);
                self.rv_uses(&rv, set);
            },
            ZirStmt.Assign(pl, rv, _) => {
                if pl.projections.len == 0 as usize {
                    self.bits_clear(set, pl.base);
                } else {
                    self.place_uses(&pl, set);
                }
                self.rv_uses(&rv, set);
            },
            ZirStmt.Drop(pl, _) | ZirStmt.DropIfLive(pl, _) => { self.place_uses(&pl, set); },
            ZirStmt.Intrinsic(name_id, args, _) => {
                if self.intern_table.lookup(name_id) != "consume_place" {
                    self.places_uses(args, set);
                }
            },
            ZirStmt.EndBorrow(_, _) => {},
        }
    }

    // exhaustive: every terminator must state which operands it reads.
    fn term_uses(self: &ZirVerifier, term: &ZirTerminator, set: *mut u64) {
        match *term {
            ZirTerminator.Branch(cond, _, _) => { self.place_uses(&cond, set); },
            ZirTerminator.Ret(p) => { self.place_uses(&p, set); },
            ZirTerminator.Jmp(_) | ZirTerminator.Unreachable => {},
        }
    }

    fn live_out_of(self: &ZirVerifier, block: usize) -> *mut u64 {
        return (self.live_out as usize + block * self.live_words * 8) as *mut u64;
    }

    // live-after of the last statement: the terminator's uses plus the block's live-out.
    fn block_tail_live(self: &ZirVerifier, b: &ZirBlock, block: usize, set: *mut u64) {
        unsafe {
            memcpy(set as *mut u8, self.live_out_of(block) as *u8, (self.live_words * 8) as u64);
        }
        self.term_uses(&b.terminator, set);
    }

    // Backward dataflow to a fixpoint: live-out(b) = union of live-in over b's successors.
    fn compute_liveness(self: &mut ZirVerifier, func: &ZirFunction, locals_len: usize) {
        let blocks_len = (*func).blocks.len;
        self.live_words = locals_len / 64 as usize + 1 as usize;
        let bytes = blocks_len * self.live_words * 8;
        self.live_out = unsafe { zoril_allocator_alloc(self.arena, bytes as u64) } as *mut u64;
        let live_in = unsafe { zoril_allocator_alloc(self.arena, bytes as u64) } as *mut u64;
        unsafe {
            memset(self.live_out as *mut u8, 0, bytes as u64);
            memset(live_in as *mut u8, 0, bytes as u64);
        }
        let tmp = unsafe {
            zoril_allocator_alloc(self.arena, (self.live_words * 8) as u64)
        } as *mut u64;
        let mut changed = true;
        let mut iter = 0 as usize;
        while changed && iter < 200 as usize {
            changed = false;
            let mut bi = blocks_len;
            while bi > 0 as usize {
                bi = bi - 1 as usize;
                let b = &(*func).blocks[bi];
                // live-out = union of the successors' live-in
                let out = self.live_out_of(bi);
                // The block's successors (NO_SUCC when it has fewer than two).
                let (s1, s2) = match b.terminator {
                    ZirTerminator.Jmp(t) => (t as usize, NO_SUCC),
                    ZirTerminator.Branch(_, t1, t2) => (t1 as usize, t2 as usize),
                    ZirTerminator.Ret(_) | ZirTerminator.Unreachable => (NO_SUCC, NO_SUCC),
                };
                let mut w = 0 as usize;
                while w < self.live_words {
                    let mut acc = unsafe { *((out as usize + w * 8) as *u64) };
                    if s1 < blocks_len {
                        acc = acc
                            | unsafe {
                                *((live_in as usize + (s1 * self.live_words + w) * 8) as *u64)
                            };
                    }
                    if s2 < blocks_len {
                        acc = acc
                            | unsafe {
                                *((live_in as usize + (s2 * self.live_words + w) * 8) as *u64)
                            };
                    }
                    unsafe { *((out as usize + w * 8) as *mut u64) = acc; }
                    w = w + 1 as usize;
                }
                // live-in = transfer backwards through the statements
                self.block_tail_live(b, bi, tmp);
                let mut si = b.statements.len;
                while si > 0 as usize {
                    si = si - 1 as usize;
                    self.stmt_live_transfer(&b.statements[si], tmp);
                }
                let inb = (live_in as usize + bi * self.live_words * 8) as *mut u64;
                if !unsafe { is_mem_eq(inb as *u8, tmp as *u8, (self.live_words * 8) as u64) } {
                    unsafe { memcpy(inb as *mut u8, tmp as *u8, (self.live_words * 8) as u64); }
                    changed = true;
                }
            }
            iter = iter + 1 as usize;
        }
    }

    // Rows for the current block: row k (k < n) = live after statement k; row n = the
    // block's live-out, for its terminator.
    fn compute_block_rows(self: &mut ZirVerifier, b: &ZirBlock, block: usize) {
        let n = b.statements.len;
        let wbytes = self.live_words * 8;
        let need = (n + 1 as usize) * self.live_words;
        if need > self.live_rows_cap {
            self.live_rows = unsafe {
                zoril_allocator_alloc(self.arena, (need * 8) as u64)
            } as *mut u64;
            self.live_rows_cap = need;
        }
        unsafe {
            memcpy(self.live_row(n) as *mut u8, self.live_out_of(block) as *u8, wbytes as u64);
        }
        if n == 0 as usize { return; }
        self.block_tail_live(b, block, self.live_row(n - 1 as usize));
        let mut k = n - 1 as usize;
        while k > 0 as usize {
            // live after statement k-1 = live before statement k
            unsafe {
                memcpy(
                    self.live_row(k - 1 as usize) as *mut u8,
                    self.live_row(k) as *u8,
                    wbytes as u64
                );
            }
            self.stmt_live_transfer(&b.statements[k], self.live_row(k - 1 as usize));
            k = k - 1 as usize;
        }
    }

    fn live_row(self: &ZirVerifier, k: usize) -> *mut u64 {
        return (self.live_rows as usize + k * self.live_words * 8) as *mut u64;
    }

    fn verify_function(self: &mut ZirVerifier, func: &ZirFunction) {
        self.next_borrow_epoch = 1 as u32;
        self.reject_via = 0 as u64;
        self.cur_rv = 0 as u64;
        self.cur_stmt = 0 as u64;
        self.cur_term = 0 as u64;
        self.cur_blocks = (*func).blocks;
        let locals_len = (*func).locals.len;
        let blocks_len = (*func).blocks.len;
        if blocks_len == 0 as usize { return; }
        let locals = (*func).locals;

        let block_entry_states = unsafe {
            @slice(
                zoril_allocator_alloc(self.arena, blocks_len * 8) as *mut *mut ZirAnalysisState,
                blocks_len
            )
        };
        let block_exit_states = unsafe {
            @slice(
                zoril_allocator_alloc(self.arena, blocks_len * 8) as *mut *mut ZirAnalysisState,
                blocks_len
            )
        };
        for k in 0 as usize..blocks_len {
            block_entry_states[k] = 0 as *mut ZirAnalysisState;
            block_exit_states[k] = 0 as *mut ZirAnalysisState;
        }
        block_entry_states[0] = self.initial_state(func);
        let preds = self.predecessors(func);
        self.compute_liveness(func, locals_len);

        // Each block's entry state is the merge of its predecessors' exit states, iterated to
        // a fixed point with no errors reported.
        self.reporting_enabled = false;
        let mut changed = true;
        let mut iter = 0 as usize;
        while changed && iter < 100 as usize {
            changed = false;
            for bj in 0 as usize..blocks_len {
                if bj > 0 as usize {
                    let new_entry = self.merge_states(
                        bj,
                        &preds[bj],
                        &block_exit_states,
                        locals_len
                    );
                    // A block with no live predecessor has no entry. Counting null to null as
                    // a change would never reach the fixed point (all 100 iterations, ~40s on
                    // the compiler's own source).
                    if new_entry as usize != 0 as usize {
                        let old_entry = block_entry_states[bj];
                        if old_entry as usize == 0 as usize
                            || !self.states_equal(new_entry, old_entry, locals_len) {
                            block_entry_states[bj] = new_entry;
                            changed = true;
                        }
                    }
                }
                let exit = self.run_block(func, bj, block_entry_states[bj]);
                if exit as usize != 0 as usize {
                    let old_exit = block_exit_states[bj];
                    if old_exit as usize == 0 as usize
                        || !self.states_equal(exit, old_exit, locals_len) {
                        block_exit_states[bj] = exit;
                        changed = true;
                    }
                }
            }
            iter = iter + 1 as usize;
        }

        // The reporting pass below is sound only from a fixed point; a borrow or move fact
        // that a later pass would reach must not go unchecked, so a stop at the cap is a bug.
        if changed {
            let mut msg = unsafe { ByteVec.new_raw(self.arena) };
            msg.push_slice("ZirVerifier: the fixed point of `");
            msg.push_slice(self.intern_table.lookup((*func).name));
            msg.push_slice("` did not converge within the pass cap");
            ICE(msg.as_slice());
        }

        // Then once more from the fixed point, reporting.
        self.reporting_enabled = true;
        for bk in 0 as usize..blocks_len { self.run_block(func, bk, block_entry_states[bk]); }
        self.cur_live = 0 as *mut u64;
    }

    // The state at function entry: the parameters owned, everything else uninitialized.
    fn initial_state(self: &mut ZirVerifier, func: &ZirFunction) -> *mut ZirAnalysisState {
        let n = (*func).locals.len + 1 as usize;
        let own = unsafe { @slice(zoril_allocator_alloc(self.arena, n) as *mut u8, n) };
        let ml = unsafe { @slice(zoril_allocator_alloc(self.arena, n) as *mut bool, n) };
        unsafe {
            memset(own.ptr as *mut u8, 0, n as u64);
            memset(ml.ptr as *mut u8, 0, n as u64);
        }
        for p in (*func).params { own[p.id as usize] = OWN_OWNED; }
        let state = unsafe {
            zoril_allocator_alloc(self.arena, sizeof(ZirAnalysisState))
        } as *mut ZirAnalysisState;
        unsafe {
            *state = ZirAnalysisState {
                ownership: own,
                maybe_live: ml,
                borrows: unsafe { Vec::<ActiveBorrow>.new_in_raw(self.arena) },
                enum_aliases: unsafe { Vec::<EnumPayloadAlias>.new_in_raw(self.arena) },
                mark_infos: unsafe { Vec::<MarkInfo>.new_in_raw(self.arena) },
            };
        }
        return state;
    }

    // Each block's predecessors: the blocks whose terminator can reach it. Scratch-arena lists, so
    // holding the result does not keep the verifier borrowed.
    // SAFETY: the result is scratch-arena data, reset only once the verifier is gone.
    #[unsafe(borrows())]
    fn predecessors(self: &mut ZirVerifier, func: &ZirFunction) -> [mut Vec<u32>] {
        let n = (*func).blocks.len;
        let preds = unsafe {
            @slice(zoril_allocator_alloc(self.arena, n * sizeof(Vec<u32>)) as *mut Vec<u32>, n)
        };
        for k in 0 as usize..n { preds[k] = unsafe { Vec::<u32>.new_in_raw(self.arena) }; }
        for bi in 0 as usize..n {
            let b = &(*func).blocks[bi];
            if self.block_terminates_path(b, (*func).locals) { continue; }
            match b.terminator {
                ZirTerminator.Jmp(t) => {
                    if (t as usize) < n { preds[t as usize].push(bi as u32); }
                },
                ZirTerminator.Branch(_, t1, t2) => {
                    if (t1 as usize) < n { preds[t1 as usize].push(bi as u32); }
                    if (t2 as usize) < n { preds[t2 as usize].push(bi as u32); }
                },
                ZirTerminator.Ret(_) | ZirTerminator.Unreachable => {},
            }
        }
        return preds;
    }

    // Checks block BI from (a copy of) state ENTRY: its exit state, or null when it has no
    // entry or a statement ends its path.
    fn run_block(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        bi: usize,
        entry: *mut ZirAnalysisState
    ) -> *mut ZirAnalysisState {
        if entry as usize == 0 as usize { return 0 as *mut ZirAnalysisState; }
        let locals = (*func).locals;
        let state = unsafe { (*entry).clone(self.arena, locals.len) };
        let b = &(*func).blocks[bi];
        self.compute_block_rows(b, bi);
        for si in 0 as usize..b.statements.len {
            self.cur_live = self.live_row(si);
            self.next_borrow_epoch = (bi as u32 + 1 as u32) * 100000 as u32
                + (si as u32 + 1 as u32) * 50 as u32;
            self.check_stmt(&b.statements[si], unsafe { &mut *state }, locals, b, si, func);
            if self.stmt_terminates_path(&b.statements[si], locals) {
                return 0 as *mut ZirAnalysisState;
            }
        }
        self.cur_live = self.live_row(b.statements.len);
        self.next_borrow_epoch = (bi as u32 + 1 as u32) * 100000 as u32
            + (b.statements.len as u32 + 1 as u32) * 50 as u32;
        self.check_terminator(&b.terminator, unsafe { &mut *state }, locals, func);
        return state;
    }

    fn push_borrow(self: &ZirVerifier, state: &mut ZirAnalysisState, nb: ActiveBorrow) {
        let mut k = 0 as usize;
        while k < state.borrows.len() {
            if state.borrows[k].borrower == nb.borrower
                && self.places_equal(&state.borrows[k].base, &nb.base) {
                let mut merged = state.borrows[k];
                merged.is_mut = merged.is_mut || nb.is_mut;
                merged.derived = merged.derived && nb.derived;
                merged.direct = merged.direct || nb.direct;
                merged.release_only = merged.release_only && nb.release_only;
                merged.via = merged.via | nb.via;
                if nb.epoch > merged.epoch { merged.epoch = nb.epoch; }
                state.borrows[k] = merged;
                return;
            }
            k = k + 1 as usize;
        }
        state.borrows.push(nb);
    }

    fn propagate_borrow(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        state: &mut ZirAnalysisState,
        dest_id: u32,
        locals: [Local]
    ) {
        self.propagate_borrow_direct(rv, state, dest_id, locals, true);
    }

    fn propagate_borrow_direct(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        state: &mut ZirAnalysisState,
        dest_id: u32,
        locals: [Local],
        allow_direct: bool
    ) {
        if dest_id != 0 as u32 {
            let mut li = 0 as usize;
            while li < locals.len {
                if locals[li].id == dest_id {
                    if locals[li].ty != 0 as u32
                        && is_raw_pointer_tag(
                            self.zil_module.types[locals[li].ty as usize - 1 as usize].def.get_tag()
                        ) {
                        return;
                    }
                    break;
                }
                li = li + 1 as usize;
            }
        }

        let src_id = match *rv {
            ZirRvalue.Use(p) => if self.place_holds_reference(&p, locals) {
                p.base
            } else {
                0 as u32
            },
            _ => 0 as u32,
        };
        // A bare local-to-local copy of the reference itself keeps pointing at the same
        // referent; reading a field, element or deref out of a value does not.
        let direct_copy = allow_direct
            && match *rv {
                ZirRvalue.Use(p) => p.projections.len == 0 as usize,
                _ => false,
            };

        // A borrow follows a value only into something that can hold a reference:
        // `let y = *r` or `let n = v.as_slice()[i]` copies a value out; it does not keep
        // the borrowed place borrowed. (Matters now that borrows end at their last use.)
        if src_id == 0 as u32 || !self.local_holds_reference(dest_id, locals) {
            return;
        }
        // Every borrow the source holds follows it, not just the first: a value built from
        // two references (`(&a, &b)`, or `&r.f`, which borrows `r` and what `r` borrows)
        // keeps both places borrowed. Propagating an existing borrow to a new borrower does
        // not create a new one, so each keeps its original span ("taken here").
        let n = state.borrows.len();
        let mut i = 0 as usize;
        while i < n {
            let b = state.borrows[i];
            if b.borrower == src_id {
                self.push_borrow(
                    state,
                    ActiveBorrow {
                        base: b.base,
                        is_mut: b.is_mut,
                        region: b.region,
                        borrower: dest_id,
                        span: b.span,
                        derived: b.derived,
                        direct: direct_copy && b.direct,
                        release_only: b.release_only || dest_id == OUTSIDE_BORROWER,
                        epoch: self.next_borrow_epoch,
                        via: b.via | rv_bit(rv),
                    }
                );
            }
            i = i + 1 as usize;
        }
    }

    fn local_holds_reference(self: &mut ZirVerifier, id: u32, locals: [Local]) -> bool {
        if id == OUTSIDE_BORROWER { return true; }
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == id {
                // A raw pointer local holds no reference: the type says so, since
                // `type_holds_reference` refuses `RawPtr`/`RawPtrMut` the way it refuses an integer.
                return self.type_holds_reference(locals[li].ty);
            }
            li = li + 1 as usize;
        }
        return false;
    }

    fn place_holds_reference(self: &mut ZirVerifier, p: &Place, locals: [Local]) -> bool {
        if p.projections.len == 0 as usize {
            return self.local_holds_reference(p.base, locals);
        }
        let ty = self.get_place_type(p, locals);
        if ty == 0 as u32 { return false; }
        return self.type_holds_reference(ty);
    }

    fn place_type_owns_storage(self: &mut ZirVerifier, p: &Place, locals: [Local]) -> bool {
        if p.projections.len == 0 as usize {
            return self.local_type_owns_storage(p.base, locals);
        }
        let ty = self.get_place_type(p, locals);
        if ty == 0 as u32 { return false; }
        return self.type_owns_storage(ty, 0 as usize);
    }

    fn is_temp_local(self: &ZirVerifier, id: u32, locals: [Local]) -> bool {
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == id {
                return locals[li].kind == LOCAL_KIND_TMP || locals[li].name_id == 0 as u32;
            }
            li = li + 1 as usize;
        }
        return false;
    }

    // Does this borrow constrain the borrowed place right now? Its borrower must still own
    // it, and an inherited borrow counts only once a named local holds it. The frame's outside
    // holder is live until the frame returns (§3.1, holder two).
    fn borrow_counts(
        self: &ZirVerifier,
        b: &ActiveBorrow,
        state: &ZirAnalysisState,
        locals: [Local]
    ) -> bool {
        if b.borrower == OUTSIDE_BORROWER { return true; }
        if state.ownership[b.borrower as usize] != OWN_OWNED { return false; }
        if !self.is_live(b.borrower) { return false; }
        return !(b.derived && self.is_temp_local(b.borrower, locals));
    }

    // A borrow of a place reached through a local (`&r.f`, a pattern binding through `&e`)
    // points into what that local borrows, explicitly dereferenced or not (a field access
    // auto-derefs a reference): DEST keeps those borrows after the local itself dies.
    // Without it, `if let E.A(x) = &e { e = E.B; **x }` read a freed payload. The copies keep
    // each borrow's own flag, like every other value built from an operand (inherit_borrows_keeping):
    // the pointer still points at the place, so a borrow of a local's own storage still counts at
    // that local's scope end - forcing `derived` here is what let a closure keep a reference into a
    // dead local (see inherit_borrows_captured).
    fn inherit_reborrow(
        self: &mut ZirVerifier,
        p: &Place,
        dest: u32,
        via: u64,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        self.inherit_borrows_keeping(p.base, dest, via, state);
    }

    // The same, for a closure's environment: the captures' borrows are what the closure keeps. One
    // exception, and it is what makes a by-value capture work: a borrow whose *base* is a compiler
    // temporary is the environment's own storage (`&env`, the tuple build_closure_env makes), which
    // lives in the enclosing frame - its lifetime is the escape analysis's business
    // (`returns_local_stack` / `stashes_param_mask`, src/summary_pass.zrl), and counting it here
    // rejected every closure that captures anything by value
    // (tests/language/closures/capturing_closure_if_expr.zrl). Recording a reference *inside* the
    // environment (base = the local it came from) is what must keep its flag.
    fn inherit_borrows_captured(
        self: &mut ZirVerifier,
        src: u32,
        dest: u32,
        via: u64,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if src == 0 as u32 || dest == 0 as u32 || src == dest { return; }
        let n = state.borrows.len();
        let mut bi = 0 as usize;
        while bi < n {
            if state.borrows[bi].borrower == src {
                let b = state.borrows[bi];
                self.push_borrow(
                    state,
                    ActiveBorrow {
                        base: b.base,
                        is_mut: b.is_mut,
                        region: b.region,
                        borrower: dest,
                        span: b.span,
                        // The environment's own storage is the closure's, not the caller's: keeping
                        // the flag means a closure whose environment ends at an inner scope is
                        // rejected while the closure is still live (Unified Solution D). A block-tail
                        // closure has its environment promoted to the enclosing scope instead
                        // (lower_block, promote_local_to_parent_scope).
                        derived: b.derived,
                        direct: false,
                        release_only: b.release_only || dest == OUTSIDE_BORROWER,
                        epoch: self.next_borrow_epoch,
                        via: b.via | via,
                    }
                );
            }
            bi = bi + 1 as usize;
        }
    }

    // DEST gets a copy of every borrow SRC holds (SRC's value now lives on in DEST).
    fn inherit_borrows(
        self: &mut ZirVerifier,
        src: u32,
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if src == 0 as u32 || dest == 0 as u32 || src == dest { return; }
        let n = state.borrows.len();
        let mut bi = 0 as usize;
        while bi < n {
            if state.borrows[bi].borrower == src {
                let b = state.borrows[bi];
                self.push_borrow(
                    state,
                    ActiveBorrow {
                        base: b.base,
                        is_mut: b.is_mut,
                        region: b.region,
                        borrower: dest,
                        span: b.span,
                        derived: true,
                        direct: false,
                        release_only: b.release_only || dest == OUTSIDE_BORROWER,
                        epoch: self.next_borrow_epoch,
                        via: b.via,
                    }
                );
            }
            bi = bi + 1 as usize;
        }
    }

    // The same, for a value *built* from SRC (a field of a struct or tuple literal, an array
    // element, a variant payload): each copy keeps the flag the borrow it copies already had. A
    // value that holds the operand keeps pointing wherever the operand pointed - `Holder { r: &x }`
    // holds `x`'s own storage (`&x` is a fresh borrow, derived=false), while `Holder { r: v.get(0) }`
    // holds what the call derived (derived=true, still exempt at `v`'s scope end). Forcing `true`
    // here, as the construction cases used to, read the first as the second: a field holding `&x`
    // outlived `x` (exit 7 reading its dead slot) because a derived borrow is exempt for a local
    // without `Drop`.
    fn inherit_borrows_keeping(
        self: &mut ZirVerifier,
        src: u32,
        dest: u32,
        via: u64,
        state: &mut ZirAnalysisState
    ) {
        if src == 0 as u32 || dest == 0 as u32 || src == dest { return; }
        let n = state.borrows.len();
        let mut bi = 0 as usize;
        while bi < n {
            if state.borrows[bi].borrower == src {
                let b = state.borrows[bi];
                self.push_borrow(
                    state,
                    ActiveBorrow {
                        base: b.base,
                        is_mut: b.is_mut,
                        region: b.region,
                        borrower: dest,
                        span: b.span,
                        derived: b.derived,
                        direct: false,
                        release_only: b.release_only || dest == OUTSIDE_BORROWER,
                        epoch: self.next_borrow_epoch,
                        via: b.via | via,
                    }
                );
            }
            bi = bi + 1 as usize;
        }
    }

    // DERIVED=false records the inherited borrow as one of the local's own storage, which
    // check_scope_end_borrowed counts without asking for the local's `Drop` (see the call case in
    // inherit_rv_borrows for when a call's result should be read that way). Any non-derived borrow
    // of an underlying local's own stack storage retains derived: false.
    fn inherit_borrows_as(
        self: &mut ZirVerifier,
        src: u32,
        dest: u32,
        via: u64,
        state: &mut ZirAnalysisState,
        as_derived: bool,
        locals: [Local]
    ) {
        if src == 0 as u32 || dest == 0 as u32 || src == dest { return; }
        let n = state.borrows.len();
        let mut bi = 0 as usize;
        while bi < n {
            if state.borrows[bi].borrower == src {
                let b = state.borrows[bi];
                // Whether SRC's value points at what it borrows, rather than at something it
                // was built from. That is recorded when the borrow is created and carried by a
                // bare copy, so it does not have to be guessed from the types.
                let is_direct = b.direct;
                let derived = if !as_derived {
                    false
                } else if is_direct || b.derived {
                    true
                } else if !b.derived && self.borrowed_storage_is_local(&b.base, locals) {
                    false
                } else {
                    true
                };
                self.push_borrow(
                    state,
                    ActiveBorrow {
                        base: b.base,
                        is_mut: b.is_mut,
                        region: b.region,
                        borrower: dest,
                        span: b.span,
                        derived: derived,
                        direct: false,
                        release_only: b.release_only || dest == OUTSIDE_BORROWER,
                        epoch: self.next_borrow_epoch,
                        via: b.via | via,
                    }
                );
            }
            bi = bi + 1 as usize;
        }
    }

    // A call, struct, tuple, array or enum value built from borrowed operands holds those
    // borrows, when the destination can hold a reference (a reference, a slice, or a struct, enum
    // or tuple containing one). For a call, the inputs are the callee's `ret_ties`: the parameters
    // named by `#[borrows(..)]`, or by default `self` if it is a reference, otherwise every
    // reference/pointer parameter; a call through a pointer inherits from all of them. Lexical,
    // like every borrow here.
    // exhaustive: every rvalue must say which of its operands' borrows its result inherits.
    fn inherit_rv_borrows(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if dest == 0 as u32 || !self.local_holds_reference(dest, locals) { return; }
        match *rv {
            ZirRvalue.Call(fn_id, args) => {
                let mut ties = 0xffffffffffffffff as u64;
                let mut storage = 0 as u64;
                // A callee whose storage masks are unknown (`storage_known` false: an import whose
                // `.zri` carried no storage keys, the fail-open case the audit found) is read as
                // handing back a pointer into *each* argument's own storage. That is the strict
                // side: the borrow stays live lexically, so `check_scope_end_borrowed` applies it
                // without the `Drop` exemption instead of skipping it.
                let mut storage_unknown = true;
                if (fn_id as usize) < self.zil_module.functions.len() {
                    let callee = &self.zil_module.functions[fn_id as usize];
                    // A callee in a recursive cycle not yet finished (still being lowered, this
                    // body included, or waiting for the cycle's fixpoint) has no final ties:
                    // os_infer_ties adds its body's ties only then. With no declaration, its
                    // result may point into any argument.
                    let open = callee.os_depth != 0 as u32 || callee.os_in_cycle;
                    ties = if open && !callee.has_borrows {
                        0xffffffffffffffff as u64
                    } else {
                        callee.ret_ties
                    };
                    storage = self.zil_module.functions[fn_id as usize].ret_storage;
                    storage_unknown = !self.zil_module.functions[fn_id as usize].storage_known;
                }
                for i in 0 as usize..args.len {
                    if i >= 64 as usize || ((ties >> (i as u64)) & 1 as u64) != 0 as u64 {
                        // Does the callee hand back a pointer into this argument's own storage
                        // (`id(&x)`), or one built out of what the argument references
                        // (`v.as_slice()` returns a slice of the buffer it points at)? The summary
                        // says: the `.zri` field for an import, the ZIR-level reading of the body
                        // for a function of this module. Unknown reads as the argument's own
                        // storage - the strict side (doc/SAFETY.md §4.4).
                        // A bit for a slice parameter says the result points into the bytes the
                        // slice covers; the whole-program walk keeps those in the contents mask, so
                        // an import is read the same way: derived, not the header's own storage
                        // (`"a,b".split_raw(..)` holds pointers into the literal's bytes, not into
                        // the temporary that holds its header).
                        let own_storage = storage_unknown
                            || (i < 64 as usize
                                && ((storage >> (i as u64)) & 1 as u64) != 0 as u64
                                && !self.callee_param_is_slice(fn_id, i));
                        self.inherit_borrows_as(
                            args[i].base,
                            dest,
                            rv_bit(rv),
                            state,
                            !own_storage,
                            locals
                        );
                    }
                }
            },
            // A call through a value (`let f = cb; f(&x)`) has no summary, so its result may point
            // into the callee value's own captured environment or *any* argument's own storage.
            // Own storage, not derived: reading it as derived exempted the borrow at the local's
            // scope end and `y = f(&x)` outlived `x`; the callee value's environment is what a
            // closure returning a capture hands back (probe 208).
            ZirRvalue.CallPtr(f, args) => {
                self.inherit_borrows_as(f.base, dest, rv_bit(rv), state, false, locals);
                for a in args {
                    self.inherit_borrows_as(a.base, dest, rv_bit(rv), state, false, locals);
                }
            },
            // A value built from operands holds what they hold: a struct, tuple or array literal,
            // a variant payload, a box, a repeated array or a cast. The copy keeps each operand
            // borrow's own flag (see inherit_borrows_keeping).
            ZirRvalue.StructLiteral(_, args)
                | ZirRvalue.Array(_, args) => {
                for a in args { self.inherit_borrows_keeping(a.base, dest, rv_bit(rv), state); }
            },
            ZirRvalue.Tuple(elems) => {
                for e in elems { self.inherit_borrows_keeping(e.base, dest, rv_bit(rv), state); }
            },
            ZirRvalue.EnumVariant(_, _, payload) | ZirRvalue.EnumPayload(payload, _, _) => {
                self.inherit_borrows_keeping(payload.base, dest, rv_bit(rv), state);
            },
            ZirRvalue.Boxed(p) | ZirRvalue.ArrayRepeat(p, _, _) => {
                self.inherit_borrows_keeping(p.base, dest, rv_bit(rv), state);
            },
            // A cast to a *raw* pointer ends the borrow: a raw pointer carries no lifetime, and
            // the cast is the documented escape hatch (`&mut x as *mut T` keeps `x` usable,
            // tests/language/memory/raw_ptr_element_assignment.zrl). Any other cast (to a
            // reference or an aggregate) carries the operand's borrows.
            ZirRvalue.Cast(p, target) => {
                if target == 0 as u32
                    || !is_raw_pointer_tag(self.get_type_decl(target).def.get_tag()) {
                    self.inherit_borrows_keeping(p.base, dest, rv_bit(rv), state);
                }
            },
            ZirRvalue.PtrFromInt(_, _) => {},
            ZirRvalue.Syscall(args) | ZirRvalue.Intrinsic(_, args) => {
                for a in args {
                    self.inherit_borrows_as(a.base, dest, rv_bit(rv), state, false, locals);
                }
            },
            ZirRvalue.FuncAddr(_, env_ptr) => {
                if env_ptr != 0 as u32 {
                    self.inherit_borrows_captured(env_ptr, dest, rv_bit(rv), state, locals);
                }
            },
            // A borrow of a place (`&p`) is recorded by check_let/check_assign, and a copy of a
            // reference by propagate_borrow; nothing is inherited here.
            ZirRvalue.Use(_)
                | ZirRvalue.Ref(_, _)
                | ZirRvalue.RefMut(_, _)
                // Scalars: no reference result.
                | ZirRvalue.Const(_, _)
                | ZirRvalue.Sizeof(_)
                | ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_)
                | ZirRvalue.GetEnv
                | ZirRvalue.UnaryOp(_, _)
                | ZirRvalue.BinaryOp(_, _, _) => {},
            // A variant test reads only the discriminant, and the same scrutinee temporary is
            // read again by the `EnumPayload` that binds the payload: its borrows must survive
            // this statement (they end at the payload extraction or the scope).
            ZirRvalue.VariantCheck(_, _, _) => {},
        }
    }

    // A compiler temporary lives for the statement that uses it, so once used, its borrows
    // end (any that matter were passed on to the destination first). Named locals keep
    // theirs until they go out of scope.
    fn end_temp_borrows(
        self: &mut ZirVerifier,
        base: u32,
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if base == 0 as u32 || base == dest || !self.is_temp_local(base, locals) { return; }
        let mut bi = 0 as usize;
        while bi < state.borrows.len() {
            if state.borrows[bi].borrower == base {
                let _ = state.borrows.remove(bi);
            } else {
                bi = bi + 1 as usize;
            }
        }
    }

    fn end_places_temp_borrows(
        self: &mut ZirVerifier,
        places: [Place],
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        let mut i = 0 as usize;
        while i < places.len {
            self.end_temp_borrows(places[i].base, dest, state, locals);
            i = i + 1 as usize;
        }
    }

    // Borrows held by the compiler temporaries RV consumes end with this statement (the value
    // that inherited them keeps them).
    // exhaustive: every rvalue must say which temporary operands stop holding borrows.
    fn end_rv_temp_borrows(
        self: &mut ZirVerifier,
        rv: &ZirRvalue,
        dest: u32,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        match *rv {
            ZirRvalue.Use(p)
                | ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.Boxed(p)
                | ZirRvalue.ArrayRepeat(p, _, _)
                | ZirRvalue.Cast(p, _)
                | ZirRvalue.PtrFromInt(p, _)
                | ZirRvalue.UnaryOp(_, p) => {
                self.end_temp_borrows(p.base, dest, state, locals);
            },
            ZirRvalue.BinaryOp(_, a, b) => {
                self.end_temp_borrows(a.base, dest, state, locals);
                self.end_temp_borrows(b.base, dest, state, locals);
            },
            ZirRvalue.Call(_, args)
                | ZirRvalue.StructLiteral(_, args)
                | ZirRvalue.Tuple(args)
                | ZirRvalue.Array(_, args)
                | ZirRvalue.Syscall(args)
                | ZirRvalue.Intrinsic(_, args) => {
                self.end_places_temp_borrows(args, dest, state, locals);
            },
            ZirRvalue.CallPtr(f, args) => {
                self.end_temp_borrows(f.base, dest, state, locals);
                self.end_places_temp_borrows(args, dest, state, locals);
            },
            ZirRvalue.FuncAddr(_, env_ptr) => {
                if env_ptr != 0 as u32 {
                    self.end_temp_borrows(env_ptr, dest, state, locals);
                }
            },
            ZirRvalue.Const(_, _)
                | ZirRvalue.Sizeof(_)
                | ZirRvalue.StringConst(_)
                | ZirRvalue.GlobalAddr(_)
                | ZirRvalue.GetEnv
                // Reads only the discriminant; the same scrutinee temporary is read again by
                // the `EnumPayload` that binds the payload, so its borrows must survive this
                // statement.
                | ZirRvalue.VariantCheck(_, _, _) => {},
        }
    }

    // exhaustive: every statement must state its ownership and borrow effect.
    fn check_stmt(
        self: &mut ZirVerifier,
        stmt: &ZirStmt,
        state: &mut ZirAnalysisState,
        locals: [Local],
        b: &ZirBlock,
        si: usize,
        func: &ZirFunction
    ) {
        self.cur_rv = 0 as u64;
        self.cur_stmt = stmt_bit(stmt);
        self.cur_term = 0 as u64;
        match *stmt {
            ZirStmt.Let(local_id, rv, span) => {
                self.check_let(local_id, &rv, span, state, locals, b, si, func);
            },
            ZirStmt.Assign(place, rv, span) => {
                self.check_assign(&place, &rv, span, state, locals, b, si, func);
            },
            ZirStmt.Drop(place, span) => { self.check_drop(&place, false, span, state, locals); },
            ZirStmt.DropIfLive(place, span) => {
                self.check_drop(&place, true, span, state, locals);
            },
            ZirStmt.Intrinsic(name_id, args, span) => {
                let name = self.intern_table.lookup(name_id);
                if name == "explicit_drop" {
                    self.check_explicit_drop(args, span, state, locals);
                } else if name == "consume_place" {
                    self.check_places_consumed(args, span, state, locals);
                } else {
                    self.check_places_moved(args, span, state, locals);
                }
            },
            ZirStmt.EndBorrow(borrower, span) => {
                // The local's storage ends here (lowering emits this for every local whose scope
                // exits), so nothing that outlives the scope may still borrow it.
                self.check_scope_end_borrowed(borrower, span, state, locals);
                self.end_borrow_of(borrower, state);
            },
        }
    }

    // `let local = rv`: a reference makes a borrow; anything else is checked as a use, and
    // borrows and ownership pass to the new local.
    fn check_let(
        self: &mut ZirVerifier,
        local_id: u32,
        rv: &ZirRvalue,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        b: &ZirBlock,
        si: usize,
        func: &ZirFunction
    ) {
        self.cur_rv = rv_bit(rv);
        match *rv {
            ZirRvalue.Ref(p, region) => {
                self.check_borrow_creation(
                    &p,
                    false,
                    span,
                    state,
                    locals,
                    local_id,
                    region,
                    0 as u32
                );
                self.inherit_reborrow(&p, local_id, rv_bit(rv), state, locals);
            },
            ZirRvalue.RefMut(p, region) => {
                let exempt_epoch = self.get_reset_to_exempt_epoch(b, si, local_id, p.base, state);
                self.check_borrow_creation(
                    &p,
                    true,
                    span,
                    state,
                    locals,
                    local_id,
                    region,
                    exempt_epoch
                );
                self.inherit_reborrow(&p, local_id, rv_bit(rv), state, locals);
            },
            _ => {
                let is_cap_alias = local_id != 0 as u32
                    && (local_id as usize) <= locals.len
                    && locals[local_id as usize - 1 as usize].is_capture_alias;
                if is_cap_alias {
                    if let ZirRvalue.Use(p) = *rv {
                        self.cur_rv = rv_bit(rv);
                        self.check_place_use(&p, false, span, state, locals);
                    } else {
                        self.check_rvalue_use(rv, span, state, locals, func);
                    }
                } else {
                    self.check_rvalue_use(rv, span, state, locals, func);
                }
                // A closure's environment owns what it captures: an owning value (a collection, a
                // `Box`, an `Arena`) is moved into it, so the outer binding cannot be used or
                // dropped afterwards (probe 298). The environment is the tuple the lowerer marks
                // with the closure's span.
                if let ZirRvalue.Tuple(args) = *rv {
                    if self.is_closure_env(local_id, locals) {
                        let mut ai = 0 as usize;
                        while ai < args.len {
                            let a = args[ai];
                            if a.base != 0 as u32
                                && (a.base as usize) <= locals.len
                                && self.local_type_owns_storage(a.base, locals) {
                                state.ownership[a.base as usize] = OWN_MOVED;
                            }
                            ai = ai + 1 as usize;
                        }
                    }
                }
                if let ZirRvalue.Call(fn_id, args) = *rv {
                    if self.is_arena_mark_call(fn_id) && args.len >= 1 as usize {
                        let arena_base = self.get_borrow_base(args[0].base, state);
                        self.set_mark_info(state, local_id, arena_base, self.next_borrow_epoch);
                    }
                }
                if let ZirRvalue.Use(p) = *rv {
                    let mut mi = 0 as usize;
                    while mi < state.mark_infos.len() {
                        if state.mark_infos[mi].mark_local == p.base {
                            let info = state.mark_infos[mi];
                            self.set_mark_info(state, local_id, info.arena_base, info.epoch);
                            break;
                        }
                        mi = mi + 1 as usize;
                    }
                }
                // The local points into the enum it was taken from: later moves through it
                // are checked against borrows of that place.
                if let ZirRvalue.EnumPayload(source, _, _) = *rv {
                    if local_id != 0 as u32 {
                        state.enum_aliases.push(EnumPayloadAlias {
                            local_id: local_id,
                            source: source
                        });
                    }
                }
            },
        }
        self.inherit_rv_borrows(rv, local_id, state, locals);
        self.propagate_borrow(rv, state, local_id, locals);
        self.end_rv_temp_borrows(rv, local_id, state, locals);
        state.ownership[local_id as usize] = OWN_OWNED;
        state.maybe_live[local_id as usize] = false;
    }

    fn check_assign(
        self: &mut ZirVerifier,
        place: &Place,
        rv: &ZirRvalue,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        b: &ZirBlock,
        si: usize,
        func: &ZirFunction
    ) {
        self.cur_rv = rv_bit(rv);
        if place.base != 0 as u32 && (place.base as usize) <= locals.len {
            let loc = &locals[place.base as usize - 1 as usize];
            if loc.is_capture_alias
                && loc.is_copy
                && !self.place_has_deref(place)
                && (place.projections.len == 0 as usize || !self.is_pointer_like_type(loc.ty)) {
                let mut msg = unsafe { ByteVec.new_raw(self.arena) };
                msg.push_slice("the closure holds a copy of '");
                msg.push_slice(self.intern_table.lookup(loc.name_id));
                msg.push_slice(
                    "'; assigning to it changes only the copy; capture a '&mut' reference instead"
                );
                self.report_error(msg.as_slice(), span);
                return;
            }
        }
        if self.writes_immutable_binding(place, locals) {
            self.report_var_error(
                "cannot assign to",
                place.base,
                "because it is immutable",
                span,
                locals
            );
            return;
        }
        // Writing through a read-only pointer anywhere along the place is rejected: `&T` means
        // read-only, whether the `&T` is the base (`(*r).x = 5`) or a field on the way
        // (`h.r.x = 5`). Raw pointers stay the unchecked escape hatch.
        if place.projections.len > 0 as usize {
            if self.place_last_deref_is_readonly(place, locals) {
                self.report_var_error(
                    "cannot assign to",
                    place.base,
                    self.readonly_reason(),
                    span,
                    locals
                );
                return;
            }
            let st = state.ownership[place.base as usize];
            if st == OWN_UNINIT {
                self.report_var_error(
                    "use of uninitialized variable",
                    place.base,
                    "",
                    span,
                    locals
                );
                return;
            }
            if st == OWN_MOVED {
                self.report_var_error("use of moved value", place.base, "", span, locals);
                return;
            }
            // `@drop(b); *b = 5;` would write into freed storage (check_place_use rejects the read).
            if st == OWN_DROPPED {
                self.report_var_error("use of dropped value", place.base, "", span, locals);
                return;
            }
        }
        // The old value's borrow, if it was a borrower, ends - but only when the place being
        // assigned *is* the binding. A write through a reference (`*rm = 5`, `rm.f = v`) has
        // `place.base == rm`, and the borrow that would be ended there is the one `rm` itself holds
        // (`&mut x`), which is still live. Ending it let a later `&x` pass the conflict scan while
        // `rm` went on being used: the shared borrow then observed writes made through the `&mut`
        // (with a `Drop` value that is a use after free - a segfault in safe code).
        let borrower_id = place.base;
        // Only when the place being assigned *is* the binding: a write through a reference
        // (`*rm = 5`, `rm.f = v`) has `place.base == rm`, and the borrow that ends there is the one
        // `rm` itself holds (`&mut x`), which is still live. Ending it let a later `&x` pass the
        // conflict scan while `rm` went on being used, so the shared borrow observed writes made
        // through the `&mut` - with a `Drop` value, a use after free.
        let assigning_the_binding = place.projections.len == 0 as usize;
        if assigning_the_binding {
            self.end_borrow_of(borrower_id, state);
        }
        self.advance_container_mutation_epoch(place.base, state);
        match *rv {
            ZirRvalue.Ref(p, region) => {
                self.check_borrow_creation(
                    &p,
                    false,
                    span,
                    state,
                    locals,
                    borrower_id,
                    region,
                    0 as u32
                );
                self.inherit_reborrow(&p, borrower_id, rv_bit(rv), state, locals);
            },
            ZirRvalue.RefMut(p, region) => {
                let exempt_epoch = self.get_reset_to_exempt_epoch(
                    b,
                    si,
                    borrower_id,
                    p.base,
                    state
                );
                self.check_borrow_creation(
                    &p,
                    true,
                    span,
                    state,
                    locals,
                    borrower_id,
                    region,
                    exempt_epoch
                );
                self.inherit_reborrow(&p, borrower_id, rv_bit(rv), state, locals);
            },
            _ => {
                self.check_rvalue_use(rv, span, state, locals, func);
                if place.projections.len == 0 as usize {
                    let mut handled_mark = false;
                    if let ZirRvalue.Call(fn_id, args) = *rv {
                        if self.is_arena_mark_call(fn_id) && args.len >= 1 as usize {
                            let arena_base = self.get_borrow_base(args[0].base, state);
                            self.set_mark_info(
                                state,
                                borrower_id,
                                arena_base,
                                self.next_borrow_epoch
                            );
                            handled_mark = true;
                        }
                    }
                    if let ZirRvalue.Use(p) = *rv {
                        let mut mi = 0 as usize;
                        while mi < state.mark_infos.len() {
                            if state.mark_infos[mi].mark_local == p.base {
                                let info = state.mark_infos[mi];
                                self.set_mark_info(state, borrower_id, info.arena_base, info.epoch);
                                handled_mark = true;
                                break;
                            }
                            mi = mi + 1 as usize;
                        }
                    }
                    if !handled_mark {
                        self.remove_mark_info(state, borrower_id);
                    }
                    self.inherit_rv_borrows(rv, borrower_id, state, locals);
                } else if !self.place_writes_through_pointer(place, locals) {
                    // A write into a field, element or tuple slot of the local (`x.f = ..`,
                    // `x[i] = ..`, `x.0 = ..`) stores the value in x: x holds what the value
                    // holds. A write through a pointer gives the borrow to every local in the
                    // destination's reach (holder one, strict tier) and to the outside holder when
                    // the reach leaves the frame (holder two, release tier; §3.1).
                    if self.place_holds_reference(place, locals) {
                        self.inherit_rv_borrows(rv, borrower_id, state, locals);
                    }
                } else if self.place_holds_reference(place, locals) {
                    self.apply_through_pointer_borrows(place, rv, state, locals, true);
                }
            },
        }
        if self.place_outlives_frame(func, locals, place) {
            if self.check_rvalue_escapes_frame("cannot store", rv, span, state, locals, func) {
                return;
            }
        }
        // The place itself must not be borrowed. A release-tier borrow conflicts only when the
        // assignment overwrites a value whose type drops on overwrite (an Arena, a Box, or a Drop
        // impl; overwriting a Vec does not run Drop or free its old buffer) (§3.1, item 2).
        let overwrites_owner = self.local_type_has_drop_place(place, locals);
        for i in 0 as usize..state.borrows.len() {
            let b = &state.borrows[i];
            if self.borrow_counts(b, &*state, locals)
                && self.places_overlap(&b.base, place)
                && (!b.release_only
                    || (overwrites_owner && self.place_overwrites_borrow(place, &b.base))) {
                self.report_borrow_conflict(
                    "cannot assign to",
                    place,
                    "because it is borrowed",
                    span,
                    &b.base,
                    b.span,
                    b.via,
                    locals
                );
                return;
            }
        }
        if place.projections.len == 0 as usize {
            self.propagate_borrow(rv, state, place.base, locals);
            state.ownership[place.base as usize] = OWN_OWNED;
            state.maybe_live[place.base as usize] = false;
        } else if !self.place_writes_through_pointer(place, locals) {
            // The borrows of a copied reference join x's: x keeps each borrow it already holds
            // and the old value's borrow is not ended, because the other fields are still live.
            // The copy lands in a field or slot, not in x itself, so it is not a direct borrow.
            if self.place_holds_reference(place, locals) {
                self.propagate_borrow_direct(rv, state, place.base, locals, false);
            }
        } else if self.place_holds_reference(place, locals) {
            self.apply_through_pointer_borrows(place, rv, state, locals, false);
        }
        self.end_rv_temp_borrows(rv, place.base, state, locals);
    }

    fn place_overwrites_borrow(
        self: &ZirVerifier,
        assign_place: &Place,
        borrow_base: &Place
    ) -> bool {
        if assign_place.base != borrow_base.base { return false; }
        let mut i1 = 0 as usize;
        let mut i2 = 0 as usize;
        while i1 < assign_place.projections.len {
            let pr1 = &assign_place.projections[i1];
            let t1 = pr1.get_tag();
            if t1 == PROJ_DEREF {
                i1 = i1 + 1 as usize;
                continue;
            }
            while i2 < borrow_base.projections.len
                && borrow_base.projections[i2].get_tag() == PROJ_DEREF {
                i2 = i2 + 1 as usize;
            }
            if i2 >= borrow_base.projections.len { return false; }
            let pr2 = &borrow_base.projections[i2];
            if pr2.get_tag() != t1 { return false; }
            if t1 == PROJ_FIELD && pr1.get_Field() != pr2.get_Field() { return false; }
            if t1 == PROJ_TUPLEINDEX && pr1.get_TupleIndex() != pr2.get_TupleIndex() {
                return false;
            }
            i1 = i1 + 1 as usize;
            i2 = i2 + 1 as usize;
        }
        return true;
    }

    // Holders one and two (§3.1, item 1) for a write through a pointer: each `Frame(L)` in PLACE's
    // destination reach receives RV's borrows under the strict tier, and any external origin
    // (`Param`, `Static`, `Raw`, `Unknown`) gives them to the frame's outside holder under the
    // release tier.
    fn apply_through_pointer_borrows(
        self: &mut ZirVerifier,
        place: &Place,
        rv: &ZirRvalue,
        state: &mut ZirAnalysisState,
        locals: [Local],
        is_inherit: bool
    ) {
        if self.origins as usize == 0 as usize { return; }
        let c: &mut OriginSets = unsafe { &mut *self.origins };
        let dm = os_t(c, OS_T_DM);
        let td = os_t(c, OS_T_D);
        os_clear(c, dm);
        os_clear(c, td);
        os_addr(c, self.zil_module, self.intern_table, locals, place, dm);
        os_dest_reach(c, self.zil_module, self.intern_table, locals, dm, td);
        let nl = c.nl;
        let ext = os_external(c, td);
        let mut id = 1 as usize;
        while id < nl {
            if os_has_frame(unsafe { &*self.origins }, td, id) {
                if is_inherit {
                    self.inherit_rv_borrows(rv, id as u32, state, locals);
                } else {
                    self.propagate_borrow_direct(rv, state, id as u32, locals, false);
                }
            }
            id = id + 1 as usize;
        }
        if ext {
            if is_inherit {
                self.inherit_rv_borrows(rv, OUTSIDE_BORROWER, state, locals);
            } else {
                self.propagate_borrow_direct(rv, state, OUTSIDE_BORROWER, locals, false);
            }
        }
    }

    // A scope-exit drop (IF_LIVE: guarded by a runtime drop flag, so a value already moved or
    // dropped on this path is fine). Linear resources (fd, ioring) must be closed, not dropped.
    fn check_drop(
        self: &mut ZirVerifier,
        place: &Place,
        if_live: bool,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if place.base == 0 as u32 || place.base > locals.len as u32 { return; }
        let loc = &locals[place.base as usize - 1 as usize];
        if loc.is_capture_alias { return; }
        let idx = place.base as usize;
        let st = state.ownership[idx];
        if st == OWN_UNINIT || st == OWN_DROPPED {
            if !if_live {
                self.report_var_error(
                    "cannot drop value",
                    place.base,
                    "that is not owned",
                    span,
                    locals
                );
            }
            return;
        }
        // Still owned on some path into this drop: not closed on every path (`if c { close(f); }`).
        if st == OWN_MOVED && state.maybe_live[idx] {
            let ty = self.get_place_type(place, locals);
            if ty != 0 as u32 && self.type_holds_linear(ty) {
                self.report_var_error(
                    "linear resource",
                    place.base,
                    "is not closed on every path",
                    span,
                    locals
                );
            }
        }
        if st == OWN_OWNED { self.check_drop_not_linear(place, span, locals); }
        // Only the binding's own drop is recorded on the local. A drop of a *projected* place -
        // `*rm = a` drops the old `*rm` before storing - is a drop of the referent, which is not a
        // local and cannot be named here. Recording it against `rm` marked the pointer local dropped,
        // and `borrow_counts` stops counting a borrow whose borrower is not owned, so the live `&mut`
        // went invisible and the right-hand side's read of the same place passed the conflict scan:
        // the value was moved out of itself, and with an owning type that is a use after free (the
        // arena form exits 139).
        let dropping_the_binding = place.projections.len == 0 as usize;
        if dropping_the_binding {
            state.ownership[idx] = OWN_DROPPED;
            state.maybe_live[idx] = false;
        }
    }

    fn check_drop_not_linear(self: &mut ZirVerifier, place: &Place, span: Span, locals: [Local]) {
        let ty_id = self.get_place_type(place, locals);
        if ty_id == 0 as u32 { return; }
        if !self.is_linear_tag(ty_id) && self.type_holds_linear(ty_id) {
            // A struct, tuple or enum holding an fd: dropping it would drop the fd.
            self.report_var_error(
                "value",
                place.base,
                "holds a linear resource (fd or ioring) that must be explicitly closed, not dropped",
                span,
                locals
            );
        }
        let ty_tag = self.get_type_decl(ty_id).def.get_tag();
        if ty_tag != ILTYPE_FD && ty_tag != ILTYPE_IORING { return; }
        let mut name_id = 0 as u32;
        for l in locals { if l.id == place.base { name_id = l.name_id; } }
        let mut msg: &mut ByteVec = unsafe { ByteVec.new_raw(self.arena) };
        msg.push_slice("linear resource");
        if name_id != 0 as u32 {
            msg.push_slice(" '");
            msg.push_slice(self.intern_table.lookup(name_id));
            msg.push_slice("'");
        }
        msg.push_slice(if ty_tag == ILTYPE_FD { " (type fd)" } else { " (type ioring)" });
        msg.push_slice(" must be explicitly closed, not dropped");
        self.report_error(msg.as_slice(), span);
    }

    // The user's `@drop(x)` (lowering emits this marker before it): unlike a scope-exit drop,
    // the value must be definitely live here.
    fn check_explicit_drop(
        self: &mut ZirVerifier,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if args.len != 1 as usize || args[0].base == 0 as u32 || args[0].base > locals.len as u32 {
            return;
        }
        let loc = &locals[args[0].base as usize - 1 as usize];
        if loc.is_capture_alias && args[0].projections.len == 0 as usize {
            self.report_error("cannot move out of a closure capture", span);
            return;
        }
        let drop_st = state.ownership[args[0].base as usize];
        if drop_st == OWN_MOVED {
            self.report_var_error(
                "cannot drop value",
                args[0].base,
                "that may have been moved",
                span,
                locals
            );
        } else if drop_st == OWN_DROPPED {
            self.report_var_error(
                "cannot drop value",
                args[0].base,
                "that is already dropped",
                span,
                locals
            );
        }
        // Dropping a value a live reference points into frees what the reference reads (`@drop(b)`
        // then `*r`), the same escape a scope end reports; the explicit form needs it here because
        // no EndBorrow runs at an intrinsic.
        let mut bi = 0 as usize;
        while bi < state.borrows.len() {
            let b = &state.borrows[bi];
            if b.borrower != args[0].base
                && self.borrow_counts(b, state, locals)
                && self.places_overlap(&args[0], &b.base) {
                self.report_var_error(
                    "cannot drop value",
                    args[0].base,
                    "while it is still borrowed",
                    span,
                    locals
                );
                return;
            }
            bi = bi + 1 as usize;
        }
    }

    fn end_borrow_of(self: &mut ZirVerifier, borrower: u32, state: &mut ZirAnalysisState) {
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            if state.borrows[i].borrower == borrower {
                state.borrows.remove(i);
            } else {
                i = i + 1 as usize;
            }
        }
    }

    // Whether the storage a borrow is rooted at is the local's own, as opposed to storage
    // behind a pointer or reference, which belongs to whoever allocated it and may outlive the
    // local. `&x` and `&x.field` borrow the local's storage; a `Box` deref is storage the local
    // owns and whose `Drop` frees it, so it counts; a deref of a pointer, reference or slice
    // (`&*p`, `&*self.current_func`) does not, however many field steps come first.
    fn borrowed_storage_is_local(
        self: &mut ZirVerifier,
        borrowed: &Place,
        locals: [Local]
    ) -> bool {
        let mut curr_ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == borrowed.base {
                curr_ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if curr_ty == 0 as u32 { return false; }
        // A reference, pointer or slice local owns nothing behind it: `&*s.b` through an `&S`
        // points into the caller's storage, not this local's. The first projection (or an
        // auto-deref `s.b`) goes through the pointer, so nothing beyond it is this local's.
        let base_tag = self.get_type_decl(curr_ty).def.get_tag();
        if borrowed.projections.len > 0 as usize
            && (is_any_pointer_tag(base_tag) || base_tag == ILTYPE_SLICE) {
            return false;
        }
        for proj in borrowed.projections {
            match *proj {
                Projection.Deref => {
                    let d_tag = self.get_type_decl(curr_ty).def.get_tag();
                    if d_tag != ILTYPE_BOXED && d_tag != ILTYPE_BOXEDMUT { return false; }
                    curr_ty = self.get_ptr_inner_type(curr_ty);
                },
                Projection.Field(name) => {
                    curr_ty = self.get_field_type(curr_ty, self.get_field_index(curr_ty, name));
                },
                Projection.TupleIndex(idx) => {
                    curr_ty = self.get_tuple_elem_type(curr_ty, idx);
                },
                Projection.Index(_) => {
                    curr_ty = self.get_slice_element_type(curr_ty);
                },
            }
        }
        return true;
    }

    // Whether ending LOCAL_ID's scope releases storage it owns: true for a type with a `Drop`
    // impl (an `Arena` handle unmaps its region, a `Box` frees its pointee) - *including* one
    // reached through a struct, enum, tuple, array or `Box` field, since a value whose field
    // frees storage frees storage when it goes out of scope. A `Vec` frees nothing, so the
    // buffer a slice into it points at outlives the `Vec` itself.
    fn local_type_has_drop(self: &mut ZirVerifier, local_id: u32, locals: [Local]) -> bool {
        let mut ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == local_id {
                ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if ty == 0 as u32 { return false; }
        return self.type_has_drop(ty, 0 as usize);
    }

    // As `type_holds_linear`, for `Drop`: a user type with its own `Drop` impl, or one whose
    // struct, enum, tuple, array or `Box` field has one. Reading only the local's own type made a
    // struct holding an `Arena` read as "frees nothing", so a derived borrow outliving it was
    // accepted and read freed memory (probe 166).
    //
    // Past the recursion limit the answer is *unknown*, which must read as "it does free
    // storage": "frees nothing" is what exempts a derived borrow at the local's scope end, so a
    // `false` there leaves the borrow live and reads the region a `Drop` freed (a value holding
    // an `Arena` nine struct levels down, exit 139, probe 175). `ty_id == 0` stays false: that is
    // the absent type, not a deep one. A recursive type is over-approximated, which never removes
    // a rejection.
    fn type_has_drop(self: &mut ZirVerifier, ty_id: u32, depth: usize) -> bool {
        // (`past_limit_drop`: a name of its own so the mutation harness can revert this answer on its
        // own, as it does the one above for the reference question.)
        let past_limit_drop = depth > 8 as usize;
        if past_limit_drop { return true; }
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.type_decl_copy(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_TUPLE {
            let elems = p_ty.def.get_Tuple();
            let mut i = 0 as usize;
            while i < elems.len {
                if self.type_has_drop(elems[i], depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
            return false;
        }
        if tag == ILTYPE_ARRAY {
            return self.type_has_drop(p_ty.def.get_Array().element, depth + 1 as usize);
        }
        if tag == ILTYPE_BOXED {
            return self.type_has_drop(p_ty.def.get_Boxed(), depth + 1 as usize);
        }
        if tag == ILTYPE_BOXEDMUT {
            return self.type_has_drop(p_ty.def.get_BoxedMut(), depth + 1 as usize);
        }
        if tag != ILTYPE_USER { return false; }
        if self.has_drop_impl(ty_id) { return true; }
        let user_id = p_ty.def.get_User().id;
        if user_id == 0xffffffff as u32 || user_id as usize >= self.zil_module.typedefs.len() {
            return false;
        }
        let p_def = self.zil_module.typedefs[user_id as usize];
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            let fields = p_def.get_Struct().fields;
            let mut i = 0 as usize;
            while i < fields.len {
                if self.type_has_drop(fields[i].ty, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            let variants = p_def.get_Enum().variants;
            let mut i = 0 as usize;
            while i < variants.len {
                if self.type_has_drop(variants[i].payload, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        }
        return false;
    }

    // A local's storage ends here (lowering emits `EndBorrow` for every local whose scope
    // exits): if anything that outlives the scope still borrows it, the borrower would point at
    // dead storage — "does not live long enough". `borrow_counts` skips borrows whose borrower
    // is dead, moved or a compiler temporary, so this rejects only a live named borrower.
    //
    // A borrow a call or method derived (`v.as_slice()`, `Vec::new_in(&a)`) points wherever that
    // result points, which for a local whose type frees nothing (a `Vec` over an arena buffer)
    // is storage that outlives the local, so those need LOCAL_ID's own `Drop` to count.
    fn check_scope_end_borrowed(
        self: &mut ZirVerifier,
        local_id: u32,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local]
    ) {
        if local_id == 0 as u32 { return; }
        let place = Place {
            base: local_id,
            projections: @slice(0 as *mut Projection, 0 as usize)
        };
        let mut i = 0 as usize;
        while i < state.borrows.len() {
            let b = &state.borrows[i];
            if b.borrower != local_id
                && self.borrow_counts(b, state, locals)
                && self.places_overlap(&place, &b.base)
                && self.borrowed_storage_is_local(&b.base, locals)
                && ((!b.release_only && !b.derived) || self.local_type_has_drop(local_id, locals)) {
                self.report_borrow_conflict(
                    "cannot let",
                    &place,
                    "go out of scope while it is still borrowed",
                    span,
                    &b.base,
                    b.span,
                    b.via,
                    locals
                );
                return;
            }
            i = i + 1 as usize;
        }
    }

    // The unifying store rule:
    // A store is rejected when the value stored carries a borrow of frame-owned storage
    // (a collection, a box, an arena, or a closure's owned capture) and the destination outlives the frame
    // (a pointer or reference parameter, a captured &mut, another capture, or a global).
    //
    // This applies both to direct assignments (`*dst = val`, `dst.field = val`) where
    // `place_outlives_frame` holds, and to calls (`callee(dst, val)`) where callee
    // storage summaries indicate a value passed via one argument is stored into a target
    // that outlives the caller's frame (including loads and derefs through reference parameters).
    fn check_borrow_escapes_frame(
        self: &mut ZirVerifier,
        action: [u8],
        borrower_local: u32,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) -> bool {
        return self.check_borrow_escapes_frame_depth(
            action,
            borrower_local,
            span,
            state,
            locals,
            func,
            0 as usize,
            false
        );
    }

    fn os_local_storage_external(self: &ZirVerifier, id: u32) -> bool {
        if self.origins as usize == 0 as usize || id == 0 as u32 { return false; }
        let c: &OriginSets = unsafe { &*self.origins };
        if (id as usize) >= c.nl { return false; }
        let s = c.nl + id as usize;
        if os_has_frame(c, s, id as usize) { return false; }
        return os_external(c, s);
    }

    fn local_type_has_drop_place(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> bool {
        let ty = self.get_place_type(pl, locals);
        return self.type_has_drop_or_box(ty, 0 as usize);
    }

    fn type_has_drop_or_box(self: &mut ZirVerifier, ty: u32, depth: usize) -> bool {
        if depth > 8 as usize { return true; }
        if ty == 0 as u32 || (ty as usize) > self.zil_module.types.len() { return false; }
        let p_ty = self.type_decl_copy(ty);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT { return true; }
        if self.has_drop_impl(ty) { return true; }
        if tag == ILTYPE_TUPLE {
            let elems = p_ty.def.get_Tuple();
            for e in elems {
                if self.type_has_drop_or_box(*e, depth + 1 as usize) { return true; }
            }
            return false;
        }
        if tag == ILTYPE_ARRAY {
            return self.type_has_drop_or_box(p_ty.def.get_Array().element, depth + 1 as usize);
        }
        if tag != ILTYPE_USER { return false; }
        let uid = p_ty.def.get_User().id;
        if uid == 0xffffffff as u32 || (uid as usize) >= self.zil_module.typedefs.len() {
            return false;
        }
        let p_def = self.zil_module.typedefs[uid as usize];
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            for f in p_def.get_Struct().fields {
                if self.type_has_drop_or_box(f.ty, depth + 1 as usize) { return true; }
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            for v in p_def.get_Enum().variants {
                if self.type_has_drop_or_box(v.payload, depth + 1 as usize) { return true; }
            }
        }
        return false;
    }

    fn check_borrow_escapes_frame_depth(
        self: &mut ZirVerifier,
        action: [u8],
        borrower_local: u32,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction,
        depth: usize,
        via_release: bool
    ) -> bool {
        if borrower_local == 0 as u32 || depth > 8 as usize { return false; }
        let mut vi = 0 as usize;
        while vi < state.borrows.len() {
            let b = &state.borrows[vi];
            if b.borrower == borrower_local
                && b.base.base != 0 as u32
                && !(b.release_only && b.base.base == borrower_local) {
                let rel = via_release || b.release_only;
                if self.borrowed_storage_is_local(&b.base, locals)
                    && self.local_type_owns_storage(b.base.base, locals)
                    && !self.local_storage_external(func, locals, b.base.base, 0 as usize)
                    && !(rel && self.os_local_storage_external(b.base.base)) {
                    self.report_borrow_conflict(
                        action,
                        &b.base,
                        "a reference into storage owned by this frame (a collection, a box or an arena) cannot outlive the frame",
                        span,
                        &b.base,
                        b.span,
                        b.via,
                        locals
                    );
                    return true;
                }
                if b.base.base != borrower_local
                    && self.check_borrow_escapes_frame_depth(
                        action,
                        b.base.base,
                        span,
                        state,
                        locals,
                        func,
                        depth + 1 as usize,
                        rel
                    ) {
                    return true;
                }
            }
            vi = vi + 1 as usize;
        }
        return false;
    }

    fn local_is_ref_or_ptr(self: &ZirVerifier, local_id: u32, locals: [Local]) -> bool {
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == local_id {
                let ty = locals[li].ty;
                if ty == 0 as u32 || (ty as usize) > self.zil_module.types.len() { return false; }
                let tag = self.zil_module.types[ty as usize - 1 as usize].def.get_tag();
                return is_any_pointer_tag(tag);
            }
            li = li + 1 as usize;
        }
        return false;
    }

    fn rvalue_is_external_target(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        local_id: u32,
        rv: &ZirRvalue,
        depth: usize
    ) -> bool {
        match *rv {
            ZirRvalue.Use(p)
                | ZirRvalue.Ref(p, _)
                | ZirRvalue.RefMut(p, _)
                | ZirRvalue.Cast(p, _)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.Boxed(p) => {
                return self.local_is_external_target(func, locals, p.base, depth + 1 as usize);
            },
            ZirRvalue.Tuple(args) | ZirRvalue.StructLiteral(_, args) | ZirRvalue.Array(_, args) => {
                for a in args {
                    if self.local_is_external_target(func, locals, a.base, depth + 1 as usize) {
                        return true;
                    }
                }
                return false;
            },
            ZirRvalue.Call(fn_id, args) => {
                let is_ref = self.local_is_ref_or_ptr(local_id, locals);
                let is_opt_ref = !is_ref && self.local_holds_reference(local_id, locals);
                if is_ref || is_opt_ref {
                    if is_opt_ref {
                        let mut li = 0 as usize;
                        let mut is_enum = false;
                        while li < locals.len {
                            if locals[li].id == local_id {
                                let ty = locals[li].ty;
                                if ty != 0 as u32 && (ty as usize) <= self.zil_module.types.len() {
                                    let tag = self.zil_module.types[ty as usize
                                        - 1 as usize].def.get_tag();
                                    if tag == ILTYPE_USER {
                                        let uid = self.zil_module.types[ty as usize
                                            - 1 as usize].def.get_User().id;
                                        if uid != 0 as u32
                                            && (uid as usize) < self.zil_module.typedefs.len() {
                                            if let ILTypeDef.Enum(_) = self.zil_module.typedefs[uid as usize] {
                                                is_enum = true;
                                            }
                                        }
                                    }
                                }
                                break;
                            }
                            li = li + 1 as usize;
                        }
                        if !is_enum { return false; }
                    }
                    let mut ties = 0xffffffffffffffff as u64;
                    if (fn_id as usize) < self.zil_module.functions.len() {
                        ties = self.zil_module.functions[fn_id as usize].ret_ties;
                    }
                    let mut i = 0 as usize;
                    while i < args.len {
                        if i >= 64 as usize || ((ties >> (i as u64)) & 1 as u64) != 0 as u64 {
                            if self.local_is_external_target(
                                func,
                                locals,
                                args[i].base,
                                depth + 1 as usize
                            ) {
                                return true;
                            }
                        }
                        i = i + 1 as usize;
                    }
                }
                return false;
            },
            ZirRvalue.CallPtr(_, args) => {
                if self.local_is_ref_or_ptr(local_id, locals) {
                    for a in args {
                        if self.local_is_external_target(func, locals, a.base, depth + 1 as usize) {
                            return true;
                        }
                    }
                }
                return false;
            },
            ZirRvalue.GlobalAddr(_) => {
                return true;
            },
            _ => { return false; },
        }
    }

    fn local_is_external_target(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        local_id: u32,
        depth: usize
    ) -> bool {
        if depth > 8 as usize { return false; }
        if local_id == 0 as u32 || (local_id as usize) > locals.len { return false; }
        for p in func.params {
            if p.id == local_id { return true; }
        }
        if locals[local_id as usize - 1 as usize].is_capture_alias {
            return true;
        }
        let mut bi = 0 as usize;
        while bi < func.blocks.len {
            let b = &func.blocks[bi];
            let mut si = 0 as usize;
            while si < b.statements.len {
                match b.statements[si] {
                    ZirStmt.Let(id, rv, _) => {
                        if id == local_id {
                            if self.rvalue_is_external_target(func, locals, id, &rv, depth) {
                                return true;
                            }
                        }
                    },
                    ZirStmt.Assign(pl, rv, _) => {
                        if pl.base == local_id && pl.projections.len == 0 as usize {
                            if self.rvalue_is_external_target(func, locals, pl.base, &rv, depth) {
                                return true;
                            }
                        }
                    },
                    _ => {},
                }
                si = si + 1 as usize;
            }
            bi = bi + 1 as usize;
        }
        return false;
    }

    fn place_carries_borrow(self: &mut ZirVerifier, p: &Place, locals: [Local]) -> bool {
        let ty = self.get_place_type(p, locals);
        if ty == 0 as u32 { return true; }
        return self.type_holds_reference(ty) || self.type_owns_storage(ty, 0 as usize);
    }

    fn place_outlives_frame(
        self: &mut ZirVerifier,
        func: &ZirFunction,
        locals: [Local],
        place: &Place
    ) -> bool {
        if place.projections.len == 0 as usize { return false; }
        return self.local_is_external_target(func, locals, place.base, 0 as usize);
    }

    fn check_rvalue_escapes_frame(
        self: &mut ZirVerifier,
        action: [u8],
        rv: &ZirRvalue,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) -> bool {
        match *rv {
            ZirRvalue.Use(p) => {
                if !self.place_carries_borrow(&p, locals) { return false; }
                return self.check_borrow_escapes_frame(action, p.base, span, state, locals, func);
            },
            ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => {
                if self.check_borrow_escapes_frame(action, p.base, span, state, locals, func) {
                    return true;
                }
                if p.base != 0 as u32
                    && self.borrowed_storage_is_local(&p, locals)
                    && self.local_type_owns_storage(p.base, locals)
                    && !self.local_storage_external(func, locals, p.base, 0 as usize) {
                    self.report_borrow_conflict(
                        action,
                        &p,
                        "a reference into storage owned by this frame (a collection, a box or an arena) cannot outlive the frame",
                        span,
                        &p,
                        span,
                        0 as u64,
                        locals
                    );
                    return true;
                }
                return false;
            },
            ZirRvalue.Tuple(elems) => {
                for e in elems {
                    if self.check_borrow_escapes_frame(action, e.base, span, state, locals, func) {
                        return true;
                    }
                }
                return false;
            },
            ZirRvalue.StructLiteral(_, args) | ZirRvalue.Array(_, args) => {
                for a in args {
                    if self.check_borrow_escapes_frame(action, a.base, span, state, locals, func) {
                        return true;
                    }
                }
                return false;
            },
            ZirRvalue.EnumVariant(_, _, p)
                | ZirRvalue.EnumPayload(p, _, _)
                | ZirRvalue.Boxed(p)
                | ZirRvalue.Cast(p, _)
                | ZirRvalue.ArrayRepeat(p, _, _) => {
                return self.check_borrow_escapes_frame(action, p.base, span, state, locals, func);
            },
            _ => { return false; },
        }
    }

    fn callee_releases_mask(self: &mut ZirVerifier, fn_id: u32) -> u64 {
        if (fn_id as usize) >= self.zil_module.functions.len() { return 0 as u64; }
        let f = &self.zil_module.functions[fn_id as usize];
        let sret_name = self.intern_table.intern("__sret");
        let mut mask = os_decl_releases(self.zil_module, f, sret_name);
        if f.os_known { mask = mask | f.os_releases; }
        return mask;
    }

    fn callee_env_releases_mask(self: &ZirVerifier, fn_id: u32) -> u64 {
        if (fn_id as usize) >= self.zil_module.functions.len() { return 0 as u64; }
        let f = &self.zil_module.functions[fn_id as usize];
        if f.os_known { return f.os_env_releases; }
        return 0 as u64;
    }

    fn reset_to_mark_epoch(
        self: &ZirVerifier,
        fn_id: u32,
        args: [Place],
        state: &ZirAnalysisState
    ) -> u32 {
        if !self.is_arena_reset_to_call(fn_id) || args.len < 2 as usize { return 0 as u32; }
        let arena_base = self.get_borrow_base(args[0].base, state);
        let mark_local = args[1].base;
        let mut mi = 0 as usize;
        while mi < state.mark_infos.len() {
            let info = &state.mark_infos[mi];
            if info.mark_local == mark_local && info.arena_base == arena_base {
                return info.epoch;
            }
            mi = mi + 1 as usize;
        }
        return 0 as u32;
    }

    fn check_arg_release(
        self: &mut ZirVerifier,
        arg: &Place,
        exempt_epoch: u32,
        env_only: bool,
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        if arg.base == 0 as u32 { return; }
        if !env_only {
            let mut ai = 0 as usize;
            while ai < state.borrows.len() {
                let ab = state.borrows[ai];
                if ab.borrower == arg.base && (ab.direct || !ab.derived) {
                    let mut bi = 0 as usize;
                    while bi < state.borrows.len() {
                        let b = &state.borrows[bi];
                        if b.release_only
                            && b.borrower != arg.base
                            && self.borrow_counts(b, state, locals)
                            && self.places_overlap(&ab.base, &b.base) {
                            let is_exempt = exempt_epoch != 0 as u32
                                && !b.is_mut
                                && b.epoch < exempt_epoch;
                            if !is_exempt {
                                self.report_borrow_conflict(
                                    "cannot mutably borrow",
                                    &ab.base,
                                    "while it is already borrowed",
                                    span,
                                    &b.base,
                                    b.span,
                                    b.via,
                                    locals
                                );
                                return;
                            }
                        }
                        bi = bi + 1 as usize;
                    }
                }
                ai = ai + 1 as usize;
            }
        }
        if self.origins as usize == 0 as usize { return; }
        let c: &mut OriginSets = unsafe { &mut *self.origins };
        let tao = os_t(c, OS_T_AO);
        let tas = os_t(c, OS_T_AS);
        let tr = os_t(c, OS_T_R);
        os_clear(c, tao);
        os_clear(c, tas);
        if env_only {
            let ta = os_t(c, OS_T_X);
            os_clear(c, ta);
            let _ = os_read(c, self.zil_module, self.intern_table, locals, arg, ta, tas);
            let _ = os_or(c, ta, tas);
            os_clear(c, tas);
            os_reach_all(c, ta, tr);
            os_copy(c, ta, tr);
            let w = ta * c.words;
            c.buf[w + OS_W_ADDR] = 0 as u64;
            c.buf[w + OS_W_CONTENTS] = 0 as u64;
            c.buf[w + OS_W_FLAGS] = c.buf[w + OS_W_FLAGS] & !ORIGIN_STATIC;
            os_env_frames_only(c, self.zil_module, locals, ta);
            os_through(c, ta, tao);
        } else {
            let _ = os_read(c, self.zil_module, self.intern_table, locals, arg, tao, tas);
            let _ = os_or(c, tao, tas);
        }
        os_reach_all(c, tao, tr);
        let rw = tr * c.words;
        let p_bits = c.buf[rw + OS_W_ADDR] | c.buf[rw + OS_W_CONTENTS];
        let mut bi = 0 as usize;
        while bi < state.borrows.len() {
            let b = &state.borrows[bi];
            if b.release_only && b.borrower != arg.base && self.borrow_counts(b, state, locals) {
                let mut hits = os_has_frame(unsafe { &*self.origins }, tr, b.base.base as usize);
                if !hits {
                    let mut pi = 0 as usize;
                    while pi < (*func).params.len {
                        if (*func).params[pi].id == b.base.base {
                            let bit = if pi < 63 as usize { pi } else { 63 as usize };
                            if (p_bits >> (bit as u64)) & 1 as u64 != 0 as u64 { hits = true; }
                            break;
                        }
                        pi = pi + 1 as usize;
                    }
                }
                if hits {
                    let is_exempt = exempt_epoch != 0 as u32 && !b.is_mut && b.epoch < exempt_epoch;
                    if !is_exempt {
                        self.report_borrow_conflict(
                            "cannot mutably borrow",
                            &b.base,
                            "while it is already borrowed",
                            span,
                            &b.base,
                            b.span,
                            b.via,
                            locals
                        );
                        return;
                    }
                }
            }
            bi = bi + 1 as usize;
        }
    }

    fn check_call_releases(
        self: &mut ZirVerifier,
        fn_id: u32,
        args: [Place],
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        let cal_releases = self.callee_releases_mask(fn_id);
        let cal_env_releases = self.callee_env_releases_mask(fn_id);
        if cal_releases == 0 as u64 && cal_env_releases == 0 as u64 { return; }
        let exempt_epoch = self.reset_to_mark_epoch(fn_id, args, state);
        let mut k = 0 as usize;
        while k < args.len {
            let bit = if k < 63 as usize { k } else { 63 as usize };
            if (cal_releases >> (bit as u64)) & 1 as u64 != 0 as u64 {
                self.check_arg_release(&args[k], exempt_epoch, false, span, state, locals, func);
            } else if (cal_env_releases >> (bit as u64)) & 1 as u64 != 0 as u64 {
                self.check_arg_release(&args[k], exempt_epoch, true, span, state, locals, func);
            }
            k = k + 1 as usize;
        }
    }

    fn check_call_ptr_releases(
        self: &mut ZirVerifier,
        callee: &Place,
        args: [Place],
        span: Span,
        state: &ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        let mut cal_releases = 0xffffffffffffffff as u64;
        let mut cal_env_releases = 0 as u64;
        let mut env_releases = true;
        let mut env_only_callee = true;
        let mut known = false;
        if self.origins as usize != 0 as usize {
            let c: &OriginSets = unsafe { &*self.origins };
            if callee.projections.len == 0 as usize && (callee.base as usize) < c.nl {
                let k = c.known_fn[callee.base as usize];
                if k != 0 as u32 && k != OS_KNOWN_NONE {
                    known = true;
                    let fid = (k & !OS_KNOWN_ENV) - 1 as u32;
                    cal_releases = self.callee_releases_mask(fid);
                    cal_env_releases = self.callee_env_releases_mask(fid);
                    if k & OS_KNOWN_ENV == 0 as u32 {
                        env_releases = false;
                    } else {
                        let shift = if args.len < 63 as usize { args.len } else { 63 as usize };
                        let rel_env = (cal_releases >> (shift as u64)) != 0 as u64;
                        let env_rel_env = (cal_env_releases >> (shift as u64)) != 0 as u64;
                        env_releases = rel_env || env_rel_env;
                        env_only_callee = !rel_env;
                    }
                }
            }
        }
        let mut cal_fn_ty = 0 as u32;
        if !known {
            let cty = self.get_place_type(callee, locals);
            if cty != 0 as u32
                && (cty as usize) <= self.zil_module.types.len()
                && self.zil_module.types[cty as usize - 1 as usize].def.get_tag() == ILTYPE_FN {
                cal_fn_ty = cty;
            }
        }
        let mut i = 0 as usize;
        while i < args.len {
            let bit = if i < 63 as usize { i } else { 63 as usize };
            let is_rel = (cal_releases >> (bit as u64)) & 1 as u64 != 0 as u64;
            let is_env_rel = (cal_env_releases >> (bit as u64)) & 1 as u64 != 0 as u64;
            if is_rel || is_env_rel {
                let mut can_release = true;
                if !known {
                    let mut aty = self.get_place_type(&args[i], locals);
                    if aty == 0 as u32 && cal_fn_ty != 0 as u32 {
                        let fn_t = self.zil_module.types[cal_fn_ty as usize
                            - 1 as usize].def.get_Fn();
                        if i < fn_t.params.len { aty = fn_t.params[i]; }
                    }
                    if aty != 0 as u32 {
                        let tag = self.zil_module.types[aty as usize - 1 as usize].def.get_tag();
                        if is_raw_pointer_tag(tag) {
                            can_release = false;
                        } else if self.origins as usize != 0 as usize {
                            let c: &mut OriginSets = unsafe { &mut *self.origins };
                            if !os_type_has(c, self.zil_module, self.intern_table, aty, OS_Q_HANDLE)
                                && !os_owns(c, self.zil_module, self.intern_table, aty) {
                                can_release = false;
                            }
                        } else if !is_mut_pointer_tag(tag)
                            && !self.type_owns_storage(aty, 0 as usize) {
                            can_release = false;
                        }
                    }
                }
                if can_release {
                    self.check_arg_release(&args[i], 0 as u32, !is_rel, span, state, locals, func);
                }
            }
            i = i + 1 as usize;
        }
        if env_releases {
            self.check_arg_release(callee, 0 as u32, env_only_callee, span, state, locals, func);
        }
    }

    fn local_is_param(self: &ZirVerifier, local_id: u32, func: &ZirFunction) -> bool {
        let mut pi = 0 as usize;
        while pi < (*func).params.len {
            if (*func).params[pi].id == local_id { return true; }
            pi = pi + 1 as usize;
        }
        return false;
    }

    fn param_is_indirect(self: &ZirVerifier, fn_id: u32, idx: usize) -> bool {
        if (fn_id as usize) >= self.zil_module.functions.len() { return false; }
        let f = &self.zil_module.functions[fn_id as usize];
        let sret_name = self.intern_table.intern("__sret");
        let base = if f.params_len > 0 as usize && f.param(0).name == sret_name {
            1 as usize
        } else {
            0 as usize
        };
        if idx + base >= f.params_len { return false; }
        if f.param(idx + base).by_ref { return true; }
        let pty = f.param(idx + base).ty;
        if pty == 0 as u32 || (pty as usize) > self.zil_module.types.len() { return false; }
        let tag = self.zil_module.types[pty as usize - 1 as usize].def.get_tag();
        return is_any_pointer_tag(tag) || tag == ILTYPE_SLICE;
    }

    // Gives release-tier borrows from source argument SRC (carried borrows, plus referenced place
    // borrows when FROM_CONTENTS is true) to BORROWER_ID (a frame local id or OUTSIDE_BORROWER).
    fn give_arg_borrows_to_target(
        self: &mut ZirVerifier,
        src: &Place,
        from_contents: bool,
        borrower_id: u32,
        via: u64,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        if src.base == 0 as u32 || borrower_id == 0 as u32 { return; }
        if borrower_id != OUTSIDE_BORROWER && !self.local_holds_reference(borrower_id, locals) {
            return;
        }
        if !from_contents && !self.place_holds_reference(src, locals) { return; }
        let orig_len = state.borrows.len();
        let mut any_copied = false;
        let mut work = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        let mut bi = 0 as usize;
        while bi < orig_len {
            if state.borrows[bi].borrower == src.base {
                any_copied = true;
                let b = state.borrows[bi];
                self.push_borrow(
                    state,
                    ActiveBorrow {
                        base: b.base,
                        is_mut: false,
                        region: b.region,
                        borrower: borrower_id,
                        span: b.span,
                        derived: b.derived,
                        direct: false,
                        release_only: true,
                        epoch: b.epoch,
                        via: b.via | via,
                    }
                );
                if from_contents
                    && b.base.base != 0 as u32
                    && (b.base.base as usize) <= locals.len {
                    work.push(b.base.base);
                }
            }
            bi = bi + 1 as usize;
        }
        if from_contents {
            let mut wi = 0 as usize;
            while wi < work.len() {
                let target_local = work[wi];
                let mut ti = 0 as usize;
                while ti < orig_len {
                    if state.borrows[ti].borrower == target_local {
                        let b = state.borrows[ti];
                        self.push_borrow(
                            state,
                            ActiveBorrow {
                                base: b.base,
                                is_mut: false,
                                region: b.region,
                                borrower: borrower_id,
                                span: b.span,
                                derived: b.derived,
                                direct: false,
                                release_only: true,
                                epoch: b.epoch,
                                via: b.via | via,
                            }
                        );
                        if b.base.base != 0 as u32 && (b.base.base as usize) <= locals.len {
                            let mut seen = false;
                            let mut ki = 0 as usize;
                            while ki < work.len() {
                                if work[ki] == b.base.base {
                                    seen = true;
                                    break;
                                }
                                ki = ki + 1 as usize;
                            }
                            if !seen { work.push(b.base.base); }
                        }
                    }
                    ti = ti + 1 as usize;
                }
                wi = wi + 1 as usize;
            }
            if !any_copied
                && self.local_is_param(src.base, func)
                && self.place_holds_reference(src, locals) {
                self.push_borrow(
                    state,
                    ActiveBorrow {
                        base: *src,
                        is_mut: false,
                        region: 0 as u32,
                        borrower: borrower_id,
                        span: span,
                        derived: false,
                        direct: false,
                        release_only: true,
                        epoch: 0 as u32,
                        via: via,
                    }
                );
            }
        }
    }

    // Gives SRC_ARG's release-tier borrows to every Frame(L) in target destination reach TD,
    // and to OUTSIDE_BORROWER when external is set.
    fn apply_edge_targets(
        self: &mut ZirVerifier,
        src_arg: &Place,
        from_contents: bool,
        td: usize,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        if self.origins as usize == 0 as usize { return; }
        let nl = unsafe { (&*self.origins).nl };
        let ext = os_external(unsafe { &*self.origins }, td);
        let mut id = 1 as usize;
        while id < nl {
            if os_has_frame(unsafe { &*self.origins }, td, id) {
                self.give_arg_borrows_to_target(
                    src_arg,
                    from_contents,
                    id as u32,
                    self.cur_rv,
                    span,
                    state,
                    locals,
                    func
                );
            }
            id = id + 1 as usize;
        }
        if ext {
            self.give_arg_borrows_to_target(
                src_arg,
                from_contents,
                OUTSIDE_BORROWER,
                self.cur_rv,
                span,
                state,
                locals,
                func
            );
        }
    }

    fn apply_targets_mask_for_src(
        self: &mut ZirVerifier,
        fn_id: u32,
        call_args: [Place],
        src_arg: &Place,
        from_contents: bool,
        targets: u64,
        to_global: bool,
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        if self.origins as usize == 0 as usize { return; }
        let td = unsafe { (&*self.origins).nl * 2 as usize + 2 as usize + OS_T_D };
        let mut j = 0 as usize;
        while j < call_args.len {
            let bit = if j < 63 as usize { j } else { 63 as usize };
            if ((targets >> (bit as u64)) & 1 as u64) != 0 as u64 {
                {
                    let c: &mut OriginSets = unsafe { &mut *self.origins };
                    let tm = os_t(c, OS_T_W);
                    os_clear(c, tm);
                    os_param_origin(
                        c,
                        self.zil_module,
                        self.intern_table,
                        locals,
                        fn_id,
                        call_args,
                        j,
                        false,
                        tm
                    );
                    if os_fn_param(c, self.zil_module, fn_id, j) {
                        let fw = tm * c.words + OS_W_FLAGS;
                        c.buf[fw] = c.buf[fw] & !ORIGIN_STATIC;
                    }
                    os_dest_reach(c, self.zil_module, self.intern_table, locals, tm, td);
                }
                self.apply_edge_targets(src_arg, from_contents, td, span, state, locals, func);
            }
            j = j + 1 as usize;
        }
        if to_global {
            self.give_arg_borrows_to_target(
                src_arg,
                from_contents,
                OUTSIDE_BORROWER,
                self.cur_rv,
                span,
                state,
                locals,
                func
            );
        }
    }

    fn apply_unknown_store_borrows(
        self: &mut ZirVerifier,
        callee: &Place,
        has_callee: bool,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        if self.origins as usize == 0 as usize { return; }
        let td = unsafe { (&*self.origins).nl * 2 as usize + 2 as usize + OS_T_D };
        let nargs = if has_callee { args.len + 1 as usize } else { args.len };
        let empty_projs: [Projection] = @slice(0 as *mut Projection, 0 as usize);
        let dummy = Place { base: 0 as u32, projections: empty_projs };
        let cal_pl = if has_callee { *callee } else { dummy };
        let mut i = 0 as usize;
        while i < nargs {
            let src = if i < args.len { args[i] } else { cal_pl };
            let from_c = i < args.len;
            if self.place_holds_reference(&src, locals)
                || (i < args.len && state.borrows.len() > 0 as usize) {
                let mut j = 0 as usize;
                while j < nargs {
                    {
                        let c: &mut OriginSets = unsafe { &mut *self.origins };
                        let tao = os_t(c, OS_T_AO);
                        let tas = os_t(c, OS_T_AS);
                        let _ = os_unknown_arg(
                            c,
                            self.zil_module,
                            self.intern_table,
                            locals,
                            args,
                            &cal_pl,
                            j
                        );
                        let _ = os_or(c, tao, tas);
                        os_dest_reach(c, self.zil_module, self.intern_table, locals, tao, td);
                    }
                    self.apply_edge_targets(&src, from_c, td, span, state, locals, func);
                    j = j + 1 as usize;
                }
            }
            i = i + 1 as usize;
        }
    }

    fn check_call_ptr_stores(
        self: &mut ZirVerifier,
        callee: &Place,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        if self.origins as usize == 0 as usize { return; }
        let mut k = 0 as u32;
        let mut env_tup = 0 as u32;
        {
            let c: &OriginSets = unsafe { &*self.origins };
            if callee.projections.len == 0 as usize && (callee.base as usize) < c.nl {
                k = c.known_fn[callee.base as usize];
                env_tup = c.env_of[callee.base as usize];
            }
        }
        if k != 0 as u32 && k != OS_KNOWN_NONE {
            let fid = (k & !OS_KNOWN_ENV) - 1 as u32;
            if (k & OS_KNOWN_ENV) == 0 as u32 {
                self.check_call_stores_escapes(fid, args, span, state, locals, func);
                return;
            }
            if (fid as usize) < self.zil_module.functions.len() && env_tup != 0 as u32 {
                let p_func = self.zil_module.functions[fid as usize];
                if p_func.os_known {
                    let n = if args.len + 1 as usize > 63 as usize {
                        args.len + 1 as usize
                    } else {
                        63 as usize
                    };
                    let mut all = unsafe { Vec::<Place>.new_in_raw(self.arena) };
                    let mut ai = 0 as usize;
                    while ai < args.len {
                        all.push(args[ai]);
                        ai = ai + 1 as usize;
                    }
                    while ai < n {
                        all.push(*callee);
                        ai = ai + 1 as usize;
                    }
                    let mut first = 0 as usize;
                    let mut cap_n = 0 as usize;
                    {
                        let c: &mut OriginSets = unsafe { &mut *self.origins };
                        first = c.env_first[env_tup as usize] as usize;
                        cap_n = c.env_n[env_tup as usize] as usize;
                        c.known_env = args.len;
                        c.known_tuple = env_tup;
                    }
                    let edge_tbl = unsafe {
                        @slice(p_func.os_edges, p_func.os_edge_rows * 4 as usize)
                    };
                    let empty_projs: [Projection] = @slice(0 as *mut Projection, 0 as usize);
                    let mut r = 0 as usize;
                    while r < p_func.os_edge_rows {
                        let row = r * 4 as usize;
                        let code = edge_tbl[row] as usize;
                        let gflags = edge_tbl[row + 3 as usize];
                        if code < 128 as usize && (gflags & OS_EDGE_REF) != 0 as u64 {
                            let from_contents = code >= 64 as usize;
                            let pidx = if from_contents { code - 64 as usize } else { code };
                            let to_global = (gflags & (OS_EDGE_GLOBAL | OS_EDGE_ENV)) != 0 as u64;
                            let targets = edge_tbl[row + 1 as usize] | edge_tbl[row + 2 as usize];
                            if pidx < args.len {
                                self.apply_targets_mask_for_src(
                                    fid,
                                    all.as_slice(),
                                    &args[pidx],
                                    from_contents,
                                    targets,
                                    to_global,
                                    span,
                                    state,
                                    locals,
                                    func
                                );
                            } else if pidx == args.len {
                                self.apply_targets_mask_for_src(
                                    fid,
                                    all.as_slice(),
                                    callee,
                                    from_contents,
                                    targets,
                                    to_global,
                                    span,
                                    state,
                                    locals,
                                    func
                                );
                            } else {
                                let cap_idx = pidx - args.len - 1 as usize;
                                if cap_idx < cap_n {
                                    let cap_id = unsafe {
                                        (&*self.origins).env_caps[first + cap_idx]
                                    };
                                    let cap_pl = Place {
                                        base: cap_id,
                                        projections: empty_projs
                                    };
                                    self.apply_targets_mask_for_src(
                                        fid,
                                        all.as_slice(),
                                        &cap_pl,
                                        from_contents,
                                        targets,
                                        to_global,
                                        span,
                                        state,
                                        locals,
                                        func
                                    );
                                }
                            }
                        }
                        r = r + 1 as usize;
                    }
                    {
                        let c: &mut OriginSets = unsafe { &mut *self.origins };
                        c.known_env = OS_NO_ENV;
                        c.known_tuple = 0 as u32;
                    }
                    return;
                }
            }
        }
        self.apply_unknown_store_borrows(callee, true, args, span, state, locals, func);
    }

    fn check_call_stores_escapes(
        self: &mut ZirVerifier,
        fn_id: u32,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        if fn_id as usize >= self.zil_module.functions.len() { return; }
        let p_func = self.zil_module.functions[fn_id as usize];

        if p_func.has_stores_declared {
            let decl_from = p_func.stores_declared_from;
            let decl_to = p_func.stores_declared_to;
            let to_global = (decl_to & (0x8000000000000000 as u64)) != 0 as u64;
            let mut i = 0 as usize;
            while i < args.len {
                if i < 64 as usize && ((decl_from >> (i as u64)) & 1 as u64) != 0 as u64 {
                    let mut escapes = to_global;
                    if !escapes {
                        let mut j = 0 as usize;
                        while j < args.len {
                            if j != i
                                && j < 64 as usize
                                && ((decl_to >> (j as u64)) & 1 as u64) != 0 as u64 {
                                if self.local_is_external_target(
                                    func,
                                    locals,
                                    args[j].base,
                                    0 as usize
                                ) {
                                    escapes = true;
                                    break;
                                }
                            }
                            j = j + 1 as usize;
                        }
                    }
                    if escapes && self.place_carries_borrow(&args[i], locals) {
                        if self.check_borrow_escapes_frame(
                            "cannot store",
                            args[i].base,
                            span,
                            state,
                            locals,
                            func
                        ) {
                            return;
                        }
                    }
                }
                i = i + 1 as usize;
            }
        }

        if p_func.stores_storage != 0 as u64 {
            let stored = p_func.stores_storage;
            let targets = p_func.store_targets;
            let to_global = (targets & (0x8000000000000000 as u64)) != 0 as u64;
            let mut i = 0 as usize;
            while i < args.len {
                if i < 64 as usize && ((stored >> (i as u64)) & 1 as u64) != 0 as u64 {
                    let mut escapes = to_global;
                    if !escapes {
                        let mut j = 0 as usize;
                        while j < args.len {
                            if j != i
                                && j < 64 as usize
                                && ((targets >> (j as u64)) & 1 as u64) != 0 as u64 {
                                if self.local_is_external_target(
                                    func,
                                    locals,
                                    args[j].base,
                                    0 as usize
                                ) {
                                    escapes = true;
                                    break;
                                }
                            }
                            j = j + 1 as usize;
                        }
                    }
                    if escapes && self.place_carries_borrow(&args[i], locals) {
                        if self.check_borrow_escapes_frame(
                            "cannot store",
                            args[i].base,
                            span,
                            state,
                            locals,
                            func
                        ) {
                            return;
                        }
                    }
                }
                i = i + 1 as usize;
            }
        }

        if self.origins as usize == 0 as usize { return; }

        if p_func.os_known {
            // SAFETY: os_edge_rows rows of four u64 allocated by store_origin_summary.
            let edge_tbl = unsafe { @slice(p_func.os_edges, p_func.os_edge_rows * 4 as usize) };
            let mut r = 0 as usize;
            while r < p_func.os_edge_rows {
                let row = r * 4 as usize;
                let code = edge_tbl[row] as usize;
                let gflags = edge_tbl[row + 3 as usize];
                if code < 128 as usize && (gflags & OS_EDGE_REF) != 0 as u64 {
                    let from_contents = code >= 64 as usize;
                    let pidx = if from_contents { code - 64 as usize } else { code };
                    let to_global = (gflags & (OS_EDGE_GLOBAL | OS_EDGE_ENV)) != 0 as u64;
                    let targets = edge_tbl[row + 1 as usize] | edge_tbl[row + 2 as usize];
                    let mut k = pidx;
                    while k < args.len && (k == pidx || pidx == 63 as usize) {
                        self.apply_targets_mask_for_src(
                            fn_id,
                            args,
                            &args[k],
                            from_contents,
                            targets,
                            to_global,
                            span,
                            state,
                            locals,
                            func
                        );
                        k = k + 1 as usize;
                    }
                }
                r = r + 1 as usize;
            }
        }
        if p_func.has_stores_declared {
            let decl_from = p_func.stores_declared_from;
            let decl_to = p_func.stores_declared_to;
            let to_global = (decl_to & (0x8000000000000000 as u64)) != 0 as u64;
            let mut i = 0 as usize;
            while i < args.len {
                if (i < 63 as usize && ((decl_from >> (i as u64)) & 1 as u64) != 0 as u64)
                    || (i >= 63 as usize && ((decl_from >> 63 as u64) & 1 as u64) != 0 as u64) {
                    let from_c = !p_func.os_known && self.param_is_indirect(fn_id, i);
                    self.apply_targets_mask_for_src(
                        fn_id,
                        args,
                        &args[i],
                        from_c,
                        decl_to & (0x7fffffffffffffff as u64),
                        to_global,
                        span,
                        state,
                        locals,
                        func
                    );
                }
                i = i + 1 as usize;
            }
        } else if !p_func.os_known {
            if p_func.stores_storage != 0 as u64 {
                let stored = p_func.stores_storage;
                let targets = p_func.store_targets;
                let to_global = (targets & (0x8000000000000000 as u64)) != 0 as u64;
                let mut i = 0 as usize;
                while i < args.len {
                    if i < 64 as usize && ((stored >> (i as u64)) & 1 as u64) != 0 as u64 {
                        let from_c = self.param_is_indirect(fn_id, i);
                        self.apply_targets_mask_for_src(
                            fn_id,
                            args,
                            &args[i],
                            from_c,
                            targets & (0x7fffffffffffffff as u64),
                            to_global,
                            span,
                            state,
                            locals,
                            func
                        );
                    }
                    i = i + 1 as usize;
                }
            } else if !p_func.storage_known && !(p_func.is_extern && !p_func.has_summary) {
                let empty_projs: [Projection] = @slice(0 as *mut Projection, 0 as usize);
                let dummy = Place { base: 0 as u32, projections: empty_projs };
                self.apply_unknown_store_borrows(&dummy, false, args, span, state, locals, func);
            }
        }
    }

    // exhaustive: every terminator must state its operand, ownership and linearity effect.
    fn check_terminator(
        self: &mut ZirVerifier,
        term: &ZirTerminator,
        state: &mut ZirAnalysisState,
        locals: [Local],
        func: &ZirFunction
    ) {
        let span = func.span;
        self.cur_rv = 0 as u64;
        self.cur_stmt = 0 as u64;
        self.cur_term = term_bit(term);
        match *term {
            ZirTerminator.Ret(ret_pl) => {
                if ret_pl.base == 0 as u32 {
                    if func.ret_ty != 0 as u32 && !self.is_unit_type(func.ret_ty) {
                        self.report_error(
                            "control reaches end of non-void function without a return value",
                            span
                        );
                    }
                }
                // A return ends every scope, and this path has never run the block-end rule
                // (`emit_scope_cleanup` skips the marker: the region verifier was trusted to see
                // an escape). It does not see a buffer reached through a local - `v.get(i)` /
                // `v.as_slice()` hand back `self.data`, which is not derived from `self` - so a
                // reference into a buffer owned by this frame (a collection, a box or an arena)
                // would leave with the frame and read invalid memory. Default-deny: any borrow the
                // returned value holds whose root is a local owning storage is rejected unless the
                // local's provenance proves that storage outlives the frame (a parameter, a `*_raw`
                // constructor, or a constructor anchored to a parameter's arena). Before
                // `check_place_use`: that marks the returned value moved, and a moved borrower no
                // longer counts.
                if self.place_carries_borrow(&ret_pl, locals) {
                    self.check_borrow_escapes_frame(
                        "cannot return",
                        ret_pl.base,
                        span,
                        state,
                        locals,
                        func
                    );
                }
                self.check_place_use(&ret_pl, true, span, state, locals);
                // A linear resource consumed on some paths into this return but not others is
                // leaked on those others (`if c { close(f); } return 0;`). Lowering emits no
                // scope-exit drop for a value moved in a branch, so this is checked here.
                for l in locals {
                    let id = l.id;
                    if id != 0 as u32
                        && id != ret_pl.base
                        && (id as usize) < state.ownership.len
                        && state.ownership[id as usize] == OWN_MOVED
                        && state.maybe_live[id as usize]
                        && self.type_holds_linear(l.ty) {
                        self.report_var_error(
                            "linear resource",
                            id,
                            "is not closed on every path",
                            span,
                            locals
                        );
                    }
                }
            },
            ZirTerminator.Branch(cond, _, _) => {
                self.check_place_use(&cond, false, span, state, locals);
            },
            ZirTerminator.Jmp(_) | ZirTerminator.Unreachable => {},
        }
    }

    fn merge_states(
        self: &mut ZirVerifier,
        target: usize,
        predecessors: &Vec<u32>,
        exit_states: &[*mut ZirAnalysisState],
        locals_len: usize
    ) -> *mut ZirAnalysisState {
        if predecessors.len() == 0 as usize { return 0 as *mut ZirAnalysisState; }

        // Seed the merge from the first predecessor that has a computed exit.
        // Predecessors whose exit is still null (orphan or not yet processed) are
        // skipped: giving up on a null first predecessor would never analyze a
        // reachable block whose first predecessor comes later.
        let mut seed: *mut ZirAnalysisState = 0 as *mut ZirAnalysisState;
        let mut si = 0 as usize;
        while si < predecessors.len() {
            let idx = &predecessors[si];
            let ex = exit_states[(*idx) as usize];
            if ex as usize != 0 as usize { seed = ex; break; }
            si = si + 1 as usize;
        }
        if seed as usize == 0 as usize { return 0 as *mut ZirAnalysisState; }

        let seed_ref: &ZirAnalysisState = unsafe { &*seed };
        let res = seed_ref.clone(self.arena, locals_len);
        let res_ref: &mut ZirAnalysisState = unsafe { &mut *res };
        let mut i = 0 as usize;
        while i < predecessors.len() {
            let pred_idx = &predecessors[i];
            let pred_exit = exit_states[(*pred_idx) as usize];
            if pred_exit as usize != 0 as usize {
                let pred_exit_ref: &ZirAnalysisState = unsafe { &*pred_exit };
                // Ownership merge
                let mut j = 0 as usize;
                while j <= locals_len {
                    let st1 = res_ref.ownership[j];
                    let st2 = pred_exit_ref.ownership[j];
                    let ml = res_ref.maybe_live[j] || pred_exit_ref.maybe_live[j];
                    if st1 != st2 {
                        if st1 == OWN_UNINIT || st2 == OWN_UNINIT {
                            res_ref.ownership[j] = OWN_UNINIT;
                            res_ref.maybe_live[j] = false;
                        } else {
                            res_ref.ownership[j] = OWN_MOVED;  // Moved/Dropped confusion -> Moved
                            res_ref.maybe_live[j] = ml || st1 == OWN_OWNED || st2 == OWN_OWNED;
                        }
                    } else {
                        res_ref.maybe_live[j] = ml;
                    }

                    j = j + 1 as usize;
                }

                // Borrows merge: union, keyed by (borrower, base). A borrow live on only one
                // incoming path is live here too (may-analysis): intersecting the paths let a
                // branch-conditional borrow disappear at the join, and the arena it borrowed
                // was then reset while the value still held the reference (probe 203). Where
                // both paths have the same borrow, the merged answer is the conservative one:
                // mutable if either is, derived only if both are, direct if either is, and the
                // later epoch (so a post-mark borrow cannot be exempted as pre-mark).
                let mut l = 0 as usize;
                while l < pred_exit_ref.borrows.len() {
                    let b2 = pred_exit_ref.borrows[l];
                    let mut found = false;
                    let mut k = 0 as usize;
                    while k < res_ref.borrows.len() {
                        if res_ref.borrows[k].borrower == b2.borrower
                            && self.places_equal(&res_ref.borrows[k].base, &b2.base) {
                            found = true;
                            let mut merged = res_ref.borrows[k];
                            merged.is_mut = merged.is_mut || b2.is_mut;
                            merged.derived = merged.derived && b2.derived;
                            merged.direct = merged.direct || b2.direct;
                            merged.release_only = merged.release_only && b2.release_only;
                            merged.via = merged.via | b2.via;
                            if b2.epoch > merged.epoch { merged.epoch = b2.epoch; }
                            res_ref.borrows[k] = merged;
                            break;
                        }
                        k = k + 1 as usize;
                    }
                    if !found {
                        res_ref.borrows.push(ActiveBorrow {
                            base: b2.base,
                            is_mut: b2.is_mut,
                            region: b2.region,
                            borrower: b2.borrower,
                            span: b2.span,
                            derived: b2.derived,
                            direct: b2.direct,
                            release_only: b2.release_only,
                            epoch: b2.epoch,
                            via: b2.via,
                        });
                    }
                    l = l + 1 as usize;
                }

                // Every borrow in the merged state has crossed this block's join (two or more
                // predecessors), and a predecessor at or after the target block is a back-edge.
                // Those are routes a rejection can travel through, so record them on the borrow.
                let mut flags = 0 as u64;
                if predecessors.len() >= 2 as usize { flags = flags | route_bit(ROUTE_JOIN); }
                let mut pi = 0 as usize;
                while pi < predecessors.len() {
                    if (predecessors[pi] as usize) >= target {
                        flags = flags | route_bit(ROUTE_BACKEDGE);
                        break;
                    }
                    pi = pi + 1 as usize;
                }
                if flags != 0 as u64 {
                    let mut bj = 0 as usize;
                    while bj < res_ref.borrows.len() {
                        let mut b = res_ref.borrows[bj];
                        b.via = b.via | flags;
                        res_ref.borrows[bj] = b;
                        bj = bj + 1 as usize;
                    }
                }

                // EnumPayload aliases merge: Union
                let mut m = 0 as usize;
                while m < pred_exit_ref.enum_aliases.len() {
                    let ea = &pred_exit_ref.enum_aliases[m];
                    let mut found = false;
                    let mut n = 0 as usize;
                    while n < res_ref.enum_aliases.len() {
                        if res_ref.enum_aliases[n].local_id == ea.local_id {
                            found = true;
                            break;
                        }
                        n = n + 1 as usize;
                    }
                    if !found {
                        res_ref.enum_aliases.push(EnumPayloadAlias {
                            local_id: ea.local_id,
                            source: ea.source
                        });
                    }
                    m = m + 1 as usize;
                }

                // MarkInfos merge: Intersection taking minimum epoch when arena_base matches
                let mut mi_idx = 0 as usize;
                while mi_idx < res_ref.mark_infos.len() {
                    let r_info = &res_ref.mark_infos[mi_idx];
                    let mut matched = false;
                    let mut min_epoch = r_info.epoch;
                    let mut n = 0 as usize;
                    while n < pred_exit_ref.mark_infos.len() {
                        let p_info = &pred_exit_ref.mark_infos[n];
                        if p_info.mark_local == r_info.mark_local {
                            if p_info.arena_base == r_info.arena_base {
                                matched = true;
                                if p_info.epoch < min_epoch {
                                    min_epoch = p_info.epoch;
                                }
                            }
                            break;
                        }
                        n = n + 1 as usize;
                    }
                    if matched {
                        res_ref.mark_infos[mi_idx].epoch = min_epoch;
                        mi_idx = mi_idx + 1 as usize;
                    } else {
                        res_ref.mark_infos.remove(mi_idx);
                    }
                }
            }
            i = i + 1 as usize;
        }
        return res;
    }

    // The alias list's order follows which predecessor a merge visited first, not anything the
    // state says. A positional comparison keeps a loop whose back edges carry the same aliases in
    // different orders from reaching its fixed point, so compare as sets.
    fn alias_lists_equal(
        self: &ZirVerifier,
        a: &Vec<EnumPayloadAlias>,
        b: &Vec<EnumPayloadAlias>
    ) -> bool {
        let mut i = 0 as usize;
        while i < a.len() {
            let mut found = false;
            let mut j = 0 as usize;
            while j < b.len() && !found {
                found = a[i].local_id == b[j].local_id
                    && self.places_equal(&a[i].source, &b[j].source);
                j = j + 1 as usize;
            }
            if !found { return false; }
            i = i + 1 as usize;
        }
        let mut j = 0 as usize;
        while j < b.len() {
            let mut found = false;
            let mut i2 = 0 as usize;
            while i2 < a.len() && !found {
                found = a[i2].local_id == b[j].local_id
                    && self.places_equal(&a[i2].source, &b[j].source);
                i2 = i2 + 1 as usize;
            }
            if !found { return false; }
            j = j + 1 as usize;
        }
        return true;
    }

    fn borrow_fields_equal(self: &ZirVerifier, b1: &ActiveBorrow, b2: &ActiveBorrow) -> bool {
        return b1.borrower == b2.borrower
            && self.places_equal(&b1.base, &b2.base)
            && b1.is_mut == b2.is_mut
            && b1.derived == b2.derived
            && b1.direct == b2.direct
            && b1.release_only == b2.release_only
            && b1.epoch == b2.epoch;
    }

    fn borrows_subset(self: &ZirVerifier, a: &Vec<ActiveBorrow>, b: &Vec<ActiveBorrow>) -> bool {
        let mut i = 0 as usize;
        while i < a.len() {
            let mut found = false;
            let mut j = 0 as usize;
            while j < b.len() && !found {
                found = self.borrow_fields_equal(&a[i], &b[j]);
                j = j + 1 as usize;
            }
            if !found { return false; }
            i = i + 1 as usize;
        }
        return true;
    }

    fn borrow_lists_equal(
        self: &ZirVerifier,
        a: &Vec<ActiveBorrow>,
        b: &Vec<ActiveBorrow>
    ) -> bool {
        if a.len() == b.len() {
            let mut same_order = true;
            let mut i = 0 as usize;
            while i < a.len() {
                if !self.borrow_fields_equal(&a[i], &b[i]) {
                    same_order = false;
                    break;
                }
                i = i + 1 as usize;
            }
            if same_order { return true; }
        }
        return self.borrows_subset(a, b) && self.borrows_subset(b, a);
    }

    fn states_equal(
        self: &ZirVerifier,
        s1: *mut ZirAnalysisState,
        s2: *mut ZirAnalysisState,
        locals_len: usize
    ) -> bool {
        if s1 == s2 { return true; }
        if s1 as usize == 0 as usize || s2 as usize == 0 as usize { return false; }

        // Both are non-null per the check above; the block states are a nullable
        // raw array, so this is where the two become references.
        let a: &ZirAnalysisState = unsafe { &*s1 };
        let b: &ZirAnalysisState = unsafe { &*s2 };

        if !unsafe { is_mem_eq(a.ownership.ptr, b.ownership.ptr, (locals_len + 1) as u64) } {
            return false;
        }
        if !unsafe {
            is_mem_eq(a.maybe_live.ptr as *u8, b.maybe_live.ptr as *u8, (locals_len + 1) as u64)
        } {
            return false;
        }

        // Compare the active borrow lists as sets (with positional fast path) so
        // join predecessor ordering cannot keep the fixed point spinning.
        // Every field that can change a later decision is included: stopping at
        // `borrower` ended a loop's fixed point one pass early (probe 204).
        if !self.borrow_lists_equal(&a.borrows, &b.borrows) {
            return false;
        }
        if !self.alias_lists_equal(&a.enum_aliases, &b.enum_aliases) { return false; }
        if a.mark_infos.len() != b.mark_infos.len() { return false; }
        let mut mi = 0 as usize;
        while mi < a.mark_infos.len() {
            let m1 = &a.mark_infos[mi];
            let m2 = &b.mark_infos[mi];
            if m1.mark_local != m2.mark_local
                || m1.arena_base != m2.arena_base
                || m1.epoch != m2.epoch {
                return false;
            }
            mi = mi + 1 as usize;
        }
        return true;
    }

    fn get_type_decl(self: &ZirVerifier, ty_id: u32) -> &ILTypeDecl {
        if ty_id == 0 as u32 {
            ICE("ZirVerifier.get_type_decl: ty_id is 0");
        }
        if ty_id as usize > self.zil_module.types.len() {
            ICE("ZirVerifier.get_type_decl: ty_id out of bounds");
        }
        return &self.zil_module.types[ty_id as usize - 1 as usize];
    }

    // A copy of the declaration, for a caller that keeps it across its own `&mut self` calls: the
    // borrowed result of `get_type_decl` would keep the verifier borrowed throughout.
    // SAFETY: a copy of the module's type data, in the compilation's arena.
    #[unsafe(borrows())]
    fn type_decl_copy(self: &mut ZirVerifier, ty_id: u32) -> ILTypeDecl {
        return *self.get_type_decl(ty_id);
    }

    // Mirrors ZirLowerer.get_zil_sret_offset (lower_zir/utils.zrl) -- duplicated rather than
    // shared because the two run over different module handles (ZilModule vs ILModule) despite
    // the same struct shapes. sret is detected by param name, not by inspecting ret_ty: the
    // builder stage is what decides whether to insert the slot and names it "__sret" when it
    // does, so that name is the only authoritative signal here.
    fn call_get_sret_offset(self: &ZirVerifier, p_func: &ILFunction) -> usize {
        if p_func.params_len == 0 as usize { return 0 as usize; }
        let sret_name = self.intern_table.intern("__sret");
        let p_param0 = p_func.param(0);
        if p_param0.name == sret_name { return 1 as usize; }
        return 0 as usize;
    }

    // Index into `p_func.params` where the ZIR call's user-visible `args[0]` lands -- i.e. past
    // the compiler-inserted sret slot. Mirrors the `direct_param_base` /
    // `param_base_idx` computation in lower_zir/expr.zrl's call-lowering, which is what actually
    // built the alignment between ZIR args and IL params being relied on here.
    fn call_param_base(self: &ZirVerifier, p_func: &ILFunction) -> usize {
        // A closure's environment parameter comes last, after the source parameters.
        return self.call_get_sret_offset(p_func);
    }

    // Rejects passing a place declared as a non-mut pointer/reference (`&T` / `*T`, IL tags Ptr
    // or Boxed) where the callee's parameter is PtrMut/BoxedMut while that place's base local
    // holds an active *shared* borrow. It is the call-argument counterpart of the assignment and
    // borrow-creation checks: `&T` must not become a `&mut T` receiver just because it is passed
    // positionally. What is checked is the argument's own resolved type (`get_place_type`), not
    // something one deref below it, because `h.r` where `h.r: &P` hands over the reference value
    // itself. A raw pointer from `as *T` or arithmetic stays the documented escape hatch.
    fn check_call_arg_mutability(
        self: &mut ZirVerifier,
        fn_id: u32,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        if fn_id as usize >= self.zil_module.functions.len() { return; }
        let p_func = self.zil_module.functions[fn_id as usize];
        let param_base = self.call_param_base(p_func);

        let mut i = 0 as usize;
        while i < args.len {
            let param_idx = param_base + i;
            if param_idx >= p_func.params_len {
                i = i + 1 as usize;
                continue;
            }
            let param_ty = p_func.param(param_idx).ty;
            if param_ty != 0 as u32 {
                let p_param_ty = self.get_type_decl(param_ty);
                let param_tag = p_param_ty.def.get_tag();
                if is_mut_pointer_tag(param_tag) || param_tag == ILTYPE_BOXEDMUT {
                    let arg_place = &args[i];
                    self.advance_container_mutation_epoch(arg_place.base, state);
                    let arg_ty = self.get_place_type(arg_place, locals);
                    if arg_ty != 0 as u32 {
                        let p_arg_ty = self.get_type_decl(arg_ty);
                        if is_shared_pointer_tag(p_arg_ty.def.get_tag()) {
                            self.report_var_error(
                                "cannot pass",
                                arg_place.base,
                                "as a mutable reference because it is behind a shared reference",
                                span,
                                locals
                            );
                        }
                    }
                }
            }
            i = i + 1 as usize;
        }
    }

    // The argument rules of a direct call (`check_call_arg_mutability`), for a call through a
    // function value: its parameter types are in the `fn` type the value carries. A `&mut`
    // argument is a container mutation like any other, so it advances the mutation epoch (a
    // mark taken before the call must not exempt a borrow after it, probe 207), and a shared
    // reference passed where `&mut` is expected is rejected.
    fn check_call_ptr_arg_mutability(
        self: &mut ZirVerifier,
        f: &Place,
        args: [Place],
        span: Span,
        state: &mut ZirAnalysisState,
        locals: [Local]
    ) {
        let fn_ty = self.get_place_type(f, locals);
        if fn_ty == 0 as u32 { return; }
        let mut actual_fn_ty = 0 as u32;
        let tag = self.get_type_decl(fn_ty).def.get_tag();
        if tag == ILTYPE_FN {
            actual_fn_ty = fn_ty;
        } else if is_any_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(fn_ty);
            if inner != 0 as u32 && self.get_type_decl(inner).def.get_tag() == ILTYPE_FN {
                actual_fn_ty = inner;
            }
        }
        if actual_fn_ty == 0 as u32 { return; }
        // Copy the parameter types out: the slice borrows the module, and the checks below take
        // `&mut self`, which the checker cannot split from a field borrow.
        let mut param_tys = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        for pty in self.get_type_decl(actual_fn_ty).def.get_Fn().params {
            param_tys.push(*pty);
        }
        let mut i = 0 as usize;
        while i < args.len && i < param_tys.len() {
            let param_ty = param_tys[i];
            if param_ty != 0 as u32 {
                let param_tag = self.get_type_decl(param_ty).def.get_tag();
                if is_mut_pointer_tag(param_tag) || param_tag == ILTYPE_BOXEDMUT {
                    self.advance_container_mutation_epoch(args[i].base, state);
                    let arg_ty = self.get_place_type(&args[i], locals);
                    if arg_ty != 0 as u32 {
                        let arg_tag = self.get_type_decl(arg_ty).def.get_tag();
                        if is_shared_pointer_tag(arg_tag) {
                            self.report_var_error(
                                "cannot pass",
                                args[i].base,
                                "as a mutable reference because it is behind a shared reference",
                                span,
                                locals
                            );
                        }
                    }
                }
            }
            i = i + 1 as usize;
        }
    }

    fn get_usize_type(self: &ZirVerifier) -> u32 {
        return self.get_primitive_type(ILPRIM_USIZE);
    }

    fn is_unit_type(self: &ZirVerifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return true; }
        if ty_id as usize > self.zil_module.types.len() { return false; }
        let p_t = &self.zil_module.types[ty_id as usize - 1 as usize];
        if p_t.def.get_tag() == ILTYPE_PRIMITIVE {
            return p_t.def.get_Primitive().get_tag() == ILPRIM_UNIT;
        }
        if p_t.def.get_tag() == ILTYPE_TUPLE {
            return p_t.def.get_Tuple().len == 0 as usize;
        }
        return false;
    }

    fn get_primitive_type(self: &ZirVerifier, prim_tag: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len() {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_PRIMITIVE {
                if p_t.def.get_Primitive().get_tag() == prim_tag {
                    return p_t.id;
                }
            }
            i = i + 1 as usize;
        }
        return 0 as u32;
    }

    fn get_ptr_type(self: &mut ZirVerifier, inner: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len() {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_PTR { // a reference type is built here (Phase D step 2 adds the raw twin)
                if p_t.def.get_Ptr() == inner { return p_t.id; }
            }
            i = i + 1 as usize;
        }
        return self.zil_module.alloc_type(ILTypeDecl {
            id: 0,
            name: 0,
            def: ILType.Ptr(inner),
            source_file: 0 as u32
        });
    }

    fn get_raw_ptr_type(self: &mut ZirVerifier, inner: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len() {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_RAWPTR {
                if p_t.def.get_Ptr() == inner { return p_t.id; }
            }
            i = i + 1 as usize;
        }
        return self.zil_module.alloc_type(ILTypeDecl {
            id: 0, name: 0, def: ILType.RawPtr(inner), source_file: 0 as u32
        });
    }

    fn get_raw_ptr_mut_type(self: &mut ZirVerifier, inner: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len() {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_RAWPTRMUT {
                if p_t.def.get_PtrMut() == inner { return p_t.id; }
            }
            i = i + 1 as usize;
        }
        return self.zil_module.alloc_type(ILTypeDecl {
            id: 0, name: 0, def: ILType.RawPtrMut(inner), source_file: 0 as u32
        });
    }

    // Whether source argument I of function FN_ID is a slice, or a reference to one.
    fn callee_param_is_slice(self: &ZirVerifier, fn_id: u32, i: usize) -> bool {
        if (fn_id as usize) >= self.zil_module.functions.len() { return false; }
        let p_f = &self.zil_module.functions[fn_id as usize];
        let pi = i + self.call_param_base(p_f);
        if pi >= p_f.params_len { return false; }
        let mut ty = p_f.param(pi).ty;
        if ty == 0 as u32 || ty as usize > self.zil_module.types.len() { return false; }
        if is_any_pointer_tag(self.zil_module.types[ty as usize - 1 as usize].def.get_tag()) {
            ty = self.get_ptr_inner_type(ty);
            if ty == 0 as u32 || ty as usize > self.zil_module.types.len() { return false; }
        }
        return self.zil_module.types[ty as usize - 1 as usize].def.get_tag() == ILTYPE_SLICE;
    }

    fn get_ptr_inner_type(self: &ZirVerifier, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = &self.zil_module.types[ty_id as usize - 1 as usize];
        match p_ty.def {
            ILType.Ptr(inner)
                | ILType.PtrMut(inner)
                | ILType.RawPtr(inner)
                | ILType.RawPtrMut(inner)
                | ILType.Boxed(inner)
                | ILType.BoxedMut(inner) => { return inner; },
            ILType.Slice(s) => { return s.element; },
            _ => { return 0 as u32; },
        }
    }

    fn get_field_index(self: &mut ZirVerifier, ty_id: u32, field_name: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }

        let mut curr_ty = ty_id;
        let mut p_ty = self.get_type_decl(curr_ty);
        let mut tag = p_ty.def.get_tag();

        while is_any_pointer_tag(tag) || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            curr_ty = self.get_ptr_inner_type(curr_ty);
            if curr_ty == 0 as u32 { break; }
            p_ty = self.get_type_decl(curr_ty);
            tag = p_ty.def.get_tag();
        }

        if tag == ILTYPE_SLICE {
            let ptr_id = self.intern_table.intern("ptr");
            let data_id = self.intern_table.intern("data");
            let len_id = self.intern_table.intern("len");
            if field_name == ptr_id || field_name == data_id { return 0 as u32; }
            if field_name == len_id { return 1 as u32; }
            return 0 as u32;
        }

        let mut user_id = 0xffffffff as u32;
        if tag == ILTYPE_USER {
            user_id = p_ty.def.get_User().id;
        }

        if user_id != 0xffffffff as u32 {
            let p_def = &self.zil_module.typedefs[user_id as usize];
            if p_def.get_tag() == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                let mut fi = 0 as usize;
                while fi < s.fields.len {
                    if s.fields[fi].name == field_name {
                        return fi as u32;
                    }
                    fi = fi + 1 as usize;
                }
            }
        }
        return 0 as u32;
    }

    fn get_field_type(self: &mut ZirVerifier, ty_id: u32, field_idx: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }

        let mut curr_ty = ty_id;
        let mut p_ty = self.get_type_decl(curr_ty);
        let mut tag = p_ty.def.get_tag();

        while is_any_pointer_tag(tag) || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            curr_ty = self.get_ptr_inner_type(curr_ty);
            if curr_ty == 0 as u32 { break; }
            p_ty = self.get_type_decl(curr_ty);
            tag = p_ty.def.get_tag();
        }

        if tag == ILTYPE_SLICE {
            if field_idx == 0 as u32 {
                let elem_ty = p_ty.def.get_Slice().element;
                if p_ty.def.get_Slice().mutable { return self.get_raw_ptr_mut_type(elem_ty); }
                return self.get_raw_ptr_type(elem_ty);
            }
            if field_idx == 1 as u32 { return self.get_usize_type(); }
            return 0 as u32;
        }

        let mut user_id = 0xffffffff as u32;
        if tag == ILTYPE_USER {
            user_id = p_ty.def.get_User().id;
        }

        if user_id != 0xffffffff as u32 {
            let p_def = &self.zil_module.typedefs[user_id as usize];
            if p_def.get_tag() == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                if (field_idx as usize) < s.fields.len {
                    return s.fields[field_idx as usize].ty;
                }
            }
        }
        return 0 as u32;
    }

    // Whether a value of TY_ID can hold a reference (and so a borrow): the walk lives on the IL
    // module (`ILModule.type_holds_reference`, src/il_cfg.zrl), shared with the driver's signature
    // ties and its `static mut` rule - one walk replacing three near-copies that had drifted apart.
    fn type_holds_reference(self: &mut ZirVerifier, ty_id: u32) -> bool {
        return self.zil_module.type_holds_reference(ty_id, 0 as usize);
    }

    fn is_linear_tag(self: &ZirVerifier, ty_id: u32) -> bool {
        let tag = self.get_type_decl(ty_id).def.get_tag();
        return tag == ILTYPE_FD || tag == ILTYPE_IORING;
    }

    // Is this a linear resource, or an aggregate that holds one by value?
    //
    // The walk follows tuple elements, array elements, struct fields, enum payloads and boxes. A
    // depth limit used to double as the cycle breaker and answered `false` past eight levels - the
    // fail-open side - so an `fd` nested deeper was dropped without complaint and leaked (an
    // `fd<w>` nine struct levels down was accepted where eight was rejected). The cycle breaker is
    // the set of types already entered, so the answer is exact at any depth, and a recursive type
    // that holds none is not read as holding one (a conservative answer at the limit rejected
    // every linked list in `corpus/`).
    fn type_holds_linear(self: &mut ZirVerifier, ty_id: u32) -> bool {
        let mut seen = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        return self.type_holds_linear_walk(ty_id, 0 as usize, &mut seen);
    }

    // The walk itself. `depth` is vestigial - the recursion terminates on `seen`, not on a limit -
    // and stays as the mutation harness's anchor, where the old `|| depth > 8` answer goes back.
    fn type_holds_linear_walk(
        self: &mut ZirVerifier,
        ty_id: u32,
        depth: usize,
        seen: &mut Vec<u32>
    ) -> bool {
        // Named, like every guard the mutation harness targets: this line alone is where the old
        // `|| depth > 8` answer goes back.
        let absent_type = ty_id == 0 as u32;
        if absent_type { return false; }
        if self.linear_walk_entered(seen, ty_id) { return false; }
        seen.push(ty_id);
        let p_ty = self.type_decl_copy(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_FD || tag == ILTYPE_IORING { return true; }
        if tag == ILTYPE_TUPLE {
            let elems = p_ty.def.get_Tuple();
            let mut i = 0 as usize;
            while i < elems.len {
                if self.type_holds_linear_walk(elems[i], depth + 1 as usize, seen) { return true; }
                i = i + 1 as usize;
            }
            return false;
        }
        if tag == ILTYPE_ARRAY {
            return self.type_holds_linear_walk(
                p_ty.def.get_Array().element,
                depth + 1 as usize,
                seen
            );
        }
        if tag == ILTYPE_BOXED {
            return self.type_holds_linear_walk(p_ty.def.get_Boxed(), depth + 1 as usize, seen);
        }
        if tag == ILTYPE_BOXEDMUT {
            return self.type_holds_linear_walk(p_ty.def.get_BoxedMut(), depth + 1 as usize, seen);
        }
        if tag != ILTYPE_USER { return false; }
        let user_id = p_ty.def.get_User().id;
        if user_id == 0xffffffff as u32 || user_id as usize >= self.zil_module.typedefs.len() {
            return false;
        }
        let p_def = self.zil_module.typedefs[user_id as usize];
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            let fields = p_def.get_Struct().fields;
            let mut i = 0 as usize;
            while i < fields.len {
                if self.type_holds_linear_walk(fields[i].ty, depth + 1 as usize, seen) {
                    return true;
                }
                i = i + 1 as usize;
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            let variants = p_def.get_Enum().variants;
            let mut i = 0 as usize;
            while i < variants.len {
                if self.type_holds_linear_walk(variants[i].payload, depth + 1 as usize, seen) {
                    return true;
                }
                i = i + 1 as usize;
            }
        }
        return false;
    }

    // Whether TY_ID is already on this walk: what makes a recursive type terminate, since the fields
    // that would be examined on re-entry are the ones being examined right now.
    fn linear_walk_entered(self: &mut ZirVerifier, seen: &mut Vec<u32>, ty_id: u32) -> bool {
        for v in seen.as_slice() {
            if *v == ty_id { return true; }
        }
        return false;
    }

    fn get_tuple_elem_type(self: &mut ZirVerifier, ty_id: u32, idx: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = self.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        let mut base_ty = p_ty;
        if is_any_pointer_tag(tag) {
            let inner_ty = p_ty.def.get_Ptr();
            if inner_ty != 0 as u32 {
                base_ty = self.get_type_decl(inner_ty);
            }
        }

        let base_tag = base_ty.def.get_tag();
        if base_tag == ILTYPE_TUPLE {
            let elements = base_ty.def.get_Tuple();
            if (idx as usize) < elements.len {
                return elements[idx as usize];
            }
        }
        return 0 as u32;
    }

    fn is_vec_type(self: &mut ZirVerifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_USER {
            let user = p_ty.def.get_User();
            let name = self.intern_table.lookup(user.name);
            let is_vec = (name.len == 3 as usize
                && name[0] == 'V' as u8
                && name[1] == 'e' as u8
                && name[2] == 'c' as u8)
                || (name.len > 3 as usize
                    && name[0] == 'V' as u8
                    && name[1] == 'e' as u8
                    && name[2] == 'c' as u8
                    && name[3] == '_' as u8);
            return is_vec && user.type_args.len > 0 as usize;
        }
        return false;
    }

    fn get_slice_element_type(self: &mut ZirVerifier, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = self.type_decl_copy(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_SLICE {
            return p_ty.def.get_Slice().element;
        } else if tag == ILTYPE_ARRAY {
            return p_ty.def.get_Array().element;
        } else if self.is_vec_type(ty_id) {
            return p_ty.def.get_User().type_args[0];
        } else if is_shared_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(ty_id);
            if inner != 0 as u32 {
                let p_inner = self.get_type_decl(inner);
                let inner_tag = p_inner.def.get_tag();
                if inner_tag == ILTYPE_SLICE
                    || inner_tag == ILTYPE_ARRAY
                    || self.is_vec_type(inner) {
                    return self.get_slice_element_type(inner);
                }
                return inner;
            }
        } else if is_mut_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(ty_id);
            if inner != 0 as u32 {
                let p_inner = self.get_type_decl(inner);
                let inner_tag = p_inner.def.get_tag();
                if inner_tag == ILTYPE_SLICE || inner_tag == ILTYPE_ARRAY {
                    return self.get_slice_element_type(inner);
                }
                return inner;
            }
        }
        return ty_id;
    }

    fn has_drop_impl(self: &mut ZirVerifier, type_id: u32) -> bool {
        return self.zil_module.drop_fn_index(self.intern_table, type_id) != NO_DROP_FN;
    }

    pub fn is_copy_type(self: &mut ZirVerifier, type_id: u32) -> bool {
        return self.is_copy_type_internal(type_id, 0 as usize);
    }

    fn is_copy_type_internal(self: &mut ZirVerifier, type_id: u32, depth: usize) -> bool {
        if type_id == 0 as u32 { return true; }
        // Past the recursion limit the answer is *unknown*, and unknown has to read as "not `Copy`":
        // that is the conservative side for this question (a use is then a move, so a value used
        // after it was moved out of is rejected), while "`Copy`" is what stops the checker tracking
        // the move (doc/SAFETY.md §4.4). The limit is a backstop for
        // `is_implicit_aggregate_ptr`, the one recursion that follows a pointer; the walk is
        // otherwise finite. The name is its own so the mutation harness can revert this answer alone.
        let past_limit_copy = depth > 10 as usize;
        if past_limit_copy { return false; }

        if self.is_implicit_aggregate_ptr(type_id) {
            let inner = self.get_ptr_inner_type(type_id);
            return self.is_copy_type_internal(inner, depth + 1 as usize);
        }

        let p_ty = self.zil_module.types[type_id as usize - 1 as usize];
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_PRIMITIVE {
            let prim_tag = p_ty.def.get_Primitive().get_tag();
            return prim_tag != ILPRIM_NEVER;
        }
        if is_any_pointer_tag(tag) && tag != ILTYPE_PTRMUT { return true; }
        if tag == ILTYPE_SLICE { return true; }
        if tag == ILTYPE_FN { return true; }

        if tag == ILTYPE_ARRAY {
            return self.is_copy_type_internal(p_ty.def.get_Array().element, depth + 1 as usize);
        }
        if tag == ILTYPE_TUPLE {
            let elements = p_ty.def.get_Tuple();
            let mut i = 0 as usize;
            while i < elements.len {
                if !self.is_copy_type_internal(elements[i], depth + 1 as usize) { return false; }
                i = i + 1 as usize;
            }
            return true;
        }
        if tag == ILTYPE_USER {
            let u = p_ty.def.get_User();
            if self.has_drop_impl(type_id) { return false; }
            let user_id = u.id;
            if user_id as usize >= self.zil_module.typedefs.len() { return true; }
            let p_def = self.zil_module.typedefs[user_id as usize];
            let d_tag = p_def.get_tag();
            if d_tag == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                if s.is_copy_opt_out { return false; }
                let mut i = 0 as usize;
                while i < s.fields.len {
                    if !self.is_copy_type_internal(s.fields[i].ty, depth + 1 as usize) {
                        return false;
                    }
                    i = i + 1 as usize;
                }
                return true;
            } else if d_tag == IL_TYPEDEF_ENUM {
                let e = p_def.get_Enum();
                if e.is_copy_opt_out { return false; }
                let mut i = 0 as usize;
                while i < e.variants.len {
                    if e.variants[i].payload != 0 as u32 {
                        if !self.is_copy_type_internal(e.variants[i].payload, depth + 1 as usize) {
                            return false;
                        }
                    }
                    i = i + 1 as usize;
                }
                return true;
            }
        }
        return false;
    }

    fn is_implicit_aggregate_ptr(self: &mut ZirVerifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = &self.zil_module.types[ty_id as usize - 1 as usize];
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_PTR { // a shared reference, not a raw pointer (see src/lower_zir/utils.zrl)
            let inner = self.get_ptr_inner_type(ty_id);
            if inner == 0 as u32 { return false; }
            let p_inner = &self.zil_module.types[inner as usize - 1 as usize];
            let inner_tag = p_inner.def.get_tag();
            if inner_tag == ILTYPE_USER || inner_tag == ILTYPE_TUPLE {
                return p_inner.name == 0 as u32;
            }
        }
        return false;
    }

    fn get_place_type(self: &mut ZirVerifier, pl: &Place, locals: [Local]) -> u32 {
        if pl.base == 0 as u32 { return 0 as u32; }

        let mut curr_ty = 0 as u32;
        let mut li = 0 as usize;
        while li < locals.len {
            if locals[li].id == pl.base {
                curr_ty = locals[li].ty;
                break;
            }
            li = li + 1 as usize;
        }
        if curr_ty == 0 as u32 { return 0 as u32; }

        for proj in pl.projections {
            curr_ty = match *proj {
                Projection.Field(name) => self.get_field_type(
                    curr_ty,
                    self.get_field_index(curr_ty, name)
                ),
                Projection.TupleIndex(idx) => self.get_tuple_elem_type(curr_ty, idx),
                Projection.Deref => self.get_ptr_inner_type(curr_ty),
                Projection.Index(_) => self.get_slice_element_type(curr_ty),
            };
        }
        return curr_ty;
    }
}

// Which of FUNC's parameters' own storage the value it returns may point into
// (`ILFunction.ret_storage`), computed from the canonical ZIR before the borrow checker runs.
// The surface-AST walk it replaces named only a handful of expression shapes, so an alias local,
// a `match`, a struct or tuple literal or a field read read as "points into nothing" and the
// checker treated a direct borrow as a derived one (Unified Solution C).
//
// A flow over locals, each carrying the parameters whose storage it may point into. A call
// contributes what its callee's mask says about that argument; a callee whose mask is unknown (a
// cycle, an interface without storage keys) contributes every argument, the strict reading, and
// the answer is *unknown* - never silently empty - when such a callee was read.
pub struct ZirStorageFacts {
    pub mask: u64,
    pub known: bool,
    pub stored: u64,
    pub targets: u64,
}

fn storage_type_tag(module: &mut ILModule, ty: u32) -> u32 {
    if ty == 0 as u32 || ty as usize > module.types.len() { return 0 as u32; }
    return module.types[ty as usize - 1 as usize].def.get_tag();
}

fn storage_at(work: [mut u64], base: u32) -> u64 {
    if base == 0 as u32 || (base as usize) >= work.len { return 0 as u64; }
    return work[base as usize];
}

// Union WORK into block TO's entry; true when that changed it.
fn storage_join(
    entries: [mut u64],
    cmask_entries: [mut u64],
    reach_entries: [mut u64],
    to: usize,
    work: [mut u64],
    cmask: [mut u64],
    reach: [mut u64],
    nl: usize,
    nb: usize
) -> bool {
    if to >= nb { return false; }
    let mut changed = false;
    let mut i = 0 as usize;
    while i < nl {
        let old = entries[to * nl + i];
        let new = old | work[i];
        if new != old {
            entries[to * nl + i] = new;
            changed = true;
        }
        let old_c = cmask_entries[to * nl + i];
        let new_c = old_c | cmask[i];
        if new_c != old_c {
            cmask_entries[to * nl + i] = new_c;
            changed = true;
        }
        let old_r = reach_entries[to * nl + i];
        let new_r = old_r | reach[i];
        if new_r != old_r {
            reach_entries[to * nl + i] = new_r;
            changed = true;
        }
        i = i + 1 as usize;
    }
    return changed;
}

// The type of field FIELD_NAME in struct/user type TY, 0 when TY is not a struct or has no such
// field.
fn storage_field_type(module: &mut ILModule, ty: u32, field_name: u32) -> u32 {
    if ty == 0 as u32 { return 0 as u32; }
    let tag = storage_type_tag(module, ty);
    let mut base_ty = ty;
    if is_any_pointer_tag(tag) || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
        let p_def = &module.types[base_ty as usize - 1 as usize].def;
        base_ty = match *p_def {
            ILType.Ptr(inner)
                | ILType.PtrMut(inner)
                | ILType.RawPtr(inner)
                | ILType.RawPtrMut(inner)
                | ILType.Boxed(inner)
                | ILType.BoxedMut(inner) => inner,
            _ => 0 as u32,
        };
        if base_ty == 0 as u32 { return 0 as u32; }
    }
    if storage_type_tag(module, base_ty) != ILTYPE_USER { return 0 as u32; }
    let uid = module.types[base_ty as usize - 1 as usize].def.get_User().id;
    if uid == 0 as u32 || uid as usize >= module.typedefs.len() { return 0 as u32; }
    match module.typedefs[uid as usize] {
        ILTypeDef.Struct(st) => {
            for f in st.fields {
                if f.name == field_name { return f.ty; }
            }
            return 0 as u32;
        },
        _ => { return 0 as u32; },
    }
}

fn storage_place_type(module: &mut ILModule, locals: [Local], p: &Place) -> u32 {
    let mut ty = 0 as u32;
    let mut li = 0 as usize;
    while li < locals.len {
        if locals[li].id == p.base {
            ty = locals[li].ty;
            break;
        }
        li = li + 1 as usize;
    }
    let mut i = 0 as usize;
    while i < p.projections.len {
        if ty == 0 as u32 { return 0 as u32; }
        let tag = storage_type_tag(module, ty);
        match p.projections[i] {
            Projection.Field(name) => {
                ty = storage_field_type(module, ty, name);
            },
            Projection.TupleIndex(idx) => {
                if tag == ILTYPE_TUPLE {
                    let elems = module.types[ty as usize - 1 as usize].def.get_Tuple();
                    ty = if (idx as usize) < elems.len { elems[idx as usize] } else { 0 as u32 };
                } else if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else {
                    ty = 0 as u32;
                }
            },
            Projection.Index(_) => {
                if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else if tag == ILTYPE_SLICE {
                    ty = module.types[ty as usize - 1 as usize].def.get_Slice().element;
                } else {
                    ty = 0 as u32;
                }
            },
            Projection.Deref => {
                let p_def = &module.types[ty as usize - 1 as usize].def;
                ty = match *p_def {
                    ILType.Ptr(inner)
                        | ILType.PtrMut(inner)
                        | ILType.RawPtr(inner)
                        | ILType.RawPtrMut(inner)
                        | ILType.Boxed(inner)
                        | ILType.BoxedMut(inner) => inner,
                    ILType.Slice(s) => s.element,
                    _ => 0 as u32,
                };
            },
        }
        i = i + 1 as usize;
    }
    return ty;
}

// Whether reading the place P loads through a pointer, box or slice at some step: then the value
// comes from memory the base reaches, not from the base's own storage. This is the distinction
// the IL's storage_facts draws between `mask` (an address into the argument's own storage,
// `&self.v`) and `reach` (one built from a load, `self.data`, or a Vec's buffer). Reading
// `self.data` out of a `&Vec` is reachable memory, so `as_slice` does not hand back the
// argument's own storage - marking it would tie every slice to the Vec variable and reject an
// arena-backed `Vec` whose buffer outlives its handle.
fn storage_read_crosses_pointer(module: &mut ILModule, locals: [Local], p: &Place) -> bool {
    let mut ty = 0 as u32;
    let mut li = 0 as usize;
    while li < locals.len {
        if locals[li].id == p.base {
            ty = locals[li].ty;
            break;
        }
        li = li + 1 as usize;
    }
    let mut i = 0 as usize;
    while i < p.projections.len {
        let tag = storage_type_tag(module, ty);
        if is_any_pointer_tag(tag)
            || tag == ILTYPE_BOXED
            || tag == ILTYPE_BOXEDMUT
            || tag == ILTYPE_SLICE {
            return true;
        }
        match p.projections[i] {
            Projection.Field(name) => { ty = storage_field_type(module, ty, name); },
            Projection.TupleIndex(idx) => {
                if tag == ILTYPE_TUPLE {
                    let elems = module.types[ty as usize - 1 as usize].def.get_Tuple();
                    ty = if (idx as usize) < elems.len { elems[idx as usize] } else { 0 as u32 };
                } else if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else {
                    ty = 0 as u32;
                }
            },
            Projection.Index(_) => {
                if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else if tag == ILTYPE_SLICE {
                    ty = module.types[ty as usize - 1 as usize].def.get_Slice().element;
                } else {
                    ty = 0 as u32;
                }
            },
            Projection.Deref => {
                ty = if ty != 0 as u32 {
                    module.types[ty as usize - 1 as usize].def.get_Ptr()
                } else {
                    0 as u32
                };
            },
        }
        i = i + 1 as usize;
    }
    return false;
}

// The mask of the value READ from place P: the base's own-storage mask unless the read loads
// through a pointer (see storage_read_crosses_pointer).
fn storage_value_mask(module: &mut ILModule, locals: [Local], work: [mut u64], p: &Place) -> u64 {
    if storage_read_crosses_pointer(module, locals, p) { return 0 as u64; }
    return storage_at(work, p.base);
}

// The parameter-storage mask of the value RV produces, given each local's current mask.
fn storage_transfer_rv(
    module: &mut ILModule,
    locals: [Local],
    rv: &ZirRvalue,
    work: [mut u64],
    param_bits: [u64],
    known: &mut bool
) -> u64 {
    let mut m = 0 as u64;
    match *rv {
        // A bare copy - or a projection out of an aggregate, the strict reading - may point
        // wherever the source's storage points.
        ZirRvalue.Use(p) => { m = storage_value_mask(module, locals, work, &p); },
        ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => {
            m = storage_at(work, p.base);
            if (p.base as usize) < param_bits.len { m = m | param_bits[p.base as usize]; }
        },
        ZirRvalue.Call(fn_id, args) => {
            let mut callee_known = false;
            let mut storage = 0 as u64;
            if (fn_id as usize) < module.functions.len() {
                callee_known = module.functions[fn_id as usize].storage_known;
                storage = module.functions[fn_id as usize].ret_storage;
                if !callee_known { *known = false; }
            } else {
                *known = false;
            }
            let mut i = 0 as usize;
            while i < args.len {
                // The callee's mask names the arguments whose own storage the result may point
                // into. An unknown callee may hand back any of them.
                let own = !callee_known
                    || (i < 64 as usize && ((storage >> (i as u64)) & 1 as u64) != 0 as u64);
                if own { m = m | storage_value_mask(module, locals, work, &args[i]); }
                i = i + 1 as usize;
            }
        },
        ZirRvalue.CallPtr(f, args) => {
            // No summary: the result may point into the callee value's own storage (its captured
            // environment) or any argument's.
            m = storage_value_mask(module, locals, work, &f);
            for a in args { m = m | storage_value_mask(module, locals, work, a); }
        },
        ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args)
            | ZirRvalue.Syscall(args)
            | ZirRvalue.Intrinsic(_, args) => {
            for a in args { m = m | storage_value_mask(module, locals, work, a); }
        },
        ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.EnumPayload(p, _, _)
            | ZirRvalue.Boxed(p)
            | ZirRvalue.ArrayRepeat(p, _, _)
            | ZirRvalue.Cast(p, _)
            | ZirRvalue.PtrFromInt(p, _)
            | ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.VariantCheck(p, _, _) => {
            m = storage_value_mask(module, locals, work, &p);
        },
        ZirRvalue.BinaryOp(_, a, b) => {
            m = storage_value_mask(module, locals, work, &a)
                | storage_value_mask(module, locals, work, &b);
        },
        ZirRvalue.FuncAddr(_, env_ptr) => {
            if env_ptr != 0 as u32 {
                let ep = Place {
                    base: env_ptr,
                    projections: @slice(0 as *mut Projection, 0 as usize)
                };
                m = storage_value_mask(module, locals, work, &ep);
            }
        },
        ZirRvalue.Const(_, _)
            | ZirRvalue.Sizeof(_)
            | ZirRvalue.StringConst(_)
            | ZirRvalue.GlobalAddr(_)
            | ZirRvalue.GetEnv => {},
    }
    return m;
}

fn storage_transfer_cmask(
    module: &mut ILModule,
    locals: [Local],
    rv: &ZirRvalue,
    cmask: [mut u64],
    param_bits: [u64]
) -> u64 {
    let mut m = 0 as u64;
    match *rv {
        ZirRvalue.Use(p) => {
            if !storage_read_crosses_pointer(module, locals, &p) {
                m = storage_at(cmask, p.base);
            }
        },
        ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => {
            m = storage_at(cmask, p.base);
            if (p.base as usize) < param_bits.len {
                m = m | param_bits[p.base as usize];
            }
        },
        ZirRvalue.Call(fn_id, args) => {
            let mut callee_known = false;
            let mut storage = 0 as u64;
            let mut ties = 0xffffffffffffffff as u64;
            if (fn_id as usize) < module.functions.len() {
                callee_known = module.functions[fn_id as usize].storage_known;
                storage = module.functions[fn_id as usize].ret_storage;
                ties = module.functions[fn_id as usize].ret_ties;
            }
            let mut i = 0 as usize;
            while i < args.len {
                let own = !callee_known
                    || (i < 64 as usize && ((storage >> (i as u64)) & 1 as u64) != 0 as u64)
                    || (i < 64 as usize && ((ties >> (i as u64)) & 1 as u64) != 0 as u64);
                if own {
                    if !storage_read_crosses_pointer(module, locals, &args[i]) {
                        m = m | storage_at(cmask, args[i].base);
                    }
                }
                i = i + 1 as usize;
            }
        },
        ZirRvalue.CallPtr(f, args) => {
            if !storage_read_crosses_pointer(module, locals, &f) {
                m = m | storage_at(cmask, f.base);
            }
            for a in args {
                if !storage_read_crosses_pointer(module, locals, a) {
                    m = m | storage_at(cmask, a.base);
                }
            }
        },
        ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args)
            | ZirRvalue.Syscall(args)
            | ZirRvalue.Intrinsic(_, args) => {
            for a in args {
                if !storage_read_crosses_pointer(module, locals, a) {
                    m = m | storage_at(cmask, a.base);
                }
            }
        },
        ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.EnumPayload(p, _, _)
            | ZirRvalue.Boxed(p)
            | ZirRvalue.ArrayRepeat(p, _, _)
            | ZirRvalue.Cast(p, _)
            | ZirRvalue.PtrFromInt(p, _)
            | ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.VariantCheck(p, _, _) => {
            if !storage_read_crosses_pointer(module, locals, &p) {
                m = storage_at(cmask, p.base);
            }
        },
        ZirRvalue.BinaryOp(_, a, b) => {
            if !storage_read_crosses_pointer(module, locals, &a) {
                m = m | storage_at(cmask, a.base);
            }
            if !storage_read_crosses_pointer(module, locals, &b) {
                m = m | storage_at(cmask, b.base);
            }
        },
        ZirRvalue.FuncAddr(_, env_ptr) => {
            if env_ptr != 0 as u32 {
                m = storage_at(cmask, env_ptr);
            }
        },
        ZirRvalue.Const(_, _)
            | ZirRvalue.Sizeof(_)
            | ZirRvalue.StringConst(_)
            | ZirRvalue.GlobalAddr(_)
            | ZirRvalue.GetEnv => {},
    }
    return m;
}

fn storage_transfer_reach(
    module: &ILModule,
    rv: &ZirRvalue,
    reach: [mut u64],
    param_bits: [u64]
) -> u64 {
    let mut r = 0 as u64;
    match *rv {
        ZirRvalue.Use(p)
            | ZirRvalue.Ref(p, _)
            | ZirRvalue.RefMut(p, _)
            | ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.EnumPayload(p, _, _)
            | ZirRvalue.Boxed(p)
            | ZirRvalue.ArrayRepeat(p, _, _)
            | ZirRvalue.Cast(p, _)
            | ZirRvalue.PtrFromInt(p, _)
            | ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.VariantCheck(p, _, _) => {
            if (p.base as usize) < reach.len {
                r = reach[p.base as usize];
                if (p.base as usize) < param_bits.len {
                    r = r | param_bits[p.base as usize];
                }
            }
        },
        ZirRvalue.BinaryOp(_, a, b) => {
            if (a.base as usize) < reach.len {
                r = r | reach[a.base as usize];
                if (a.base as usize) < param_bits.len {
                    r = r | param_bits[a.base as usize];
                }
            }
            if (b.base as usize) < reach.len {
                r = r | reach[b.base as usize];
                if (b.base as usize) < param_bits.len {
                    r = r | param_bits[b.base as usize];
                }
            }
        },
        ZirRvalue.GlobalAddr(_) => {
            r = 0x8000000000000000 as u64;
        },
        ZirRvalue.Call(fn_id, args) => {
            let mut ties = 0xffffffffffffffff as u64;
            if (fn_id as usize) < module.functions.len() {
                ties = module.functions[fn_id as usize].ret_ties;
            }
            let mut i = 0 as usize;
            while i < args.len {
                if i < 64 as usize && ((ties >> (i as u64)) & 1 as u64) != 0 as u64 {
                    if (args[i].base as usize) < reach.len {
                        r = r | reach[args[i].base as usize];
                        if (args[i].base as usize) < param_bits.len {
                            r = r | param_bits[args[i].base as usize];
                        }
                    }
                }
                i = i + 1 as usize;
            }
        },
        ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args)
            | ZirRvalue.Syscall(args)
            | ZirRvalue.Intrinsic(_, args) => {
            for a in args {
                if (a.base as usize) < reach.len {
                    r = r | reach[a.base as usize];
                    if (a.base as usize) < param_bits.len {
                        r = r | param_bits[a.base as usize];
                    }
                }
            }
        },
        ZirRvalue.CallPtr(f, args) => {
            if (f.base as usize) < reach.len {
                r = r | reach[f.base as usize];
                if (f.base as usize) < param_bits.len {
                    r = r | param_bits[f.base as usize];
                }
            }
            for a in args {
                if (a.base as usize) < reach.len {
                    r = r | reach[a.base as usize];
                    if (a.base as usize) < param_bits.len {
                        r = r | param_bits[a.base as usize];
                    }
                }
            }
        },
        ZirRvalue.FuncAddr(_, env_ptr) => {
            if env_ptr != 0 as u32 && (env_ptr as usize) < reach.len {
                r = reach[env_ptr as usize];
                if (env_ptr as usize) < param_bits.len {
                    r = r | param_bits[env_ptr as usize];
                }
            }
        },
        ZirRvalue.Const(_, _)
            | ZirRvalue.Sizeof(_)
            | ZirRvalue.StringConst(_)
            | ZirRvalue.GetEnv => {},
    }
    return r;
}

// A primitive too narrow to hold an address (an integer of 32 bits or fewer, a float of 32, a `bool`,
// a `char`): a value of it carries no pointer, however it was computed from one, so a store of it
// is no store of its provenance. `u64`/`usize` and wider stay tracked (`p as usize` launders one).
fn type_is_narrow_scalar(module: &ILModule, ty: u32) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() { return false; }
    let t = &module.types[ty as usize - 1 as usize];
    if t.def.get_tag() != ILTYPE_PRIMITIVE { return false; }
    let p = t.def.get_Primitive().get_tag();
    return p == ILPRIM_U8
        || p == ILPRIM_U16
        || p == ILPRIM_U32
        || p == ILPRIM_I8
        || p == ILPRIM_I16
        || p == ILPRIM_I32
        || p == ILPRIM_F32
        || p == ILPRIM_BOOL
        || p == ILPRIM_CHAR;
}

fn note_call_stores_zir(
    module: &mut ILModule,
    locals: [Local],
    fn_id: u32,
    args: [Place],
    work: [mut u64],
    cmask: [mut u64],
    reach: [mut u64],
    param_bits: [u64],
    from_call: [bool],
    facts: &mut ZirStorageFacts
) {
    if (fn_id as usize) >= module.functions.len() { return; }
    let p_func = &module.functions[fn_id as usize];
    let mut stored_mask = p_func.stores_storage;
    let mut targets_mask = p_func.store_targets;
    if p_func.has_stores_declared {
        stored_mask = stored_mask | p_func.stores_declared_from;
        targets_mask = targets_mask | p_func.stores_declared_to;
    }
    if stored_mask == 0 as u64 { return; }
    let to_global = (targets_mask & (0x8000000000000000 as u64)) != 0 as u64;
    let mut i = 0 as usize;
    while i < args.len {
        if i < 64 as usize && ((stored_mask >> (i as u64)) & 1 as u64) != 0 as u64 {
            let ab = args[i].base as usize;
            let arg_ty = storage_place_type(module, locals, &args[i]);
            if type_is_narrow_scalar(module, arg_ty) {
                i = i + 1 as usize;
                continue;
            }
            let m_arg = (if ab < cmask.len { cmask[ab] } else { 0 as u64 })
                | (if ab < work.len { work[ab] } else { 0 as u64 })
                | (if ab < param_bits.len { param_bits[ab] } else { 0 as u64 })
                | (if ab < reach.len { reach[ab] } else { 0 as u64 });
            if m_arg != 0 as u64 {
                if to_global {
                    facts.stored = facts.stored | m_arg;
                    facts.targets = facts.targets | (0x8000000000000000 as u64);
                }
                let mut j = 0 as usize;
                while j < args.len {
                    if j != i
                        && j < 64 as usize
                        && ((targets_mask >> (j as u64)) & 1 as u64) != 0 as u64 {
                        let jb = args[j].base as usize;
                        let jb_ty = if jb < locals.len { locals[jb].ty } else { 0 as u32 };
                        let jb_is_ref = jb_ty != 0 as u32
                            && module.type_holds_reference(jb_ty, 0 as usize);
                        let t_reach = if jb < reach.len
                            && ((jb < from_call.len && !from_call[jb]) || jb_is_ref) {
                            reach[jb]
                        } else {
                            0 as u64
                        };
                        let t_arg = (if jb < param_bits.len { param_bits[jb] } else { 0 as u64 })
                            | (if jb < work.len { work[jb] } else { 0 as u64 })
                            | t_reach;
                        let t_filtered = t_arg & !m_arg;
                        if t_filtered != 0 as u64 {
                            facts.stored = facts.stored | m_arg;
                            facts.targets = facts.targets | t_filtered;
                        }
                    }
                    j = j + 1 as usize;
                }
            }
        }
        i = i + 1 as usize;
    }
}

fn os_local_ty(locals: [Local], id: u32) -> u32 {
    if id == 0 as u32 { return 0 as u32; }
    if (id as usize) <= locals.len && locals[id as usize - 1 as usize].id == id {
        return locals[id as usize - 1 as usize].ty;
    }
    for l in locals {
        if l.id == id { return l.ty; }
    }
    return 0 as u32;
}

fn storage_walk_zir(
    arena: *mut ArenaHeader,
    module: &mut ILModule,
    func: &ZirFunction
) -> ZirStorageFacts {
    let mut facts = ZirStorageFacts {
        mask: 0 as u64,
        known: true,
        stored: 0 as u64,
        targets: 0 as u64,
    };
    let locals = (*func).locals;
    let nl = locals.len + 1 as usize;
    let nb = (*func).blocks.len;
    if nb == 0 as usize { return facts; }
    // entry[bi * nl + local]: the parameter-storage mask each local holds on entry to block bi.
    let entries = unsafe { @slice(zoril_allocator_alloc(arena, nb * nl * 8) as *mut u64, nb * nl) };
    let cmask_entries = unsafe {
        @slice(zoril_allocator_alloc(arena, nb * nl * 8) as *mut u64, nb * nl)
    };
    let reach_entries = unsafe {
        @slice(zoril_allocator_alloc(arena, nb * nl * 8) as *mut u64, nb * nl)
    };
    let work = unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) };
    let cmask = unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) };
    let reach = unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) };
    let from_call = unsafe { @slice(zoril_allocator_alloc(arena, nl) as *mut bool, nl) };
    // param_bits[local] = that parameter's bit. A reference parameter's own storage is the
    // storage it points into (what the caller passed), so its bit starts in the flow; a
    // non-reference parameter's bit is added when an address into it is taken.
    let param_bits = unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) };
    unsafe {
        memset(entries.ptr as *mut u8, 0, (nb * nl * 8) as u64);
        memset(cmask_entries.ptr as *mut u8, 0, (nb * nl * 8) as u64);
        memset(reach_entries.ptr as *mut u8, 0, (nb * nl * 8) as u64);
        memset(param_bits.ptr as *mut u8, 0, (nl * 8) as u64);
        memset(work.ptr as *mut u8, 0, (nl * 8) as u64);
        memset(cmask.ptr as *mut u8, 0, (nl * 8) as u64);
        memset(reach.ptr as *mut u8, 0, (nl * 8) as u64);
        memset(from_call.ptr as *mut u8, 0, nl as u64);
    }
    let mut pi = 0 as usize;
    while pi < (*func).params.len && pi < 64 as usize {
        let p = (*func).params[pi];
        if (p.id as usize) < nl {
            let bit = (1 as u64) << (pi as u64);
            param_bits[p.id as usize] = bit;
            reach[p.id as usize] = bit;
            reach_entries[p.id as usize] = bit;
            if p.ty != 0 as u32 {
                if is_reference_tag(storage_type_tag(module, p.ty)) {
                    entries[p.id as usize] = entries[p.id as usize] | bit;
                    work[p.id as usize] = work[p.id as usize] | bit;
                }
                if module.type_holds_reference(p.ty, 0 as usize) {
                    cmask_entries[p.id as usize] = cmask_entries[p.id as usize] | bit;
                    cmask[p.id as usize] = cmask[p.id as usize] | bit;
                }
            }
        }
        pi = pi + 1 as usize;
    }

    let mut changed = true;
    while changed {
        changed = false;
        let mut bi = 0 as usize;
        while bi < nb {
            unsafe {
                memcpy(
                    work.ptr as *mut u8,
                    ((entries.ptr as usize) + bi * nl * 8) as *u8,
                    (nl * 8) as u64
                );
                memcpy(
                    cmask.ptr as *mut u8,
                    ((cmask_entries.ptr as usize) + bi * nl * 8) as *u8,
                    (nl * 8) as u64
                );
                memcpy(
                    reach.ptr as *mut u8,
                    ((reach_entries.ptr as usize) + bi * nl * 8) as *u8,
                    (nl * 8) as u64
                );
            }
            let b = &(*func).blocks[bi];
            let mut si = 0 as usize;
            while si < b.statements.len {
                match b.statements[si] {
                    ZirStmt.Let(id, rv, _) => {
                        if id != 0 as u32 && (id as usize) < nl {
                            let m = storage_transfer_rv(
                                module,
                                locals,
                                &rv,
                                work,
                                param_bits,
                                &mut facts.known
                            );
                            work[id as usize] = m;
                            let cm = storage_transfer_cmask(module, locals, &rv, cmask, param_bits);
                            cmask[id as usize] = cm;
                            let r = storage_transfer_reach(module, &rv, reach, param_bits);
                            reach[id as usize] = r;
                            let mut fc = false;
                            match rv {
                                ZirRvalue.Call(_, _) => { fc = true; },
                                ZirRvalue.Use(p)
                                    | ZirRvalue.Ref(p, _)
                                    | ZirRvalue.RefMut(p, _)
                                    | ZirRvalue.Cast(p, _)
                                    | ZirRvalue.EnumVariant(_, _, p)
                                    | ZirRvalue.EnumPayload(p, _, _)
                                    | ZirRvalue.Boxed(p)
                                    | ZirRvalue.ArrayRepeat(p, _, _)
                                    | ZirRvalue.UnaryOp(_, p)
                                    | ZirRvalue.VariantCheck(p, _, _) => {
                                    if (p.base as usize) < from_call.len {
                                        fc = from_call[p.base as usize];
                                    }
                                },
                                ZirRvalue.BinaryOp(_, a, b) => {
                                    let fca = if (a.base as usize) < from_call.len {
                                        from_call[a.base as usize]
                                    } else {
                                        false
                                    };
                                    let fcb = if (b.base as usize) < from_call.len {
                                        from_call[b.base as usize]
                                    } else {
                                        false
                                    };
                                    fc = fca || fcb;
                                },
                                _ => {},
                            }
                            from_call[id as usize] = fc;
                        }
                        if let ZirRvalue.Call(fn_id, args) = rv {
                            note_call_stores_zir(
                                module,
                                locals,
                                fn_id,
                                args,
                                work,
                                cmask,
                                reach,
                                param_bits,
                                from_call,
                                &mut facts
                            );
                        }
                    },
                    ZirStmt.Assign(pl, rv, _) => {
                        if pl.base != 0 as u32 && (pl.base as usize) < nl {
                            let m = storage_transfer_rv(
                                module,
                                locals,
                                &rv,
                                work,
                                param_bits,
                                &mut facts.known
                            );
                            let cm = storage_transfer_cmask(module, locals, &rv, cmask, param_bits);
                            let r = storage_transfer_reach(module, &rv, reach, param_bits);
                            if pl.projections.len == 0 as usize {
                                work[pl.base as usize] = m;
                                cmask[pl.base as usize] = cm;
                                reach[pl.base as usize] = r;
                                let mut fc = false;
                                match rv {
                                    ZirRvalue.Call(_, _) => { fc = true; },
                                    ZirRvalue.Use(p)
                                        | ZirRvalue.Ref(p, _)
                                        | ZirRvalue.RefMut(p, _)
                                        | ZirRvalue.Cast(p, _)
                                        | ZirRvalue.EnumVariant(_, _, p)
                                        | ZirRvalue.EnumPayload(p, _, _)
                                        | ZirRvalue.Boxed(p)
                                        | ZirRvalue.ArrayRepeat(p, _, _)
                                        | ZirRvalue.UnaryOp(_, p)
                                        | ZirRvalue.VariantCheck(p, _, _) => {
                                        if (p.base as usize) < from_call.len {
                                            fc = from_call[p.base as usize];
                                        }
                                    },
                                    ZirRvalue.BinaryOp(_, a, b) => {
                                        let fca = if (a.base as usize) < from_call.len {
                                            from_call[a.base as usize]
                                        } else {
                                            false
                                        };
                                        let fcb = if (b.base as usize) < from_call.len {
                                            from_call[b.base as usize]
                                        } else {
                                            false
                                        };
                                        fc = fca || fcb;
                                    },
                                    _ => {},
                                }
                                from_call[pl.base as usize] = fc;
                            } else {
                                work[pl.base as usize] = work[pl.base as usize] | m;
                                cmask[pl.base as usize] = cmask[pl.base as usize] | cm;
                                if storage_read_crosses_pointer(module, locals, &pl) {
                                    let pl_base_ty = os_local_ty(locals, pl.base);
                                    let base_is_ref = pl_base_ty != 0 as u32
                                        && module.type_holds_reference(pl_base_ty, 0 as usize);
                                    let target_reach = if (pl.base as usize) < reach.len
                                        && (((pl.base as usize) < from_call.len
                                            && !from_call[pl.base as usize])
                                            || base_is_ref) {
                                        reach[pl.base as usize]
                                    } else {
                                        0 as u64
                                    };
                                    let target = param_bits[pl.base as usize]
                                        | work[pl.base as usize]
                                        | target_reach;
                                    let mut stored_val = (cm | m) & !target;
                                    let pl_ty = storage_place_type(module, locals, &pl);
                                    if pl_ty != 0 as u32
                                        && module.type_holds_reference(pl_ty, 0 as usize) {
                                        stored_val = (cm | m | r) & !target;
                                    }
                                    if target != 0 as u64 && stored_val != 0 as u64 {
                                        facts.stored = facts.stored | stored_val;
                                        facts.targets = facts.targets | target;
                                    }
                                }
                            }
                        }
                        if let ZirRvalue.Call(fn_id, args) = rv {
                            note_call_stores_zir(
                                module,
                                locals,
                                fn_id,
                                args,
                                work,
                                cmask,
                                reach,
                                param_bits,
                                from_call,
                                &mut facts
                            );
                        }
                    },
                    ZirStmt.Drop(_, _)
                        | ZirStmt.DropIfLive(_, _)
                        | ZirStmt.EndBorrow(_, _)
                        | ZirStmt.Intrinsic(_, _, _) => {},
                }
                si = si + 1 as usize;
            }
            match b.terminator {
                ZirTerminator.Ret(rp) => {
                    if rp.base != 0 as u32 && (rp.base as usize) < nl {
                        facts.mask = facts.mask | work[rp.base as usize];
                    }
                },
                ZirTerminator.Jmp(t) => {
                    if storage_join(
                        entries,
                        cmask_entries,
                        reach_entries,
                        t as usize,
                        work,
                        cmask,
                        reach,
                        nl,
                        nb
                    ) {
                        changed = true;
                    }
                },
                ZirTerminator.Branch(_, t1, t2) => {
                    if storage_join(
                        entries,
                        cmask_entries,
                        reach_entries,
                        t1 as usize,
                        work,
                        cmask,
                        reach,
                        nl,
                        nb
                    ) {
                        changed = true;
                    }
                    if storage_join(
                        entries,
                        cmask_entries,
                        reach_entries,
                        t2 as usize,
                        work,
                        cmask,
                        reach,
                        nl,
                        nb
                    ) {
                        changed = true;
                    }
                },
                ZirTerminator.Unreachable => {},
            }
            bi = bi + 1 as usize;
        }
    }
    return facts;
}

pub fn compute_ret_storage_zir(
    arena: *mut ArenaHeader,
    module: &mut ILModule,
    func: &ZirFunction,
    il_func_idx: u32
) {
    let facts = storage_walk_zir(arena, module, func);
    if (il_func_idx as usize) < module.functions.len() {
        module.functions[il_func_idx as usize].ret_storage = facts.mask;
        module.functions[il_func_idx as usize].storage_known = facts.known;
        module.functions[il_func_idx as usize].stores_storage = facts.stored;
        module.functions[il_func_idx as usize].store_targets = facts.targets;
    }
}

// Origin sets (doc/design/provenance.md §3): for every local L, O(L), the origins of the addresses
// it holds, and S(L), the origins of the storage it owns, as a forward, flow-insensitive fixpoint
// over every statement. Field-insensitive: a write into any projection of L adds to L's sets.
// `zoril --emit-origins` prints them; under `--provenance` one more pass applies the store and
// return rules, beside the old ones.
//
// A set is `words` u64s in `buf`: word OS_W_ADDR holds ParamAddr(i), what argument i itself holds,
// and OS_W_CONTENTS ParamContents(i), the memory reached through it (§3, _The summary_; bit 63
// stands for parameter 63 and every later one), word OS_W_FLAGS the ORIGIN_* flags, and the rest
// Frame(L) by local id. Set k = L is O(L), k = nl + L is S(L), k = 2 * nl and 2 * nl + 1 the
// return value's O and S, and the OS_T_* temporaries follow.
const OS_W_ADDR: usize = 0;
const OS_W_CONTENTS: usize = 1;
const OS_W_FLAGS: usize = 2;
const OS_W_FRAME: usize = 3;
pub const ORIGIN_STATIC: u64 = 1;
pub const ORIGIN_UNKNOWN: u64 = 2;
// An address `@ptr_from_int` made, which the programmer vouched for in `unsafe` code (§3, _Raw
// operations_). In a value it is exempt from the return and store rules (os_frame_bound); as memory
// it is outside the frame (os_external), so a frame address stored through it is still refused.
pub const ORIGIN_RAW: u64 = 8;
// An address of read-only data: a string literal or a `fn` item's code. In a value it is outside
// the frame, as Static is; as memory it is no destination, since nothing stores into it without
// `unsafe`, so a literal a value holds does not make what the value reaches a global (§3,
// _Scalars, casts and `extern`_). A `static`'s address stays Static: it may be a `static mut`.
pub const ORIGIN_RODATA: u64 = 16;
// The flags that make memory a destination outside the frame.
const OS_FLAGS_MEMORY: u64 = ORIGIN_STATIC | ORIGIN_UNKNOWN | ORIGIN_RAW;

const OS_T_M: usize = 0;
const OS_T_DM: usize = 1;
const OS_T_OWN: usize = 2;
const OS_T_VO: usize = 3;
const OS_T_VS: usize = 4;
const OS_T_A: usize = 5;
const OS_T_B: usize = 6;
const OS_T_C: usize = 7;
const OS_T_AO: usize = 8;
const OS_T_R: usize = 9;
const OS_T_SV: usize = 10;
const OS_T_W: usize = 11;
const OS_T_AS: usize = 12;
const OS_T_SO: usize = 13;
const OS_T_V: usize = 14;
const OS_T_D: usize = 15;
const OS_T_X: usize = 16;
const OS_T_EV: usize = 17;
const OS_T_ED: usize = 18;
const OS_T_AH: usize = 19;
// Frame(L) for every capture alias L of a closure body, set once and never cleared.
const OS_T_CAP: usize = 20;
const OS_T_SF: usize = 21;
// The Frame(L) of OS_T_CAP whose type owns storage: the owned captures.
const OS_T_OWNCAP: usize = 22;
// os_dest_reach's own scratch set.
const OS_T_DR: usize = 23;
// os_arena_at_depths: its result, and its own two scratch sets.
const OS_T_ARENA: usize = 24;
const OS_T_AR1: usize = 25;
const OS_T_AR2: usize = 26;
const OS_TEMPS: usize = 27;

// The questions os_type_has answers about a type.
const OS_Q_ARENA: usize = 0;
const OS_Q_HANDLE: usize = 1;
const OS_Q_FRESH: usize = 2;
const OS_Q_ARENA_REF: usize = 3;
const OS_Q_REF_HANDLE: usize = 4;
const OS_Q_LOOSE_RAW: usize = 5;
const OS_Q_COUNT: usize = 6;

// The rules of §3: off, refusing, or warning only (`--provenance=warn`).
pub const PROVENANCE_OFF: u32 = 0;
pub const PROVENANCE_ON: u32 = 1;
pub const PROVENANCE_WARN: u32 = 2;

const OS_RULE_STORE: u8 = 1;
const OS_RULE_CALL_STORE: u8 = 2;
const OS_RULE_UNKNOWN_CALL: u8 = 3;
const OS_RULE_CLOSURE: u8 = 4;
const OS_RULE_RETURN: u8 = 5;
const OS_RULE_EXTERN_STORE: u8 = 6;

pub struct OsSeenDiag {
    pub span: Span,
    pub rule: u8,
}

pub struct OriginSets {
    pub nl: usize,
    pub words: usize,
    pub buf: [mut u64],
    // Per type id, memoised: 0 not yet asked, 1 no, 2 yes, 3 being asked (a cycle answers no; a
    // cycle can only close through a pointer or a box, which answer for themselves).
    pub carries_memo: [mut u8],
    pub owns_memo: [mut u8],
    pub walk_crossed: bool,
    // The last os_walk ended on a slice's `len`, which holds no address.
    pub walk_len: bool,
    pub changed: bool,
    pub passes: u32,
    pub unknown_calls: u32,
    // The callee of each unknown call of the last pass (UNKNOWN_FN_VALUE for a `fn` value), for the
    // dump.
    pub unknown_ids: [mut u32],
    // The interned `__sret`: a callee whose first parameter has it takes the result's slot there.
    pub sret_name: u32,
    // The functions named `T::drop`, so a type implementing Drop owns (os_owns).
    pub drop_fns: [mut u32],
    pub ndrop: usize,
    // os_type_has, memoised per question and type id as carries_memo is.
    pub q_memo: [mut u8],
    pub nt: usize,
    // The rule pass (one pass over the body after the fixpoint, PROVENANCE_ON or _WARN): where a
    // diagnostic goes, the span of the statement being checked, and how many it reported.
    pub rules: u32,
    pub checking: bool,
    pub file: [u8],
    pub span: Span,
    pub errors: u32,
    pub seen_diags: [mut OsSeenDiag],
    pub seen_diags_len: usize,
    // The store edges of this body, for its summary (§3, _The summary_): per stored-value code
    // (OS_EDGE_ROWS), the targets' ParamAddr bits, ParamContents bits, and OS_EDGE_GLOBAL.
    pub edges: [mut u64],
    // In a closure body, the index of `__env`, the last parameter (one past the declared ones:
    // lower_rv_call_ptr passes the environment after the arguments). GetEnv is ParamAddr of it.
    pub env_param: usize,
    // Per local, the ParamContents bit past env_param that stands for what the environment holds
    // for that capture alias inside the body, 0 for none (os_cap_bits). The summary keeps it: a
    // caller maps bit env_param + 1 + j to capture j, field j of the environment tuple
    // (os_known_call).
    pub cap_bit: [mut u8],
    // Per local, the function every `FuncAddr` assigned to it names (its index plus one, with
    // OS_KNOWN_ENV set when it carries an environment), 0 when none is, OS_KNOWN_NONE when it can
    // name more than one (os_known_callees).
    pub known_fn: [mut u32],
    // The body's scratch arena, for the argument lists of calls through a known callee.
    pub arena: *mut ArenaHeader,
    // During a call through a known closure, the index of its `__env` argument, else OS_NO_ENV;
    // the arguments past it stand for the captures (os_arg).
    pub known_env: usize,
    // During that call, the closure's environment tuple local when its fields can be read one by
    // one (env_of), else 0.
    pub known_tuple: u32,
    // Per closure local, its environment tuple local when every use of the closure is a call or a
    // copy and the tuple is written only where it is built, else 0 (os_known_envs).
    pub env_of: [mut u32],
    // Per tuple local, where its element locals start in env_caps and how many there are.
    pub env_first: [mut u32],
    pub env_n: [mut u32],
    pub env_caps: [mut u32],
    // Per local built by a literal, a bit for each element overwritten before it is seen
    // (os_dead_inits).
    pub dead_init: [mut u64],
    // Parameters whose reachable storage this body may release (§3.1, _What invalidates_): bit i
    // for parameter i, bit 63 for 63 and later.
    pub releases: u64,
    // Parameters whose reachable closure environments this body may invoke (and thereby release).
    pub env_releases: u64,
}

const OS_NO_ENV: usize = 0xffffffff;

const OS_KNOWN_NONE: u32 = 0xffffffff;
const OS_KNOWN_ENV: u32 = 0x80000000;

const OS_EDGE_STATIC: usize = 128;
const OS_EDGE_UNKNOWN: usize = 129;
const OS_EDGE_RODATA: usize = 130;
const OS_EDGE_ROWS: usize = 131;
const OS_EDGE_GLOBAL: u64 = 1;
// The target may be an owned capture of the closure (§3, _A closure body's summary is stated
// over `__env`_): the caller's environment, which outlives the call but is a local of the frame
// that made the closure, so the caller refuses a frame address there and records no global edge.
const OS_EDGE_ENV: u64 = 2;
const OS_EDGE_REF: u64 = 4;

fn os_t(c: &OriginSets, k: usize) -> usize { return 2 as usize * c.nl + 2 as usize + k; }

const UNKNOWN_FN_VALUE: u32 = 0xffffffff;

fn os_note_unknown(c: &mut OriginSets, fn_id: u32) {
    if (c.unknown_calls as usize) < c.unknown_ids.len {
        c.unknown_ids[c.unknown_calls as usize] = fn_id;
    }
    c.unknown_calls = c.unknown_calls + 1 as u32;
}

fn os_or(c: &mut OriginSets, dst: usize, src: usize) -> bool {
    let d = dst * c.words;
    let s = src * c.words;
    let mut changed = false;
    let mut k = 0 as usize;
    while k < c.words {
        let old = c.buf[d + k];
        let new = old | c.buf[s + k];
        if new != old {
            c.buf[d + k] = new;
            changed = true;
        }
        k = k + 1 as usize;
    }
    return changed;
}

fn os_clear(c: &mut OriginSets, set: usize) {
    let d = set * c.words;
    let mut k = 0 as usize;
    while k < c.words {
        c.buf[d + k] = 0 as u64;
        k = k + 1 as usize;
    }
}

fn os_copy(c: &mut OriginSets, dst: usize, src: usize) {
    os_clear(c, dst);
    let _ = os_or(c, dst, src);
}

fn os_is_empty(c: &OriginSets, set: usize) -> bool {
    let d = set * c.words;
    let mut k = 0 as usize;
    while k < c.words {
        if c.buf[d + k] != 0 as u64 { return false; }
        k = k + 1 as usize;
    }
    return true;
}

fn os_add_frame(c: &mut OriginSets, set: usize, id: u32) {
    if id == 0 as u32 || id as usize >= c.nl { return; }
    let w = set * c.words + OS_W_FRAME + (id as usize) / 64 as usize;
    c.buf[w] = c.buf[w] | ((1 as u64) << ((id as usize % 64 as usize) as u64));
}

fn os_has_frame(c: &OriginSets, set: usize, id: usize) -> bool {
    let w = set * c.words + OS_W_FRAME + id / 64 as usize;
    return (c.buf[w] >> ((id % 64 as usize) as u64)) & 1 as u64 != 0 as u64;
}

fn os_add_flag(c: &mut OriginSets, set: usize, flag: u64) {
    let w = set * c.words + OS_W_FLAGS;
    c.buf[w] = c.buf[w] | flag;
}

fn os_add_param(c: &mut OriginSets, set: usize, i: usize) {
    let bit = if i < 63 as usize { i } else { 63 as usize };
    let w = set * c.words;
    c.buf[w] = c.buf[w] | ((1 as u64) << (bit as u64));
}

fn os_add_contents(c: &mut OriginSets, set: usize, i: usize) {
    let bit = if i < 63 as usize { i } else { 63 as usize };
    let w = set * c.words + OS_W_CONTENTS;
    c.buf[w] = c.buf[w] | ((1 as u64) << (bit as u64));
}

// DST = what is stored in the memory SRC names: for each Frame(L), the addresses L holds and the
// storage L owns, which is reached through L too; memory reached through parameter i, by its own
// value (ParamAddr) or deeper (ParamContents), holds ParamContents(i); Static and Unknown
// memory holds only more of the same origin. This is the read-through rule that settles the design
// note's open question (§3).
fn os_through(c: &mut OriginSets, src: usize, dst: usize) {
    os_clear(c, dst);
    let s = src * c.words;
    let d = dst * c.words;
    c.buf[d + OS_W_CONTENTS] = c.buf[s + OS_W_ADDR] | c.buf[s + OS_W_CONTENTS];
    c.buf[d + OS_W_FLAGS] = c.buf[s + OS_W_FLAGS];
    let mut id = 1 as usize;
    while id < c.nl {
        if os_has_frame(c, src, id) {
            let _ = os_or(c, dst, id);
            let _ = os_or(c, dst, c.nl + id);
        }
        id = id + 1 as usize;
    }
}

// The value read from the memory SRC names, kept apart as a direct read keeps it (§3: S(src) when
// L is moved or copied from src): DST_O gets what each Frame(L) holds, DST_S what it owns. A move
// out of a payload or a box then stays an owner instead of becoming a borrow of its source.
fn os_through_split(c: &mut OriginSets, src: usize, dst_o: usize, dst_s: usize) {
    let s = src * c.words;
    let o = dst_o * c.words;
    let d = dst_s * c.words;
    let contents = c.buf[s + OS_W_ADDR] | c.buf[s + OS_W_CONTENTS];
    c.buf[o + OS_W_CONTENTS] = c.buf[o + OS_W_CONTENTS] | contents;
    c.buf[o + OS_W_FLAGS] = c.buf[o + OS_W_FLAGS] | c.buf[s + OS_W_FLAGS];
    c.buf[d + OS_W_CONTENTS] = c.buf[d + OS_W_CONTENTS] | contents;
    c.buf[d + OS_W_FLAGS] = c.buf[d + OS_W_FLAGS] | c.buf[s + OS_W_FLAGS];
    let mut id = 1 as usize;
    while id < c.nl {
        if os_has_frame(c, src, id) {
            let _ = os_or(c, dst_o, id);
            let _ = os_or(c, dst_s, c.nl + id);
        }
        id = id + 1 as usize;
    }
}

// DST = everything reached through SRC by one or more reads (SRC itself only where a cycle leads
// back to it).
fn os_through_plus(c: &mut OriginSets, src: usize, dst: usize) {
    os_through(c, src, dst);
    let tb = os_t(c, OS_T_B);
    loop {
        os_through(c, dst, tb);
        if !os_or(c, dst, tb) { break; }
    }
}

// DST = SRC and everything reached through it.
fn os_reach_all(c: &mut OriginSets, src: usize, dst: usize) {
    let tc = os_t(c, OS_T_C);
    os_through_plus(c, src, tc);
    os_copy(c, dst, src);
    let _ = os_or(c, dst, tc);
}

fn os_type_def_tag(module: &ILModule, ty: u32) -> u32 {
    return module.types[ty as usize - 1 as usize].def.get_tag();
}

fn os_pointee(module: &ILModule, ty: u32) -> u32 {
    return match module.types[ty as usize - 1 as usize].def {
        ILType.Ptr(x)
            | ILType.PtrMut(x)
            | ILType.RawPtr(x)
            | ILType.RawPtrMut(x)
            | ILType.Boxed(x)
            | ILType.BoxedMut(x) => x,
        ILType.Slice(s) => s.element,
        ILType.Primitive(_)
            | ILType.Array(_)
            | ILType.Fn(_)
            | ILType.Tuple(_)
            | ILType.FD(_)
            | ILType.IORing
            | ILType.User(_)
            | ILType.Var(_) => 0 as u32,
    };
}

// Whether a value of type TY can hold an address. A primitive of 64 bits can (`p as usize`); a
// narrower one, a float, `bool`, `char` and unit cannot. An unknown type can.
fn os_carries(c: &mut OriginSets, module: &ILModule, ty: u32) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() { return true; }
    let memo = c.carries_memo[ty as usize];
    if memo != 0 as u8 { return memo == 2 as u8; }
    c.carries_memo[ty as usize] = 3 as u8;
    let mut yes = false;
    match module.types[ty as usize - 1 as usize].def {
        ILType.Primitive(p) => {
            let pt = p.get_tag();
            yes = pt == ILPRIM_U64 || pt == ILPRIM_USIZE || pt == ILPRIM_I64 || pt == ILPRIM_ISIZE;
        },
        ILType.Ptr(_)
            | ILType.PtrMut(_)
            | ILType.RawPtr(_)
            | ILType.RawPtrMut(_)
            | ILType.Boxed(_)
            | ILType.BoxedMut(_)
            | ILType.Slice(_)
            | ILType.Fn(_)
            | ILType.Var(_) => { yes = true; },
        ILType.Array(a) => { yes = os_carries(c, module, a.element); },
        ILType.Tuple(elems) => {
            for e in elems {
                if os_carries(c, module, *e) { yes = true; }
            }
        },
        ILType.FD(_) | ILType.IORing => {},
        ILType.User(u) => {
            if u.id == 0xffffffff as u32 || u.id as usize >= module.typedefs.len() {
                yes = true;
            } else {
                match module.typedefs[u.id as usize] {
                    ILTypeDef.Struct(st) => {
                        for f in st.fields {
                            if os_carries(c, module, f.ty) { yes = true; }
                        }
                    },
                    ILTypeDef.Enum(en) => {
                        for v in en.variants {
                            if v.payload != 0 as u32 && os_carries(c, module, v.payload) {
                                yes = true;
                            }
                        }
                    },
                    ILTypeDef.Fn(_) => { yes = true; },
                }
            }
        },
    }
    c.carries_memo[ty as usize] = if yes { 2 as u8 } else { 1 as u8 };
    return yes;
}

// Whether a value of type TY holds a pointer, slice, box or `fn` value at any depth; an unknown
// type, a type variable or nesting past 32 levels counts as one.
fn os_holds_pointer(module: &ILModule, ty: u32, depth: usize) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() || depth > 32 as usize { return true; }
    match module.types[ty as usize - 1 as usize].def {
        ILType.Primitive(_) | ILType.FD(_) | ILType.IORing => { return false; },
        ILType.Ptr(_)
            | ILType.PtrMut(_)
            | ILType.RawPtr(_)
            | ILType.RawPtrMut(_)
            | ILType.Boxed(_)
            | ILType.BoxedMut(_)
            | ILType.Slice(_)
            | ILType.Fn(_)
            | ILType.Var(_) => { return true; },
        ILType.Array(a) => { return os_holds_pointer(module, a.element, depth + 1 as usize); },
        ILType.Tuple(elems) => {
            for e in elems {
                if os_holds_pointer(module, *e, depth + 1 as usize) { return true; }
            }
            return false;
        },
        ILType.User(u) => {
            if u.id == 0xffffffff as u32 || u.id as usize >= module.typedefs.len() { return true; }
            match module.typedefs[u.id as usize] {
                ILTypeDef.Struct(st) => {
                    for f in st.fields {
                        if os_holds_pointer(module, f.ty, depth + 1 as usize) { return true; }
                    }
                    return false;
                },
                ILTypeDef.Enum(en) => {
                    for v in en.variants {
                        if v.payload != 0 as u32
                            && os_holds_pointer(module, v.payload, depth + 1 as usize) {
                            return true;
                        }
                    }
                    return false;
                },
                ILTypeDef.Fn(_) => { return true; },
            }
        },
    }
}

// Whether TY holds an `Arena` or `ArenaHeader` in place, crossing no pointer.
fn os_arena_inline(module: &ILModule, table: &InternTable, ty: u32, depth: usize) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() || depth > 32 as usize { return true; }
    match module.types[ty as usize - 1 as usize].def {
        ILType.Array(a) => {
            return os_arena_inline(module, table, a.element, depth + 1 as usize);
        },
        ILType.Tuple(elems) => {
            for e in elems {
                if os_arena_inline(module, table, *e, depth + 1 as usize) { return true; }
            }
            return false;
        },
        ILType.User(u) => {
            if u.id == 0xffffffff as u32 || u.id as usize >= module.typedefs.len() { return true; }
            if type_name_is(table.lookup(u.name), "Arena")
                || type_name_is(table.lookup(u.name), "ArenaHeader") {
                return true;
            }
            match module.typedefs[u.id as usize] {
                ILTypeDef.Struct(st) => {
                    for f in st.fields {
                        if os_arena_inline(module, table, f.ty, depth + 1 as usize) { return true; }
                    }
                    return false;
                },
                ILTypeDef.Enum(en) => {
                    for v in en.variants {
                        if v.payload != 0 as u32
                            && os_arena_inline(module, table, v.payload, depth + 1 as usize) {
                            return true;
                        }
                    }
                    return false;
                },
                ILTypeDef.Fn(_) => { return false; },
            }
        },
        ILType.Primitive(_)
            | ILType.FD(_)
            | ILType.IORing
            | ILType.Fn(_)
            | ILType.Ptr(_)
            | ILType.PtrMut(_)
            | ILType.RawPtr(_)
            | ILType.RawPtrMut(_)
            | ILType.Boxed(_)
            | ILType.BoxedMut(_)
            | ILType.Slice(_) => { return false; },
        ILType.Var(_) => { return true; },
    }
}

// The numbers of pointers a value of type TY must follow to reach memory holding an `Arena` or
// `ArenaHeader` in place, as bits (bit k: k pointers; `&Arena` is bit 1, `&Vec<T>` bit 2, since a
// `Vec` holds its arena's address in `raw`). Bit 63: a path longer than eight, a type variable or
// an unknown type.
fn os_arena_depths(module: &ILModule, table: &InternTable, ty: u32, depth: usize) -> u64 {
    if ty == 0 as u32 || ty as usize > module.types.len() || depth > 32 as usize {
        return (1 as u64) << 63;
    }
    match module.types[ty as usize - 1 as usize].def {
        ILType.Ptr(x) | ILType.PtrMut(x) | ILType.RawPtr(x) | ILType.RawPtrMut(x) => {
            let mut m = if os_arena_inline(module, table, x, 0 as usize) {
                2 as u64
            } else {
                0 as u64
            };
            let inner = os_arena_depths(module, table, x, depth + 1 as usize);
            let deep = inner & ((1 as u64) << 63);
            let shifted = (inner & !((1 as u64) << 63)) << 1;
            m = m | deep | (shifted & ((1 as u64) << 9) - 1 as u64);
            if shifted >> 9 != 0 as u64 { m = m | ((1 as u64) << 63); }
            return m;
        },
        ILType.Boxed(x) | ILType.BoxedMut(x) => {
            return os_arena_depths(module, table, x, depth + 1 as usize);
        },
        ILType.Slice(sl) => {
            let mut m = if os_arena_inline(module, table, sl.element, 0 as usize) {
                2 as u64
            } else {
                0 as u64
            };
            let inner = os_arena_depths(module, table, sl.element, depth + 1 as usize);
            let deep = inner & ((1 as u64) << 63);
            let shifted = (inner & !((1 as u64) << 63)) << 1;
            m = m | deep | (shifted & ((1 as u64) << 9) - 1 as u64);
            if shifted >> 9 != 0 as u64 { m = m | ((1 as u64) << 63); }
            return m;
        },
        ILType.Array(a) => {
            return os_arena_depths(module, table, a.element, depth + 1 as usize);
        },
        ILType.Tuple(elems) => {
            let mut m = 0 as u64;
            for e in elems { m = m | os_arena_depths(module, table, *e, depth + 1 as usize); }
            return m;
        },
        ILType.User(u) => {
            if u.id == 0xffffffff as u32 || u.id as usize >= module.typedefs.len() {
                return (1 as u64) << 63;
            }
            // The pointers inside an arena lead to its blocks, C memory, not to another arena.
            if type_name_is(table.lookup(u.name), "Arena")
                || type_name_is(table.lookup(u.name), "ArenaHeader") {
                return 0 as u64;
            }
            let mut m = 0 as u64;
            match module.typedefs[u.id as usize] {
                ILTypeDef.Struct(st) => {
                    for f in st.fields {
                        m = m | os_arena_depths(module, table, f.ty, depth + 1 as usize);
                    }
                },
                ILTypeDef.Enum(en) => {
                    for v in en.variants {
                        if v.payload != 0 as u32 {
                            m = m | os_arena_depths(module, table, v.payload, depth + 1 as usize);
                        }
                    }
                },
                ILTypeDef.Fn(_) => {},
            }
            return m;
        },
        ILType.Var(_) => { return (1 as u64) << 63; },
        ILType.Primitive(_) | ILType.FD(_) | ILType.IORing | ILType.Fn(_) => { return 0 as u64; },
    }
}

// OS_T_ARENA = the memory the arenas lie in, for an argument holding SRC with DEPTHS as
// os_arena_depths gives them: for bit k, what SRC reaches through k - 1 more pointers; for bit 63,
// SRC and all it reaches.
fn os_arena_at_depths(c: &mut OriginSets, src: usize, depths: u64) {
    let out = os_t(c, OS_T_ARENA);
    let cur = os_t(c, OS_T_AR1);
    let nxt = os_t(c, OS_T_AR2);
    os_clear(c, out);
    if depths & ((1 as u64) << 63) != 0 as u64 {
        os_reach_all(c, src, out);
        return;
    }
    os_copy(c, cur, src);
    let mut k = 1 as usize;
    while k <= 8 as usize {
        if (depths >> (k as u64)) & 1 as u64 != 0 as u64 { let _ = os_or(c, out, cur); }
        os_through(c, cur, nxt);
        os_copy(c, cur, nxt);
        k = k + 1 as usize;
    }
}

// Whether user type NAME implements Drop: a function `NAME::drop` exists.
fn os_has_drop(c: &OriginSets, module: &ILModule, table: &InternTable, name: u32) -> bool {
    if name == 0 as u32 { return false; }
    let s = table.lookup(name);
    let mut k = 0 as usize;
    while k < c.ndrop {
        let n = table.lookup(module.functions[c.drop_fns[k] as usize].name);
        if n.len == s.len + 6 as usize {
            let mut same = true;
            let mut i = 0 as usize;
            while i < s.len {
                if n[i] != s[i] {
                    same = false;
                    break;
                }
                i = i + 1 as usize;
            }
            if same { return true; }
        }
        k = k + 1 as usize;
    }
    return false;
}

// Whether a value of type TY owns storage (§3, _Ownership_): it is a box, implements Drop, is one
// of the four standard-library collections designated as owners until they get a Drop of their own,
// or contains an owning type by value. A raw pointer, a reference, a slice and a function value own
// nothing. An unknown type owns.
fn os_owns(c: &mut OriginSets, module: &ILModule, table: &InternTable, ty: u32) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() { return true; }
    let memo = c.owns_memo[ty as usize];
    if memo != 0 as u8 { return memo == 2 as u8; }
    c.owns_memo[ty as usize] = 3 as u8;
    let mut yes = false;
    match module.types[ty as usize - 1 as usize].def {
        ILType.Boxed(_) | ILType.BoxedMut(_) | ILType.Var(_) => { yes = true; },
        ILType.Primitive(_)
            | ILType.RawPtr(_)
            | ILType.RawPtrMut(_)
            | ILType.Ptr(_)
            | ILType.PtrMut(_)
            | ILType.Slice(_)
            | ILType.Fn(_)
            | ILType.FD(_)
            | ILType.IORing => {},
        ILType.Array(a) => { yes = os_owns(c, module, table, a.element); },
        ILType.Tuple(elems) => {
            for e in elems {
                if os_owns(c, module, table, *e) { yes = true; }
            }
        },
        ILType.User(u) => {
            let s = table.lookup(u.name);
            if u.id == 0xffffffff as u32 || u.id as usize >= module.typedefs.len() {
                yes = true;
            } else if type_name_is(s, "Vec")
                || type_name_is(s, "String")
                || type_name_is(s, "ByteVec")
                || type_name_is(s, "HashMap")
                || os_has_drop(c, module, table, u.name) {
                yes = true;
            } else {
                match module.typedefs[u.id as usize] {
                    ILTypeDef.Struct(st) => {
                        for f in st.fields {
                            if os_owns(c, module, table, f.ty) { yes = true; }
                        }
                    },
                    ILTypeDef.Enum(en) => {
                        for v in en.variants {
                            if v.payload != 0 as u32 && os_owns(c, module, table, v.payload) {
                                yes = true;
                            }
                        }
                    },
                    ILTypeDef.Fn(_) => {},
                }
            }
        },
    }
    c.owns_memo[ty as usize] = if yes { 2 as u8 } else { 1 as u8 };
    return yes;
}

// Q of type TY (§3): OS_Q_ARENA, whether a value can reach an `Arena` (by value or through a
// pointer, a box or a slice); OS_Q_HANDLE, whether it can hold a mutable handle (`&mut`, `[mut T]`
// or a `fn` value, the leaves of _Destination reach_; every other type answers for its element or
// field types); OS_Q_FRESH, whether it is or contains by value a box or a type implementing Drop,
// so a call returning one owns fresh storage; OS_Q_ARENA_REF, whether it reaches an `Arena` through
// a pointer or a slice (an `Arena` or `ArenaHeader` held by value answers no, though its header is
// one); OS_Q_REF_HANDLE, whether it can hold a mutable handle other than a `fn` value, or a raw
// `*mut` pointer; OS_Q_LOOSE_RAW, whether it holds by value a raw `*mut` pointer that is not part
// of an owner (a standard collection or a Drop type, whose raw pointers point into what it owns),
// not looking behind a reference or a slice. An unknown type answers yes.
fn os_type_has(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    ty: u32,
    q: usize
) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() { return true; }
    let m = q * c.nt + ty as usize;
    let memo = c.q_memo[m];
    if memo != 0 as u8 { return memo == 2 as u8; }
    c.q_memo[m] = 3 as u8;
    let mut yes = false;
    match module.types[ty as usize - 1 as usize].def {
        ILType.Var(_) => { yes = true; },
        ILType.Primitive(_) | ILType.FD(_) | ILType.IORing => {},
        ILType.PtrMut(x) => {
            yes = q == OS_Q_HANDLE
                || q == OS_Q_REF_HANDLE
                || (q == OS_Q_ARENA && os_type_has(c, module, table, x, q))
                || (q == OS_Q_ARENA_REF && os_type_has(c, module, table, x, OS_Q_ARENA));
        },
        ILType.Ptr(x) | ILType.RawPtr(x) | ILType.RawPtrMut(x) => {
            let raw_mut = module.types[ty as usize - 1 as usize].def.get_tag() == ILTYPE_RAWPTRMUT;
            if raw_mut && q == OS_Q_LOOSE_RAW {
                // An arena's raw form (`*mut ArenaHeader`, `Vec.new_in_raw(arena)`) points at an
                // arena, which owns what is written through it: no `static mut` to lead a store to.
                yes = true;
                if x != 0 as u32 && x as usize <= module.types.len() {
                    if let ILType.User(pu) = module.types[x as usize - 1 as usize].def {
                        if type_name_is(table.lookup(pu.name), "ArenaHeader") { yes = false; }
                    }
                }
            } else if raw_mut && q == OS_Q_REF_HANDLE {
                // What a raw mutable pointer points to may be written through it, a global as
                // well (`&mut G as *mut T`): no reason to take Static out of what a type holding
                // one holds.
                yes = true;
            } else if q == OS_Q_ARENA_REF {
                yes = os_type_has(c, module, table, x, OS_Q_ARENA);
            } else if q == OS_Q_LOOSE_RAW {
                yes = false;
            } else {
                yes = q != OS_Q_FRESH && os_type_has(c, module, table, x, q);
            }
        },
        ILType.Boxed(x) | ILType.BoxedMut(x) => {
            yes = q == OS_Q_FRESH || os_type_has(c, module, table, x, q);
        },
        ILType.Slice(sl) => {
            yes = ((q == OS_Q_HANDLE || q == OS_Q_REF_HANDLE) && sl.mutable)
                || (q == OS_Q_ARENA_REF && os_type_has(c, module, table, sl.element, OS_Q_ARENA))
                || (q != OS_Q_FRESH
                    && q != OS_Q_ARENA_REF
                    && q != OS_Q_LOOSE_RAW
                    && os_type_has(c, module, table, sl.element, q));
        },
        ILType.Fn(_) => { yes = q == OS_Q_HANDLE; },
        ILType.Array(a) => { yes = os_type_has(c, module, table, a.element, q); },
        ILType.Tuple(elems) => {
            for e in elems {
                if os_type_has(c, module, table, *e, q) { yes = true; }
            }
        },
        ILType.User(u) => {
            if u.id == 0xffffffff as u32 || u.id as usize >= module.typedefs.len() {
                yes = true;
            } else if q == OS_Q_ARENA
                && (type_name_is(table.lookup(u.name), "Arena")
                    || type_name_is(table.lookup(u.name), "ArenaHeader")) {
                // `ArenaHeader` is an arena's raw form (`Vec.new_in_raw(arena)`).
                yes = true;
            } else if q == OS_Q_ARENA_REF
                && (type_name_is(table.lookup(u.name), "Arena")
                    || type_name_is(table.lookup(u.name), "ArenaHeader")) {
                yes = false;
            } else if q == OS_Q_FRESH && os_has_drop(c, module, table, u.name) {
                yes = true;
            } else if q == OS_Q_LOOSE_RAW
                && (type_name_is(table.lookup(u.name), "Vec")
                    || type_name_is(table.lookup(u.name), "String")
                    || type_name_is(table.lookup(u.name), "ByteVec")
                    || type_name_is(table.lookup(u.name), "HashMap")
                    || os_has_drop(c, module, table, u.name)) {
                yes = false;
            } else {
                match module.typedefs[u.id as usize] {
                    ILTypeDef.Struct(st) => {
                        for f in st.fields {
                            if os_type_has(c, module, table, f.ty, q) { yes = true; }
                        }
                    },
                    ILTypeDef.Enum(en) => {
                        for v in en.variants {
                            if v.payload != 0 as u32
                                && os_type_has(c, module, table, v.payload, q) {
                                yes = true;
                            }
                        }
                    },
                    ILTypeDef.Fn(_) => { yes = q == OS_Q_HANDLE; },
                }
            }
        },
    }
    c.q_memo[m] = if yes { 2 as u8 } else { 1 as u8 };
    return yes;
}

// DST = the destination SRC names, with its reach (§3, _Destination reach_): each Frame(L) in it
// adds the storage L owns, S(L), and, when L's type can hold a mutable handle, what L holds, O(L),
// to a fixpoint. Following O(L) for every type would refuse `v.push(arena_str)` after
// `v.push("lit")` put Static in O(v). When L's only handles are `fn` values and it holds no raw
// `*mut` pointer, O(L) adds no Static: a `fn` value names no memory but its environment, and a
// `fn` item's Static is its code. When L holds a raw `*mut` pointer and no mutable handle, the
// pointer not part of an owner (OS_Q_LOOSE_RAW), only the Static in O(L) is added: it may name a
// `static mut`. The rest of
// O(L) is what the memory it points to holds, not where it points, and following it would make a
// store through it a store into those values. An owner's raw pointers (a `Vec`'s buffer, an
// `Arena`'s header) point into what it owns, S(L), so a `static`'s address one of its elements
// holds is no destination of a push. A capture alias's slot is the environment's memory, so a
// Frame of one adds ParamContents(`__env`) (§3, _Closure environments_).
fn os_dest_reach(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    src: usize,
    dst: usize
) {
    os_dest_reach_impl(c, module, table, locals, src, dst, true);
}

fn os_handle_reach(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    src: usize,
    dst: usize
) {
    os_dest_reach_impl(c, module, table, locals, src, dst, false);
}

fn os_dest_reach_impl(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    src: usize,
    dst: usize,
    include_storage: bool
) {
    os_copy(c, dst, src);
    let mut more = true;
    while more {
        more = false;
        let mut id = 1 as usize;
        while id < c.nl {
            if os_has_frame(c, dst, id) {
                if include_storage && os_or(c, dst, c.nl + id) { more = true; }
                let lty = os_local_ty(locals, id as u32);
                if !os_type_has(c, module, table, lty, OS_Q_HANDLE)
                    && os_type_has(c, module, table, lty, OS_Q_LOOSE_RAW)
                    && c.buf[id * c.words + OS_W_FLAGS] & ORIGIN_STATIC != 0 as u64 {
                    os_add_flag(c, dst, ORIGIN_STATIC);
                }
                // A loose raw local holds no owner, so following its parameter words cannot pull
                // in a Vec's elements; include them so stores reach caller parameters.
                if !os_type_has(c, module, table, lty, OS_Q_HANDLE)
                    && os_type_has(c, module, table, lty, OS_Q_LOOSE_RAW) {
                    let dw = dst * c.words;
                    let lw = id * c.words;
                    c.buf[dw + OS_W_ADDR] = c.buf[dw + OS_W_ADDR] | c.buf[lw + OS_W_ADDR];
                    c.buf[dw + OS_W_CONTENTS] = c.buf[dw + OS_W_CONTENTS]
                        | c.buf[lw + OS_W_CONTENTS];
                }
                if os_type_has(c, module, table, lty, OS_Q_HANDLE) {
                    let held = os_t(c, OS_T_DR);
                    os_copy(c, held, id);
                    if !os_type_has(c, module, table, lty, OS_Q_REF_HANDLE) {
                        let fw = held * c.words + OS_W_FLAGS;
                        c.buf[fw] = c.buf[fw] & !ORIGIN_STATIC;
                    }
                    if os_or(c, dst, held) { more = true; }
                }
            }
            id = id + 1 as usize;
        }
    }
    if os_meets_frames(c, dst, os_t(c, OS_T_CAP)) { os_add_contents(c, dst, c.env_param); }
}

// Fills OS_T_CAP, OS_T_OWNCAP and cap_bit for the capture aliases of a closure body. Each capture
// gets its own ParamContents bit past `__env`, so the body can tell what one capture holds from what
// another does: a store into an owned capture of anything but its own contents is an edge into a
// global (os_note_edges). Past bit 62 a capture keeps ParamContents(`__env`) and no bit of its own,
// which only refuses more at the caller.
fn os_cap_bits(c: &mut OriginSets, module: &ILModule, table: &InternTable, locals: [Local]) {
    let cap = os_t(c, OS_T_CAP);
    let owncap = os_t(c, OS_T_OWNCAP);
    let mut next = c.env_param + 1 as usize;
    let mut li = 1 as usize;
    while li < c.nl {
        if locals[li - 1 as usize].is_capture_alias {
            os_add_frame(c, cap, li as u32);
            if os_owns(c, module, table, locals[li - 1 as usize].ty) {
                os_add_frame(c, owncap, li as u32);
            }
            if next < 63 as usize {
                c.cap_bit[li] = next as u8;
                next = next + 1 as usize;
            }
        }
        li = li + 1 as usize;
    }
}

// In SET, the value capture alias ID was loaded from the environment: ParamContents(`__env`)
// becomes the capture's own bit.
fn os_env_to_cap(c: &mut OriginSets, set: usize, id: usize) {
    let w = set * c.words + OS_W_CONTENTS;
    let e = (1 as u64) << (c.env_param as u64);
    if c.buf[w] & e != 0 as u64 {
        c.buf[w] = (c.buf[w] & !e) | ((1 as u64) << (c.cap_bit[id] as u64));
    }
}

// Whether argument J of a call to FN_ID is a declared parameter of a `fn` type.
fn os_fn_param(c: &OriginSets, module: &ILModule, fn_id: u32, j: usize) -> bool {
    if fn_id as usize >= module.functions.len() || j >= 63 as usize { return false; }
    if c.known_env != OS_NO_ENV && j >= c.known_env { return false; }
    let f = &module.functions[fn_id as usize];
    let base = if f.params_len > 0 as usize && f.param(0).name == c.sret_name {
        1 as usize
    } else {
        0 as usize
    };
    if j + base >= f.params_len { return false; }
    let ty = f.param(j + base).ty;
    if ty == 0 as u32 || ty as usize > module.types.len() { return false; }
    return os_type_def_tag(module, ty) == ILTYPE_FN;
}

// SET joins what one read through it yields (os_through).
fn os_add_read(c: &mut OriginSets, set: usize) {
    let tb = os_t(c, OS_T_B);
    os_through(c, set, tb);
    let _ = os_or(c, set, tb);
}

// Whether sets A and B share a Frame origin.
fn os_meets_frames(c: &OriginSets, a: usize, b: usize) -> bool {
    let x = a * c.words;
    let y = b * c.words;
    let mut k = OS_W_FRAME;
    while k < c.words {
        if c.buf[x + k] & c.buf[y + k] != 0 as u64 { return true; }
        k = k + 1 as usize;
    }
    return false;
}

// Takes out of VAL the storage of an owned capture that a store writes back into the same capture:
// DEST, the memory the store names before its reach, is that one capture (Frame(L) alone, L a
// capture alias whose type holds no mutable handle, so the store reaches nothing beyond L's slot
// and the storage L owns). That is `v.push(x)` on a closure's owned `Vec` v: the buffer stays the
// environment's, as a local `Vec`'s stays this frame's. Stored anywhere else, an owned capture's
// storage is still an address of this frame (§3, _Closure environments_).
fn os_drop_self_store(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    val: usize,
    dest: usize
) {
    let d = dest * c.words;
    if c.buf[d + OS_W_ADDR] | c.buf[d + OS_W_CONTENTS] | (c.buf[d + OS_W_FLAGS] & OS_FLAGS_MEMORY)
        != 0 as u64 {
        return;
    }
    let mut id = 0 as usize;
    let mut k = OS_W_FRAME;
    while k < c.words {
        let fr = c.buf[d + k];
        if fr != 0 as u64 {
            if id != 0 as usize || fr & (fr - 1 as u64) != 0 as u64 { return; }
            let mut b = 0 as usize;
            while (fr >> (b as u64)) & 1 as u64 == 0 as u64 { b = b + 1 as usize; }
            id = (k - OS_W_FRAME) * 64 as usize + b;
        }
        k = k + 1 as usize;
    }
    if id == 0 as usize || !os_has_frame(c, os_t(c, OS_T_CAP), id) { return; }
    if os_type_has(c, module, table, os_local_ty(locals, id as u32), OS_Q_HANDLE) { return; }
    let w = val * c.words + OS_W_FRAME + id / 64 as usize;
    c.buf[w] = c.buf[w] & !((1 as u64) << ((id % 64 as usize) as u64));
}

// Whether a destination with origins SET outlives this frame: it has any origin but this frame's
// Frame origins (a Param, Static or Unknown).
fn os_external(c: &OriginSets, set: usize) -> bool {
    let d = set * c.words;
    return c.buf[d + OS_W_ADDR] != 0 as u64
        || c.buf[d + OS_W_CONTENTS] != 0 as u64
        || c.buf[d + OS_W_FLAGS] & OS_FLAGS_MEMORY != 0 as u64;
}

// Whether a value with origins SET may not leave this frame: it has a Frame or an Unknown origin.
// Takes out of SET the frame storage a stored value owns and does not hold an address into
// (Frame bits in VS, not in VO): an owner is moved by the store, and the storage it owns goes with
// it, as an edge into a local leaves out what that local owns (§3, _The summary as built_). A
// Frame bit also in VO stays: an arena-backed collection holds its local arena's Frame in both.
fn os_drop_moved_storage(c: &mut OriginSets, set: usize, vo: usize, vs: usize) {
    let d = set * c.words;
    let o = vo * c.words;
    let s = vs * c.words;
    let mut k = OS_W_FRAME;
    while k < c.words {
        c.buf[d + k] = c.buf[d + k] & !(c.buf[s + k] & !c.buf[o + k]);
        k = k + 1 as usize;
    }
}

// DST = the frame storage os_drop_moved_storage takes out: what the stored value owns and holds no
// address into. It joins the storage a target owner owns, not the addresses it holds.
fn os_moved_storage(c: &mut OriginSets, dst: usize, vo: usize, vs: usize) {
    os_clear(c, dst);
    let d = dst * c.words;
    let o = vo * c.words;
    let s = vs * c.words;
    let mut k = OS_W_FRAME;
    while k < c.words {
        c.buf[d + k] = c.buf[s + k] & !c.buf[o + k];
        k = k + 1 as usize;
    }
}

fn os_frame_bound(c: &OriginSets, set: usize) -> bool {
    let d = set * c.words;
    if c.buf[d + OS_W_FLAGS] & ORIGIN_UNKNOWN != 0 as u64 { return true; }
    let mut k = OS_W_FRAME;
    while k < c.words {
        if c.buf[d + k] != 0 as u64 { return true; }
        k = k + 1 as usize;
    }
    return false;
}

fn os_is_c_fn_ptr(module: &ILModule, ty: u32) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() { return false; }
    let def = &module.types[ty as usize - 1 as usize].def;
    if let ILType.Fn(f) = *def { return f.c_abi; }
    if let ILType.RawPtr(inner) = *def {
        if inner != 0 as u32 && inner as usize <= module.types.len() {
            let idef = &module.types[inner as usize - 1 as usize].def;
            if let ILType.Fn(f) = *idef { return f.c_abi; }
        }
    }
    return false;
}

fn os_has_frame_or_param(c: &OriginSets, set: usize) -> bool {
    let d = set * c.words;
    if c.buf[d + OS_W_ADDR] != 0 as u64 || c.buf[d + OS_W_CONTENTS] != 0 as u64 {
        return true;
    }
    let mut k = OS_W_FRAME;
    while k < c.words {
        if c.buf[d + k] != 0 as u64 { return true; }
        k = k + 1 as usize;
    }
    return false;
}

// Records that a value with origins VAL is stored into the memory MEM names, as edges of this
// body's summary: each parameter origin of the value against each parameter origin of the memory.
// Memory that is Static or Unknown is a global; a Frame origin of the value reads as Unknown,
// which is what the caller has to assume, except a capture alias's: what an owned capture owns
// is reached through the environment, ParamContents(`__env`), and the rules have already refused
// it everywhere but back into its own capture (os_drop_self_store). Frame memory is this frame's
// and no edge. A capture's own bit stays its own (cap_bit), which a caller maps to the capture.
fn os_note_edges(c: &mut OriginSets, val: usize, mem: usize, extra_flags: u64) {
    let m = mem * c.words;
    let t_addr = c.buf[m + OS_W_ADDR];
    let t_contents = c.buf[m + OS_W_CONTENTS];
    let t_flags = if c.buf[m + OS_W_FLAGS] & OS_FLAGS_MEMORY != 0 as u64 {
        OS_EDGE_GLOBAL | extra_flags
    } else {
        extra_flags
    };
    if t_addr == 0 as u64
        && t_contents == 0 as u64
        && (t_flags & (OS_EDGE_GLOBAL | OS_EDGE_ENV)) == 0 as u64 {
        return;
    }
    // An owned capture outlives the frame (§3, the store rule), so what the memory may take from
    // anywhere but the capture itself (its own bit, its own storage) goes into a global too.
    let owncap = os_t(c, OS_T_OWNCAP) * c.words;
    let mut own_bits = 0 as u64;
    let mut og = 0 as u64;
    let mut id = 1 as usize;
    while id < c.nl {
        if os_has_frame(c, mem, id) && os_has_frame(c, os_t(c, OS_T_OWNCAP), id) {
            og = OS_EDGE_ENV;
            if c.cap_bit[id] != 0 as u8 {
                own_bits = own_bits | ((1 as u64) << (c.cap_bit[id] as u64));
            }
        }
        id = id + 1 as usize;
    }
    let e = if c.env_param < 63 as usize { c.env_param } else { 63 as usize };
    let v = val * c.words;
    let mut i = 0 as usize;
    while i < 64 as usize {
        if (c.buf[v + OS_W_ADDR] >> (i as u64)) & 1 as u64 != 0 as u64 {
            os_note_edge_row(c, i, t_addr, t_contents, t_flags | og);
        }
        if (c.buf[v + OS_W_CONTENTS] >> (i as u64)) & 1 as u64 != 0 as u64 {
            let g = if (own_bits >> (i as u64)) & 1 as u64 != 0 as u64 { 0 as u64 } else { og };
            os_note_edge_row(c, 64 as usize + i, t_addr, t_contents, t_flags | g);
        }
        i = i + 1 as usize;
    }
    let vf = c.buf[v + OS_W_FLAGS];
    if vf & ORIGIN_STATIC != 0 as u64 {
        os_note_edge_row(c, OS_EDGE_STATIC, t_addr, t_contents, t_flags);
    }
    if vf & ORIGIN_RODATA != 0 as u64 {
        os_note_edge_row(c, OS_EDGE_RODATA, t_addr, t_contents, t_flags);
    }
    let mut unknown = vf & ORIGIN_UNKNOWN != 0 as u64;
    let mut env_own = false;
    let mut env_other = false;
    let cap = os_t(c, OS_T_CAP) * c.words;
    let mut k = OS_W_FRAME;
    while k < c.words {
        let fr = c.buf[v + k];
        if fr & !c.buf[cap + k] != 0 as u64 { unknown = true; }
        let own = c.buf[m + k] & c.buf[owncap + k];
        if fr & c.buf[cap + k] & own != 0 as u64 { env_own = true; }
        if fr & c.buf[cap + k] & !own != 0 as u64 { env_other = true; }
        k = k + 1 as usize;
    }
    if env_own { os_note_edge_row(c, 64 as usize + e, t_addr, t_contents, t_flags); }
    if env_other { os_note_edge_row(c, 64 as usize + e, t_addr, t_contents, t_flags | og); }
    if unknown { os_note_edge_row(c, OS_EDGE_UNKNOWN, t_addr, t_contents, t_flags | og); }
}

fn os_note_edge_row(c: &mut OriginSets, row: usize, t_addr: u64, t_contents: u64, t_flags: u64) {
    let r = row * 3 as usize;
    c.edges[r] = c.edges[r] | t_addr;
    c.edges[r + 1 as usize] = c.edges[r + 1 as usize] | t_contents;
    c.edges[r + 2 as usize] = c.edges[r + 2 as usize] | t_flags;
}

// Reports one refusal of the rules at the statement being checked (c.span), at most once per
// site and rule.
fn os_mark_diag(c: &mut OriginSets, rule: u8) -> bool {
    let mut i = 0 as usize;
    while i < c.seen_diags_len {
        let d = &c.seen_diags[i];
        if d.rule == rule && d.span.line == c.span.line && d.span.col == c.span.col {
            return false;
        }
        i = i + 1 as usize;
    }
    if c.seen_diags_len < c.seen_diags.len {
        c.seen_diags[c.seen_diags_len] = OsSeenDiag { span: c.span, rule: rule };
        c.seen_diags_len = c.seen_diags_len + 1 as usize;
    }
    return true;
}

fn os_has_any_frame(c: &OriginSets, set: usize) -> bool {
    let d = set * c.words;
    let mut k = OS_W_FRAME;
    while k < c.words {
        if c.buf[d + k] != 0 as u64 { return true; }
        k = k + 1 as usize;
    }
    return false;
}

fn os_origin_msg(c: &OriginSets, set: usize, frame_msg: [u8], unknown_msg: [u8]) -> [u8] {
    if os_has_any_frame(c, set) { return frame_msg; }
    return unknown_msg;
}

fn os_refuse(c: &mut OriginSets, rule: u8, msg: [u8]) {
    if !os_mark_diag(c, rule) { return; }
    c.errors = c.errors + 1 as u32;
    diag_start(c.file, c.span, if c.rules == PROVENANCE_WARN { "warning" } else { "error" });
    eprint("provenance: ");
    eprint(msg);
    eprint("\n");
}

// The type of field NAME of struct type TY, 0 when TY is no struct or has no such field.
fn os_field_type(module: &ILModule, ty: u32, name: u32) -> u32 {
    if os_type_def_tag(module, ty) != ILTYPE_USER { return 0 as u32; }
    let uid = module.types[ty as usize - 1 as usize].def.get_User().id;
    if uid == 0xffffffff as u32 || uid as usize >= module.typedefs.len() { return 0 as u32; }
    if let ILTypeDef.Struct(st) = module.typedefs[uid as usize] {
        for f in st.fields {
            if f.name == name { return f.ty; }
        }
    }
    return 0 as u32;
}

// The element type of a `Vec<T>`, 0 for any other type: what codegen's index_addr indexes in the
// Vec's buffer (get_slice_element_type, by the same name test).
fn os_vec_element(module: &ILModule, table: &InternTable, ty: u32) -> u32 {
    if os_type_def_tag(module, ty) != ILTYPE_USER { return 0 as u32; }
    let u = module.types[ty as usize - 1 as usize].def.get_User();
    if !type_name_is(table.lookup(u.name), "Vec") || u.type_args.len == 0 as usize {
        return 0 as u32;
    }
    return u.type_args[0];
}

// The memory place P lies in. With no pointer crossed it is the base local's own slot
// (`c.walk_crossed` false); otherwise OS_T_M holds that memory's origins. A projection on a
// pointer steps through it, as does an index or dereference of a slice (a field of a slice, its
// length or data pointer, is in the slice's own slot). A box is a value wrapper, not a pointer
// (§3, _Details the transfer needs_): its sets already hold its contents', so `*b` and `(*b).s`
// stay in the box's own slot. Returns P's type, 0 when the walk lost it: the memory is then
// everything the base reaches, and Unknown.
fn os_walk(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    p: &Place
) -> u32 {
    let tm = os_t(c, OS_T_M);
    let ta = os_t(c, OS_T_A);
    os_clear(c, tm);
    c.walk_len = false;
    let mut ty = os_local_ty(locals, p.base);
    let mut crossed = false;
    // For the Index at idx_at, as codegen's index_addr sees it: whether the type it starts at is a
    // `&mut`/`*mut` (a `Vec` reached so is an array of Vecs), and whether a pointer or box layer was
    // dereferenced for it (indexing what is left is pointer arithmetic over that memory).
    let mut idx_at = p.projections.len;
    let mut idx_mut = false;
    let mut idx_ptr = false;
    let mut i = 0 as usize;
    while i < p.projections.len {
        if ty == 0 as u32 || ty as usize > module.types.len() {
            if crossed {
                os_through(c, tm, ta);
                let _ = os_or(c, tm, ta);
            } else {
                os_add_frame(c, tm, p.base);
                let _ = os_or(c, tm, p.base as usize);
                let _ = os_or(c, tm, c.nl + p.base as usize);
            }
            os_add_flag(c, tm, ORIGIN_UNKNOWN);
            c.walk_crossed = true;
            return 0 as u32;
        }
        let tag = os_type_def_tag(module, ty);
        let is_index = match p.projections[i] {
            Projection.Index(_) => true,
            Projection.Deref | Projection.Field(_) | Projection.TupleIndex(_) => false,
        };
        if is_index && idx_at != i {
            idx_at = i;
            idx_mut = is_mut_pointer_tag(tag);
            idx_ptr = false;
        }
        if tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            ty = os_pointee(module, ty);
            match p.projections[i] {
                Projection.Deref => { i = i + 1 as usize; },
                Projection.Index(_) => { idx_ptr = true; },
                Projection.Field(_) | Projection.TupleIndex(_) => {},
            }
            continue;
        }
        let mut steps_in = is_any_pointer_tag(tag);
        let mut consumes = false;
        match p.projections[i] {
            Projection.Deref => { consumes = true; },
            Projection.Index(_) => {
                if tag == ILTYPE_SLICE {
                    steps_in = true;
                    consumes = true;
                }
            },
            Projection.Field(_) | Projection.TupleIndex(_) => {},
        }
        if steps_in {
            if crossed {
                os_through(c, tm, ta);
                os_copy(c, tm, ta);
            } else {
                let _ = os_or(c, tm, p.base as usize);
                let _ = os_or(c, tm, c.nl + p.base as usize);
                crossed = true;
            }
            ty = os_pointee(module, ty);
            if consumes { i = i + 1 as usize; } else if is_index { idx_ptr = true; }
            continue;
        }
        match p.projections[i] {
            Projection.Field(name) => {
                // A slice's length is a count, not an address: it carries none of the origins of
                // the slice's pointer, which field-insensitive sets would otherwise give it
                // (`self.len = self.len + other.len` would read as storing `other` into `self`).
                if tag == ILTYPE_SLICE
                    && i + 1 as usize == p.projections.len
                    && table.lookup(name) == "len" {
                    c.walk_len = true;
                }
                ty = os_field_type(module, ty, name);
            },
            Projection.TupleIndex(idx) => {
                if tag == ILTYPE_TUPLE {
                    let elems = module.types[ty as usize - 1 as usize].def.get_Tuple();
                    ty = if (idx as usize) < elems.len { elems[idx as usize] } else { 0 as u32 };
                } else if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else {
                    ty = 0 as u32;
                }
            },
            // As codegen's index_addr: an array is indexed in place; a Vec (not reached through a
            // `&mut`/`*mut`) through its buffer pointer, so the element is memory the Vec's pointer
            // reaches, as for a slice; anything else reached through a pointer or box is pointer
            // arithmetic over that memory, of the same type.
            Projection.Index(_) => {
                let elem = os_vec_element(module, table, ty);
                if tag == ILTYPE_ARRAY {
                    ty = module.types[ty as usize - 1 as usize].def.get_Array().element;
                } else if elem != 0 as u32 && !idx_mut {
                    if crossed {
                        os_through(c, tm, ta);
                        os_copy(c, tm, ta);
                    } else {
                        let _ = os_or(c, tm, p.base as usize);
                        let _ = os_or(c, tm, c.nl + p.base as usize);
                        crossed = true;
                    }
                    ty = elem;
                } else if !idx_ptr {
                    ty = 0 as u32;
                }
            },
            // A dereference of a type that is not a pointer: the walk has lost the type.
            Projection.Deref => {
                ty = 0 as u32;
                continue;
            },
        }
        i = i + 1 as usize;
    }
    c.walk_crossed = crossed;
    return ty;
}

// Adds what reading P yields to DST_O (the addresses) and DST_S (the storage the value owns).
// From the base's own slot: its sets. Through a pointer: what that memory holds (os_through_split); the
// value's own storage comes along only when its type owns any. Returns P's type.
fn os_read(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    p: &Place,
    dst_o: usize,
    dst_s: usize
) -> u32 {
    if p.base == 0 as u32 { return 0 as u32; }
    let ty = os_walk(c, module, table, locals, p);
    if c.walk_len { return ty; }
    if ty != 0 as u32 && !os_carries(c, module, ty) { return ty; }
    if !c.walk_crossed {
        let _ = os_or(c, dst_o, p.base as usize);
        let _ = os_or(c, dst_s, c.nl + p.base as usize);
        return ty;
    }
    let tm = os_t(c, OS_T_M);
    let ta = os_t(c, OS_T_A);
    os_clear(c, ta);
    if os_owns(c, module, table, ty) {
        os_through_split(c, tm, dst_o, dst_s);
    } else {
        os_through_split(c, tm, dst_o, ta);
    }
    return ty;
}

// Adds the origins of the address `&P` to DST: the base's slot, or the memory a pointer led to.
fn os_addr(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    p: &Place,
    dst: usize
) {
    if p.base == 0 as u32 { return; }
    let _ = os_walk(c, module, table, locals, p);
    if c.walk_crossed {
        let tm = os_t(c, OS_T_M);
        let _ = os_or(c, dst, tm);
    } else {
        os_add_frame(c, dst, p.base);
    }
}

// Adds VO and VS to every local whose memory MEM names (its Frame origins); other origins are
// memory outside the frame, which the store rule (not these sets) is about.
fn os_write_memory(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    mem: usize,
    vo: usize,
    vs: usize
) {
    let mut id = 1 as usize;
    while id < c.nl {
        let lty = os_local_ty(locals, id as u32);
        if os_has_frame(c, mem, id) && os_carries(c, module, lty) {
            if os_or(c, id, vo) { c.changed = true; }
            if os_owns(c, module, table, lty) && os_or(c, c.nl + id, vs) { c.changed = true; }
        }
        id = id + 1 as usize;
    }
}

// Argument K of an unknown call into OS_T_AO (what it holds) and OS_T_AS (what it owns). For a
// `CallPtr`, K = ARGS.len is the callee's environment, an implicit read-write argument: the memory
// the closure value points at, os_through(O(callee)) (§3, _Closure environments_). A `fn` value of
// Static origin is a function with no environment (a capturing closure's value holds its
// environment's Frame), so it adds no memory.
fn os_unknown_arg(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    args: [Place],
    callee: &Place,
    k: usize
) -> u32 {
    let tao = os_t(c, OS_T_AO);
    let tas = os_t(c, OS_T_AS);
    let ta = os_t(c, OS_T_X);
    os_clear(c, tao);
    os_clear(c, tas);
    if k < args.len {
        return os_read(c, module, table, locals, &args[k], tao, tas);
    }
    os_clear(c, ta);
    let _ = os_read(c, module, table, locals, callee, ta, tas);
    os_clear(c, tas);
    let w = ta * c.words + OS_W_FLAGS;
    c.buf[w] = c.buf[w] & !ORIGIN_STATIC;
    os_env_frames_only(c, module, locals, ta);
    os_through(c, ta, tao);
    return 0 as u32;
}

// Takes out of SET, the origins of a `fn` value, every Frame(L) whose L is not a tuple. A `fn`
// value made in this frame points at its environment, which is always a tuple local
// (build_closure_env's `&env`), so another Frame in it is a field-insensitive set's spill (a tuple
// parameter's summary storing `p.0` into itself) or the storage the local holding the value owns,
// neither of which the call can reach. What the environment holds is still followed from Frame(E).
fn os_env_frames_only(c: &mut OriginSets, module: &ILModule, locals: [Local], set: usize) {
    let mut id = 1 as usize;
    while id < c.nl {
        if os_has_frame(c, set, id) {
            let ty = os_local_ty(locals, id as u32);
            let mut keep = ty == 0 as u32;
            if !keep {
                if let ILType.Tuple(_) = module.types[ty as usize - 1 as usize].def { keep = true; }
            }
            if !keep {
                let w = set * c.words + OS_W_FRAME + id / 64 as usize;
                c.buf[w] = c.buf[w] & !((1 as u64) << ((id % 64 as usize) as u64));
            }
        }
        id = id + 1 as usize;
    }
}

fn os_add_releases(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    src: usize,
    to_env: bool
) {
    let tr = os_t(c, OS_T_R);
    os_copy(c, tr, src);
    let mut more = true;
    while more {
        more = false;
        let mut id = 1 as usize;
        while id < c.nl {
            if os_has_frame(c, tr, id) {
                if os_or(c, tr, c.nl + id) { more = true; }
                let lty = os_local_ty(locals, id as u32);
                if os_type_has(c, module, table, lty, OS_Q_HANDLE) {
                    if os_or(c, tr, id) { more = true; }
                }
            }
            id = id + 1 as usize;
        }
    }
    let rw = tr * c.words;
    let bits = c.buf[rw + OS_W_ADDR] | c.buf[rw + OS_W_CONTENTS];
    if to_env {
        c.env_releases = c.env_releases | bits;
    } else {
        c.releases = c.releases | bits;
    }
}

// What a call to a callee with no usable summary (a `fn` value, a body not read yet) does to the
// caller's locals: it may store anything every argument reaches, and EXTRA, into anything any
// argument reaches (§3, "counts as storing every reference argument into every other"). EXTRA is
// Unknown for a body not read, Static for a `fn` value, whose body these rules checked where it
// was made (§3, _Calls through a `fn` value_). A target's S grows only by what the stored values
// own, so not by EXTRA: otherwise a call would make its own arguments' storage external and refuse
// itself in the rule pass. NARGS is ARGS.len, plus one for a `CallPtr`'s environment. The rule
// pass checks every argument against every other, itself included.
fn os_unknown_call_effects(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    args: [Place],
    callee: &Place,
    nargs: usize,
    extra: u64
) {
    let tao = os_t(c, OS_T_AO);
    let tas = os_t(c, OS_T_AS);
    let tr = os_t(c, OS_T_R);
    let tsv = os_t(c, OS_T_SV);
    let tso = os_t(c, OS_T_SO);
    let tw = os_t(c, OS_T_W);
    let tv = os_t(c, OS_T_V);
    let td = os_t(c, OS_T_D);
    os_clear(c, tsv);
    os_clear(c, tso);
    let mut cal_fn_ty = 0 as u32;
    if callee.base != 0 as u32 {
        let cty = os_walk(c, module, table, locals, callee);
        if cty != 0 as u32 && os_type_def_tag(module, cty) == ILTYPE_FN { cal_fn_ty = cty; }
    }
    let mut k = 0 as usize;
    while k < nargs {
        let mut aty = os_unknown_arg(c, module, table, locals, args, callee, k);
        let _ = os_or(c, tso, tas);
        let _ = os_or(c, tao, tas);
        os_reach_all(c, tao, tr);
        let _ = os_or(c, tsv, tr);
        if aty == 0 as u32 && k < args.len && cal_fn_ty != 0 as u32 {
            if let ILType.Fn(fn_t) = module.types[cal_fn_ty as usize - 1 as usize].def {
                if k < fn_t.params.len { aty = fn_t.params[k]; }
            }
        }
        let can_rel = if k < args.len {
            if aty == 0 as u32 {
                true
            } else {
                let tag = os_type_def_tag(module, aty);
                !is_raw_pointer_tag(tag)
                    && (os_type_has(c, module, table, aty, OS_Q_HANDLE)
                        || os_owns(c, module, table, aty))
            }
        } else {
            false
        };
        if can_rel && k < args.len {
            os_add_releases(c, module, table, locals, tao, false);
        } else if k == args.len {
            os_add_releases(c, module, table, locals, tao, true);
        }
        k = k + 1 as usize;
    }
    // The summary's edges carry what the arguments reach (os_note_edges below), not this Unknown:
    // a `fn` value's body was checked where it was made, so what it stores is something its
    // arguments reach, and an Unknown edge would refuse every caller handing it a closure.
    let ev = os_t(c, OS_T_EV);
    os_copy(c, ev, tsv);
    let _ = os_or(c, ev, tso);
    os_add_flag(c, tsv, extra);
    if c.checking {
        let mut refused = false;
        let mut i = 0 as usize;
        while i < nargs && !refused {
            let _ = os_unknown_arg(c, module, table, locals, args, callee, i);
            let _ = os_or(c, tao, tas);
            os_reach_all(c, tao, tv);
            if os_frame_bound(c, tv) {
                let mut j = 0 as usize;
                while j < nargs && !refused {
                    let jty = os_unknown_arg(c, module, table, locals, args, callee, j);
                    if j < args.len
                        && jty != 0 as u32
                        && !os_holds_pointer(module, jty, 0 as usize) {
                        j = j + 1 as usize;
                        continue;
                    }
                    let _ = os_or(c, tao, tas);
                    let sf = os_t(c, OS_T_SF);
                    os_copy(c, sf, tv);
                    os_drop_self_store(c, module, table, locals, sf, tao);
                    os_dest_reach(c, module, table, locals, tao, td);
                    if os_frame_bound(c, sf) && os_external(c, td) {
                        os_refuse(
                            c,
                            OS_RULE_UNKNOWN_CALL,
                            os_origin_msg(
                                c,
                                sf,
                                "a call with no store summary may store an address of this frame into memory that outlives it (unknown-call store rule)",
                                "a call with no store summary may store an address the compiler cannot trace into memory that outlives it (unknown-call store rule)"
                            )
                        );
                        refused = true;
                    }
                    j = j + 1 as usize;
                }
            }
            i = i + 1 as usize;
        }
    }
    let ed = os_t(c, OS_T_ED);
    k = 0 as usize;
    while k < nargs {
        let kty = os_unknown_arg(c, module, table, locals, args, callee, k);
        if k < args.len && kty != 0 as u32 && !os_holds_pointer(module, kty, 0 as usize) {
            k = k + 1 as usize;
            continue;
        }
        let _ = os_or(c, tao, tas);
        os_dest_reach(c, module, table, locals, tao, ed);
        os_note_edges(c, ev, ed, OS_EDGE_REF);
        os_reach_all(c, tao, tw);
        os_write_memory(c, module, table, locals, tw, tsv, tso);
        k = k + 1 as usize;
    }
}

// Fills known_fn: a local is a known callee when every value the body assigns to it, directly or by
// a plain copy of another known local, is a `FuncAddr` of one function (§3, _Calls through a
// known callee_). A reference taken to it (shared too: a cast makes it writable in `unsafe`), a
// write into a projection of it, or any other value makes it OS_KNOWN_NONE, so a local a callee
// could reassign through a pointer is never known. Order does not matter, as the sets do not. A
// copy of a local joins nothing until that local is known; once no round changes anything, a copy
// of a local still not known (a parameter, a call's result) makes the copy unknown (STRICT).
fn os_known_callees(c: &mut OriginSets, func: &ZirFunction) {
    let mut strict = false;
    let mut more = true;
    while more || !strict {
        if !more { strict = true; }
        more = false;
        for b in (*func).blocks {
            for st in b.statements {
                match *st {
                    ZirStmt.Let(id, rv, _) => {
                        if os_known_def(c, id, &rv, strict) { more = true; }
                    },
                    ZirStmt.Assign(p, rv, _) => {
                        if p.projections.len == 0 as usize {
                            if os_known_def(c, p.base, &rv, strict) { more = true; }
                        } else {
                            if os_known_set(c, p.base, OS_KNOWN_NONE) { more = true; }
                            if os_known_refs(c, &rv) { more = true; }
                        }
                    },
                    ZirStmt.Drop(_, _)
                        | ZirStmt.DropIfLive(_, _)
                        | ZirStmt.EndBorrow(_, _)
                        | ZirStmt.Intrinsic(_, _, _) => {},
                }
            }
        }
    }
}

// Joins V into known_fn[ID]; whether it changed.
fn os_known_set(c: &mut OriginSets, id: u32, v: u32) -> bool {
    if id == 0 as u32 || id as usize >= c.nl || v == 0 as u32 { return false; }
    let old = c.known_fn[id as usize];
    let new = if old == 0 as u32 || old == v { v } else { OS_KNOWN_NONE };
    if new == old { return false; }
    c.known_fn[id as usize] = new;
    return true;
}

// A reference to a local makes it unknown: whatever holds the reference may write it.
fn os_known_refs(c: &mut OriginSets, rv: &ZirRvalue) -> bool {
    return match *rv {
        ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => os_known_set(c, p.base, OS_KNOWN_NONE),
        _ => false,
    };
}

fn os_known_def(c: &mut OriginSets, id: u32, rv: &ZirRvalue, strict: bool) -> bool {
    let refs = os_known_refs(c, rv);
    let v = match *rv {
        ZirRvalue.FuncAddr(fid, env) => {
            (fid + 1 as u32) | (if env != 0 as u32 { OS_KNOWN_ENV } else { 0 as u32 })
        },
        ZirRvalue.Use(p) => {
            if p.projections.len == 0 as usize && p.base as usize < c.nl {
                let k = c.known_fn[p.base as usize];
                if strict && k == 0 as u32 { OS_KNOWN_NONE } else { k }
            } else {
                OS_KNOWN_NONE
            }
        },
        _ => OS_KNOWN_NONE,
    };
    return os_known_set(c, id, v) || refs;
}

// Fills env_of, env_first, env_n and env_caps: a known closure's calls read its environment field
// by field (os_arg) when the tuple E is built once (`E = (a, b, ..)` of plain locals), its address
// P = &E is taken once and only made into the closure (`FuncAddr(f, P)`), and every local holding
// the closure only calls it or copies it into another such local. Then nothing but those calls
// writes into E after it is built, and each of them adds what it stores into a slot to every
// element's local too, so the element local holds all field j ever holds. A use of E, P or a
// closure local anywhere else (an argument, a capture of another closure, a return) leaves the
// environment one value (env_of 0).
fn os_known_envs(c: &mut OriginSets, func: &ZirFunction) {
    let nl = c.nl;
    // SAFETY: NL bytes and NL u32 in the body's scratch arena, zeroed before any read.
    let ndef = unsafe { @slice(zoril_allocator_alloc(c.arena, nl) as *mut u8, nl) };
    // SAFETY: as above.
    let bad = unsafe { @slice(zoril_allocator_alloc(c.arena, nl) as *mut u8, nl) };
    // SAFETY: as above.
    let nref = unsafe { @slice(zoril_allocator_alloc(c.arena, nl) as *mut u8, nl) };
    // SAFETY: as above.
    let refof = unsafe { @slice(zoril_allocator_alloc(c.arena, nl * 4) as *mut u32, nl) };
    // SAFETY: as above.
    let envp = unsafe { @slice(zoril_allocator_alloc(c.arena, nl * 4) as *mut u32, nl) };
    unsafe {
        memset(ndef.ptr as *mut u8, 0, nl as u64);
        memset(bad.ptr as *mut u8, 0, nl as u64);
        memset(nref.ptr as *mut u8, 0, nl as u64);
        memset(refof.ptr as *mut u8, 0, (nl * 4) as u64);
        memset(envp.ptr as *mut u8, 0, (nl * 4) as u64);
    }
    let mut ncaps = 0 as usize;
    let mut any = false;
    for b in (*func).blocks {
        for st in b.statements {
            let (dest, rv) = match *st {
                ZirStmt.Let(id, rv, _) => (id, rv),
                ZirStmt.Assign(p, rv, _) => {
                    if p.projections.len != 0 as usize {
                        os_env_mark(bad, nl, p.base);
                        (0 as u32, rv)
                    } else {
                        (p.base, rv)
                    }
                },
                ZirStmt.Intrinsic(_, args, _) => {
                    for a in args { os_env_mark(bad, nl, a.base); }
                    continue;
                },
                ZirStmt.Drop(_, _) | ZirStmt.DropIfLive(_, _) | ZirStmt.EndBorrow(_, _) => {
                    continue;
                },
            };
            if dest != 0 as u32 && (dest as usize) < nl {
                if ndef[dest as usize] < 2 as u8 {
                    ndef[dest as usize] = ndef[dest as usize] + 1 as u8;
                }
            }
            if let ZirRvalue.FuncAddr(_, p) = rv { if p != 0 as u32 { any = true; } }
            if let ZirRvalue.Tuple(vals) = rv { ncaps = ncaps + vals.len; }
            os_env_scan_rv(c, &rv, dest, bad, nref, refof);
        }
        match b.terminator {
            ZirTerminator.Branch(p, _, _) | ZirTerminator.Ret(p) => os_env_mark(bad, nl, p.base),
            ZirTerminator.Jmp(_) | ZirTerminator.Unreachable => {},
        }
    }
    if !any { return; }
    // SAFETY: NCAPS u32 in the body's scratch arena; every one read is written below first.
    c.env_caps = unsafe {
        @slice(zoril_allocator_alloc(c.arena, ncaps * 4 + 4) as *mut u32, ncaps)
    };
    let mut at = 0 as usize;
    for b in (*func).blocks {
        for st in b.statements {
            if let ZirStmt.Let(id, rv, _) = *st {
                if let ZirRvalue.Tuple(vals) = rv {
                    if (id as usize) < nl && ndef[id as usize] == 1 as u8 {
                        let mut plain = true;
                        for v in vals {
                            if v.projections.len != 0 as usize || v.base == 0 as u32 {
                                plain = false;
                            }
                        }
                        if plain {
                            c.env_first[id as usize] = at as u32;
                            c.env_n[id as usize] = vals.len as u32;
                            for v in vals {
                                c.env_caps[at] = v.base;
                                at = at + 1 as usize;
                            }
                        }
                    }
                }
            }
        }
    }
    // The pointer each closure local was made from, joined over copies as known_fn is.
    let mut more = true;
    while more {
        more = false;
        for b in (*func).blocks {
            for st in b.statements {
                let (dest, rv) = match *st {
                    ZirStmt.Let(id, rv, _) => (id, rv),
                    ZirStmt.Assign(p, rv, _) => {
                        if p.projections.len != 0 as usize { continue; }
                        (p.base, rv)
                    },
                    ZirStmt.Drop(_, _)
                        | ZirStmt.DropIfLive(_, _)
                        | ZirStmt.EndBorrow(_, _)
                        | ZirStmt.Intrinsic(_, _, _) => { continue; },
                };
                if dest == 0 as u32 || dest as usize >= nl { continue; }
                let v = match rv {
                    ZirRvalue.FuncAddr(_, p) => p,
                    ZirRvalue.Use(q) => {
                        if q.projections.len == 0 as usize && (q.base as usize) < nl {
                            envp[q.base as usize]
                        } else {
                            0 as u32
                        }
                    },
                    _ => 0 as u32,
                };
                if v == 0 as u32 { continue; }
                let old = envp[dest as usize];
                let new = if old == 0 as u32 || old == v { v } else { OS_KNOWN_NONE };
                if new != old {
                    envp[dest as usize] = new;
                    more = true;
                }
            }
        }
    }
    let mut l = 1 as usize;
    while l < nl {
        let k = c.known_fn[l];
        let p = envp[l];
        if k != 0 as u32
            && k != OS_KNOWN_NONE
            && k & OS_KNOWN_ENV != 0 as u32
            && p != 0 as u32
            && p != OS_KNOWN_NONE
            && (p as usize) < nl {
            let e = refof[p as usize];
            // NREF of P counts the closures made from it and the references taken to it: one.
            let mut ok = ndef[p as usize] == 1 as u8
                && bad[p as usize] == 0 as u8
                && nref[p as usize] == 1 as u8
                && e != 0 as u32
                && (e as usize) < nl
                && ndef[e as usize] == 1 as u8
                && nref[e as usize] == 1 as u8
                && bad[e as usize] == 0 as u8
                && c.env_n[e as usize] != 0 as u32;
            // Every local holding this closure must keep to calls and copies.
            let mut m = 1 as usize;
            while ok && m < nl {
                if c.known_fn[m] == k && (bad[m] != 0 as u8 || envp[m] != p) { ok = false; }
                m = m + 1 as usize;
            }
            if ok { c.env_of[l] = e; }
        }
        l = l + 1 as usize;
    }
}

fn os_env_mark(bad: [mut u8], nl: usize, id: u32) {
    if (id as usize) < nl { bad[id as usize] = 1 as u8; }
}

// Marks in BAD the base of every place RV reads, but for the uses os_known_envs allows: the callee
// of a call through a local, a plain copy of a local into DEST, the closure's environment pointer,
// and `&E` (counted in NREF, recorded in REFOF for DEST); NREF also counts each closure made
// from a pointer. A copy into another local is checked
// there: os_known_envs requires every local holding the closure to be a known callee of it.
// exhaustive: every rvalue must say which locals it reads.
fn os_env_scan_rv(
    c: &OriginSets,
    rv: &ZirRvalue,
    dest: u32,
    bad: [mut u8],
    nref: [mut u8],
    refof: [mut u32]
) {
    let nl = c.nl;
    match *rv {
        ZirRvalue.Use(p) => {
            if p.projections.len != 0 as usize || dest == 0 as u32 {
                os_env_mark(bad, nl, p.base);
            } else if (p.base as usize) < nl && (dest as usize) < nl {
                let k = c.known_fn[p.base as usize];
                if k == 0 as u32 || k == OS_KNOWN_NONE || k != c.known_fn[dest as usize] {
                    os_env_mark(bad, nl, p.base);
                }
            }
        },
        ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => {
            if p.projections.len != 0 as usize || dest == 0 as u32 || p.base as usize >= nl {
                os_env_mark(bad, nl, p.base);
            } else {
                if nref[p.base as usize] < 2 as u8 {
                    nref[p.base as usize] = nref[p.base as usize] + 1 as u8;
                }
                if (dest as usize) < nl { refof[dest as usize] = p.base; }
            }
        },
        ZirRvalue.CallPtr(f, args) => {
            if f.projections.len != 0 as usize { os_env_mark(bad, nl, f.base); }
            for a in args { os_env_mark(bad, nl, a.base); }
        },
        ZirRvalue.BinaryOp(_, a, b) => {
            os_env_mark(bad, nl, a.base);
            os_env_mark(bad, nl, b.base);
        },
        ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.Cast(p, _)
            | ZirRvalue.VariantCheck(p, _, _)
            | ZirRvalue.EnumPayload(p, _, _)
            | ZirRvalue.Boxed(p)
            | ZirRvalue.PtrFromInt(p, _)
            | ZirRvalue.ArrayRepeat(p, _, _) => os_env_mark(bad, nl, p.base),
        ZirRvalue.Call(_, args)
            | ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Syscall(args)
            | ZirRvalue.Intrinsic(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args) => {
            for a in args { os_env_mark(bad, nl, a.base); }
        },
        ZirRvalue.FuncAddr(_, p) => {
            if p != 0 as u32 && (p as usize) < nl && nref[p as usize] < 2 as u8 {
                nref[p as usize] = nref[p as usize] + 1 as u8;
            }
        },
        ZirRvalue.Const(_, _)
            | ZirRvalue.Sizeof(_)
            | ZirRvalue.StringConst(_)
            | ZirRvalue.GlobalAddr(_)
            | ZirRvalue.GetEnv => {},
    }
}

fn os_place_names(p: &Place, l: u32) -> bool {
    if p.base == l { return true; }
    for pr in p.projections {
        if let Projection.Index(k) = *pr { if k == l { return true; } }
    }
    return false;
}

// Whether RV reads, or takes the address of, local L anywhere: what ends the window in which an
// element of L's literal can still be overwritten unseen (os_dead_inits).
// exhaustive: every rvalue must say which locals it names.
fn os_rv_names(rv: &ZirRvalue, l: u32) -> bool {
    match *rv {
        ZirRvalue.Use(p)
            | ZirRvalue.Ref(p, _)
            | ZirRvalue.RefMut(p, _)
            | ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.Cast(p, _)
            | ZirRvalue.VariantCheck(p, _, _)
            | ZirRvalue.EnumPayload(p, _, _)
            | ZirRvalue.Boxed(p)
            | ZirRvalue.PtrFromInt(p, _)
            | ZirRvalue.ArrayRepeat(p, _, _) => { return os_place_names(&p, l); },
        ZirRvalue.BinaryOp(_, a, b) => { return os_place_names(&a, l) || os_place_names(&b, l); },
        ZirRvalue.CallPtr(f, args) => {
            if os_place_names(&f, l) { return true; }
            for a in args { if os_place_names(a, l) { return true; } }
            return false;
        },
        ZirRvalue.Call(_, args)
            | ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Syscall(args)
            | ZirRvalue.Intrinsic(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args) => {
            for a in args { if os_place_names(a, l) { return true; } }
            return false;
        },
        ZirRvalue.FuncAddr(_, env) => { return env == l; },
        ZirRvalue.Const(_, _)
            | ZirRvalue.Sizeof(_)
            | ZirRvalue.StringConst(_)
            | ZirRvalue.GlobalAddr(_)
            | ZirRvalue.GetEnv => { return false; },
    }
}

// The local whose address RV takes, 0 if none: the base of a reference, of an enum payload's
// address, or a closure's environment pointer.
fn os_addr_taken(rv: &ZirRvalue) -> u32 {
    match *rv {
        ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) | ZirRvalue.EnumPayload(p, _, _) => {
            return p.base;
        },
        ZirRvalue.FuncAddr(_, env) => { return env; },
        _ => { return 0 as u32; },
    }
}

// The element a one-projection place `L.p` overwrites whole in L's literal of N elements, or N
// when it is not one: a field (in declaration order, as a struct literal's values are), a tuple
// slot, or an array slot at an index local that only ever holds one constant (KCONST, KVAL). An
// index from anything else may be any element.
fn os_whole_element(
    module: &ILModule,
    ty: u32,
    pr: &Projection,
    n: usize,
    kconst: [mut u8],
    kval: [mut u64]
) -> usize {
    match *pr {
        Projection.TupleIndex(i) => {
            if (i as usize) < n { return i as usize; }
        },
        Projection.Field(name) => {
            if ty != 0 as u32 && os_type_def_tag(module, ty) == ILTYPE_USER {
                let uid = module.types[ty as usize - 1 as usize].def.get_User().id;
                if uid != 0xffffffff as u32 && (uid as usize) < module.typedefs.len() {
                    if let ILTypeDef.Struct(st) = module.typedefs[uid as usize] {
                        let mut k = 0 as usize;
                        while k < st.fields.len && k < n {
                            if st.fields[k].name == name { return k; }
                            k = k + 1 as usize;
                        }
                    }
                }
            }
        },
        Projection.Index(x) => {
            if (x as usize) < kconst.len
                && kconst[x as usize] == 1 as u8
                && kval[x as usize] < n as u64 {
                return kval[x as usize] as usize;
            }
        },
        Projection.Deref => {},
    }
    return n;
}

// Fills dead_init: for a local L built by one `Let` of a tuple, struct or array literal, the
// elements that a later statement of the same block overwrites whole (`L.f = v`, `L.0 = v`,
// `L[0] = v`, or `L = v` for all of them) before anything reads L, takes its address or names it
// as an index. Such an element's value is never seen, so the literal adds nothing of it to L's
// sets, which are flow-insensitive and would otherwise keep a placeholder's origins for the
// whole body (§3, _Transfer_). A statement in another block, a loop's back edge, a `&mut` to L
// or a reborrow all name L or lie outside the window, so they still join the old value in.
fn os_dead_inits(c: &mut OriginSets, module: &ILModule, func: &ZirFunction) {
    let nl = c.nl;
    let locals = (*func).locals;
    // SAFETY: NL bytes and NL u64 in the body's scratch arena, zeroed before any read.
    let nlet = unsafe { @slice(zoril_allocator_alloc(c.arena, nl) as *mut u8, nl) };
    // SAFETY: as above.
    let kconst = unsafe { @slice(zoril_allocator_alloc(c.arena, nl) as *mut u8, nl) };
    // SAFETY: as above.
    let kval = unsafe { @slice(zoril_allocator_alloc(c.arena, nl * 8) as *mut u64, nl) };
    unsafe {
        memset(nlet.ptr as *mut u8, 0, nl as u64);
        memset(kconst.ptr as *mut u8, 0, nl as u64);
        memset(kval.ptr as *mut u8, 0, (nl * 8) as u64);
    }
    // kconst: 1 while every definition seen is the one `Let` of a constant, 2 once another is.
    // nlet: 3 for a local whose address is taken anywhere, so that no alias made on an earlier
    // pass through the block can read the element in the window.
    for b in (*func).blocks {
        for st in b.statements {
            match *st {
                ZirStmt.Let(id, rv, _) => {
                    if (id as usize) < nl {
                        if nlet[id as usize] < 2 as u8 {
                            nlet[id as usize] = nlet[id as usize] + 1 as u8;
                        }
                        if let ZirRvalue.Const(v, _) = rv {
                            if kconst[id as usize] == 0 as u8 {
                                kconst[id as usize] = 1 as u8;
                                kval[id as usize] = v;
                            }
                        } else {
                            kconst[id as usize] = 2 as u8;
                        }
                    }
                    let a = os_addr_taken(&rv);
                    if (a as usize) < nl { nlet[a as usize] = 3 as u8; }
                },
                ZirStmt.Assign(p, rv, _) => {
                    if (p.base as usize) < nl { kconst[p.base as usize] = 2 as u8; }
                    let a = os_addr_taken(&rv);
                    if (a as usize) < nl { nlet[a as usize] = 3 as u8; }
                },
                ZirStmt.Drop(_, _)
                    | ZirStmt.DropIfLive(_, _)
                    | ZirStmt.EndBorrow(_, _)
                    | ZirStmt.Intrinsic(_, _, _) => {},
            }
        }
    }
    let mut id = 0 as usize;
    while id < nl {
        if nlet[id] != 1 as u8 { kconst[id] = 2 as u8; }
        id = id + 1 as usize;
    }
    for b in (*func).blocks {
        let sts = b.statements;
        let mut s = 0 as usize;
        while s < sts.len {
            let (l, n) = match sts[s] {
                ZirStmt.Let(id, ZirRvalue.Tuple(vals), _)
                    | ZirStmt.Let(id, ZirRvalue.StructLiteral(_, vals), _)
                    | ZirStmt.Let(id, ZirRvalue.Array(_, vals), _) => (id, vals.len),
                _ => (0 as u32, 0 as usize),
            };
            s = s + 1 as usize;
            if l == 0 as u32 || l as usize >= nl || nlet[l as usize] != 1 as u8 || n > 64 as usize {
                continue;
            }
            let ty = os_local_ty(locals, l);
            let mut dead = 0 as u64;
            let mut t = s;
            let mut open = true;
            while open && t < sts.len {
                match sts[t] {
                    ZirStmt.Let(k, rv, _) => {
                        if k == l || os_rv_names(&rv, l) { open = false; }
                    },
                    ZirStmt.Assign(p, rv, _) => {
                        if os_rv_names(&rv, l) {
                            open = false;
                        } else if p.base == l && p.projections.len == 0 as usize {
                            dead = if n == 64 as usize {
                                0xffffffffffffffff as u64
                            } else {
                                ((1 as u64) << (n as u64)) - 1 as u64
                            };
                            open = false;
                        } else if p.base == l && p.projections.len == 1 as usize {
                            let e = os_whole_element(
                                module,
                                ty,
                                &p.projections[0],
                                n,
                                kconst,
                                kval
                            );
                            if e < n {
                                dead = dead | ((1 as u64) << (e as u64));
                            } else {
                                open = false;
                            }
                        } else if os_place_names(&p, l) {
                            open = false;
                        }
                    },
                    ZirStmt.Drop(p, _) | ZirStmt.DropIfLive(p, _) => {
                        if os_place_names(&p, l) { open = false; }
                    },
                    ZirStmt.Intrinsic(_, args, _) => {
                        for a in args { if os_place_names(a, l) { open = false; } }
                    },
                    ZirStmt.EndBorrow(k, _) => { if k == l { open = false; } },
                }
                t = t + 1 as usize;
            }
            c.dead_init[l as usize] = dead;
        }
    }
}

// The closure rule (§3, _A closure made into a value_): a closure that is not only called through
// locals of this body (env_of 0) may be called where no caller knows its environment, so the edges
// of its summary whose value is what the environment reaches are checked where it is made, against
// the environment ENV (the pointer FuncAddr carries), and recorded as this body's own edges, since
// a call of the closure anywhere is a store this body caused. The flow-insensitive sets already
// hold what any later call writes into that environment. An edge whose value is a declared
// parameter is checked where the argument is passed, by the store rules of the body that calls
// the closure.
fn os_check_closure_value(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    fid: u32,
    env: u32
) {
    if fid as usize >= module.functions.len() { return; }
    let f = &module.functions[fid as usize];
    let base = if f.params_len > 0 as usize && f.param(0).name == c.sret_name {
        1 as usize
    } else {
        0 as usize
    };
    // `__env`, the closure's last IL parameter, is index E of a call's arguments: one past the
    // declared parameters, which are the ones a call through the value passes (lower_rv_call_ptr).
    let mut e = if f.params_len >= base { f.params_len - base } else { 0 as usize };
    if e > 0 as usize
        && type_name_is(table.lookup(f.param(f.params_len - 1 as usize).name), "__env") {
        e = e - 1 as usize;
    }
    let ao = os_t(c, OS_T_AO);
    let aos = os_t(c, OS_T_AS);
    let place = Place { base: env, projections: @slice(0 as *mut Projection, 0 as usize) };
    os_clear(c, ao);
    os_clear(c, aos);
    let _ = os_read(c, module, table, locals, &place, ao, aos);
    let _ = os_or(c, ao, aos);
    let tv = os_t(c, OS_T_SV);
    let tv2 = os_t(c, OS_T_X);
    let ed = os_t(c, OS_T_ED);
    let eo = os_t(c, OS_T_R);
    let es = os_t(c, OS_T_D);
    os_clear(c, eo);
    os_clear(c, es);
    os_through_split(c, ao, eo, es);
    if !f.os_known {
        // No summary yet: what the closure stores is not known, so its environment may not hold
        // an address of this frame at all.
        os_through_plus(c, ao, tv);
        os_drop_moved_storage(c, tv, eo, es);
        if c.checking && os_frame_bound(c, tv) {
            os_refuse(
                c,
                OS_RULE_CLOSURE,
                os_origin_msg(
                    c,
                    tv,
                    "a closure whose stores are not known yet holds an address of this frame (closure rule)",
                    "a closure whose stores are not known yet holds an address the compiler cannot trace (closure rule)"
                )
            );
        }
        return;
    }
    // SAFETY: the closure's own summary table, os_edge_rows rows of four u64 in the main arena
    // (store_origin_summary).
    let edge_tbl = unsafe { @slice(f.os_edges, f.os_edge_rows * 4 as usize) };
    let mut r = 0 as usize;
    while r < f.os_edge_rows {
        let row = r * 4 as usize;
        let code = edge_tbl[row] as usize;
        let contents = code >= 64 as usize && code < 128 as usize;
        let pidx = if contents { code - 64 as usize } else { code };
        if code < 128 as usize && pidx >= e {
            let gflags = edge_tbl[row + 3 as usize];
            if contents {
                os_through_plus(c, ao, tv);
                os_drop_moved_storage(c, tv, eo, es);
            } else {
                os_copy(c, tv, ao);
            }
            let bound = os_frame_bound(c, tv);
            if gflags & OS_EDGE_GLOBAL != 0 as u64 {
                if c.checking && bound {
                    os_refuse(
                        c,
                        OS_RULE_CLOSURE,
                        os_origin_msg(
                            c,
                            tv,
                            "the closure made here stores an address of this frame into a global when it is called (closure rule)",
                            "the closure made here stores an address the compiler cannot trace into a global when it is called (closure rule)"
                        )
                    );
                    return;
                }
                os_clear(c, ed);
                os_add_flag(c, ed, ORIGIN_STATIC);
                os_note_edges(c, tv, ed, gflags & OS_EDGE_REF);
            }
            let mut w = 1 as usize;
            while w <= 2 as usize {
                let mut j = e;
                while j < 64 as usize {
                    if (edge_tbl[row + w] >> (j as u64)) & 1 as u64 != 0 as u64 {
                        os_copy(c, tv2, ao);
                        if j > e { os_add_read(c, tv2); }
                        os_dest_reach(c, module, table, locals, tv2, ed);
                        if c.checking && bound && os_external(c, ed) {
                            os_refuse(
                                c,
                                OS_RULE_CLOSURE,
                                os_origin_msg(
                                    c,
                                    tv,
                                    "the closure made here stores an address of this frame into memory that outlives it when it is called (closure rule)",
                                    "the closure made here stores an address the compiler cannot trace into memory that outlives it when it is called (closure rule)"
                                )
                            );
                            return;
                        }
                        os_note_edges(c, tv, ed, gflags & OS_EDGE_REF);
                    }
                    j = j + 1 as usize;
                }
                w = w + 1 as usize;
            }
        }
        r = r + 1 as usize;
    }
}

// A call through a known callee (os_known_callees) applies that function's summary, as a direct
// call does (os_call); a closure gets the callee value, its environment's address, as `__env`, its
// last argument (lower_rv_call_ptr). Whether it was one.
fn os_known_call(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    callee: &Place,
    args: [Place],
    owner: usize
) -> bool {
    if callee.projections.len != 0 as usize || callee.base as usize >= c.nl { return false; }
    let k = c.known_fn[callee.base as usize];
    if k == 0 as u32 || k == OS_KNOWN_NONE { return false; }
    let fid = (k & !OS_KNOWN_ENV) - 1 as u32;
    if fid as usize >= module.functions.len() { return false; }
    if k & OS_KNOWN_ENV == 0 as u32 {
        os_call(c, module, table, locals, fid, args, owner);
        return true;
    }
    // The callee value, then one argument for each bit a capture can have in the summary, up to
    // parameter 62 (63 stands for every later one, and os_cap_bits stops below it).
    let n = if args.len + 1 as usize > 63 as usize { args.len + 1 as usize } else { 63 as usize };
    // SAFETY: N Places in the body's scratch arena, which outlives the call; every one is written
    // before the slice is read.
    let all = unsafe { @slice(zoril_allocator_alloc(c.arena, n * sizeof(Place)) as *mut Place, n) };
    let mut i = 0 as usize;
    while i < args.len {
        all[i] = args[i];
        i = i + 1 as usize;
    }
    while i < n {
        all[i] = *callee;
        i = i + 1 as usize;
    }
    c.known_env = args.len;
    c.known_tuple = c.env_of[callee.base as usize];
    os_call(c, module, table, locals, fid, all, owner);
    c.known_env = OS_NO_ENV;
    c.known_tuple = 0 as u32;
    return true;
}

// The result of a call through a `fn` value into OS_T_VO/OS_T_VS (§3, _Calls through a `fn`
// value_): the body was checked by these rules where it was made, so its result holds only what
// its arguments and its environment reach, and Static. An owning result is fresh storage of this
// frame (OWNER) or storage that memory reaches (a `Vec` in an arena it was handed). Every
// argument's reach goes into S, not only a tied arena's as in os_call: with no summary, which
// argument the result is tied to is not known, and the environment's capture types are not either.
fn os_fn_value_result(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    args: [Place],
    callee: &Place,
    owner: usize
) {
    let vo = os_t(c, OS_T_VO);
    let vs = os_t(c, OS_T_VS);
    let tao = os_t(c, OS_T_AO);
    let tas = os_t(c, OS_T_AS);
    let tr = os_t(c, OS_T_R);
    let mut k = 0 as usize;
    while k <= args.len {
        let _ = os_unknown_arg(c, module, table, locals, args, callee, k);
        let _ = os_or(c, tao, tas);
        os_reach_all(c, tao, tr);
        let _ = os_or(c, vo, tr);
        let _ = os_or(c, vs, tr);
        k = k + 1 as usize;
    }
    os_add_flag(c, vo, ORIGIN_STATIC);
    let _ = os_or(c, vs, owner);
}

// Reads argument I of a direct call to FN_ID into OS_T_AO (what it holds) and OS_T_AS (what it
// owns) and returns its type. An aggregate the callee takes by value arrives as a shared pointer to
// a temporary holding it (ILParam.by_ref); it is read as that value, not as the temporary's
// address.
fn os_arg(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    fn_id: u32,
    args: [Place],
    i: usize
) -> u32 {
    if c.known_env == OS_NO_ENV || i < c.known_env {
        return os_arg_read(c, module, table, locals, fn_id, args, i);
    }
    let tao = os_t(c, OS_T_AO);
    let tas = os_t(c, OS_T_AS);
    let t = c.known_tuple as usize;
    let first = if t != 0 as usize { c.env_first[t] as usize } else { 0 as usize };
    let ncap = if t != 0 as usize { c.env_n[t] as usize } else { 0 as usize };
    if i == c.known_env {
        // The environment's own slots: a store into one of them, which the summary names as
        // ParamContents(`__env`) whichever capture it is, reaches every capture's source local too.
        let ty = os_arg_read(c, module, table, locals, fn_id, args, i);
        let mut k = 0 as usize;
        while k < ncap {
            os_add_frame(c, tao, c.env_caps[first + k]);
            k = k + 1 as usize;
        }
        return ty;
    }
    let j = i - c.known_env - 1 as usize;
    if j >= ncap { return os_arg(c, module, table, locals, fn_id, args, c.known_env); }
    // Capture j is field j of the tuple, which holds what local env_caps[first + j] held when the
    // tuple was built, and what a store into a slot added (above): its address names that local.
    os_clear(c, tao);
    os_clear(c, tas);
    os_add_frame(c, tao, c.env_caps[first + j]);
    return 0 as u32;
}

fn os_arg_read(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    fn_id: u32,
    args: [Place],
    i: usize
) -> u32 {
    let tao = os_t(c, OS_T_AO);
    let tas = os_t(c, OS_T_AS);
    let ta = os_t(c, OS_T_A);
    os_clear(c, tao);
    os_clear(c, tas);
    let aty = os_read(c, module, table, locals, &args[i], tao, tas);
    if aty == 0 as u32 || os_type_def_tag(module, aty) != ILTYPE_PTR { return aty; }
    if (fn_id as usize) >= module.functions.len() { return aty; }
    let f = &module.functions[fn_id as usize];
    let base = if f.params_len > 0 as usize && f.param(0).name == c.sret_name {
        1 as usize
    } else {
        0 as usize
    };
    if i + base >= f.params_len { return aty; }
    if !f.param(i + base).by_ref { return aty; }
    let pty = os_pointee(module, f.param(i + base).ty);
    if pty == 0 as u32 || pty as usize > module.types.len() { return aty; }
    let _ = os_or(c, tao, tas);
    os_copy(c, ta, tao);
    os_clear(c, tao);
    os_clear(c, tas);
    os_through_split(c, ta, tao, tas);
    return pty;
}

// The callee's store summary at the call: what each stored argument reaches goes into what each
// target argument reaches, and a target's S grows only by what the stored arguments own. The masks
// are not paired, so every stored argument meets every target, the same one included. Bit 63 of
// the targets is a global: no local of this frame, and outside it for the rule pass. An argument
// past the masks' 64 bits counts as both.
fn os_summary_store_effects(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    fn_id: u32,
    args: [Place],
    from_mask: u64,
    to_mask: u64
) {
    if from_mask == 0 as u64 { return; }
    let tao = os_t(c, OS_T_AO);
    let tas = os_t(c, OS_T_AS);
    let tr = os_t(c, OS_T_R);
    let tsv = os_t(c, OS_T_SV);
    let tso = os_t(c, OS_T_SO);
    let tw = os_t(c, OS_T_W);
    let tv = os_t(c, OS_T_V);
    let td = os_t(c, OS_T_D);
    os_clear(c, tsv);
    os_clear(c, tso);
    let mut i = 0 as usize;
    while i < args.len {
        if i >= 64 as usize || ((from_mask >> (i as u64)) & 1 as u64) != 0 as u64 {
            let _ = os_arg(c, module, table, locals, fn_id, args, i);
            let po = os_t(c, OS_T_EV);
            let ps = os_t(c, OS_T_ED);
            os_copy(c, po, tao);
            os_copy(c, ps, tas);
            let _ = os_or(c, tso, tas);
            let _ = os_or(c, tao, tas);
            os_reach_all(c, tao, tr);
            if i < 63 as usize { os_drop_moved_storage(c, tr, po, ps); }
            let _ = os_or(c, tsv, tr);
        }
        i = i + 1 as usize;
    }
    if os_is_empty(c, tsv) { return; }
    if c.checking {
        let global = (to_mask >> 63 as u64) & 1 as u64 != 0 as u64;
        let mut refused = false;
        i = 0 as usize;
        while i < args.len && !refused {
            if i >= 64 as usize || ((from_mask >> (i as u64)) & 1 as u64) != 0 as u64 {
                let _ = os_arg(c, module, table, locals, fn_id, args, i);
                let po = os_t(c, OS_T_EV);
                let ps = os_t(c, OS_T_ED);
                os_copy(c, po, tao);
                os_copy(c, ps, tas);
                let _ = os_or(c, tao, tas);
                os_reach_all(c, tao, tv);
                if i < 63 as usize { os_drop_moved_storage(c, tv, po, ps); }
                if os_frame_bound(c, tv) {
                    if global {
                        os_refuse(
                            c,
                            OS_RULE_CALL_STORE,
                            os_origin_msg(
                                c,
                                tv,
                                "the callee stores an address of this frame into a global (call store rule)",
                                "the callee stores an address the compiler cannot trace into a global (call store rule)"
                            )
                        );
                        refused = true;
                    }
                    let mut j = 0 as usize;
                    while j < args.len && !refused {
                        let target = if j >= 63 as usize {
                            to_mask != 0 as u64
                        } else {
                            ((to_mask >> (j as u64)) & 1 as u64) != 0 as u64
                        };
                        if target {
                            let _ = os_arg(c, module, table, locals, fn_id, args, j);
                            let _ = os_or(c, tao, tas);
                            let sf = os_t(c, OS_T_SF);
                            os_copy(c, sf, tv);
                            os_drop_self_store(c, module, table, locals, sf, tao);
                            os_dest_reach(c, module, table, locals, tao, td);
                            if os_frame_bound(c, sf) && os_external(c, td) {
                                os_refuse(
                                    c,
                                    OS_RULE_CALL_STORE,
                                    os_origin_msg(
                                        c,
                                        sf,
                                        "the callee stores an address of this frame into memory that outlives it (call store rule)",
                                        "the callee stores an address the compiler cannot trace into memory that outlives it (call store rule)"
                                    )
                                );
                                refused = true;
                            }
                        }
                        j = j + 1 as usize;
                    }
                }
            }
            i = i + 1 as usize;
        }
    }
    let ev = os_t(c, OS_T_EV);
    let ed = os_t(c, OS_T_ED);
    os_copy(c, ev, tsv);
    let _ = os_or(c, ev, tso);
    os_drop_moved_storage(c, ev, tsv, tso);
    if (to_mask >> 63 as u64) & 1 as u64 != 0 as u64 {
        os_clear(c, ed);
        os_add_flag(c, ed, ORIGIN_STATIC);
        os_note_edges(c, ev, ed, OS_EDGE_REF);
    }
    let mut j = 0 as usize;
    while j < args.len {
        let target = if j >= 63 as usize {
            to_mask != 0 as u64
        } else {
            ((to_mask >> (j as u64)) & 1 as u64) != 0 as u64
        };
        if target {
            let _ = os_arg(c, module, table, locals, fn_id, args, j);
            let _ = os_or(c, tao, tas);
            os_dest_reach(c, module, table, locals, tao, ed);
            os_note_edges(c, ev, ed, OS_EDGE_REF);
            os_reach_all(c, tao, tw);
            os_write_memory(c, module, table, locals, tw, tsv, tso);
        }
        j = j + 1 as usize;
    }
}

// True when TY is a safe slice or reference whose element/referent type carries no address
// (e.g. `[u8]`, `&i32`, `&[u8; N]`). Raw pointers (`*u8`, `*mut u8`) are excluded because they
// can be type-erased pointers to address-carrying values (as in `memcpy`).
fn os_contents_non_carrying(c: &mut OriginSets, module: &ILModule, ty: u32) -> bool {
    if ty == 0 as u32 || ty as usize > module.types.len() { return false; }
    match module.types[ty as usize - 1 as usize].def {
        ILType.Slice(s) => { return !os_carries(c, module, s.element); },
        ILType.Ptr(inner) | ILType.PtrMut(inner) => { return !os_carries(c, module, inner); },
        _ => { return false; },
    }
}

// Argument K of a direct call to FN_ID, what it holds and owns together, into DST: with CONTENTS
// what is reached through it instead (ParamContents). Parameter 63 stands for itself and every
// later one, so code 63 takes the union of arguments 63 onwards.
fn os_param_origin(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    fn_id: u32,
    args: [Place],
    i: usize,
    contents: bool,
    dst: usize
) {
    let tao = os_t(c, OS_T_AO);
    let tas = os_t(c, OS_T_AS);
    let tr = os_t(c, OS_T_R);
    let mut k = i;
    while k < args.len && (k == i || i == 63 as usize) {
        let arg_ty = os_arg(c, module, table, locals, fn_id, args, k);
        let _ = os_or(c, tao, tas);
        if contents {
            if !os_contents_non_carrying(c, module, arg_ty) {
                os_through_plus(c, tao, tr);
                let _ = os_or(c, dst, tr);
            }
        } else {
            let _ = os_or(c, dst, tao);
        }
        k = k + 1 as usize;
    }
}

// An edge's value VAL written into every local the memory MEM names, as os_write_memory does
// for O, less the Frame origins of the storage that local owns: an address into storage L owns,
// held by L, moves with L, and S(L) already says L reaches it. Without this, a callee storing what
// it read through `self` back into `self` (`self.cap = grow_cap(self.cap)` in `Vec.push`, a
// `usize` carrying origins) puts a Vec's own buffer into what it holds, and every `return v` of a
// pushed-to Vec would read as returning an address of this frame. Storage in a local arena is no
// exception the other way: the arena tie already puts `Frame(a)` into O(L) itself.
fn os_write_edge(c: &mut OriginSets, module: &ILModule, locals: [Local], mem: usize, val: usize) {
    let tx = os_t(c, OS_T_X);
    let mut id = 1 as usize;
    while id < c.nl {
        let lty = os_local_ty(locals, id as u32);
        if os_has_frame(c, mem, id) && os_carries(c, module, lty) {
            os_copy(c, tx, val);
            let x = tx * c.words;
            let s = (c.nl + id) * c.words;
            let mut k = OS_W_FRAME;
            while k < c.words {
                c.buf[x + k] = c.buf[x + k] & !c.buf[s + k];
                k = k + 1 as usize;
            }
            if os_or(c, id, tx) { c.changed = true; }
        }
        id = id + 1 as usize;
    }
}

// The store edges of a callee's summary (§3, _The summary_) at a call: each edge stores the
// argument origin its value names into the memory its target names, pairwise, so independent
// parameters are not conflated. The stored values join what the target memory holds, not what it
// owns (a target's S grows only by storage it is handed, never by what is written into it). The
// rule pass applies the store rule to each edge; every edge is also recorded as this body's own.
fn os_edge_effects(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    fn_id: u32,
    args: [Place],
    edges: *mut u64,
    rows: usize
) {
    let tv = os_t(c, OS_T_SV);
    let tm = os_t(c, OS_T_W);
    let ed = os_t(c, OS_T_ED);
    // SAFETY: EDGES has ROWS rows of four u64: store_origin_summary's table in the main arena,
    // which outlives every body's checks, or null with zero rows for a callee in a recursive cycle
    // that has no summary yet (os_call), whose empty slice is never indexed.
    let edge_tbl = unsafe { @slice(edges, rows * 4 as usize) };
    let mut refused = false;
    let mut r = 0 as usize;
    while r < rows {
        let row = r * 4 as usize;
        let code = edge_tbl[row] as usize;
        os_clear(c, tv);
        if code < 64 as usize {
            os_param_origin(c, module, table, locals, fn_id, args, code, false, tv);
        } else if code < 128 as usize {
            os_param_origin(c, module, table, locals, fn_id, args, code - 64 as usize, true, tv);
        } else if code == OS_EDGE_STATIC {
            os_add_flag(c, tv, ORIGIN_STATIC);
        } else if code == OS_EDGE_RODATA {
            os_add_flag(c, tv, ORIGIN_RODATA);
        } else {
            os_add_flag(c, tv, ORIGIN_UNKNOWN);
        }
        // An argument stored by value moves: the frame storage it owns goes with it, into the
        // target's S, and is neither an address the target holds nor one that escapes. What a
        // callee reads through a parameter (ParamContents) is what its addresses lead to, never
        // the parameter's own buffer (that is Frame of the parameter in the callee), so the
        // moved storage leaves that value too, and what the buffer holds stays.
        let moved = os_t(c, OS_T_EV);
        os_clear(c, moved);
        let pidx = if code < 64 as usize { code } else { code - 64 as usize };
        if code < 128 as usize && pidx < 63 as usize {
            let _ = os_arg(c, module, table, locals, fn_id, args, pidx);
            if code < 64 as usize {
                os_moved_storage(c, moved, os_t(c, OS_T_AO), os_t(c, OS_T_AS));
            }
            os_drop_moved_storage(c, tv, os_t(c, OS_T_AO), os_t(c, OS_T_AS));
            // What the environment owns by an owner moved into it is no value a closure stores:
            // its body refuses an owned capture's storage everywhere but back into that capture,
            // where it is a Frame origin of the capture, not ParamContents(`__env`).
            if code >= 64 as usize && c.known_env != OS_NO_ENV && pidx >= c.known_env {
                let eo = os_t(c, OS_T_R);
                let es = os_t(c, OS_T_D);
                os_clear(c, eo);
                os_clear(c, es);
                os_through_split(c, os_t(c, OS_T_AO), eo, es);
                os_drop_moved_storage(c, tv, eo, es);
            }
        }
        let bound = os_frame_bound(c, tv);
        let gflags = edge_tbl[row + 3 as usize];
        if gflags & (OS_EDGE_GLOBAL | OS_EDGE_ENV) != 0 as u64 {
            if c.checking && bound && !refused {
                os_refuse(
                    c,
                    OS_RULE_CALL_STORE,
                    os_origin_msg(
                        c,
                        tv,
                        "the callee stores an address of this frame into a global (call store rule)",
                        "the callee stores an address the compiler cannot trace into a global (call store rule)"
                    )
                );
                refused = true;
            }
        }
        if gflags & OS_EDGE_GLOBAL != 0 as u64 {
            os_clear(c, ed);
            os_add_flag(c, ed, ORIGIN_STATIC);
            os_note_edges(c, tv, ed, gflags & OS_EDGE_REF);
        }
        let mut w = 1 as usize;
        while w <= 2 as usize {
            let mut j = 0 as usize;
            while j < 64 as usize {
                if (edge_tbl[row + w] >> (j as u64)) & 1 as u64 != 0 as u64 {
                    // The target memory: what argument j names (ParamAddr), or what a write through
                    // it can reach (ParamContents), which is its destination reach (§3), not every
                    // read through it: a callee writes only through what it could write through,
                    // so the Static of a literal already in a `Vec<[u8]>` is no target.
                    os_clear(c, tm);
                    os_param_origin(c, module, table, locals, fn_id, args, j, false, tm);
                    // A capture's bit as a target is the memory the capture's value names, one read
                    // through its local (os_arg names the local), whatever its type: the reach
                    // follows what a local holds only for a mutable handle, never a raw pointer.
                    if w == 2 as usize && c.known_env != OS_NO_ENV && j > c.known_env {
                        os_add_read(c, tm);
                    }
                    // A `fn` value names no memory but its environment: a `fn` item's Static is
                    // its code, which nothing stores into (§3, _Calls through a `fn` value_).
                    if os_fn_param(c, module, fn_id, j) {
                        let fw = tm * c.words + OS_W_FLAGS;
                        c.buf[fw] = c.buf[fw] & !ORIGIN_STATIC;
                    }
                    let sf = os_t(c, OS_T_SF);
                    os_copy(c, sf, tv);
                    os_drop_self_store(c, module, table, locals, sf, tm);
                    os_dest_reach(c, module, table, locals, tm, ed);
                    if w == 2 as usize {
                        os_handle_reach(c, module, table, locals, tm, os_t(c, OS_T_X));
                        os_copy(c, tm, os_t(c, OS_T_X));
                    }
                    if c.checking
                        && bound
                        && !refused
                        && os_frame_bound(c, sf)
                        && os_external(c, ed) {
                        os_refuse(
                            c,
                            OS_RULE_CALL_STORE,
                            os_origin_msg(
                                c,
                                sf,
                                "the callee stores an address of this frame into memory that outlives it (call store rule)",
                                "the callee stores an address the compiler cannot trace into memory that outlives it (call store rule)"
                            )
                        );
                        refused = true;
                    }
                    os_note_edges(c, tv, ed, gflags & OS_EDGE_REF);
                    os_write_edge(c, module, locals, tm, tv);
                    if !os_is_empty(c, moved) {
                        let none = os_t(c, OS_T_X);
                        os_clear(c, none);
                        os_write_memory(c, module, table, locals, tm, none, moved);
                    }
                }
                j = j + 1 as usize;
            }
            w = w + 1 as usize;
        }
        r = r + 1 as usize;
    }
}

// The smallest lowering depth among FUNC's direct callees that are still being lowered and have
// no summary yet (ILFunction.os_depth), 0xffffffff when there is none: such a call closes a
// recursive cycle through a body on the driver's stack. The condition is os_call's for
// giving such a callee an empty summary; the two must stay the same.
pub fn zir_open_call_depth(module: &ILModule, func: &ZirFunction) -> u32 {
    let mut low = 0xffffffff as u32;
    for b in (*func).blocks {
        for st in b.statements {
            let rv = match *st {
                ZirStmt.Let(_, r, _) => r,
                ZirStmt.Assign(_, r, _) => r,
                ZirStmt.Drop(_, _)
                    | ZirStmt.DropIfLive(_, _)
                    | ZirStmt.EndBorrow(_, _)
                    | ZirStmt.Intrinsic(_, _, _) => { continue; },
            };
            if let ZirRvalue.Call(fn_id, _) = rv {
                if (fn_id as usize) < module.functions.len() {
                    let f = &module.functions[fn_id as usize];
                    if !f.os_known && f.os_depth != 0 as u32 && f.os_depth < low {
                        low = f.os_depth;
                    }
                }
            }
        }
    }
    return low;
}

// The parameters F's `#[releases]` declaration marks as released: each raw-pointer parameter
// (`*T` or `*mut T`), bit 63 for 63 and later (§3.1, item 2).
pub fn os_decl_releases(module: &ILModule, f: &ILFunction, sret_name: u32) -> u64 {
    if !f.releases { return 0 as u64; }
    let base = if f.params_len > 0 as usize && f.param(0).name == sret_name {
        1 as usize
    } else {
        0 as usize
    };
    let mut mask = 0 as u64;
    let mut i = 0 as usize;
    while i + base < f.params_len {
        let ty = f.param(i + base).ty;
        if ty != 0 as u32 && ty as usize <= module.types.len() {
            let tag = os_type_def_tag(module, ty);
            if tag == ILTYPE_RAWPTR || tag == ILTYPE_RAWPTRMUT {
                let bit = if i < 63 as usize { i } else { 63 as usize };
                mask = mask | ((1 as u64) << (bit as u64));
            }
        }
        i = i + 1 as usize;
    }
    return mask;
}

// This body's summary, written to its function for the calls after it (§3, _The summary_): the
// parameter origins of the result's O, its Static and Unknown (a Frame origin is Unknown to a
// caller), whether the result's S is fresh storage (a Frame or Unknown origin), and the store
// edges, copied into ARENA because the sets live in the body's scratch arena. The summary is
// joined with the one the function already has, so a recursive cycle's fixpoint only
// grows it; returns whether it grew.
pub fn store_origin_summary(
    arena: *mut ArenaHeader,
    module: &mut ILModule,
    idx: usize,
    c: &mut OriginSets
) -> bool {
    let old = module.functions[idx];
    let mut grew = !old.os_known;
    if old.os_known && old.os_edge_rows > 0 as usize {
        // SAFETY: the function's own summary table, OS_EDGE_ROWS rows of four u64 in the main
        // arena (written below on an earlier call).
        let prev = unsafe { @slice(old.os_edges, old.os_edge_rows * 4 as usize) };
        let mut j = 0 as usize;
        while j < old.os_edge_rows {
            let e = (prev[j * 4 as usize] as usize) * 3 as usize;
            let mut w = 0 as usize;
            while w < 3 as usize {
                c.edges[e + w] = c.edges[e + w] | prev[j * 4 as usize + 1 as usize + w];
                w = w + 1 as usize;
            }
            j = j + 1 as usize;
        }
    }
    let r = 2 as usize * c.nl * c.words;
    let rs = r + c.words;
    let mut flags = c.buf[r + OS_W_FLAGS] & (ORIGIN_STATIC | ORIGIN_RAW | ORIGIN_RODATA);
    let mut fresh = c.buf[rs + OS_W_FLAGS] & ORIGIN_UNKNOWN != 0 as u64;
    if c.buf[r + OS_W_FLAGS] & ORIGIN_UNKNOWN != 0 as u64 {
        flags = flags | ORIGIN_UNKNOWN;
    }
    let mut k = OS_W_FRAME;
    while k < c.words {
        if c.buf[r + k] != 0 as u64 { flags = flags | ORIGIN_UNKNOWN; }
        if c.buf[rs + k] != 0 as u64 { fresh = true; }
        k = k + 1 as usize;
    }
    let mut rows = 0 as usize;
    let mut i = 0 as usize;
    while i < OS_EDGE_ROWS {
        let e = i * 3 as usize;
        if c.edges[e] | c.edges[e + 1 as usize] | c.edges[e + 2 as usize] != 0 as u64 {
            rows = rows + 1 as usize;
        }
        i = i + 1 as usize;
    }
    // SAFETY: ARENA is the main arena, which outlives every body's checks (the scratch arena of
    // the sets is reset after each body); the block holds `rows * 4` u64, and the slice covers
    // exactly those.
    let out = unsafe { zoril_allocator_alloc(arena, rows * 32 + 8) as *mut u64 };
    // SAFETY: OUT was just allocated above with room for `rows * 4` u64.
    let dst = unsafe { @slice(out, rows * 4 as usize) };
    let mut n = 0 as usize;
    i = 0 as usize;
    while i < OS_EDGE_ROWS {
        let e = i * 3 as usize;
        if c.edges[e] | c.edges[e + 1 as usize] | c.edges[e + 2 as usize] != 0 as u64 {
            dst[n] = i as u64;
            dst[n + 1 as usize] = c.edges[e];
            dst[n + 2 as usize] = c.edges[e + 1 as usize];
            dst[n + 3 as usize] = c.edges[e + 2 as usize];
            n = n + 4 as usize;
        }
        i = i + 1 as usize;
    }
    if old.os_known {
        if rows != old.os_edge_rows {
            grew = true;
        } else if rows > 0 as usize {
            // SAFETY: as above: the old table of the same number of rows.
            let prev = unsafe { @slice(old.os_edges, rows * 4 as usize) };
            let mut q = 0 as usize;
            while q < rows * 4 as usize {
                if dst[q] != prev[q] { grew = true; }
                q = q + 1 as usize;
            }
        }
    }
    let addr = old.os_ret_addr | c.buf[r + OS_W_ADDR];
    let contents = old.os_ret_contents | c.buf[r + OS_W_CONTENTS];
    flags = flags | old.os_ret_flags;
    fresh = fresh || old.os_ret_fresh;
    let releases = old.os_releases | c.releases | os_decl_releases(module, &old, c.sret_name);
    let env_releases = old.os_env_releases | c.env_releases;
    c.releases = releases;
    c.env_releases = env_releases;
    if addr != old.os_ret_addr
        || contents != old.os_ret_contents
        || flags != old.os_ret_flags
        || fresh != old.os_ret_fresh
        || releases != old.os_releases
        || env_releases != old.os_env_releases {
        grew = true;
    }
    let f = module.get_function_mut(idx);
    f.os_known = true;
    f.os_ret_addr = addr;
    f.os_ret_contents = contents;
    f.os_ret_flags = flags;
    f.os_ret_fresh = fresh;
    f.os_releases = releases;
    f.os_env_releases = env_releases;
    f.os_edges = out;
    f.os_edge_rows = rows;
    return grew;
}

// The parameters FUNC's result may point into by its final body summary, as a call reads them
// (os_call): its ParamAddr ties, and its ParamContents ties unless the result holds only integers.
fn os_body_ties(c: &mut OriginSets, module: &ILModule, f: &ILFunction) -> u64 {
    if f.ret_ty == 0 as u32 || !os_carries(c, module, f.ret_ty) { return 0 as u64; }
    if !os_holds_pointer(module, f.ret_ty, 0 as usize) { return f.os_ret_addr; }
    return f.os_ret_addr | f.os_ret_contents;
}

// A function with no `#[borrows(..)]` has its body's ties added to the elision default (§3,
// _Checked contracts_): a call's borrows read `ret_ties` (inherit_rv_borrows), so a result the
// body ties to a parameter the default leaves out (a `&self` method returning its other
// argument) would otherwise end that borrow while the result still points into it. The ties only
// grow, so no program the default refuses is accepted. A `#[borrows(..)]` is the author's contract
// and is left as written: it may name more than the body returns, never less, so under
// `--provenance` one that leaves out a body tie is refused (tier 2). `#[unsafe(borrows(..))]` is
// trusted as written (tier 3). A closure's ties are its environment's, which no declaration names.
// A body in a recursive cycle gets its ties once the cycle's summaries are final, after the
// borrow checks of the cycle's own bodies ran; those read a call into the cycle as tied to every
// argument instead (inherit_rv_borrows, ILFunction.os_in_cycle). Returns the refusals.
pub fn os_infer_ties(
    c: &mut OriginSets,
    module: &mut ILModule,
    table: &InternTable,
    idx: usize
) -> u32 {
    let f = module.functions[idx];
    if f.borrows_trusted || f.from_interface || f.is_extern { return 0 as u32; }
    if f.has_borrows && c.rules == PROVENANCE_OFF { return 0 as u32; }
    if f.params_len > 0 as usize
        && type_name_is(table.lookup(f.param(f.params_len - 1 as usize).name), "__env") {
        return 0 as u32;
    }
    // A borrow is held only by a value whose type can hold a reference (inherit_rv_borrows), so
    // an integer result or argument carries none, whatever address its bits may hold.
    if f.ret_ty != 0 as u32 && !module.type_holds_reference(f.ret_ty, 0 as usize) {
        return 0 as u32;
    }
    let base = if f.params_len > 0 as usize && f.param(0).name == c.sret_name {
        1 as usize
    } else {
        0 as usize
    };
    let body = os_body_ties(c, module, &f);
    let mut missing = 0 as u64;
    let mut i = 0 as usize;
    while i < 63 as usize {
        if (body >> (i as u64)) & 1 as u64 != 0 as u64
            && (f.ret_ties >> (i as u64)) & 1 as u64 == 0 as u64
            && i + base < f.params_len
            && module.type_holds_reference(f.param(i + base).ty, 0 as usize) {
            missing = missing | ((1 as u64) << (i as u64));
        }
        i = i + 1 as usize;
    }
    if missing == 0 as u64 { return 0 as u32; }
    if f.has_borrows { return os_refuse_narrowing(c, table, &f, base, missing); }
    let p = module.get_function_mut(idx);
    p.ret_ties = p.ret_ties | missing;
    p.ties_inferred = true;
    return 0 as u32;
}

// One refusal per parameter in MISSING, at F's declaration: its `#[borrows(..)]` leaves out a tie
// the body makes. The caller holds no borrow of that argument while the result points into it.
fn os_refuse_narrowing(
    c: &mut OriginSets,
    table: &InternTable,
    f: &ILFunction,
    base: usize,
    missing: u64
) -> u32 {
    let kind = if c.rules == PROVENANCE_WARN { "warning" } else { "error" };
    let mut n = 0 as u32;
    let mut i = 0 as usize;
    while i < 63 as usize {
        if (missing >> (i as u64)) & 1 as u64 != 0 as u64 {
            c.errors = c.errors + 1 as u32;
            n = n + 1 as u32;
            diag_start(c.file, f.decl_span, kind);
            eprint("provenance: #[borrows(..)] leaves out '");
            eprint(table.lookup(f.param(i + base).name));
            eprint("', which the result may point into; a declaration may name more than ");
            eprint("the body returns, never less ");
            eprint("(a reviewed narrowing is `#[unsafe(borrows(..))]`)\n");
        }
        i = i + 1 as usize;
    }
    return n;
}

// A direct call's result, into OS_T_VO and OS_T_VS, from the callee's summary: an argument in
// `ret_storage` gives its own origins (the result points into it); one in `ret_ties` gives what is
// reached through it when it is a reference, and itself and what it reaches otherwise. An owning
// result owns what its tied arguments that can reach an `Arena` give (`Vec.new_in(a)`), and fresh
// storage, OWNER's, when its type is or holds by value a box or a Drop type or no tied argument can
// reach an `Arena` (§3, _Details the transfer needs_). An `extern` with no summary is known (§3,
// _Scalars, casts and `extern`_): its result is Static unless `#[borrows(..)]` ties it, and it
// stores only what `#[stores(..)]` declares. Any other callee whose summary is not known yields
// Unknown.
fn os_call(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    fn_id: u32,
    args: [Place],
    owner: usize
) {
    let vo = os_t(c, OS_T_VO);
    let vs = os_t(c, OS_T_VS);
    let tao = os_t(c, OS_T_AO);
    let tr = os_t(c, OS_T_R);
    let mut known = (fn_id as usize) < module.functions.len();
    let mut storage = 0 as u64;
    let mut ties = 0 as u64;
    let mut trusted = false;
    let mut ret_ty = 0 as u32;
    let mut from_mask = 0 as u64;
    let mut to_mask = 0 as u64;
    let mut bare_extern = false;
    // The summary the origin sets gave the callee's body, when it was lowered before this call
    // (§3, _The summary_); otherwise the masks of the old analyses.
    let mut body = false;
    let mut ret_flags = 0 as u64;
    let mut ret_fresh = false;
    let mut cal_releases = 0 as u64;
    let mut cal_env_releases = 0 as u64;
    let mut edges = 0 as *mut u64;
    let mut edge_rows = 0 as usize;
    if known {
        let f = &module.functions[fn_id as usize];
        bare_extern = f.is_extern;
        known = f.storage_known || bare_extern;
        storage = f.ret_storage;
        ties = f.ret_ties;
        ret_ty = f.ret_ty;
        from_mask = f.stores_storage;
        to_mask = f.store_targets;
        cal_releases = os_decl_releases(module, f, c.sret_name);
        if !f.os_known && f.os_depth != 0 as u32 {
            // A callee still being lowered: this body is in a recursive cycle with it. Its summary
            // starts empty and grows with the cycle's fixpoint, which rechecks this body
            // with the final summaries; the rules are deferred until then. The driver finds such
            // calls before this pass with zir_open_call_depth, which must test the same condition.
            body = true;
            known = true;
            storage = 0 as u64;
            ties = if f.has_borrows { f.ret_ties } else { 0 as u64 };
            from_mask = 0 as u64;
            to_mask = 0 as u64;
        }
        if f.os_known {
            body = true;
            known = true;
            storage = f.os_ret_addr;
            // A declared `#[borrows(..)]` adds to what the body proves, as `#[stores(..)]` below
            // does: a copy through a bare `extern`
            // (`memcpy` in `Vec.clone_in`) is invisible to the body, and a declaration may be wider
            // than it. A narrowing `#[borrows()]` adds nothing, so it no longer launders a tie.
            ties = f.os_ret_contents | (if f.has_borrows { f.ret_ties } else { 0 as u64 });
            trusted = f.borrows_trusted;
            ret_flags = f.os_ret_flags;
            ret_fresh = f.os_ret_fresh;
            cal_releases = cal_releases | f.os_releases;
            cal_env_releases = cal_env_releases | f.os_env_releases;
            edges = f.os_edges;
            edge_rows = f.os_edge_rows;
            from_mask = 0 as u64;
            to_mask = 0 as u64;
        }
        if bare_extern {
            storage = 0 as u64;
            if !f.has_borrows { ties = 0 as u64; }
            from_mask = 0 as u64;
            to_mask = 0 as u64;
            if f.has_stores_declared {
                edges = f.os_edges;
                edge_rows = f.os_edge_rows;
            }
        }
        if f.has_stores_declared && !bare_extern {
            from_mask = from_mask | f.stores_declared_from;
            to_mask = to_mask | f.stores_declared_to;
        }
        // `#[fresh]`: its author's claim that the address the body made from an integer is a new
        // mapping, not memory outside the frame (§3, _Raw operations_). Only that `Raw` goes; a
        // tie to an argument, Static and Unknown stay, as the narrowest reading of the claim.
        if f.fresh {
            ret_flags = ret_flags & !ORIGIN_RAW;
        }
    }
    if !known {
        os_note_unknown(c, fn_id);
        os_add_flag(c, vo, ORIGIN_UNKNOWN);
        os_add_flag(c, vs, ORIGIN_UNKNOWN);
        let none = Place { base: 0 as u32, projections: @slice(0 as *mut Projection, 0 as usize) };
        os_unknown_call_effects(c, module, table, locals, args, &none, args.len, ORIGIN_UNKNOWN);
        return;
    }
    let tas = os_t(c, OS_T_AS);
    let mut tied = false;
    let mut arena_tie = false;
    let owning = ret_ty != 0 as u32
        && os_carries(c, module, ret_ty)
        && os_owns(c, module, table, ret_ty);
    // A callee of no result type (ret_ty 0, unit) hands back no address.
    let result_carries = ret_ty != 0 as u32 && os_carries(c, module, ret_ty);
    // An integer read through a parameter (`self.len` in `Vec.len`) is no address of it, and the
    // field-insensitive sets cannot tell it from a pointer field, so for a result holding only
    // integers at any depth (`usize`, `Option<usize>` from `Vec.pop`, a struct of counts) a body
    // summary's ParamContents ties do not count; its ParamAddr ties (`p as usize`) do. Making an
    // address of an integer needs `unsafe` either way.
    if body && result_carries && !os_holds_pointer(module, ret_ty, 0 as usize) {
        ties = 0 as u64;
    }
    // What the result points into through its tied arguments. `#[unsafe(borrows(..))]` states it
    // in place of the body's ties, so the trust is stated once, at its `// SAFETY:` line, and its
    // callers are checked against the declaration as against a bodyless callee's. Which arena an
    // owning result's storage is in stays the body's: the declaration speaks of borrows only.
    let view_ties = if trusted { ties & module.functions[fn_id as usize].ret_ties } else { ties };
    let mut i = 0 as usize;
    while i < args.len {
        let in_storage = i >= 64 as usize || ((storage >> (i as u64)) & 1 as u64) != 0 as u64;
        let in_ties = i >= 64 as usize || ((ties >> (i as u64)) & 1 as u64) != 0 as u64;
        let in_view = i >= 64 as usize || ((view_ties >> (i as u64)) & 1 as u64) != 0 as u64;
        if result_carries && (in_storage || in_ties) {
            let aty = os_arg(c, module, table, locals, fn_id, args, i);
            let tah = os_t(c, OS_T_AH);
            os_copy(c, tah, tao);
            let _ = os_or(c, tao, tas);
            if aty == 0 as u32 || os_carries(c, module, aty) {
                tied = true;
                let arena = owning && os_type_has(c, module, table, aty, OS_Q_ARENA);
                if arena { arena_tie = true; }
                // An argument that holds its arena by value (`unwrap` of a `Result<Arena, _>`)
                // names the arena's storage by what it owns, S; what it holds, O, is what that
                // storage holds (a literal a callee put in the arena), never storage.
                let mut arena_store = if aty != 0 as u32
                    && !os_type_has(c, module, table, aty, OS_Q_ARENA_REF) {
                    tas
                } else {
                    tao
                };
                if arena && arena_store == tao && aty != 0 as u32 {
                    let depths = os_arena_depths(module, table, aty, 0 as usize);
                    if depths != 2 as u64 && depths != 0 as u64 {
                        os_arena_at_depths(c, tao, depths);
                        arena_store = os_t(c, OS_T_ARENA);
                    }
                }
                if in_storage {
                    // A body summary's Param(i) is what argument i holds. An owner passed by value
                    // (`id(v)`, `o.unwrap()`) moves the storage it owns into the call, so that
                    // storage is no address the result holds; a callee returning an address into
                    // it says so with Unknown, its own Frame.
                    if body && aty != 0 as u32 && os_owns(c, module, table, aty) {
                        let _ = os_or(c, vo, tah);
                    } else {
                        let _ = os_or(c, vo, tao);
                    }
                    if arena { let _ = os_or(c, vs, arena_store); }
                }
                if in_ties {
                    // ParamContents(i) is what is reached through the argument, whatever its type.
                    if body || aty != 0 as u32 && is_reference_tag(os_type_def_tag(module, aty)) {
                        os_through_plus(c, tao, tr);
                    } else {
                        os_reach_all(c, tao, tr);
                    }
                    if in_view { let _ = os_or(c, vo, tr); }
                    // Storage in an arena is named by the arena argument's own origins (`Frame(a)`
                    // for `&a`), never by what the arena struct holds: under a body summary that
                    // includes the C memory of its blocks (Static), which would make every Vec in
                    // a local arena an external destination.
                    if arena {
                        if body {
                            let _ = os_or(c, vs, arena_store);
                        } else {
                            let _ = os_or(c, vs, tr);
                        }
                    }
                }
            }
        }
        i = i + 1 as usize;
    }
    if result_carries && bare_extern && !tied { os_add_flag(c, vo, ORIGIN_STATIC); }
    if result_carries && body { os_add_flag(c, vo, ret_flags); }
    if owning && (!arena_tie || ret_fresh || os_type_has(c, module, table, ret_ty, OS_Q_FRESH)) {
        let _ = os_or(c, vs, owner);
    }
    if (body || bare_extern) && edge_rows > 0 as usize {
        os_edge_effects(c, module, table, locals, fn_id, args, edges, edge_rows);
    }
    if c.checking && bare_extern && !module.functions[fn_id as usize].has_stores_declared {
        let f = &module.functions[fn_id as usize];
        let mut takes_addr = f.is_variadic;
        let mut pi = 0 as usize;
        while pi < f.params_len && !takes_addr {
            let pty = f.param(pi).ty;
            if pty != 0 as u32 && os_carries(c, module, pty) {
                takes_addr = true;
            }
            pi = pi + 1 as usize;
        }
        if takes_addr {
            let mut k = 0 as usize;
            while k < args.len {
                let _ = os_arg(c, module, table, locals, fn_id, args, k);
                if os_has_frame_or_param(c, tao) {
                    if !os_mark_diag(c, OS_RULE_EXTERN_STORE) { break; }
                    c.errors = c.errors + 1 as u32;
                    diag_start(
                        c.file,
                        c.span,
                        if c.rules == PROVENANCE_WARN { "warning" } else { "error" }
                    );
                    eprint("provenance: the extern '");
                    eprint(table.lookup(f.name));
                    eprint(
                        "' declares no #[unsafe(stores(..))], and this call passes it an address of this frame or of a parameter (extern store rule)\n"
                    );
                    break;
                }
                k = k + 1 as usize;
            }
        }
    }
    os_summary_store_effects(c, module, table, locals, fn_id, args, from_mask, to_mask);
    if cal_releases != 0 as u64 || cal_env_releases != 0 as u64 {
        let mut k = 0 as usize;
        while k < args.len {
            let bit = if k < 63 as usize { k } else { 63 as usize };
            if (cal_releases >> (bit as u64)) & 1 as u64 != 0 as u64 {
                let _ = os_arg(c, module, table, locals, fn_id, args, k);
                let _ = os_or(c, tao, tas);
                os_add_releases(c, module, table, locals, tao, false);
            } else if (cal_env_releases >> (bit as u64)) & 1 as u64 != 0 as u64 {
                let _ = os_arg(c, module, table, locals, fn_id, args, k);
                let _ = os_or(c, tao, tas);
                os_add_releases(c, module, table, locals, tao, true);
            }
            k = k + 1 as usize;
        }
    }
}

// exhaustive: every rvalue must say which origins its value carries and what storage it owns.
fn os_rvalue(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    rv: &ZirRvalue,
    owner: usize
) {
    let vo = os_t(c, OS_T_VO);
    let vs = os_t(c, OS_T_VS);
    os_clear(c, vo);
    os_clear(c, vs);
    match *rv {
        ZirRvalue.Use(p)
            | ZirRvalue.UnaryOp(_, p)
            | ZirRvalue.EnumVariant(_, _, p)
            | ZirRvalue.ArrayRepeat(p, _, _) => {
            let _ = os_read(c, module, table, locals, &p, vo, vs);
        },
        ZirRvalue.Ref(p, _) | ZirRvalue.RefMut(p, _) => {
            os_addr(c, module, table, locals, &p, vo);
        },
        // An enum payload is lowered as the address of the payload inside the enum place; a
        // `match` binding or `?` then reads through it. A `match` on a reference names the
        // reference itself, and codegen takes the enum's address from its value
        // (`enum_address`), so the payload lies in what the reference holds, not in its slot.
        ZirRvalue.EnumPayload(p, _, _) => {
            let pty = os_walk(c, module, table, locals, &p);
            if pty != 0 as u32 && is_any_pointer_tag(os_type_def_tag(module, pty)) {
                let _ = os_read(c, module, table, locals, &p, vo, vs);
                os_clear(c, vs);
            } else {
                os_addr(c, module, table, locals, &p, vo);
            }
        },
        ZirRvalue.BinaryOp(_, a, b) => {
            let _ = os_read(c, module, table, locals, &a, vo, vs);
            let _ = os_read(c, module, table, locals, &b, vo, vs);
        },
        ZirRvalue.StructLiteral(_, args)
            | ZirRvalue.Tuple(args)
            | ZirRvalue.Array(_, args)
            | ZirRvalue.Intrinsic(_, args) => {
            for a in args { let _ = os_read(c, module, table, locals, a, vo, vs); }
        },
        // A system call's result is the kernel's integer, not one of its arguments (§3, _Raw
        // operations_): an address it returns (mmap) becomes one only through `@ptr_from_int`.
        ZirRvalue.Syscall(_) => {},
        // A cast reinterprets the value, so an owner cast to a pointer is an address into the
        // storage it owns (`b as *i32` for a box): what it owns joins what it holds.
        ZirRvalue.Cast(p, _) => {
            let _ = os_read(c, module, table, locals, &p, vo, vs);
            let _ = os_or(c, vo, vs);
        },
        // An address made from an integer: whatever the integer was made from, still checked (a
        // frame address round-tripped through `as u64` stays this frame's), and Raw.
        ZirRvalue.PtrFromInt(p, _) => {
            let _ = os_read(c, module, table, locals, &p, vo, vs);
            let _ = os_or(c, vo, vs);
            os_add_flag(c, vo, ORIGIN_RAW);
        },
        ZirRvalue.Boxed(p) => {
            let _ = os_read(c, module, table, locals, &p, vo, vs);
            let _ = os_or(c, vs, owner);
        },
        ZirRvalue.Call(fn_id, args) => { os_call(c, module, table, locals, fn_id, args, owner); },
        ZirRvalue.CallPtr(callee, args) => {
            if os_known_call(c, module, table, locals, &callee, args, owner) { return; }
            if c.checking {
                let cty = os_read(
                    c,
                    module,
                    table,
                    locals,
                    &callee,
                    os_t(c, OS_T_X),
                    os_t(c, OS_T_AS)
                );
                if os_is_c_fn_ptr(module, cty) {
                    let tao = os_t(c, OS_T_AO);
                    let mut k = 0 as usize;
                    while k < args.len {
                        let _ = os_unknown_arg(c, module, table, locals, args, &callee, k);
                        if os_has_frame_or_param(c, tao) {
                            os_refuse(
                                c,
                                OS_RULE_EXTERN_STORE,
                                "a call through a C function pointer passes it an address of this frame or of a parameter (extern store rule)"
                            );
                            break;
                        }
                        k = k + 1 as usize;
                    }
                }
            }
            os_note_unknown(c, UNKNOWN_FN_VALUE);
            let nargs = args.len + 1 as usize;
            os_unknown_call_effects(c, module, table, locals, args, &callee, nargs, ORIGIN_STATIC);
            os_fn_value_result(c, module, table, locals, args, &callee, owner);
        },
        // A capturing closure's value is the address of its environment struct: it holds what the
        // environment pointer holds, so a read through it reaches the captures (§3, _Closure
        // environments_).
        ZirRvalue.FuncAddr(_, env) => {
            if env != 0 as u32 && (env as usize) < c.nl {
                let _ = os_or(c, vo, env as usize);
            } else if env != 0 as u32 {
                os_add_flag(c, vo, ORIGIN_UNKNOWN);
            } else {
                os_add_flag(c, vo, ORIGIN_RODATA);
            }
        },
        ZirRvalue.GetEnv => { os_add_param(c, vo, c.env_param); },
        ZirRvalue.StringConst(_) => { os_add_flag(c, vo, ORIGIN_RODATA); },
        ZirRvalue.GlobalAddr(_) => { os_add_flag(c, vo, ORIGIN_STATIC); },
        ZirRvalue.Const(_, _) | ZirRvalue.Sizeof(_) | ZirRvalue.VariantCheck(_, _, _) => {},
    }
}

// Writes OS_T_VO/OS_T_VS into the destination the caller walked: its base's sets when no pointer
// was crossed, else every local the memory in OS_T_DM names.
fn os_store(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    base: u32,
    crossed: bool,
    dest_ty: u32
) {
    if dest_ty != 0 as u32 && !os_carries(c, module, dest_ty) { return; }
    let vo = os_t(c, OS_T_VO);
    let vs = os_t(c, OS_T_VS);
    if crossed {
        let dm = os_t(c, OS_T_DM);
        os_write_memory(c, module, table, locals, dm, vo, vs);
        return;
    }
    if base == 0 as u32 || base as usize >= c.nl { return; }
    if !os_carries(c, module, os_local_ty(locals, base)) { return; }
    if os_or(c, base as usize, vo) { c.changed = true; }
    if os_owns(c, module, table, os_local_ty(locals, base)) && os_or(c, c.nl + base as usize, vs) {
        c.changed = true;
    }
}

// The store rule (§3) for the assignment just evaluated into OS_T_VO: a destination that outlives
// the frame (the memory OS_T_DM names, with its reach, when a pointer was crossed; a closure's owned
// capture otherwise) takes no value with a Frame or Unknown origin.
fn os_check_store(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    base: u32,
    crossed: bool
) {
    let vo = os_t(c, OS_T_VO);
    if !os_frame_bound(c, vo) { return; }
    let td = os_t(c, OS_T_D);
    if crossed {
        let dm = os_t(c, OS_T_DM);
        let sf = os_t(c, OS_T_SF);
        os_copy(c, sf, vo);
        os_drop_self_store(c, module, table, locals, sf, dm);
        if !os_frame_bound(c, sf) { return; }
        os_dest_reach(c, module, table, locals, dm, td);
        if !os_external(c, td) { return; }
    } else if base == 0 as u32
        || base as usize > locals.len
        || !locals[base as usize - 1 as usize].is_capture_alias {
        return;
    }
    let val_set = if crossed { os_t(c, OS_T_SF) } else { vo };
    os_refuse(
        c,
        OS_RULE_STORE,
        os_origin_msg(
            c,
            val_set,
            "a value holding an address of this frame is stored into memory that outlives it (store rule)",
            "a value holding an address the compiler cannot trace is stored into memory that outlives it (store rule)"
        )
    );
}

// OS_T_VO/OS_T_VS of a tuple, struct or array literal without the elements DEAD names, as
// os_rvalue reads the rest (os_dead_inits).
fn os_live_elements(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    rv: &ZirRvalue,
    dead: u64
) {
    let vo = os_t(c, OS_T_VO);
    let vs = os_t(c, OS_T_VS);
    os_clear(c, vo);
    os_clear(c, vs);
    let vals = match *rv {
        ZirRvalue.Tuple(v) | ZirRvalue.StructLiteral(_, v) | ZirRvalue.Array(_, v) => v,
        _ => @slice(0 as *mut Place, 0 as usize),
    };
    let mut k = 0 as usize;
    while k < vals.len {
        if k >= 64 as usize || (dead >> (k as u64)) & 1 as u64 == 0 as u64 {
            let _ = os_read(c, module, table, locals, &vals[k], vo, vs);
        }
        k = k + 1 as usize;
    }
}

// exhaustive: every statement must say what it writes into which local's sets.
fn os_stmt(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    locals: [Local],
    st: &ZirStmt
) {
    let own = os_t(c, OS_T_OWN);
    match *st {
        ZirStmt.Let(id, rv, span) => {
            c.span = span;
            os_clear(c, own);
            os_add_frame(c, own, id);
            let dead = if id != 0 as u32 && (id as usize) < c.nl {
                c.dead_init[id as usize]
            } else {
                0 as u64
            };
            if dead == 0 as u64 {
                os_rvalue(c, module, table, locals, &rv, own);
            } else {
                os_live_elements(c, module, table, locals, &rv, dead);
            }
            let ty = os_local_ty(locals, id);
            if id != 0 as u32 && (id as usize) < c.nl && c.cap_bit[id as usize] != 0 as u8 {
                os_env_to_cap(c, os_t(c, OS_T_VO), id as usize);
                os_env_to_cap(c, os_t(c, OS_T_VS), id as usize);
            }
            // An owned capture's storage dies with the closure, whatever the frame does (§3).
            if id != 0 as u32
                && (id as usize) <= locals.len
                && locals[id as usize - 1 as usize].is_capture_alias
                && os_owns(c, module, table, ty) {
                let vs = os_t(c, OS_T_VS);
                os_add_frame(c, vs, id);
            }
            os_store(c, module, table, locals, id, false, ty);
            if let ZirRvalue.FuncAddr(fid, env) = rv {
                if env != 0 as u32 && (id as usize) < c.nl && c.env_of[id as usize] == 0 as u32 {
                    os_check_closure_value(c, module, table, locals, fid, env);
                }
            }
        },
        ZirStmt.Assign(pl, rv, span) => {
            c.span = span;
            let ty = os_walk(c, module, table, locals, &pl);
            let crossed = c.walk_crossed;
            let tm = os_t(c, OS_T_M);
            let dm = os_t(c, OS_T_DM);
            os_copy(c, dm, tm);
            if crossed {
                os_copy(c, own, dm);
            } else {
                os_clear(c, own);
                os_add_frame(c, own, pl.base);
            }
            os_rvalue(c, module, table, locals, &rv, own);
            if c.checking && (ty == 0 as u32 || os_carries(c, module, ty)) {
                os_check_store(c, module, table, locals, pl.base, crossed);
            }
            // An integer stored records no summary edge (§3, _The summary as built_): a callee's
            // bookkeeping (`arena.offset = .. + size`) is no address of what it was computed from,
            // and making a pointer of an integer needs `unsafe`, which answers for the round trip.
            // A capture alias's slot is the environment's memory, so a store into it is an edge
            // too (§3, _Closure environments_).
            let into_env = !crossed
                && (pl.base as usize) < c.nl
                && os_has_frame(c, os_t(c, OS_T_CAP), pl.base as usize);
            if into_env {
                os_clear(c, dm);
                os_add_frame(c, dm, pl.base);
            }
            if (crossed || into_env)
                && (ty == 0 as u32 || os_carries(c, module, ty))
                && (ty == 0 as u32 || os_type_def_tag(module, ty) != ILTYPE_PRIMITIVE) {
                let ev = os_t(c, OS_T_EV);
                let ed = os_t(c, OS_T_ED);
                os_copy(c, ev, os_t(c, OS_T_VO));
                let _ = os_or(c, ev, os_t(c, OS_T_VS));
                os_drop_moved_storage(c, ev, os_t(c, OS_T_VO), os_t(c, OS_T_VS));
                os_dest_reach(c, module, table, locals, dm, ed);
                let ref_flag = if ty == 0 as u32
                    || module.type_holds_reference_no_pointer(ty, 0 as usize) {
                    OS_EDGE_REF
                } else {
                    0 as u64
                };
                os_note_edges(c, ev, ed, ref_flag);
            }
            os_store(c, module, table, locals, pl.base, crossed, ty);
        },
        ZirStmt.Drop(_, _)
            | ZirStmt.DropIfLive(_, _)
            | ZirStmt.EndBorrow(_, _)
            | ZirStmt.Intrinsic(_, _, _) => {},
    }
}

// The origin sets of FUNC's locals (see OriginSets), and under RULES the rules' refusals,
// reported against FILE and counted in `errors`. Parameter i holds
// Param(i) when its type can hold an address; a by-value parameter that owns storage owns
// Frame(itself) (§5: a by-value `Vec` is this frame's). The sets keep only FILE for reporting
// and scratch buffers in ARENA, and nothing of TABLE, MODULE, or FUNC, so the driver can keep
// them live across `ZirVerifier` (`&mut zir_func`) and write summaries into MODULE while they are
// live.
// SAFETY: every slice field on `OriginSets` is allocated in `arena` (or empty) except `file`,
// which is parameter `file`. Nothing from `module`, `table`, or `func` is stored in the result.
#[unsafe(borrows(arena, file))]
pub fn compute_origins_zir(
    arena: *mut ArenaHeader,
    module: &ILModule,
    func: &ZirFunction,
    sret_name: u32,
    table: &InternTable,
    rules: u32,
    file: [u8]
) -> OriginSets {
    let locals = (*func).locals;
    let nl = locals.len + 1 as usize;
    let words = OS_W_FRAME + (nl + 63 as usize) / 64 as usize;
    let nsets = 2 as usize * nl + 2 as usize + OS_TEMPS;
    let nt = module.types.len() + 1 as usize;
    let mut nstmts = 1 as usize;
    for b in (*func).blocks { nstmts = nstmts + b.statements.len; }
    let nf = module.functions.len();
    let drop_fns: [mut u32] = unsafe {
        @slice(zoril_allocator_alloc(arena, nf * 4 + 4) as *mut u32, nf + 1 as usize)
    };
    let mut ndrop = 0 as usize;
    let mut fi = 0 as usize;
    while fi < nf {
        let n = table.lookup(module.functions[fi].name);
        if n.len > 6 as usize
            && n[n.len - 6 as usize] == ':' as u8
            && n[n.len - 5 as usize] == ':' as u8
            && n[n.len - 4 as usize] == 'd' as u8
            && n[n.len - 3 as usize] == 'r' as u8
            && n[n.len - 2 as usize] == 'o' as u8
            && n[n.len - 1 as usize] == 'p' as u8 {
            drop_fns[ndrop] = fi as u32;
            ndrop = ndrop + 1 as usize;
        }
        fi = fi + 1 as usize;
    }
    let mut c = OriginSets {
        nl: nl,
        words: words,
        buf: unsafe {
            @slice(zoril_allocator_alloc(arena, nsets * words * 8) as *mut u64, nsets * words)
        },
        carries_memo: unsafe { @slice(zoril_allocator_alloc(arena, nt) as *mut u8, nt) },
        owns_memo: unsafe { @slice(zoril_allocator_alloc(arena, nt) as *mut u8, nt) },
        walk_crossed: false,
        walk_len: false,
        changed: false,
        passes: 0 as u32,
        unknown_calls: 0 as u32,
        unknown_ids: unsafe {
            @slice(zoril_allocator_alloc(arena, nstmts * 4) as *mut u32, nstmts)
        },
        sret_name: sret_name,
        drop_fns: drop_fns,
        ndrop: ndrop,
        q_memo: unsafe {
            @slice(zoril_allocator_alloc(arena, OS_Q_COUNT * nt) as *mut u8, OS_Q_COUNT * nt)
        },
        nt: nt,
        rules: rules,
        checking: false,
        file: file,
        span: (*func).span,
        errors: 0 as u32,
        seen_diags: unsafe {
            @slice(
                zoril_allocator_alloc(
                    arena,
                    (nstmts * 6 as usize + 6 as usize) * sizeof(OsSeenDiag)
                ) as *mut OsSeenDiag,
                nstmts * 6 as usize + 6 as usize
            )
        },
        seen_diags_len: 0 as usize,
        // SAFETY: a block of OS_EDGE_ROWS * 3 u64 in ARENA, the body's scratch arena, which lives
        // as long as these sets; it is zeroed below before any read.
        edges: unsafe {
            @slice(
                zoril_allocator_alloc(arena, OS_EDGE_ROWS * 3 * 8) as *mut u64,
                OS_EDGE_ROWS * 3 as usize
            )
        },
        env_param: (*func).params.len,
        // SAFETY: NL bytes in ARENA, the body's scratch arena, zeroed below before any read.
        cap_bit: unsafe { @slice(zoril_allocator_alloc(arena, nl) as *mut u8, nl) },
        // SAFETY: NL u32 in ARENA, as above, zeroed below before any read.
        known_fn: unsafe { @slice(zoril_allocator_alloc(arena, nl * 4) as *mut u32, nl) },
        arena: arena,
        known_env: OS_NO_ENV,
        known_tuple: 0 as u32,
        // SAFETY: NL u32 each in ARENA, as above, zeroed below before any read.
        env_of: unsafe { @slice(zoril_allocator_alloc(arena, nl * 4) as *mut u32, nl) },
        // SAFETY: as above.
        env_first: unsafe { @slice(zoril_allocator_alloc(arena, nl * 4) as *mut u32, nl) },
        // SAFETY: as above.
        env_n: unsafe { @slice(zoril_allocator_alloc(arena, nl * 4) as *mut u32, nl) },
        env_caps: @slice(0 as *mut u32, 0 as usize),
        // SAFETY: NL u64 in ARENA, as above, zeroed below before any read.
        dead_init: unsafe { @slice(zoril_allocator_alloc(arena, nl * 8) as *mut u64, nl) },
        releases: 0 as u64,
        env_releases: 0 as u64,
    };
    unsafe {
        memset(c.edges.ptr as *mut u8, 0, (OS_EDGE_ROWS * 3 * 8) as u64);
        memset(c.buf.ptr as *mut u8, 0, (nsets * words * 8) as u64);
        memset(c.carries_memo.ptr as *mut u8, 0, nt as u64);
        memset(c.owns_memo.ptr as *mut u8, 0, nt as u64);
        memset(c.q_memo.ptr as *mut u8, 0, (OS_Q_COUNT * nt) as u64);
        memset(c.cap_bit.ptr as *mut u8, 0, nl as u64);
        memset(c.known_fn.ptr as *mut u8, 0, (nl * 4) as u64);
        memset(c.env_of.ptr as *mut u8, 0, (nl * 4) as u64);
        memset(c.env_first.ptr as *mut u8, 0, (nl * 4) as u64);
        memset(c.env_n.ptr as *mut u8, 0, (nl * 4) as u64);
        memset(c.dead_init.ptr as *mut u8, 0, (nl * 8) as u64);
    }
    let mut pi = 0 as usize;
    while pi < (*func).params.len {
        let p = (*func).params[pi];
        if p.id != 0 as u32 && (p.id as usize) < nl {
            if os_carries(&mut c, module, p.ty) { os_add_param(&mut c, p.id as usize, pi); }
            if os_owns(&mut c, module, table, p.ty) {
                os_add_frame(&mut c, nl + p.id as usize, p.id);
            }
        }
        pi = pi + 1 as usize;
    }
    os_cap_bits(&mut c, module, table, locals);
    os_known_callees(&mut c, func);
    os_known_envs(&mut c, func);
    os_dead_inits(&mut c, module, func);
    let ret = 2 as usize * nl;
    let mut more = true;
    while more {
        c.changed = false;
        c.passes = c.passes + 1 as u32;
        c.unknown_calls = 0 as u32;
        os_pass(&mut c, module, table, func, ret);
        more = c.changed;
        // One more pass over the settled sets applies the rules (§3); it changes no set.
        if !more && c.rules != PROVENANCE_OFF && !c.checking {
            c.checking = true;
            c.unknown_calls = 0 as u32;
            os_pass(&mut c, module, table, func, ret);
        }
    }
    return c;
}

fn os_pass(
    c: &mut OriginSets,
    module: &ILModule,
    table: &InternTable,
    func: &ZirFunction,
    ret: usize
) {
    let locals = (*func).locals;
    for b in (*func).blocks {
        for st in b.statements { os_stmt(c, module, table, locals, st); }
        if let ZirTerminator.Ret(rp) = b.terminator {
            let vo = os_t(c, OS_T_VO);
            let vs = os_t(c, OS_T_VS);
            os_clear(c, vo);
            os_clear(c, vs);
            let _ = os_read(c, module, table, locals, &rp, vo, vs);
            if os_or(c, ret, vo) { c.changed = true; }
            if os_or(c, ret + 1 as usize, vs) { c.changed = true; }
            // The return rule: the result carries no Frame or Unknown origin.
            if c.checking && os_frame_bound(c, vo) {
                if b.statements.len > 0 as usize {
                    c.span = b.statements[b.statements.len - 1 as usize].get_span();
                } else {
                    c.span = (*func).span;
                }
                os_refuse(
                    c,
                    OS_RULE_RETURN,
                    os_origin_msg(
                        c,
                        vo,
                        "the returned value holds an address of this frame (return rule)",
                        "the returned value holds an address the compiler cannot trace (return rule)"
                    )
                );
            }
        }
    }
}

fn os_print_local(id: usize, locals: [Local], table: &InternTable) {
    let mut out = stdout();
    if id >= 1 as usize && id <= locals.len && locals[id - 1 as usize].name_id != 0 as u32 {
        print(table.lookup(locals[id - 1 as usize].name_id));
    } else {
        print("_");
        let _ = write_u64(&mut out, id as u64);
    }
}

// The capture alias whose own ParamContents bit is BIT (os_cap_bits), 0 for none.
fn os_cap_of_bit(c: &OriginSets, bit: usize) -> usize {
    if bit <= c.env_param || bit >= 63 as usize { return 0 as usize; }
    let mut id = 1 as usize;
    while id < c.nl {
        if c.cap_bit[id] as usize == bit { return id; }
        id = id + 1 as usize;
    }
    return 0 as usize;
}

fn os_print_set(c: &OriginSets, set: usize, locals: [Local], table: &InternTable) {
    let mut out = stdout();
    let base = set * c.words;
    let mut first = true;
    print("{");
    let mut w = OS_W_ADDR;
    while w <= OS_W_CONTENTS {
        let mut i = 0 as usize;
        while i < 64 as usize {
            if (c.buf[base + w] >> (i as u64)) & 1 as u64 != 0 as u64 {
                if !first { print(", "); }
                first = false;
                let cap = if w == OS_W_CONTENTS { os_cap_of_bit(c, i) } else { 0 as usize };
                if cap != 0 as usize {
                    print("Env(");
                    os_print_local(cap, locals, table);
                } else {
                    print(if w == OS_W_ADDR { "Param(" } else { "ParamContents(" });
                    let _ = write_u64(&mut out, i as u64);
                    if i == 63 as usize { print("+"); }
                }
                print(")");
            }
            i = i + 1 as usize;
        }
        w = w + 1 as usize;
    }
    let mut id = 1 as usize;
    while id < c.nl {
        if os_has_frame(c, set, id) {
            if !first { print(", "); }
            first = false;
            print("Frame(");
            os_print_local(id, locals, table);
            print(")");
        }
        id = id + 1 as usize;
    }
    let flags = c.buf[base + OS_W_FLAGS];
    if flags & ORIGIN_STATIC != 0 as u64 {
        if !first { print(", "); }
        first = false;
        print("Static");
    }
    if flags & ORIGIN_RODATA != 0 as u64 {
        if !first { print(", "); }
        first = false;
        print("Rodata");
    }
    if flags & ORIGIN_RAW != 0 as u64 {
        if !first { print(", "); }
        first = false;
        print("Raw");
    }
    if flags & ORIGIN_UNKNOWN != 0 as u64 {
        if !first { print(", "); }
        print("Unknown");
    }
    print("}");
}

// `zoril --emit-origins`: one header line per function, then each named local and each temporary
// with a non-empty set, and the return value's origins.
pub fn print_origins(c: &OriginSets, func: &ZirFunction, module: &ILModule, table: &InternTable) {
    let mut out = stdout();
    let locals = (*func).locals;
    print("origins ");
    print(table.lookup((*func).name));
    print(" passes ");
    let _ = write_u64(&mut out, c.passes as u64);
    print(" unknown-calls ");
    let _ = write_u64(&mut out, c.unknown_calls as u64);
    print("\n");
    let mut id = 1 as usize;
    while id < c.nl {
        let named = id <= locals.len && locals[id - 1 as usize].name_id != 0 as u32;
        if named || !os_is_empty(c, id) || !os_is_empty(c, c.nl + id) {
            print("  ");
            os_print_local(id, locals, table);
            print(" O=");
            os_print_set(c, id, locals, table);
            print(" S=");
            os_print_set(c, c.nl + id, locals, table);
            print("\n");
        }
        id = id + 1 as usize;
    }
    let mut k = 0 as usize;
    while k < c.unknown_calls as usize && k < c.unknown_ids.len {
        print("  unknown-call ");
        let fid = c.unknown_ids[k];
        if fid == UNKNOWN_FN_VALUE || fid as usize >= module.functions.len() {
            print("<fn value>");
        } else {
            print(table.lookup(module.functions[fid as usize].name));
        }
        print("\n");
        k = k + 1 as usize;
    }
    print("  return O=");
    os_print_set(c, 2 as usize * c.nl, locals, table);
    print(" S=");
    os_print_set(c, 2 as usize * c.nl + 1 as usize, locals, table);
    print("\n");
    // The store edges of the summary, one line per stored value (§3, _The summary_).
    let mut r = 0 as usize;
    while r < OS_EDGE_ROWS {
        let e = r * 3 as usize;
        if c.edges[e] | c.edges[e + 1 as usize] | c.edges[e + 2 as usize] != 0 as u64 {
            print("  store ");
            os_print_edge_code(r);
            print(" ->");
            let mut w = 0 as usize;
            while w < 2 as usize {
                let mut j = 0 as usize;
                while j < 64 as usize {
                    if (c.edges[e + w] >> (j as u64)) & 1 as u64 != 0 as u64 {
                        print(" ");
                        os_print_edge_code(w * 64 as usize + j);
                    }
                    j = j + 1 as usize;
                }
                w = w + 1 as usize;
            }
            if c.edges[e + 2 as usize] & OS_EDGE_GLOBAL != 0 as u64 { print(" global"); }
            if c.edges[e + 2 as usize] & OS_EDGE_ENV != 0 as u64 { print(" env"); }
            print("\n");
        }
        r = r + 1 as usize;
    }
    if c.releases != 0 as u64 {
        print("  releases");
        let mut ri = 0 as usize;
        while ri < 64 as usize {
            if (c.releases >> (ri as u64)) & 1 as u64 != 0 as u64 {
                print(" ");
                let _ = write_u64(&mut out, ri as u64);
                if ri == 63 as usize { print("+"); }
            }
            ri = ri + 1 as usize;
        }
        print("\n");
    }
}

fn os_print_edge_code(code: usize) {
    let mut out = stdout();
    if code == OS_EDGE_STATIC {
        print("Static");
    } else if code == OS_EDGE_RODATA {
        print("Rodata");
    } else if code == OS_EDGE_UNKNOWN {
        print("Unknown");
    } else {
        print(if code < 64 as usize { "Param(" } else { "ParamContents(" });
        let _ = write_u64(&mut out, (code % 64 as usize) as u64);
        if code % 64 as usize == 63 as usize { print("+"); }
        print(")");
    }
}
