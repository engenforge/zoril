// A map from a pair of interned ids to an id: the resolver's per-module name tables (a
// module's namespaces, and the names its `use` declarations bring in). Open addressing over
// a power-of-two bucket array; a value of 0 means absent.

import "core.zrl";
import "mem_raw.zrl";
import "vec.zrl";
use mem_raw::ArenaHeader;
use vec::Vec;

struct PairEntry {
    a: u32,
    b: u32,
    val: u32,
}

pub struct PairMap {
    entries: Vec<PairEntry>,
    buckets: Vec<u32>, // 1 + index into entries; 0 for an empty bucket
}

impl PairMap {
    pub fn new(arena: *mut ArenaHeader) -> PairMap {
        let mut buckets = unsafe { Vec::<u32>.new_in_raw(arena) };
        buckets.resize(64 as usize);
        return PairMap { entries: unsafe { Vec::<PairEntry>.new_in_raw(arena) }, buckets: buckets };
    }

    // The value of (A, B); 0 if it has none.
    pub fn get(self: &PairMap, a: u32, b: u32) -> u32 {
        let mask = self.buckets.len() - 1 as usize;
        let mut i = pair_hash(a, b) & mask;
        loop {
            let slot = self.buckets.as_slice()[i];
            if slot == 0 as u32 { return 0 as u32; }
            let e = self.entries.as_slice()[slot as usize - 1 as usize];
            if e.a == a && e.b == b { return e.val; }
            i = (i + 1 as usize) & mask;
        }
        return 0 as u32;
    }

    // Sets (A, B) to VAL (not 0), replacing any value it had.
    pub fn set(self: &mut PairMap, a: u32, b: u32, val: u32) {
        let mask = self.buckets.len() - 1 as usize;
        let mut i = pair_hash(a, b) & mask;
        loop {
            let slot = self.buckets.as_slice()[i];
            if slot == 0 as u32 { break; }
            let e = self.entries.as_slice()[slot as usize - 1 as usize];
            if e.a == a && e.b == b {
                self.entries.set(slot as usize - 1 as usize, PairEntry { a: a, b: b, val: val });
                return;
            }
            i = (i + 1 as usize) & mask;
        }
        self.entries.push(PairEntry { a: a, b: b, val: val });
        self.buckets.set(i, self.entries.len() as u32);
        if self.entries.len() * 2 as usize > self.buckets.len() { self.rehash(); }
    }

    fn rehash(self: &mut PairMap) {
        let size = self.buckets.len() * 2 as usize;
        let mask = size - 1 as usize;
        self.buckets.clear();
        self.buckets.resize(size);
        for k in 0 as usize..self.entries.len() {
            let e = self.entries.as_slice()[k];
            let mut i = pair_hash(e.a, e.b) & mask;
            while self.buckets.as_slice()[i] != 0 as u32 { i = (i + 1 as usize) & mask; }
            self.buckets.set(i, (k + 1 as usize) as u32);
        }
    }
}

fn pair_hash(a: u32, b: u32) -> usize {
    return ((((a as u64) *% (0x9e3779b97f4a7c15 as u64)) ^ (b as u64))
        *% (0xff51afd7ed558ccd as u64)
        >> (17 as u64)) as usize;
}
