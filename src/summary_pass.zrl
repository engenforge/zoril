import "diag.zrl";
import "core.zrl";
import "mem_raw.zrl";
import "io.zrl";
import "fmt.zrl";
import "il_type.zrl";
import "il_instr.zrl";
import "il_cfg.zrl";
import "intern.zrl";
import "vec.zrl";
import "ast.zrl";
use ast::Span;
use diag::diag_start;
use il_cfg::{ILFunction, ILModule};
use il_instr::{ILInstr, NO_SSA, SSAId};
use il_type::{ILTYPE_ARRAY, ILTYPE_BOXED, ILTYPE_BOXEDMUT, ILTYPE_FN, ILTYPE_PTR, ILTYPE_PTRMUT, ILTYPE_SLICE, ILTYPE_TUPLE, ILTYPE_USER, is_any_pointer_tag};
use intern::InternTable;
use io::{eprint, stderr};
use fmt::write_u64;
use mem_raw::{ArenaHeader, memset, zoril_allocator_alloc};
use vec::Vec;

pub struct FuncSummary {
    pub name: u32,
    pub returns_param_mask: u64,
    pub stashes_param_mask: u64,
    // The same two for what is read *through* a parameter (`c.v` of `ex(c: Carrier)`) as against the
    // parameter itself (`id(p)`): a caller must tell the argument from what it points at.
    pub returns_via_mask: u64,
    pub stashes_via_mask: u64,
    pub returns_local_stack: bool,
    pub is_extern: bool,
}

pub struct InterprocSummaryPass {
    pub arena: *mut ArenaHeader,
    pub module: &mut ILModule,
    pub intern_table: &mut InternTable,
    pub file_path: [u8],
    pub summaries: [mut FuncSummary],
    pub had_error: bool,
    pub error_count: usize,
    pub max_ssa: usize,
    pub prov_is_stack: [mut bool],
    pub prov_param_mask: [mut u64],
    pub prov_load_mask: [mut u64],
    pub borrowed_from: [mut u32],
    pub slot_holds_stack: [mut bool],
    pub slot_holds_param: [mut u64],
    pub slot_holds_load: [mut u64],
    pub is_stack_slot: [mut bool],
    pub is_global_addr: [mut bool],
    pub addr_taken_func_ids: [u32],
    pub addr_taken_count: usize,
    pub total_direct_calls: usize,
    pub total_indirect_calls: usize,
    pub indirect_candidate_evals: usize,
    pub fixpoint_iterations: usize,
    pub verbose: bool,
}

impl InterprocSummaryPass {
    pub fn new(
        arena: *mut ArenaHeader,
        module: &mut ILModule,
        table: &mut InternTable,
        file_path: [u8]
    ) -> InterprocSummaryPass {
        let mut max_ssa = 64 as usize;
        for fi in 0 as usize..module.functions.len() {
            if module.functions[fi].result_types_len > max_ssa {
                max_ssa = module.functions[fi].result_types_len;
            }
        }
        max_ssa = max_ssa + 256 as usize;
        let summaries = initial_summaries(module, arena);
        let mut addr_taken = unsafe { Vec::<u32>.new_in_raw(arena) };
        let (direct_calls, indirect_calls) = scan_calls(module, &mut addr_taken);

        // Seven parallel per-SSA provenance arrays, all allocated and sized here.
        return InterprocSummaryPass {
            arena: arena,
            module: module,
            intern_table: table,
            file_path: file_path,
            summaries: summaries,
            had_error: false,
            error_count: 0 as usize,
            max_ssa: max_ssa,
            prov_is_stack: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 1) as *mut bool, max_ssa)
            },
            prov_param_mask: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 8) as *mut u64, max_ssa)
            },
            prov_load_mask: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 8) as *mut u64, max_ssa)
            },
            borrowed_from: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 4) as *mut u32, max_ssa)
            },
            slot_holds_stack: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 1) as *mut bool, max_ssa)
            },
            slot_holds_param: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 8) as *mut u64, max_ssa)
            },
            slot_holds_load: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 8) as *mut u64, max_ssa)
            },
            is_stack_slot: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 1) as *mut bool, max_ssa)
            },
            is_global_addr: unsafe {
                @slice(zoril_allocator_alloc(arena, max_ssa * 1) as *mut bool, max_ssa)
            },
            addr_taken_func_ids: addr_taken.as_slice(),
            addr_taken_count: addr_taken.len(),
            total_direct_calls: direct_calls,
            total_indirect_calls: indirect_calls,
            indirect_candidate_evals: 0 as usize,
            fixpoint_iterations: 0 as usize,
            verbose: false,
        };
    }

    // An imported Zoril function whose interface carried no #[summary] is an unknown callee, and an
    // unknown callee must be assumed to do the worst with every pointer it is handed: stash each
    // pointer-like parameter into long-lived memory and return any of them. All-zero ("nothing
    // escapes") is the optimistic reading and would silently weaken the safety analysis.
    pub fn apply_conservative_defaults(
        self: &mut InterprocSummaryPass,
        compile_only: bool,
        target_sf: u32
    ) {
        let env_id = self.intern_table.intern("__env");
        let sret_id = self.intern_table.intern("__sret");
        let mut fi = 0 as usize;
        while fi < self.module.functions.len() {
            let p_f = &self.module.functions[fi];
            if p_f.is_zoril_extern(compile_only, target_sf) && !p_f.has_summary {
                let mut ptr_mask = 0 as u64;
                let mut k = 0 as usize;
                while k < p_f.params_len && k < 64 as usize {
                    let p = p_f.param(k);
                    if p.name != env_id && p.name != sret_id {
                        if self.is_pointer_like(p.ty) || self.is_aggregate(p.ty) {
                            ptr_mask = ptr_mask | ((1 as u64) << (k as u64));
                        }
                    }
                    k = k + 1 as usize;
                }
                self.summaries[fi].stashes_param_mask = ptr_mask;
                self.summaries[fi].stashes_via_mask = ptr_mask;
                if self.is_pointer_like(p_f.ret_ty) || self.is_aggregate(p_f.ret_ty) {
                    self.summaries[fi].returns_param_mask = ptr_mask;
                    self.summaries[fi].returns_via_mask = ptr_mask;
                }
            }
            fi = fi + 1 as usize;
        }
    }

    // What the memory ARG points at holds, as far as known: a stack pointer, parameters directly,
    // parameters through loads. Only a slot of this frame or a parameter's referent is known.
    fn arg_contents(
        self: &InterprocSummaryPass,
        arg_ssa: SSAId,
        max_ssa: usize
    ) -> (bool, u64, u64) {
        let base = self.get_base(arg_ssa, max_ssa);
        if (base as usize) < max_ssa && self.is_stack_slot[base as usize] {
            return (
                self.slot_holds_stack[base as usize],
                self.slot_holds_param[base as usize],
                self.slot_holds_load[base as usize]
            );
        }
        // A frame pointer from a load or a call has no known slot: fail closed.
        return (
            self.prov_is_stack[arg_ssa as usize],
            0 as u64,
            self.prov_param_mask[arg_ssa as usize] | self.prov_load_mask[arg_ssa as usize]
        );
    }

    // A by-value aggregate is passed as a pointer to the caller's copy (`ILParam.by_ref`): the bits
    // describe what the copy holds, not the copy's frame address (`first("hi")`, `set_ice_note(v.as_slice())`).
    fn arg_provenance(
        self: &InterprocSummaryPass,
        target: &ILFunction,
        p_idx: usize,
        arg_ssa: SSAId,
        max_ssa: usize
    ) -> (bool, u64, u64) {
        if p_idx < target.params_len && target.param(p_idx).by_ref {
            return self.arg_contents(arg_ssa, max_ssa);
        }
        return (
            self.prov_is_stack[arg_ssa as usize],
            self.prov_param_mask[arg_ssa as usize],
            self.prov_load_mask[arg_ssa as usize]
        );
    }

    fn call_result_flow(
        self: &InterprocSummaryPass,
        target: &ILFunction,
        args: [SSAId],
        ret_mask: u64,
        ret_via: u64,
        first_arg: usize,
        max_ssa: usize
    ) -> (bool, u64, u64) {
        let mut stack = false;
        let mut params = 0 as u64;
        let mut loaded = 0 as u64;
        let mut p_idx = first_arg;
        while p_idx < args.len && p_idx < 64 as usize {
            if (args[p_idx] as usize) < max_ssa {
                let bit = (1 as u64) << (p_idx as u64);
                if (ret_mask & bit) != 0 as u64 {
                    let (s, p, l) = self.arg_provenance(target, p_idx, args[p_idx], max_ssa);
                    stack = stack || s;
                    params = params | p;
                    loaded = loaded | l;
                }
                if (ret_via & bit) != 0 as u64 {
                    let (s, p, l) = self.arg_contents(args[p_idx], max_ssa);
                    stack = stack || s;
                    params = params | p;
                    loaded = loaded | l;
                }
            }
            p_idx = p_idx + 1 as usize;
        }
        return (stack, params, loaded);
    }

    fn call_stashes_stack(
        self: &InterprocSummaryPass,
        target: &ILFunction,
        args: [SSAId],
        stash_mask: u64,
        stash_via: u64,
        max_ssa: usize
    ) -> bool {
        let mut p_idx = 0 as usize;
        while p_idx < args.len && p_idx < 64 as usize {
            if (args[p_idx] as usize) < max_ssa {
                let bit = (1 as u64) << (p_idx as u64);
                if (stash_mask & bit) != 0 as u64 {
                    let (s, _p, _l) = self.arg_provenance(target, p_idx, args[p_idx], max_ssa);
                    if s { return true; }
                }
                if (stash_via & bit) != 0 as u64 {
                    let (s, _p, _l) = self.arg_contents(args[p_idx], max_ssa);
                    if s { return true; }
                }
            }
            p_idx = p_idx + 1 as usize;
        }
        return false;
    }

    fn is_sret_memory(
        self: &mut InterprocSummaryPass,
        f: &ILFunction,
        base: SSAId,
        max_ssa: usize
    ) -> bool {
        if f.params_len == 0 as usize || (base as usize) >= max_ssa { return false; }
        let sret_id = self.intern_table.intern("__sret");
        return f.param(0 as usize).name == sret_id
            && self.prov_param_mask[base as usize] == 1 as u64;
    }

    // An aggregate result comes back through `__sret`: the slot passed first then holds what the
    // result carries, so `ex(mk(&x))` and `let c = mk(&x); ex(c)` see the pointer to `x`.
    fn note_call_result(
        self: &mut InterprocSummaryPass,
        target: &ILFunction,
        args: [SSAId],
        ssa: SSAId,
        ret_mask: u64,
        ret_via: u64,
        ret_stack: bool,
        max_ssa: usize
    ) {
        let sret_id = self.intern_table.intern("__sret");
        let has_sret = target.params_len > 0 as usize
            && target.param(0 as usize).name == sret_id
            && args.len > 0 as usize;
        let first_arg = if has_sret { 1 as usize } else { 0 as usize };
        let (stack, params, loaded) = self.call_result_flow(
            target,
            args,
            ret_mask,
            ret_via,
            first_arg,
            max_ssa
        );
        if has_sret {
            let dst = self.get_base(args[0], max_ssa);
            if (dst as usize) < max_ssa && self.is_stack_slot[dst as usize] {
                self.slot_holds_stack[dst as usize] = self.slot_holds_stack[dst as usize]
                    || stack
                    || ret_stack;
                self.slot_holds_param[dst as usize] = self.slot_holds_param[dst as usize] | params;
                self.slot_holds_load[dst as usize] = self.slot_holds_load[dst as usize] | loaded;
            }
            return;
        }
        if ssa != 0 as u32 && ssa != NO_SSA && (ssa as usize) < max_ssa {
            self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                || stack
                || ret_stack;
            self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize] | params;
            self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize] | loaded;
        }
    }

    fn get_base(self: &InterprocSummaryPass, ssa: SSAId, max_ssa: usize) -> SSAId {
        let mut curr = ssa;
        let mut depth = 0 as usize;
        while curr != 0 as u32 && (curr as usize) < max_ssa && depth < 50 as usize {
            let parent = self.borrowed_from[curr as usize];
            if parent == 0 as u32 { break; }
            curr = parent;
            depth = depth + 1 as usize;
        }
        return curr;
    }

    fn matches_signature(
        self: &InterprocSummaryPass,
        target: &ILFunction,
        args_len: usize
    ) -> bool {
        return target.params_len == args_len;
    }

    fn get_ssa_type(self: &InterprocSummaryPass, f: &ILFunction, ssa: SSAId) -> u32 {
        if ssa == 0 as u32 || ssa as usize >= f.result_types_len { return 0 as u32; }
        return f.result_type_ids()[ssa as usize];
    }

    fn is_pointer_like(self: &InterprocSummaryPass, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        let tag = p_ty.def.get_tag();
        return is_any_pointer_tag(tag)
            || tag == ILTYPE_SLICE
            || tag == ILTYPE_FN
            || tag == ILTYPE_BOXED
            || tag == ILTYPE_BOXEDMUT;
    }

    fn is_aggregate(self: &InterprocSummaryPass, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        let tag = p_ty.def.get_tag();
        return tag == ILTYPE_ARRAY || tag == ILTYPE_TUPLE || tag == ILTYPE_USER || tag == ILTYPE_FN;
    }

    fn report_error(self: &mut InterprocSummaryPass, msg: [u8], span: Span) {
        self.had_error = true;
        self.error_count = self.error_count + 1 as usize;
        diag_start(self.file_path, span, "error");
        eprint(msg);
        eprint("\n");
    }

    fn analyze_function(
        self: &mut InterprocSummaryPass,
        f: &ILFunction,
        check_errors: bool
    ) -> bool {
        let ssa_count = f.result_types_len;
        if ssa_count == 0 as usize { return false; }
        let clear_len = if ssa_count > self.max_ssa { self.max_ssa } else { ssa_count };

        let saved_file_path = self.file_path;
        if f.source_file != 0 as u32 {
            self.file_path = self.intern_table.lookup(f.source_file);
        }

        unsafe {
            memset(self.prov_is_stack.ptr as *mut u8, 0, clear_len as u64);
            memset(self.prov_param_mask.ptr as *mut u8, 0, (clear_len * 8) as u64);
            memset(self.prov_load_mask.ptr as *mut u8, 0, (clear_len * 8) as u64);
            memset(self.borrowed_from.ptr as *mut u8, 0, (clear_len * 4) as u64);
            memset(self.slot_holds_stack.ptr as *mut u8, 0, clear_len as u64);
            memset(self.slot_holds_param.ptr as *mut u8, 0, (clear_len * 8) as u64);
            memset(self.slot_holds_load.ptr as *mut u8, 0, (clear_len * 8) as u64);
            memset(self.is_stack_slot.ptr as *mut u8, 0, clear_len as u64);
            memset(self.is_global_addr.ptr as *mut u8, 0, clear_len as u64);
        }

        // Parameters
        let mut k_p = 0 as usize;
        while k_p < f.params_len {
            let p_ssa = f.param(k_p).ssa;
            if (p_ssa as usize) < clear_len {
                if k_p < 64 as usize {
                    self.prov_param_mask[p_ssa as usize] = (1 as u64) << (k_p as u64);
                }
            }
            k_p = k_p + 1 as usize;
        }

        let mut new_returns_param_mask = 0 as u64;
        let mut new_returns_local_stack = false;
        let mut new_stashes_param_mask = 0 as u64;
        let mut new_returns_via_mask = 0 as u64;
        let mut new_stashes_via_mask = 0 as u64;

        // Run 2 local iterations for loop / branch propagation
        let mut pass_iter = 0 as usize;
        while pass_iter < 2 as usize {
            let is_final_pass = (pass_iter == 1 as usize);
            let mut bi = 0 as usize;
            while bi < f.blocks_len {
                let blocks_slice = f.block_ids();
                let block_id = blocks_slice[bi];
                let p_b = self.module.blocks[block_id as usize];
                let mut ii = 0 as usize;
                while ii < p_b.instructions_len {
                    let instrs_slice = p_b.instr_ids();
                    let ssa_slice = p_b.ssa_result_ids();
                    let instr_idx = instrs_slice[ii];
                    let ssa = ssa_slice[ii];
                    let p_in = self.module.instrs[instr_idx as usize];
                    let span = self.module.instr_spans[instr_idx as usize];

                    self.transfer_instr(
                        f,
                        &p_in,
                        ssa,
                        span,
                        clear_len,
                        check_errors && is_final_pass,
                        &mut new_returns_param_mask,
                        &mut new_returns_local_stack,
                        &mut new_stashes_param_mask,
                        &mut new_returns_via_mask,
                        &mut new_stashes_via_mask
                    );

                    ii = ii + 1 as usize;
                }
                bi = bi + 1 as usize;
            }
            pass_iter = pass_iter + 1 as usize;
        }

        let fid = f.id as usize;
        let old_ret_mask = self.summaries[fid].returns_param_mask;
        let old_stack = self.summaries[fid].returns_local_stack;
        let old_stash = self.summaries[fid].stashes_param_mask;
        let old_ret_via = self.summaries[fid].returns_via_mask;
        let old_stash_via = self.summaries[fid].stashes_via_mask;

        self.file_path = saved_file_path;
        if new_returns_param_mask != old_ret_mask
            || new_returns_local_stack != old_stack
            || new_stashes_param_mask != old_stash
            || new_returns_via_mask != old_ret_via
            || new_stashes_via_mask != old_stash_via {
            self.summaries[fid].returns_param_mask = new_returns_param_mask;
            self.summaries[fid].returns_local_stack = new_returns_local_stack;
            self.summaries[fid].stashes_param_mask = new_stashes_param_mask;
            self.summaries[fid].returns_via_mask = new_returns_via_mask;
            self.summaries[fid].stashes_via_mask = new_stashes_via_mask;
            return true;
        }
        return false;
    }

    fn transfer_instr(
        self: &mut InterprocSummaryPass,
        f: &ILFunction,
        instr: &ILInstr,
        ssa: SSAId,
        span: Span,
        max_ssa: usize,
        check_errors: bool,
        out_ret_mask: &mut u64,
        out_ret_stack: &mut bool,
        out_stash_mask: &mut u64,
        out_ret_via: &mut u64,
        out_stash_via: &mut u64
    ) {
        let valid_ssa = (ssa != 0 as u32 && ssa != NO_SSA && (ssa as usize) < max_ssa);
        match *instr {
            ILInstr.Alloc(a) => {
                if valid_ssa {
                    match a.region {
                        Region.Local => {
                            if a.allocator == 0xffffffff as u32 {
                                self.is_stack_slot[ssa as usize] = true;
                                self.prov_is_stack[ssa as usize] = true;
                            }
                        },
                        Region.Static | Region.Heap | Region.Custom(_) => {}
                    }
                }
            },
            ILInstr.GlobalAddr(_) => {
                if valid_ssa {
                    self.is_global_addr[ssa as usize] = true;
                }
            },
            ILInstr.Param(idx) => {
                if valid_ssa && idx < 64 as u32 {
                    self.prov_param_mask[ssa as usize] = (1 as u64) << (idx as u64);
                }
            },
            ILInstr.FieldAddr(fa) => {
                if valid_ssa && (fa.val as usize) < max_ssa {
                    self.borrowed_from[ssa as usize] = fa.val;
                    self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                        || self.prov_is_stack[fa.val as usize];
                    self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize]
                        | self.prov_param_mask[fa.val as usize];
                    self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                        | self.prov_load_mask[fa.val as usize];
                }
            },
            ILInstr.Add(op) => {
                if valid_ssa && (op.lhs as usize) < max_ssa {
                    self.borrowed_from[ssa as usize] = op.lhs;
                    self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                        || self.prov_is_stack[op.lhs as usize];
                    self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize]
                        | self.prov_param_mask[op.lhs as usize];
                    self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                        | self.prov_load_mask[op.lhs as usize];
                }
            },
            ILInstr.Move(src) => {
                if valid_ssa && (src as usize) < max_ssa {
                    self.borrowed_from[ssa as usize] = src;
                    self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                        || self.prov_is_stack[src as usize];
                    self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize]
                        | self.prov_param_mask[src as usize];
                    self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                        | self.prov_load_mask[src as usize];
                }
            },
            ILInstr.RegionCast(rc) => {
                if valid_ssa && (rc.val as usize) < max_ssa {
                    self.borrowed_from[ssa as usize] = rc.val;
                    self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                        || self.prov_is_stack[rc.val as usize];
                    self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize]
                        | self.prov_param_mask[rc.val as usize];
                    self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                        | self.prov_load_mask[rc.val as usize];
                }
            },
            ILInstr.Cast(c) => {
                if valid_ssa && (c.val as usize) < max_ssa {
                    self.borrowed_from[ssa as usize] = c.val;
                    self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                        || self.prov_is_stack[c.val as usize];
                    self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize]
                        | self.prov_param_mask[c.val as usize];
                    self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                        | self.prov_load_mask[c.val as usize];
                }
            },
            ILInstr.SliceConstruct(sc) => {
                if valid_ssa && (sc.ptr as usize) < max_ssa {
                    self.borrowed_from[ssa as usize] = sc.ptr;
                    self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                        || self.prov_is_stack[sc.ptr as usize];
                    self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize]
                        | self.prov_param_mask[sc.ptr as usize];
                    self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                        | self.prov_load_mask[sc.ptr as usize];
                }
            },
            ILInstr.Phi(phi) => {
                if valid_ssa {
                    let mut pi = 0 as usize;
                    while pi < phi.preds.len {
                        let pv = phi.preds[pi].val;
                        if (pv as usize) < max_ssa {
                            self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                                || self.prov_is_stack[pv as usize];
                            self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize]
                                | self.prov_param_mask[pv as usize];
                            self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                                | self.prov_load_mask[pv as usize];
                        }
                        pi = pi + 1 as usize;
                    }
                }
            },
            ILInstr.Store(s) => {
                if (s.ptr as usize) < max_ssa && (s.val as usize) < max_ssa {
                    let base = self.get_base(s.ptr, max_ssa);
                    if (base as usize) < max_ssa {
                        if self.is_stack_slot[base as usize] {
                            self.slot_holds_stack[base as usize] = self.slot_holds_stack[base as usize]
                                || self.prov_is_stack[s.val as usize];
                            self.slot_holds_param[base as usize] = self.slot_holds_param[base as usize]
                                | self.prov_param_mask[s.val as usize];
                            self.slot_holds_load[base as usize] = self.slot_holds_load[base as usize]
                                | self.prov_load_mask[s.val as usize];
                        } else if self.is_global_addr[base as usize] {
                            if check_errors && self.prov_is_stack[s.val as usize] {
                                self.report_error(
                                    "region escape: storing local stack pointer into global variable",
                                    span
                                );
                            }
                            let p_mask = self.prov_param_mask[s.val as usize];
                            if p_mask != 0 as u64 {
                                *out_stash_mask = *out_stash_mask | p_mask;
                            }
                            *out_stash_via = *out_stash_via | self.prov_load_mask[s.val as usize];
                        } else {
                            // Target is memory pointed to by a parameter
                            if self.is_sret_memory(f, base, max_ssa) {
                                *out_ret_mask = *out_ret_mask
                                    | self.prov_param_mask[s.val as usize];
                                *out_ret_via = *out_ret_via | self.prov_load_mask[s.val as usize];
                            }
                            let p_mask_target = self.prov_param_mask[base as usize];
                            if p_mask_target != 0 as u64 {
                                if check_errors && self.prov_is_stack[s.val as usize] {
                                    self.report_error(
                                        "region escape: storing local stack pointer into caller memory",
                                        span
                                    );
                                }
                            }
                        }
                    }
                }
            },
            ILInstr.Load(src) => {
                if valid_ssa && (src as usize) < max_ssa {
                    let val_ty = self.get_ssa_type(f, ssa);
                    if self.is_pointer_like(val_ty) || self.is_aggregate(val_ty) {
                        let base = self.get_base(src, max_ssa);
                        if (base as usize) < max_ssa {
                            if self.is_stack_slot[base as usize] {
                                self.prov_is_stack[ssa as usize] = self.prov_is_stack[ssa as usize]
                                    || self.slot_holds_stack[base as usize];
                                self.prov_param_mask[ssa as usize] = self.prov_param_mask[ssa as usize]
                                    | self.slot_holds_param[base as usize];
                                self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                                    | self.slot_holds_load[base as usize];
                            } else {
                                // Read from a parameter's referent: its contents, not the parameter.
                                self.prov_load_mask[ssa as usize] = self.prov_load_mask[ssa as usize]
                                    | self.prov_param_mask[base as usize]
                                    | self.prov_load_mask[base as usize];
                            }
                        }
                    }
                }
            },
            ILInstr.Call(c) => {
                let call_name = self.intern_table.lookup(c.name_id);
                if call_name == "memcpy" && c.args.len >= 2 as usize {
                    let dst = c.args[0];
                    let src = c.args[1];
                    let base_dst = self.get_base(dst, max_ssa);
                    let base_src = self.get_base(src, max_ssa);
                    if (base_dst as usize) < max_ssa && self.is_stack_slot[base_dst as usize] {
                        if (base_src as usize) < max_ssa && self.is_stack_slot[base_src as usize] {
                            self.slot_holds_stack[base_dst as usize] = self.slot_holds_stack[base_dst as usize]
                                || self.slot_holds_stack[base_src as usize];
                            self.slot_holds_param[base_dst as usize] = self.slot_holds_param[base_dst as usize]
                                | self.slot_holds_param[base_src as usize];
                            self.slot_holds_load[base_dst as usize] = self.slot_holds_load[base_dst as usize]
                                | self.slot_holds_load[base_src as usize];
                        } else if (base_src as usize) < max_ssa {
                            self.slot_holds_stack[base_dst as usize] = self.slot_holds_stack[base_dst as usize]
                                || self.prov_is_stack[base_src as usize];
                            self.slot_holds_load[base_dst as usize] = self.slot_holds_load[base_dst as usize]
                                | self.prov_param_mask[base_src as usize]
                                | self.prov_load_mask[base_src as usize];
                        }
                    } else if (base_dst as usize) < max_ssa {
                        let p_mask = self.prov_param_mask[base_dst as usize];
                        if self.is_sret_memory(f, base_dst, max_ssa)
                            && (base_src as usize) < max_ssa {
                            if self.is_stack_slot[base_src as usize] {
                                *out_ret_mask = *out_ret_mask
                                    | self.slot_holds_param[base_src as usize];
                                *out_ret_via = *out_ret_via
                                    | self.slot_holds_load[base_src as usize];
                            } else {
                                *out_ret_via = *out_ret_via
                                    | self.prov_param_mask[base_src as usize]
                                    | self.prov_load_mask[base_src as usize];
                            }
                        }
                        if p_mask != 0 as u64 {
                            let src_has_stack = if (base_src as usize) < max_ssa
                                && self.is_stack_slot[base_src as usize] {
                                self.slot_holds_stack[base_src as usize]
                            } else if (base_src as usize) < max_ssa {
                                self.prov_is_stack[base_src as usize]
                            } else {
                                false
                            };
                            if check_errors && src_has_stack {
                                self.report_error(
                                    "region escape: returning a pointer to local stack storage via sret",
                                    span
                                );
                            }
                        }
                    }
                } else {
                    let p_target = self.module.callee(&c);
                    if p_target != 0 as *mut ILFunction {
                        let tid = unsafe { (*p_target).id } as usize;
                        let ret_mask = self.summaries[tid].returns_param_mask;
                        let ret_via = self.summaries[tid].returns_via_mask;
                        let stash_mask = self.summaries[tid].stashes_param_mask;
                        let stash_via = self.summaries[tid].stashes_via_mask;
                        let ret_stack = self.summaries[tid].returns_local_stack;
                        self.note_call_result(
                            unsafe { &*p_target },
                            c.args,
                            ssa,
                            ret_mask,
                            ret_via,
                            ret_stack,
                            max_ssa
                        );
                        if check_errors
                            && self.call_stashes_stack(
                                unsafe { &*p_target },
                                c.args,
                                stash_mask,
                                stash_via,
                                max_ssa
                            ) {
                            self.report_error(
                                "region escape: callee stashes local stack pointer into global memory",
                                span
                            );
                        }
                    }
                }
            },
            ILInstr.CallPtr(c) => {
                let mut cand_i = 0 as usize;
                while cand_i < self.addr_taken_count {
                    let tid = self.addr_taken_func_ids[cand_i] as usize;
                    let p_target = &self.module.functions[tid];
                    if self.matches_signature(p_target, c.args.len) {
                        self.indirect_candidate_evals = self.indirect_candidate_evals + 1 as usize;
                        let ret_mask = self.summaries[tid].returns_param_mask;
                        let ret_via = self.summaries[tid].returns_via_mask;
                        let stash_mask = self.summaries[tid].stashes_param_mask;
                        let stash_via = self.summaries[tid].stashes_via_mask;
                        let ret_stack = self.summaries[tid].returns_local_stack;
                        let target = self.module.functions[tid];
                        self.note_call_result(
                            &target,
                            c.args,
                            ssa,
                            ret_mask,
                            ret_via,
                            ret_stack,
                            max_ssa
                        );
                        if check_errors
                            && self.call_stashes_stack(
                                &target,
                                c.args,
                                stash_mask,
                                stash_via,
                                max_ssa
                            ) {
                            self.report_error(
                                "region escape: callee stashes local stack pointer via indirect call",
                                span
                            );
                        }
                    }
                    cand_i = cand_i + 1 as usize;
                }
            },
            ILInstr.Ret(res) => {
                if res != 0 as u32 && res != NO_SSA && (res as usize) < max_ssa {
                    let ret_ty = f.ret_ty;
                    if self.is_pointer_like(ret_ty) || self.is_aggregate(ret_ty) {
                        *out_ret_mask = *out_ret_mask | self.prov_param_mask[res as usize];
                        *out_ret_via = *out_ret_via | self.prov_load_mask[res as usize];
                        if self.prov_is_stack[res as usize] {
                            *out_ret_stack = true;
                            if check_errors {
                                self.report_error(
                                    "region escape: returning a pointer to local stack storage",
                                    span
                                );
                            }
                        }
                    }
                }
            },
            _ => {}
        }
    }

    pub fn run(self: &mut InterprocSummaryPass, check_errors: bool) -> bool {
        if self.verbose {
            eprint("PROGRESS: Running interprocedural summary pass...\n");
        }

        let mut changed = true;
        let mut iter = 0 as usize;
        let max_iters = 20 as usize;

        while changed && iter < max_iters {
            changed = false;
            iter = iter + 1 as usize;

            let mut fi = 0 as usize;
            while fi < self.module.functions.len() {
                let p_f = self.module.functions[fi];
                if !p_f.is_extern && p_f.blocks_len > 0 as usize {
                    let func_changed = self.analyze_function(&p_f, false);
                    if func_changed {
                        changed = true;
                    }
                }
                fi = fi + 1 as usize;
            }
        }
        self.fixpoint_iterations = iter;

        // Final verification pass with error reporting
        if check_errors {
            let mut fi2 = 0 as usize;
            while fi2 < self.module.functions.len() {
                let p_f = self.module.functions[fi2];
                if !p_f.is_extern && p_f.blocks_len > 0 as usize {
                    self.analyze_function(&p_f, true);
                }
                fi2 = fi2 + 1 as usize;
            }
        }

        if self.verbose {
            eprint("SUMMARY PASS: functions=");
            let mut err = stderr();
            let _ = write_u64(&mut err, self.module.functions.len() as u64);
            eprint(", direct_calls=");
            let _ = write_u64(&mut err, self.total_direct_calls as u64);
            eprint(", indirect_calls=");
            let _ = write_u64(&mut err, self.total_indirect_calls as u64);
            eprint(", addr_taken=");
            let _ = write_u64(&mut err, self.addr_taken_count as u64);
            eprint(", candidate_evals=");
            let _ = write_u64(&mut err, self.indirect_candidate_evals as u64);
            eprint(", iters=");
            let _ = write_u64(&mut err, self.fixpoint_iterations as u64);
            eprint(", errors=");
            let _ = write_u64(&mut err, self.error_count as u64);
            eprint("\n");
        }

        return !self.had_error;
    }
}

// Each function's summary to start from: an import's from its interface, else empty.
fn initial_summaries(module: &ILModule, arena: *mut ArenaHeader) -> [mut FuncSummary] {
    let n = module.functions.len();
    let summaries = unsafe {
        @slice(zoril_allocator_alloc(arena, n * sizeof(FuncSummary)) as *mut FuncSummary, n)
    };
    for fi in 0 as usize..n {
        let f = &module.functions[fi];
        summaries[fi] = FuncSummary {
            name: f.name,
            returns_param_mask: if f.has_summary { f.summary_escape } else { 0 as u64 },
            stashes_param_mask: if f.has_summary { f.summary_stash } else { 0 as u64 },
            returns_via_mask: if f.has_summary { f.summary_escape_via } else { 0 as u64 },
            stashes_via_mask: if f.has_summary { f.summary_stash_via } else { 0 as u64 },
            returns_local_stack: f.has_summary && f.summary_ret_stack,
            is_extern: f.is_extern,
        };
    }
    return summaries;
}

// The functions whose address is taken (each once, into ADDR_TAKEN: the candidates of an
// indirect call), and the counts of direct and indirect calls.
fn scan_calls(module: &ILModule, addr_taken: &mut Vec<u32>) -> (usize, usize) {
    let mut direct = 0 as usize;
    let mut indirect = 0 as usize;
    for fi in 0 as usize..module.functions.len() {
        let f = &module.functions[fi];
        for bi in 0 as usize..f.blocks_len {
            let b = &module.blocks[f.block_ids()[bi] as usize];
            for ii in 0 as usize..b.instructions_len {
                match module.instrs[b.instr_ids()[ii] as usize] {
                    // FuncAddr holds the function's id (its index), not a name.
                    ILInstr.FuncAddr(fid) => {
                        if (fid as usize) < module.functions.len() {
                            let mut already = false;
                            for t in addr_taken.as_slice() { if *t == fid { already = true; } }
                            if !already { addr_taken.push(fid); }
                        }
                    },
                    ILInstr.Call(_) => { direct = direct + 1 as usize; },
                    ILInstr.CallPtr(_) => { indirect = indirect + 1 as usize; },
                    _ => {},
                }
            }
        }
    }
    return (direct, indirect);
}
