import "ast.zrl";
import "resolve.zrl";
import "il_cfg.zrl";
import "il_type.zrl";
import "intern.zrl";
import "mem_raw.zrl";
import "io.zrl";
import "fmt.zrl";
import "bytevec.zrl";
import "vec.zrl";
import "diag.zrl";
use ast::{AST, Decl, DeclId, EnumDecl, FnDecl, ImplDecl, StructDecl, TYPE_PATH, TYPE_PRIMITIVE, Type, TypeId, TypeParam};
use diag::diag_start;
use bytevec::ByteVec;
use il_cfg::{ILFunction, ILModule, il_module_set_typedef};
use il_type::{ILEnum, ILField, ILPRIM_NEVER, ILPRIM_UNIT, ILStruct, ILType, ILTypeDecl, ILTypeDef, ILUser, ILVariant};
use intern::InternTable;
use io::{eprint, stderr};
use fmt::write_u64;
use mem_raw::{ArenaHeader, zoril_allocator_alloc};
use resolve::{Resolver, SymbolKind, last_path_segment};
use vec::Vec;

// A closure's result taken from its body (ClosureSig.ret).
pub const INFER_RESULT: u32 = 0xffffffff;

// The types a closure's signature leaves unwritten (`|x| x + 1`), inferred where the closure is
// lowered: by parameter (0 where it is written), and its result (0: none, unit; INFER_RESULT:
// its body's type, known once the body is lowered).
struct ClosureSig {
    name: u32,
    params: [u32],
    ret: u32,
}

// The type parameters an impl's methods see, and their arguments (Monomorphizer.impl_scope).
struct ImplScope {
    params: [TypeParam],
    args: [u32],
}

pub struct Monomorphizer {
    pub arena: *mut ArenaHeader,
    pub module: &mut ILModule,
    pub resolver: &mut Resolver,
    pub intern_table: &mut InternTable,
    // Lowers a function instance: the driver's lower_fn_instance, set by set_lowerer. A
    // function and its context rather than the Driver, which holds this Monomorphizer.
    pub lower_instance: fn(*mut u8, *FnDecl, u32, *TypeParam, usize, *u32, usize, u32, u32, bool) -> u32,
    pub lower_ctx: *mut u8,

    pub mono_functions: MonoRegistry,
    pub mono_types: MonoRegistry,
    pub mono_typedefs: MonoRegistry,
    pub typedef_to_decl: Vec<u32>,

    pub cap_func_idxs: Vec<u32>,
    pub cap_env_local_ids: Vec<u32>,

    pub pending_cap_names: *mut u32,
    pub pending_cap_tys: *mut u32,
    pub pending_cap_len: usize,
    pub pending_cap_env_ty: u32,
    pub closure_count: u32,
    // How many associated type projections are being resolved, one inside another.
    pub projection_depth: u32,
    closure_sigs: Vec<ClosureSig>,
}

impl Monomorphizer {
    #[stores(arena -> arena, module -> arena, resolver -> arena, intern_table -> arena)]
    pub fn new(
        arena: *mut ArenaHeader,
        module: &mut ILModule,
        resolver: &mut Resolver,
        intern_table: &mut InternTable
    ) -> *mut Monomorphizer {
        let m = unsafe {
            zoril_allocator_alloc(arena, sizeof(Monomorphizer))
        } as *mut Monomorphizer;
        unsafe {
            *m = Monomorphizer {
                arena: arena,
                module: module,
                resolver: resolver,
                intern_table: intern_table,
                lower_instance: no_lowerer,
                lower_ctx: 0 as *mut u8,
                mono_functions: MonoRegistry.new(arena),
                mono_types: MonoRegistry.new(arena),
                mono_typedefs: MonoRegistry.new(arena),
                typedef_to_decl: unsafe { Vec::<u32>.new_in_raw(arena) },
                cap_func_idxs: unsafe { Vec::<u32>.new_in_raw(arena) },
                cap_env_local_ids: unsafe { Vec::<u32>.new_in_raw(arena) },
                pending_cap_names: 0 as *mut u32,
                pending_cap_tys: 0 as *mut u32,
                pending_cap_len: 0 as usize,
                pending_cap_env_ty: 0 as u32,
                closure_count: 0 as u32,
                projection_depth: 0 as u32,
                closure_sigs: unsafe { Vec::<ClosureSig>.new_in_raw(arena) },
            };
        }
        return m;
    }

    #[stores(f -> self, ctx -> self)]
    pub fn set_lowerer(
        self: &mut Monomorphizer,
        f: fn(*mut u8, *FnDecl, u32, *TypeParam, usize, *u32, usize, u32, u32, bool) -> u32,
        ctx: *mut u8
    ) {
        self.lower_instance = f;
        self.lower_ctx = ctx;
    }

    // F lowered as NAME with TYPE_PARAMS bound to TYPE_ARGS (see Driver.lower_fn_instance).
    fn lower_fn(
        self: &mut Monomorphizer,
        f: &FnDecl,
        name: u32,
        type_params: [TypeParam],
        type_args: [u32],
        self_name: u32,
        self_ty: u32,
        is_closure: bool
    ) -> u32 {
        let lower = self.lower_instance;
        return lower(
            self.lower_ctx,
            f as *FnDecl,
            name,
            type_params.ptr,
            type_params.len,
            type_args.ptr,
            type_args.len,
            self_name,
            self_ty,
            is_closure
        );
    }

    pub fn lower_closure_fn(self: &mut Monomorphizer, f: &FnDecl, name: u32) -> u32 {
        return self.lower_fn(
            f,
            name,
            f.type_params,
            @slice(0 as *u32, 0 as usize),
            0 as u32,
            0 as u32,
            true
        );
    }

    pub fn instantiate_type(self: &mut Monomorphizer, decl_id: u32, type_args: [u32]) -> u32 {
        let existing = self.mono_types.lookup(decl_id, type_args);
        if existing != 0xffffffff as u32 {
            let p_ty: &mut ILTypeDecl = &mut self.module.types[existing as usize - 1 as usize];
            if p_ty.name == 0 as u32 {
                let ast: &AST = self.resolver.ast;
                let p_decl: &Decl = &ast.decls[decl_id as usize];
                match *p_decl {
                    Decl.Struct(s) => { p_ty.name = s.name; },
                    Decl.Enum(e) => { p_ty.name = e.name; },
                    Decl.Fn(_)
                        | Decl.Trait(_)
                        | Decl.Impl(_)
                        | Decl.TypeAlias(_)
                        | Decl.Const(_)
                        | Decl.Static(_)
                        | Decl.Import(_)
                        | Decl.None => {},
                }
            }
            return existing;
        }

        let ast: &AST = self.resolver.ast;
        let p_decl: &Decl = &ast.decls[decl_id as usize];
        let mut name_id = 0 as u32;
        let mut decl_source_file = 0 as u32;
        match *p_decl {
            Decl.Struct(s) => { name_id = s.name; decl_source_file = s.source_file; },
            Decl.Enum(e) => { name_id = e.name; decl_source_file = e.source_file; },
            _ => {
                ICE("Monomorphizer.instantiate_type: expected struct or enum declaration");
            }
        }

        let base_name_id = name_id;
        name_id = self.instance_name(self.intern_table.lookup(name_id), type_args);
        let mut args_vec = unsafe { Vec::<u32>.with_capacity_in_raw(self.arena, type_args.len) };
        for t in type_args { args_vec.push(*t); }

        let new_ty = self.module.alloc_type(ILTypeDecl {
            id: 0 as u32,
            name: name_id,
            def: ILType.User(ILUser {
                id: 0 as u32,
                name: name_id,
                type_args: args_vec.as_slice()
            }),
            // A named type, so it has a module: `Foo<i32>` is `struct Foo<T>`'s
            // (unlike the anonymous Ptr, Slice, Tuple types resolve_type builds).
            source_file: decl_source_file,
        });
        self.mono_types.insert(decl_id, type_args, new_ty);

        let typedef_id = if type_args.len > 0 as usize {
            self.lower_generic_typedef(decl_id, type_args)
        } else {
            self.lower_typedef(decl_id)
        };
        // Update the type definition with the correct typedef ID
        let p_new_ty: &mut ILTypeDecl = &mut self.module.types[new_ty as usize - 1 as usize];
        match p_new_ty.def {
            ILType.User(u) => {
                let mut u2 = u;
                u2.id = typedef_id;

                p_new_ty.def = ILType.User(u2);
                self.module.rebuild_type_hash_table();
            },
            _ => { ICE("Monomorphizer.instantiate_type: expected ILType.User"); }
        }

        if type_args.len > 0 as usize {
            let mut all_concrete = true;
            for t in type_args {
                if !self.is_concrete_type(*t) {
                    all_concrete = false;
                }
            }
            if all_concrete {
                let drop_trait_name = self.intern_table.intern("Drop");
                let drop_method_name = self.intern_table.intern("drop");
                for i in 1 as usize..self.resolver.ast.decls.len() {
                    let imp = match self.resolver.ast.decls[i] {
                        Decl.Impl(imp) => imp,
                        _ => { continue; }
                    };
                    if imp.trait_name == drop_trait_name {
                        let t = imp.target_ty;
                        if t != 0 as TypeId && (t as usize) < self.resolver.ast.types.len() {
                            let matches_base = match self.resolver.ast.types[t as usize] {
                                Type.Path((n, _)) => n == base_name_id,
                                _ => false,
                            };
                            if matches_base
                                && self.impl_covers(i as u32, new_ty)
                                && self.impl_bounds_hold_for_type(&imp, new_ty, 0 as usize) {
                                for m in imp.methods {
                                    if m.name == drop_method_name {
                                        let no_args = @slice(0 as *mut u32, 0 as usize);
                                        self.instantiate_method(
                                            m,
                                            no_args,
                                            name_id,
                                            drop_method_name,
                                            &imp,
                                            new_ty
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        return new_ty;
    }

    pub fn instantiate_function(self: &mut Monomorphizer, decl_id: u32, type_args: [u32]) -> u32 {
        let existing = self.mono_functions.lookup(decl_id, type_args);
        if existing != 0xffffffff as u32 { return existing; }

        let ast: &AST = self.resolver.ast;
        let p_decl: &Decl = &ast.decls[decl_id as usize];
        match *p_decl {
            Decl.Fn(f) => {
                let name = self.mangle_name(f.name, type_args);

                // Already lowered under this name (a non-generic function lowered with its module).
                for i in 0 as usize..self.module.functions.len() {
                    let p_func: &ILFunction = &self.module.functions[i];
                    if p_func.name == name
                        && p_func.owner_len == 0 as u32
                        && p_func.source_file == f.source_file {
                        self.mono_functions.insert(decl_id, type_args, i as u32);
                        return i as u32;
                    }
                }

                let id = self.lower_fn(
                    &f,
                    name,
                    f.type_params,
                    type_args,
                    0 as u32,
                    0 as u32,
                    false
                );
                self.mono_functions.insert(decl_id, type_args, id);
                return id;
            },
            _ => { ICE("instantiate_function: expected fn declaration"); }
        }
    }
    pub fn instantiate_method(
        self: &mut Monomorphizer,
        f: &FnDecl,
        type_args: [u32],
        self_name: u32,
        method_name: u32,
        imp: &ImplDecl,
        self_ty: u32
    ) -> u32 {
        // Extract receiver type args and struct decl_id from self_ty (the IL type for the receiver).
        // In Zoril, `impl Foo<T>` sets imp.type_params.len=0 (T is not an explicit impl type param).
        // The struct's type params and base name come from the AST struct/enum declaration.
        let mut recv_type_args = @slice(0 as *mut u32, 0 as usize);
        let mut typedef_id_for_recv = 0 as u32;
        if self_ty != 0 as u32 {
            let p_selfty: ILTypeDecl = self.module.types[self_ty as usize - 1 as usize];
            match p_selfty.def {
                ILType.User(u) => {
                    recv_type_args = u.type_args;
                    typedef_id_for_recv = u.id;
                },
                _ => {},
            }
        }

        // Get the struct/enum decl_id via typedef_to_decl, then get type params and base name.
        let struct_decl_id = self.get_typedef_origin(typedef_id_for_recv);
        let mut struct_type_params = @slice(0 as *mut TypeParam, 0 as usize);
        let mut struct_base_name = 0 as u32;
        if struct_decl_id != 0 as u32 && struct_decl_id as usize < self.resolver.ast.decls.len() {
            let p_decl: Decl = self.resolver.ast.decls[struct_decl_id as usize];
            match p_decl {
                Decl.Struct(s) => {
                    struct_type_params = s.type_params;
                    struct_base_name = s.name;
                },
                Decl.Enum(e) => { struct_type_params = e.type_params; struct_base_name = e.name; },
                _ => {},
            }
        }

        // For `impl Stack<i32>` called as `Stack.new()`: the receiver at call site is uninstantiated
        // (recv_type_args=[]), but the impl's target type has concrete args (e.g. i32).
        // Resolve imp.target_ty to get those concrete args as a fallback.
        if recv_type_args.len == 0 as usize && struct_type_params.len > 0 as usize {
            let p_tgt: Type = self.resolver.ast.types[imp.target_ty as usize];
            if p_tgt.get_tag() == TYPE_PATH {
                let path = p_tgt.get_Path();
                let path_targs = path.1;
                if path_targs.len > 0 as usize {
                    let resolved = self.resolver.resolve_type_list(path_targs);
                    let mut all_valid = true;
                    for r in resolved { if *r == 0 as u32 { all_valid = false; } }
                    if all_valid { recv_type_args = resolved; }
                }
            }
        }

        // The receiver type's instance name, whether SELF_NAME is already one (`Vec_Tu8`) or
        // bare (`Stack`); then `Type::method[_T<method args>]`.
        let effective_type_name = if struct_base_name != 0 as u32 {
            self.instance_name(self.intern_table.lookup(struct_base_name), recv_type_args)
        } else if self_name != 0 as u32 {
            self_name
        } else {
            let mut ty_buf = unsafe { ByteVec.new_raw(self.arena) };
            self.get_type_mangled_name_to(self_ty, ty_buf);
            self.intern_table.intern(ty_buf.as_slice())
        };
        let mut method_full = unsafe { ByteVec.new_raw(self.arena) };
        method_full.push_slice(self.intern_table.lookup(effective_type_name));
        method_full.push_slice("::");
        method_full.push_slice(self.intern_table.lookup(method_name));
        let mangled_name = self.instance_name(method_full.as_slice(), type_args);

        // By module too: two modules can each have a type of one name.
        for i in 0 as usize..self.module.functions.len() {
            let p_func: &ILFunction = &self.module.functions[i];
            if p_func.name == mangled_name
                && p_func.owner_len > 0 as u32
                && p_func.source_file == imp.source_file {
                return i as u32;
            }
        }

        // The impl's parameters then the method's own, bound to the receiver's arguments then
        // the method's. A trait's default method sees the trait's parameters instead, bound
        // to the impl's trait arguments (`T` of `Source<T>` is `i64` in `impl Source<i64>`).
        let scope = self.impl_scope(imp, self_ty, struct_type_params, recv_type_args);
        if imp.trait_name != 0 as u32
            && f.default_of == 0 as u32
            && (!self.impl_is_concrete(imp) || f.type_params.len > 0 as usize) {
            self.check_impl_method_signature(imp, f, self_ty, scope, type_args);
        }
        let mut params = unsafe { Vec::<TypeParam>.new_in_raw(self.arena) };
        let mut args = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        if f.default_of != 0 as u32 {
            let trait_id = self.resolver.trait_decl_named(imp.trait_name, imp.source_file);
            for tp in self.resolver.ast.decls[trait_id as usize].get_Trait().type_params {
                params.push(*tp);
            }
            let trait_args = self.resolve_in_impl(
                imp.trait_type_args,
                imp,
                scope.params,
                scope.args,
                self_ty
            );
            for a in trait_args { args.push(*a); }
        } else {
            for tp in scope.params { params.push(*tp); }
            for a in scope.args { args.push(*a); }
        }
        for tp in f.type_params { params.push(*tp); }
        for a in type_args { args.push(*a); }
        let id = self.lower_fn(
            f,
            mangled_name,
            params.as_slice(),
            args.as_slice(),
            effective_type_name,
            self_ty,
            false
        );
        return id;
    }

    // The associated type NAME of TY (`Self::Item`, or `I::Item` with I bound to TY): the type
    // the impl for TY defines it as, resolved as that impl's methods see it. Reports (at SITE,
    // in MODULE's file) and gives 0 when no impl for TY defines it, when two do, or when its
    // definition leads back to itself.
    pub fn project_assoc_type(
        self: &mut Monomorphizer,
        ty: u32,
        name: u32,
        site: TypeId,
        module: u32
    ) -> u32 {
        if self.projection_depth > 32 as u32 {
            self.report_projection(site, module, ty, name, "is defined in terms of itself");
            return 0 as u32;
        }
        self.projection_depth = self.projection_depth + 1 as u32;
        let ty_params = self.instance_type_params(ty);
        let ty_args = self.instance_type_args(ty);
        let mut found = 0 as u32;
        let mut count = 0 as usize;
        for i in 1 as usize..self.resolver.ast.decls.len() {
            let imp = match self.resolver.ast.decls[i] {
                Decl.Impl(imp) => imp,
                _ => { continue; }
            };
            let mut assoc = 0 as TypeId;
            for a in imp.assoc_types { if a.name == name { assoc = a.ty; } }
            if assoc == 0 as TypeId { continue; }
            let scope = self.impl_scope(&imp, ty, ty_params, ty_args);
            if !self.impl_applies(i as u32, &imp, ty, scope.params, scope.args) { continue; }
            let saved = self.enter_impl(&imp, scope.params, scope.args, ty);
            let resolved = self.resolver.resolve_type(assoc);
            self.leave_impl(saved);
            count = count + 1 as usize;
            if count == 1 as usize { found = resolved; }
        }
        self.projection_depth = self.projection_depth - 1 as u32;
        if count == 1 as usize { return found; }
        self.report_projection(
            site,
            module,
            ty,
            name,
            if count == 0 as usize {
                "is defined by no impl"
            } else {
                "is defined by more than one impl"
            }
        );
        return 0 as u32;
    }

    fn report_projection(
        self: &mut Monomorphizer,
        site: TypeId,
        module: u32,
        ty: u32,
        name: u32,
        problem: [u8]
    ) {
        self.resolver.had_error = true;
        if module == 0 as u32 || self.resolver.reported_types.get(site, 0 as u32) != 0 as u32 {
            return;
        }
        self.resolver.reported_types.set(site, 0 as u32, 1 as u32);
        diag_start(
            self.intern_table.lookup(module),
            self.resolver.ast.type_spans[site as usize],
            "error"
        );
        eprint("associated type `");
        eprint(self.intern_table.lookup(name));
        eprint("` of `");
        eprint(self.type_display(ty));
        eprint("` ");
        eprint(problem);
        eprint("\n");
    }

    // Whether impl IMP (declaration IMPL_ID) is for TY, its target type's parameters (PARAMS)
    // bound to ARGS: a struct or enum instance must be the impl's target with those arguments
    // (`impl Tr for W<i32>` is not for W<i64>); another type only a primitive target can name.
    fn impl_applies(
        self: &mut Monomorphizer,
        impl_id: u32,
        imp: &ImplDecl,
        ty: u32,
        params: [TypeParam],
        args: [u32]
    ) -> bool {
        let origin = match self.module.types[ty as usize - 1 as usize].def {
            ILType.User(u) => self.get_typedef_origin(u.id),
            _ => 0 as u32
        };
        if origin != 0 as u32 {
            if self.resolver.impl_type_decl(impl_id) != origin { return false; }
        } else if self.resolver.ast.types[imp.target_ty as usize].get_tag() != TYPE_PRIMITIVE {
            return false;
        }
        let saved = self.enter_impl(imp, params, args, ty);
        let target = self.resolver.resolve_type(imp.target_ty);
        self.leave_impl(saved);
        return target == ty;
    }

    // Checks every method of trait impl IMPL_ID whose types are known without instantiating it
    // (a non-generic impl's non-generic methods) against the trait; the others are checked as
    // each instance is made (instantiate_method).
    pub fn check_concrete_trait_impl(self: &mut Monomorphizer, impl_id: u32) {
        let imp = match self.resolver.ast.decls[impl_id as usize] {
            Decl.Impl(imp) => imp,
            _ => { return; }
        };
        if imp.trait_name == 0 as u32 || !self.impl_is_concrete(&imp) { return; }
        let saved_module = self.resolver.current_module;
        self.resolver.current_module = imp.source_file;
        let self_ty = self.resolver.resolve_type(imp.target_ty);
        self.resolver.current_module = saved_module;
        if self_ty == 0 as u32 { return; }
        let no_params = @slice(0 as *mut TypeParam, 0 as usize);
        let no_args = @slice(0 as *mut u32, 0 as usize);
        let scope = ImplScope { params: no_params, args: no_args };
        for m in imp.methods {
            if m.default_of == 0 as u32 && m.type_params.len == 0 as usize {
                self.check_impl_method_signature(&imp, m, self_ty, scope, no_args);
            }
        }
    }

    // An impl with no parameters of its own for a type named with no arguments (`impl Tr for
    // S`, `impl Tr for i32`): its methods' types are known as written, so `check_concrete_trait_impl`
    // checks their signatures against the trait now rather than as each instance is made. A
    // specialisation (`impl Tr for W<i32>`) is not one of these and is checked the other way.
    fn impl_is_concrete(self: &mut Monomorphizer, imp: &ImplDecl) -> bool {
        if imp.type_params.len > 0 as usize { return false; }
        return match self.resolver.ast.types[imp.target_ty as usize] {
            Type.Path(path) => path.1.len == 0 as usize,
            Type.Primitive(_) => true,
            _ => false,
        };
    }

    // Whether IMP's target names one type (`impl S`, `impl Clone for i32`, `impl W<i32>`,
    // `impl Pair<u8, bool>`), so that its methods are the same bodies in every build of the program
    // and can be checked with no instance of the type (`Driver.check_uncalled_methods`). False for
    // `impl<T> W<T>` and `impl W<T>`, whose target is written with a type parameter, and for an impl
    // that declares parameters of its own (`impl<A> Tr<A> for S`): those methods have no one `Self`
    // to be checked against, and an instance is what checks them (`instantiate_method`), as a
    // generic method's body is checked at its own instantiation.
    pub fn impl_target_is_concrete(self: &mut Monomorphizer, imp: &ImplDecl) -> bool {
        if imp.type_params.len > 0 as usize { return false; }
        return !self.target_names_param(imp.target_ty, imp.source_file);
    }

    pub fn is_concrete_type(self: &Monomorphizer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 || (ty_id as usize) > self.module.types.len() { return false; }
        let p_ty: &ILTypeDecl = &self.module.types[ty_id as usize - 1 as usize];
        return match p_ty.def {
            ILType.Primitive(_) => true,
            ILType.Ptr(inner)
                | ILType.PtrMut(inner)
                | ILType.RawPtr(inner)
                | ILType.RawPtrMut(inner)
                | ILType.Boxed(inner)
                | ILType.BoxedMut(inner) => self.is_concrete_type(inner),
            ILType.Slice(s) => self.is_concrete_type(s.element),
            ILType.Array(a) => self.is_concrete_type(a.element),
            ILType.Fn(f) => {
                if f.ret_ty != 0 as u32 && !self.is_concrete_type(f.ret_ty) { return false; }
                for p in f.params {
                    if !self.is_concrete_type(*p) { return false; }
                }
                true
            },
            ILType.Tuple(types) => {
                for t in types {
                    if !self.is_concrete_type(*t) { return false; }
                }
                true
            },
            ILType.User(u) => {
                for t in u.type_args {
                    if !self.is_concrete_type(*t) { return false; }
                }
                true
            },
            ILType.FD(_) | ILType.IORing => true,
            ILType.Var(_) => false,
        };
    }

    // Whether the type TY_ID, as module MODULE writes it, names a type parameter: a name that names
    // no type there (`Resolver.names_type`) - `T` of `impl<T> W<T>` or `impl W<T>`, declared by the
    // impl or by the type it targets, and put in scope by neither. The resolver reads an impl's target
    // the same way when it checks a declaration's type names (`Resolver.check_declared_types`), so the
    // two agree on which names in a target are parameters.
    fn target_names_param(self: &mut Monomorphizer, ty_id: TypeId, module: u32) -> bool {
        match self.resolver.ast.types[ty_id as usize] {
            Type.Path(path) => {
                if !self.resolver.names_type(path.0, module) { return true; }
                for a in path.1 {
                    if self.target_names_param(*a, module) { return true; }
                }
                return false;
            },
            Type.Ptr(inner)
                | Type.PtrMut(inner)
                | Type.Ref(inner)
                | Type.RefMut(inner)
                | Type.Slice(inner)
                | Type.SliceMut(inner) => { return self.target_names_param(inner, module); },
            Type.Array(a) => { return self.target_names_param(a.0, module); },
            Type.Tuple(types) => {
                for t in types {
                    if self.target_names_param(*t, module) { return true; }
                }
                return false;
            },
            Type.Fn(f) => {
                for p in f.params {
                    if self.target_names_param(*p, module) { return true; }
                }
                return self.target_names_param(f.ret_ty, module);
            },
            _ => { return false; },
        }
    }

    // Checks method F of trait impl IMP, for receiver SELF_TY with the impl's parameters bound
    // as SCOPE has them and the method's own bound to TYPE_ARGS, against the trait's
    // declaration of it: as many parameters, each of the same type, and the same result, with
    // `Self`, the trait's parameters and its associated types as this impl has them.
    fn check_impl_method_signature(
        self: &mut Monomorphizer,
        imp: &ImplDecl,
        f: &FnDecl,
        self_ty: u32,
        scope: ImplScope,
        type_args: [u32]
    ) {
        let trait_id = self.resolver.trait_decl_named(imp.trait_name, imp.source_file);
        if trait_id == 0 as u32 { return; }
        let tr = match self.resolver.ast.decls[trait_id as usize] {
            Decl.Trait(tr) => tr,
            _ => { return; }
        };
        let mut tm_found = false;
        let mut tm = *f;
        for m in tr.methods {
            if m.name == f.name { tm = *m; tm_found = true; }
        }
        if !tm_found { return; }
        let span = self.resolver.ast.expr_spans[f.body as usize];
        if f.params.len != tm.params.len {
            self.resolver.had_error = true;
            diag_start(self.intern_table.lookup(f.source_file), span, "error");
            self.write_mismatch_head(f.name, tr.name);
            eprint("it takes ");
            let mut err = stderr();
            let _ = write_u64(&mut err, f.params.len as u64);
            eprint(" parameters, the trait's ");
            let _ = write_u64(&mut err, tm.params.len as u64);
            eprint("\n");
            return;
        }
        if f.type_params.len != tm.type_params.len { return; }

        // The impl's signature, as its body sees it.
        let saved = self.enter_impl(imp, scope.params, scope.args, self_ty);
        self.bind_type_params(f.type_params, type_args);
        let mut impl_tys = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        for p in f.params { impl_tys.push(self.resolver.resolve_type(p.ty)); }
        let impl_ret = self.resolver.resolve_type(f.ret_ty);
        let trait_args = self.resolver.resolve_type_list(imp.trait_type_args);
        self.leave_impl(saved);

        // The trait's, in the trait's module, its parameters bound to the impl's arguments.
        let saved_module = self.resolver.current_module;
        self.resolver.current_module = tr.source_file;
        self.resolver.push_scope();
        self.bind_type_params(tr.type_params, trait_args);
        self.resolver.define(self.intern_table.intern("Self"), SymbolKind.Type(self_ty), false);
        self.bind_type_params(tm.type_params, type_args);
        let mut trait_tys = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        for p in tm.params { trait_tys.push(self.resolver.resolve_type(p.ty)); }
        let trait_ret = self.resolver.resolve_type(tm.ret_ty);
        self.resolver.pop_scope();
        self.resolver.current_module = saved_module;

        for i in 0 as usize..f.params.len {
            let here = impl_tys.as_slice()[i];
            let there = trait_tys.as_slice()[i];
            if here != 0 as u32 && there != 0 as u32 && here != there {
                self.resolver.had_error = true;
                diag_start(self.intern_table.lookup(f.source_file), span, "error");
                self.write_mismatch_head(f.name, tr.name);
                eprint("parameter ");
                let mut err = stderr();
                let _ = write_u64(&mut err, (i + 1 as usize) as u64);
                eprint(" is `");
                eprint(self.type_display(here));
                eprint("`, the trait's `");
                eprint(self.type_display(there));
                eprint("`\n");
                return;
            }
        }
        if !self.same_result(impl_ret, trait_ret) {
            self.resolver.had_error = true;
            diag_start(self.intern_table.lookup(f.source_file), span, "error");
            self.write_mismatch_head(f.name, tr.name);
            eprint("it returns `");
            eprint(self.type_display(impl_ret));
            eprint("`, the trait `");
            eprint(self.type_display(trait_ret));
            eprint("`\n");
        }
    }

    fn write_mismatch_head(self: &mut Monomorphizer, method: u32, trait_name: u32) {
        eprint("method `");
        eprint(self.intern_table.lookup(method));
        eprint("` does not match trait `");
        eprint(self.intern_table.lookup(trait_name));
        eprint("`: ");
    }

    // Whether two result types agree, no result and `unit` being the same.
    fn same_result(self: &mut Monomorphizer, a: u32, b: u32) -> bool {
        if a == b { return true; }
        let unit = self.resolver.primitive_type(ILPRIM_UNIT);
        return (a == 0 as u32 || a == unit) && (b == 0 as u32 || b == unit);
    }

    // Whether impl IMPL_ID serves receiver type TY: its target, its parameters bound from TY,
    // is TY (`impl W<&i32>` does not serve W<i64>). A receiver with no type arguments (a
    // generic type named bare, `Stack.new()`) and a target that is no named type are not
    // decided here.
    pub fn impl_covers(self: &mut Monomorphizer, impl_id: u32, ty: u32) -> bool {
        let imp = match self.resolver.ast.decls[impl_id as usize] {
            Decl.Impl(i) => i,
            _ => { return true; },
        };
        if self.resolver.ast.types[imp.target_ty as usize].get_tag() != TYPE_PATH { return true; }
        let ty_args = self.instance_type_args(ty);
        if ty_args.len == 0 as usize { return true; }
        let ty_params = self.instance_type_params(ty);
        let scope = self.impl_scope(&imp, ty, ty_params, ty_args);
        return self.impl_applies(impl_id, &imp, ty, scope.params, scope.args);
    }

    pub fn impl_bounds_hold_for_type(
        self: &mut Monomorphizer,
        imp: &ImplDecl,
        ty: u32,
        depth: usize
    ) -> bool {
        if imp.type_params.len == 0 as usize { return true; }
        if depth > 8 as usize { return true; }
        let ty_args = match self.module.types[ty as usize - 1 as usize].def {
            ILType.User(u) => u.type_args,
            _ => { return true; },
        };
        let p_target = self.resolver.ast.types[imp.target_ty as usize];
        if p_target.get_tag() != TYPE_PATH { return true; }
        let target_args = p_target.get_Path().1;
        let mut ai = 0 as usize;
        while ai < target_args.len && ai < ty_args.len {
            let p_arg = self.resolver.ast.types[target_args[ai] as usize];
            let mut arg_name = 0 as u32;
            if p_arg.get_tag() == TYPE_PATH {
                let path = p_arg.get_Path();
                if path.1.len == 0 as usize {
                    arg_name = path.0;
                }
            }
            let mut pi = 0 as usize;
            while arg_name != 0 as u32 && pi < imp.type_params.len {
                if imp.type_params[pi].name == arg_name {
                    let bounds = imp.type_params[pi].bounds;
                    let mut bi = 0 as usize;
                    while bi < bounds.len {
                        let p_bound = self.resolver.ast.types[bounds[bi] as usize];
                        if p_bound.get_tag() == TYPE_PATH {
                            let bound_name = p_bound.get_Path().0;
                            if !self.type_implements_trait(
                                ty_args[ai],
                                bound_name,
                                imp.source_file,
                                depth + 1 as usize
                            ) {
                                return false;
                            }
                        }
                        bi = bi + 1 as usize;
                    }
                }
                pi = pi + 1 as usize;
            }
            ai = ai + 1 as usize;
        }
        return true;
    }

    pub fn type_implements_trait(
        self: &mut Monomorphizer,
        ty: u32,
        trait_name: u32,
        trait_module: u32,
        depth: usize
    ) -> bool {
        if depth > 8 as usize { return true; }
        if ty == 0 as u32 || (ty as usize) > self.module.types.len() { return false; }
        let copy_name = self.intern_table.intern("Copy");
        if trait_name == copy_name {
            match self.module.types[ty as usize - 1 as usize].def {
                ILType.Primitive(_)
                    | ILType.Ptr(_)
                    | ILType.PtrMut(_)
                    | ILType.RawPtr(_)
                    | ILType.RawPtrMut(_) => { return true; },
                _ => {},
            }
        }
        let p_ty = &self.module.types[ty as usize - 1 as usize];
        match p_ty.def {
            ILType.User(_) | ILType.Primitive(_) => {},
            _ => { return false; },
        }
        let ty_name = p_ty.name;
        let ast: &AST = self.resolver.ast;
        for di in 1 as usize..ast.decls.len() {
            let p_decl: &Decl = &ast.decls[di];
            if let Decl.Impl(imp) = *p_decl {
                if imp.trait_name != 0 as u32
                    && self.resolver.same_trait(
                        imp.trait_name,
                        imp.source_file,
                        trait_name,
                        trait_module
                    )
                    && self.impl_target_matches(imp.target_ty, ty, ty_name)
                    && self.impl_covers(di as u32, ty)
                    && self.impl_bounds_hold_for_type(&imp, ty, depth) {
                    return true;
                }
            }
        }
        return false;
    }

    fn impl_target_matches(
        self: &mut Monomorphizer,
        target_ty: u32,
        ty_id: u32,
        ty_name: u32
    ) -> bool {
        let ast: &AST = self.resolver.ast;
        let p_target: &Type = &ast.types[target_ty as usize];
        if p_target.get_tag() == TYPE_PRIMITIVE {
            return self.resolver.primitive_type(p_target.get_Primitive().get_tag()) == ty_id;
        }
        if p_target.get_tag() != TYPE_PATH || ty_name == 0 as u32 { return false; }
        let target_name = p_target.get_Path().0;
        if target_name == ty_name { return true; }
        let target_str = self.intern_table.lookup(target_name);
        let ty_str = self.intern_table.lookup(ty_name);
        if ty_str.len <= target_str.len || ty_str[target_str.len] != '_' as u8 {
            return false;
        }
        let mut i = 0 as usize;
        while i < target_str.len {
            if ty_str[i] != target_str[i] { return false; }
            i = i + 1 as usize;
        }
        return true;
    }

    // The type parameters impl IMP's methods see for receiver type SELF_TY, and their
    // arguments: the impl's own (`A` of `impl<A> Box2<A>`), bound by matching its target type
    // against SELF_TY; for an impl that declares none (`impl Vec<T>`), the type's own
    // parameters TY_PARAMS, bound to its arguments TY_ARGS. A parameter the target does not
    // reach is bound to no type (0).
    // The result holds the arguments it was given, or a fresh arena list: it never points into
    // MONOMORPHIZER's own storage, so a caller may keep it across further `&mut self` calls.
    #[borrows(imp, ty_params, ty_args)]
    fn impl_scope(
        self: &mut Monomorphizer,
        imp: &ImplDecl,
        self_ty: u32,
        ty_params: [TypeParam],
        ty_args: [u32]
    ) -> ImplScope {
        if imp.type_params.len == 0 as usize {
            return ImplScope { params: ty_params, args: ty_args };
        }
        let mut args = unsafe { Vec::<u32>.with_capacity_in_raw(self.arena, imp.type_params.len) };
        for tp in imp.type_params { args.push(0 as u32); }
        self.bind_impl_params(imp.target_ty, self_ty, imp.type_params, &mut args, 0 as usize);
        return ImplScope { params: imp.type_params, args: args.as_slice() };
    }

    // Binds each of PARAMS that AST type AST_TY names to the part of IL type IL_TY in its
    // place (`Outer<Box2<N>>` against `Outer<Box2<char>>` binds N to char), into ARGS.
    fn bind_impl_params(
        self: &mut Monomorphizer,
        ast_ty: TypeId,
        il_ty: u32,
        params: [TypeParam],
        args: &mut Vec<u32>,
        depth: usize
    ) {
        if ast_ty == 0 as TypeId || il_ty == 0 as u32 || depth > 16 as usize { return; }
        let il = self.module.types[il_ty as usize - 1 as usize].def;
        match self.resolver.ast.types[ast_ty as usize] {
            Type.Path(path) => {
                if path.1.len == 0 as usize {
                    for i in 0 as usize..params.len {
                        if params[i].name == path.0 && args.as_slice()[i] == 0 as u32 {
                            args.set(i, il_ty);
                        }
                    }
                    return;
                }
                if let ILType.User(u) = il {
                    for k in 0 as usize..path.1.len {
                        if k < u.type_args.len {
                            self.bind_impl_params(
                                path.1[k],
                                u.type_args[k],
                                params,
                                args,
                                depth + 1 as usize
                            );
                        }
                    }
                }
            },
            Type.Ref(inner) | Type.RefMut(inner) | Type.Ptr(inner) | Type.PtrMut(inner) => {
                match il {
                    // The raw pair binds like the reference pair: `Type.Ptr` above is `*T`, so a
                    // `RawPtr`/`RawPtrMut` here is the pointer this case is about. Leaving it out
                    // would skip binding `T` for a raw pointer argument, which is the wall probe
                    // 125 walked through.
                    ILType.Ptr(t)
                        | ILType.PtrMut(t)
                        | ILType.RawPtr(t)
                        | ILType.RawPtrMut(t) => {
                        self.bind_impl_params(inner, t, params, args, depth + 1 as usize);
                    },
                    _ => {},
                }
            },
            Type.Slice(inner) | Type.SliceMut(inner) => {
                if let ILType.Slice(s) = il {
                    self.bind_impl_params(inner, s.element, params, args, depth + 1 as usize);
                }
            },
            Type.Array(a) => {
                if let ILType.Array(arr) = il {
                    self.bind_impl_params(a.0, arr.element, params, args, depth + 1 as usize);
                }
            },
            Type.Tuple(elems) => {
                if let ILType.Tuple(il_elems) = il {
                    for k in 0 as usize..elems.len {
                        if k < il_elems.len {
                            self.bind_impl_params(
                                elems[k],
                                il_elems[k],
                                params,
                                args,
                                depth + 1 as usize
                            );
                        }
                    }
                }
            },
            Type.Fn(ft) => {
                if let ILType.Fn(f) = il {
                    for k in 0 as usize..ft.params.len {
                        if k < f.params.len {
                            self.bind_impl_params(
                                ft.params[k],
                                f.params[k],
                                params,
                                args,
                                depth + 1 as usize
                            );
                        }
                    }
                    self.bind_impl_params(ft.ret_ty, f.ret_ty, params, args, depth + 1 as usize);
                }
            },
            Type.Primitive(_) => {},
        }
    }

    // The type parameters of the struct or enum TY instantiates; none for any other type.
    // The type's own parameters and arguments point at the AST and the type table, which the
    // resolver's arena owns and which outlives every caller: neither is a view of this
    // monomorphizer's own storage.
    #[borrows()]
    fn instance_type_params(self: &mut Monomorphizer, ty: u32) -> [TypeParam] {
        let none = @slice(0 as *mut TypeParam, 0 as usize);
        let origin = match self.module.types[ty as usize - 1 as usize].def {
            ILType.User(u) => self.get_typedef_origin(u.id),
            _ => 0 as u32
        };
        if origin == 0 as u32 || origin as usize >= self.resolver.ast.decls.len() { return none; }
        return match self.resolver.ast.decls[origin as usize] {
            Decl.Struct(s) => s.type_params,
            Decl.Enum(e) => e.type_params,
            _ => none,
        };
    }

    // TY's type arguments (`[i32]` for `Vec<i32>`); none for a type that is no instance.
    #[borrows()]
    fn instance_type_args(self: &mut Monomorphizer, ty: u32) -> [u32] {
        return match self.module.types[ty as usize - 1 as usize].def {
            ILType.User(u) => u.type_args,
            _ => @slice(0 as *mut u32, 0 as usize)
        };
    }

    // AST type TY, written in method F of impl IMP, resolved as an instance of F for receiver
    // SELF_TY with its own type parameters bound to TYPE_ARGS (0 for one not known yet, which
    // then resolves to no type) sees it: the impl's parameters (or, for a trait's default
    // method, the trait's) and Self bound as instantiate_method binds them.
    pub fn resolve_method_type(
        self: &mut Monomorphizer,
        f: &FnDecl,
        imp: &ImplDecl,
        self_ty: u32,
        type_args: [u32],
        ty: TypeId
    ) -> u32 {
        let mut params = unsafe { Vec::<TypeParam>.new_in_raw(self.arena) };
        let mut args = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        let scope = self.impl_scope(
            imp,
            self_ty,
            self.instance_type_params(self_ty),
            self.instance_type_args(self_ty)
        );
        if f.default_of != 0 as u32 {
            let trait_id = self.resolver.trait_decl_named(imp.trait_name, imp.source_file);
            for tp in self.resolver.ast.decls[trait_id as usize].get_Trait().type_params {
                params.push(*tp);
            }
            let trait_args = self.resolve_in_impl(
                imp.trait_type_args,
                imp,
                scope.params,
                scope.args,
                self_ty
            );
            for a in trait_args { args.push(*a); }
        } else {
            for tp in scope.params { params.push(*tp); }
            for a in scope.args { args.push(*a); }
        }
        let saved_module = self.resolver.current_module;
        self.resolver.current_module = f.source_file;
        self.resolver.push_scope();
        self.bind_type_params(params.as_slice(), args.as_slice());
        self.resolver.define(self.intern_table.intern("Self"), SymbolKind.Type(self_ty), false);
        self.bind_type_params(f.type_params, type_args);
        let resolved = self.resolver.resolve_type(ty);
        self.resolver.pop_scope();
        self.resolver.current_module = saved_module;
        return resolved;
    }

    // TYS, written in impl IMP, resolved as its methods see them: in its module, with the
    // target type's parameters (PARAMS) bound to ARGS and `Self` to SELF_TY.
    // The result is `resolve_type_list`'s fresh arena list; nothing in it points into this
    // monomorphizer, so a caller may keep it across further `&mut self` calls.
    #[borrows()]
    fn resolve_in_impl(
        self: &mut Monomorphizer,
        tys: [TypeId],
        imp: &ImplDecl,
        params: [TypeParam],
        args: [u32],
        self_ty: u32
    ) -> [u32] {
        let saved = self.enter_impl(imp, params, args, self_ty);
        let resolved = self.resolver.resolve_type_list(tys);
        self.leave_impl(saved);
        return resolved;
    }

    // Enters the scope impl IMP's methods see (see resolve_in_impl); gives the module to
    // restore with leave_impl.
    fn enter_impl(
        self: &mut Monomorphizer,
        imp: &ImplDecl,
        params: [TypeParam],
        args: [u32],
        self_ty: u32
    ) -> u32 {
        let saved_module = self.resolver.current_module;
        self.resolver.current_module = imp.source_file;
        self.resolver.push_scope();
        self.bind_type_params(params, args);
        self.resolver.define(self.intern_table.intern("Self"), SymbolKind.Type(self_ty), false);
        return saved_module;
    }

    fn leave_impl(self: &mut Monomorphizer, saved_module: u32) {
        self.resolver.pop_scope();
        self.resolver.current_module = saved_module;
    }

    // The typedef of the struct or enum declaration DECL whose parameters are already bound, and
    // an empty struct for any other declaration. The fields are fresh arena data (see
    // struct_typedef), so the result is not tied to this monomorphizer.
    #[borrows()]
    fn typedef_of_decl(self: &mut Monomorphizer, decl: Decl) -> ILTypeDef {
        return match decl {
            Decl.Struct(s) => self.struct_typedef(&s),
            Decl.Enum(e) => self.enum_typedef(&e),
            _ => ILTypeDef.Struct(ILStruct {
                fields: @slice(0 as *mut ILField, 0 as usize),
                is_copy_opt_out: false,
            }),
        };
    }

    #[borrows()]
    fn generic_typedef_of_decl(
        self: &mut Monomorphizer,
        decl: Decl,
        type_args: [u32]
    ) -> ILTypeDef {
        return match decl {
            Decl.Struct(s) => {
                self.bind_type_params(s.type_params, type_args);
                self.struct_typedef(&s)
            },
            Decl.Enum(e) => {
                self.bind_type_params(e.type_params, type_args);
                self.enum_typedef(&e)
            },
            _ => {
                ICE("Monomorphizer.lower_generic_typedef: expected struct or enum");
                ILTypeDef.Struct(ILStruct {
                    fields: @slice(0 as *mut ILField, 0 as usize),
                    is_copy_opt_out: false,
                })
            },
        };
    }

    // The typedef of the non-generic struct or enum DECL_ID, which keeps the declaration's id.
    // 0 when DECL_ID is not a struct or enum: a generic instance's typedef id can equal some
    // other declaration's index, and that typedef is already built.
    pub fn lower_typedef(self: &mut Monomorphizer, decl_id: DeclId) -> u32 {
        let no_args = @slice(0 as *u32, 0 as usize);
        let existing = self.mono_typedefs.lookup(decl_id, no_args);
        if existing != 0xffffffff as u32 { return existing; }
        if decl_id as usize >= self.resolver.ast.decls.len() { return 0 as u32; }
        let saved_module = self.resolver.current_module;
        // A generic one used without type arguments (`Option.None` with nothing to infer
        // from) resolves its type parameters in whatever scope is current, as no module's own
        // code (an unbound one is no reported error).
        let decl = self.resolver.ast.decls[decl_id as usize];
        let generic = match decl {
            Decl.Struct(s) => s.type_params.len > 0 as usize,
            Decl.Enum(e) => e.type_params.len > 0 as usize,
            _ => false
        };
        self.resolver.current_module = if generic { 0 as u32 } else { decl.source_file() };
        let is_typedef_decl = match decl {
            Decl.Struct(_) => true,
            Decl.Enum(_) => true,
            _ => false,
        };
        if !is_typedef_decl { self.resolver.current_module = saved_module; return 0 as u32; }
        let def = self.typedef_of_decl(decl);
        self.resolver.current_module = saved_module;
        il_module_set_typedef(self.module, decl_id, def);
        self.mono_typedefs.insert(decl_id, no_args, decl_id);
        self.set_typedef_origin(decl_id, decl_id);
        return decl_id;
    }

    // The typedef of the generic struct or enum DECL_ID with TYPE_ARGS, its type parameters
    // bound in a scope of their own.
    pub fn lower_generic_typedef(
        self: &mut Monomorphizer,
        decl_id: DeclId,
        type_args: [u32]
    ) -> u32 {
        let existing = self.mono_typedefs.lookup(decl_id, type_args);
        if existing != 0xffffffff as u32 { return existing; }
        let decl = self.resolver.ast.decls[decl_id as usize];
        let saved_module = self.resolver.current_module;
        self.resolver.current_module = decl.source_file();
        self.resolver.push_scope();
        let def = self.generic_typedef_of_decl(decl, type_args);
        let typedef_id = self.module.alloc_typedef(def);
        self.resolver.pop_scope();
        self.resolver.current_module = saved_module;
        self.mono_typedefs.insert(decl_id, type_args, typedef_id);
        self.set_typedef_origin(typedef_id, decl_id);
        return typedef_id;
    }

    fn bind_type_params(self: &mut Monomorphizer, params: [TypeParam], args: [u32]) {
        for i in 0 as usize..params.len {
            if i < args.len {
                self.resolver.define(params[i].name, SymbolKind.Type(args[i]), false);
            }
        }
    }

    fn decl_is_copy_opt_out_struct(self: &mut Monomorphizer, s: &StructDecl) -> bool {
        let mut has_raw_ptr = false;
        for f in s.fields {
            if self.resolver.type_contains_raw_ptr(f.ty) {
                has_raw_ptr = true;
                break;
            }
        }
        if !has_raw_ptr { return false; }
        return !self.type_has_copy_impl(s.name);
    }

    fn decl_is_copy_opt_out_enum(self: &mut Monomorphizer, e: &EnumDecl) -> bool {
        let mut has_raw_ptr = false;
        for v in e.variants {
            if v.payload != 0 as u32 && self.resolver.type_contains_raw_ptr(v.payload) {
                has_raw_ptr = true;
                break;
            }
        }
        if !has_raw_ptr { return false; }
        return !self.type_has_copy_impl(e.name);
    }

    fn type_has_copy_impl(self: &Monomorphizer, type_name: u32) -> bool {
        let copy_name = self.intern_table.intern("Copy");
        let type_str = last_path_segment(self.intern_table.lookup(type_name));
        let ast: &AST = self.resolver.ast;
        for di in 0 as usize..ast.decls.len() {
            let imp = match ast.decls[di] {
                Decl.Impl(imp) => imp,
                _ => { continue; }
            };
            if imp.trait_name != 0 as u32
                && self.resolver.same_trait(imp.trait_name, imp.source_file, copy_name, 0 as u32) {
                let target_ty = imp.target_ty;
                if target_ty != 0 as u32 && (target_ty as usize) < ast.types.len() {
                    let p_ty = &ast.types[target_ty as usize];
                    if p_ty.get_tag() == TYPE_PATH {
                        let path = p_ty.get_Path();
                        let target_str = last_path_segment(self.intern_table.lookup(path.0));
                        if target_str == type_str {
                            return true;
                        }
                    }
                }
            }
        }
        return false;
    }

    // The fields are a fresh arena list, not a view of this monomorphizer: the typedef may be
    // held by a caller across further `&mut self` calls (lower_typedef installs it in the module).
    #[borrows()]
    fn struct_typedef(self: &mut Monomorphizer, s: &StructDecl) -> ILTypeDef {
        let is_copy_opt_out = self.decl_is_copy_opt_out_struct(s);
        let mut fields = unsafe { Vec::<ILField>.with_capacity_in_raw(self.arena, s.fields.len) };
        for f in s.fields {
            fields.push(ILField {
                name: f.name,
                ty: self.resolver.resolve_type(f.ty),
            });
        }
        return ILTypeDef.Struct(ILStruct {
            fields: fields.as_slice(),
            is_copy_opt_out: is_copy_opt_out,
        });
    }

    // Variants are numbered in order unless one gives its discriminant.
    #[borrows()]
    fn enum_typedef(self: &mut Monomorphizer, e: &EnumDecl) -> ILTypeDef {
        let is_copy_opt_out = self.decl_is_copy_opt_out_enum(e);
        let mut variants = unsafe {
            Vec::<ILVariant>.with_capacity_in_raw(self.arena, e.variants.len)
        };
        for k in 0 as usize..e.variants.len {
            let v = &e.variants[k];
            let disc = if v.has_discriminant { v.discriminant } else { k as u32 };
            variants.push(ILVariant {
                name: v.name,
                payload: self.resolver.resolve_type(v.payload),
                discriminant: disc
            });
        }
        return ILTypeDef.Enum(ILEnum {
            variants: variants.as_slice(),
            is_copy_opt_out: is_copy_opt_out,
        });
    }

    pub fn set_typedef_origin(self: &mut Monomorphizer, typedef_id: u32, decl_id: u32) {
        if typedef_id == 0 as u32 { return; }
        let idx = typedef_id as usize;
        self.typedef_to_decl.ensure_len(idx + 1 as usize);
        self.typedef_to_decl.set(idx, decl_id);
    }

    pub fn get_typedef_origin(self: &Monomorphizer, typedef_id: u32) -> u32 {
        if typedef_id == 0 as u32 { return 0 as u32; }
        match self.typedef_to_decl.get(typedef_id as usize) {
            Option.Some(p_origin) => {
                if *p_origin == 0 as u32 { return typedef_id; }
                return *p_origin;
            },
            Option.None => { return typedef_id; },
        }
    }

    // A type as the source spells it, for diagnostics: `&fd<w>`, `[u8]`, `(i32, bool)`,
    // `fn(i32) -> i32`, `Vec<u32>`, `*mut i32`. The IL keeps `&T` and `*T` distinct (Phase D), so a
    // pointer prints with the raw-ness it was declared with.
    pub fn type_display(self: &mut Monomorphizer, ty: u32) -> [u8] {
        let mut out = unsafe { ByteVec.new_raw(self.arena) };
        self.write_type_display(ty, out, 0 as usize);
        return out.as_slice();
    }

    fn write_type_display(self: &mut Monomorphizer, ty: u32, out: &mut ByteVec, depth: usize) {
        if ty == 0 as u32 || ty as usize > self.module.types.len() || depth > 8 as usize {
            out.push_slice("_");
            return;
        }
        let decl: ILTypeDecl = self.module.types[ty as usize - 1 as usize];
        match decl.def {
            ILType.Primitive(p) => {
                let t = p.get_tag();
                out.push_slice(
                    if t == ILPRIM_UNIT {
                        "()"
                    } else if t == ILPRIM_NEVER {
                        "!"
                    } else {
                        primitive_name(t)
                    }
                );
            },
            ILType.Ptr(inner) => {
                out.push_slice("&");
                self.write_type_display(inner, out, depth + 1 as usize);
            },
            ILType.PtrMut(inner) => {
                out.push_slice("&mut ");
                self.write_type_display(inner, out, depth + 1 as usize);
            },
            ILType.RawPtr(inner) => {
                // A C function pointer is written as its own type, not as a pointer to a signature.
                let is_c_fn = inner != 0 as u32
                    && match self.module.types[inner as usize - 1 as usize].def {
                        ILType.Fn(f) => f.c_abi,
                        _ => false,
                    };
                if !is_c_fn { out.push_slice("*"); }
                self.write_type_display(inner, out, depth + 1 as usize);
            },
            ILType.RawPtrMut(inner) => {
                out.push_slice("*mut ");
                self.write_type_display(inner, out, depth + 1 as usize);
            },
            ILType.Boxed(inner) => {
                out.push_slice("Box<");
                self.write_type_display(inner, out, depth + 1 as usize);
                out.push_slice(">");
            },
            ILType.BoxedMut(inner) => {
                out.push_slice("Box<");
                self.write_type_display(inner, out, depth + 1 as usize);
                out.push_slice(">");
            },
            ILType.Slice(sl) => {
                out.push_slice(if sl.mutable { "[mut " } else { "[" });
                self.write_type_display(sl.element, out, depth + 1 as usize);
                out.push_slice("]");
            },
            ILType.Array(ar) => {
                out.push_slice("[");
                self.write_type_display(ar.element, out, depth + 1 as usize);
                out.push_slice("; ");
                push_decimal(out, ar.size as u64);
                out.push_slice("]");
            },
            ILType.Fn(f) => {
                if f.c_abi { out.push_slice("extern \"C\" "); }
                out.push_slice("fn(");
                for i in 0 as usize..f.params.len {
                    if i > 0 as usize { out.push_slice(", "); }
                    self.write_type_display(f.params[i], out, depth + 1 as usize);
                }
                out.push_slice(")");
                if f.ret_ty != 0 as u32 {
                    out.push_slice(" -> ");
                    self.write_type_display(f.ret_ty, out, depth + 1 as usize);
                }
            },
            ILType.Tuple(elems) => {
                out.push_slice("(");
                for i in 0 as usize..elems.len {
                    if i > 0 as usize { out.push_slice(", "); }
                    self.write_type_display(elems[i], out, depth + 1 as usize);
                }
                out.push_slice(")");
            },
            ILType.FD(cap) => {
                let c = cap.get_tag();
                if c == 0 as u32 {
                    out.push_slice("fd<r>");
                } else if c == 1 as u32 {
                    out.push_slice("fd<w>");
                } else {
                    out.push_slice("fd<rw>");
                }
            },
            ILType.IORing => { out.push_slice("ioring"); },
            ILType.User(u) => {
                let mut name_buf = unsafe { ByteVec.new_raw(self.arena) };
                if decl.name != 0 as u32 {
                    name_buf.push_slice(self.intern_table.lookup(decl.name));
                } else if u.name != 0 as u32 {
                    name_buf.push_slice(self.intern_table.lookup(u.name));
                } else {
                    name_buf.push_slice("_");
                }
                let mut name = name_buf.as_slice();
                if u.type_args.len > 0 as usize {
                    // An instantiation is named `Base_T<mangled args>`: strip exactly that
                    // suffix to recover `Base`, then spell the arguments.
                    let mut suffix = unsafe { ByteVec.new_raw(self.arena) };
                    self.push_type_args(suffix, u.type_args);
                    let sfx = suffix.as_slice();
                    if name.len > sfx.len && subslice_from(name, name.len - sfx.len) == sfx {
                        name = subslice(name, 0 as usize, name.len - sfx.len);
                    }
                }
                out.push_slice(name);
                if u.type_args.len > 0 as usize {
                    out.push_slice("<");
                    for i in 0 as usize..u.type_args.len {
                        if i > 0 as usize { out.push_slice(", "); }
                        self.write_type_display(u.type_args[i], out, depth + 1 as usize);
                    }
                    out.push_slice(">");
                }
            },
            ILType.Var(v) => { out.push_slice(self.intern_table.lookup(v.name)); },
        }
    }

    // TY_ID's encoding in an instance name. Prefix-free, so a list of them reads back one way
    // (`(u8, u8, u8)` and `(u8, u8), u8` differ): primitives by their lowercase names; a named
    // type as `N<len><name>`; `P`/`Q` pointer and mutable pointer, `B`/`C` boxes, `S`/`M` slices,
    // `A<n>_` an array of n, `T<n>_` a tuple of n, `F<n>_` a function of n parameters (return
    // type first), `D<cap>` a file descriptor, `R` an io ring, `V<len><name>` a type variable,
    // `Z` no type.
    fn get_type_mangled_name_to(self: &mut Monomorphizer, ty_id: u32, buf: &mut ByteVec) {
        if ty_id == 0 as u32 { buf.push_slice("Z"); return; }
        let p_ty: ILTypeDecl = self.module.types[ty_id as usize - 1 as usize];
        if p_ty.name != 0 as u32 {
            push_counted_name(buf, self.intern_table.lookup(p_ty.name));
            return;
        }
        match p_ty.def {
            ILType.Primitive(p) => { buf.push_slice(primitive_name(p.get_tag())); },
            ILType.Ptr(inner) => {
                buf.push_slice("P");
                self.get_type_mangled_name_to(inner, buf);
            },
            ILType.PtrMut(inner) => {
                buf.push_slice("Q");
                self.get_type_mangled_name_to(inner, buf);
            },
            // `W`/`X` for the raw pair. They must *not* share `P`/`Q` with the references: the
            // mangled name is what monomorphization keys on, and a raw pointer and a reference that
            // come out of `id(p)` under one name is exactly the laundering route of probe 125.
            ILType.RawPtr(inner) => {
                buf.push_slice("W");
                self.get_type_mangled_name_to(inner, buf);
            },
            ILType.RawPtrMut(inner) => {
                buf.push_slice("X");
                self.get_type_mangled_name_to(inner, buf);
            },
            ILType.Boxed(inner) => {
                buf.push_slice("B");
                self.get_type_mangled_name_to(inner, buf);
            },
            ILType.BoxedMut(inner) => {
                buf.push_slice("C");
                self.get_type_mangled_name_to(inner, buf);
            },
            ILType.Slice(sl) => {
                buf.push_slice(if sl.mutable { "M" } else { "S" });
                self.get_type_mangled_name_to(sl.element, buf);
            },
            ILType.Array(a) => {
                buf.push_slice("A");
                push_decimal(buf, a.size as u64);
                buf.push_slice("_");
                self.get_type_mangled_name_to(a.element, buf);
            },
            ILType.Tuple(types) => {
                buf.push_slice("T");
                push_decimal(buf, types.len as u64);
                buf.push_slice("_");
                for t in types { self.get_type_mangled_name_to(*t, buf); }
            },
            ILType.Fn(f) => {
                buf.push_slice("F");
                push_decimal(buf, f.params.len as u64);
                buf.push_slice("_");
                self.get_type_mangled_name_to(f.ret_ty, buf);
                for t in f.params { self.get_type_mangled_name_to(*t, buf); }
            },
            ILType.User(u) => {
                let mut inner = unsafe { ByteVec.new_raw(self.arena) };
                inner.push_slice(self.intern_table.lookup(u.name));
                self.push_type_args(inner, u.type_args);
                push_counted_name(buf, inner.as_slice());
            },
            ILType.FD(cap) => { buf.push_slice("D"); push_decimal(buf, cap.get_tag() as u64); },
            ILType.IORing => { buf.push_slice("R"); },
            ILType.Var(v) => {
                buf.push_slice("V");
                push_counted_name(
                    buf,
                    if v.name != 0 as u32 { self.intern_table.lookup(v.name) } else { "" }
                );
            },
        }
    }

    // `_T` and the arguments' encodings, after a name; nothing when there are none.
    fn push_type_args(self: &mut Monomorphizer, buf: &mut ByteVec, type_args: [u32]) {
        if type_args.len == 0 as usize { return; }
        buf.push_slice("_T");
        for t in type_args { self.get_type_mangled_name_to(*t, buf); }
    }

    // The interned name of BASE instantiated with TYPE_ARGS (`Vec_Tu8`); BASE itself without
    // arguments.
    fn instance_name(self: &mut Monomorphizer, base: [u8], type_args: [u32]) -> u32 {
        let mut buf = unsafe { ByteVec.new_raw(self.arena) };
        buf.push_slice(base);
        self.push_type_args(buf, type_args);
        return self.intern_table.intern(buf.as_slice());
    }

    fn mangle_name(self: &mut Monomorphizer, name_id: u32, type_args: [u32]) -> u32 {
        if type_args.len == 0 as usize { return name_id; }
        return self.instance_name(self.intern_table.lookup(name_id), type_args);
    }

    // Records closure NAME's inferred parameter types (0 where written) and result.
    pub fn set_closure_sig(self: &mut Monomorphizer, name: u32, params: [u32], ret: u32) {
        self.closure_sigs.push(ClosureSig { name: name, params: params, ret: ret });
    }

    // The inferred type of parameter I of closure NAME; 0 when it is written or NAME is no
    // closure.
    pub fn closure_param_ty(self: &Monomorphizer, name: u32, i: usize) -> u32 {
        for s in self.closure_sigs.as_slice() {
            if s.name == name && i < s.params.len { return s.params[i]; }
        }
        return 0 as u32;
    }

    // The inferred result type of closure NAME; 0 when none (unit) or NAME is no closure, and
    // INFER_RESULT while its body decides it.
    pub fn closure_ret_ty(self: &Monomorphizer, name: u32) -> u32 {
        for s in self.closure_sigs.as_slice() {
            if s.name == name { return s.ret; }
        }
        return 0 as u32;
    }

    pub fn register_zir_closure_env(self: &mut Monomorphizer, func_idx: u32, env_local_id: u32) {
        self.cap_func_idxs.push(func_idx);
        self.cap_env_local_ids.push(env_local_id);
    }

    pub fn lookup_zir_closure_env(self: &Monomorphizer, func_idx: u32) -> u32 {
        for i in 0 as usize..self.cap_func_idxs.len() {
            if self.cap_func_idxs[i] == func_idx { return self.cap_env_local_ids[i]; }
        }
        return 0 as u32;
    }
}

fn push_decimal(out: &mut ByteVec, v: u64) {
    if v >= 10 as u64 { push_decimal(out, v / 10 as u64); }
    out.push(('0' as u64 + v % 10 as u64) as u8);
}

// `<len><name>`: a name whose end a reader can find.
fn push_counted_name(buf: &mut ByteVec, name: [u8]) {
    buf.push_slice("N");
    push_decimal(buf, name.len as u64);
    buf.push_slice(name);
}

// A primitive type's name, by its ILPRIM_* tag.
pub fn primitive_name(tag: u32) -> [u8] {
    let names = [
        "u8",
        "u16",
        "u32",
        "u64",
        "usize",
        "i8",
        "i16",
        "i32",
        "i64",
        "isize",
        "f32",
        "f64",
        "bool",
        "char",
        "unit",
        "never"
    ];
    if tag as usize >= names.len { return "unknown_prim"; }
    return names[tag as usize];
}

// Instances by (declaration, type arguments): a hash index (entry index + 1, 0 when empty,
// probed linearly) over the entries, growing with them.
pub struct MonoRegistry {
    pub entries: Vec<MonoEntry>,
    pub buckets: Vec<u32>,
    pub arena: *mut ArenaHeader,
}

pub struct MonoEntry {
    pub decl_id: u32,
    pub args: [u32],
    pub value: u32,
}

impl MonoRegistry {
    pub fn new(arena: *mut ArenaHeader) -> MonoRegistry {
        return MonoRegistry {
            entries: unsafe { Vec::<MonoEntry>.new_in_raw(arena) },
            buckets: unsafe { Vec::<u32>.new_in_raw(arena) },
            arena: arena
        };
    }

    // The value recorded for DECL_ID with ARGS, or 0xffffffff.
    pub fn lookup(self: &MonoRegistry, decl_id: u32, args: [u32]) -> u32 {
        let cap = self.buckets.len();
        if cap == 0 as usize { return 0xffffffff as u32; }
        let mut b = mono_key_hash(decl_id, args) % cap;
        loop {
            let slot = self.buckets.as_slice()[b];
            if slot == 0 as u32 { return 0xffffffff as u32; }
            let e = &self.entries.as_slice()[slot as usize - 1 as usize];
            if e.decl_id == decl_id && e.args == args { return e.value; }
            b = (b + 1 as usize) % cap;
        }
    }

    pub fn insert(self: &mut MonoRegistry, decl_id: u32, args: [u32], value: u32) {
        // ARGS may be a caller's temporary: the entry keeps its own copy.
        let mut owned = unsafe { Vec::<u32>.with_capacity_in_raw(self.arena, args.len) };
        for a in args { owned.push(*a); }
        self.entries.push(MonoEntry { decl_id: decl_id, args: owned.as_slice(), value: value });
        if self.entries.len() * 2 > self.buckets.len() {
            self.rehash(
                if self.buckets.len() == 0 as usize {
                    64 as usize
                } else {
                    self.buckets.len() * 2 as usize
                }
            );
        } else {
            self.index(self.entries.len() - 1 as usize);
        }
    }

    fn rehash(self: &mut MonoRegistry, cap: usize) {
        self.buckets = unsafe { Vec::<u32>.with_capacity_in_raw(self.arena, cap) };
        for _b in 0 as usize..cap { self.buckets.push(0 as u32); }
        for i in 0 as usize..self.entries.len() { self.index(i); }
    }

    fn index(self: &mut MonoRegistry, i: usize) {
        let cap = self.buckets.len();
        let e = &self.entries.as_slice()[i];
        let mut b = mono_key_hash(e.decl_id, e.args) % cap;
        while self.buckets.as_slice()[b] != 0 as u32 { b = (b + 1 as usize) % cap; }
        self.buckets.set(b, (i + 1 as usize) as u32);
    }
}

fn mono_key_hash(decl_id: u32, args: [u32]) -> usize {
    let mut h = decl_id as u64 *% 0x9e3779b97f4a7c15 as u64;
    for a in args { h = (h ^ *a as u64) *% 0x100000001b3 as u64; }
    return (h >> 16) as usize;
}

// Resolver.instantiate: instantiates DECL_ID with the N type arguments at ARGS in the
// Monomorphizer CTX.
pub fn mono_instantiate_type(ctx: *mut u8, decl_id: u32, args: *u32, n: usize) -> u32 {
    return unsafe { (*(ctx as *mut Monomorphizer)).instantiate_type(decl_id, @slice(args, n)) };
}

// Monomorphizer.project_assoc_type for the Resolver (set_assoc_projector), CTX being the
// Monomorphizer.
pub fn mono_project_assoc_type(ctx: *mut u8, ty: u32, name: u32, site: u32, module: u32) -> u32 {
    return unsafe { (*(ctx as *mut Monomorphizer)).project_assoc_type(ty, name, site, module) };
}

fn no_lowerer(
    ctx: *mut u8,
    f: *FnDecl,
    name: u32,
    params: *TypeParam,
    n_params: usize,
    args: *u32,
    n_args: usize,
    self_name: u32,
    self_ty: u32,
    is_closure: bool
) -> u32 {
    ICE("Monomorphizer: a function instance before set_lowerer");
}
