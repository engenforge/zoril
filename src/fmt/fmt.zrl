// `zoril fmt`: formats source files in place (or, with --check, lists the ones that are not
// formatted). A file is parsed alone, as written (its imports are not read), printed by the
// printer, and the result checked before it is written: it must lex to the same tokens,
// spelled the same, and keep every comment, in order. A file that does not parse, or whose
// result fails the check, is reported and left as it is.

import "core.zrl";
import "mem_raw.zrl";
import "io.zrl";
import "os/linux.zrl" as os_linux;
import "vec.zrl";
import "intern.zrl";
import "ast.zrl";
import "lexer.zrl";
import "parser.zrl";
import "parser/base.zrl";
import "module_path.zrl";
import "sys.zrl";
import "trivia.zrl";
import "printer.zrl";
import "file.zrl";
import "diag.zrl";
use ast::{AST, Span};
use file::read_file_raw;
use base::{LoadState, Parser};
use diag::diag_start;
use intern::InternTable;
use io::{close, eprint, print, read, stderr, write_all};
use os_linux::open;
use lexer::Lexer;
use mem_raw::{ArenaHeader, zoril_allocator_alloc};
use module_path::{ModuleResolution, module_resolution_new};
use printer::Printer;
use sys::arg_to_slice;
use trivia::{FComment, FTok, Trivia, scan};
use vec::Vec;

// `zoril fmt [--check] FILE..`; ARGV[1] is `fmt`. 0 when every file is (now) formatted.
#[stores(arena -> arena, table -> arena)]
pub fn fmt_main(argc: i32, argv: **u8, table: &mut InternTable, arena: *mut ArenaHeader) -> i32 {
    let mut check = false;
    let mut end_of_options = false;
    let mut files = unsafe { Vec::<[u8]>.new_in_raw(arena) };
    for i in 2 as i32..argc {
        let arg = unsafe { arg_to_slice(argv, i) };
        if !end_of_options && arg == "--" {
            end_of_options = true;
        } else if !end_of_options && arg == "--check" {
            check = true;
        } else if !end_of_options && arg.len > 0 as usize && arg[0] == '-' as u8 {
            eprint("zoril: error: unknown fmt option ");
            eprint(arg);
            eprint("\n");
            return 2;
        } else {
            files.push(arg);
        }
    }
    if files.len() == 0 as usize {
        eprint("Usage: zoril fmt [--check] <file.zrl>...\n");
        return 2;
    }
    let mut status = 0;
    for path in files.as_slice() {
        let source_opt = fmt_read_file(*path, arena);
        let source = match source_opt {
            Option.Some(s) => s,
            Option.None => {
                eprint("zoril: error: cannot read ");
                eprint(*path);
                eprint("\n");
                status = 1;
                continue;
            },
        };
        let out_opt = format_source(*path, source, table, arena);
        let out = match out_opt {
            Option.Some(o) => o,
            Option.None => {
                status = 1;
                continue;
            },
        };
        if out == source { continue; }
        if check {
            print(*path);
            print("\n");
            status = 1;
        } else if !fmt_write_file(*path, out, arena) {
            eprint("zoril: error: cannot write ");
            eprint(*path);
            eprint("\n");
            status = 1;
        }
    }
    return status;
}

// SOURCE (the file PATH) formatted; None, with the reason reported, when it cannot be.
#[stores(arena -> arena, path -> arena, table -> arena)]
pub fn format_source(
    path: [u8],
    source: [u8],
    table: &mut InternTable,
    arena: *mut ArenaHeader
) -> Option<[u8]> {
    if source.len == 0 as usize { return Option.Some(""); }
    let trivia = scan(source, table, arena);
    if !trivia.ok {
        return fmt_error(path, source, 0 as u32, "the file has a token the lexer rejects");
    }
    let ast = parse_alone(path, source, table, arena);
    if ast as usize == 0 as usize { return Option.None; }
    let mut p = Printer.new(
        unsafe { &*ast },
        source,
        trivia.toks.as_slice(),
        trivia.comments.as_slice(),
        table,
        arena
    );
    p.file();
    if p.failed {
        return fmt_error(
            path,
            source,
            p.fail_offset,
            "internal: the syntax tree and the tokens disagree here; the file is left as it is"
        );
    }
    let out = p.doc.render(arena);
    let again = scan(out, table, arena);
    let bad = first_difference(source, &trivia, out, &again);
    if bad != 0xffffffff as u32 {
        return fmt_error(
            path,
            source,
            bad,
            "internal: formatting would change the tokens or comments here; the file is left as it is"
        );
    }
    return Option.Some(out);
}

// PATH parsed on its own (imports not loaded); null after a syntax error, reported.
fn parse_alone(
    path: [u8],
    source: [u8],
    table: &mut InternTable,
    arena: *mut ArenaHeader
) -> *mut AST {
    let ast = AST.new(arena);
    let lexer = Lexer.new(source, table, arena);
    let no_includes = unsafe { Vec::<u32>.new_in_raw(arena) };
    let mr = unsafe {
        zoril_allocator_alloc(arena, sizeof(ModuleResolution))
    } as *mut ModuleResolution;
    unsafe {
        *mr = module_resolution_new(path, "", &no_includes, table as *mut InternTable, arena);
    }
    // `ast` is fresh arena storage (AST.new), the parser its only user while it parses.
    let parser = Parser.new_modular(
        lexer,
        unsafe { &mut *ast },
        table,
        path,
        path,
        0 as *mut u32,
        0 as usize,
        0 as *mut LoadState,
        mr,
        false
    );
    unsafe {
        (*(*parser).state).fmt_only = true;
        (*parser).parse_module();
        if (*parser).had_error { return 0 as *mut AST; }
    }
    return ast;
}

// Where the formatted OUT first differs from SOURCE in a token or a comment (an offset into
// SOURCE); 0xffffffff when it keeps them all.
fn first_difference(source: [u8], a: &Trivia, out: [u8], b: &Trivia) -> u32 {
    let n = if a.toks.len() < b.toks.len() { a.toks.len() } else { b.toks.len() };
    for i in 0 as usize..n {
        let x = a.toks.as_slice()[i];
        let y = b.toks.as_slice()[i];
        if x.kind != y.kind || text_of(source, x.start, x.end) != text_of(out, y.start, y.end) {
            return x.start;
        }
    }
    if a.toks.len() != b.toks.len() {
        return if n < a.toks.len() { a.toks.as_slice()[n].start } else { source.len as u32 };
    }
    let m = if a.comments.len() < b.comments.len() { a.comments.len() } else { b.comments.len() };
    for i in 0 as usize..m {
        let x = a.comments.as_slice()[i];
        let y = b.comments.as_slice()[i];
        if trimmed(text_of(source, x.start, x.end)) != trimmed(text_of(out, y.start, y.end)) {
            return x.start;
        }
    }
    if a.comments.len() != b.comments.len() {
        return if m < a.comments.len() {
            a.comments.as_slice()[m].start
        } else {
            source.len as u32
        };
    }
    return 0xffffffff as u32;
}

fn text_of(s: [u8], start: u32, end: u32) -> [u8] {
    return subslice(s, start as usize, (end - start) as usize);
}

fn trimmed(s: [u8]) -> [u8] {
    let mut end = s.len;
    while end > 0 as usize
        && (s[end - 1 as usize] == ' ' as u8
            || s[end - 1 as usize] == '\t' as u8
            || s[end - 1 as usize] == '\r' as u8) {
        end = end - 1 as usize;
    }
    return subslice(s, 0 as usize, end);
}

// `PATH:LINE:COL: error: MESSAGE`, OFFSET into SOURCE; returns Option.None.
fn fmt_error(path: [u8], source: [u8], offset: u32, message: [u8]) -> Option<[u8]> {
    let mut line = 1 as u64;
    let mut col = 1 as u64;
    for i in 0 as usize..(offset as usize) {
        if i >= source.len { break; }
        if source[i] == '\n' as u8 {
            line = line + 1 as u64;
            col = 1 as u64;
        } else {
            col = col + 1 as u64;
        }
    }
    diag_start(
        path,
        Span { start: offset, end: offset, line: line as u32, col: col as u32 },
        "error"
    );
    eprint(message);
    eprint("\n");
    return Option.None;
}

fn fmt_tmp_path(path: [u8], arena: *mut ArenaHeader) -> [u8] {
    let suffix = ".fmt_tmp";
    let len = path.len + suffix.len;
    let p = unsafe { zoril_allocator_alloc(arena, (len + 1 as usize) as u64) } as *mut u8;
    let mut s = unsafe { @slice(p, len + 1 as usize) };
    let mut i = 0 as usize;
    while i < path.len {
        s[i] = path[i];
        i = i + 1 as usize;
    }
    let mut j = 0 as usize;
    while j < suffix.len {
        s[i + j] = suffix[j];
        j = j + 1 as usize;
    }
    s[len] = 0 as u8;
    return unsafe { @slice(p, len) };
}

fn fmt_cstr(s: [u8], arena: *mut ArenaHeader) -> [u8] {
    let p = unsafe { zoril_allocator_alloc(arena, (s.len + 1 as usize) as u64) } as *mut u8;
    let mut dst = unsafe { @slice(p, s.len + 1 as usize) };
    let mut i = 0 as usize;
    while i < s.len {
        dst[i] = s[i];
        i = i + 1 as usize;
    }
    dst[s.len] = 0 as u8;
    return dst;
}

fn fmt_read_file(path: [u8], arena: *mut ArenaHeader) -> Option<[u8]> {
    return match unsafe { read_file_raw(path, arena) } {
        Ok(s) => Option.Some(s),
        Err(_) => Option.None,
    };
}

fn fmt_write_file(path: [u8], text: [u8], arena: *mut ArenaHeader) -> bool {
    let path_c = fmt_cstr(path, arena);
    let statbuf = unsafe { @alloca<[u64; 18]>(1) };
    let mut mode = 0o644 as u32; // default 0o644
    let is_link = if unsafe { @syscall(6, path_c.ptr as u64, statbuf as u64) } as i64 == 0 as i64 {
        let raw_mode = (*statbuf)[3] as u32;
        (raw_mode & 0o170000 as u32) == 0o120000 as u32
    } else {
        false
    };
    if unsafe { @syscall(4, path_c.ptr as u64, statbuf as u64) } as i64 == 0 as i64 {
        let file_mode = ((*statbuf)[3] as u32) & 0o777 as u32;
        if file_mode != 0 as u32 { mode = file_mode; }
    }
    if is_link {
        // A symlink is written through to its target so the symlink is kept.
        let fd_res = open(path, 577, mode as u64);
        let fd = match fd_res {
            Result.Ok(f) => f,
            Result.Err(_) => return false,
        };
        let mut out = fd;
        let write_ok = match write_all(&mut out, text) {
            Result.Ok(_) => true,
            Result.Err(_) => false,
        };
        let close_ok = match close(fd) {
            Result.Ok(_) => true,
            Result.Err(_) => false,
        };
        return write_ok && close_ok;
    }
    let tmp = fmt_tmp_path(path, arena);
    let fd_res = open(tmp, 577, mode as u64);
    let fd = match fd_res {
        Result.Ok(f) => f,
        Result.Err(_) => return false,
    };
    let fchmod_ret = unsafe { @syscall(91, fd.unix_raw() as u64, mode as u64) } as i64;
    let mut out = fd;
    let write_ok = match write_all(&mut out, text) {
        Result.Ok(_) => true,
        Result.Err(_) => false,
    };
    let close_ok = match close(fd) {
        Result.Ok(_) => true,
        Result.Err(_) => false,
    };
    if fchmod_ret < 0 as i64 || !write_ok || !close_ok {
        unsafe { @syscall(87, tmp.ptr as u64) };
        return false;
    }
    let ok = unsafe { @syscall(82, tmp.ptr as u64, path_c.ptr as u64) } as i64 == 0 as i64;
    if !ok {
        unsafe { @syscall(87, tmp.ptr as u64) };
        return false;
    }
    return true;
}
