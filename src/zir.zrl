pub enum ZirStmt {
    Let(u32, ZirRvalue, Span),       // LocalId, Rvalue, Span
    Assign(Place, ZirRvalue, Span),  // Place, Rvalue, Span
    Drop(Place, Span),               // Place to drop, Span
    Intrinsic(u32, [Place], Span),   // name ID, args, Span
    EndBorrow(u32, Span),            // LocalId, Span
    // Scope-exit drop guarded by a runtime drop flag (lower_zir emits it inside `if flag { ... }`).
    // Statically the value may already be moved or dropped on some paths; the checker treats it as
    // "drop if still owned" instead of reporting a double drop.
    DropIfLive(Place, Span),
}

impl ZirStmt {
    pub fn get_Let_id(self: &ZirStmt) -> u32 {
        return match self {
            ZirStmt.Let(x, _, _) => *x,
            _ => ICE("ZirStmt.get_Let_id on another variant")
        };
    }
    pub fn get_Let_rv(self: &ZirStmt) -> &ZirRvalue {
        return match self {
            ZirStmt.Let(_, x, _) => x,
            _ => ICE("ZirStmt.get_Let_rv on another variant")
        };
    }
    pub fn get_Assign_pl(self: &ZirStmt) -> &Place {
        return match self {
            ZirStmt.Assign(x, _, _) => x,
            _ => ICE("ZirStmt.get_Assign_pl on another variant")
        };
    }
    pub fn get_Assign_rv(self: &ZirStmt) -> &ZirRvalue {
        return match self {
            ZirStmt.Assign(_, x, _) => x,
            _ => ICE("ZirStmt.get_Assign_rv on another variant")
        };
    }
    pub fn get_Drop_pl(self: &ZirStmt) -> &Place {
        return match self {
            ZirStmt.Drop(x, _) | ZirStmt.DropIfLive(x, _) => x,
            _ => ICE("ZirStmt.get_Drop_pl on another variant")
        };
    }
    pub fn get_Intrinsic_id(self: &ZirStmt) -> u32 {
        return match self {
            ZirStmt.Intrinsic(x, _, _) => *x,
            _ => ICE("ZirStmt.get_Intrinsic_id on another variant")
        };
    }
    pub fn get_Intrinsic_args(self: &ZirStmt) -> [Place] {
        return match self {
            ZirStmt.Intrinsic(_, x, _) => *x,
            _ => ICE("ZirStmt.get_Intrinsic_args on another variant")
        };
    }
    pub fn get_EndBorrow_id(self: &ZirStmt) -> u32 {
        return match self {
            ZirStmt.EndBorrow(x, _) => *x,
            _ => ICE("ZirStmt.get_EndBorrow_id on another variant")
        };
    }

    pub fn get_span(self: &ZirStmt) -> Span {
        match *self {
            ZirStmt.Let(a, b, span) => { return span; },
            ZirStmt.Assign(a, b, span) => { return span; },
            ZirStmt.Drop(a, span) => { return span; },
            ZirStmt.DropIfLive(a, span) => { return span; },
            ZirStmt.Intrinsic(a, b, span) => { return span; },
            ZirStmt.EndBorrow(a, span) => { return span; },
        }
    }
}

pub struct ZirBlock {
    pub id: u32,
    pub statements: [ZirStmt],
    pub literal_comments: [u32], // parallel to statements: literal source comment in effect when each was emitted, 0 if none
    pub terminator: ZirTerminator,
    pub name_hint: u32, // Interned label hint based on the construct that created this block (0 if none)
}

pub enum ZirTerminator {
    Jmp(u32),
    Branch(Place, u32, u32), // cond, then, else
    Ret(Place),
    Unreachable,
}

impl ZirTerminator {
    pub fn get_Jmp(self: &ZirTerminator) -> u32 {
        return match self {
            ZirTerminator.Jmp(x) => *x,
            _ => ICE("ZirTerminator.get_Jmp on another variant")
        };
    }
    pub fn get_Branch_cond(self: &ZirTerminator) -> &Place {
        return match self {
            ZirTerminator.Branch(x, _, _) => x,
            _ => ICE("ZirTerminator.get_Branch_cond on another variant")
        };
    }
    pub fn get_Branch_then(self: &ZirTerminator) -> u32 {
        return match self {
            ZirTerminator.Branch(_, x, _) => *x,
            _ => ICE("ZirTerminator.get_Branch_then on another variant")
        };
    }
    pub fn get_Branch_else(self: &ZirTerminator) -> u32 {
        return match self {
            ZirTerminator.Branch(_, _, x) => *x,
            _ => ICE("ZirTerminator.get_Branch_else on another variant")
        };
    }
    pub fn get_Ret(self: &ZirTerminator) -> &Place {
        return match self {
            ZirTerminator.Ret(x) => x,
            _ => ICE("ZirTerminator.get_Ret on another variant")
        };
    }
}

pub struct ZirFunction {
    pub name: u32,
    pub params: [Local],
    pub locals: [Local],
    pub blocks: [ZirBlock],
    pub ret_ty: u32,
    pub doc_comment: u32,
    pub span: Span,
}

pub struct ZirModule {
    pub funcs: [ZirFunction],
}
