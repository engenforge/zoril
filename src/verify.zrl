import "il_typecheck.zrl";
import "diag.zrl";
import "il_type.zrl";
import "il_instr.zrl";
import "il_cfg.zrl";
import "ast.zrl";
import "mem_raw.zrl";
import "io.zrl";
import "vec.zrl";
import "bytevec.zrl";
import "intern.zrl";
import "progress.zrl";
use ast::Span;
use bytevec::ByteVec;
use diag::diag_start;
use il_cfg::{ILFunction, ILModule, NO_DROP_FN};
use il_instr::{AllocInstr, CALL_BY_NAME, CallInstr, CallPtrInstr, CastInstr, ConstInstr, FieldAddrInstr, ILInstr, NO_SSA, SSAId, StoreInstr};
use il_type::{ILTYPE_ARRAY, ILTYPE_BOXED, ILTYPE_BOXEDMUT, ILTYPE_FN, ILTYPE_PRIMITIVE, ILTYPE_PTR, ILTYPE_PTRMUT, ILTYPE_SLICE, ILTYPE_TUPLE, ILTYPE_USER, Region, is_any_pointer_tag, is_mut_pointer_tag, is_reference_tag};
use il_typecheck::type_check_function;
use intern::InternTable;
use io::eprint;
use mem_raw::{ArenaHeader, memcpy, memset, zoril_allocator_alloc};
use progress::progress_name;
use vec::Vec;

pub enum OwnerState {
    Uninit,
    Owned,
    Moved,
    Dropped,
}

pub struct OwnerMap {
    pub states: *mut u32, // Index is ssa ID
    pub count: usize,
    pub cap: usize,
}

impl OwnerMap {
    pub fn new(arena: *mut ArenaHeader) -> OwnerMap {
        let initial_cap = 8192 as usize;
        let states = unsafe { zoril_allocator_alloc(arena, initial_cap * 4 as usize) } as *mut u32;
        unsafe {
            memset(states as *mut u8, 0, (initial_cap * 4 as usize) as u64);
        }                                                                           // Uninit = 0
        return OwnerMap {
            states: states,
            count: 0 as usize,
            cap: initial_cap,
        };
    }

    pub fn set_state(self: &mut OwnerMap, ssa: u32, state: OwnerState, arena: *mut ArenaHeader) {
        let idx = ssa as usize;
        if idx >= self.cap {
            let old_cap = self.cap;
            let mut new_cap = old_cap * 2 as usize;
            while idx >= new_cap { new_cap = new_cap * 2 as usize; }
            let new_states = unsafe {
                zoril_allocator_alloc(arena, new_cap * 4 as usize)
            } as *mut u32;
            unsafe {
                memset(new_states as *mut u8, 0, (new_cap * 4 as usize) as u64);
                memcpy(new_states as *mut u8, self.states as *u8, (old_cap * 4 as usize) as u64);
            }
            self.states = new_states;
            self.cap = new_cap;
        }
        let mut states = unsafe { @slice(self.states, self.cap) };
        match state {
            OwnerState.Uninit => { states[idx] = 0 as u32; },
            OwnerState.Owned => { states[idx] = 1 as u32; },
            OwnerState.Moved => { states[idx] = 2 as u32; },
            OwnerState.Dropped => { states[idx] = 3 as u32; },
        }
        if idx >= self.count { self.count = idx + 1 as usize; }
    }

    pub fn get_state(self: &OwnerMap, ssa: u32) -> OwnerState {
        let idx = ssa as usize;
        if idx >= self.cap { return OwnerState.Uninit; }
        let states = unsafe { @slice(self.states, self.cap) };
        let val = states[idx];
        if val == 0 as u32 { return OwnerState.Uninit; }
        if val == 1 as u32 { return OwnerState.Owned; }
        if val == 2 as u32 { return OwnerState.Moved; }
        return OwnerState.Dropped;
    }
}

pub const ARENA_UNKNOWN: u32 = 0;
pub const ARENA_INITIALIZED: u32 = 1;
pub const ARENA_CLOSED: u32 = 2;

pub struct ArenaInfo {
    pub state: u32,
    pub remaining: usize,
}

// What a function's body does with the storage of its parameters (see storage_facts).
// storage_facts' per-SSA relations (see there), as parameter bit masks: an address's storage
// (MASK), what it reaches (REACH), and the contents of memory it points at when that is not one
// of this frame's slots (CMASK); the same three for what each local slot holds; the slot an
// address points into (SLOT_OF, 0 for none) and whether it is the result slot (TO_RESULT).
struct StorageFlow {
    mask: [mut u64],
    reach: [mut u64],
    cmask: [mut u64],
    slot_mask: [mut u64],
    slot_reach: [mut u64],
    slot_cmask: [mut u64],
    slot_of: [mut u32],
    to_result: [mut bool],
}

pub struct StorageFacts {
    pub ret: u64,
    pub stored: u64,
    pub targets: u64,
}

// store_targets bit for a global, or memory of unknown origin.
pub const STORE_INTO_GLOBAL: u32 = 63;
pub const STORE_GLOBAL_BIT: u64 = 0x8000000000000000;

pub struct Verifier {
    pub arena: *mut ArenaHeader,
    pub module: &mut ILModule,
    pub intern_table: &mut InternTable,
    pub file_path: [u8],
    pub current_func: *mut ILFunction,
    // Function index + 1 by interned name (0: none), built once by index_functions.
    pub fn_by_name: [mut u32],
    // Names looked up on every call, interned once.
    pub sret_name: u32,
    pub env_name: u32,
    pub memcpy_name: u32,
    // Scratch for storage_facts, sized to the largest function and reused: eight per-SSA arrays.
    pub sf_words: [mut u64],
    pub sf_slot_of: [mut u32],
    pub sf_to_result: [mut bool],
    pub uses: [mut u32],
    pub arena_info: [mut ArenaInfo],
    pub current_map: OwnerMap,
    pub had_error: bool,
    pub const_values: [mut u64],
    pub const_flags: [mut bool],
    pub borrowed_from: [mut u32],
    pub borrow_is_mut: [mut bool],
    // True for an SSA that IS a stack slot in this frame -- an Alloc with no
    // allocator. Distinct from is_alloc_result (any Alloc) and from
    // points_to_stack. Used by the Ret outlives check.
    pub is_stack_slot: [mut bool],
    // True for a pointer that points INTO this frame's stack storage. Distinct
    // from borrowed_from, which a Load also sets (:678) and therefore conflates
    // "points into that storage" with "was read out of that storage". Outlives
    // needs the former only: `let p = mmap_or_trap(...); return p;` reads a pointer
    // out of a stack slot but does not point at it.
    pub points_to_stack: [mut bool],
    // The value, or the memory a stack slot names, contains a pointer to this frame's
    // stack: set by storing one into a slot (or a field or element of it), carried by
    // move and memcpy. Copying it into memory that outlives the frame is an escape.
    pub holds_stack_ptr: [mut bool],
    // The 'local slot an address is derived from (field, element, offset, move,
    // cast), or 0. Unlike borrowed_from, stores never change it.
    pub stack_base: [mut u32],
    pub is_alloc_result: [mut bool],
    pub remaining_uses: [mut u32],
    pub ssa_spans: [mut Span],
    pub current_ssa: u32,
}

impl Verifier {
    pub fn new(
        arena: *mut ArenaHeader,
        module: &mut ILModule,
        table: &mut InternTable,
        file_path: [u8]
    ) -> Verifier {
        return Verifier {
            arena: arena,
            module: module,
            intern_table: table,
            file_path: file_path,
            current_func: 0 as *mut ILFunction,
            fn_by_name: @slice(0 as *mut u32, 0 as usize),
            sret_name: 0 as u32,
            env_name: 0 as u32,
            memcpy_name: 0 as u32,
            sf_words: @slice(0 as *mut u64, 0 as usize),
            sf_slot_of: @slice(0 as *mut u32, 0 as usize),
            sf_to_result: @slice(0 as *mut bool, 0 as usize),
            uses: @slice(0 as *mut u32, 0 as usize),
            arena_info: @slice(0 as *mut ArenaInfo, 0 as usize),
            current_map: OwnerMap.new(arena),
            had_error: false,
            const_values: @slice(0 as *mut u64, 0 as usize),
            const_flags: @slice(0 as *mut bool, 0 as usize),
            borrowed_from: @slice(0 as *mut u32, 0 as usize),
            borrow_is_mut: @slice(0 as *mut bool, 0 as usize),
            is_stack_slot: @slice(0 as *mut bool, 0 as usize),
            points_to_stack: @slice(0 as *mut bool, 0 as usize),
            holds_stack_ptr: @slice(0 as *mut bool, 0 as usize),
            stack_base: @slice(0 as *mut u32, 0 as usize),
            is_alloc_result: @slice(0 as *mut bool, 0 as usize),
            remaining_uses: @slice(0 as *mut u32, 0 as usize),
            ssa_spans: @slice(0 as *mut Span, 0 as usize),
            current_ssa: 0 as u32,
        };
    }

    fn has_result(self: &Verifier, ssa: SSAId) -> bool {
        return ssa != 0 as u32 && ssa != NO_SSA;
    }

    fn has_suffix(self: &Verifier, s: [u8], suffix: [u8]) -> bool {
        if s.len < suffix.len { return false; }
        let mut i = 0 as usize;
        let start = s.len - suffix.len;
        while i < suffix.len {
            if s[start + i] != suffix[i] { return false; }
            i = i + 1 as usize;
        }
        return true;
    }

    fn has_drop_impl(self: &mut Verifier, type_id: u32) -> bool {
        return self.module.drop_fn_index(self.intern_table, type_id) != NO_DROP_FN;
    }

    fn is_state_owned(self: &Verifier, state: OwnerState) -> bool {
        match state {
            OwnerState.Owned => { return true; },
            OwnerState.Uninit | OwnerState.Moved | OwnerState.Dropped => { return false; },
        }
    }

    fn get_ultimate_base(self: &Verifier, ssa: SSAId) -> SSAId {
        let mut curr = ssa;
        let mut depth = 0 as usize;
        while curr != 0 as u32 && curr as usize < self.uses.len && depth < 100 as usize {
            let p_base = self.borrowed_from[curr as usize];
            if p_base == 0 as u32 { break; }
            curr = p_base;
            depth = depth + 1 as usize;
        }
        return curr;
    }

    // `#[borrows(..)]` is a claim the compiler mostly cannot check (that is why it exists), but it
    // can catch the visible lie: a result that points into the storage of a parameter the attribute
    // leaves out (`&a.v` under `#[borrows(b)]`). Addresses are followed through field, offset, cast
    // and move, and through the stack slot each parameter is first stored in; a pointer *loaded*
    // through a parameter is not its address (it is the arena/buffer case the attribute is for).
    fn check_borrows_claim(self: &mut Verifier, func: &ILFunction) {
        self.storage_facts(func, true);
    }
    // `#[stores(p -> q)]` is checked against the body's computed masks: a declared source the body
    // never stores, or a declared target that receives nothing, is an error in its own module. A
    // `pub fn` that stores a reference parameter without declaring it warns, naming the attribute
    // to add - a contract callers cannot see is what the declaration is for.
    fn check_stores_claims(self: &mut Verifier) {
        let saved_file_path = self.file_path;
        let mut warned_spans = unsafe { Vec::<Span>.new_in_raw(self.arena) };
        let mut i = 0 as usize;
        while i < self.module.functions.len() {
            let p_f = (&self.module.functions[i]) as *ILFunction;
            let declared = unsafe { (*p_f).has_stores_declared };
            let has_body = unsafe { (*p_f).blocks_len } > 0 as usize;
            if !has_body {
                i = i + 1 as usize;
                continue;
            }
            let sf = unsafe { (*p_f).source_file };
            if sf != 0 as u32 { self.file_path = self.intern_table.lookup(sf); }
            let stored = unsafe { (*p_f).stores_storage };
            let targets = unsafe { (*p_f).store_targets };
            let span = unsafe { (*p_f).decl_span };
            if declared && unsafe { (*p_f).is_generic } {
                // A generic body stores according to its instantiation; the claim is a promise.
                i = i + 1 as usize;
                continue;
            }
            if declared {
                let from = unsafe { (*p_f).stores_declared_from };
                let to = unsafe { (*p_f).stores_declared_to };
                if (from & !stored) != 0 as u64 {
                    self.report_error("#[stores] names a parameter this body does not store", span);
                } else if (to & !targets) != 0 as u64 {
                    self.report_error(
                        "#[stores] names a target this body does not store into",
                        span
                    );
                } else if (stored & !from) != 0 as u64 {
                    let hidden = self.hidden_param_count(unsafe { &*p_f });
                    let mut u = 0 as usize;
                    while u < 63 as usize {
                        if (((stored & !from) >> (u as u64)) & 1 as u64) != 0 as u64
                            && (u + hidden) < unsafe { (*p_f).params_len } {
                            let name = unsafe { (*p_f).param(u + hidden).name };
                            let mut msg = unsafe { ByteVec.new_raw(self.arena) };
                            msg.push_slice("this function stores the parameter '");
                            msg.push_slice(self.intern_table.lookup(name));
                            msg.push_slice("' where #[stores] does not declare it; add `#[stores(");
                            msg.push_slice(self.intern_table.lookup(name));
                            let tname = self.first_store_target(unsafe { &*p_f }, hidden);
                            if tname == 0 as u32 {
                                msg.push_slice(" -> static)]`");
                            } else {
                                msg.push_slice(" -> ");
                                msg.push_slice(self.intern_table.lookup(tname));
                                msg.push_slice(")]`");
                            }
                            self.report_error(msg.as_slice(), span);
                            break;
                        }
                        u = u + 1 as usize;
                    }
                } else if (targets & !to) != 0 as u64 {
                    let hidden = self.hidden_param_count(unsafe { &*p_f });
                    let mut v = 0 as usize;
                    while v < 64 as usize {
                        if (((targets & !to) >> (v as u64)) & 1 as u64) != 0 as u64 {
                            let mut msg = unsafe { ByteVec.new_raw(self.arena) };
                            if v == 63 as usize {
                                msg.push_slice(
                                    "this function stores into static memory where #[stores] does not declare it; add `-> static` to `#[stores]`"
                                );
                            } else if (v + hidden) < unsafe { (*p_f).params_len } {
                                let tname = unsafe { (*p_f).param(v + hidden).name };
                                msg.push_slice("this function stores into the target '");
                                msg.push_slice(self.intern_table.lookup(tname));
                                msg.push_slice("' where #[stores] does not declare it; add `-> ");
                                msg.push_slice(self.intern_table.lookup(tname));
                                msg.push_slice("` to `#[stores]`");
                            }
                            self.report_error(msg.as_slice(), span);
                            break;
                        }
                        v = v + 1 as usize;
                    }
                }
            } else if unsafe { (*p_f).is_pub }
                && !unsafe { (*p_f).from_interface }
                && stored != 0 as u64 {
                let mut span_seen = false;
                let mut si = 0 as usize;
                while si < warned_spans.len() {
                    let s = &warned_spans[si];
                    if s.line == span.line
                        && s.col == span.col
                        && s.start == span.start
                        && s.end == span.end {
                        span_seen = true;
                        break;
                    }
                    si = si + 1 as usize;
                }
                if !span_seen {
                    warned_spans.push(span);
                    self.warn_undeclared_stores(unsafe { &*p_f }, stored, span);
                }
            }
            i = i + 1 as usize;
        }
        self.file_path = saved_file_path;
    }

    // A parameter name to suggest as the target: the first parameter bit in the body's targets,
    // or 0 when only a global does (the caller then writes `-> static`).
    fn first_store_target(self: &mut Verifier, p_f: &ILFunction, hidden: usize) -> u32 {
        let targets = p_f.store_targets;
        let mut v = 0 as usize;
        while v < 63 as usize {
            if ((targets >> (v as u64)) & 1 as u64) != 0 as u64 && (v + hidden) < p_f.params_len {
                return p_f.param(v + hidden).name;
            }
            v = v + 1 as usize;
        }
        return 0 as u32;
    }

    fn warn_undeclared_stores(self: &mut Verifier, p_f: &ILFunction, stored: u64, span: Span) {
        let hidden = self.hidden_param_count(p_f);
        let mut u = 0 as usize;
        while u < 63 as usize {
            if ((stored >> (u as u64)) & 1 as u64) != 0 as u64 && (u + hidden) < p_f.params_len {
                let name = p_f.param(u + hidden).name;
                let mut msg = unsafe { ByteVec::new_raw(self.arena) };
                msg.push_slice("this `pub fn` stores the reference parameter '");
                msg.push_slice(self.intern_table.lookup(name));
                msg.push_slice("' where its signature does not declare it; add `#[stores(");
                msg.push_slice(self.intern_table.lookup(name));
                let tname = self.first_store_target(p_f, hidden);
                if tname == 0 as u32 {
                    msg.push_slice(" -> static)]`");
                } else {
                    msg.push_slice(" -> ");
                    msg.push_slice(self.intern_table.lookup(tname));
                    msg.push_slice(")]`");
                }
                self.report_warning(msg.as_slice(), span);
                return;
            }
            u = u + 1 as usize;
        }
    }

    // For every function with a body: which parameters' own storage its result may point
    // into (`ret_storage`), and which it writes into memory outside its frame
    // (`stores_storage` / `store_targets`). Iterated so a wrapper inherits what it calls.
    // The module's functions by name, so a call resolves without scanning them all.
    fn index_functions(self: &mut Verifier) {
        self.sret_name = self.intern_table.intern("__sret");
        self.env_name = self.intern_table.intern("__env");
        self.memcpy_name = self.intern_table.intern("memcpy");
        let mut max_name = 0 as u32;
        let mut max_ssa = 0 as usize;
        let mut i = 0 as usize;
        while i < self.module.functions.len() {
            if self.module.functions[i].name > max_name {
                max_name = self.module.functions[i].name;
            }
            if self.module.functions[i].result_types_len > max_ssa {
                max_ssa = self.module.functions[i].result_types_len;
            }
            i = i + 1 as usize;
        }
        unsafe {
            self.sf_words = @slice(
                zoril_allocator_alloc(self.arena, (max_ssa * 8 * 8) as u64) as *mut u64,
                max_ssa * 8
            );
            self.sf_slot_of = @slice(
                zoril_allocator_alloc(self.arena, (max_ssa * 4) as u64) as *mut u32,
                max_ssa
            );
            self.sf_to_result = @slice(
                zoril_allocator_alloc(self.arena, max_ssa as u64) as *mut bool,
                max_ssa
            );
        }
        let n = max_name as usize + 1 as usize;
        self.fn_by_name = unsafe {
            @slice(zoril_allocator_alloc(self.arena, (n * 4) as u64) as *mut u32, n)
        };
        unsafe { memset(self.fn_by_name.ptr as *mut u8, 0, (n * 4) as u64); }
        i = self.module.functions.len();
        while i > 0 as usize {
            // Walked backwards so the first function of a name wins, as in find_function_by_name.
            i = i - 1 as usize;
            self.fn_by_name[self.module.functions[i].name as usize] = (i + 1 as usize) as u32;
        }
    }

    // The function call C calls: by index when it has one, else by name.
    fn callee_of(self: &Verifier, c: &CallInstr) -> *mut ILFunction {
        if c.func_idx != CALL_BY_NAME && (c.func_idx as usize) < self.module.functions.len() {
            return &self.module.functions[c.func_idx as usize];
        }
        return self.function_named(c.name_id);
    }

    fn function_named(self: &Verifier, name_id: u32) -> *mut ILFunction {
        if (name_id as usize) < self.fn_by_name.len {
            let k = self.fn_by_name[name_id as usize];
            if k == 0 as u32 { return 0 as *mut ILFunction; }
            return &self.module.functions[k as usize - 1 as usize];
        }
        return self.module.find_function_by_name(name_id);
    }

    // For every function with a body: which parameters' own storage its result may point
    // into (`ret_storage`), and which it writes outside its frame (`stores_storage` /
    // `store_targets`). A fixpoint over the call graph: every body starts at "nothing" (started
    // from the signature's conservative answer, recursive functions would keep each other's bits
    // alive), and after a first pass, callees first, a function is analyzed again only when a
    // callee's facts changed since. The masks only grow, over finitely many bits, so this ends.
    pub fn compute_ret_storage(self: &mut Verifier) {
        self.index_functions();
        let nf = self.module.functions.len();
        if nf == 0 as usize { return; }
        let mut z = 0 as usize;
        while z < nf {
            let p_z = &mut self.module.functions[z];
            if p_z.blocks_len > 0 as usize {
                p_z.ret_storage = 0 as u64;
                p_z.stores_storage = 0 as u64;
                p_z.store_targets = 0 as u64;
                // The fixpoint below computes them from this body, so they are known - the one
                // state in which `0` means "nothing escapes" rather than "no information".
                p_z.storage_known = true;
            }
            z = z + 1 as usize;
        }
        let callees = self.callee_lists();
        let changed_at = unsafe {
            @slice(zoril_allocator_alloc(self.arena, (nf * 4) as u64) as *mut u32, nf)
        };
        let analyzed_at = unsafe {
            @slice(zoril_allocator_alloc(self.arena, (nf * 4) as u64) as *mut u32, nf)
        };
        unsafe {
            memset(changed_at.ptr as *mut u8, 0, (nf * 4) as u64);
            memset(analyzed_at.ptr as *mut u8, 0, (nf * 4) as u64);
        }
        let mut epoch = 1 as u32;
        let mut first = true;
        let mut any = true;
        while any {
            any = false;
            let mut i = nf;
            while i > 0 as usize {
                i = i - 1 as usize;
                // A raw pointer, not `&mut self.module.functions[i]`: the borrow checker has a
                // whole-`self` model, so holding a field borrow across `storage_facts` (a
                // `&mut self` call) is a conflict it cannot split. The function itself is not
                // moved or reallocated while its facts are computed.
                let p_func = (&mut self.module.functions[i]) as *mut ILFunction;
                unsafe {
                    if (*p_func).blocks_len == 0 as usize { continue; }
                }
                let mut stale = first;
                let mut k = callees.0[i] as usize;
                while !stale && k < callees.0[i + 1 as usize] as usize {
                    if changed_at[callees.1[k] as usize] > analyzed_at[i] { stale = true; }
                    k = k + 1 as usize;
                }
                if !stale { continue; }
                epoch = epoch + 1 as u32;
                analyzed_at[i] = epoch;
                let facts = self.storage_facts(unsafe { &*p_func }, false);
                unsafe {
                    if facts.ret != (*p_func).ret_storage
                        || facts.stored != (*p_func).stores_storage
                        || facts.targets != (*p_func).store_targets {
                        (*p_func).ret_storage = facts.ret;
                        (*p_func).stores_storage = facts.stored;
                        (*p_func).store_targets = facts.targets;
                        epoch = epoch + 1 as u32;
                        changed_at[i] = epoch;
                        any = true;
                    }
                }
            }
            first = false;
        }
    }

    // Each function's direct callees, as (start offsets with one extra end entry, callee indices).
    // Arena mirrors of the call graph, not views of the verifier.
    #[borrows()]
    fn callee_lists(self: &mut Verifier) -> ([mut u32], [u32]) {
        let nf = self.module.functions.len();
        let starts = unsafe {
            @slice(
                zoril_allocator_alloc(self.arena, ((nf + 1 as usize) * 4) as u64) as *mut u32,
                nf + 1 as usize
            )
        };
        let mut ids = unsafe { Vec::<u32>.new_in_raw(self.arena) };
        let mut i = 0 as usize;
        while i < nf {
            starts[i] = ids.len() as u32;
            let func = &self.module.functions[i];
            let mut bi = 0 as usize;
            while bi < func.blocks_len {
                let p_block = &self.module.blocks[func.block_ids()[bi] as usize];
                let mut j = 0 as usize;
                while j < p_block.instructions_len {
                    let p_instr = &self.module.instrs[p_block.instr_ids()[j] as usize];
                    match *p_instr {
                        ILInstr.Call(c) => {
                            let p_callee = self.callee_of(&c);
                            if p_callee as usize != 0 as usize {
                                ids.push(unsafe { (*p_callee).id });
                            }
                        },
                        _ => {},
                    }
                    j = j + 1 as usize;
                }
                bi = bi + 1 as usize;
            }
            i = i + 1 as usize;
        }
        starts[nf] = ids.len() as u32;
        return (starts, ids.as_slice());
    }

    // Two relations per address value, as parameter bit masks (hidden sret/env parameters not
    // counted): storage - it points into what the parameter points at, derived by field/index
    // steps with no load through it (`&self.v`, not `self.data`); reach - it points into memory
    // reachable from the parameter, loads included. A store of a storage-carrying value is a write
    // of the caller's argument's address: to the result slot it is returned, to a local slot it
    // stays in the frame, anywhere else (memory the parameters reach, a global) it is stored away.
    // With REPORT, a `#[borrows(..)]` result pointing into an unlisted parameter is an error.
    // exhaustive: every IL instruction must say which storage relation (mask, reach, slot,
    // result) it propagates; a new instruction cannot silently carry an untracked pointer.
    fn storage_facts(self: &mut Verifier, func: &ILFunction, report: bool) -> StorageFacts {
        let n = func.result_types_len;
        let mut facts = StorageFacts { ret: 0 as u64, stored: 0 as u64, targets: 0 as u64 };
        if n == 0 as usize { return facts; }
        if n > self.sf_slot_of.len { self.index_functions(); }
        let w = self.sf_words.ptr as *mut u64;
        let mut fl = StorageFlow {
            mask: unsafe { @slice(w, n) },
            reach: unsafe { @slice((w as usize + n * 8) as *mut u64, n) },
            slot_mask: unsafe { @slice((w as usize + n * 16) as *mut u64, n) },
            slot_reach: unsafe { @slice((w as usize + n * 24) as *mut u64, n) },
            cmask: unsafe { @slice((w as usize + n * 32) as *mut u64, n) },
            slot_cmask: unsafe { @slice((w as usize + n * 40) as *mut u64, n) },
            slot_of: unsafe { @slice(self.sf_slot_of.ptr as *mut u32, n) },
            to_result: unsafe { @slice(self.sf_to_result.ptr as *mut bool, n) },
        };
        unsafe {
            memset(w as *mut u8, 0, (n * 48) as u64);
            memset(fl.slot_of.ptr as *mut u8, 0, (n * 4) as u64);
            memset(fl.to_result.ptr as *mut u8, 0, n as u64);
        }
        let hidden = self.hidden_param_count(func);
        // Two passes, so a slot stored in a later block is seen by a load in an earlier one.
        for pass in 0 as usize..2 as usize {
            for bi in 0 as usize..func.blocks_len {
                let p_block = self.module.blocks[func.block_ids()[bi] as usize];
                for j in 0 as usize..p_block.instructions_len {
                    let id = p_block.instr_ids()[j] as usize;
                    let ssa = p_block.ssa_result_ids()[j];
                    let ok = ssa != 0 as u32 && (ssa as usize) < n;
                    let mut from = 0 as u32;
                    match self.module.instrs[id] {
                        ILInstr.Param(pi) => {
                            if ok { self.storage_param(func, pi as usize, hidden, ssa, &mut fl); }
                        },
                        ILInstr.Alloc(a) => {
                            if ok
                                && a.allocator == 0xffffffff as u32
                                && is_local_region(&a.region) {
                                fl.slot_of[ssa as usize] = ssa;
                            }
                        },
                        ILInstr.GlobalAddr(_) => {
                            if ok { fl.reach[ssa as usize] = STORE_GLOBAL_BIT; }
                        },
                        ILInstr.FieldAddr(fa) => { from = fa.val; },
                        ILInstr.Add(op) => { from = op.lhs; },
                        ILInstr.Cast(c) => { from = c.val; },
                        ILInstr.Move(src) => { from = src; },
                        ILInstr.RegionCast(rc) => { from = rc.val; },
                        ILInstr.Borrow(b) => { from = b.val; },
                        ILInstr.SliceConstruct(sc) => { from = sc.ptr; },
                        ILInstr.Phi(phi) => {
                            for pr in phi.preds {
                                if ok && (pr.val as usize) < n {
                                    fl.mask[ssa as usize] = fl.mask[ssa as usize]
                                        | fl.mask[pr.val as usize];
                                    fl.reach[ssa as usize] = fl.reach[ssa as usize]
                                        | fl.reach[pr.val as usize];
                                }
                            }
                        },
                        ILInstr.Store(st) => {
                            if (st.ptr as usize) < n && (st.val as usize) < n {
                                let slot = fl.slot_of[st.ptr as usize];
                                if slot != 0 as u32 {
                                    fl.slot_cmask[slot as usize] = fl.slot_cmask[slot as usize]
                                        | fl.cmask[st.val as usize];
                                }
                                self.note_storage_write(
                                    st.ptr,
                                    fl.mask[st.val as usize],
                                    fl.reach[st.val as usize],
                                    &mut fl,
                                    &mut facts
                                );
                            }
                        },
                        ILInstr.Load(src) => {
                            if ok && (src as usize) < n {
                                self.storage_load(func, src, ssa, &mut fl);
                            }
                        },
                        // A call through a value has no summary: read it as the worst case
                        // (the result may point into any argument's own storage), not as
                        // "nothing escapes".
                        ILInstr.CallPtr(c) => {
                            self.storage_unknown_call(c.args, ssa, ok, &mut fl, &mut facts);
                        },
                        ILInstr.Call(c) => { self.storage_call(&c, ssa, ok, &mut fl, &mut facts); },
                        ILInstr.Ret(res) => {
                            if res != 0 as u32 && (res as usize) < n {
                                facts.ret = facts.ret | fl.mask[res as usize];
                                if report
                                    && pass == 1 as usize
                                    && (fl.mask[res as usize] & !func.ret_ties) != 0 as u64 {
                                    self.report_error(
                                        "#[borrows(..)] does not list a parameter this function returns a pointer into",
                                        self.module.instr_spans[id]
                                    );
                                }
                            }
                        },
                        // No storage relation to carry. Every variant is named (rather than
                        // a `_` arm) so a new instruction must decide; `// exhaustive:` above
                        // states the rule.
                        ILInstr.Sub(_)
                            | ILInstr.Mul(_)
                            | ILInstr.Div(_)
                            | ILInstr.Rem(_)
                            | ILInstr.And(_)
                            | ILInstr.Or(_)
                            | ILInstr.Xor(_)
                            | ILInstr.Shl(_)
                            | ILInstr.Shr(_)
                            | ILInstr.CmpLt(_)
                            | ILInstr.CmpLe(_)
                            | ILInstr.CmpGt(_)
                            | ILInstr.CmpGe(_)
                            | ILInstr.CmpEq(_)
                            | ILInstr.CmpNe(_)
                            | ILInstr.WrappingAdd(_)
                            | ILInstr.WrappingSub(_)
                            | ILInstr.WrappingMul(_)
                            | ILInstr.SaturatingAdd(_)
                            | ILInstr.CheckedAdd(_)
                            | ILInstr.CheckedSub(_)
                            | ILInstr.CheckedMul(_)
                            | ILInstr.Drop(_)
                            | ILInstr.BoundsCheck(_)
                            | ILInstr.SliceLoad(_)
                            | ILInstr.SliceStore(_)
                            | ILInstr.SliceLen(_)
                            | ILInstr.ArrayConstruct(_)
                            | ILInstr.ArrayLoad(_)
                            | ILInstr.ArrayStore(_)
                            | ILInstr.IsSome(_)
                            | ILInstr.Unwrap(_)
                            | ILInstr.Branch(_)
                            | ILInstr.Jmp(_)
                            | ILInstr.VariantMatch(_)
                            | ILInstr.SumConstruct(_)
                            | ILInstr.Syscall(_)
                            | ILInstr.Const(_)
                            | ILInstr.StringConst(_)
                            | ILInstr.FuncAddr(_)
                            | ILInstr.FDOpen(_)
                            | ILInstr.FDClose(_)
                            | ILInstr.FDRead(_)
                            | ILInstr.FDWrite(_)
                            | ILInstr.IORingSetup(_)
                            | ILInstr.IORingEnter(_)
                            | ILInstr.IORingClose(_)
                            | ILInstr.EndBorrow(_)
                            | ILInstr.Release(_)
                            | ILInstr.Neg(_)
                            | ILInstr.Not(_)
                            | ILInstr.StructConstruct(_)
                            | ILInstr.TupleConstruct(_)
                            | ILInstr.GetEnv
                            | ILInstr.Likely(_)
                            | ILInstr.Unlikely(_)
                            | ILInstr.Unreachable => {},
                    }
                    if ok && from != 0 as u32 && (from as usize) < n {
                        fl.mask[ssa as usize] = fl.mask[ssa as usize] | fl.mask[from as usize];
                        fl.cmask[ssa as usize] = fl.cmask[ssa as usize] | fl.cmask[from as usize];
                        fl.reach[ssa as usize] = fl.reach[ssa as usize] | fl.reach[from as usize];
                        fl.slot_of[ssa as usize] = fl.slot_of[from as usize];
                        fl.to_result[ssa as usize] = fl.to_result[from as usize];
                    }
                    // An integer computed from an address (a length, a hash, a type id) is
                    // not one: only values that can hold an address carry the relations, and
                    // an integer only by address arithmetic (`(p as usize + off) as *T`),
                    // never by being loaded or returned.
                    if ok && !self.can_hold_address(func.get_ssa_type(ssa), from != 0 as u32) {
                        fl.mask[ssa as usize] = 0 as u64;
                        fl.reach[ssa as usize] = 0 as u64;
                    }
                }
            }
        }
        return facts;
    }

    // Parameter PI, the value SSA: a slice parameter's header holds the caller's slice
    // (`s.ptr`, `&s[0]`, `return s`), so its bit is in the contents (cmask), not the storage.
    fn storage_param(
        self: &mut Verifier,
        func: &ILFunction,
        pi: usize,
        hidden: usize,
        ssa: SSAId,
        fl: &mut StorageFlow
    ) {
        if pi >= hidden && pi - hidden < STORE_INTO_GLOBAL as usize {
            let bit = (1 as u64) << ((pi - hidden) as u64);
            fl.reach[ssa as usize] = bit;
            let pty = func.param(pi).ty;
            if self.is_slice_like(pty) {
                fl.cmask[ssa as usize] = bit;
            } else {
                fl.mask[ssa as usize] = bit;
            }
        }
        if pi < func.params_len && func.param(pi).name == self.sret_name {
            fl.to_result[ssa as usize] = true;
        }
    }

    // A call: memcpy writes its source's relations through its destination; any other callee
    // contributes through its summary (what it returns and stores of its arguments).
    fn storage_call(
        self: &mut Verifier,
        c: &CallInstr,
        ssa: SSAId,
        ok: bool,
        fl: &mut StorageFlow,
        facts: &mut StorageFacts
    ) {
        let n = fl.mask.len;
        if c.name_id == self.memcpy_name && c.args.len >= 2 as usize {
            let dst = c.args[0];
            let src = c.args[1];
            if (dst as usize) < n && (src as usize) < n {
                let slot = fl.slot_of[src as usize];
                let m = if slot != 0 as u32 {
                    fl.slot_mask[slot as usize]
                } else {
                    fl.cmask[src as usize]
                };
                let r = if slot != 0 as u32 {
                    fl.slot_reach[slot as usize]
                } else {
                    fl.reach[src as usize]
                };
                self.note_storage_write(dst, m, r, fl, facts);
            }
            return;
        }
        let p_callee = self.callee_of(c);
        let mut arg_reach = 0 as u64;
        for a in c.args {
            if (*a as usize) < n { arg_reach = arg_reach | fl.reach[*a as usize]; }
        }
        let mut r = 0 as u64;
        if p_callee != 0 as *mut ILFunction {
            r = self.call_storage_mask(p_callee, c.args, unsafe { (*p_callee).ret_storage }, fl);
            // The callee stores our parameters' storage into the memory of its own: a write
            // of ours to what we passed there.
            let stored = self.call_storage_mask(
                p_callee,
                c.args,
                unsafe { (*p_callee).stores_storage },
                fl
            );
            if stored != 0 as u64 { self.note_callee_stores(p_callee, c.args, stored, fl, facts); }
        }
        if p_callee != 0 as *mut ILFunction
            && self.has_sret_param(p_callee)
            && c.args.len > 0 as usize {
            let a0 = c.args[0];
            if (a0 as usize) < n && fl.slot_of[a0 as usize] != 0 as u32 {
                let slot = fl.slot_of[a0 as usize];
                fl.slot_mask[slot as usize] = fl.slot_mask[slot as usize] | r;
                fl.slot_reach[slot as usize] = fl.slot_reach[slot as usize] | arg_reach;
            } else if (a0 as usize) < n && fl.to_result[a0 as usize] {
                facts.ret = facts.ret | r;
            }
        } else if ok {
            fl.mask[ssa as usize] = fl.mask[ssa as usize] | r;
            fl.reach[ssa as usize] = fl.reach[ssa as usize] | arg_reach;
        }
    }

    // A call whose summary cannot be read - a call through a value, or a direct call whose callee
    // did not resolve - is read the way the borrow checker reads `ZirRvalue.CallPtr`: the result
    // may point into any argument's own storage. An empty answer here would mean "decided: nothing
    // escapes", the fail-open reading a missing summary must not produce.
    //
    // The store half of the same unknown is `summary_pass`'s: it evaluates every address-taken
    // function whose signature matches an indirect call and reports a stash, and obtaining a
    // function address from outside the module needs `unsafe`. Marking every argument as
    // stored-into-global here instead rejected legitimate callback code in `tools/zilc`.
    fn storage_unknown_call(
        self: &mut Verifier,
        args: [SSAId],
        ssa: SSAId,
        ok: bool,
        fl: &mut StorageFlow,
        facts: &mut StorageFacts
    ) {
        let n = fl.mask.len;
        let mut own = 0 as u64;
        let mut reach = 0 as u64;
        for a in args {
            if (*a as usize) < n {
                own = own | fl.mask[*a as usize];
                reach = reach | fl.reach[*a as usize];
            }
        }
        if ok {
            fl.mask[ssa as usize] = fl.mask[ssa as usize] | own;
            fl.reach[ssa as usize] = fl.reach[ssa as usize] | reach;
        }
    }

    // A callee stores STORED (our parameters' storage) into the memory of the parameters its
    // store_targets name, or into a global.
    fn note_callee_stores(
        self: &mut Verifier,
        p_callee: *mut ILFunction,
        args: [SSAId],
        stored: u64,
        fl: &mut StorageFlow,
        facts: &mut StorageFacts
    ) {
        let targets = unsafe { (*p_callee).store_targets };
        if (targets & STORE_GLOBAL_BIT) != 0 as u64 {
            facts.stored = facts.stored | stored;
            facts.targets = facts.targets | STORE_GLOBAL_BIT;
        }
        let ch = self.hidden_param_count(unsafe { &*p_callee });
        for ti in ch..args.len {
            let u = ti - ch;
            if u < STORE_INTO_GLOBAL as usize
                && ((targets >> (u as u64)) & 1 as u64) != 0 as u64
                && (args[ti] as usize) < fl.mask.len {
                self.note_storage_write(args[ti], stored, 0 as u64, fl, facts);
            }
        }
    }

    // Pointers, aggregates, and pointer-sized integers (address arithmetic in `unsafe`:
    // `(p as usize + off) as *T`).
    fn can_hold_address(self: &Verifier, ty: u32, by_arithmetic: bool) -> bool {
        if ty == 0 as u32 { return false; }
        let tag = self.get_type_tag(ty);
        if tag == ILTYPE_PRIMITIVE {
            if !by_arithmetic { return false; }
            let prim = self.module.types[ty as usize - 1 as usize].def.get_Primitive().get_tag();
            return prim == 3 as u32 || prim == 4 as u32 || prim == 8 as u32 || prim == 9 as u32; // u64, usize, i64, isize
        }
        return is_any_pointer_tag(tag)
            || tag == ILTYPE_SLICE
            || tag == ILTYPE_BOXED
            || tag == ILTYPE_BOXEDMUT
            || tag == ILTYPE_USER
            || tag == ILTYPE_TUPLE
            || tag == ILTYPE_ARRAY;
    }

    // A value carrying parameter-storage bits M (and reaching R) is written at DST.
    fn note_storage_write(
        self: &mut Verifier,
        dst: SSAId,
        m: u64,
        r: u64,
        fl: &mut StorageFlow,
        facts: &mut StorageFacts
    ) {
        let slot = fl.slot_of[dst as usize];
        if slot != 0 as u32 {
            fl.slot_mask[slot as usize] = fl.slot_mask[slot as usize] | m;
            fl.slot_reach[slot as usize] = fl.slot_reach[slot as usize] | r;
            return;
        }
        if fl.to_result[dst as usize] {
            facts.ret = facts.ret | m;
            return;
        }
        if m == 0 as u64 { return; }
        facts.stored = facts.stored | m;
        let t = fl.reach[dst as usize];
        // Memory of unknown origin counts as outliving every caller.
        facts.targets = facts.targets | (if t == 0 as u64 { STORE_GLOBAL_BIT } else { t });
    }

    // Bits of this function's parameters' storage that reach a callee's parameters selected
    // by TIES (its ret_storage or stores_storage), through the arguments passed for them.
    // A slice argument is the address of its header (a slot, or the field holding it), so
    // what counts is what the header holds, not where it is.
    fn call_storage_mask(
        self: &mut Verifier,
        p_callee: *mut ILFunction,
        args: [SSAId],
        ties: u64,
        fl: &StorageFlow
    ) -> u64 {
        if ties == 0 as u64 { return 0 as u64; }
        let hidden = self.hidden_param_count(unsafe { &*p_callee });
        let mut r = 0 as u64;
        let mut i = hidden;
        while i < args.len {
            let u = i - hidden;
            let a = args[i];
            if u < STORE_INTO_GLOBAL as usize
                && ((ties >> (u as u64)) & 1 as u64) != 0 as u64
                && (a as usize) < fl.mask.len {
                let pty = unsafe { (*p_callee).param(i).ty };
                if self.is_slice_like(pty) {
                    let slot = fl.slot_of[a as usize];
                    r = r
                        | (if slot != 0 as u32 {
                            fl.slot_mask[slot as usize]
                        } else {
                            fl.cmask[a as usize]
                        });
                } else {
                    r = r | fl.mask[a as usize];
                }
            }
            i = i + 1 as usize;
        }
        return r;
    }

    // Leading sret/closure-env parameters, which ret_ties and ret_storage do not count.
    fn hidden_param_count(self: &mut Verifier, func: &ILFunction) -> usize {
        let sret_name = self.sret_name;
        let env_name = self.env_name;
        let mut hidden = 0 as usize;
        while hidden < func.params_len
            && (func.param(hidden).name == sret_name || func.param(hidden).name == env_name) {
            hidden = hidden + 1 as usize;
        }
        return hidden;
    }

    fn has_sret_param(self: &mut Verifier, p_f: *mut ILFunction) -> bool {
        let sret_name = self.sret_name;
        return unsafe {
            (*p_f).params_len > 0 as usize && (*p_f).param(0 as usize).name == sret_name
        };
    }

    // A raw pointer returned by a call may point into the arguments its callee's signature ties it
    // to (`ret_ties`: `#[borrows(..)]`, or `self`, or every pointer parameter). If one of those
    // points to this frame's stack, so may the result: `return stash(&mut s)` dangles like
    // `return &mut s`. Raw pointers only: a returned reference is tracked by the borrow checker,
    // by place, which knows that `v.as_slice()` points into v's buffer rather than v's slot.
    // A call's result, and what the callee stores away, as they involve pointers into this frame.
    fn tie_call_result(
        self: &mut Verifier,
        p_f: *mut ILFunction,
        args: [SSAId],
        ssa: SSAId,
        span: Span
    ) {
        self.tie_call_result_storage(p_f, args, ssa);
        self.check_call_stores_stack(p_f, args, span);
    }

    // Whether the argument for callee parameter I carries a pointer into this frame. A
    // pointer argument is the address itself. A slice or function value argument arrives as
    // the slot holding it (IL type Ptr<Slice<..>>), so what matters is where the slice or the
    // environment points, not where the slot is (`""` in a temporary is not stack data).
    fn arg_points_to_stack(
        self: &mut Verifier,
        p_f: *mut ILFunction,
        i: usize,
        arg: SSAId
    ) -> bool {
        let param_ty = unsafe { (*p_f).param(i).ty };
        if self.is_slice_like(param_ty) {
            return (arg as usize) < self.uses.len
                && (self.points_to_stack[arg as usize] || self.holds_stack(arg));
        }
        return self.is_stack_addr(arg);
    }

    // A result that points into the storage of an argument on this frame's stack points to
    // the stack too, whatever its type: `c.get()` on a local `c` returning `&c.v`, or an
    // `Option<&i32>` / struct holding it, which arrives in the sret slot. The callee's body
    // decided which arguments count (`ret_storage`), so `v.as_slice()` on a local Vec,
    // which points into the Vec's buffer, does not.
    fn tie_call_result_storage(
        self: &mut Verifier,
        p_f: *mut ILFunction,
        args: [SSAId],
        ssa: SSAId
    ) {
        // A callee whose masks are unknown (`storage_known` false: a `-c` import whose `.zri`
        // carried no summary) may hand back a pointer into any argument's storage, so assume
        // every parameter ties - the same doctrine summary_pass applies to such a callee.
        let ties = if unsafe { (*p_f).storage_known } {
            unsafe { (*p_f).ret_storage }
        } else {
            0xffffffffffffffff as u64
        };
        if ties == 0 as u64 { return; }
        let hidden = self.hidden_param_count(unsafe { &*p_f });
        let mut i = hidden;
        while i < args.len {
            let u = i - hidden;
            if u < 64 as usize
                && ((ties >> (u as u64)) & 1 as u64) != 0 as u64
                && self.arg_points_to_stack(p_f, i, args[i]) {
                if self.has_sret_param(p_f) && args.len > 0 as usize {
                    self.mark_holds_stack(args[0]);
                } else if self.has_result(ssa) && (ssa as usize) < self.uses.len {
                    self.points_to_stack[ssa as usize] = true;
                }
            }
            i = i + 1 as usize;
        }
    }

    // A function value is called where no check can see the arguments, so a body that stores one
    // parameter's own storage into another parameter or a global cannot become one: the direct
    // call's check (check_call_stores_stack) has no analogue through the value. A target that is
    // also the stored parameter is the same place written back, which cannot move a pointer out
    // of it (doc/spec/surface_syntax.md §7.3).
    fn check_fn_value(self: &mut Verifier, fid: u32, span: Span) {
        if fid as usize >= self.module.functions.len() { return; }
        let p_f = &self.module.functions[fid as usize];
        let stored = unsafe { (*p_f).stores_storage };
        if stored == 0 as u64 { return; }
        let targets = unsafe { (*p_f).store_targets };
        if targets == 0 as u64 { return; }
        if (targets & STORE_GLOBAL_BIT) != 0 as u64 || (targets & !stored) != 0 as u64 {
            self.report_error(
                "region escape: the function stores a reference into memory that outlives a call through a `fn` value",
                span
            );
        }
    }

    // The callee writes the storage of some arguments into memory its other arguments reach
    // (`stores_storage` into `store_targets`). Passing a pointer into this frame for one of
    // the first is a write of that pointer to each target: within the frame it taints the
    // target's slot, outside it (a caller's memory, a global) it dangles, as when the write
    // is in this function (note_stack_ptr_written).
    fn check_call_stores_stack(
        self: &mut Verifier,
        p_f: *mut ILFunction,
        args: [SSAId],
        span: Span
    ) {
        // Unknown (see `tie_call_result_storage`): assume it stores every pointer it is handed
        // into long-lived memory, so a stack argument the caller passes is reported.
        let known = unsafe { (*p_f).storage_known };
        let stored = if known {
            unsafe { (*p_f).stores_storage }
        } else {
            0xffffffffffffffff as u64
        };
        if stored == 0 as u64 { return; }
        let targets = if known {
            unsafe { (*p_f).store_targets }
        } else {
            (1 as u64) << (STORE_INTO_GLOBAL as u64)
        };
        let hidden = self.hidden_param_count(unsafe { &*p_f });
        let mut stack_arg = false;
        let mut i = hidden;
        while i < args.len {
            let u = i - hidden;
            if u < STORE_INTO_GLOBAL as usize
                && ((stored >> (u as u64)) & 1 as u64) != 0 as u64
                && self.arg_points_to_stack(p_f, i, args[i]) {
                stack_arg = true;
            }
            i = i + 1 as usize;
        }
        if !stack_arg { return; }
        if (targets & STORE_GLOBAL_BIT) != 0 as u64 {
            self.report_error(
                "region escape: the callee stores a pointer to local stack storage where it outlives this function",
                span
            );
            return;
        }
        // Each target in this frame now holds a stack pointer; one outside it is an error,
        // reported once for the call.
        let mut escapes = false;
        i = hidden;
        while i < args.len {
            let u = i - hidden;
            if u < STORE_INTO_GLOBAL as usize && ((targets >> (u as u64)) & 1 as u64) != 0 as u64 {
                if self.is_stack_addr(args[i]) {
                    self.mark_holds_stack(args[i]);
                } else {
                    escapes = true;
                }
            }
            i = i + 1 as usize;
        }
        if escapes {
            self.report_error(
                "region escape: a pointer to local stack storage is written to memory that outlives this function",
                span
            );
        }
    }

    // A slice or a function value, or the slot one arrives in: two words, one of them a
    // pointer (the data, the environment) whose target is what matters, not the slot's.
    fn is_slice_like(self: &mut Verifier, ty: u32) -> bool {
        let mut tag = self.get_type_tag(ty);
        if is_any_pointer_tag(tag) {
            let inner = self.get_ptr_inner_type(ty);
            if inner == 0 as u32 { return false; }
            tag = self.get_type_tag(inner);
        }
        return tag == ILTYPE_SLICE || tag == ILTYPE_FN;
    }

    // An address in this frame's stack: a slot, or a pointer derived into one.
    fn is_stack_addr(self: &Verifier, ssa: SSAId) -> bool {
        if ssa == 0 as u32 || ssa as usize >= self.uses.len { return false; }
        return self.is_stack_slot[ssa as usize] || self.points_to_stack[ssa as usize];
    }

    fn holds_stack(self: &Verifier, ssa: SSAId) -> bool {
        if ssa == 0 as u32 || ssa as usize >= self.uses.len { return false; }
        if self.holds_stack_ptr[ssa as usize] { return true; }
        let base = self.stack_base[ssa as usize];
        return base != 0 as u32
            && (base as usize) < self.uses.len
            && self.holds_stack_ptr[base as usize];
    }

    fn mark_holds_stack(self: &mut Verifier, ssa: SSAId) {
        if ssa == 0 as u32 || ssa as usize >= self.uses.len { return; }
        self.holds_stack_ptr[ssa as usize] = true;
        let base = self.stack_base[ssa as usize];
        if base != 0 as u32 && (base as usize) < self.uses.len {
            self.holds_stack_ptr[base as usize] = true;
        }
    }

    // Record which 'local slot an address derives from (see stack_base).
    fn track_stack_base(self: &mut Verifier, instr: &ILInstr, ssa: SSAId) {
        if ssa == 0 as u32 || ssa as usize >= self.uses.len { return; }
        let mut from = 0 as u32;
        match *instr {
            ILInstr.Alloc(a) => {
                if a.allocator == 0xffffffff as u32 && is_local_region(&a.region) {
                    self.stack_base[ssa as usize] = ssa;
                }
                return;
            },
            ILInstr.Move(src) => { from = src; },
            ILInstr.Cast(c) => { from = c.val; },
            ILInstr.FieldAddr(fa) => { from = fa.val; },
            ILInstr.Add(op) => { from = op.lhs; },
            _ => { return; },
        }
        if from != 0 as u32 && (from as usize) < self.uses.len {
            self.stack_base[ssa as usize] = self.stack_base[from as usize];
        }
    }

    // A pointer to this frame's stack, or a value containing one, is being written to
    // DST. Within the frame that only taints DST's slot; anywhere else (an out-parameter,
    // a global, the heap, the caller's return slot) it outlives the frame and dangles.
    fn note_stack_ptr_written(self: &mut Verifier, dst: SSAId, span: Span) {
        if self.is_stack_addr(dst) {
            self.mark_holds_stack(dst);
        } else {
            self.report_error(
                "region escape: a pointer to local stack storage is written to memory that outlives this function",
                span
            );
        }
    }

    fn report_error(self: &mut Verifier, msg: [u8], span: Span) {
        self.had_error = true;
        diag_start(self.file_path, span, "error");
        eprint(msg);
        eprint("\n");
    }

    fn report_warning(self: &mut Verifier, msg: [u8], span: Span) {
        diag_start(self.file_path, span, "warning");
        eprint(msg);
        eprint("\n");
    }

    // `current_func` is set at the top of `verify_function` and read only from
    // code reached through it; this is the single marked forge.
    fn cur_func(self: &Verifier) -> &ILFunction {
        return unsafe { &*self.current_func };
    }

    // The mutable half, for the SSA-name and arena-accounting write-backs.
    fn cur_func_mut(self: &Verifier) -> &mut ILFunction {
        return unsafe { &mut *self.current_func };
    }

    fn get_ssa_type(self: &mut Verifier, ssa: SSAId) -> u32 {
        let f = self.cur_func();
        if ssa == 0 as u32 || ssa as usize >= f.result_types_len { return 0 as u32; }
        return f.result_type_ids()[ssa as usize];
    }

    fn get_type_tag(self: &Verifier, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        return p_ty.def.get_tag();
    }

    fn get_ptr_inner_type(self: &Verifier, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        match p_ty.def {
            ILType.Ptr(inner)
                | ILType.PtrMut(inner)
                | ILType.RawPtr(inner)
                | ILType.RawPtrMut(inner)
                | ILType.Boxed(inner)
                | ILType.BoxedMut(inner) => { return inner; },
            ILType.Slice(s) => { return s.element; },
            _ => { return 0 as u32; },
        }
    }

    fn is_aggregate(self: &Verifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        match p_ty.def {
            ILType.Array(_) | ILType.Tuple(_) | ILType.Fn(_) => { return true; },
            ILType.User(u) => {
                return match self.module.typedefs[u.id as usize] {
                    ILTypeDef.Struct(_) | ILTypeDef.Enum(_) => true,
                    ILTypeDef.Fn(_) => false
                };
            },
            _ => { return false; },
        }
    }

    fn is_implicit_aggregate_ptr(self: &Verifier, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        let tag = p_ty.def.get_tag();
        if !is_reference_tag(tag) { return false; }
        if p_ty.name != 0 as u32 { return false; }
        let inner = self.get_ptr_inner_type(ty_id);
        return self.is_aggregate(inner);
    }

    fn is_copy_type(self: &mut Verifier, ty_id: u32) -> bool {
        return self.is_copy_type_internal(ty_id, 0 as usize);
    }

    fn is_copy_type_internal(self: &mut Verifier, ty_id: u32, depth: usize) -> bool {
        if ty_id == 0 as u32 { return true; }
        // Past the recursion limit the answer is *unknown*, and unknown reads as "not `Copy`" - the
        // conservative side for this question, and the side that keeps the IL verifier's move
        // tracking on (doc/SAFETY.md §4.4).
        let past_limit_copy = depth > 10 as usize;
        if past_limit_copy { return false; }
        // Unnamed Ptr to aggregate = compiler-generated aggregate proxy; non-copy if inner is non-copy.
        if self.is_implicit_aggregate_ptr(ty_id) {
            let inner = self.get_ptr_inner_type(ty_id);
            return self.is_copy_type_internal(inner, depth + 1 as usize);
        }
        let p_ty = self.module.types[ty_id as usize - 1 as usize];
        match p_ty.def {
            ILType.Primitive(_)
                | ILType.Ptr(_)
                | ILType.RawPtr(_)
                | ILType.RawPtrMut(_)
                | ILType.Slice(_)
                | ILType.Fn(_) => { return true; },
            ILType.PtrMut(_) => { return false; },
            ILType.FD(_) | ILType.IORing => { return false; },
            ILType.Boxed(_) | ILType.BoxedMut(_) => { return false; },
            ILType.Array(a) => {
                return self.is_copy_type_internal(a.element, depth + 1 as usize);
            },
            ILType.Tuple(types) => {
                let mut i = 0 as usize;
                while i < types.len {
                    if !self.is_copy_type_internal(types[i], depth + 1 as usize) { return false; }
                    i = i + 1 as usize;
                }
                return true;
            },
            ILType.User(u) => {
                if u.id == 0 as u32 { return true; }
                if self.has_drop_impl(ty_id) { return false; }
                if u.id as usize >= self.module.typedefs.len() { return true; }
                let p_def = self.module.typedefs[u.id as usize];
                match p_def {
                    ILTypeDef.Struct(s) => {
                        if s.is_copy_opt_out { return false; }
                        let mut i = 0 as usize;
                        while i < s.fields.len {
                            if !self.is_copy_type_internal(s.fields[i].ty, depth + 1 as usize) {
                                return false;
                            }
                            i = i + 1 as usize;
                        }
                        return true;
                    },
                    ILTypeDef.Enum(e) => {
                        if e.is_copy_opt_out { return false; }
                        let mut i = 0 as usize;
                        while i < e.variants.len {
                            if e.variants[i].payload != 0 as u32 {
                                if !self.is_copy_type_internal(
                                    e.variants[i].payload,
                                    depth + 1 as usize
                                ) {
                                    return false;
                                }
                            }
                            i = i + 1 as usize;
                        }
                        return true;
                    },
                    ILTypeDef.Fn(_) => { return true; },
                }
            },
            ILType.Var(_) => { return true; },
        }
    }

    pub fn verify(self: &mut Verifier) -> i32 {
        self.compute_ret_storage();
        self.check_stores_claims();
        let mut i = 0 as usize;
        while i < self.module.functions.len() {
            // A raw pointer, like the fixpoint above: the verifier stores the function it is
            // checking (`current_func`), so it must be a view of the module, not of this frame.
            let p_func = (&self.module.functions[i]) as *mut ILFunction;
            self.verify_function(unsafe { &*p_func });
            i = i + 1 as usize;
        }
        if self.had_error { return 1 as i32; }
        return 0 as i32;
    }

    fn verify_function(self: &mut Verifier, func: &ILFunction) -> bool {
        if func.blocks_len == 0 as usize { return true; }
        let saved_file_path = self.file_path;
        if func.source_file != 0 as u32 {
            self.file_path = self.intern_table.lookup(func.source_file);
        }
        progress_name("Verifying function: ", self.intern_table.lookup(func.name));
        self.current_func = func;

        // The ownership map, large enough for every SSA id, all cleared.
        let ssa_count = func.result_types_len;
        if ssa_count >= self.current_map.cap {
            self.current_map.set_state(ssa_count as u32, OwnerState.Uninit, self.arena);
        }
        unsafe {
            memset(
                self.current_map.states as *mut u8,
                0,
                (self.current_map.count * 4 as usize) as u64
            );
        }
        self.current_map.count = 0 as usize;
        self.reset_ssa_tables(func.result_types_len);
        for k in 0 as usize..func.params_len {
            self.current_map.set_state(func.param(k).ssa, OwnerState.Owned, self.arena);
        }
        self.current_ssa = func.params_len as u32;

        for i in 0 as usize..func.blocks_len {
            let p_block = self.module.blocks[func.block_ids()[i] as usize];
            for j in 0 as usize..p_block.instructions_len {
                let instr = self.module.instrs[p_block.instr_ids()[j] as usize];
                self.count_uses(&instr);
            }
        }
        if self.uses.len > 0 as usize {
            unsafe {
                memcpy(
                    self.remaining_uses.ptr as *mut u8,
                    self.uses.ptr as *u8,
                    (self.uses.len * 4) as u64
                );
            }
        }
        for i in 0 as usize..func.blocks_len { self.check_block(func.block_ids()[i]); }

        if func.has_borrows { self.check_borrows_claim(func); }
        // Operand types: a mismatch is ZIL the compiler should not have produced.
        for issue in type_check_function(self.module, func, self.arena).as_slice() {
            let mut msg = unsafe { ByteVec.new_raw(self.arena) };
            msg.push_slice("invalid ZIL (a compiler bug): ");
            msg.push_slice(issue.message);
            self.report_error(msg.as_slice(), self.module.instr_spans[issue.instr_idx as usize]);
        }

        // Then each loop body again (the blocks from a backward jump's target to the jump), in
        // order, with the states the first pass left: what a later iteration sees.
        let in_loop = self.loop_blocks(func);
        for i in 0 as usize..func.blocks_len {
            if in_loop[i] { self.check_block(func.block_ids()[i]); }
        }

        self.file_path = saved_file_path;
        return true;
    }

    // The per-SSA analysis tables, sized for N ids and cleared.
    fn reset_ssa_tables(self: &mut Verifier, n: usize) {
        if n == 0 as usize { return; }
        let uses_len = n;
        // The parallel per-SSA analysis arrays, all freshly allocated here
        // and sized by `uses_len`: this is the one place they are forged.
        unsafe {
            self.uses = @slice(
                zoril_allocator_alloc(self.arena, uses_len * sizeof(u32)) as *mut u32,
                uses_len
            );
            self.arena_info = @slice(
                zoril_allocator_alloc(self.arena, uses_len * sizeof(ArenaInfo)) as *mut ArenaInfo,
                uses_len
            );
            self.const_values = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 8) as *mut u64,
                uses_len
            );
            self.const_flags = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 1) as *mut bool,
                uses_len
            );
            self.borrowed_from = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 4) as *mut u32,
                uses_len
            );
            self.borrow_is_mut = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 1) as *mut bool,
                uses_len
            );
            self.is_stack_slot = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 1) as *mut bool,
                uses_len
            );
            self.points_to_stack = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 1) as *mut bool,
                uses_len
            );
            self.holds_stack_ptr = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 1) as *mut bool,
                uses_len
            );
            self.stack_base = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 4) as *mut u32,
                uses_len
            );
            self.is_alloc_result = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 1) as *mut bool,
                uses_len
            );
            self.remaining_uses = @slice(
                zoril_allocator_alloc(self.arena, uses_len * 4) as *mut u32,
                uses_len
            );
            self.ssa_spans = @slice(
                zoril_allocator_alloc(self.arena, uses_len * sizeof(Span)) as *mut Span,
                uses_len
            );
        }
        let mut k = 0 as usize;
        while k < uses_len {
            self.uses[k] = 0 as u32;
            self.remaining_uses[k] = 0 as u32;
            self.arena_info[k] = ArenaInfo { state: ARENA_UNKNOWN, remaining: 0 as usize };
            self.const_values[k] = 0 as u64;
            self.const_flags[k] = false;
            self.borrowed_from[k] = 0 as u32;
            self.borrow_is_mut[k] = false;
            self.is_stack_slot[k] = false;
            self.points_to_stack[k] = false;
            self.holds_stack_ptr[k] = false;
            self.stack_base[k] = 0 as u32;
            self.is_alloc_result[k] = false;
            self.ssa_spans[k] = Span {
                start: 0 as u32,
                end: 0 as u32,
                line: 0 as u32,
                col: 0 as u32
            };
            k = k + 1 as usize;
        }
    }

    fn check_block(self: &mut Verifier, block_id: u32) {
        let p_block = self.module.blocks[block_id as usize];
        for j in 0 as usize..p_block.instructions_len {
            let instr_idx = p_block.instr_ids()[j] as usize;
            let instr = self.module.instrs[instr_idx];
            self.check_instr(
                &instr,
                p_block.ssa_result_ids()[j],
                self.module.instr_spans[instr_idx]
            );
        }
    }

    // Which blocks (by position) lie in a loop: from the target of a jump or branch back to
    // an earlier block through the block that jumps.
    // A fresh arena array of flags, held across the second pass's `&mut self` calls.
    #[borrows()]
    fn loop_blocks(self: &mut Verifier, func: &ILFunction) -> [mut bool] {
        let in_loop = unsafe {
            @slice(zoril_allocator_alloc(self.arena, func.blocks_len) as *mut bool, func.blocks_len)
        };
        for k in 0 as usize..in_loop.len { in_loop[k] = false; }
        let blocks = func.block_ids();
        for i in 0 as usize..func.blocks_len {
            let p_block = &self.module.blocks[blocks[i] as usize];
            if p_block.instructions_len == 0 as usize { continue; }
            let last = p_block.instr_ids()[p_block.instructions_len - 1 as usize];
            let mut target_idx = 0xffffffff as usize;
            for k in 0 as usize..i {
                let b = blocks[k];
                let is_target = match self.module.instrs[last as usize] {
                    ILInstr.Jmp(t) => b == t,
                    ILInstr.Branch(br) => b == br.then_block || b == br.else_block,
                    _ => false,
                };
                if is_target { target_idx = k; }
            }
            if target_idx != 0xffffffff as usize {
                for m in target_idx..i + 1 as usize { in_loop[m] = true; }
            }
        }
        return in_loop;
    }

    fn is_copy_type_ssa(self: &mut Verifier, ssa: SSAId) -> bool {
        if ssa == 0 as u32 { return true; }
        let ty = self.get_ssa_type(ssa);
        if self.is_copy_type_internal(ty, 0 as usize) { return true; }

        // Logically non-copy by type. But if it's a pointer/reference, it's a copyable address
        // UNLESS it's an owned stack slot (alloc_result) — then the slot owns the value.
        let tag = self.get_type_tag(ty);
        if is_any_pointer_tag(tag) || tag == ILTYPE_SLICE {
            if ssa < self.uses.len as u32 {
                let is_owned_slot = self.is_alloc_result[ssa as usize];
                if is_owned_slot {
                    let inner_ty = self.get_ptr_inner_type(ty);
                    return self.is_copy_type_internal(inner_ty, 0 as usize);
                }
            }
            return true;
        }
        return false;
    }

    // exhaustive: every IL instruction must state its ownership effect.
    fn check_instr(self: &mut Verifier, instr: &ILInstr, ssa: SSAId, span: Span) {
        if self.has_result(ssa) {
            self.ssa_spans[ssa as usize] = span;
        }

        // 1. Check ownership of operands
        self.check_operands(instr, span);

        self.track_stack_base(instr, ssa);

        // 2. Mark moves and results
        match *instr {
            ILInstr.Move(src) => { self.mark_move(src, ssa); },
            ILInstr.Borrow(b) => {
                if self.has_result(ssa) && ssa < self.uses.len as u32 {
                    self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
                    self.borrowed_from[ssa as usize] = b.val;
                    if b.val < self.uses.len as u32 {
                        self.points_to_stack[ssa as usize] = self.is_stack_slot[b.val as usize]
                            || self.points_to_stack[b.val as usize];
                    }
                    self.borrow_is_mut[ssa as usize] = b.is_mut;
                }
            },
            ILInstr.Store(s) => { self.mark_store(s, span); },
            ILInstr.Load(src) => { self.mark_load(src, ssa); },
            ILInstr.Ret(res) => { self.mark_ret(res, span); },
            ILInstr.Call(c) => { self.mark_call(c, ssa, span); },
            ILInstr.CallPtr(c) => { self.mark_call_ptr(c, ssa); },
            ILInstr.Cast(c) => { self.mark_cast(c, ssa); },
            ILInstr.FuncAddr(fid) => { self.check_fn_value(fid, span); },
            ILInstr.Const(c) => { self.mark_const(c, ssa); },
            ILInstr.Alloc(a) => { self.mark_alloc(a, ssa); },
            ILInstr.FieldAddr(fa) => { self.mark_field_addr(fa, ssa); },
            ILInstr.FDClose(fd_ssa) => {
                self.current_map.set_state(fd_ssa, OwnerState.Moved, self.arena);
            },
            ILInstr.IORingClose(ring_ssa) => {
                self.current_map.set_state(ring_ssa, OwnerState.Moved, self.arena);
            },
            ILInstr.EndBorrow(borrower) => {
                if borrower != 0 as u32 {
                    self.current_map.set_state(borrower, OwnerState.Moved, self.arena);
                }
            },
            ILInstr.Release(borrower) => {
                if borrower != 0 as u32 {
                    self.current_map.set_state(borrower, OwnerState.Moved, self.arena);
                }
            },
            ILInstr.Add(op) => {
                if self.has_result(ssa) && ssa < self.uses.len as u32 {
                    self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
                    let ssa_ty = self.get_ssa_type(ssa);
                    let tag = self.get_type_tag(ssa_ty);
                    let is_ptr = is_any_pointer_tag(tag);
                    if is_ptr
                        && op.lhs < self.uses.len as u32
                        && (self.is_stack_slot[op.lhs as usize]
                            || self.points_to_stack[op.lhs as usize]) {
                        self.points_to_stack[ssa as usize] = true;
                    }
                }
            },
            ILInstr.SliceConstruct(sc) => {
                if self.has_result(ssa) && ssa < self.uses.len as u32 {
                    self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
                    if sc.ptr < self.uses.len as u32
                        && (self.is_stack_slot[sc.ptr as usize]
                            || self.points_to_stack[sc.ptr as usize]) {
                        self.points_to_stack[ssa as usize] = true;
                    }
                }
            },
            // Everything else produces an owned result and carries no special ownership
            // effect. Every variant is named (rather than a `_` arm) so a new ILInstr cannot
            // silently default to "owned": `// exhaustive:` above keeps it that way.
            ILInstr.Sub(_)
                | ILInstr.Mul(_)
                | ILInstr.Div(_)
                | ILInstr.Rem(_)
                | ILInstr.And(_)
                | ILInstr.Or(_)
                | ILInstr.Xor(_)
                | ILInstr.Shl(_)
                | ILInstr.Shr(_)
                | ILInstr.CmpLt(_)
                | ILInstr.CmpLe(_)
                | ILInstr.CmpGt(_)
                | ILInstr.CmpGe(_)
                | ILInstr.CmpEq(_)
                | ILInstr.CmpNe(_)
                | ILInstr.WrappingAdd(_)
                | ILInstr.WrappingSub(_)
                | ILInstr.WrappingMul(_)
                | ILInstr.SaturatingAdd(_)
                | ILInstr.CheckedAdd(_)
                | ILInstr.CheckedSub(_)
                | ILInstr.CheckedMul(_)
                | ILInstr.Drop(_)
                | ILInstr.BoundsCheck(_)
                | ILInstr.SliceLoad(_)
                | ILInstr.SliceStore(_)
                | ILInstr.SliceLen(_)
                | ILInstr.ArrayConstruct(_)
                | ILInstr.ArrayLoad(_)
                | ILInstr.ArrayStore(_)
                | ILInstr.RegionCast(_)
                | ILInstr.IsSome(_)
                | ILInstr.Unwrap(_)
                | ILInstr.Branch(_)
                | ILInstr.Jmp(_)
                | ILInstr.GlobalAddr(_)
                | ILInstr.VariantMatch(_)
                | ILInstr.SumConstruct(_)
                | ILInstr.Syscall(_)
                | ILInstr.Phi(_)
                | ILInstr.StringConst(_)
                | ILInstr.FuncAddr(_)
                | ILInstr.FDOpen(_)
                | ILInstr.FDRead(_)
                | ILInstr.FDWrite(_)
                | ILInstr.IORingSetup(_)
                | ILInstr.IORingEnter(_)
                | ILInstr.Param(_)
                | ILInstr.Likely(_)
                | ILInstr.Unlikely(_)
                | ILInstr.GetEnv
                | ILInstr.Neg(_)
                | ILInstr.Not(_)
                | ILInstr.StructConstruct(_)
                | ILInstr.TupleConstruct(_)
                | ILInstr.Unreachable => {
                if self.has_result(ssa) {
                    self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
                }
            }
        }
        if self.has_result(ssa) {
            self.current_ssa = ssa;
        }
    }

    fn mark_move(self: &mut Verifier, src: SSAId, ssa: SSAId) {
        if !self.is_copy_type_ssa(src) {
            self.current_map.set_state(src, OwnerState.Moved, self.arena);
        }
        if self.has_result(ssa) && ssa < self.uses.len as u32 {
            self.current_map.set_state(ssa, OwnerState.Owned, self.arena);

            // Propagate name only if dst has no existing name (prevents overwriting lowerer-assigned name)
            let name = self.cur_func().get_ssa_name(src);
            if name != 0 as u32 && self.cur_func().get_ssa_name(ssa) == 0 as u32 {
                self.cur_func_mut().set_ssa_name(self.arena, ssa, name);
            }

            // Propagate is_alloc_result (moved owned aggregate stays owned)
            let mut ar = false;
            if src < self.uses.len as u32 {
                ar = self.is_alloc_result[src as usize];
            }
            self.is_alloc_result[ssa as usize] = ar;

            // Register propagated borrow
            if src < self.uses.len as u32 {
                if self.is_stack_slot[src as usize] {
                    self.is_stack_slot[ssa as usize] = true;
                }
                if self.points_to_stack[src as usize] {
                    self.points_to_stack[ssa as usize] = true;
                }
                if self.holds_stack(src) {
                    self.holds_stack_ptr[ssa as usize] = true;
                }
                let parent_borrow = self.get_ultimate_base(src);
                if parent_borrow != src {
                    self.borrowed_from[ssa as usize] = parent_borrow;
                    self.borrow_is_mut[ssa as usize] = self.borrow_is_mut[src as usize];
                }
            }

            // Propagate constant value
            if src < self.uses.len as u32 && self.const_flags[src as usize] {
                self.const_values[ssa as usize] = self.const_values[src as usize];
                self.const_flags[ssa as usize] = true;
            }

            // Propagate ArenaInfo
            if self.arena_info.len > 0 as usize && src < self.uses.len as u32 {
                self.arena_info[ssa as usize].state = self.arena_info[src as usize].state;
                self.arena_info[ssa as usize].remaining = self.arena_info[src as usize].remaining;
            }
        }
    }

    fn mark_store(self: &mut Verifier, s: StoreInstr, span: Span) {
        // Classified before the bookkeeping below, which makes the destination
        // look derived from the stored value.
        let dst_is_stack = self.is_stack_addr(s.ptr);
        let s_val_ty = self.get_ssa_type(s.val);
        if !self.is_copy_type(s_val_ty) {
            self.current_map.set_state(s.val, OwnerState.Moved, self.arena);
        }

        // Reset state of the base variable to Owned if stored to
        let mut base = s.ptr;
        if s.ptr < self.uses.len as u32 {
            let is_alloc = self.is_alloc_result[s.ptr as usize];
            if !is_alloc {
                let p_base = self.borrowed_from[s.ptr as usize];
                if p_base != 0 as u32 {
                    base = p_base;
                }
            }
        }
        if base != 0 as u32 && base < self.uses.len as u32 {
            self.current_map.set_state(base, OwnerState.Owned, self.arena);
        }

        // Propagate the borrow base when storing a pointer
        let val_ty = self.get_ssa_type(s.val);
        let val_tag = self.get_type_tag(val_ty);
        // A pointer to an aggregate usually stands for the aggregate itself, but not
        // when the destination holds a pointer: a slice's data pointer over an array.
        let dst_inner = self.get_ptr_inner_type(self.get_ssa_type(s.ptr));
        let dst_inner_tag = self.get_type_tag(dst_inner);
        let into_ptr_slot = dst_inner != 0 as u32 && (is_any_pointer_tag(dst_inner_tag));
        let is_real_ptr = (is_any_pointer_tag(val_tag) || val_tag == ILTYPE_SLICE)
            && (!self.is_implicit_aggregate_ptr(val_ty) || into_ptr_slot);
        let is_boxed = val_tag == ILTYPE_BOXED || val_tag == ILTYPE_BOXEDMUT;
        let is_ref_store = is_real_ptr
            || (is_boxed && (is_any_pointer_tag(dst_inner_tag) || dst_inner_tag == ILTYPE_SLICE));
        if is_ref_store {
            if s.ptr < self.uses.len as u32 {
                self.borrowed_from[s.ptr as usize] = s.val;
                if s.val < self.uses.len as u32 && s.ptr < self.uses.len as u32 {
                    // A slot's own address (`let p = &mut x` stores the alloc
                    // itself, with no Borrow) points to the stack as much as a
                    // pointer derived into it does.
                    if self.is_stack_addr(s.val) {
                        self.points_to_stack[s.ptr as usize] = true;
                    }
                }
            }
        }
        if (is_ref_store && self.is_stack_addr(s.val)) || self.holds_stack(s.val) {
            if dst_is_stack {
                self.mark_holds_stack(s.ptr);
            } else {
                self.report_error(
                    "region escape: a pointer to local stack storage is written to memory that outlives this function",
                    span
                );
            }
        }

        // Propagate ArenaInfo from value to pointer
        if self.arena_info.len > 0 as usize
            && s.val < self.uses.len as u32
            && s.ptr < self.uses.len as u32 {
            if self.arena_info[s.val as usize].state == ARENA_INITIALIZED {
                self.arena_info[s.ptr as usize].state = self.arena_info[s.val as usize].state;
                self.arena_info[s.ptr as usize].remaining = self.arena_info[s.val as usize].remaining;
            }
        }
    }

    fn mark_load(self: &mut Verifier, src: SSAId, ssa: SSAId) {
        if self.has_result(ssa) && ssa < self.uses.len as u32 {
            self.current_map.set_state(ssa, OwnerState.Owned, self.arena);

            // Propagate name only if dst has no existing name
            let name = self.cur_func().get_ssa_name(src);
            if name != 0 as u32 && self.cur_func().get_ssa_name(ssa) == 0 as u32 {
                self.cur_func_mut().set_ssa_name(self.arena, ssa, name);
            }

            // Propagate borrow base
            let val_ty = self.get_ssa_type(ssa);
            let val_tag = self.get_type_tag(val_ty);
            let is_real_ptr = (is_any_pointer_tag(val_tag) || val_tag == ILTYPE_SLICE)
                && !self.is_implicit_aggregate_ptr(val_ty);
            if is_real_ptr {
                if src < self.uses.len as u32 {
                    self.borrowed_from[ssa as usize] = src;
                    // points_to_stack of the SLOT, never is_stack_slot of
                    // it -- reading a pointer out of stack storage does
                    // not make that pointer point at the storage.
                    if self.is_stack_slot[src as usize] {
                        self.points_to_stack[ssa as usize] = self.points_to_stack[src as usize];
                    }
                    // A pointer read out of a slot that holds a stack pointer may
                    // be that pointer (e.g. a slice's data field). Per slot, not
                    // per field: conservative.
                    if self.holds_stack(src) {
                        self.points_to_stack[ssa as usize] = true;
                    }
                }
            }

            let is_boxed = val_tag == ILTYPE_BOXED || val_tag == ILTYPE_BOXEDMUT;
            if is_boxed {
                if src < self.uses.len as u32 {
                    let from_stack = self.is_stack_addr(src)
                        || self.stack_base[src as usize] != 0 as u32;
                    if from_stack || self.holds_stack(src) {
                        self.points_to_stack[ssa as usize] = true;
                    }
                }
            }

            if !is_real_ptr && !is_boxed && self.holds_stack(src) {
                self.holds_stack_ptr[ssa as usize] = true;
            }

            // Load from a pointer derived from a non-copy variable moves the variable
            let mut base = src;
            if src < self.uses.len as u32 {
                let p_base = self.borrowed_from[src as usize];
                if p_base != 0 as u32 {
                    base = p_base;
                }
            }
            if base != 0 as u32 && base < self.uses.len as u32 {
                let val_ty2 = self.get_ssa_type(ssa);
                if self.is_aggregate(val_ty2) && !self.is_copy_type(val_ty2) {
                    // Only move the base for owned (alloc-origin) aggregates.
                    // Loading non-copy through a borrowed reference should NOT consume the base.
                    let base_alloc = base < self.uses.len as u32
                        && self.is_alloc_result[base as usize];
                    if base_alloc {
                        self.current_map.set_state(base, OwnerState.Moved, self.arena);
                    }
                } else if src != base {
                    // Copy-type field load: release the FieldAddr borrow by clearing borrowed_from.
                    // Do NOT mark src as Moved — the same FieldAddr SSA may be the Store destination
                    // in a compound assignment like c.value += 1.
                    if src < self.uses.len as u32 {
                        self.borrowed_from[src as usize] = 0 as u32;
                    }
                }
            }

            // Propagate ArenaInfo from pointer to value
            if self.arena_info.len > 0 as usize && src < self.uses.len as u32 {
                if self.arena_info[src as usize].state == ARENA_INITIALIZED {
                    self.arena_info[ssa as usize].state = self.arena_info[src as usize].state;
                    self.arena_info[ssa as usize].remaining = self.arena_info[src as usize].remaining;
                }
            }
        }
    }

    fn mark_ret(self: &mut Verifier, res: SSAId, span: Span) {
        // A pointer into this frame's own stack storage, returned, dangles in the caller.
        // This keys on provenance (the value's ultimate base is a stack slot allocated
        // here), not on its type: a slice built from a pointer parameter traces back to the
        // parameter and is fine (`ByteVec.as_slice`).
        if res != 0 as u32 {
            if res < self.uses.len as u32 {
                let ret_tag = self.get_type_tag(self.get_ssa_type(res));
                let fn_ret_ty = self.cur_func().ret_ty;
                let fn_ret_tag = self.get_type_tag(fn_ret_ty);
                let is_ref_ret = is_any_pointer_tag(fn_ret_tag)
                    || fn_ret_tag == ILTYPE_SLICE
                    || is_any_pointer_tag(ret_tag)
                    || ret_tag == ILTYPE_SLICE;
                if is_ref_ret {
                    // Two ways to return a dangling stack pointer: hand
                    // back the slot's own address (`return &mut s` lowers
                    // to `ret <the alloc>`, with no Borrow instruction at
                    // all), or hand back a pointer derived into it.
                    if self.is_stack_slot[res as usize] || self.points_to_stack[res as usize] {
                        self.report_error(
                            "region escape: returning a pointer to local stack storage",
                            span
                        );
                    }
                }
            }
        }
        if res != 0 as u32 {
            if !self.is_copy_type_ssa(res) {
                if res < self.uses.len as u32 {
                    let p_base = self.borrowed_from[res as usize];
                    if p_base != 0 as u32 {
                        let tag = self.get_type_tag(self.get_ssa_type(res));
                        if !is_any_pointer_tag(tag) && tag != ILTYPE_SLICE {
                            self.report_error("cannot move out of borrow", span);
                        }
                    }
                }
                self.current_map.set_state(res, OwnerState.Moved, self.arena);
            }
        }
    }

    fn mark_call(self: &mut Verifier, c: CallInstr, ssa: SSAId, span: Span) {
        self.mark_call_args(&c, span);
        let p_f = self.callee_of(&c);
        if p_f != 0 as *mut ILFunction {
            self.tie_call_result(p_f, c.args, ssa, span);
        }
        if self.has_result(ssa) {
            if self.uses[ssa as usize] == 0 as u32
                && p_f != 0 as *mut ILFunction
                && unsafe { (*p_f).must_use } {
                self.report_warning("unused result from #[must_use] function", span);
            }
            self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
        }
        self.track_arena_call(&c, ssa, span);
    }

    // An argument passed by value (not through a pointer or slice) is moved into the callee:
    // moved out of a borrow, an error. The sret argument is the caller's own slot, not a move.
    // Arguments and parameters line up, hidden ones included.
    fn mark_call_args(self: &mut Verifier, c: &CallInstr, span: Span) {
        let p_f = self.callee_of(c);
        let mut sret_offset = 0 as usize;
        if p_f != 0 as *mut ILFunction {
            if self.is_aggregate(unsafe { (*p_f).ret_ty }) {
                sret_offset = 1 as usize;
            }
        }

        let mut i = 0 as usize;
        while i < c.args.len {
            let arg = c.args[i];

            let mut is_logical_move = true;
            if p_f != 0 as *mut ILFunction {
                let param_idx = i;
                if param_idx < unsafe { (*p_f).params_len } {
                    let param_ty = unsafe { (*p_f).param(param_idx).ty };
                    let tag = self.get_type_tag(param_ty);
                    if is_any_pointer_tag(tag) || tag == ILTYPE_SLICE {
                        is_logical_move = false;
                    }
                }
            } else {
                // External function: assume pointers are not moves
                let tag = self.get_type_tag(self.get_ssa_type(arg));
                if is_any_pointer_tag(tag) || tag == ILTYPE_SLICE {
                    is_logical_move = false;
                }
            }

            if is_logical_move && !self.is_copy_type_ssa(arg) {
                // Skip move check/marking for SRET argument
                let is_sret_arg = (i == 0 as usize && sret_offset == 1 as usize);
                if !is_sret_arg {
                    if arg < self.uses.len as u32 {
                        let p_base = self.borrowed_from[arg as usize];
                        if p_base != 0 as u32 {
                            let tag = self.get_type_tag(self.get_ssa_type(arg));
                            if !is_any_pointer_tag(tag) && tag != ILTYPE_SLICE {
                                self.report_error("cannot move out of borrow", span);
                            }
                        }
                    }
                    self.current_map.set_state(arg, OwnerState.Moved, self.arena);
                }
            }
            i = i + 1 as usize;
        }
    }

    // Compile-time arena accounting: `arena_init` with a constant capacity starts one, and
    // a constant allocation from it (or a callee's summarized one) uses it up; more than
    // fits is an error. A memcpy of a struct, tuple or slice holding a stack pointer is where
    // it leaves the frame.
    fn track_arena_call(self: &mut Verifier, c: &CallInstr, ssa: SSAId, span: Span) {
        // Compared in their own statements: a held `lookup` slice would keep the intern table
        // borrowed through the `&mut self` calls below (`has_suffix` takes `&self`).
        let is_memcpy = self.intern_table.lookup(c.name_id) == "memcpy";
        let is_arena_init = self.intern_table.lookup(c.name_id) == "arena_init"
            || self.has_suffix(self.intern_table.lookup(c.name_id), "_arena_init");
        let is_alloc = self.intern_table.lookup(c.name_id) == "zoril_allocator_alloc"
            || self.has_suffix(self.intern_table.lookup(c.name_id), "_zoril_allocator_alloc");
        if is_memcpy && c.args.len >= 2 as usize && self.holds_stack(c.args[1]) {
            self.note_stack_ptr_written(c.args[0], span);
        }
        if is_arena_init && c.args.len >= 1 as usize {
            let capacity_ssa = c.args[c.args.len - 1 as usize];
            let is_const = self.const_flags[capacity_ssa as usize];
            if is_const {
                let cap_val = self.const_values[capacity_ssa as usize];
                if self.has_result(ssa) {
                    self.arena_info[ssa as usize].state = ARENA_INITIALIZED;
                    self.arena_info[ssa as usize].remaining = cap_val as usize;
                }
            }
        } else if is_alloc && c.args.len >= 2 as usize {
            let arena_ssa = c.args[c.args.len - 2 as usize];
            let size_ssa = c.args[c.args.len - 1 as usize];
            let is_const = self.const_flags[size_ssa as usize];
            if is_const {
                let size_val = self.const_values[size_ssa as usize];
                self.cur_func_mut().arena_alloc_bytes = self.cur_func().arena_alloc_bytes
                    + size_val as usize;

                if self.arena_info[arena_ssa as usize].state == ARENA_INITIALIZED {
                    if size_val as usize > self.arena_info[arena_ssa as usize].remaining {
                        self.report_error("arena capacity exceeded at compile time", span);
                    } else {
                        self.arena_info[arena_ssa as usize].remaining = self.arena_info[arena_ssa as usize].remaining
                            - size_val as usize;
                    }
                }
            }
        } else {
            let p_f = self.callee_of(c);
            if p_f as usize != 0 as usize {
                let alloc_bytes = unsafe { (*p_f).arena_alloc_bytes };
                if alloc_bytes > 0 as usize && c.args.len > 0 as usize {
                    let arena_ssa = c.args[c.args.len - 1 as usize];
                    if self.arena_info[arena_ssa as usize].state == ARENA_INITIALIZED {
                        if alloc_bytes > self.arena_info[arena_ssa as usize].remaining {
                            self.report_error(
                                "arena capacity exceeded at compile time (interprocedural)",
                                span
                            );
                        } else {
                            self.arena_info[arena_ssa as usize].remaining = self.arena_info[arena_ssa as usize].remaining
                                - alloc_bytes;
                        }
                    }
                }
            }
        }
    }

    fn mark_call_ptr(self: &mut Verifier, c: CallPtrInstr, ssa: SSAId) {
        let mut i = 0 as usize;
        while i < c.args.len {
            let arg = c.args[i];
            if !self.is_copy_type_ssa(arg) {
                self.current_map.set_state(arg, OwnerState.Moved, self.arena);
            }
            i = i + 1 as usize;
        }
        if self.has_result(ssa) {
            self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
        }
    }

    fn mark_cast(self: &mut Verifier, c: CastInstr, ssa: SSAId) {
        if self.has_result(ssa) {
            self.current_map.set_state(ssa, OwnerState.Owned, self.arena);

            // Propagate name
            let name = self.cur_func().get_ssa_name(c.val);
            if name != 0 as u32 {
                self.cur_func_mut().set_ssa_name(self.arena, ssa, name);
            }

            // Register propagated borrow
            if c.val < self.uses.len as u32 {
                let is_stack = self.is_stack_slot[c.val as usize]
                    || self.points_to_stack[c.val as usize];
                if is_stack {
                    self.points_to_stack[ssa as usize] = true;
                }
                let has_parent = self.borrowed_from[c.val as usize] != 0 as u32;
                if has_parent {
                    self.borrowed_from[ssa as usize] = c.val;
                    self.borrow_is_mut[ssa as usize] = self.borrow_is_mut[c.val as usize];
                }
            }

            // Propagate constant value
            if self.const_flags[c.val as usize] {
                self.const_values[ssa as usize] = self.const_values[c.val as usize];
                self.const_flags[ssa as usize] = true;
            }

            // Propagate ArenaInfo
            if self.arena_info.len > 0 as usize {
                self.arena_info[ssa as usize].state = self.arena_info[c.val as usize].state;
                self.arena_info[ssa as usize].remaining = self.arena_info[c.val as usize].remaining;
            }
        }
    }

    fn mark_const(self: &mut Verifier, c: ConstInstr, ssa: SSAId) {
        if self.has_result(ssa) {
            self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
            match c.val {
                ConstValue.U64(v) => {
                    self.const_values[ssa as usize] = v;
                    self.const_flags[ssa as usize] = true;
                },
                ConstValue.F64(_) | ConstValue.Bool(_) => {}
            }
        }
    }

    fn mark_alloc(self: &mut Verifier, a: AllocInstr, ssa: SSAId) {
        if self.has_result(ssa) {
            self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
            if a.allocator == 0xffffffff as u32 && is_local_region(&a.region) {
                // An 'local alloc without an allocator is a stack slot in the
                // current frame, which is what the escape checks key on. An
                // 'heap one (`box`) is not: it outlives the frame.
                self.is_stack_slot[ssa as usize] = true;
            }
            self.is_alloc_result[ssa as usize] = true;
        }
    }

    fn mark_field_addr(self: &mut Verifier, fa: FieldAddrInstr, ssa: SSAId) {
        let is_mut = is_mut_pointer_tag(self.get_type_tag(self.get_ssa_type(ssa)));
        let base = self.get_ultimate_base(fa.val);
        // Field access on a directly-owned (Alloc-origin) non-copy struct moves the struct.
        // Borrowed aggregates (from FieldAddr/VariantMatch on references) have is_alloc_result=false.
        let val_ty = self.get_ssa_type(fa.val);
        let alloc_origin = fa.val < self.uses.len as u32 && self.is_alloc_result[fa.val as usize];
        let has_user_name = self.cur_func().get_ssa_name(fa.val) != 0 as u32;
        let inner_ty = self.get_ptr_inner_type(val_ty);
        let is_non_copy_struct = alloc_origin
            && has_user_name
            && self.is_implicit_aggregate_ptr(val_ty)
            && !self.is_copy_type(inner_ty);
        if is_non_copy_struct {
            self.current_map.set_state(base, OwnerState.Moved, self.arena);
            if self.has_result(ssa) {
                self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
                if fa.val < self.uses.len as u32 {
                    if self.is_stack_slot[fa.val as usize]
                        || self.points_to_stack[fa.val as usize] {
                        self.is_stack_slot[ssa as usize] = true;
                        self.points_to_stack[ssa as usize] = self.points_to_stack[fa.val as usize];
                    }
                }
            }
        } else {
            if self.has_result(ssa) {
                self.current_map.set_state(ssa, OwnerState.Owned, self.arena);
                self.borrowed_from[ssa as usize] = fa.val;
                if fa.val < self.uses.len as u32 {
                    if self.is_stack_slot[fa.val as usize]
                        || self.points_to_stack[fa.val as usize] {
                        self.is_stack_slot[ssa as usize] = true;
                        self.points_to_stack[ssa as usize] = self.points_to_stack[fa.val as usize];
                    }
                }
                self.borrow_is_mut[ssa as usize] = is_mut;

                // Do NOT propagate name: fa result is an intermediate pointer, not the variable.
                // Propagating the base name causes get_name_state to confuse the field addr's
                // state with the base variable's state.

            }
        }
    }

    fn dec_use(self: &mut Verifier, ssa: SSAId) {
        if ssa == 0 as u32 || ssa as usize >= self.uses.len { return; }
        if self.remaining_uses[ssa as usize] > 0 as u32 {
            self.remaining_uses[ssa as usize] = self.remaining_uses[ssa as usize] - 1 as u32;
            if self.remaining_uses[ssa as usize] == 0 as u32 {
                let state = self.current_map.get_state(ssa);
                if self.is_state_owned(state) {
                    let is_borrow = self.borrowed_from[ssa as usize] != 0 as u32;
                    let is_copy = self.is_copy_type_ssa(ssa);
                    if !is_copy || is_borrow {
                        self.current_map.set_state(ssa, OwnerState.Dropped, self.arena);
                    }
                }
            }
        }
    }

    fn check_ssa_access(self: &mut Verifier, ssa: SSAId, span: Span) {
        if ssa == 0 as u32 { return; }
        // Every operand a required position names must be a value this function defines.
        // NO_SSA in such a position is the `{ } *r = 5` shape after lowering: the address came
        // from an instruction with no operand, and the store then faulted at run time.
        if ssa == NO_SSA || ssa as usize >= self.uses.len {
            self.report_error(
                "invalid ZIL (a compiler bug): an instruction names an operand that no value defines",
                span
            );
            return;
        }
        self.dec_use(ssa);
    }

    // exhaustive: every IL instruction must name the operands it reads.
    fn check_operands(self: &mut Verifier, instr: &ILInstr, span: Span) {
        match *instr {
            ILInstr.Add(op)
                | ILInstr.Sub(op)
                | ILInstr.Mul(op)
                | ILInstr.Div(op)
                | ILInstr.Rem(op)
                | ILInstr.And(op)
                | ILInstr.Or(op)
                | ILInstr.Xor(op)
                | ILInstr.Shl(op)
                | ILInstr.Shr(op)
                | ILInstr.CmpEq(op)
                | ILInstr.CmpNe(op)
                | ILInstr.CmpLt(op)
                | ILInstr.CmpLe(op)
                | ILInstr.CmpGt(op)
                | ILInstr.CmpGe(op)
                | ILInstr.WrappingAdd(op)
                | ILInstr.WrappingSub(op)
                | ILInstr.WrappingMul(op)
                | ILInstr.SaturatingAdd(op)
                | ILInstr.CheckedAdd(op)
                | ILInstr.CheckedSub(op)
                | ILInstr.CheckedMul(op) => {
                self.check_ssa_access(op.lhs, span);
                self.check_ssa_access(op.rhs, span);
            },
            ILInstr.Neg(ssa)
                | ILInstr.Not(ssa)
                | ILInstr.Load(ssa)
                | ILInstr.IsSome(ssa)
                | ILInstr.Unwrap(ssa)
                | ILInstr.SliceLen(ssa)
                | ILInstr.FDClose(ssa)
                | ILInstr.IORingSetup(ssa)
                | ILInstr.IORingClose(ssa)
                | ILInstr.Likely(ssa)
                | ILInstr.Unlikely(ssa)
                | ILInstr.Move(ssa)
                | ILInstr.Drop(ssa)
                | ILInstr.EndBorrow(ssa)
                | ILInstr.Release(ssa) => {
                self.check_ssa_access(ssa, span);
            },
            // A `ret` with no value spells its operand as NO_SSA; only a defined value is read.
            ILInstr.Ret(ssa) => {
                if ssa != NO_SSA as u32 { self.check_ssa_access(ssa, span); }
            },
            ILInstr.Borrow(b) => { self.check_ssa_access(b.val, span); },
            ILInstr.Store(s) => {
                self.check_ssa_access(s.ptr, span);
                self.check_ssa_access(s.val, span);
            },
            ILInstr.Alloc(a) => {
                if a.allocator != 0xffffffff as u32 { self.check_ssa_access(a.allocator, span); }
            },
            ILInstr.BoundsCheck(b) => {
                self.check_ssa_access(b.idx, span);
                self.check_ssa_access(b.len, span);
            },
            ILInstr.RegionCast(rc) => { self.check_ssa_access(rc.val, span); },
            ILInstr.SliceLoad(i) => {
                self.check_ssa_access(i.base, span);
                self.check_ssa_access(i.idx, span);
            },
            ILInstr.SliceStore(is) => {
                self.check_ssa_access(is.base, span);
                self.check_ssa_access(is.idx, span);
                self.check_ssa_access(is.val, span);
            },
            ILInstr.SliceConstruct(sc) => {
                self.check_ssa_access(sc.ptr, span);
                self.check_ssa_access(sc.len, span);
            },
            ILInstr.ArrayConstruct(ssas) => {
                let mut i = 0 as usize;
                while i < ssas.len { self.check_ssa_access(ssas[i], span); i = i + 1 as usize; }
            },
            ILInstr.ArrayLoad(i) => {
                self.check_ssa_access(i.base, span);
                self.check_ssa_access(i.idx, span);
            },
            ILInstr.ArrayStore(is) => {
                self.check_ssa_access(is.base, span);
                self.check_ssa_access(is.idx, span);
                self.check_ssa_access(is.val, span);
            },
            ILInstr.VariantMatch(vm) => { self.check_ssa_access(vm.val, span); },
            ILInstr.SumConstruct(sc) => {
                if sc.payload != 0xffffffff as u32 { self.check_ssa_access(sc.payload, span); }
            },
            ILInstr.Call(c) => {
                let mut i = 0 as usize;
                while i < c.args.len { self.check_ssa_access(c.args[i], span); i = i + 1 as usize; }
            },
            ILInstr.CallPtr(c) => {
                self.check_ssa_access(c.func_ptr, span);
                let mut i = 0 as usize;
                while i < c.args.len { self.check_ssa_access(c.args[i], span); i = i + 1 as usize; }
            },
            ILInstr.Branch(b) => { self.check_ssa_access(b.cond, span); },
            ILInstr.FieldAddr(fa) => { self.check_ssa_access(fa.val, span); },
            ILInstr.StructConstruct(sc) => {
                let mut i = 0 as usize;
                while i < sc.fields.len {
                    self.check_ssa_access(sc.fields[i], span);
                    i = i + 1 as usize;
                }
            },
            ILInstr.TupleConstruct(ssas) => {
                let mut i = 0 as usize;
                while i < ssas.len { self.check_ssa_access(ssas[i], span); i = i + 1 as usize; }
            },
            ILInstr.Syscall(s) => {
                let mut i = 0 as usize;
                while i < s.args.len { self.check_ssa_access(s.args[i], span); i = i + 1 as usize; }
            },
            ILInstr.Phi(p) => {
                let mut i = 0 as usize;
                while i < p.preds.len {
                    self.check_ssa_access(p.preds[i].val, span);
                    i = i + 1 as usize;
                }
            },
            ILInstr.FDOpen(o) => { self.check_ssa_access(o.path, span); },
            ILInstr.FDRead(io) => {
                self.check_ssa_access(io.fd, span);
                self.check_ssa_access(io.buf, span);
            },
            ILInstr.FDWrite(io) => {
                self.check_ssa_access(io.fd, span);
                self.check_ssa_access(io.buf, span);
            },
            ILInstr.IORingEnter(ie) => { self.check_ssa_access(ie.ring, span); },
            ILInstr.Cast(c) => { self.check_ssa_access(c.val, span); },
            ILInstr.GetEnv => {},
            ILInstr.Jmp(_)
                | ILInstr.Unreachable
                | ILInstr.Const(_)
                | ILInstr.GlobalAddr(_)
                | ILInstr.FuncAddr(_)
                | ILInstr.StringConst(_)
                | ILInstr.Param(_) => {},
        }
    }

    fn count_uses(self: &mut Verifier, instr: &ILInstr) {
        match *instr {
            ILInstr.Add(op)
                | ILInstr.Sub(op)
                | ILInstr.Mul(op)
                | ILInstr.Div(op)
                | ILInstr.Rem(op)
                | ILInstr.And(op)
                | ILInstr.Or(op)
                | ILInstr.Xor(op)
                | ILInstr.Shl(op)
                | ILInstr.Shr(op)
                | ILInstr.CmpEq(op)
                | ILInstr.CmpNe(op)
                | ILInstr.CmpLt(op)
                | ILInstr.CmpLe(op)
                | ILInstr.CmpGt(op)
                | ILInstr.CmpGe(op)
                | ILInstr.WrappingAdd(op)
                | ILInstr.WrappingSub(op)
                | ILInstr.WrappingMul(op)
                | ILInstr.SaturatingAdd(op)
                | ILInstr.CheckedAdd(op)
                | ILInstr.CheckedSub(op)
                | ILInstr.CheckedMul(op) => {
                self.inc_use(op.lhs);
                self.inc_use(op.rhs);
            },
            ILInstr.Neg(ssa)
                | ILInstr.Not(ssa)
                | ILInstr.Load(ssa)
                | ILInstr.Ret(ssa)
                | ILInstr.IsSome(ssa)
                | ILInstr.Unwrap(ssa)
                | ILInstr.SliceLen(ssa)
                | ILInstr.FDClose(ssa)
                | ILInstr.IORingSetup(ssa)
                | ILInstr.IORingClose(ssa)
                | ILInstr.Likely(ssa)
                | ILInstr.Unlikely(ssa)
                | ILInstr.Move(ssa)
                | ILInstr.Drop(ssa)
                | ILInstr.EndBorrow(ssa)
                | ILInstr.Release(ssa) => {
                self.inc_use(ssa);
            },
            ILInstr.Borrow(b) => { self.inc_use(b.val); },
            ILInstr.Store(s) => {
                self.inc_use(s.ptr);
                self.inc_use(s.val);
            },
            ILInstr.Alloc(a) => {
                if a.allocator != 0xffffffff as u32 { self.inc_use(a.allocator); }
            },
            ILInstr.BoundsCheck(b) => { self.inc_use(b.idx); self.inc_use(b.len); },
            ILInstr.RegionCast(rc) => { self.inc_use(rc.val); },
            ILInstr.SliceLoad(i) => { self.inc_use(i.base); self.inc_use(i.idx); },
            ILInstr.SliceStore(is) => {
                self.inc_use(is.base);
                self.inc_use(is.idx);
                self.inc_use(is.val);
            },
            ILInstr.SliceConstruct(sc) => { self.inc_use(sc.ptr); self.inc_use(sc.len); },
            ILInstr.ArrayConstruct(ssas) => {
                let mut i = 0 as usize;
                while i < ssas.len { self.inc_use(ssas[i]); i = i + 1 as usize; }
            },
            ILInstr.ArrayLoad(i) => { self.inc_use(i.base); self.inc_use(i.idx); },
            ILInstr.ArrayStore(is) => {
                self.inc_use(is.base);
                self.inc_use(is.idx);
                self.inc_use(is.val);
            },
            ILInstr.VariantMatch(vm) => { self.inc_use(vm.val); },
            ILInstr.SumConstruct(sc) => {
                if sc.payload != 0xffffffff as u32 { self.inc_use(sc.payload); }
            },
            ILInstr.Call(c) => {
                let mut i = 0 as usize;
                while i < c.args.len { self.inc_use(c.args[i]); i = i + 1 as usize; }
            },
            ILInstr.CallPtr(c) => {
                self.inc_use(c.func_ptr);
                let mut i = 0 as usize;
                while i < c.args.len { self.inc_use(c.args[i]); i = i + 1 as usize; }
            },
            ILInstr.Branch(b) => { self.inc_use(b.cond); },
            ILInstr.FieldAddr(fa) => { self.inc_use(fa.val); },
            ILInstr.StructConstruct(sc) => {
                let mut i = 0 as usize;
                while i < sc.fields.len { self.inc_use(sc.fields[i]); i = i + 1 as usize; }
            },
            ILInstr.TupleConstruct(ssas) => {
                let mut i = 0 as usize;
                while i < ssas.len { self.inc_use(ssas[i]); i = i + 1 as usize; }
            },
            ILInstr.Syscall(s) => {
                let mut i = 0 as usize;
                while i < s.args.len { self.inc_use(s.args[i]); i = i + 1 as usize; }
            },
            ILInstr.Phi(p) => {
                let mut i = 0 as usize;
                while i < p.preds.len { self.inc_use(p.preds[i].val); i = i + 1 as usize; }
            },
            ILInstr.FDOpen(o) => { self.inc_use(o.path); },
            ILInstr.FDRead(io) => { self.inc_use(io.fd); self.inc_use(io.buf); },
            ILInstr.FDWrite(io) => { self.inc_use(io.fd); self.inc_use(io.buf); },
            ILInstr.IORingEnter(ie) => { self.inc_use(ie.ring); },
            ILInstr.Cast(c) => { self.inc_use(c.val); },
            ILInstr.GetEnv => {},
            ILInstr.Jmp(_)
                | ILInstr.Unreachable
                | ILInstr.Const(_)
                | ILInstr.GlobalAddr(_)
                | ILInstr.FuncAddr(_)
                | ILInstr.StringConst(_)
                | ILInstr.Param(_) => {},
        }
    }

    fn inc_use(self: &mut Verifier, ssa: SSAId) {
        if ssa == 0 as u32 || ssa as usize >= self.uses.len { return; }
        self.uses[ssa as usize] = self.uses[ssa as usize] + 1 as u32;
    }
    fn storage_load(
        self: &Verifier,
        func: &ILFunction,
        src: SSAId,
        ssa: SSAId,
        fl: &mut StorageFlow
    ) {
        let slot = fl.slot_of[src as usize];
        if slot != 0 as u32 {
            fl.mask[ssa as usize] = fl.slot_mask[slot as usize];
            fl.reach[ssa as usize] = fl.slot_reach[slot as usize];
            fl.cmask[ssa as usize] = fl.slot_cmask[slot as usize];
        } else {
            let val_ty = func.get_ssa_type(ssa);
            let val_tag = self.get_type_tag(val_ty);
            if val_tag == ILTYPE_BOXED || val_tag == ILTYPE_BOXEDMUT {
                fl.mask[ssa as usize] = fl.mask[src as usize] | fl.cmask[src as usize];
            } else {
                fl.mask[ssa as usize] = fl.cmask[src as usize];
            }
            fl.reach[ssa as usize] = fl.reach[src as usize];
        }
    }
}

// A frame-local region ('local).
fn is_local_region(r: &Region) -> bool {
    return match *r {
        Region.Local => true,
        Region.Static | Region.Heap | Region.Custom(_) => false
    };
}
