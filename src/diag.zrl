// Diagnostics. An error or warning is `FILE:LINE:COL: error: MESSAGE` (or `warning:`) on
// stderr; one with no source location is `zoril: error: MESSAGE` (main.zrl).

import "io.zrl";
import "fmt.zrl";
import "ast.zrl";
use ast::Span;
use io::{eprint, exit, stderr};
use fmt::write_u64;

pub static mut ERROR_LIMIT: u64 = 20;
pub static mut ERROR_COUNT: u64 = 0;
pub static mut SAW_FIRST_DECL: bool = false;

pub fn set_error_limit(limit: u64) {
    unsafe { ERROR_LIMIT = limit; }
}

pub fn mark_first_decl() {
    unsafe { SAW_FIRST_DECL = true; }
}

// Rejects a NUL byte or invalid UTF-8 with one diagnostic line before lexing starts.
pub fn validate_source_bytes(file: [u8], bytes: [u8]) -> bool {
    let mut i = 0 as usize;
    while i < bytes.len {
        let b = bytes[i];
        if b == 0 as u8 {
            eprint(file);
            eprint(": error: file contains a NUL byte (not Zoril source)\n");
            return false;
        }
        if b < 0x80 as u8 {
            i = i + 1 as usize;
        } else if (b & 0xe0 as u8) == 0xc0 as u8 {
            if i + 1 as usize >= bytes.len
                || b < 0xc2 as u8
                || (bytes[i + 1 as usize] & 0xc0 as u8) != 0x80 as u8 {
                eprint(file);
                eprint(": error: file is not valid UTF-8 (not Zoril source)\n");
                return false;
            }
            i = i + 2 as usize;
        } else if (b & 0xf0 as u8) == 0xe0 as u8 {
            if i + 2 as usize >= bytes.len
                || (bytes[i + 1 as usize] & 0xc0 as u8) != 0x80 as u8
                || (bytes[i + 2 as usize] & 0xc0 as u8) != 0x80 as u8
                || (b == 0xe0 as u8 && bytes[i + 1 as usize] < 0xa0 as u8)
                || (b == 0xed as u8 && bytes[i + 1 as usize] >= 0xa0 as u8) {
                eprint(file);
                eprint(": error: file is not valid UTF-8 (not Zoril source)\n");
                return false;
            }
            i = i + 3 as usize;
        } else if (b & 0xf8 as u8) == 0xf0 as u8 {
            if i + 3 as usize >= bytes.len
                || (bytes[i + 1 as usize] & 0xc0 as u8) != 0x80 as u8
                || (bytes[i + 2 as usize] & 0xc0 as u8) != 0x80 as u8
                || (bytes[i + 3 as usize] & 0xc0 as u8) != 0x80 as u8
                || (b == 0xf0 as u8 && bytes[i + 1 as usize] < 0x90 as u8)
                || (b > 0xf4 as u8)
                || (b == 0xf4 as u8 && bytes[i + 1 as usize] >= 0x90 as u8) {
                eprint(file);
                eprint(": error: file is not valid UTF-8 (not Zoril source)\n");
                return false;
            }
            i = i + 4 as usize;
        } else {
            eprint(file);
            eprint(": error: file is not valid UTF-8 (not Zoril source)\n");
            return false;
        }
    }
    return true;
}

// `FILE:LINE:COL: KIND: `, the start of a diagnostic (`FILE: KIND: ` for a span with no line, an
// interface's declaration); the caller writes the message and the newline.
pub fn diag_start(file: [u8], span: Span, kind: [u8]) {
    if kind == "error" {
        let lim = unsafe { ERROR_LIMIT };
        if lim > 0 as u64 {
            let count = unsafe { ERROR_COUNT };
            if count >= lim {
                eprint("zoril: error: ");
                if !unsafe { SAW_FIRST_DECL } {
                    eprint(
                        "too many errors before the first declaration (the file does not look like Zoril source); "
                    );
                } else {
                    eprint("too many errors; ");
                }
                eprint("stopping after ");
                let mut err = stderr();
                let _ = write_u64(&mut err, lim);
                eprint(" (use --error-limit N to change, 0 for no limit)\n");
                exit(1 as i32);
            }
            unsafe { ERROR_COUNT = count + 1 as u64; }
        }
    }
    eprint(file);
    if span.line == 0 as u32 {
        eprint(": ");
        eprint(kind);
        eprint(": ");
        return;
    }
    eprint(":");
    let mut err = stderr();
    let _ = write_u64(&mut err, span.line as u64);
    eprint(":");
    let _ = write_u64(&mut err, span.col as u64);
    eprint(": ");
    eprint(kind);
    eprint(": ");
}

// Lints: warnings a compile can turn on (`-W NAME`) or off (`-A NAME`). Each has a bit, and
// LINTS_ON_BY_DEFAULT says which start on; making one opt-in is clearing its bit there.
pub const LINT_WILDCARD_ARM: u32 = 0;   // `wildcard-arm`: `_` standing for few enum variants
pub const LINT_REDUNDANT_CAST: u32 = 1; // `redundant-cast`: `0 as u32` where a u32 is expected

pub const LINTS_ON_BY_DEFAULT: u64 = 1;
pub static mut LINTS_ON: u64 = 1;

pub fn lint_enabled(lint: u32) -> bool {
    return (unsafe { LINTS_ON } >> (lint as u64)) & (1 as u64) != 0 as u64;
}

pub fn set_lint(lint: u32, on: bool) {
    unsafe {
        if on {
            LINTS_ON = LINTS_ON | ((1 as u64) << (lint as u64));
        } else {
            LINTS_ON = LINTS_ON & !((1 as u64) << (lint as u64));
        }
    }
}

// The lint called NAME on the command line.
pub fn lint_named(name: [u8]) -> Option<u32> {
    if name == "wildcard-arm" { return Option.Some(LINT_WILDCARD_ARM); }
    if name == "redundant-cast" { return Option.Some(LINT_REDUNDANT_CAST); }
    return Option.None;
}
