pub struct Payload {
    pub num: u32,
    pub dummy: u32,
    pub ptr: usize,
    pub len: usize,
}

pub enum Container {
    Other(u32),
    Target(Payload),
}

fn main() -> i32 {
    let mut c = Container.Other(0 as u32);
    
    // Manually write tag 1 and value 42 at offset 8
    let p_tag = &c as *mut u32;
    *p_tag = 1 as u32;
    
    let p_num = (&c as usize + 8) as *mut u32;
    *p_num = 42 as u32;
    
    // Now read it using getter
    let n = match c {
        Container.Target(tp) => tp.num,
        _ => 0 as u32,
    };
    
    if n == 42 as u32 {
        @syscall(60, 0);
    }
    if n == 0 as u32 {
        @syscall(60, 2);
    }
    @syscall(60, 1);
    return 0;
}
