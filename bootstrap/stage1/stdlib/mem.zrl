// Zoril Standard Library: Memory Management
// Arena-based allocation.

import "sys.zrl";
import "io.zrl";

pub extern fn memcpy(dest: *mut u8, src: *u8, size: u64);
pub extern fn memset(dest: *mut u8, value: i32, size: u64);

pub struct Arena {
    pub start: *mut u8,
    pub offset: u64,
    pub capacity: u64,
}

// Arena header occupies the first 64 bytes of the mmap'd region.
// arena.offset is user-visible (0 = first byte after the header).
// Allocations internally add ARENA_HEADER_SIZE when computing pointers.
const ARENA_HEADER_SIZE: u64 = 64;

pub fn arena_init(capacity: u64) -> *mut Arena {
    // PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x22
    let ptr = must_mmap(0 as *mut u8, capacity, 3 as u64, 34 as u64, -1 as i64, 0 as u64);
    
    // Arena struct lives at the beginning of the mmap'd region
    let arena = ptr as *mut Arena;
    // The arena header lives in the mmap'd region itself; writing it is the act of
    // manufacturing the storage the safe API is built on (unsafe_policy.md §3).
    unsafe {
        (*arena).start = ptr;
        (*arena).offset = 0 as u64; // First user byte is at start + ARENA_HEADER_SIZE
        (*arena).capacity = capacity;
    }

    return arena;
}

pub fn arena_free(arena: *mut Arena) {
    unsafe { must_munmap((*arena).start, (*arena).capacity); }
}

// Byte written over memory an arena_reset releases. A use-after-reset then reads a fixed
// pattern (0xA5A5...) on every run, instead of whatever later allocations happened to leave
// there -- which is how a scratch-arena type list in the compiler stayed hidden for months
// (doc/tasks/active.tm.md, poison-on-reset task).
const ARENA_POISON: i32 = 165;

pub fn arena_reset(arena: *mut Arena, offset: u64) {
    // offset=0 resets to the first allocatable byte (past the Arena header)
    unsafe {
        let old_offset = (*arena).offset;
        if offset < old_offset {
            let released = ((*arena).start as u64 + ARENA_HEADER_SIZE + offset) as *mut u8;
            memset(released, ARENA_POISON, old_offset - offset);
        }
        (*arena).offset = offset;
    }
}

// Called internally by the compiler for `box(arena) expr`
pub fn zoril_allocator_alloc(arena: *mut Arena, size: u64) -> *mut u8 {
    if arena as u64 == 0 as u64 {
        // Fallback to mmap if no arena is provided
        let ptr = must_mmap(0 as *mut u8, size, 3 as u64, 34 as u64, -1 as i64, 0 as u64);
        return ptr;
    }
    // Apply header offset and align to 8 bytes.
    let mut aligned_offset = (arena.offset + ARENA_HEADER_SIZE + 7 as u64) & !(7 as u64);

    if aligned_offset + size > arena.capacity {
        must_write(2, "Arena overflow (capacity: ");
        write_u64(2, arena.capacity);
        must_write(2, ", requested: ");
        write_u64(2, aligned_offset + size);
        must_write(2, ")\n");
        exit(134 as u64);
    }

    let user_ptr = (arena.start as u64 + aligned_offset) as *mut u8;
    // Store user-visible offset (excluding header)
    arena.offset = aligned_offset + size - ARENA_HEADER_SIZE;

    return user_ptr;
}

pub fn zoril_allocator_realloc(arena: *mut Arena, old_ptr: *u8, old_size: u64, new_size: u64) -> *u8 {
    // If it's the last thing allocated, we can just expand it
    if (arena.start as u64 + arena.offset + ARENA_HEADER_SIZE) == (old_ptr as u64 + old_size) {
        if (old_ptr as u64 - arena.start as u64) + new_size <= arena.capacity {
            arena.offset = (old_ptr as u64 - arena.start as u64) + new_size - ARENA_HEADER_SIZE;
            return old_ptr;
        }
    }

    // Otherwise allocate new space and copy
    let new_ptr = zoril_allocator_alloc(arena, new_size);
    unsafe { memcpy(new_ptr, old_ptr, old_size); }
    return new_ptr;
}

pub fn zoril_allocator_free(arena: *mut Arena, ptr: *u8, size: u64) {
    if arena as u64 == 0 as u64 {
        must_munmap(ptr, size);
    }
    // Allocations within an arena cannot be freed individually
}

pub fn heap_alloc(size: u64) -> *mut u8 {
    return zoril_allocator_alloc(0 as *mut Arena, size);
}

pub fn heap_free(ptr: *u8, size: u64) {
    zoril_allocator_free(0 as *mut Arena, ptr, size);
}
