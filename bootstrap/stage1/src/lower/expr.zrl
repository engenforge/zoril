import "core.zrl";
import "mem.zrl";
import "io.zrl";
import "ast.zrl";
import "il_type.zrl";
import "il_instr.zrl";
import "il_cfg.zrl";
import "resolve.zrl";
import "token.zrl";
import "lexer.zrl";
import "intern.zrl";
import "bytevec.zrl";
import "mono.zrl";
import "builder.zrl";
import "vec.zrl";
import "env.zrl";

impl Lowerer {

    fn report_error(self: &mut Lowerer, msg: [u8], span: Span) {
        self.had_error = true;
        must_write(2, self.file_path);
        must_write(2, ":");
        write_u64(2, span.line as usize);
        must_write(2, ":");
        write_u64(2, span.col as usize);
        must_write(2, ": error: ");
        must_write(2, msg);
        must_write(2, "\n");
    }

    fn check_cast_validity(self: &mut Lowerer, c: &CastExpr, val: SSAId, target_ty: u32, span: Span) {
        let is_target_enum = self.resolver.is_enum_type(c.target_ty);
        if is_target_enum {
            self.report_error("cannot cast to enum type: enum discriminants must be constructed via variant constructors", span);
            return;
        }
        let is_target_ref = self.resolver.is_ref_type(c.target_ty);
        let is_target_fn = self.resolver.is_fn_type(c.target_ty);
        let is_target_param = self.resolver.is_type_param(c.target_ty) || (target_ty != 0 as u32 && self.get_type_tag(target_ty) == ILTYPE_VAR);
        if is_target_ref || is_target_fn || is_target_param {
            let val_ty = self.get_ssa_type(val);
            let mut is_int = false;
            let mut is_ptr = false;
            if val_ty != 0 as u32 {
                let p_val_decl: &ILTypeDecl = self.builder.get_type_decl(val_ty);
                match (*p_val_decl).def {
                    ILType.Primitive(prim) => {
                        is_int = prim.get_tag() <= ILPRIM_ISIZE;
                    },
                    ILType.Ptr(_) | ILType.PtrMut(_) => {
                        is_ptr = true;
                    },
                    _ => {},
                }
            }
            if is_target_ref {
                if is_int {
                    self.report_error("cannot cast integer to reference type: references cannot be null", span);
                } else if is_ptr {
                    self.report_error("cannot cast raw pointer directly to reference (dereference and borrow instead)", span);
                } else {
                    self.report_error("cannot cast to reference type: references cannot be null", span);
                }
            } else if is_target_fn {
                if is_int {
                    self.report_error("cannot cast integer to function pointer: function pointers cannot be null", span);
                } else if is_ptr {
                    self.report_error("cannot cast pointer to function pointer: function pointers cannot be null", span);
                } else {
                    self.report_error("cannot cast to function pointer: function pointers cannot be null", span);
                }
            } else if is_target_param {
                if is_int {
                    self.report_error("cannot cast integer to type parameter: type parameters may be reference types", span);
                }
            }
        }
    }

    fn validate_call_params(self: &mut Lowerer, is_variadic: bool, total_params: usize, ret_ty: u32, is_extern: bool, name: u32, actual_args: usize, span: Span) {
        let mut extra = 0 as usize;
        if self.requires_pass_by_ref(ret_ty) { extra = extra + 1 as usize; }
        if self.needs_env_ptr(is_extern, name) { extra = extra + 1 as usize; }

        let expected = if total_params >= extra { total_params - extra } else { 0 as usize };

        if is_variadic {
            if actual_args < expected {
                self.report_error_with_args("wrong number of arguments (expected ", expected, actual_args, span);
            }
        } else {
            if actual_args != expected {
                self.report_error_with_args("wrong number of arguments (expected ", expected, actual_args, span);
            }
        }
    }

    fn report_error_with_args(self: &mut Lowerer, prefix: [u8], expected: usize, actual: usize, span: Span) {
        self.had_error = true;
        must_write(2, self.file_path);
        must_write(2, ":");
        write_u64(2, span.line as usize);
        must_write(2, ":");
        write_u64(2, span.col as usize);
        must_write(2, ": error: ");
        must_write(2, prefix);
        write_u64(2, expected);
        must_write(2, ", got ");
        write_u64(2, actual);
        must_write(2, ")\n");
    }

    fn validate_call_args(self: &mut Lowerer, f: &FnDecl, c: &CallExpr, span: Span, is_method_call: bool) {
        let mut expected = f.params.len;
        if is_method_call {
            if expected > 0 as usize {
                expected = expected - 1 as usize;
            }
        }

        if f.is_variadic {
            if c.args.len < expected {
                self.report_error_with_args("wrong number of arguments (expected ", expected, c.args.len, span);
            }
        } else {
            if c.args.len != expected {
                self.report_error_with_args("wrong number of arguments (expected ", expected, c.args.len, span);
            }
        }
    }

    pub fn lower_expr_as_type(self: &mut Lowerer, expr_id: ExprId) -> u32 {
        let ast: &AST = self.resolver.ast;
        match ast.exprs.as_slice()[expr_id as usize] {
            Expr.Ident(id) => {
                let opt_sym = self.resolver.resolve_ptr(id);
                match opt_sym {
                    Some(s) => {
                        let k_tag = s.kind_tag as u32;
                        if k_tag == SYM_TYPE || k_tag == SYM_PRIMITIVE {
                            return self.resolve_sym_type(s);
                        }
                        if k_tag == SYM_GLOBAL {
                            match ast.decls.as_slice()[s.kind_payload as usize] {
                                Decl.Struct(_) | Decl.Enum(_) | Decl.TypeAlias(_) => {
                                    return self.resolve_sym_type(s);
                                },
                                _ => {},
                            }
                        }
                    },
                    None => {}
                }
            },
            Expr.Generic(g) => {
                match ast.exprs.as_slice()[g.expr as usize] {
                    Expr.Ident(id) => {
                        let opt_sym = self.resolver.resolve_ptr(id);
                        match opt_sym {
                            Some(s) => {
                                let k_tag = s.kind_tag as u32;
                                let mut decl_id = NO_SSA as u32;
                                if k_tag == SYM_GLOBAL {
                                     match ast.decls.as_slice()[s.kind_payload as usize] {
                                         Decl.Struct(_) | Decl.Enum(_) => {
                                             decl_id = s.kind_payload;
                                         },
                                         _ => {},
                                     }
                                }

                                if decl_id != NO_SSA as u32 {
                                    let resolved_type_args = self.resolver.resolve_type_list(g.type_args.ptr, g.type_args.len);
                                    return self.mono.instantiate_type(decl_id, resolved_type_args);
                                }
                            },
                            None => {}
                        }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        return 0 as u32;
    }

    pub fn get_enum_payload_offset(self: &mut Lowerer, enum_ty_id: u32) -> u64 {
        // payload_offset = max(4, max_payload_align) per ABI spec.
        if enum_ty_id == 0 as u32 { return ENUM_TAG_SIZE; }
        if enum_ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:164"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(enum_ty_id);
        match (*p_ty).def {
            ILType.User(u) => {
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Enum(e) => {
                        let mut max_payload_align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < e.variants.len {
                            let p_var: &ILVariant = &e.variants[i];
                            if p_var.payload != 0 as u32 {
                                let a = self.get_type_align(p_var.payload);
                                if a > max_payload_align { max_payload_align = a; }
                            }
                            i = i + 1 as usize;
                        }
                        if max_payload_align < ENUM_TAG_SIZE { return ENUM_TAG_SIZE; }
                        return max_payload_align;
                    },
                    ILTypeDef.Struct(_) | ILTypeDef.Fn(_) => {},
                }
            },
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) |
            ILType.BoxedMut(_) | ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) |
            ILType.Tuple(_) | ILType.FD(_) | ILType.IORing | ILType.Var(_) => {},
        }
        return ENUM_TAG_SIZE;
    }

    pub fn is_aggregate(self: &mut Lowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        if ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:195"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);
        match (*p_ty).def {
            ILType.Slice(_) | ILType.Array(_) | ILType.Tuple(_) => { return true; },
            ILType.User(u) => {
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                let tag = (*p_def).get_tag();
                return tag == 0 as u32 || tag == 1 as u32; // Struct or Enum
            },
            _ => { return false; },
        }
    }

    pub fn requires_pass_by_ref(self: &mut Lowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        return self.is_aggregate(ty_id);
    }
    pub fn needs_env_ptr(self: &mut Lowerer, is_extern: bool, name: u32) -> bool {
        if is_extern { return false; }
        if name == self.intern_table.intern("main") { return false; }
        // Syscalls don't get an env ptr in Zoril's ABI
        let name_slice = self.intern_table.lookup(name);
        if name_slice.len >= 16 as usize {
            if name_slice[0] == '_' as u8 && name_slice[1] == '_' as u8 && name_slice[2] == 'z' as u8 {
                return false; // Very hacky syscall stub check, maybe refine
            }
        }
        return true;
    }

    pub fn get_type_size(self: &mut Lowerer, ty_id: u32) -> u64 {
        if self.sizing_depth > 100 as u32 {
            if !self.had_error {
                must_write(2, "error: recursive type detected (recursive types must be behind a pointer)\n");
                self.had_error = true;
            }
            return 0 as u64;
        }
        self.sizing_depth = self.sizing_depth + 1 as u32;
        let res = self.get_type_size_internal(ty_id);
        self.sizing_depth = self.sizing_depth - 1 as u32;
        return res;
    }

    fn get_type_size_internal(self: &mut Lowerer, ty_id: u32) -> u64 {
        if ty_id == 0 as u32 { return 0 as u64; }
        if ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:240"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);

        match (*p_ty).def {
            ILType.Primitive(p) => {
                match p {
                    ILPrimitive.U8 => { return 1 as u64; },
                    ILPrimitive.U16 => { return 2 as u64; },
                    ILPrimitive.U32 => { return 4 as u64; },
                    ILPrimitive.U64 => { return 8 as u64; },
                    ILPrimitive.USize => { return 8 as u64; },
                    ILPrimitive.I8 => { return 1 as u64; },
                    ILPrimitive.I16 => { return 2 as u64; },
                    ILPrimitive.I32 => { return 4 as u64; },
                    ILPrimitive.I64 => { return 8 as u64; },
                    ILPrimitive.ISize => { return 8 as u64; },
                    ILPrimitive.F32 => { return 4 as u64; },
                    ILPrimitive.F64 => { return 8 as u64; },
                    ILPrimitive.Bool => { return 1 as u64; },
                    ILPrimitive.Char => { return 4 as u64; },
                    ILPrimitive.Unit => { return 0 as u64; },
                    ILPrimitive.Never => { return 0 as u64; },
                }
            },
            ILType.Ptr(_) => { return 8 as u64; },
            ILType.PtrMut(_) => { return 8 as u64; },
            ILType.Boxed(_) => { return 8 as u64; },
            ILType.BoxedMut(_) => { return 8 as u64; },
            ILType.Slice(_) => { return 16 as u64; },
            ILType.Array(a) => {
                return (a.size as u64) * self.get_type_size(a.element);
            },
            ILType.Fn(_) => { return 8 as u64; },
            ILType.Tuple(types) => {
                let mut size = 0 as u64;
                let mut align = 1 as u64;
                let mut i = 0 as usize;
                while i < types.len {
                    let f_ty = types[i];
                    let f_size = self.get_type_size(f_ty);
                    let f_align = self.get_type_align(f_ty);
                    if f_align > align { align = f_align; }
                    size = (size + f_align - 1 as u64) / f_align * f_align;
                    size = size + f_size;
                    i = i + 1 as usize;
                }
                size = (size + align - 1 as u64) / align * align;
                return size;
            },
            ILType.User(u) => {
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Struct(s) => {
                        let mut size = 0 as u64;
                        let mut align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < s.fields.len {
                            let f_ty = s.fields[i].ty;
                            let f_size = self.get_type_size(f_ty);
                            let f_align = self.get_type_align(f_ty);
                            if f_align > align { align = f_align; }
                            size = (size + f_align - 1 as u64) / f_align * f_align;
                            size = size + f_size;
                            i = i + 1 as usize;
                        }
                        size = (size + align - 1 as u64) / align * align;
                        return size;
                    },
                    ILTypeDef.Enum(e) => {
                        let mut max_payload_size = 0 as u64;
                        let mut max_payload_align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < e.variants.len {
                            let p_var: &ILVariant = &e.variants[i];
                            if p_var.payload != 0 as u32 {
                                let v_size = self.get_type_size(p_var.payload);
                                let v_align = self.get_type_align(p_var.payload);
                                if v_size > max_payload_size { max_payload_size = v_size; }
                                if v_align > max_payload_align { max_payload_align = v_align; }
                            }
                            i = i + 1 as usize;
                        }

                        if max_payload_size == 0 as u64 { return ENUM_TAG_SIZE; }
                        // payload_offset = max(4, max_payload_align) per ABI spec.
                        let enum_align = if max_payload_align > ENUM_TAG_SIZE { max_payload_align } else { ENUM_TAG_SIZE };
                        let total_size = enum_align + max_payload_size;
                        return (total_size + enum_align - 1 as u64) / enum_align * enum_align;
                    },
                    ILTypeDef.Fn(_) => { return 8 as u64; },
                }
            },
            ILType.FD(_) => { return 8 as u64; },
            ILType.IORing => { return 8 as u64; },
            ILType.Var(_) => { return 8 as u64; },
        }
    }

    pub fn get_type_align(self: &mut Lowerer, ty_id: u32) -> u64 {
        if self.sizing_depth > 100 as u32 {
            if !self.had_error {
                must_write(2, "error: recursive type detected (recursive types must be behind a pointer)\n");
                self.had_error = true;
            }
            return 1 as u64;
        }
        self.sizing_depth = self.sizing_depth + 1 as u32;
        let res = self.get_type_align_internal(ty_id);
        self.sizing_depth = self.sizing_depth - 1 as u32;
        return res;
    }

    fn get_type_align_internal(self: &mut Lowerer, ty_id: u32) -> u64 {
        if ty_id == 0 as u32 { return 1 as u64; }
        if ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:353"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);

        match (*p_ty).def {
            ILType.Primitive(p) => {
                match p {
                    ILPrimitive.U8 => { return 1 as u64; },
                    ILPrimitive.U16 => { return 2 as u64; },
                    ILPrimitive.U32 => { return 4 as u64; },
                    ILPrimitive.U64 => { return 8 as u64; },
                    ILPrimitive.USize => { return 8 as u64; },
                    ILPrimitive.I8 => { return 1 as u64; },
                    ILPrimitive.I16 => { return 2 as u64; },
                    ILPrimitive.I32 => { return 4 as u64; },
                    ILPrimitive.I64 => { return 8 as u64; },
                    ILPrimitive.ISize => { return 8 as u64; },
                    ILPrimitive.F32 => { return 4 as u64; },
                    ILPrimitive.F64 => { return 8 as u64; },
                    ILPrimitive.Bool => { return 1 as u64; },
                    ILPrimitive.Char => { return 4 as u64; },
                    ILPrimitive.Unit => { return 1 as u64; },
                    ILPrimitive.Never => { return 1 as u64; },
                }
            },
            ILType.Ptr(_) => { return 8 as u64; },
            ILType.PtrMut(_) => { return 8 as u64; },
            ILType.Boxed(_) => { return 8 as u64; },
            ILType.BoxedMut(_) => { return 8 as u64; },
            ILType.Slice(_) => { return 8 as u64; },
            ILType.Array(a) => { return self.get_type_align(a.element); },
            ILType.Fn(_) => { return 8 as u64; },
            ILType.Tuple(types) => {
                let mut align = 1 as u64;
                let mut i = 0 as usize;
                while i < types.len {
                    let f_align = self.get_type_align(types[i]);
                    if f_align > align { align = f_align; }
                    i = i + 1 as usize;
                }
                return align;
            },
            ILType.User(u) => {
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Struct(s) => {
                        let mut align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < s.fields.len {
                            let f_align = self.get_type_align(s.fields[i].ty);
                            if f_align > align { align = f_align; }
                            i = i + 1 as usize;
                        }
                        return align;
                    },
                    ILTypeDef.Enum(e) => {
                        let mut max_payload_align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < e.variants.len {
                            let p_var: &ILVariant = &e.variants[i];
                            if p_var.payload != 0 as u32 {
                                let a = self.get_type_align(p_var.payload);
                                if a > max_payload_align { max_payload_align = a; }
                            }
                            i = i + 1 as usize;
                        }
                        // enum_align = max(4, max_payload_align) per ABI spec.
                        if max_payload_align < ENUM_TAG_SIZE { return ENUM_TAG_SIZE; }
                        return max_payload_align;
                    },
                    ILTypeDef.Fn(_) => { return 8 as u64; },
                }
            },
            ILType.FD(_) => { return 8 as u64; },
            ILType.IORing => { return 8 as u64; },
            ILType.Var(_) => { return 1 as u64; },
        }
    }


    pub fn get_field_index(self: &mut Lowerer, struct_ty_id: u32, field_name: u32) -> u32 {
        if struct_ty_id == 0 as u32 { return NO_SSA as u32; }
        
        // Ensure typedef is lowered if it's a user type, BEFORE getting p_ty
        if struct_ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:435"); }
        let mut p_ty_initial: &ILTypeDecl = self.builder.get_type_decl(struct_ty_id);
        match (*p_ty_initial).def {
            ILType.User(u) => {
                self.mono.lower_typedef(u.id);
            },
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
            ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
            ILType.IORing | ILType.Var(_) => {},
        }

        if struct_ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:445"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(struct_ty_id);
        match (*p_ty).def {
            ILType.Slice(_) => {
                if field_name == self.ptr_id || field_name == self.intern_table.intern("data") { return 0 as u32; }
                if field_name == self.len_id { return 1 as u32; }
            },
            ILType.User(u) => {
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Struct(s) => {
                        let mut i = 0 as usize;
                        while i < s.fields.len {
                            if s.fields[i].name == field_name {
                                return i as u32;
                            }
                            i = i + 1 as usize;
                        }
                    },
                    ILTypeDef.Enum(_) | ILTypeDef.Fn(_) => {},
                }
            },
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
            ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) | ILType.IORing | ILType.Var(_) => {},
        }
        return NO_SSA as u32;
    }

    pub fn get_variant_index(self: &mut Lowerer, enum_ty_id: u32, variant_name: u32) -> u32 {
        if enum_ty_id == 0 as u32 { return NO_SSA as u32; }
        if enum_ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:474"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(enum_ty_id);

        match (*p_ty).def {
            ILType.User(u) => {
                // Ensure typedef is lowered
                self.mono.lower_typedef(u.id);
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Enum(e) => {
                        let mut i = 0 as usize;
                        while i < e.variants.len {
                            let p_var: &ILVariant = &e.variants[i];
                            if p_var.name == variant_name { return i as u32; }
                            i = i + 1 as usize;
                        }
                    },
                    ILTypeDef.Struct(_) | ILTypeDef.Fn(_) => { ICE("get_variant_index: not an enum"); },
                }
            },
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
            ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
            ILType.IORing | ILType.Var(_) => {
                // Not a user enum — return NO_SSA so callers can fall back to impl-const matching
            },
        }
        return NO_SSA as u32;
    }

    pub fn get_variant_payload_type(self: &mut Lowerer, enum_ty_id: u32, variant_idx: u32) -> u32 {
        if enum_ty_id == 0 as u32 { return 0 as u32; }
        if enum_ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:504"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(enum_ty_id);

        match (*p_ty).def {
            ILType.User(u) => {
                // Ensure typedef is lowered
                self.mono.lower_typedef(u.id);
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Enum(e) => {
                        if variant_idx as usize < e.variants.len {
                            let p_var: &ILVariant = &e.variants[variant_idx as usize];
                            return p_var.payload;
                        }
                    },
                    ILTypeDef.Struct(_) | ILTypeDef.Fn(_) => { ICE("get_variant_payload_type: not an enum"); },
                }
            },
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
            ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
            ILType.IORing | ILType.Var(_) => { ICE("get_variant_payload_type: not a user type"); },
        }
        return 0 as u32;
    }

    pub fn get_field_type(self: &mut Lowerer, struct_ty_id: u32, field_idx: u32) -> u32 {
        if struct_ty_id == 0 as u32 { return 0 as u32; }
        if struct_ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:530"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(struct_ty_id);

        match (*p_ty).def {
            ILType.User(u) => {
                // Ensure typedef is lowered
                self.mono.lower_typedef(u.id);
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Struct(s) => {
                        return s.fields[field_idx as usize].ty;
                    },
                    ILTypeDef.Enum(_) | ILTypeDef.Fn(_) => { ICE("get_field_type: not a struct"); },
                }
            },
            ILType.Slice(s) => {
                if field_idx == 0 as u32 { return self.get_ptr_type( s.element ); }
                if field_idx == 1 as u32 { return self.get_primitive_type(ILPrimitive.U64); } // u64
            },
            ILType.Tuple(types) => {
                if (field_idx as usize) < types.len { return types[field_idx as usize]; }
            },
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
            ILType.Array(_) | ILType.Fn(_) | ILType.FD(_) | ILType.IORing | ILType.Var(_) => { ICE("get_field_type: unhandled ILType variant"); },
        }
        return 0 as u32;
    }


    pub fn lower_address_of(self: &mut Lowerer, expr_id: ExprId, is_mut: bool) -> SSAId {
        let dest = self.lower_address_of_internal(expr_id);
        if dest == NO_SSA as u32 { return NO_SSA as u32; }

        let ssa_ty = self.get_ssa_type(dest);
        let inner_ty = self.get_ptr_inner_type(ssa_ty);
        if inner_ty == 0 as u32 { return dest; }

        let borrow_ty = if is_mut { self.get_ptr_mut_type(inner_ty) } else { self.get_ptr_type(inner_ty) };
        
        // Wrap in Borrow instruction for the verifier to track the reference lifecycle.
        // This is crucial for Phase 2 borrow checking and aliasing rules.
        return self.emit_with_type(ILInstr.Borrow(BorrowInstr { val: dest, is_mut: is_mut }), borrow_ty);
    }

    pub fn lower_address_of_internal(self: &mut Lowerer, expr_id: ExprId) -> SSAId {
        if expr_id == 0 as ExprId { return NO_SSA as u32; }
        let ast: &AST = self.resolver.ast;
        let p_expr: &Expr = &ast.exprs[expr_id as usize];
        
        match *p_expr {
            Expr.Literal(lit) => {
                match lit {
                    Literal.String(_) => { return self.lower_expr(expr_id); },
                    _ => { return NO_SSA as u32; },
                }
            },
            Expr.Ident(id) => {
                let opt_sym = self.resolver.resolve_ptr(id);
                match opt_sym {
                    Some(s) => {
                        let p_entry = self.get_symbol_entry(s);
                        if p_entry != 0 as *mut SymbolMapEntry {
                            if (*p_entry).addr_ssa != 0 as u64 {
                                let ty = (*p_entry).ty;
                                if self.is_compiler_aggregate_slot(ty) {
                                    return self.emit_with_type(ILInstr.Load((*p_entry).addr_ssa as SSAId), ty);
                                }
                                return (*p_entry).addr_ssa as SSAId;
                            }
                            // No addr_ssa yet. For aggregate immutable locals, ssa holds the
                            // aggregate address directly — return it as the address-of result.
                            let resolved_ty = self.resolve_sym_type(s);
                            (*p_entry).ty = resolved_ty;
                            if self.is_implicit_aggregate_ptr(resolved_ty) {
                                return (*p_entry).ssa as SSAId;
                            }
                            let ptr_ty = self.get_ptr_type(resolved_ty);
                            let saved = self.builder.current_block_idx;
                            let k_tag = s.kind_tag as u32;
                            if k_tag == SYM_PARAM {
                                self.switch_to_block(self.builder.entry_block_idx);
                                let slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: resolved_ty, allocator: NO_SSA as u32 }), ptr_ty);
                                self.emit(ILInstr.Store(StoreInstr { ptr: slot, val: (*p_entry).ssa as SSAId }));
                                self.switch_to_block(saved);
                                 self.set_symbol_addr_ssa(s, slot);
                                return slot;
                            } else {
                                self.switch_to_block(self.builder.entry_block_idx);
                                let slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: resolved_ty, allocator: NO_SSA as u32 }), ptr_ty);
                                self.switch_to_block(saved);
                                self.emit(ILInstr.Store(StoreInstr { ptr: slot, val: (*p_entry).ssa as SSAId }));
                                self.set_symbol_addr_ssa(s, slot);
                                return slot;
                            }
                        } else {
                            // Not a local variable. Check if this is a global (static mut).
                            // For globals, return the raw global address so that compound
                            // assignment operators can store back to the correct pointer.
                            let k_tag = s.kind_tag as u32;
                            if k_tag == SYM_GLOBAL {
                                let kind_payload = s.kind_payload as u32;
                                let p_decl: &Decl = &ast.decls[kind_payload as usize];
                                match *p_decl {
                                    Decl.Static(_) => {
                                        let glob_id = self.get_global_id_by_name(s.name);
                                        return self.emit(ILInstr.GlobalAddr(glob_id));
                                    },
                                    Decl.Fn(_) | Decl.Struct(_) | Decl.Enum(_) | Decl.Trait(_) |
                                    Decl.Impl(_) | Decl.TypeAlias(_) | Decl.Const(_) |
                                    Decl.Import(_) | Decl.None => {},
                                }
                            }
                            return NO_SSA as u32;
                        }
                    },
                    None => { return NO_SSA as u32; },
                }
            },
            Expr.Unary(u) => {
                match u.op {
                    UnaryOp.Deref => {
                        let res = self.lower_expr(u.expr);
                        return res;
                    },
                    UnaryOp.Neg | UnaryOp.Not | UnaryOp.Ref | UnaryOp.RefMut => { return NO_SSA as u32; },
                }
            },
            Expr.MemberAccess(m) => {
                let mut base = self.get_base_ptr_for_access(m.expr);
                if base == NO_SSA as u32 { return NO_SSA as u32; }
                let mut current_base = base;
                let mut current_ty = self.get_ssa_type(base);
                while true {
                    if current_ty == 0 as u32 { break; }
                    if current_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:664"); }
                    let p_ty_it: &ILTypeDecl = self.builder.get_type_decl(current_ty);

                    match (*p_ty_it).def {
                        ILType.Ptr(inner) | ILType.PtrMut(inner) | ILType.Boxed(inner) | ILType.BoxedMut(inner) => {
                             if inner == 0 as u32 { break; }
                             if inner == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:669"); }
                             let p_ty_inner: &ILTypeDecl = self.builder.get_type_decl(inner);
                             match (*p_ty_inner).def {
                                 ILType.Slice(_) | ILType.User(_) | ILType.Tuple(_) => {
                                     current_ty = inner;
                                     break;
                                 },
                                 ILType.Ptr(_) | ILType.PtrMut(_) => { /* fall through to load */ },
                                 ILType.Primitive(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                                 ILType.Array(_) | ILType.Fn(_) | ILType.FD(_) | ILType.IORing | ILType.Var(_) => { return NO_SSA as u32; },
                             }
                             current_base = self.emit_with_type(ILInstr.Load(current_base), inner);
                             current_ty = inner;
                        },
                        ILType.Primitive(_) | ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) |
                        ILType.FD(_) | ILType.IORing | ILType.User(_) | ILType.Var(_) => { break; },
                    }
                }

                let field_idx = self.get_field_index(current_ty, m.member);
                if field_idx != NO_SSA as u32 {
                    let field_ty = self.get_field_type(current_ty, field_idx);
                    let fa = self.emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: current_base, field_idx: field_idx }), self.get_ptr_type(field_ty));
                    // Auto-deref Box<T> fields: &struct.box_field should give &T, not &Box<T>
                    let fty_tag2 = self.get_type_tag(field_ty);
                    if fty_tag2 == ILTYPE_BOXED || fty_tag2 == ILTYPE_BOXEDMUT {
                        return self.emit_with_type(ILInstr.Load(fa), field_ty);
                    }
                    return fa;
                }
                return NO_SSA as u32;
            },
            Expr.TupleAccess(t) => {
                let current_base = self.get_base_ptr_for_access(t.expr);
                if current_base == NO_SSA as u32 { return NO_SSA as u32; }
                let mut base_ty = self.get_ssa_type(current_base);
                let inner = self.get_ptr_inner_type(base_ty);
                let mut current_ty = base_ty;
                if inner != 0 as u32 { current_ty = inner; }

                let field_idx = t.index as u32;
                let field_ty = self.get_field_type(current_ty, field_idx);
                let field_addr = self.emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: current_base, field_idx: field_idx }), self.get_ptr_type(field_ty));
                // Auto-deref Box<T> fields: &box_field should give &T, not &Box<T>
                let fty_tag = self.get_type_tag(field_ty);
                if fty_tag == ILTYPE_BOXED || fty_tag == ILTYPE_BOXEDMUT {
                    return self.emit_with_type(ILInstr.Load(field_addr), field_ty);
                }
                return field_addr;
            },
            Expr.Index(ix) => {
                let base = self.lower_expr(ix.expr);
                let idx = self.lower_expr(ix.index);
                let base_ty = self.get_ssa_type(base);
                
                if base_ty == 0 as u32 { return NO_SSA as u32; }
                if base_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:724"); }
                let p_ity: &ILTypeDecl = self.builder.get_type_decl(base_ty);

                let mut elem_ty = 0 as u32;
                let mut actual_base = base;
                match (*p_ity).def {
                    ILType.Array(a) => {
                        elem_ty = a.element;
                    },
                    ILType.Slice(s) => {
                        elem_ty = s.element;
                        let elem_ptr_ty = self.get_ptr_type(elem_ty);
                        actual_base = self.emit_with_type(ILInstr.Load(base), elem_ptr_ty);
                    },
                    ILType.Ptr(inner) | ILType.PtrMut(inner) | ILType.Boxed(inner) | ILType.BoxedMut(inner) => {
                        if inner == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:738"); }
                        let p_inner: &ILTypeDecl = self.builder.get_type_decl(inner);
                        match (*p_inner).def {
                            ILType.Array(a) => { elem_ty = a.element; },
                            ILType.Slice(s) => { 
                                elem_ty = s.element;
                                let elem_ptr_ty = self.get_ptr_type(elem_ty);
                                actual_base = self.emit_with_type(ILInstr.Load(base), elem_ptr_ty);
                            },
                            _ => { elem_ty = inner; }
                        }
                    },
                    ILType.Primitive(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) | ILType.IORing | ILType.User(_) | ILType.Var(_) => { return NO_SSA as u32; },
                }

                if elem_ty == 0 as u32 { return NO_SSA as u32; }
                let elem_size = self.get_type_size(elem_ty);
                let usize_ty = self.get_primitive_type(ILPrimitive.USize);
                let idx_l = self.emit_cast(idx, usize_ty);
                let size_ssa = self.emit_const_u64(elem_size, usize_ty);
                let offset = self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: idx_l, rhs: size_ssa }), usize_ty);
                let base_int = self.emit_cast(actual_base, usize_ty);
                let addr = self.emit_with_type(ILInstr.Add(ILBinaryOp { lhs: base_int, rhs: offset }), usize_ty);
                let elem_ptr_ty = self.get_ptr_type(elem_ty);
                return self.emit_cast(addr, elem_ptr_ty);
            },
            Expr.ArrayLiteral(_) | Expr.ArrayRepeat(_) => {
                // Inline array literals already allocate stack space and return a pointer.
                return self.lower_expr(expr_id);
            },
            Expr.Binary(_) | Expr.Call(_) | Expr.Generic(_) | Expr.Intrinsic(_) | Expr.Block(_) |
            Expr.If(_) | Expr.Match(_) | Expr.StructLiteral(_) | Expr.TupleAccess(_) | Expr.Boxed(_) |
            Expr.Cast(_) | Expr.TupleLiteral(_) |
            Expr.Closure(_) | Expr.Try(_) | Expr.Return(_) | Expr.Break | Expr.Continue |
            Expr.Sizeof(_) | Expr.Alignof(_) => { return NO_SSA as u32; },
        }
        return NO_SSA as u32;
    }

    pub fn lower_logical(self: &mut Lowerer, b: &BinaryExpr, is_and: bool) -> SSAId {
        let bool_ty = self.get_primitive_type(ILPrimitive.Bool);
        let lhs = self.lower_expr_with_expected(b.lhs, bool_ty);
        let const_val = if is_and { self.emit_const_u64(0 as u64, bool_ty) } else { self.emit_const_u64(1 as u64, bool_ty) };
        
        let base = self.scratch_stack_len;
        let second_block = self.new_block();
        let join_block = self.new_block();
        
        self.push_scratch(second_block as u64);
        self.push_scratch(join_block as u64);
        
        if is_and {
            self.emit(ILInstr.Branch(BranchInstr { cond: lhs, then_block: second_block, else_block: join_block }));
        } else {
            self.emit(ILInstr.Branch(BranchInstr { cond: lhs, then_block: join_block, else_block: second_block }));
        }
        
        let first_end = self.builder.current_block_idx;
        
        self.switch_to_block(second_block);
        let rhs = self.lower_expr_with_expected(b.rhs, bool_ty);
        let second_end = self.builder.current_block_idx;
        if !self.is_terminated() {
            self.emit(ILInstr.Jmp(join_block));
        }
        
        self.switch_to_block(join_block);
        
        // Build phi instruction
        let mut preds = zoril_allocator_alloc(self.arena, 2 * sizeof(PhiPred)) as *mut PhiPred;
        let mut count = 0 as usize;
        
        // incoming from first block
        if first_end != NO_BLOCK {
            let p = (preds as usize + count * sizeof(PhiPred)) as *mut PhiPred;
            (*p).block = first_end;
            (*p).val = const_val;
            count = count + 1 as usize;
        }
        
        // incoming from second block
        if second_end != NO_BLOCK {
            let p = (preds as usize + count * sizeof(PhiPred)) as *mut PhiPred;
            (*p).block = second_end;
            (*p).val = rhs;
            count = count + 1 as usize;
        }
        
        self.scratch_stack_len = base;
        
        if count == 0 as usize {
            return NO_SSA as u32;
        } else if count == 1 as usize {
            return (*preds).val;
        }
        
        return self.emit_with_type(ILInstr.Phi(PhiInstr { preds: @slice(preds, count) }), bool_ty);
    }

    fn lower_enum_cmp(self: &mut Lowerer, lhs: SSAId, rhs: SSAId, ty: u32, is_eq: bool) -> SSAId {
        let enum_inner_ty = if self.get_ptr_inner_type(ty) == 0 as u32 { ty } else { self.get_ptr_inner_type(ty) };
        if enum_inner_ty != 0 as u32 {
            if enum_inner_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:839"); }
            let p_et: &ILTypeDecl = self.builder.get_type_decl(enum_inner_ty);
            match (*p_et).def {
                ILType.User(u) => {
                    let p_td = &self.module.typedefs[u.id as usize];
                    match *p_td {
                        ILTypeDef.Enum(_) => {
                            let u32_ty = self.get_primitive_type(ILPrimitive.U32);
                            let lhs_tag = self.emit_with_type(ILInstr.Load(lhs), u32_ty);
                            let rhs_tag = self.emit_with_type(ILInstr.Load(rhs), u32_ty);
                            let bool_ty = self.get_primitive_type(ILPrimitive.Bool);
                            if is_eq {
                                return self.emit_with_type(ILInstr.CmpEq(ILBinaryOp { lhs: lhs_tag, rhs: rhs_tag }), bool_ty);
                            } else {
                                return self.emit_with_type(ILInstr.CmpNe(ILBinaryOp { lhs: lhs_tag, rhs: rhs_tag }), bool_ty);
                            }
                        },
                        ILTypeDef.Struct(_) | ILTypeDef.Fn(_) => {},
                    }
                },
                ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
                ILType.IORing | ILType.Var(_) => {},
            }
        }
        return NO_SSA as u32;
    }

    pub fn lower_binary(self: &mut Lowerer, b: &BinaryExpr) -> SSAId {
        let ast: &AST = self.resolver.ast;
        match b.op {
            BinaryOp.Assign => {
                let p_lhs: &Expr = &ast.exprs[b.lhs as usize];
                match *p_lhs {
                    Expr.Index(i_expr) => {
                        let base = self.lower_expr(i_expr.expr);
                        let idx = self.lower_expr(i_expr.index);
                        let base_ty = self.get_ssa_type(base);

                        if base_ty == 0 as u32 { return NO_SSA as u32; }

                        // Determine element type so the RHS literal gets the right type context
                        let mut elem_expected = 0 as u32;
                        if base_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:881"); }
                        let p_it0: &ILTypeDecl = self.builder.get_type_decl(base_ty);
                        match (*p_it0).def {
                            ILType.Array(a) => { elem_expected = a.element; },
                            ILType.Slice(s) => { elem_expected = s.element; },
                            ILType.Ptr(inner0) | ILType.PtrMut(inner0) => {
                                if inner0 == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:886"); }
                                let p_in0: &ILTypeDecl = self.builder.get_type_decl(inner0);
                                match (*p_in0).def {
                                    ILType.Array(a) => { elem_expected = a.element; },
                                    ILType.Slice(s) => { elem_expected = s.element; },
                                    ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) |
                                    ILType.Boxed(_) | ILType.BoxedMut(_) | ILType.Fn(_) |
                                    ILType.Tuple(_) | ILType.FD(_) | ILType.IORing |
                                    ILType.User(_) | ILType.Var(_) => {}
                                }
                            },
                            ILType.Primitive(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                            ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) | ILType.IORing |
                            ILType.User(_) | ILType.Var(_) => {}
                        }
                        let val = self.lower_expr_with_expected(b.rhs, elem_expected);

                        if base_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:902"); }
                        let p_it: &ILTypeDecl = self.builder.get_type_decl(base_ty);
                        match (*p_it).def {
                            ILType.Array(_) => {
                                self.emit(ILInstr.ArrayStore(IndexStoreInstr { base: base, idx: idx, val: val }));
                            },
                            ILType.Slice(_) => {
                                self.emit(ILInstr.SliceStore(IndexStoreInstr { base: base, idx: idx, val: val }));
                            },
                            ILType.Ptr(inner) | ILType.PtrMut(inner) => {
                                if inner == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:911"); }
                                let p_inner: &ILTypeDecl = self.builder.get_type_decl(inner);
                                match (*p_inner).def {
                                    ILType.Array(_) => {
                                        self.emit(ILInstr.ArrayStore(IndexStoreInstr { base: base, idx: idx, val: val }));
                                    },
                                    ILType.Slice(_) => {
                                        self.emit(ILInstr.SliceStore(IndexStoreInstr { base: base, idx: idx, val: val }));
                                    },
                                    _ => {
                                        self.emit(ILInstr.ArrayStore(IndexStoreInstr { base: base, idx: idx, val: val }));
                                    }
                                }
                            },
                            ILType.Primitive(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                            ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) | ILType.IORing | ILType.User(_) | ILType.Var(_) => {
                                ICE("lower_binary: index assign on non-array/slice/ptr");
                            },
                        }
                        return val;
                    },
                    Expr.Literal(_) | Expr.Ident(_) | Expr.Unary(_) | Expr.Binary(_) | Expr.Call(_) | Expr.Generic(_) |
                    Expr.Intrinsic(_) | Expr.Block(_) | Expr.If(_) | Expr.Match(_) | Expr.StructLiteral(_) |
                    Expr.MemberAccess(_) | Expr.TupleAccess(_) | Expr.Boxed(_) |
                    Expr.Cast(_) | Expr.ArrayLiteral(_) | Expr.ArrayRepeat(_) | Expr.TupleLiteral(_) |
                    Expr.Closure(_) | Expr.Try(_) | Expr.Return(_) | Expr.Break | Expr.Continue |
                    Expr.Sizeof(_) | Expr.Alignof(_) => {
                        let dest = self.get_base_ptr_for_access(b.lhs);
                        let dest_ty = self.get_ptr_inner_type(self.get_ssa_type(dest));
                        let val = self.lower_expr_with_expected(b.rhs, dest_ty);
                        let val_ty = self.get_ssa_type(val);
                        if dest_ty != 0 as u32 && val_ty != 0 as u32 && !self.types_match(dest_ty, val_ty) {
                            let span = &ast.expr_spans[b.rhs as usize];
                            must_write(2, self.file_path);
                            must_write(2, ":");
                            write_u64(2, span.line as u64);
                            must_write(2, ":");
                            write_u64(2, span.col as u64);
                            must_write(2, ": error: type mismatch: expected `");
                            must_write(2, self.mono.type_display(dest_ty));
                            must_write(2, "`, found `");
                            must_write(2, self.mono.type_display(val_ty));
                            must_write(2, "`\n");
                            self.had_error = true;
                        }
                        self.emit(ILInstr.Store(StoreInstr { ptr: dest, val: val }));
                        return val;
                    },
                }
            },
            BinaryOp.AddAssign | BinaryOp.SubAssign | BinaryOp.MulAssign | BinaryOp.DivAssign | BinaryOp.ModAssign | 
            BinaryOp.AddWrapAssign | BinaryOp.SubWrapAssign | BinaryOp.MulWrapAssign | 
            BinaryOp.BitAndAssign | BinaryOp.BitOrAssign | BinaryOp.BitXorAssign | 
            BinaryOp.ShlAssign | BinaryOp.ShrAssign => {
                let p_lhs: &Expr = &ast.exprs[b.lhs as usize];
                match *p_lhs {
                    Expr.Index(i_expr) => {
                        let base = self.lower_expr(i_expr.expr);
                        let idx = self.lower_expr(i_expr.index);
                        let rhs = self.lower_expr(b.rhs);
                        let base_ty = self.get_ssa_type(base);
                        
                        if base_ty == 0 as u32 { return NO_SSA as u32; }
                        if base_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:990"); }
                        let p_it: &ILTypeDecl = self.builder.get_type_decl(base_ty);
                        let mut lhs_val = NO_SSA as u32;
                        let mut res_ty = 0 as u32;
                        match (*p_it).def {
                            ILType.Array(a) => {
                                res_ty = a.element;
                                lhs_val = self.emit_with_type(ILInstr.ArrayLoad(IndexInstr { base: base, idx: idx }), res_ty);
                            },
                            ILType.Slice(s) => {
                                res_ty = s.element;
                                lhs_val = self.emit_with_type(ILInstr.SliceLoad(IndexInstr { base: base, idx: idx }), res_ty);
                            },
                            ILType.Ptr(inner) | ILType.PtrMut(inner) => {
                                if inner == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1003"); }
                                let p_inner: &ILTypeDecl = self.builder.get_type_decl(inner);
                                match (*p_inner).def {
                                    ILType.Array(a) => {
                                        res_ty = a.element;
                                        lhs_val = self.emit_with_type(ILInstr.ArrayLoad(IndexInstr { base: base, idx: idx }), res_ty);
                                    },
                                    ILType.Slice(s) => {
                                        res_ty = s.element;
                                        lhs_val = self.emit_with_type(ILInstr.SliceLoad(IndexInstr { base: base, idx: idx }), res_ty);
                                    },
                                    _ => {
                                        res_ty = inner;
                                        lhs_val = self.emit_with_type(ILInstr.ArrayLoad(IndexInstr { base: base, idx: idx }), res_ty);
                                    }
                                }
                            },
                            ILType.Primitive(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                            ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) | ILType.IORing | ILType.User(_) | ILType.Var(_) => {
                                ICE("lower_binary: index assign on non-array/slice/ptr");
                            },
                        }
                        let res = match b.op {
                            BinaryOp.AddAssign => self.emit_with_type(ILInstr.Add(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.SubAssign => self.emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.MulAssign => self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.DivAssign => self.emit_with_type(ILInstr.Div(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.ModAssign => self.emit_with_type(ILInstr.Rem(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.AddWrapAssign => { let r = self.emit_with_type(ILInstr.WrappingAdd(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty); self.emit_narrow_wrap_mask(r, res_ty) },
                            BinaryOp.SubWrapAssign => { let r = self.emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty); self.emit_narrow_wrap_mask(r, res_ty) },
                            BinaryOp.MulWrapAssign => { let r = self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty); self.emit_narrow_wrap_mask(r, res_ty) },
                            BinaryOp.BitAndAssign => self.emit_with_type(ILInstr.And(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.BitOrAssign => self.emit_with_type(ILInstr.Or(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.BitXorAssign => self.emit_with_type(ILInstr.Xor(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.ShlAssign => self.emit_with_type(ILInstr.Shl(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.ShrAssign => self.emit_with_type(ILInstr.Shr(ILBinaryOp { lhs: lhs_val, rhs: rhs }), res_ty),
                            BinaryOp.Add | BinaryOp.Sub | BinaryOp.Mul | BinaryOp.Div | BinaryOp.Mod |
                            BinaryOp.AddWrap | BinaryOp.SubWrap | BinaryOp.MulWrap |
                            BinaryOp.Eq | BinaryOp.Ne | BinaryOp.Lt | BinaryOp.Le | BinaryOp.Gt | BinaryOp.Ge |
                            BinaryOp.And | BinaryOp.Or | BinaryOp.Xor | BinaryOp.Shl | BinaryOp.Shr |
                            BinaryOp.LAnd | BinaryOp.LOr |
                            BinaryOp.Assign => { ICE("lower_binary: unhandled index assign op") },
                        };
                        match (*p_it).def {
                            ILType.Array(_) => {
                                self.emit(ILInstr.ArrayStore(IndexStoreInstr { base: base, idx: idx, val: res }));
                            },
                            ILType.Slice(_) => {
                                self.emit(ILInstr.SliceStore(IndexStoreInstr { base: base, idx: idx, val: res }));
                            },
                            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                            ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) | ILType.IORing | ILType.User(_) | ILType.Var(_) => {
                                ICE("lower_binary: index assign store on non-array/slice");
                            },
                        }
                        return res;
                    },
                    Expr.Literal(_) | Expr.Ident(_) | Expr.Unary(_) | Expr.Binary(_) | Expr.Call(_) | Expr.Generic(_) |
                    Expr.Intrinsic(_) | Expr.Block(_) | Expr.If(_) | Expr.Match(_) | Expr.StructLiteral(_) |
                    Expr.MemberAccess(_) | Expr.TupleAccess(_) | Expr.Boxed(_) |
                    Expr.Cast(_) | Expr.ArrayLiteral(_) | Expr.ArrayRepeat(_) | Expr.TupleLiteral(_) |
                    Expr.Closure(_) | Expr.Try(_) | Expr.Return(_) | Expr.Break | Expr.Continue |
                    Expr.Sizeof(_) | Expr.Alignof(_) => {
                        let dest = self.get_base_ptr_for_access(b.lhs);
                        let rhs = self.lower_expr(b.rhs);
                        let ty = self.get_ptr_inner_type(self.get_ssa_type(dest));
                        let lhs_val = self.emit_with_type(ILInstr.Load(dest), ty);
                        let res = match b.op {
                            BinaryOp.AddAssign => self.emit_with_type(ILInstr.Add(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.SubAssign => self.emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.MulAssign => self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.DivAssign => self.emit_with_type(ILInstr.Div(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.ModAssign => self.emit_with_type(ILInstr.Rem(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.AddWrapAssign => { let r = self.emit_with_type(ILInstr.WrappingAdd(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty); self.emit_narrow_wrap_mask(r, ty) },
                            BinaryOp.SubWrapAssign => { let r = self.emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty); self.emit_narrow_wrap_mask(r, ty) },
                            BinaryOp.MulWrapAssign => { let r = self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty); self.emit_narrow_wrap_mask(r, ty) },
                            BinaryOp.BitAndAssign => self.emit_with_type(ILInstr.And(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.BitOrAssign => self.emit_with_type(ILInstr.Or(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.BitXorAssign => self.emit_with_type(ILInstr.Xor(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.ShlAssign => self.emit_with_type(ILInstr.Shl(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.ShrAssign => self.emit_with_type(ILInstr.Shr(ILBinaryOp { lhs: lhs_val, rhs: rhs }), ty),
                            BinaryOp.Add | BinaryOp.Sub | BinaryOp.Mul | BinaryOp.Div | BinaryOp.Mod |
                            BinaryOp.AddWrap | BinaryOp.SubWrap | BinaryOp.MulWrap |
                            BinaryOp.Eq | BinaryOp.Ne | BinaryOp.Lt | BinaryOp.Le | BinaryOp.Gt | BinaryOp.Ge |
                            BinaryOp.And | BinaryOp.Or | BinaryOp.Xor | BinaryOp.Shl | BinaryOp.Shr |
                            BinaryOp.LAnd | BinaryOp.LOr |
                            BinaryOp.Assign => { ICE("lower_binary: unhandled assign op") },
                        };
                        self.emit(ILInstr.Store(StoreInstr { ptr: dest, val: res }));
                        return res;
                    },
                }
            },
            BinaryOp.LAnd => { return self.lower_logical(b, true); },
            BinaryOp.LOr => { return self.lower_logical(b, false); },
            BinaryOp.Add | BinaryOp.Sub | BinaryOp.Mul | BinaryOp.Div | BinaryOp.Mod |
            BinaryOp.AddWrap | BinaryOp.SubWrap | BinaryOp.MulWrap |
            BinaryOp.Eq | BinaryOp.Ne | BinaryOp.Lt | BinaryOp.Le | BinaryOp.Gt | BinaryOp.Ge |
            BinaryOp.And | BinaryOp.Or | BinaryOp.Xor | BinaryOp.Shl | BinaryOp.Shr => {
                let mut lhs = self.lower_expr(b.lhs);
                let mut rhs = self.lower_expr(b.rhs);
                let mut ty = self.get_ssa_type(lhs);
                let rhs_ty = self.get_ssa_type(rhs);
                if ty != rhs_ty {
                    if self.get_type_size(rhs_ty) > self.get_type_size(ty) {
                        ty = rhs_ty;
                        lhs = self.coerce_to(lhs, ty);
                    } else {
                        rhs = self.coerce_to(rhs, ty);
                    }
                }
                match b.op {
                    BinaryOp.Add => {
                        let lhs_tag = self.get_type_tag(ty);
                        let rhs_tag = self.get_type_tag(rhs_ty);
                        if lhs_tag == ILTYPE_PTR || lhs_tag == ILTYPE_PTRMUT || lhs_tag == ILTYPE_BOXED || lhs_tag == ILTYPE_BOXEDMUT {
                             let inner = self.get_ptr_inner_type(ty);
                             let sz = self.get_type_size(inner);
                             let usize_ty = self.get_primitive_type(ILPrimitive.USize);
                             let sz_val = self.emit_const_u64(sz, usize_ty);
                             let scaled_rhs = self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: rhs, rhs: sz_val }), usize_ty);
                             return self.emit_with_type(ILInstr.Add(ILBinaryOp { lhs: lhs, rhs: scaled_rhs }), ty);
                        } else if rhs_tag == ILTYPE_PTR || rhs_tag == ILTYPE_PTRMUT || rhs_tag == ILTYPE_BOXED || rhs_tag == ILTYPE_BOXEDMUT {
                             let inner = self.get_ptr_inner_type(rhs_ty);
                             let sz = self.get_type_size(inner);
                             let usize_ty = self.get_primitive_type(ILPrimitive.USize);
                             let sz_val = self.emit_const_u64(sz, usize_ty);
                             let scaled_lhs = self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs, rhs: sz_val }), usize_ty);
                             return self.emit_with_type(ILInstr.Add(ILBinaryOp { lhs: scaled_lhs, rhs: rhs }), rhs_ty);
                        }
                        return self.emit_with_type(ILInstr.Add(ILBinaryOp { lhs: lhs, rhs: rhs }), ty);
                    },
                    BinaryOp.Sub => {
                        let lhs_tag = self.get_type_tag(ty);
                        let rhs_tag = self.get_type_tag(rhs_ty);
                        if lhs_tag == ILTYPE_PTR || lhs_tag == ILTYPE_PTRMUT || lhs_tag == ILTYPE_BOXED || lhs_tag == ILTYPE_BOXEDMUT {
                            if rhs_tag == ILTYPE_PTR || rhs_tag == ILTYPE_PTRMUT || rhs_tag == ILTYPE_BOXED || rhs_tag == ILTYPE_BOXEDMUT {
                                // ptr - ptr => isize
                                let inner = self.get_ptr_inner_type(ty);
                                let sz = self.get_type_size(inner);
                                let isize_ty = self.get_primitive_type(ILPrimitive.ISize);
                                let diff = self.emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs, rhs: rhs }), isize_ty);
                                let sz_val = self.emit_const_u64(sz, isize_ty);
                                return self.emit_with_type(ILInstr.Div(ILBinaryOp { lhs: diff, rhs: sz_val }), isize_ty);
                            }
                            // ptr - offset
                            let inner = self.get_ptr_inner_type(ty);
                            let sz = self.get_type_size(inner);
                            let usize_ty = self.get_primitive_type(ILPrimitive.USize);
                            let sz_val = self.emit_const_u64(sz, usize_ty);
                            let scaled_rhs = self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: rhs, rhs: sz_val }), usize_ty);
                            return self.emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs, rhs: scaled_rhs }), ty);
                        }
                        return self.emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs, rhs: rhs }), ty);
                    },
                    BinaryOp.Mul => { return self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); },
                    BinaryOp.Div => { return self.emit_with_type(ILInstr.Div(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); },
                    BinaryOp.Mod => { return self.emit_with_type(ILInstr.Rem(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); },
                    BinaryOp.AddWrap => { let r = self.emit_with_type(ILInstr.WrappingAdd(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); return self.emit_narrow_wrap_mask(r, ty); },
                    BinaryOp.SubWrap => { let r = self.emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); return self.emit_narrow_wrap_mask(r, ty); },
                    BinaryOp.MulWrap => { let r = self.emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); return self.emit_narrow_wrap_mask(r, ty); },
                    BinaryOp.Eq => {
                        let cmp_ssa = self.lower_enum_cmp(lhs, rhs, ty, true);
                        if cmp_ssa != NO_SSA as u32 { return cmp_ssa; }
                        return self.emit_with_type(ILInstr.CmpEq(ILBinaryOp { lhs: lhs, rhs: rhs }), self.get_primitive_type(ILPrimitive.Bool));
                    },
                    BinaryOp.Ne => {
                        let cmp_ssa = self.lower_enum_cmp(lhs, rhs, ty, false);
                        if cmp_ssa != NO_SSA as u32 { return cmp_ssa; }
                        return self.emit_with_type(ILInstr.CmpNe(ILBinaryOp { lhs: lhs, rhs: rhs }), self.get_primitive_type(ILPrimitive.Bool));
                    },
                    BinaryOp.Lt => { return self.emit_with_type(ILInstr.CmpLt(ILBinaryOp { lhs: lhs, rhs: rhs }), self.get_primitive_type(ILPrimitive.Bool)); },
                    BinaryOp.Le => { return self.emit_with_type(ILInstr.CmpLe(ILBinaryOp { lhs: lhs, rhs: rhs }), self.get_primitive_type(ILPrimitive.Bool)); },
                    BinaryOp.Gt => { return self.emit_with_type(ILInstr.CmpGt(ILBinaryOp { lhs: lhs, rhs: rhs }), self.get_primitive_type(ILPrimitive.Bool)); },
                    BinaryOp.Ge => { return self.emit_with_type(ILInstr.CmpGe(ILBinaryOp { lhs: lhs, rhs: rhs }), self.get_primitive_type(ILPrimitive.Bool)); },
                    BinaryOp.And => { return self.emit_with_type(ILInstr.And(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); },
                    BinaryOp.Or => { return self.emit_with_type(ILInstr.Or(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); },
                    BinaryOp.Xor => { return self.emit_with_type(ILInstr.Xor(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); },
                    BinaryOp.Shl => { return self.emit_with_type(ILInstr.Shl(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); },
                    BinaryOp.Shr => { return self.emit_with_type(ILInstr.Shr(ILBinaryOp { lhs: lhs, rhs: rhs }), ty); },
                    BinaryOp.Assign |
                    BinaryOp.AddAssign | BinaryOp.SubAssign | BinaryOp.MulAssign | BinaryOp.DivAssign | BinaryOp.ModAssign |
                    BinaryOp.AddWrapAssign | BinaryOp.SubWrapAssign | BinaryOp.MulWrapAssign |
                    BinaryOp.BitAndAssign | BinaryOp.BitOrAssign | BinaryOp.BitXorAssign |
                    BinaryOp.ShlAssign | BinaryOp.ShrAssign |
                    BinaryOp.LAnd | BinaryOp.LOr => { return NO_SSA as u32; },
                }
            },
        }
    }

    fn lower_static_method_access(self: &mut Lowerer, resolved_ty: u32, member_name: u32) -> SSAId {
        let opt_method_idx = self.find_method_in_impls(resolved_ty, member_name);
        match opt_method_idx {
            Some(decl_idx) => {
                let ast: &AST = self.resolver.ast;
                let p_impl_decl: &Decl = &ast.decls[decl_idx as usize];
                let imp: &ImplDecl = (*p_impl_decl).get_Impl();
                let mut jk = 0 as usize;
                while jk < (*imp).methods.len {
                    if (*imp).methods[jk].name == member_name {
                        if resolved_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1163"); }
                        let p_ty: &ILTypeDecl = self.builder.get_type_decl(resolved_ty);
                        let func_idx = self.mono.instantiate_method(&(*imp).methods[jk], @slice(0 as *mut u32, 0 as usize), (*p_ty).name, member_name, imp, resolved_ty);
                        let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                        let fn_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Fn(ILFn { params: @slice(0 as *mut u32, 0 as usize), ret_ty: (*p_func).ret_ty, is_variadic: (*p_func).is_variadic }) });
                        return self.emit_with_type(ILInstr.FuncAddr((*p_func).id), self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Ptr(fn_ty) }));
                    }
                    jk = jk + 1 as usize;
                }
            },
            None => {},
        }
        return NO_SSA as u32;
    }

    fn lower_static_const_access(self: &mut Lowerer, resolved_ty: u32, member_name: u32) -> SSAId {
        let opt_const_idx = self.find_const_in_impls(resolved_ty, member_name);
        match opt_const_idx {
            Some(decl_idx) => {
                let ast: &AST = self.resolver.ast;
                let p_impl_decl: &Decl = &ast.decls[decl_idx as usize];
                let imp: &ImplDecl = (*p_impl_decl).get_Impl();
                let mut jk = 0 as usize;
                while jk < (*imp).constants.len {
                    if (*imp).constants[jk].name == member_name {
                        let const_ty = self.resolver.resolve_type((*imp).constants[jk].ty);
                        return self.lower_expr_with_expected((*imp).constants[jk].value, const_ty);
                    }
                    jk = jk + 1 as usize;
                }
            },
            None => {},
        }
        return NO_SSA as u32;
    }

    pub fn lower_member_access(self: &mut Lowerer, m: &MemberAccessExpr, expected: u32) -> SSAId {
        // Check if it's an enum variant or static method on a type name (e.g. Color.Red, Vector.dot)
        let ast: &AST = self.resolver.ast;
        let p_base_expr: &Expr = &ast.exprs[m.expr as usize];
        match *p_base_expr {
            Expr.Ident(id) => {
                let opt_sym = self.resolver.resolve_ptr(id);
                match opt_sym {
                    Some(s) => {
                        let k_tag = s.kind_tag as u32;
                        if k_tag == SYM_GLOBAL || k_tag == SYM_TYPE || k_tag == SYM_PRIMITIVE {
                            let mut resolved_ty = self.resolve_sym_type(s);
                            if resolved_ty == 0 as u32 { return NO_SSA as u32; }

                            if expected != 0 as u32 {
                                if resolved_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1211"); }
                                let p_ty: &ILTypeDecl = self.builder.get_type_decl(resolved_ty);
                                if expected == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1212"); }
                                let expected_p_ty: &ILTypeDecl = self.builder.get_type_decl(expected);
                                if (*p_ty).def.get_tag() == ILTYPE_USER && (*expected_p_ty).def.get_tag() == ILTYPE_USER {
                                    let u_ty = (*p_ty).def.get_User();
                                    let u_exp = (*expected_p_ty).def.get_User();
                                    if u_ty.id == u_exp.id {
                                        resolved_ty = expected;
                                    }
                                }
                            }

                            if resolved_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1222"); }
                            let p_ty: &ILTypeDecl = self.builder.get_type_decl(resolved_ty);

                            // 1. Try Enum variants if it's a User type
                            match (*p_ty).def {
                                ILType.User(u) => {
                                    let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                                    match *p_def {
                                        ILTypeDef.Enum(e) => {
                                            let mut v_idx = 0 as usize;
                                            while v_idx < e.variants.len {
                                                let p_var: &ILVariant = &e.variants[v_idx];
                                                if p_var.name == m.member {
                                                    return self.emit_with_type(ILInstr.SumConstruct(SumConstructInstr { type_id: resolved_ty, variant_idx: v_idx as u32, payload: NO_SSA as u32 }), resolved_ty);
                                                }
                                                v_idx = v_idx + 1 as usize;
                                            }
                                        },
                                        ILTypeDef.Struct(_) | ILTypeDef.Fn(_) => {},
                                    }
                                },
                                ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                                ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
                                ILType.IORing | ILType.Var(_) => {},
                            }

                            // 2. Try static methods
                            let sm_ssa = self.lower_static_method_access(resolved_ty, m.member);
                            if sm_ssa != NO_SSA as u32 { return sm_ssa; }

                            // 3. Try static constants
                            let sc_ssa = self.lower_static_const_access(resolved_ty, m.member);
                            if sc_ssa != NO_SSA as u32 { return sc_ssa; }
                        }
                    },
                    None => {},
                }
            },
            Expr.Literal(_) | Expr.Unary(_) | Expr.Binary(_) | Expr.Call(_) | Expr.Generic(_) |
            Expr.Intrinsic(_) | Expr.Block(_) | Expr.If(_) | Expr.Match(_) | Expr.StructLiteral(_) |
            Expr.MemberAccess(_) | Expr.TupleAccess(_) | Expr.Index(_) | Expr.Boxed(_) |
            Expr.Cast(_) | Expr.ArrayLiteral(_) | Expr.ArrayRepeat(_) | Expr.TupleLiteral(_) |
            Expr.Closure(_) | Expr.Try(_) | Expr.Return(_) | Expr.Break | Expr.Continue |
            Expr.Sizeof(_) | Expr.Alignof(_) => {},
        }

        let base = self.get_base_ptr_for_access(m.expr);
        let base_ty = self.get_ssa_type(base);
        let inner_ty = self.get_ptr_inner_type(base_ty);

        let mut current_base = base;
        let mut current_ty = base_ty;
        
        while true {
            if current_ty == 0 as u32 { break; }
            if current_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1276"); }
            let p_ty_it: &ILTypeDecl = self.builder.get_type_decl(current_ty);

            match (*p_ty_it).def {
                ILType.Ptr(inner) | ILType.PtrMut(inner) | ILType.Boxed(inner) | ILType.BoxedMut(inner) => {
                    if inner == 0 as u32 { break; }
                    if inner == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1281"); }
                    let p_ty_inner: &ILTypeDecl = self.builder.get_type_decl(inner);
                    match (*p_ty_inner).def {
                        ILType.Slice(_) | ILType.User(_) | ILType.Tuple(_) => {
                            current_ty = inner;
                            break;
                        },
                        ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                        ILType.Array(_) | ILType.Fn(_) | ILType.FD(_) | ILType.IORing | ILType.Var(_) => {},
                    }
                    current_base = self.emit_with_type(ILInstr.Load(current_base), inner);
                    current_ty = inner;
                },
                ILType.Primitive(_) | ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) |
                ILType.FD(_) | ILType.IORing | ILType.User(_) | ILType.Var(_) => { break; },
            }
        }
        let field_idx = self.get_field_index(current_ty, m.member);
        if field_idx != NO_SSA as u32 {
            let field_ty = self.get_field_type(current_ty, field_idx);
            let addr = self.emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: current_base, field_idx: field_idx }), self.get_ptr_type(field_ty));

            if self.is_aggregate(field_ty) {
                return addr;
            }
            return self.emit_with_type(ILInstr.Load(addr), field_ty);
        }
        
        // 3. Check if it's an enum variant on a value (e.g. self.V1)
        if current_ty != 0 as u32 {
            if current_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1310"); }
            let p_ty: &ILTypeDecl = self.builder.get_type_decl(current_ty);
            match (*p_ty).def {
                ILType.User(u) => {
                    let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                    match *p_def {
                        ILTypeDef.Enum(e) => {
                            let mut v_idx = 0 as usize;
                            while v_idx < e.variants.len {
                                let p_var: &ILVariant = &e.variants[v_idx];
                                if p_var.name == m.member {
                                    return self.emit_with_type(ILInstr.SumConstruct(SumConstructInstr { type_id: current_ty, variant_idx: v_idx as u32, payload: NO_SSA as u32 }), current_ty);
                                }
                                v_idx = v_idx + 1 as usize;
                            }
                        },
                        ILTypeDef.Struct(_) | ILTypeDef.Fn(_) => {},
                    }
                },
                ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
                ILType.IORing | ILType.Var(_) => {},
            }
        }
        return NO_SSA as u32;
    }

    pub fn get_base_ptr_for_access(self: &mut Lowerer, expr_id: ExprId) -> SSAId {
        let ssa = self.lower_address_of(expr_id, false);
        if ssa != NO_SSA as u32 { return ssa; }
        return self.lower_expr(expr_id);
    }

    pub fn coerce_to(self: &mut Lowerer, val: SSAId, target_ty: u32) -> SSAId {
        let from_ty = self.get_ssa_type(val);
        if from_ty == target_ty { return val; }
        return self.emit_cast(val, target_ty);
    }

    pub fn emit_cast(self: &mut Lowerer, val: SSAId, target_ty: u32) -> SSAId {
        return self.builder.emit_cast(val, target_ty);
    }

    pub fn is_terminated(self: &mut Lowerer) -> bool {
        return self.builder.is_terminated();
    }

    pub fn emit_call_helper(self: &mut Lowerer, func_id: u32, func_ptr: SSAId, args_ptr: *mut SSAId, args_len: usize, ret_ty: u32, env_ssa: SSAId) -> SSAId {
        let is_sret = self.requires_pass_by_ref(ret_ty);
        
        let mut needs_env = false;
        if func_id != NO_SSA as u32 {
            let p_func: &ILFunction = &self.module.functions[func_id as usize];
            needs_env = self.needs_env_ptr((*p_func).is_extern, (*p_func).name);
        } else if func_ptr != NO_SSA as u32 {
            needs_env = true; // All function pointers are closures in Zoril
        }
        
        let mut extra_args = 0 as usize;
        if is_sret { extra_args = extra_args + 1 as usize; }
        if needs_env { extra_args = extra_args + 1 as usize; }

        let total_args = args_len + extra_args;
        let total_size = total_args * 4 as usize;
        let mut actual_args_ptr = zoril_allocator_alloc(self.arena, total_size) as *mut SSAId;

        let mut k = 0 as usize;
        while k < args_len {
            let k_off = k * 4 as usize;
            let mut arg = *((args_ptr as usize + k_off) as *mut SSAId);
            let arg_ty = self.get_ssa_type(arg);
            if self.is_aggregate(arg_ty) {
                // Aggregate value in SSA - needs to be moved to memory to get a pointer
                let slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: arg_ty, allocator: NO_SSA as u32 }), self.get_ptr_type(arg_ty));
                self.emit(ILInstr.Store(StoreInstr { ptr: slot, val: arg }));
                arg = slot;
            }
            
            // Cast to target parameter type if known
            if func_id != NO_SSA as u32 {
                let p_func: &ILFunction = &self.module.functions[func_id as usize];
                let mut param_idx = k + extra_args;
                if param_idx < p_func.params_len {
                    let p_param = &@slice(p_func.params, p_func.params_len)[param_idx];
                    let target_ty = p_param.ty;
                    if target_ty != 0 as u32 && arg != NO_SSA as u32 {
                        let arg_ty = self.get_ssa_type(arg);
                        if self.is_ptr_to_non_ptr_mismatch(target_ty, arg_ty) || self.is_ptr_depth_mismatch(target_ty, arg_ty) {
                            must_write(2, self.file_path);
                            must_write(2, ": error: type mismatch: pointer type depth mismatch\n");
                            self.had_error = true;
                        }
                        // Coerce &[T;N] (PTR_to_Array) → &[T] (PTR_to_Slice)
                        if arg_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1404"); }
                        let p_arg_ty: &ILTypeDecl = self.builder.get_type_decl(arg_ty);
                        if target_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1405"); }
                        let p_tgt_ty: &ILTypeDecl = self.builder.get_type_decl(target_ty);
                        let arg_tag = (*p_arg_ty).def.get_tag();
                        let tgt_tag = (*p_tgt_ty).def.get_tag();
                        if (arg_tag == ILTYPE_PTR || arg_tag == ILTYPE_PTRMUT) && (tgt_tag == ILTYPE_PTR || tgt_tag == ILTYPE_PTRMUT) {
                            let inner_arg_ty = (*p_arg_ty).def.get_Ptr();
                            let inner_tgt_ty = (*p_tgt_ty).def.get_Ptr();
                            if inner_arg_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1411"); }
                            let p_inner_arg: &ILTypeDecl = self.builder.get_type_decl(inner_arg_ty);
                            if inner_tgt_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1412"); }
                            let p_inner_tgt: &ILTypeDecl = self.builder.get_type_decl(inner_tgt_ty);
                            if (*p_inner_arg).def.get_tag() == ILTYPE_ARRAY && (*p_inner_tgt).def.get_tag() == ILTYPE_SLICE {
                                let arr_info = (*p_inner_arg).def.get_Array();
                                let arr_len = arr_info.size as u64;
                                let usize_ty = self.get_primitive_type(ILPrimitive.USize);
                                let len_ssa = self.emit_const_u64(arr_len, usize_ty);
                                arg = self.emit_with_type(ILInstr.SliceConstruct(SliceConstructInstr { ptr: arg, len: len_ssa }), target_ty);
                            } else {
                                arg = self.emit_cast(arg, target_ty);
                            }
                        } else {
                            arg = self.emit_cast(arg, target_ty);
                        }
                    }
                }
            } else if func_ptr != NO_SSA as u32 {
                let mut curr_ty = self.get_ssa_type(func_ptr);
                let mut fn_decl_id: u32 = 0 as u32;
                while true {
                    if curr_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1431"); }
                    let p_ty: &ILTypeDecl = self.builder.get_type_decl(curr_ty);
                    let tag = (*p_ty).def.get_tag();
                    if tag == ILTYPE_FN { 
                        fn_decl_id = curr_ty;
                        break;
                    }
                    if tag >= ILTYPE_PTR && tag <= ILTYPE_BOXEDMUT {
                        curr_ty = (*p_ty).def.get_Ptr();
                    } else {
                        break;
                    }
                }
                
                if fn_decl_id != 0 as u32 {
                    let fn_d: &ILFn = self.builder.get_type_decl(fn_decl_id).def.get_Fn();
                    let mut param_idx = k + extra_args;
                    if param_idx < fn_d.params.len {
                        let target_ty = fn_d.params[param_idx];
                        if target_ty != 0 as u32 {
                            let arg_ty = self.get_ssa_type(arg);
                            if self.is_ptr_to_non_ptr_mismatch(target_ty, arg_ty) || self.is_ptr_depth_mismatch(target_ty, arg_ty) {
                                must_write(2, self.file_path);
                                must_write(2, ": error: type mismatch: pointer type depth mismatch\n");
                                self.had_error = true;
                            }
                            arg = self.emit_cast(arg, target_ty);
                        }
                    }
                }
            }

            let off = (k + extra_args) * 4;
            *((actual_args_ptr as usize + off) as *mut SSAId) = arg;
            k = k + 1 as usize;
        }

        let mut actual_args_len = 0 as usize;
        let mut sret_slot = NO_SSA as u32;
        if is_sret {
            sret_slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: ret_ty, allocator: NO_SSA as u32 }), self.get_ptr_type(ret_ty));
            let sret_off = actual_args_len * 4;
            let p_arg = (actual_args_ptr as usize + sret_off) as *mut SSAId;
            *p_arg = sret_slot;
            actual_args_len = actual_args_len + 1 as usize;
        }

        if needs_env {
            let env_val = if env_ssa != NO_SSA as u32 { env_ssa } else { self.emit_const_u64(0 as u64, self.get_ptr_type(self.get_primitive_type(ILPrimitive.Unit))) };
            let env_off = actual_args_len * 4;
            let p_arg = (actual_args_ptr as usize + env_off) as *mut SSAId;
            *p_arg = env_val;
            actual_args_len = actual_args_len + 1 as usize;
        }
        actual_args_len = actual_args_len + args_len;

        let actual_args = @slice(actual_args_ptr, actual_args_len);
        let mut actual_ret_ty = if is_sret { self.get_primitive_type(ILPrimitive.Unit) } else { ret_ty };
        
        let mut ssa = NO_SSA as u32;
        if func_ptr != NO_SSA as u32 {
            let mut cp_instr = CallPtrInstr { args: actual_args, func_ptr: func_ptr, env_ssa: env_ssa };
            ssa = self.emit_with_type(ILInstr.CallPtr(cp_instr), actual_ret_ty);
        } else {
            let p_func: &ILFunction = &self.module.functions[func_id as usize];
            let mut call_instr = CallInstr { args: actual_args, name_id: (*p_func).name, is_extern: (*p_func).is_extern };
            ssa = self.emit_with_type(ILInstr.Call(call_instr), actual_ret_ty);
        }

        if is_sret {
            return self.emit_cast(sret_slot, ret_ty);
        }
        return ssa;
    }

    pub fn find_const_in_impls(self: &mut Lowerer, ty_id: u32, const_name: u32) -> Option<u32> {
        if ty_id == 0 as u32 { return Option.None; }
        if ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1506"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);

        let mut struct_name_id = (*p_ty).name;
        let ast: &AST = self.resolver.ast;
        
        let mut i = 0 as usize;
        while i < ast.decls.len {
            let p_decl: &Decl = &ast.decls[i];
            if (*p_decl).get_tag() == DECL_IMPL {
                let imp: &ImplDecl = (*p_decl).get_Impl();
                if imp.trait_name == 0 as u32 {
                    let mut target_name = 0 as u32;
                    let p_target_ty: &Type = &ast.types[imp.target_ty as usize];
                    let t_tag = (*p_target_ty).get_tag();
                    if t_tag == TYPE_PATH {
                        target_name = (*p_target_ty).get_Path().0;
                    } else if t_tag >= TYPE_PTR && t_tag <= TYPE_REFMUT {
                         let inner = (*p_target_ty).get_Ptr();
                        let p_inner: &Type = &ast.types[inner as usize];
                         if (*p_inner).get_tag() == TYPE_PATH { target_name = (*p_inner).get_Path().0; }
                    }
                    
                    if target_name == struct_name_id {
                        let mut k = 0 as usize;
                        while k < imp.constants.len {
                            if imp.constants[k].name == const_name {
                                return Option.Some(i as u32);
                            }
                            k = k + 1 as usize;
                        }
                    }
                }
            }
            i = i + 1 as usize;
        }
        return Option.None;
    }

    pub fn find_method_in_impls(self: &mut Lowerer, ty_id: u32, method_name: u32) -> Option<u32> {
        if ty_id == 0 as u32 { return Option.None; }

        if ty_id == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:1548"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);
        let struct_name_id = (*p_ty).name;
        let ast: &AST = self.resolver.ast;

        let mut i = 0 as usize;
        while i < ast.decls.len {
            let p_decl: &Decl = &ast.decls[i];
            if (*p_decl).get_tag() == DECL_IMPL {
                let imp: &ImplDecl = (*p_decl).get_Impl();
                let p_target_ty: &Type = &ast.types[imp.target_ty as usize];

                let t_tag = (*p_target_ty).get_tag();
                let mut target_name = 0 as u32;
                let mut matched = false;

                if t_tag == TYPE_PATH {
                    target_name = (*p_target_ty).get_Path().0;
                } else if t_tag >= TYPE_PTR && t_tag <= TYPE_REFMUT {
                    let inner = (*p_target_ty).get_Ptr();
                    let p_inner: &Type = &ast.types[inner as usize];
                    let inner_tag = (*p_inner).get_tag();
                    if inner_tag == TYPE_PATH {
                        target_name = (*p_inner).get_Path().0;
                    } else if inner_tag == TYPE_PRIMITIVE {
                        let prim_tag = (*p_inner).get_Primitive().get_tag();
                        let prim_ty_id = unsafe { *((self.resolver.primitives as usize + prim_tag as usize * 4) as *mut u32) };
                        if prim_ty_id == ty_id { matched = true; }
                    }
                } else if t_tag == TYPE_PRIMITIVE {
                    let prim_tag = (*p_target_ty).get_Primitive().get_tag();
                    let prim_ty_id = unsafe { *((self.resolver.primitives as usize + prim_tag as usize * 4) as *mut u32) };
                    if prim_ty_id == ty_id { matched = true; }
                }

                if target_name != 0 as u32 {
                    if target_name == struct_name_id {
                        matched = true;
                    } else if struct_name_id != 0 as u32 {
                        let target_str = self.intern_table.lookup(target_name);
                        let struct_str = self.intern_table.lookup(struct_name_id);
                        if struct_str.len >= target_str.len {
                            let mut prefix_match = true;
                            let mut pi = 0 as usize;
                            while pi < target_str.len {
                                if struct_str[pi] != target_str[pi] {
                                    prefix_match = false;
                                    break;
                                }
                                pi = pi + 1 as usize;
                            }
                            if prefix_match && (struct_str.len == target_str.len || struct_str[target_str.len] == '_' as u8) {
                                matched = true;
                            }
                        }
                    }
                }

                if matched {
                    let mut k = 0 as usize;
                    while k < imp.methods.len {
                        if imp.methods[k].name == method_name {
                            return Option.Some(i as u32);
                        }
                        k = k + 1 as usize;
                    }
                }
            }
            i = i + 1 as usize;
        }
        return Option.None;
    }

    pub fn get_global_id_by_name(self: &mut Lowerer, name: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.module.globals.len {
            let p_glob: &ILGlobal = &self.module.globals[i];
            if p_glob.name == name { return i as u32; }
            i = i + 1 as usize;
        }
        ICE("get_global_id_by_name: global not found");
        return 0 as u32;
    }

    pub fn extract_const_u64(self: &mut Lowerer, expr_id: ExprId) -> u64 {
        return self.extract_const_u64_depth(expr_id, 0 as usize);
    }

    fn extract_const_u64_depth(self: &mut Lowerer, expr_id: ExprId, depth: usize) -> u64 {
        if expr_id == 0 as ExprId { return 0 as u64; }
        let ast: &AST = self.resolver.ast;
        let p_expr: &Expr = &ast.exprs[expr_id as usize];
        let tag = (*p_expr).get_tag();
        if depth > 256 as usize && tag == EXPR_IDENT {
            // Only a const reaching itself through other consts can recurse without bound.
            let name = self.resolver.intern_table.lookup((*p_expr).get_Ident());
            self.report_error_concat("constant definition is cyclic: ", name, ast.expr_spans[expr_id as usize]);
            must_write(2, "\n");
            return 0 as u64;
        }
        if tag == EXPR_LITERAL {
            match *p_expr {
                Expr.Literal(lit) => {
                    match lit {
                        Literal.Int(v) => { return v.0 as u64; },
                        Literal.Bool(v) => { if v { return 1 as u64; } else { return 0 as u64; } },
                        _ => { ICE("extract_const_u64: unhandled literal type"); },
                    }
                },
                _ => { ICE("extract_const_u64: EXPR_LITERAL tag but non-Literal expr variant"); },
            }
        }
        if tag == EXPR_CAST {
            let c = (*p_expr).get_Cast();
            return self.extract_const_u64_depth(c.expr, depth + 1 as usize);
        }
        if tag == EXPR_UNARY {
            let u = (*p_expr).get_Unary();
            let inner = self.extract_const_u64_depth(u.expr, depth + 1 as usize);
            if u.op.get_tag() == 0 as u32 { // UnaryOp.Neg
                return (0 as u64) - inner;
            }
            return inner;
        }
        if tag == EXPR_INTRINSIC {
            let i = (*p_expr).get_Intrinsic();
            let name = self.resolver.intern_table.lookup(i.name);
            if is_str_eq(name, "ptr_cast") {
                return self.extract_const_u64_depth(i.args[0], depth + 1 as usize);
            }
        }
        if tag == EXPR_BINARY {
            let b = (*p_expr).get_Binary();
            let lv = self.extract_const_u64_depth(b.lhs, depth + 1 as usize);
            let rv = self.extract_const_u64_depth(b.rhs, depth + 1 as usize);
            let op = b.op.get_tag();
            if op == BINARY_ADD { return lv + rv; }
            if op == BINARY_SUB { return lv - rv; }
            if op == BINARY_MUL { return lv * rv; }
            if op == BINARY_DIV { if rv == 0 as u64 { return 0 as u64; } return lv / rv; }
            if op == BINARY_MOD { if rv == 0 as u64 { return 0 as u64; } return lv % rv; }
            if op == BINARY_AND { return lv & rv; }
            if op == BINARY_OR  { return lv | rv; }
            if op == BINARY_XOR { return lv ^ rv; }
            if op == BINARY_SHL { return lv << rv; }
            if op == BINARY_SHR { return lv >> rv; }
            ICE("extract_const_u64: unsupported binary op");
        }
        if tag == EXPR_IDENT {
            let name = (*p_expr).get_Ident();
            // Search AST declarations for a matching const
            let decls = ast.decls.as_slice();
            let mut i = 0 as usize;
            while i < decls.len {
                let p_decl = &decls[i];
                if p_decl.get_tag() == DECL_CONST {
                    let cd = p_decl.get_Const();
                    if cd.name == name {
                        return self.extract_const_u64_depth(cd.value, depth + 1 as usize);
                    }
                }
                i = i + 1 as usize;
            }
            ICE("extract_const_u64: constant not found");
        }
        ICE("extract_const_u64: unsupported expression kind");
        return 0 as u64;
    }

    pub fn is_copy_type(self: &mut Lowerer, type_id: u32) -> bool {
        return self.is_copy_type_internal(type_id, 0 as usize);
    }

    fn lookup_closure_env(self: &mut Lowerer, func_ssa: SSAId) -> SSAId {
        let mut i = 0 as usize;
        while i < self.cap_table_len {
            if *((self.cap_func_ssas as usize + i * sizeof(SSAId)) as *mut SSAId) == func_ssa {
                return *((self.cap_env_ptrs as usize + i * sizeof(SSAId)) as *mut SSAId);
            }
            i = i + 1 as usize;
        }
        return NO_SSA as u32;
    }

    fn register_closure_env(self: &mut Lowerer, func_ssa: SSAId, env_ptr: SSAId) {
        if self.cap_table_len < self.cap_table_cap {
            *((self.cap_func_ssas as usize + self.cap_table_len * sizeof(SSAId)) as *mut SSAId) = func_ssa;
            *((self.cap_env_ptrs as usize + self.cap_table_len * sizeof(SSAId)) as *mut SSAId) = env_ptr;
            self.cap_table_len = self.cap_table_len + 1 as usize;
        }
    }

    // Collect ident names used in an expression that refer to outer-scope locals.
    // Returns list of intern IDs. Simple scanner - handles common expression forms.
    fn collect_free_idents_expr(self: &mut Lowerer, expr_id: ExprId, params: [Param], out: *mut u32, out_len: *mut usize, max: usize) {
        if expr_id == 0 as ExprId { return; }
        let ast: &AST = self.resolver.ast;
        let p_expr: &Expr = &ast.exprs[expr_id as usize];
        let tag = (*p_expr).get_tag();
        if tag == EXPR_IDENT {
            let id = (*p_expr).get_Ident();
            // Check if it's a closure param
            let mut is_param = false;
            let mut pi = 0 as usize;
            while pi < params.len {
                if params[pi].name == id { is_param = true; break; }
                pi = pi + 1 as usize;
            }
            if !is_param {
                let opt_sym = self.resolver.resolve_ptr(id);
                match opt_sym {
                    Some(s) => {
                        let k_tag = s.kind_tag as u32;
                        if k_tag == SYM_LOCAL || k_tag == SYM_PARAM {
                            let p_entry = self.get_symbol_entry(s);
                            if p_entry != 0 as *mut SymbolMapEntry {
                                // Found in current scope - candidate capture
                                // Add if not already in list
                                let mut found = false;
                                let mut ci = 0 as usize;
                                while ci < *out_len {
                                    if *((out as usize + ci * 4) as *mut u32) == id { found = true; break; }
                                    ci = ci + 1 as usize;
                                }
                                if !found && *out_len < max {
                                    *((out as usize + *out_len * 4) as *mut u32) = id;
                                    *out_len = *out_len + 1 as usize;
                                }
                            }
                        }
                    },
                    None => {},
                }
            }
        } else if tag == EXPR_BINARY {
            let b = (*p_expr).get_Binary();
            self.collect_free_idents_expr(b.lhs, params, out, out_len, max);
            self.collect_free_idents_expr(b.rhs, params, out, out_len, max);
        } else if tag == EXPR_UNARY {
            let u = (*p_expr).get_Unary();
            self.collect_free_idents_expr(u.expr, params, out, out_len, max);
        } else if tag == EXPR_BLOCK {
            let blk = (*p_expr).get_Block();
            let mut si = 0 as usize;
            while si < blk.stmts.len {
                self.collect_free_idents_stmt(blk.stmts[si], params, out, out_len, max);
                si = si + 1 as usize;
            }
            if blk.tail_expr != 0 as ExprId {
                self.collect_free_idents_expr(blk.tail_expr, params, out, out_len, max);
            }
        } else if tag == EXPR_IF {
            let ie = (*p_expr).get_If();
            self.collect_free_idents_expr(ie.cond, params, out, out_len, max);
            self.collect_free_idents_expr(ie.then_block, params, out, out_len, max);
            if ie.else_block != 0 as ExprId {
                self.collect_free_idents_expr(ie.else_block, params, out, out_len, max);
            }
        } else if tag == EXPR_CALL {
            let c = (*p_expr).get_Call();
            self.collect_free_idents_expr(c.callee, params, out, out_len, max);
            let mut ai = 0 as usize;
            while ai < c.args.len {
                self.collect_free_idents_expr(c.args[ai], params, out, out_len, max);
                ai = ai + 1 as usize;
            }
        } else if tag == EXPR_RETURN {
            let re = (*p_expr).get_Return();
            if re != 0 as ExprId {
                self.collect_free_idents_expr(re, params, out, out_len, max);
            }
        } else if tag == EXPR_MEMBER_ACCESS {
            let me = (*p_expr).get_MemberAccess();
            self.collect_free_idents_expr(me.expr, params, out, out_len, max);
        } else if tag == EXPR_TUPLE_ACCESS {
            let ta = (*p_expr).get_TupleAccess();
            self.collect_free_idents_expr(ta.expr, params, out, out_len, max);
        } else if tag == EXPR_INDEX {
            let ie2 = (*p_expr).get_Index();
            self.collect_free_idents_expr(ie2.expr, params, out, out_len, max);
            self.collect_free_idents_expr(ie2.index, params, out, out_len, max);
        }
    }

    fn collect_free_idents_stmt(self: &mut Lowerer, stmt_id: StmtId, params: [Param], out: *mut u32, out_len: *mut usize, max: usize) {
        if stmt_id == 0 as StmtId { return; }
        let ast: &AST = self.resolver.ast;
        let p_stmt: &Stmt = &ast.stmts[stmt_id as usize];
        match *p_stmt {
            Stmt.Expr(e) => { self.collect_free_idents_expr(e, params, out, out_len, max); },
            Stmt.Let(l) => { self.collect_free_idents_expr(l.init, params, out, out_len, max); },
            Stmt.Return(re) => { if re != 0 as ExprId { self.collect_free_idents_expr(re, params, out, out_len, max); } },
            Stmt.While(w) => {
                self.collect_free_idents_expr(w.cond, params, out, out_len, max);
                self.collect_free_idents_expr(w.body, params, out, out_len, max);
            },
            Stmt.Defer(e) => { self.collect_free_idents_expr(e, params, out, out_len, max); },
            Stmt.Break | Stmt.Continue | Stmt.For(_) => {},
        }
    }

    fn get_ast_path_name(self: &mut Lowerer, type_id: TypeId) -> u32 {
        if type_id == 0 as u32 { return 0 as u32; }
        let ast: &AST = self.resolver.ast;
        let p_ty: &Type = &ast.types[type_id as usize];
        if (*p_ty).get_tag() == TYPE_PATH {
            return (*p_ty).get_Path().0;
        }
        return 0 as u32;
    }

    fn type_has_impl_for_trait(self: &mut Lowerer, type_name: u32, trait_name: u32) -> bool {
        let ast: &AST = self.resolver.ast;
        let all_decls = ast.decls.as_slice();
        let mut i = 0 as usize;
        while i < all_decls.len {
            let p_d: &Decl = &all_decls[i];
            if (*p_d).get_tag() == DECL_IMPL {
                let imp: &ImplDecl = (*p_d).get_Impl();
                if imp.trait_name == trait_name {
                    let tgt_name = self.get_ast_path_name(imp.target_ty);
                    if tgt_name == type_name { return true; }
                }
            }
            i = i + 1 as usize;
        }
        return false;
    }

    // Copy is structural: a type copies implicitly exactly when it owns nothing
    // that implements Drop. `impl Copy for T` only names that property, so it is
    // rejected for a type that lacks it.
    pub fn check_copy_impls(self: &mut Lowerer, decls: [Decl]) {
        let copy_name = self.intern_table.intern("Copy");
        let mut i = 0 as usize;
        while i < decls.len {
            let p_decl: &Decl = &decls[i];
            if (*p_decl).get_tag() == DECL_IMPL {
                let imp: &ImplDecl = (*p_decl).get_Impl();
                if imp.trait_name == copy_name && imp.type_params.len == 0 as usize {
                    let ty = self.resolver.resolve_type(imp.target_ty);
                    if ty != 0 as u32 && !self.is_copy_type(ty) {
                        let saved_path = self.file_path;
                        if imp.source_file != 0 as u32 { self.file_path = self.intern_table.lookup(imp.source_file); }
                        let name = self.get_ast_path_name(imp.target_ty);
                        self.report_error("type '", self.resolver.ast.decl_spans[i]);
                        if name != 0 as u32 { must_write(2, self.intern_table.lookup(name)); }
                        must_write(2, "' cannot implement Copy: it owns a value that implements Drop\n");
                        self.file_path = saved_path;
                    }
                }
            }
            i = i + 1 as usize;
        }
    }

    pub fn check_impl_trait_bounds(self: &mut Lowerer, decls: [Decl]) {
        let ast: &AST = self.resolver.ast;
        let all_decls = ast.decls.as_slice();
        let mut i = 0 as usize;
        while i < decls.len {
            let p_decl: &Decl = &decls[i];
            if (*p_decl).get_tag() == DECL_IMPL {
                let imp: &ImplDecl = (*p_decl).get_Impl();
                if imp.trait_name != 0 as u32 && imp.trait_type_args.len > 0 as usize {
                    // Find the trait declaration
                    let mut trait_decl_idx = 0 as usize;
                    let mut found_trait = false;
                    let mut j = 0 as usize;
                    while j < all_decls.len {
                        let p_d2: &Decl = &all_decls[j];
                        if (*p_d2).get_tag() == DECL_TRAIT {
                            let t = (*p_d2).get_Trait();
                            if t.name == imp.trait_name {
                                trait_decl_idx = j;
                                found_trait = true;
                                break;
                            }
                        }
                        j = j + 1 as usize;
                    }
                    if !found_trait { i = i + 1 as usize; continue; }
                    let tr: &TraitDecl = all_decls[trait_decl_idx].get_Trait();
                    if tr.type_params.len == 0 as usize { i = i + 1 as usize; continue; }
                    // Check each trait type arg against the type param's bounds
                    let mut k = 0 as usize;
                    while k < imp.trait_type_args.len && k < tr.type_params.len {
                        let type_arg_id = imp.trait_type_args[k];
                        let arg_name = self.get_ast_path_name(type_arg_id);
                        let p_param: &TypeParam = &tr.type_params[k];
                        let mut m = 0 as usize;
                        while m < p_param.bounds.len {
                            let bound_id = p_param.bounds[m];
                            let bound_name = self.get_ast_path_name(bound_id);
                            if arg_name != 0 as u32 && bound_name != 0 as u32 {
                                if !self.type_has_impl_for_trait(arg_name, bound_name) {
                                    self.had_error = true;
                                    let arg_str = self.intern_table.lookup(arg_name);
                                    let bound_str = self.intern_table.lookup(bound_name);
                                    must_write(2, "error: '");
                                    must_write(2, arg_str);
                                    must_write(2, "' does not implement '");
                                    must_write(2, bound_str);
                                    must_write(2, "'\n");
                                }
                            }
                            m = m + 1 as usize;
                        }
                        k = k + 1 as usize;
                    }
                }
            }
            i = i + 1 as usize;
        }
    }

    fn lower_struct_literal(self: &mut Lowerer, s: StructLiteralExpr, expected: u32) -> SSAId {
        let opt_sym = self.resolver.resolve_ptr(s.struct_name);
        let s_ref = match opt_sym {
            Some(sym) => sym,
            None => { return NO_SSA as u32; },
        };
        let ast: &AST = self.resolver.ast;
        
        let mut temp_field_ssas = zoril_allocator_alloc(self.arena, s.fields.len * 4) as *mut SSAId;
        let mut k = 0 as usize;
        while k < s.fields.len {
            temp_field_ssas[k] = self.lower_expr(s.fields[k].value);
            k = k + 1 as usize;
        }

        let mut actual_ty = 0 as u32;
        let mut needs_inference = false;
        
        if s.type_args.len > 0 as usize {
            let resolved_args = self.resolver.resolve_type_list(s.type_args.ptr, s.type_args.len);
            actual_ty = self.mono.instantiate_type(s_ref.kind_payload, resolved_args);
        } else if s_ref.kind_tag as u32 == SYM_GLOBAL {
            let p_decl: &Decl = &ast.decls[s_ref.kind_payload as usize];
            if (*p_decl).get_tag() == DECL_STRUCT {
                if (*p_decl).get_Struct().type_params.len > 0 as usize {
                    needs_inference = true;
                } else {
                    actual_ty = self.resolve_sym_type(s_ref);
                }
            } else {
                actual_ty = self.resolve_sym_type(s_ref);
            }
        } else {
            actual_ty = self.resolve_sym_type(s_ref);
        }

        if needs_inference {
            // Try to infer from fields
            let p_decl = &ast.decls.as_slice()[s_ref.kind_payload as usize];
            if p_decl.get_tag() == DECL_STRUCT {
                let sd = p_decl.get_Struct();
                let inferred = @slice(zoril_allocator_alloc(self.arena, sd.type_params.len * sizeof(u32)) as *mut u32, sd.type_params.len);
                let mut i = 0 as usize;
                while i < inferred.len { inferred[i] = 0 as u32; i = i + 1 as usize; }
                
                k = 0 as usize;
                while k < s.fields.len {
                    let fv = &s.fields[k];
                    let mut field_ty = self.get_ssa_type(temp_field_ssas[k]);
                    let mut fi = 0 as usize;
                    while fi < sd.fields.len {
                        if sd.fields[fi].name == fv.name {
                            let p_ast = &ast.types.as_slice()[sd.fields[fi].ty as usize];
                            let p_tag = p_ast.get_tag();
                            if p_tag != TYPE_PTR && p_tag != TYPE_PTRMUT && p_tag != TYPE_REF && p_tag != TYPE_REFMUT {
                                let arg_inner = self.get_ptr_inner_type(field_ty);
                                if arg_inner != 0 as u32 && self.is_aggregate(arg_inner) {
                                    field_ty = arg_inner;
                                }
                            }
                            self.unify(sd.fields[fi].ty, field_ty, inferred.ptr, sd.type_params);
                            break;
                        }
                        fi = fi + 1 as usize;
                    }
                    k = k + 1 as usize;
                }
                
                let i32_ty = self.get_primitive_type(ILPrimitive.I32);
                i = 0 as usize;
                while i < inferred.len {
                    if inferred[i] == 0 as u32 { inferred[i] = i32_ty; }
                    i = i + 1 as usize;
                }
                actual_ty = self.mono.instantiate_type(s_ref.kind_payload, inferred);
            }
        }
        
        if actual_ty == 0 as u32 { return NO_SSA as u32; }

        let mut struct_field_count = 0 as usize;
        if actual_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:2220"); }
        let p_ty_it: &ILTypeDecl = self.builder.get_type_decl(actual_ty);
        match (*p_ty_it).def {
            ILType.User(u) => {
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Struct(sd) => { struct_field_count = sd.fields.len; },
                    ILTypeDef.Enum(_) | ILTypeDef.Fn(_) => {},
                }
            },
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) |
            ILType.BoxedMut(_) | ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) |
            ILType.Tuple(_) | ILType.FD(_) | ILType.IORing | ILType.Var(_) => {},
        }

        let field_ssas = @slice(zoril_allocator_alloc(self.arena, struct_field_count * sizeof(SSAId)) as *mut SSAId, struct_field_count);
        let mut fi = 0 as usize;
        while fi < field_ssas.len { field_ssas[fi] = NO_SSA as u32; fi = fi + 1 as usize; }

        k = 0 as usize;
        while k < s.fields.len {
            let fv = &s.fields[k];
            let mut val = temp_field_ssas[k];
            let field_idx = self.get_field_index(actual_ty, fv.name);
            if field_idx != NO_SSA as u32 {
                let field_ty = self.get_field_type(actual_ty, field_idx);
                val = self.emit_cast(val, field_ty);
                field_ssas[field_idx as usize] = val;
            }
            k = k + 1 as usize;
        }
        
        let ptr_ty = self.get_ptr_type(actual_ty);
        let instr = ILInstr.StructConstruct(StructConstructInstr { ty: actual_ty, fields: field_ssas });
        return self.emit_with_type(instr, ptr_ty);
    }

    fn lower_try_expr(self: &mut Lowerer, try_expr_id: u32) -> SSAId {
        let val = self.lower_expr(try_expr_id);
        let ty = self.get_ssa_type(val);
        let actual_ty = self.get_underlying_type(ty);
        if actual_ty == 0 as u32 { return NO_SSA as u32; }
        if actual_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:2459"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(actual_ty);

        let mut v_success_idx = NO_SSA as u32;

        match (*p_ty).def {
            ILType.User(u) => {
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Enum(e) => {
                        let mut v_idx = 0 as usize;
                        while v_idx < e.variants.len {
                            let p_var: &ILVariant = &e.variants[v_idx];
                            let v_name = self.intern_table.lookup(p_var.name);
                            if is_str_eq(v_name, "Ok") || is_str_eq(v_name, "Some") {
                                v_success_idx = v_idx as u32;
                            }
                            v_idx = v_idx + 1 as usize;
                        }
                    },
                    ILTypeDef.Struct(_) | ILTypeDef.Fn(_) => { ICE("unhandled match arm: Try on non-enum User type"); },
                }
            },
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
            ILType.Slice(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
            ILType.IORing | ILType.Var(_) => { ICE("unhandled match arm: Try on non-User type"); },
        }

        if v_success_idx == NO_SSA as u32 {
            ICE("lower_expr_internal: ? operator used on non-Option/Result type");
            return NO_SSA as u32;
        }

        let bool_ty = self.get_primitive_type(ILPrimitive.Bool);
        let cond = self.emit_with_type(ILInstr.VariantMatch(VariantMatchInstr { val: val, type_id: actual_ty, variant_idx: v_success_idx }), bool_ty);

        let success_block = self.new_block();
        let error_block = self.new_block();
        self.emit(ILInstr.Branch(BranchInstr { cond: cond, then_block: success_block, else_block: error_block }));

        self.switch_to_block(error_block);
        let cur_func: &ILFunction = self.get_current_func();
        let actual_ret_ty = cur_func.ret_ty;
        if self.requires_pass_by_ref(actual_ret_ty) {
            self.emit(ILInstr.Store(StoreInstr { ptr: self.sret_ssa, val: val }));
            self.emit(ILInstr.Ret(NO_SSA as u32));
        } else {
            self.emit(ILInstr.Ret(val));
        }
        self.builder.current_block_idx = NO_SSA as u32;

        self.switch_to_block(success_block);
        let payload_ty = self.get_variant_payload_type(actual_ty, v_success_idx);
        if payload_ty != 0 as u32 {
            let ptr_ty = self.get_ptr_type(payload_ty);
            let payload_off = self.get_enum_payload_offset(actual_ty);
            let off_ssa = self.emit_const_u64(payload_off, self.get_primitive_type(ILPrimitive.U64));
            let payload_ptr = self.emit_with_type(ILInstr.Add(ILBinaryOp { lhs: val, rhs: off_ssa }), ptr_ty);
            if self.is_aggregate(payload_ty) {
                return payload_ptr;
            } else {
                return self.emit_with_type(ILInstr.Load(payload_ptr), payload_ty);
            }
        } else {
            return self.emit_const_u64(0 as u64, self.get_primitive_type(ILPrimitive.Unit));
        }
    }

    pub fn lower_expr_with_expected(self: &mut Lowerer, expr_id: ExprId, expected: u32) -> SSAId {
        if expr_id == 0 as ExprId { return NO_SSA as u32; }
        let ast: &AST = self.resolver.ast;
        let p_expr: &Expr = &ast.exprs[expr_id as usize];
        let tag = (*p_expr).get_tag();
        if tag == EXPR_LITERAL {
            let lit = (*p_expr).get_Literal();
            let lit_tag = (*lit).get_tag();
            if lit_tag == LITERAL_INT {
                let suffix = (*lit).get_Int_suffix();
                if suffix != 0xffffffff as u32 {
                     let actual_ty = *((self.resolver.primitives as usize + suffix as usize * 4) as *mut u32);
                     return self.emit_const_u64((*lit).get_Int(), actual_ty);
                }
                if expected != 0 as u32 {
                    let p_ty_exp: &ILTypeDecl = &self.module.types[expected as usize - 1 as usize];
                    let tag_exp = (*p_ty_exp).def.get_tag();
                    if self.is_numeric(expected) {
                        return self.emit_const_u64((*lit).get_Int(), expected);
                    }
                    if (tag_exp == ILTYPE_PTR || tag_exp == ILTYPE_PTRMUT) && (*lit).get_Int() == 0 as u64 {
                        return self.emit_const_u64(0 as u64, expected);
                    }
                }
            } else if lit_tag == LITERAL_FLOAT {
                if expected != 0 as u32 && self.is_numeric(expected) {
                    let fval = (*lit).get_Float();
                    let bits = *( (&fval as usize) as *u64 );
                    return self.emit_const_f64(bits, expected);
                }
            } else if lit_tag == LITERAL_CHAR {
                if expected != 0 as u32 && self.is_numeric(expected) {
                    return self.emit_const_u64((*lit).get_Char() as u64, expected);
                }
            }
        } else if tag == EXPR_UNARY {
            let u: &UnaryExpr = (*p_expr).get_Unary();
            if (*u).op.get_tag() == UNARY_NEG {
                let inner_ssa = self.lower_expr_with_expected((*u).expr, expected);
                if inner_ssa != NO_SSA as u32 {
                    return self.emit_with_type(ILInstr.Neg(inner_ssa), self.get_ssa_type(inner_ssa));
                }
            }
        }
        let mut ssa = self.lower_expr_internal(expr_id, expected);
        if ssa == NO_SSA as u32 { return ssa; }
        let ty = self.get_ssa_type(ssa);
        if !self.is_copy_type(ty) {
            let p_expr2: &Expr = &ast.exprs[expr_id as usize];
            let tag2 = (*p_expr2).get_tag();
            if tag2 == EXPR_IDENT || tag2 == EXPR_MEMBER_ACCESS || tag2 == EXPR_TUPLE_ACCESS || tag2 == EXPR_INDEX {
                let span = ast.expr_spans[expr_id as usize];
                self.builder.current_span = span;
                return self.emit_with_type(ILInstr.Move(ssa), ty);
            }
        }
        return ssa;
    }

    pub fn lower_expr(self: &mut Lowerer, expr_id: ExprId) -> SSAId {
        if expr_id == 0 as ExprId { return NO_SSA as u32; }
        let mut ssa = self.lower_expr_internal(expr_id, 0 as u32);
        if ssa == NO_SSA as u32 { return ssa; }
        let ty = self.get_ssa_type(ssa);
        if !self.is_copy_type(ty) {
            let ast: &AST = self.resolver.ast;
            let p_expr: &Expr = &ast.exprs[expr_id as usize];
            let tag = (*p_expr).get_tag();
            if tag == EXPR_IDENT || tag == EXPR_MEMBER_ACCESS || tag == EXPR_TUPLE_ACCESS || tag == EXPR_INDEX {
                let span = ast.expr_spans[expr_id as usize];
                self.builder.current_span = span;
                return self.emit_with_type(ILInstr.Move(ssa), ty);
            }
        }
        return ssa;
    }

    pub fn lower_expr_internal(self: &mut Lowerer, expr_id: ExprId, expected: u32) -> SSAId {
        if expr_id == 0 as ExprId { return NO_SSA as u32; }
        if self.builder.current_block_idx == NO_SSA as u32 { return NO_SSA as u32; }
        let ast: &AST = self.resolver.ast;
        let p_expr: &Expr = &ast.exprs[expr_id as usize];
        let tag = (*p_expr).get_tag();

        let span = ast.expr_spans[expr_id as usize];
        self.builder.current_span = span;

        match *p_expr {
            Expr.Literal(lit) => {
                let mut ty = expected;
                match lit {
                    Literal.String(_) => {
                        let u8_ty = self.get_primitive_type(ILPrimitive.U8);
                        ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Slice(ILSlice { element: u8_ty, mutable: false }) });
                    },
                    Literal.Float(_) => {
                        if ty == 0 as u32 { ty = self.get_primitive_type(ILPrimitive.F64); }
                    },
                    Literal.Int(v) => {
                        let original_ty = ty;
                        if ty == 0 as u32 { ty = self.get_primitive_type(ILPrimitive.I32); }
                        if v.1 != 0xffffffff as u32 {
                            ty = *((self.resolver.primitives as usize + v.1 as usize * 4) as *mut u32);
                        }
                        return self.lower_literal(&lit, ty);
                    },
                    Literal.Bool(_) => {
                        if ty == 0 as u32 { ty = self.get_primitive_type(ILPrimitive.Bool); }
                    },
                    Literal.Char(_) => {
                        if ty == 0 as u32 { ty = self.get_primitive_type(ILPrimitive.Char); }
                    },
                }
                return self.lower_literal(&lit, ty);
            },
            Expr.Ident(id) => {
                let opt_sym = self.resolver.resolve_ptr(id);
                let s = match opt_sym {
                    Some(s) => s,
                    None => {
                        let span = &ast.expr_spans[expr_id as usize];
                        let name = self.intern_table.lookup(id);
                        self.report_error_concat("unresolved symbol: ", name, *span);
                        return NO_SSA as u32;
                    },
                };
                let k_tag = s.kind_tag as u32;
                let kind_payload = s.kind_payload as u32;

                if k_tag == SYM_LOCAL || k_tag == SYM_PARAM {
                    let p_entry = self.get_symbol_entry(s);
                    if p_entry != 0 as *mut SymbolMapEntry {
                        if (*p_entry).addr_ssa != 0 as u64 {
                            let ty = self.resolve_sym_type(s);
                            // For all locals with addr_ssa: load the value/address from the slot.
                            // For aggregates, this loads the struct's address from the outer slot.
                            let res = self.emit_with_type(ILInstr.Load((*p_entry).addr_ssa as SSAId), ty);
                            return res;
                        }
                        return (*p_entry).ssa as SSAId;
                    } else {
                        let span = &ast.expr_spans[expr_id as usize];
                        let name = self.intern_table.lookup(id);
                        self.report_error_concat("symbol not found in current function scope (capturing from outer scope is not yet supported): ", name, *span);
                        return NO_SSA as u32;
                    }
                } else if k_tag == SYM_GLOBAL {
                    let p_decl: &Decl = &ast.decls[kind_payload as usize];
                    match *p_decl {
                        Decl.Fn(f) => {
                            let is_pub = f.is_pub;
                            let sf = f.source_file;
                            let cur_sf = self.intern_table.intern(self.file_path);
                            if !is_pub {
                                if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                    let span = &ast.expr_spans[expr_id as usize];
                                    self.report_error_concat("cannot access private function: ", self.intern_table.lookup(id), *span);
                                    return NO_SSA as u32;
                                }
                            }
                            if f.type_params.len == 0 as usize {
                                let func_idx = self.mono.instantiate_function(kind_payload, @slice(0 as *mut u32, 0 as usize));
                                let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                                let ty = self.resolve_sym_type(s);
                                return self.emit_with_type(ILInstr.FuncAddr((*p_func).id), ty);
                            }
                            return NO_SSA as u32;
                        },
                        Decl.Static(_) | Decl.Const(_) => {
                            let glob_id = self.get_global_id_by_name(s.name);
                            let addr = self.emit(ILInstr.GlobalAddr(glob_id));
                            let ty = self.resolve_sym_type(s);
                            let res = self.emit_with_type(ILInstr.Load(addr), ty);
                            return res;
                        },
                        _ => { return NO_SSA as u32; }
                    }
                } else if k_tag == SYM_FUNCTION {
                    let p_func: &ILFunction = &self.module.functions[kind_payload as usize];
                    let ty = self.resolve_sym_type(s);
                    return self.emit_with_type(ILInstr.FuncAddr((*p_func).id), ty);
                }
                return NO_SSA as u32;
            },
            Expr.Unary(u) => {
                match u.op {
                    UnaryOp.Ref => { return self.lower_address_of(u.expr, false); },
                    UnaryOp.RefMut => { return self.lower_address_of(u.expr, true); },
                    UnaryOp.Deref => {
                        let mut val = self.lower_address_of(u.expr, false);
                        if val != NO_SSA as u32 {
                            let ty = self.get_ssa_type(val);
                            let ptr_ty = self.get_ptr_inner_type(ty);
                            if ptr_ty != 0 as u32 {
                                let actual_ptr = self.emit_with_type(ILInstr.Load(val), ptr_ty);
                                let inner = self.get_ptr_inner_type(ptr_ty);
                                if inner == 0 as u32 { return actual_ptr; }
                                if self.is_aggregate(inner) { return actual_ptr; }
                                return self.emit_with_type(ILInstr.Load(actual_ptr), inner);
                            }
                        }
                        val = self.lower_expr(u.expr);
                        let ty = self.get_ssa_type(val);
                        let inner = self.get_ptr_inner_type(ty);
                        if inner == 0 as u32 { return NO_SSA as u32; }
                        if self.is_aggregate(inner) { return val; }
                        return self.emit_with_type(ILInstr.Load(val), inner);
                    },
                    UnaryOp.Neg => {
                        let val = self.lower_expr(u.expr);
                        return self.emit_with_type(ILInstr.Neg(val), self.get_ssa_type(val));
                    },
                    UnaryOp.Not => {
                        let val = self.lower_expr(u.expr);
                        return self.emit_with_type(ILInstr.Not(val), self.get_ssa_type(val));
                    },
                }
            },
            Expr.Binary(b) => {
                return self.lower_binary(&b);
            },
            Expr.Call(c) => { return self.lower_call(&c, expected); },
            Expr.Generic(g) => { return self.lower_expr(g.expr); },
            Expr.Intrinsic(i) => { return self.lower_intrinsic(&i); },
            Expr.Block(b) => { return self.lower_block(&b); },
            Expr.If(i) => { return self.lower_if(&i); },
            // Function bodies, and every match in them, are lowered through ZIR (lower_zir/).
            Expr.Match(_) => { ICE("Lowerer.lower_expr: match is lowered through ZIR"); return NO_SSA as u32; },
            Expr.StructLiteral(s) => { return self.lower_struct_literal(s, expected); },
            Expr.ArrayLiteral(a) => {
                // Extract expected element type from the context if available
                let mut elem_expected = 0 as u32;
                if expected != 0 as u32 && expected != NO_SSA as u32 {
                    let p_exp = &self.module.types[expected as usize - 1 as usize];
                    if (*p_exp).def.get_tag() == ILTYPE_ARRAY {
                        elem_expected = (*p_exp).def.get_Array().element;
                    }
                }
                let mut ssa_args = zoril_allocator_alloc(self.arena, a.elements.len * sizeof(SSAId)) as *mut SSAId;
                let mut k = 0 as usize;
                while k < a.elements.len {
                    ssa_args[k] = self.lower_expr_with_expected(a.elements[k], elem_expected);
                    k = k + 1 as usize;
                }
                let mut elem_ty = elem_expected;
                if elem_ty == 0 as u32 && a.elements.len > 0 as usize { elem_ty = self.get_ssa_type(ssa_args[0]); }
                // Unwrap *Aggregate → Aggregate so the array stores values inline.
                if elem_ty != 0 as u32 && elem_ty != NO_SSA as u32 {
                    let p_et = &self.module.types[elem_ty as usize - 1 as usize];
                    if (*p_et).def.get_tag() == ILTYPE_PTR {
                        let inner_et = (*p_et).def.get_Ptr();
                        if self.is_aggregate(inner_et) { elem_ty = inner_et; }
                    }
                }
                let arr_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Array(ILArray { element: elem_ty, size: a.elements.len as u32 }) });
                let slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: arr_ty, allocator: NO_SSA as u32 }), self.get_ptr_type(arr_ty));
                k = 0 as usize;
                while k < a.elements.len {
                    let val = ssa_args[k];
                    let idx_ssa = self.emit_const_u64(k as u64, self.get_primitive_type(ILPrimitive.U64));
                    self.emit(ILInstr.ArrayStore(IndexStoreInstr { base: slot, idx: idx_ssa, val: val }));
                    k = k + 1 as usize;
                }
                return slot;
            },
            Expr.ArrayRepeat(r) => {
                let mut rep_elem_expected = 0 as u32;
                if expected != 0 as u32 && expected != NO_SSA as u32 {
                    let p_exp = &self.module.types[expected as usize - 1 as usize];
                    if (*p_exp).def.get_tag() == ILTYPE_ARRAY {
                        rep_elem_expected = (*p_exp).def.get_Array().element;
                    }
                }
                let val = self.lower_expr_with_expected(r.value, rep_elem_expected);
                // Try to get constant count
                let mut count = 0 as usize;
                let ast: &AST = self.resolver.ast;
                let p_len: &Expr = &ast.exprs[r.len as usize];
                match *p_len {
                    Expr.Literal(lit) => {
                        match lit {
                            Literal.Int(v) => { count = v.0 as usize; },
                            _ => { ICE("lower_expr_internal: ArrayRepeat len not int literal"); },
                        }
                    },
                    _ => { ICE("lower_expr_internal: ArrayRepeat len not literal"); },
                }
                let mut elem_ty = self.get_ssa_type(val);
                // Unwrap *Aggregate → Aggregate for inline storage.
                if elem_ty != 0 as u32 && elem_ty != NO_SSA as u32 {
                    let p_et2: &ILTypeDecl = &self.module.types[elem_ty as usize - 1 as usize];
                    if (*p_et2).def.get_tag() == ILTYPE_PTR {
                        let inner_et2 = (*p_et2).def.get_Ptr();
                        if self.is_aggregate(inner_et2) { elem_ty = inner_et2; }
                    }
                }
                let arr_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Array(ILArray { element: elem_ty, size: count as u32 }) });
                let slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: arr_ty, allocator: NO_SSA as u32 }), self.get_ptr_type(arr_ty));
                let mut k = 0 as usize;
                while k < count {
                    let idx_ssa = self.emit_const_u64(k as u64, self.get_primitive_type(ILPrimitive.U64));
                    self.emit(ILInstr.ArrayStore(IndexStoreInstr { base: slot, idx: idx_ssa, val: val }));
                    k = k + 1 as usize;
                }
                return slot;
            },
            Expr.TupleLiteral(t) => {
                let mut elem_types = zoril_allocator_alloc(self.arena, t.elements.len * 4) as *mut u32;
                let mut elem_ssas = zoril_allocator_alloc(self.arena, t.elements.len * 4) as *mut SSAId;
                let mut k = 0 as usize;
                while k < t.elements.len {
                    let val = self.lower_expr(t.elements[k]);
                    elem_ssas[k] = val;
                    elem_types[k] = self.get_ssa_type(val);
                    k = k + 1 as usize;
                }
                let tup_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Tuple(@slice(elem_types, t.elements.len)) });
                let slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: tup_ty, allocator: NO_SSA as u32 }), self.get_ptr_type(tup_ty));
                k = 0 as usize;
                while k < t.elements.len {
                    let val = elem_ssas[k];
                    let field_ty = elem_types[k];
                    let addr = self.emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: slot, field_idx: k as u32 }), self.get_ptr_type(field_ty));
                    self.emit(ILInstr.Store(StoreInstr { ptr: addr, val: val }));
                    k = k + 1 as usize;
                }
                return slot;
            },
            Expr.TupleAccess(t) => {
                let mut current_base = self.get_base_ptr_for_access(t.expr);
                let mut base_ty = self.get_ssa_type(current_base);
                let inner = self.get_ptr_inner_type(base_ty);
                let mut current_ty = base_ty;
                if inner != 0 as u32 { current_ty = inner; }
                
                let field_idx = t.index as u32;
                let field_ty = self.get_field_type(current_ty, field_idx);

                if inner != 0 as u32 && !self.is_copy_type(field_ty) {
                    let cb_ty = self.get_ssa_type(current_base);
                    current_base = self.emit_with_type(ILInstr.Move(current_base), cb_ty);
                }

                let addr = self.emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: current_base, field_idx: field_idx }), self.get_ptr_type(field_ty));

                let is_agg = self.is_aggregate(field_ty);
                if is_agg {
                    return addr;
                }
                return self.emit_with_type(ILInstr.Load(addr), field_ty);
            },
            Expr.MemberAccess(m) => {
                return self.lower_member_access(&m, expected);
            },
            Expr.Index(i) => {
                let base = self.lower_expr(i.expr);
                let idx = self.lower_expr(i.index);
                let base_ty = self.get_ssa_type(base);
                
                if base_ty == 0 as u32 { return NO_SSA as u32; }
                if base_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:2385"); }
                let p_ty: &ILTypeDecl = self.builder.get_type_decl(base_ty);

                let mut elem_ty = 0 as u32;
                let mut is_slice = false;
                match (*p_ty).def {
                    ILType.Array(a) => {
                        elem_ty = a.element;
                    },
                    ILType.Slice(s) => {
                        elem_ty = s.element;
                        is_slice = true;
                    },
                    ILType.Ptr(inner) | ILType.PtrMut(inner) => {
                        if inner == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:2398"); }
                        let p_inner: &ILTypeDecl = self.builder.get_type_decl(inner);
                        match (*p_inner).def {
                            ILType.Array(a) => { elem_ty = a.element; },
                            ILType.Slice(s) => {
                                elem_ty = s.element;
                                is_slice = true;
                            },
                            _ => { elem_ty = inner; }
                        }
                    },
                    ILType.Primitive(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                    ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) | ILType.IORing | ILType.User(_) | ILType.Var(_) => {},
                }

                if elem_ty == 0 as u32 { return NO_SSA as u32; }
                if self.is_aggregate(elem_ty) {
                    return self.lower_address_of_internal(expr_id);
                }
                if is_slice {
                    return self.emit_with_type(ILInstr.SliceLoad(IndexInstr { base: base, idx: idx }), elem_ty);
                } else {
                    return self.emit_with_type(ILInstr.ArrayLoad(IndexInstr { base: base, idx: idx }), elem_ty);
                }
            },
            Expr.Cast(c) => {
                let val = self.lower_expr(c.expr);
                let target_ty = self.resolver.resolve_type(c.target_ty);
                self.check_cast_validity(&c, val, target_ty, span);
                // When casting enum to integer, load the discriminant tag.
                // An enum variable has IL type User(Enum) but in QBE is represented as a pointer
                // to alloc'd memory. Only apply when the IL type IS the enum type directly (not
                // Ptr/PtrMut to an enum, which is a pointer the user wants to use as a number).
                let val_ty = self.get_ssa_type(val);
                if val_ty != 0 as u32 {
                    let inner = self.get_ptr_inner_type(val_ty);
                    if inner == 0 as u32 {
                        if val_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:2433"); }
                        let p_check: &ILTypeDecl = self.builder.get_type_decl(val_ty);
                        match (*p_check).def {
                            ILType.User(u) => {
                                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                                match *p_def {
                                    ILTypeDef.Enum(_) => {
                                        let u32_ty = self.get_primitive_type(ILPrimitive.U32);
                                        let tag_val = self.emit_with_type(ILInstr.Load(val), u32_ty);
                                        return self.emit_cast(tag_val, target_ty);
                                    },
                                    ILTypeDef.Struct(_) | ILTypeDef.Fn(_) => {},
                                }
                            },
                            ILType.Slice(s) => {
                                let p_target_ty: &ILTypeDecl = self.builder.get_type_decl(target_ty);
                                let mut is_target_ptr_like = false;
                                match (*p_target_ty).def {
                                    ILType.Ptr(_) | ILType.PtrMut(_) => {
                                        is_target_ptr_like = true;
                                    },
                                    ILType.Primitive(prim) => {
                                        match prim {
                                            ILPrimitive.U64 | ILPrimitive.USize | ILPrimitive.I64 | ILPrimitive.ISize => {
                                                is_target_ptr_like = true;
                                            },
                                            _ => {}
                                        }
                                    },
                                    _ => {}
                                }
                                if is_target_ptr_like {
                                    let ptr_ty = self.builder.get_ptr_type(s.element);
                                    let ptr_val = self.emit_with_type(ILInstr.Load(val), ptr_ty);
                                    return self.emit_cast(ptr_val, target_ty);
                                }
                            },
                            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Boxed(_) | ILType.BoxedMut(_) |
                            ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
                            ILType.IORing | ILType.Var(_) => {},
                        }
                    }
                }
                return self.emit_cast(val, target_ty);
            },
            Expr.Try(try_expr_id) => { return self.lower_try_expr(try_expr_id); },
            Expr.Sizeof(ty_id) => {
                let actual_ty = self.resolver.resolve_type(ty_id);
                let sz = self.get_type_size(actual_ty);
                return self.emit_const_u64(sz, self.get_primitive_type(ILPrimitive.USize));
            },
            Expr.Alignof(ty_id) => {
                let actual_ty = self.resolver.resolve_type(ty_id);
                let al = self.get_type_align(actual_ty);
                return self.emit_const_u64(al, self.get_primitive_type(ILPrimitive.USize));
            },
            Expr.Boxed(b) => {
                let val = self.lower_expr(b.expr);
                let mut ty = self.get_ssa_type(val);
                let is_agg = self.is_implicit_aggregate_ptr(ty) && self.get_type_tag(ty) == ILTYPE_PTR;
                if is_agg { ty = self.get_ptr_inner_type(ty); }
                let target_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.BoxedMut(ty) });
                
                let mut alloc_ssa = NO_SSA as u32;
                let mut region = Region.Heap;
                if b.allocator != 0 as ExprId {
                    alloc_ssa = self.get_base_ptr_for_access(b.allocator);
                    region = Region.Local; // Allocating in an arena/local region
                }
                
                let ptr = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: region, ty: ty, allocator: alloc_ssa }), target_ty);
                self.emit_with_type(ILInstr.Store(StoreInstr { ptr: ptr, val: val }), self.get_primitive_type(ILPrimitive.Unit));
                return ptr;
            },
            Expr.Return(e) => {
                let p_func: &ILFunction = &self.module.functions[self.builder.current_func_idx as usize];
                let val = self.lower_expr_with_expected(e, (*p_func).ret_ty);
                if self.sret_ssa != NO_SSA as u32 {
                    if val != NO_SSA as u32 {
                        self.emit(ILInstr.Store(StoreInstr { ptr: self.sret_ssa, val: val }));
                        self.emit(ILInstr.Ret(NO_SSA as u32));
                    } else {
                        self.emit(ILInstr.Ret(NO_SSA as u32));
                    }
                } else {
                    self.emit(ILInstr.Ret(val));
                }
                self.builder.current_block_idx = NO_SSA as u32;
                return NO_SSA as u32;
            },
            Expr.Break => {
                if self.loop_stack_len > self.loop_stack_base {
                    let blocks = *((self.loop_stack as usize + (self.loop_stack_len - 1 as usize) * sizeof(LoopBlocks)) as *mut LoopBlocks);
                    self.emit(ILInstr.Jmp(blocks.exit));
                    self.builder.current_block_idx = NO_SSA as u32;
                }
                return NO_SSA as u32;
            },
            Expr.Continue => {
                if self.loop_stack_len > self.loop_stack_base {
                    let blocks = *((self.loop_stack as usize + (self.loop_stack_len - 1 as usize) * sizeof(LoopBlocks)) as *mut LoopBlocks);
                    self.emit(ILInstr.Jmp(blocks.incr));
                    self.builder.current_block_idx = NO_SSA as u32;
                }
                return NO_SSA as u32;
            },

            Expr.Closure(c) => {
                let mut name_v = ByteVec.new(self.arena);
                name_v.push('_' as u8);
                name_v.push('c' as u8);
                name_v.push('l' as u8);
                name_v.push('o' as u8);
                name_v.push('s' as u8);
                name_v.push('u' as u8);
                name_v.push('r' as u8);
                name_v.push('e' as u8);
                name_v.push('_' as u8);

                let mut temp = self.closure_count;
                if temp == 0 as u32 {
                    name_v.push('0' as u8);
                } else {
                    let mut digits = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
                    let mut di = 0 as usize;
                    while temp > 0 as u32 {
                        digits[di] = (temp % 10 as u32) as u8 + '0' as u8;
                        temp = temp / 10 as u32;
                        di = di + 1 as usize;
                    }
                    while di > 0 as usize {
                        di = di - 1 as usize;
                        name_v.push(digits[di]);
                    }
                }
                self.closure_count = self.closure_count + 1 as u32;
                let c_name = self.intern_table.intern(name_v.as_slice());

                // Collect free variables (captures) in the closure body
                let max_caps = 32 as usize;
                let free_names = zoril_allocator_alloc(self.arena, max_caps * 4) as *mut u32;
                let mut free_names_len = 0 as usize;
                self.collect_free_idents_expr(c.body, c.params, free_names, &mut free_names_len, max_caps);

                // If there are captures, set up env struct and store captured vars
                let mut cap_env_ptr = NO_SSA as u32;
                if free_names_len > 0 as usize {
                    let cap_ssas = zoril_allocator_alloc(self.arena, free_names_len * sizeof(SSAId)) as *mut SSAId;
                    let cap_tys = zoril_allocator_alloc(self.arena, free_names_len * 4) as *mut u32;
                    let cap_type_ids = zoril_allocator_alloc(self.arena, free_names_len * 4) as *mut u32;
                    let mut valid = true;
                    let mut fi = 0 as usize;
                    while fi < free_names_len {
                        let name = *((free_names as usize + fi * 4) as *mut u32);
                        let opt_sym2 = self.resolver.resolve_ptr(name);
                        match opt_sym2 {
                            Some(sym2) => {
                                // For mutable locals, load current value from addr_ssa slot
                                let pe = self.get_symbol_entry(sym2);
                                let mut cap_ssa = 0 as SSAId;
                                if pe != 0 as *mut SymbolMapEntry {
                                    if (*pe).addr_ssa != 0 as u64 {
                                        let slot_ty = self.resolve_sym_type(sym2);
                                        cap_ssa = self.emit_with_type(ILInstr.Load((*pe).addr_ssa as SSAId), slot_ty);
                                    } else {
                                        cap_ssa = (*pe).ssa as SSAId;
                                    }
                                } else {
                                    valid = false;
                                }
                                let cap_ty = self.get_ssa_type(cap_ssa);
                                if cap_ty == 0 as u32 || cap_ssa == 0 as SSAId { valid = false; }
                                let fi4 = fi * 4;
                                *((cap_ssas as usize + fi4) as *mut SSAId) = cap_ssa;
                                *((cap_tys as usize + fi4) as *mut u32) = cap_ty;
                                *((cap_type_ids as usize + fi4) as *mut u32) = cap_ty;
                            },
                            None => {
                                valid = false;
                            },
                        }
                        fi = fi + 1 as usize;
                    }
                    if valid {
                        // Create tuple type for captures
                        let cap_struct_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Tuple(@slice(cap_type_ids, free_names_len)) });
                        let cap_struct_ptr_ty = self.get_ptr_type(cap_struct_ty);
                        // Alloc env struct in current (outer) block
                        let env_alloc = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: cap_struct_ty, allocator: NO_SSA as u32 }), cap_struct_ptr_ty);
                        // Store captured values into the struct
                        let mut si2 = 0 as usize;
                        while si2 < free_names_len {
                            let cap_ssa2 = *((cap_ssas as usize + si2 * sizeof(SSAId)) as *mut SSAId);
                            let cap_ty2 = *((cap_tys as usize + si2 * 4) as *mut u32);
                            let field_addr = self.emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: env_alloc, field_idx: si2 as u32 }), self.get_ptr_type(cap_ty2));
                            self.emit(ILInstr.Store(StoreInstr { ptr: field_addr, val: cap_ssa2 }));
                            si2 = si2 + 1 as usize;
                        }
                        // Set pending captures for do_lower_fn
                        self.pending_cap_names = free_names;
                        self.pending_cap_tys = cap_tys;
                        self.pending_cap_len = free_names_len;
                        self.pending_cap_env_ty = cap_struct_ptr_ty;
                        cap_env_ptr = env_alloc;
                    }
                }

                // Create a temporary FnDecl for the closure
                let f = FnDecl {
                    name: c_name,
                    params: c.params,
                    ret_ty: c.ret_ty,
                    body: c.body,
                    type_params: @slice(0 as *mut TypeParam, 0 as usize),
                    is_pub: false,
                    is_extern: false,
                    is_variadic: false,
                    must_use: false,
                    doc_comment: 0 as u32,
                    source_file: 0 as u32,
                    has_summary: false,
                    summary_escape: 0 as u64,
                    summary_stash: 0 as u64,
                    summary_storage: 0 as u64,
                    summary_stores: 0 as u64,
                    summary_into: 0 as u64,
                    summary_ret_stack: false,
                    summary_alloc: 0 as usize,
                    has_borrows: false,
                    borrows: @slice(0 as *mut u32, 0 as usize),
                    expr_start: 0 as u32,
                    expr_end: 0 as u32,
                };

                let func_idx = self.mono.lower_closure_fn(&f, c_name);
                // pending_cap_len is cleared inside do_lower_fn after injecting captures

                let p_func: &ILFunction = &self.module.functions[func_idx as usize];

                // Construct the ILType.Fn for the closure
                let mut params = zoril_allocator_alloc(self.arena, (*p_func).params_len * 4) as *mut u32;
                let mut pi = 0 as usize;
                while pi < (*p_func).params_len {
                    let p_param = &@slice(p_func.params, p_func.params_len)[pi];
                    *((params as usize + pi * 4) as *mut u32) = (*p_param).ty;
                    pi = pi + 1 as usize;
                }
                let fn_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Fn(ILFn { params: @slice(params, (*p_func).params_len), ret_ty: (*p_func).ret_ty, is_variadic: (*p_func).is_variadic }) });
                let ptr_ty = self.get_ptr_type(fn_ty);

                let p_func_named: &ILFunction = &self.module.functions[func_idx as usize];
                let func_addr_ssa = self.emit_with_type(ILInstr.FuncAddr((*p_func_named).id), ptr_ty);

                // If this is a capturing closure, register in cap table
                if cap_env_ptr != NO_SSA as u32 {
                    self.register_closure_env(func_addr_ssa, cap_env_ptr);
                }

                return func_addr_ssa;
            },
        }

        return NO_SSA as u32;
    }

    pub fn lower_literal(self: &mut Lowerer, lit: &Literal, ty_id: u32) -> SSAId {
        match *lit {
            Literal.Int(v) => {
                let mut actual_ty = ty_id;
                if v.1 != 0xffffffff as u32 {
                    actual_ty = *((self.resolver.primitives as usize + v.1 as usize * 4) as *mut u32);
                }
                let mut ci: ConstInstr = ConstInstr { val: ConstValue.I64(v.0 as i64), ty: actual_ty };
                return self.emit_with_type(ILInstr.Const(ci), actual_ty);
            },
            Literal.Float(v) => {
                let bits = *( (&v as usize) as *u64 );
                let mut ci: ConstInstr = ConstInstr { val: ConstValue.F64(bits), ty: ty_id };
                return self.emit_with_type(ILInstr.Const(ci), ty_id);
            },
            Literal.Bool(b) => {
                let mut val = 0 as u64;
                if b { val = 1 as u64; }
                let mut ci: ConstInstr = ConstInstr { val: ConstValue.Bool(val), ty: ty_id };
                return self.emit_with_type(ILInstr.Const(ci), ty_id);
            },
            Literal.Char(c) => {
                let mut ci: ConstInstr = ConstInstr { val: ConstValue.U64(c as u64), ty: ty_id };
                return self.emit_with_type(ILInstr.Const(ci), ty_id);
            },
            Literal.String(s_id) => {
                let bytes = self.intern_table.lookup(s_id);
                let mut actual_ty = ty_id;
                if actual_ty == 0 as u32 {
                    let u8_ty = self.get_primitive_type(ILPrimitive.U8);
                    actual_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Slice(ILSlice { element: u8_ty, mutable: false }) });
                }
                return self.emit_with_type(ILInstr.StringConst(bytes), actual_ty);
            },
        }
    }


    pub fn lower_block(self: &mut Lowerer, b: &BlockExpr) -> SSAId {
        let saved_map_len = self.symbol_map_len;
        self.resolver.push_scope();
        let mut last_ssa = NO_SSA as u32;
        let mut i = 0 as usize;
        while i < b.stmts.len {
            self.lower_stmt(b.stmts[i]);
            i = i + 1 as usize;
        }
        if b.tail_expr != 0 as u32 { last_ssa = self.lower_expr(b.tail_expr); }
        self.emit_end_borrows(saved_map_len);
        self.resolver.pop_scope();
        self.symbol_map_len = saved_map_len;
        return last_ssa;
    }

    // Like lower_block but emits deferred expressions before popping scope.
    // Used for the top-level function body so deferred calls can reference locals.
    pub fn lower_fn_body_block(self: &mut Lowerer, b: &BlockExpr) -> SSAId {
        let saved_map_len = self.symbol_map_len;
        self.resolver.push_scope();
        let mut last_ssa = NO_SSA as u32;
        let mut i = 0 as usize;
        while i < b.stmts.len {
            self.lower_stmt(b.stmts[i]);
            i = i + 1 as usize;
        }
        if b.tail_expr != 0 as u32 { last_ssa = self.lower_expr(b.tail_expr); }
        // Emit defers before scope pops, so deferred exprs can reference locals.
        if !self.is_terminated() {
            self.emit_defers();
        }
        self.emit_end_borrows(saved_map_len);
        self.resolver.pop_scope();
        self.symbol_map_len = saved_map_len;
        return last_ssa;
    }

    pub fn lower_if(self: &mut Lowerer, i: &IfExpr) -> SSAId {
        let cond = self.lower_expr(i.cond);
        let base = self.scratch_stack_len;
        self.push_scratch(self.new_block()); // then_block
        self.push_scratch(self.new_block()); // else_block
        self.push_scratch(self.new_block()); // exit_block

        self.emit(ILInstr.Branch(BranchInstr { cond: cond, then_block: self.get_scratch(base) as u32, else_block: self.get_scratch(base + 1 as usize) as u32 }));

        self.switch_to_block(self.get_scratch(base) as u32);
        let mut then_val = self.lower_expr(i.then_block);
        let mut then_end = self.builder.current_block_idx;

        self.switch_to_block(self.get_scratch(base + 1 as usize) as u32);
        let mut else_val = NO_SSA as u32;
        if i.else_block != 0 as u32 { else_val = self.lower_expr(i.else_block); }
        let mut else_end = self.builder.current_block_idx;

        self.switch_to_block(self.get_scratch(base + 2 as usize) as u32);

        // If-without-else always returns unit (NO_SSA).
        if i.else_block == 0 as u32 {
            // But we still need to add the jump for the then branch!
            if then_end != NO_BLOCK {
                let saved = self.builder.current_block_idx;
                self.switch_to_block(then_end);
                if !self.is_terminated() { self.emit(ILInstr.Jmp(self.get_scratch(base + 2 as usize) as u32)); }
                then_end = self.builder.current_block_idx;
                self.switch_to_block(saved);
            }
            // And for the empty else block.
            if else_end != NO_BLOCK {
                let saved2 = self.builder.current_block_idx;
                self.switch_to_block(else_end);
                if !self.is_terminated() { self.emit(ILInstr.Jmp(self.get_scratch(base + 2 as usize) as u32)); }
                else_end = self.builder.current_block_idx;
                self.switch_to_block(saved2);
            }
            self.scratch_stack_len = base;
            return NO_SSA as u32;
        }

        // Determine the result type of the if-expression.
        let mut ty = self.get_ssa_type(then_val);
        if ty == 0 as u32 || ty == NO_SSA as u32 { ty = self.get_ssa_type(else_val); }

        if ty != 0 as u32 && ty != NO_SSA as u32 {
            let is_small_agg = self.is_aggregate(ty) && !self.requires_pass_by_ref(ty);
            let mut slot = NO_SSA as u32;
            if is_small_agg {
                let saved_blk = self.builder.current_block_idx;
                self.switch_to_block(self.builder.entry_block_idx);
                let ptr_ty = self.get_ptr_type(ty);
                slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: ty, allocator: NO_SSA as u32 }), ptr_ty);
                self.switch_to_block(saved_blk);
            }

            let saved_blk = self.builder.current_block_idx;

            if then_end != NO_BLOCK {
                self.switch_to_block(then_end);
                if then_val != NO_SSA as u32 && self.get_ssa_type(then_val) != ty {
                    then_val = self.coerce_to(then_val, ty);
                }
                if is_small_agg && then_val != NO_SSA as u32 {
                    let unit_ty = self.get_primitive_type(ILPrimitive.Unit);
                    self.emit_with_type(ILInstr.Store(StoreInstr { ptr: slot, val: then_val }), unit_ty);
                }
                if !self.is_terminated() { self.emit(ILInstr.Jmp(self.get_scratch(base + 2 as usize) as u32)); }
                then_end = self.builder.current_block_idx;
            }

            if else_end != NO_BLOCK {
                self.switch_to_block(else_end);
                if else_val != NO_SSA as u32 && self.get_ssa_type(else_val) != ty {
                    else_val = self.coerce_to(else_val, ty);
                }
                if is_small_agg && else_val != NO_SSA as u32 {
                    let unit_ty = self.get_primitive_type(ILPrimitive.Unit);
                    self.emit_with_type(ILInstr.Store(StoreInstr { ptr: slot, val: else_val }), unit_ty);
                }
                if !self.is_terminated() { self.emit(ILInstr.Jmp(self.get_scratch(base + 2 as usize) as u32)); }
                else_end = self.builder.current_block_idx;
            }

            self.switch_to_block(saved_blk);

            if is_small_agg {
                self.scratch_stack_len = base;
                return self.emit_with_type(ILInstr.Load(slot), ty);
            }

            let mut preds = zoril_allocator_alloc(self.arena, 2 * sizeof(PhiPred)) as *mut PhiPred;
            let mut count = 0 as usize;
            if then_end != NO_BLOCK {
                let p = (preds as usize + count * sizeof(PhiPred)) as *mut PhiPred;
                (*p).block = then_end;
                (*p).val = then_val;
                count = count + 1 as usize;
            }
            if else_end != NO_BLOCK && else_val != NO_SSA as u32 {
                let p = (preds as usize + count * sizeof(PhiPred)) as *mut PhiPred;
                (*p).block = else_end;
                (*p).val = else_val;
                count = count + 1 as usize;
            }

            if count == 0 as usize {
                self.scratch_stack_len = base;
                return NO_SSA as u32;
            }

            let res = self.emit_with_type(ILInstr.Phi(PhiInstr { preds: @slice(preds, count) }), ty);
            self.scratch_stack_len = base;
            return res;
        } else {
            // Unit result, but still need jumps!
            let saved3 = self.builder.current_block_idx;
            if then_end != NO_BLOCK {
                self.switch_to_block(then_end);
                if !self.is_terminated() { self.emit(ILInstr.Jmp(self.get_scratch(base + 2 as usize) as u32)); }
                then_end = self.builder.current_block_idx;
            }
            if else_end != NO_BLOCK {
                self.switch_to_block(else_end);
                if !self.is_terminated() { self.emit(ILInstr.Jmp(self.get_scratch(base + 2 as usize) as u32)); }
                else_end = self.builder.current_block_idx;
            }
            self.switch_to_block(saved3);
        }

        self.scratch_stack_len = base;
        return NO_SSA as u32;
    }

    pub fn get_underlying_type(self: &mut Lowerer, ty_id: u32) -> u32 {
        let mut curr = ty_id;
        while true {
            let inner = self.get_ptr_inner_type(curr);
            if inner == 0 as u32 { break; }
            curr = inner;
        }
        return curr;
    }

    pub fn get_typedef_decl_id(self: &mut Lowerer, typedef_id: u32) -> u32 {
        return self.mono.get_typedef_origin(typedef_id);
    }

    fn lower_enum_constructor(self: &mut Lowerer, resolved_ty: u32, u_id: u32, e: &ILEnum, v_idx: usize, c: &CallExpr, expected: u32) -> SSAId {
        let lowered_args = @slice(zoril_allocator_alloc(self.arena, c.args.len * sizeof(SSAId)) as *mut SSAId, c.args.len);
        let mut ki = 0 as usize;
        while ki < lowered_args.len { lowered_args[ki] = self.lower_expr(c.args[ki]); ki = ki + 1 as usize; }

        let mut final_ty = resolved_ty;
        let e_decl_id = self.get_typedef_decl_id(u_id);
        let p_edecl = &self.resolver.ast.decls.as_slice()[e_decl_id as usize];
        let ed = p_edecl.get_Enum();
        if ed.type_params.len > 0 as usize {
            if resolved_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3414"); }
            let p_ty: &ILTypeDecl = self.builder.get_type_decl(resolved_ty);
            let u_type_args_len = (*p_ty).def.get_User().type_args.len;
            if u_type_args_len == 0 as usize {
                let inferred = @slice(zoril_allocator_alloc(self.arena, ed.type_params.len * sizeof(u32)) as *mut u32, ed.type_params.len);
                let mut i_inf = 0 as usize;
                while i_inf < inferred.len { inferred[i_inf] = 0 as u32; i_inf = i_inf + 1 as usize; }
                if expected != 0 as u32 {
                    if expected == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3421"); }
                    let p_exp: &ILTypeDecl = self.builder.get_type_decl(expected);
                    if (*p_exp).def.get_tag() == ILTYPE_USER {
                        let u_exp = (*p_exp).def.get_User();
                        if self.get_typedef_decl_id(u_exp.id) == e_decl_id {
                            let mut i2 = 0 as usize;
                            while i2 < inferred.len && i2 < u_exp.type_args.len {
                                inferred[i2] = u_exp.type_args[i2];
                                i2 = i2 + 1 as usize;
                            }
                        }
                    }
                }
                if c.args.len > 0 as usize {
                    let mut arg0_ty = self.get_ssa_type(lowered_args[0]);
                    if ed.variants[v_idx].payload != 0 as u32 {
                        let p_v_ast = &self.resolver.ast.types.as_slice()[ed.variants[v_idx].payload as usize];
                        let p_v_tag = p_v_ast.get_tag();
                        if p_v_tag != TYPE_PTR && p_v_tag != TYPE_PTRMUT && p_v_tag != TYPE_REF && p_v_tag != TYPE_REFMUT {
                            let is_ptr = self.is_expr_ptr_value(c.args[0], lowered_args[0]);
                            if !is_ptr {
                                let arg_inner = self.get_ptr_inner_type(arg0_ty);
                                if arg_inner != 0 as u32 && self.is_aggregate(arg_inner) {
                                    arg0_ty = arg_inner;
                                }
                            }
                        }
                    }

                    // Save values already set from expected context; they take priority over arg-inferred types
                    let saved_inf = @slice(zoril_allocator_alloc(self.arena, ed.type_params.len * sizeof(u32)) as *mut u32, ed.type_params.len);
                    let mut i_sv = 0 as usize;
                    while i_sv < saved_inf.len {
                        saved_inf[i_sv] = inferred[i_sv];
                        i_sv = i_sv + 1 as usize;
                    }
                    self.unify(ed.variants[v_idx].payload, arg0_ty, inferred.ptr, ed.type_params);
                    i_sv = 0 as usize;
                    while i_sv < saved_inf.len {
                        let sv = saved_inf[i_sv];
                        if sv != 0 as u32 { inferred[i_sv] = sv; }
                        i_sv = i_sv + 1 as usize;
                    }
                }
                let i32_ty = self.get_primitive_type(ILPrimitive.I32);
                i_inf = 0 as usize;
                while i_inf < inferred.len {
                    if inferred[i_inf] == 0 as u32 { inferred[i_inf] = i32_ty; }
                    i_inf = i_inf + 1 as usize;
                }
                final_ty = self.mono.instantiate_type(e_decl_id, inferred);
            }
        }
        if final_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3473"); }
        let p_final_ty: &ILTypeDecl = self.builder.get_type_decl(final_ty);
        let final_e = self.module.typedefs[(*p_final_ty).def.get_User().id as usize].get_Enum();
        let v_ty = final_e.variants[v_idx].payload;
        let mut payload = NO_SSA as u32;
        if c.args.len == 1 as usize { 
            payload = self.coerce_to(lowered_args[0], v_ty);
        }
        else if c.args.len > 1 as usize && v_ty != 0 as u32 {
            let cur_args = @slice(zoril_allocator_alloc(self.arena, c.args.len * sizeof(SSAId)) as *mut SSAId, c.args.len);
            let mut ck = 0 as usize;
            while ck < cur_args.len {
                let f_ty = self.get_field_type(v_ty, ck as u32);
                cur_args[ck] = self.coerce_to(lowered_args[ck], f_ty);
                ck = ck + 1 as usize;
            }
            payload = self.emit_with_type(ILInstr.TupleConstruct(cur_args), v_ty);
        }
        if payload != NO_SSA as u32 && v_ty != 0 as u32 { payload = self.coerce_to(payload, v_ty); }
        return self.emit_with_type(ILInstr.SumConstruct(SumConstructInstr { type_id: final_ty, variant_idx: v_idx as u32, payload: payload }), final_ty);
    }

    fn lower_call_args(self: &mut Lowerer, c: &CallExpr, p_func: &ILFunction) -> *mut SSAId {
        let mut args_arr = zoril_allocator_alloc(self.arena, c.args.len * sizeof(SSAId)) as *mut SSAId;
        let sret_offset = if self.requires_pass_by_ref((*p_func).ret_ty) { 1 as usize } else { 0 as usize };
        let env_offset = if self.needs_env_ptr((*p_func).is_extern, (*p_func).name) { 1 as usize } else { 0 as usize };
        
        let mut i = 0 as usize;
        while i < c.args.len {
            let mut expected_ty = 0 as u32;
            if i + sret_offset + env_offset < (*p_func).params_len {
                let p_param = &@slice(p_func.params, p_func.params_len)[i + sret_offset + env_offset];
                expected_ty = (*p_param).ty;
                if self.is_implicit_aggregate_ptr(expected_ty) && self.get_type_tag(expected_ty) == ILTYPE_PTR {
                    expected_ty = self.get_ptr_inner_type(expected_ty);
                }
            }
            
            let arg_ssa = self.lower_expr_with_expected(c.args[i], expected_ty);
            let p_arg = (args_arr as usize + i * 4 as usize) as *mut SSAId;
            *p_arg = arg_ssa;
            i = i + 1 as usize;
        }
        return args_arr;
    }

    pub fn lower_call(self: &mut Lowerer, c: &CallExpr, expected: u32) -> SSAId {
        let ast: &AST = self.resolver.ast;
        let mut type_args = c.type_args;
        let mut callee_expr_id = c.callee;
        let mut p_callee: &Expr = &ast.exprs[callee_expr_id as usize];
        if (*p_callee).get_tag() == EXPR_GENERIC {
            let g = (*p_callee).get_Generic();
            callee_expr_id = g.expr;
            type_args = g.type_args;
            p_callee = &ast.exprs[callee_expr_id as usize];
        }

        let resolved_type_args = self.resolver.resolve_type_list(type_args.ptr, type_args.len);

        if (*p_callee).get_tag() == EXPR_IDENT {
            let id = (*p_callee).get_Ident();
            let opt_sym = self.resolver.resolve_ptr(id);
            match opt_sym {
                Option.Some(s) => {
                    let k_tag = s.kind_tag as u32;
                    let k_payload = s.kind_payload as u32;
                    if k_tag == SYM_FUNCTION {
                        let p_func: &ILFunction = &self.module.functions[k_payload as usize];
                        let call_span = &ast.expr_spans[c.callee as usize];
                        self.validate_call_params((*p_func).is_variadic, (*p_func).params_len, (*p_func).ret_ty, (*p_func).is_extern, (*p_func).name, c.args.len, *call_span);
                        let args_arr = self.lower_call_args(c, p_func);
                        return self.emit_call_helper(k_payload, NO_SSA as u32, args_arr, c.args.len, (*p_func).ret_ty, NO_SSA as u32);
                    }
                    if k_tag == SYM_GLOBAL {
                        let p_decl: &Decl = &ast.decls()[k_payload as usize];
                        let f: &FnDecl = (*p_decl).get_Fn();
                        let call_span = &ast.expr_spans[c.callee as usize];
                        let is_pub = f.is_pub;
                        let sf = f.source_file;
                        let cur_sf = self.intern_table.intern(self.file_path);
                        if !is_pub {
                            if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                self.report_error_concat("cannot access private function: ", self.intern_table.lookup(id), *call_span);
                                return NO_SSA as u32;
                            }
                        }
                        self.validate_call_args(f, c, *call_span, false);
                        
                        let mut actual_type_args = resolved_type_args;
                        if actual_type_args.len == 0 as usize && f.type_params.len > 0 as usize {
                            // Inference: lower args with 0 first
                            let mut args_arr_inf = zoril_allocator_alloc(self.arena, c.args.len * sizeof(SSAId)) as *mut SSAId;
                            let mut ki = 0 as usize;
                            while ki < c.args.len { *((args_arr_inf as usize + ki * 4) as *mut SSAId) = self.lower_expr(c.args[ki]); ki = ki + 1 as usize; }
                            let args_slice_inf = @slice(args_arr_inf, c.args.len);
                            actual_type_args = self.infer_type_args(f, &args_slice_inf, c.args, expected);
                            let func_idx_inf = self.mono.instantiate_function(k_payload, actual_type_args);

                            let p_func_inf: &ILFunction = &self.module.functions[func_idx_inf as usize];
                            return self.emit_call_helper(func_idx_inf, NO_SSA as u32, args_arr_inf, c.args.len, (*p_func_inf).ret_ty, NO_SSA as u32);
                        }
                        let func_idx = self.mono.instantiate_function(k_payload, actual_type_args);
                        let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                        let args_arr = self.lower_call_args(c, p_func);
                        return self.emit_call_helper(func_idx, NO_SSA as u32, args_arr, c.args.len, (*p_func).ret_ty, NO_SSA as u32);
                    }
                },
                Option.None => {},
            }
        }

        if (*p_callee).get_tag() == EXPR_MEMBER_ACCESS {
            let m = (*p_callee).get_MemberAccess();
            let resolved_ty = self.lower_expr_as_type(m.expr);
            if resolved_ty != 0 as u32 {
                if resolved_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3578"); }
                let p_ty: &ILTypeDecl = self.builder.get_type_decl(resolved_ty);
                let type_name_id = (*p_ty).name;
                if type_name_id != 0 as u32 {
                    let opt_method_idx = self.find_method_in_impls(resolved_ty, m.member);
                    match opt_method_idx {
                        Option.Some(decl_idx) => {
                            let p_impl_decl: &Decl = &ast.decls()[decl_idx as usize];
                            let imp: &ImplDecl = (*p_impl_decl).get_Impl();
                            let mut jk = 0 as usize;
                            while jk < (*imp).methods.len {
                                if (*imp).methods[jk].name == m.member {
                                    let call_span = &ast.expr_spans[c.callee as usize];
                                    self.validate_call_args(&(*imp).methods[jk], c, *call_span, false);
                                    
                                    let mut method_type_args = resolved_type_args;

                                    if method_type_args.len == 0 as usize && (*imp).methods[jk].type_params.len > 0 as usize {
                                        let mut args_arr_pre = zoril_allocator_alloc(self.arena, c.args.len * sizeof(SSAId)) as *mut SSAId;
                                        let mut pi = 0 as usize;
                                        while pi < c.args.len { *((args_arr_pre as usize + pi * 4) as *mut SSAId) = self.lower_expr(c.args[pi]); pi = pi + 1 as usize; }
                                        let args_slice_pre = @slice(args_arr_pre, c.args.len);
                                        method_type_args = self.infer_type_args(&(*imp).methods[jk], &args_slice_pre, c.args, expected);
                                    }

                                    let func_idx = self.mono.instantiate_method(&(*imp).methods[jk], method_type_args, (*p_ty).name, m.member, imp, resolved_ty);
                                    let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                                    let args_arr_final = self.lower_call_args(c, p_func);
                                    return self.emit_call_helper(func_idx, NO_SSA as u32, args_arr_final, c.args.len, (*p_func).ret_ty, NO_SSA as u32);
                                }
                                jk = jk + 1 as usize;
                            }
                        },
                        Option.None => {
                            match (*p_ty).def {
                                ILType.User(u) => {
                                    let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                                    if (*p_def).get_tag() == IL_TYPEDEF_ENUM {
                                        let e = (*p_def).get_Enum();
                                        let mut v_idx = 0 as usize;
                                        while v_idx < e.variants.len {
                                            if e.variants[v_idx].name == m.member {
                                                return self.lower_enum_constructor(resolved_ty, u.id, e, v_idx, c, expected);
                                            }
                                            v_idx = v_idx + 1 as usize;
                                        }
                                    }
                                },
                                _ => {},
                            }
                        },
                    }
                }
            } else {
                let mut base = self.get_base_ptr_for_access(m.expr);
                if base != NO_SSA as u32 {
                    let mut current_base = base;
                    let mut current_ty = self.get_ssa_type(base);
                    let mut last_addr = NO_SSA as u32;
                    while true {
                        if current_ty == 0 as u32 { break; }
                        if current_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3638"); }
                        let p_ty_it: &ILTypeDecl = self.builder.get_type_decl(current_ty);
                        match (*p_ty_it).def {
                            ILType.Ptr(inner) | ILType.PtrMut(inner) | ILType.Boxed(inner) | ILType.BoxedMut(inner) => {
                                if inner == 0 as u32 { break; }
                                if inner == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3642"); }
                                let p_ty_inner: &ILTypeDecl = self.builder.get_type_decl(inner);
                                match (*p_ty_inner).def {
                                    ILType.Slice(_) | ILType.User(_) | ILType.Tuple(_) => { current_ty = inner; break; },
                                    _ => {},
                                }
                                last_addr = current_base;
                                current_base = self.emit_with_type(ILInstr.Load(current_base), inner);
                                current_ty = inner;
                            },
                            _ => { break; },
                        }
                    }
                    if current_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3654"); }
                    let p_cty: &ILTypeDecl = self.builder.get_type_decl(current_ty);
                    let opt_method_idx = self.find_method_in_impls(current_ty, m.member);
                    match opt_method_idx {
                        Option.Some(decl_idx) => {
                            let p_impl_decl: &Decl = &ast.decls()[decl_idx as usize];
                            let imp: &ImplDecl = (*p_impl_decl).get_Impl();
                            let mut jk = 0 as usize;
                            while jk < (*imp).methods.len {
                                if (*imp).methods[jk].name == m.member {
                                    let call_span = &ast.expr_spans[c.callee as usize];
                                    self.validate_call_args(&(*imp).methods[jk], c, *call_span, true);
                                    
                                    let mut method_type_args = resolved_type_args;

                                    if method_type_args.len == 0 as usize && (*imp).methods[jk].type_params.len > 0 as usize {
                                        let mut merged_arr_pre = zoril_allocator_alloc(self.arena, (c.args.len + 1 as usize) * 4) as *mut SSAId;
                                        *((merged_arr_pre as usize) as *mut SSAId) = current_base;
                                        let mut i_pre = 0 as usize;
                                        while i_pre < c.args.len { *((merged_arr_pre as usize + (i_pre + 1 as usize) * 4) as *mut SSAId) = self.lower_expr(c.args[i_pre]); i_pre = i_pre + 1 as usize; }
                                        let args_slice_pre = @slice(merged_arr_pre, c.args.len + 1 as usize);
                                        
                                        let mut exprs_arr_pre = zoril_allocator_alloc(self.arena, (c.args.len + 1 as usize) * 4) as *mut ExprId;
                                        *((exprs_arr_pre as usize) as *mut ExprId) = m.expr;
                                        i_pre = 0 as usize;
                                        while i_pre < c.args.len { *((exprs_arr_pre as usize + (i_pre + 1 as usize) * 4) as *mut ExprId) = c.args[i_pre]; i_pre = i_pre + 1 as usize; }
                                        let exprs_slice_pre = @slice(exprs_arr_pre, c.args.len + 1 as usize);
                                        
                                        method_type_args = self.infer_type_args(&(*imp).methods[jk], &args_slice_pre, &exprs_slice_pre, expected);
                                    }

                                    let func_idx = self.mono.instantiate_method(&(*imp).methods[jk], method_type_args, (*p_cty).name, m.member, imp, current_ty);
                                    let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                                    
                                    let sret_offset = if self.requires_pass_by_ref((*p_func).ret_ty) { 1 as usize } else { 0 as usize };
                                    let env_offset = if self.needs_env_ptr((*p_func).is_extern, (*p_func).name) { 1 as usize } else { 0 as usize };

                                    let mut receiver_ssa = current_base;
                                    let expected_recv_ty = (*p_func).params[sret_offset + env_offset].ty;
                                    if !self.types_match(current_ty, expected_recv_ty) {
                                        if self.get_ptr_inner_type(expected_recv_ty) == current_ty {
                                            // Auto-ref
                                            if last_addr != NO_SSA as u32 {
                                                receiver_ssa = last_addr;
                                            } else {
                                                let ptr_ty = self.get_ptr_type(current_ty);
                                                let saved = self.builder.current_block_idx;
                                                self.switch_to_block(self.builder.entry_block_idx);
                                                let slot = self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: current_ty, allocator: NO_SSA as u32 }), ptr_ty);
                                                self.switch_to_block(saved);
                                                self.emit(ILInstr.Store(StoreInstr { ptr: slot, val: current_base }));
                                                receiver_ssa = slot;
                                            }
                                        } else if self.get_ptr_inner_type(current_ty) == expected_recv_ty {
                                            // Auto-deref
                                            receiver_ssa = self.emit_with_type(ILInstr.Load(current_base), expected_recv_ty);
                                        }
                                    }

                                    let mut args_arr_final = zoril_allocator_alloc(self.arena, (c.args.len + 1 as usize) * 4) as *mut SSAId;
                                    *((args_arr_final as usize) as *mut SSAId) = receiver_ssa;
                                    let sret_offset = if self.requires_pass_by_ref((*p_func).ret_ty) { 1 as usize } else { 0 as usize };
                                    let env_offset = if self.needs_env_ptr((*p_func).is_extern, (*p_func).name) { 1 as usize } else { 0 as usize };
                                    let mut i_f = 0 as usize;
                                    while i_f < c.args.len {
                                        let mut arg_exp = 0 as u32;
                                        if i_f + 1 as usize + sret_offset + env_offset < (*p_func).params_len {
                                            let p_param = &@slice(p_func.params, p_func.params_len)[i_f + 1 as usize + sret_offset + env_offset];
                                            arg_exp = (*p_param).ty;
                                            if self.is_implicit_aggregate_ptr(arg_exp) && self.get_type_tag(arg_exp) == ILTYPE_PTR { arg_exp = self.get_ptr_inner_type(arg_exp); }
                                        }
                                        let arg_slot = i_f + 1 as usize;
                                        let p_arg_slot = (args_arr_final as usize + arg_slot * sizeof(SSAId)) as *mut SSAId;
                                        *p_arg_slot = self.lower_expr_with_expected(c.args[i_f], arg_exp);
                                        i_f = i_f + 1 as usize;
                                    }
                                    return self.emit_call_helper(func_idx, NO_SSA as u32, args_arr_final, c.args.len + 1 as usize, (*p_func).ret_ty, NO_SSA as u32);
                                }
                                jk = jk + 1 as usize;
                            }
                        },
                        Option.None => {
                            if (*p_cty).def.get_tag() == ILTYPE_USER {
                                let u = (*p_cty).def.get_User();
                                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                                if (*p_def).get_tag() == IL_TYPEDEF_ENUM {
                                    let e = (*p_def).get_Enum();
                                    let mut v_idx = 0 as usize;
                                    while v_idx < e.variants.len {
                                        if e.variants[v_idx].name == m.member {
                                            let v_ty = e.variants[v_idx].payload;
                                            let mut payload = NO_SSA as u32;
                                            if c.args.len == 1 as usize { payload = self.lower_expr_with_expected(c.args[0], v_ty); }
                                            return self.emit_with_type(ILInstr.SumConstruct(SumConstructInstr { type_id: current_ty, variant_idx: v_idx as u32, payload: payload }), current_ty);
                                        }
                                        v_idx = v_idx + 1 as usize;
                                    }
                                }
                            }
                        },
                    }
                }
            }
        }

        let mut args_arr_fb = zoril_allocator_alloc(self.arena, c.args.len * 4) as *mut SSAId;
        let mut i_fb = 0 as usize;
        while i_fb < c.args.len {
            *((args_arr_fb as usize + i_fb * 4) as *mut SSAId) = self.lower_expr(c.args[i_fb]);
            i_fb = i_fb + 1 as usize;
        }
        let callee_val = self.lower_expr(c.callee);
        if callee_val != NO_SSA as u32 {
            let mut callee_ty = self.get_ssa_type(callee_val);
            if callee_ty != 0 as u32 {
                if callee_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3768"); }
                let mut p_ty: &ILTypeDecl = self.builder.get_type_decl(callee_ty);
                if (*p_ty).def.get_tag() == ILTYPE_PTR {
                    let inner = (*p_ty).def.get_Ptr();
                    if callee_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3771"); }
                    if inner != 0 as u32 { callee_ty = inner; p_ty = self.builder.get_type_decl(callee_ty); }
                }
                if (*p_ty).def.get_tag() == ILTYPE_FN {
                    let fn_ty: &ILFn = (*p_ty).def.get_Fn();
                    let cap_env_ssa = self.lookup_closure_env(callee_val);
                    return self.emit_call_helper(NO_SSA as u32, callee_val, args_arr_fb, c.args.len, (*fn_ty).ret_ty, cap_env_ssa);
                }
            }
        }

        let callee_span = &ast.expr_spans[c.callee as usize];
        self.report_error("Failed to resolve callee", *callee_span);
        return NO_SSA as u32;
    }

    pub fn lower_intrinsic(self: &mut Lowerer, i: &IntrinsicExpr) -> SSAId {
        let ast: &AST = self.resolver.ast;
        let name_str = self.intern_table.lookup(i.name);
        if is_str_eq(name_str, "slice") {
            let ptr = self.lower_expr(i.args[0]);
            let len_raw = self.lower_expr(i.args[1]);
            let len = self.emit_cast(len_raw, self.get_primitive_type(ILPrimitive.USize));
            let inner = self.get_ptr_inner_type(self.get_ssa_type(ptr));
            let slice_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Slice(ILSlice { element: inner, mutable: false }) });
            return self.emit_with_type(ILInstr.SliceConstruct(SliceConstructInstr { ptr: ptr, len: len }), slice_ty);
        }
        if is_str_eq(name_str, "saturating_add") {
            let lhs = self.lower_expr(i.args[0]);
            let rhs = self.lower_expr(i.args[1]);
            let ty = self.get_ssa_type(lhs);
            let casted_rhs = self.emit_cast(rhs, ty);
            return self.emit_with_type(ILInstr.SaturatingAdd(ILBinaryOp { lhs: lhs, rhs: casted_rhs }), ty);
        }
        if is_str_eq(name_str, "region_cast") {
            let val = self.lower_expr(i.args[0]);
            let ty_id = self.resolver.resolve_type(i.type_args[0]);
            return self.emit_with_type(ILInstr.RegionCast(RegionCastInstr { val: val, region: Region.Local }), ty_id);
        }
        if is_str_eq(name_str, "syscall") {
             let nr_raw = self.lower_expr(i.args[0]);
             let u64_ty = self.get_primitive_type(ILPrimitive.U64);
             let nr = self.emit_cast(nr_raw, u64_ty);
             let arg_count = i.args.len - 1 as usize;
             let ssa_args = zoril_allocator_alloc(self.arena, arg_count * sizeof(SSAId)) as *mut SSAId;
             let mut k = 0 as usize;
             while k < arg_count {
                 let arg_val = self.lower_expr(i.args[k + 1 as usize]);
                 let casted = self.emit_cast(arg_val, u64_ty);
                 ssa_args[k] = casted;
                 k = k + 1 as usize;
             }
             let res_ty = self.get_primitive_type(ILPrimitive.I64);
             return self.emit_with_type(ILInstr.Syscall(SyscallInstr { num: nr, args: @slice(ssa_args, arg_count) }), res_ty);
        }
        if is_str_eq(name_str, "likely") {
            let cond = self.lower_expr(i.args[0]);
            return self.emit_with_type(ILInstr.Likely(cond), self.get_primitive_type(ILPrimitive.Bool));
        }
        if is_str_eq(name_str, "unlikely") {
            let cond = self.lower_expr(i.args[0]);
            return self.emit_with_type(ILInstr.Unlikely(cond), self.get_primitive_type(ILPrimitive.Bool));
        }
        if is_str_eq(name_str, "async_setup") {
            let entries_raw = self.lower_expr(i.args[0]);
            let u64_ty = self.get_primitive_type(ILPrimitive.U64);
            let entries = self.emit_cast(entries_raw, u64_ty);
            let res_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.IORing });
            return self.emit_with_type(ILInstr.IORingSetup(entries), res_ty);
        }
        if is_str_eq(name_str, "async_enter") {
            let ring = self.lower_expr(i.args[0]);
            let to_submit = self.get_int_literal(i.args[1]) as u32;
            let min_complete = self.get_int_literal(i.args[2]) as u32;
            let res_ty = self.get_primitive_type(ILPrimitive.I64);
            return self.emit_with_type(ILInstr.IORingEnter(IORingEnterInstr { ring: ring, to_submit: to_submit, min_complete: min_complete }), res_ty);
        }
        if is_str_eq(name_str, "async_close") {
            let ring = self.lower_expr(i.args[0]);
            return self.emit_with_type(ILInstr.IORingClose(ring), self.get_primitive_type(ILPrimitive.Unit));
        }
        if is_str_eq(name_str, "drop") {
            // @drop(expr): evaluate expr and call its Drop::drop destructor if one exists.
            // For non-Drop types this is a no-op that consumes the value.
            // Uses lower_address_of to bypass ownership move-tracking (drop is the
            // explicit end of a value's lifetime, so it must work even after a move).
            if i.args.len == 0 as usize { return NO_SSA as u32; }
            let mut val = self.lower_address_of(i.args[0], false);
            if val == NO_SSA as u32 {
                val = self.lower_expr(i.args[0]);
            }
            if val == NO_SSA as u32 { return NO_SSA as u32; }
            let val_ty = self.get_ssa_type(val);
            let unit_ty = self.get_primitive_type(ILPrimitive.Unit);
            // Unwrap pointer indirection to get the base type name
            let mut base_ty = val_ty;
            if val_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3865"); }
            let p_vt: &ILTypeDecl = self.builder.get_type_decl(val_ty);
            let vt_tag = (*p_vt).def.get_tag();
            if vt_tag == ILTYPE_PTR || vt_tag == ILTYPE_PTRMUT || vt_tag == ILTYPE_BOXED || vt_tag == ILTYPE_BOXEDMUT {
                base_ty = (*p_vt).def.get_Ptr();
            }
            if base_ty == 0 as u32 { ICE("get_type_decl 0 at expr.zrl:3870"); }
            let p_base: &ILTypeDecl = self.builder.get_type_decl(base_ty);
            let type_name_id = (*p_base).name;
            if type_name_id != 0 as u32 {
                // Construct mangled name: TypeName_drop
                let mut name_buf: &mut ByteVec = ByteVec.new(self.arena);
                let type_str = self.intern_table.lookup(type_name_id);
                (*name_buf).push_slice(type_str);
                (*name_buf).push(':' as u8);
                (*name_buf).push(':' as u8);
                (*name_buf).push_slice("drop");
                let mangled = self.intern_table.intern((*name_buf).as_slice());

                let mut name_buf_us: &mut ByteVec = ByteVec.new(self.arena);
                (*name_buf_us).push_slice(type_str);
                (*name_buf_us).push('_' as u8);
                (*name_buf_us).push_slice("drop");
                let mangled_us = self.intern_table.intern((*name_buf_us).as_slice());
                // Search module functions for this mangled name
                let mut fi = 0 as usize;
                while fi < self.module.functions.len {
                    let p_func: &ILFunction = &self.module.functions[fi];
                    if (*p_func).name == mangled || (*p_func).name == mangled_us {
                        let arg_ptr = zoril_allocator_alloc(self.arena, sizeof(SSAId)) as *mut SSAId;
                        *arg_ptr = val;
                        self.emit_call_helper(fi as u32, NO_SSA as u32, arg_ptr, 1 as usize, unit_ty, NO_SSA as u32);
                        return NO_SSA as u32;
                    }
                    fi = fi + 1 as usize;
                }
                // No Drop impl found — try to instantiate via find_method_in_impls
                let drop_name_id = self.intern_table.intern("drop");
                let opt_decl = self.find_method_in_impls(base_ty, drop_name_id);
                match opt_decl {
                    Some(decl_idx) => {
                        let p_impl_decl: &Decl = &ast.decls()[decl_idx as usize];
                        let imp: &ImplDecl = (*p_impl_decl).get_Impl();
                        let mut jk = 0 as usize;
                        while jk < (*imp).methods.len {
                            if (*imp).methods[jk].name == drop_name_id {
                                let func_idx = self.mono.instantiate_method(&(*imp).methods[jk], @slice(0 as *mut u32, 0 as usize), type_name_id, drop_name_id, imp, base_ty);
                                let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                                let arg_ptr2 = zoril_allocator_alloc(self.arena, sizeof(SSAId)) as *mut SSAId;
                                *arg_ptr2 = val;
                                self.emit_call_helper(func_idx, NO_SSA as u32, arg_ptr2, 1 as usize, (*p_func).ret_ty, NO_SSA as u32);
                                return NO_SSA as u32;
                            }
                            jk = jk + 1 as usize;
                        }
                    },
                    None => {},
                }
            }
            return NO_SSA as u32;
        }
        if is_str_eq(name_str, "ptr_cast") {
            // @ptr_cast<*T>(expr): reinterpret bits of expr as pointer type *T
            if i.type_args.len == 0 as usize || i.args.len == 0 as usize { return NO_SSA as u32; }
            if self.resolver.is_enum_type(i.type_args[0]) {
                let span = ast.expr_spans[i.args[0] as usize];
                self.report_error("cannot cast to enum type: enum discriminants must be constructed via variant constructors", span);
                return NO_SSA as u32;
            }
            let target_ty = self.resolver.resolve_type(i.type_args[0]);
            let val = self.lower_expr(i.args[0]);
            return self.emit_cast(val, target_ty);
        }
        if is_str_eq(name_str, "int_cast") {
            // @int_cast<U>(expr): reinterpret bits of expr as integer type U
            if i.type_args.len == 0 as usize || i.args.len == 0 as usize { return NO_SSA as u32; }
            if self.resolver.is_enum_type(i.type_args[0]) {
                let span = ast.expr_spans[i.args[0] as usize];
                self.report_error("cannot cast to enum type: enum discriminants must be constructed via variant constructors", span);
                return NO_SSA as u32;
            }
            let target_ty = self.resolver.resolve_type(i.type_args[0]);
            let val = self.lower_expr(i.args[0]);
            return self.emit_cast(val, target_ty);
        }
        if is_str_eq(name_str, "ptr_from_int") {
            // @ptr_from_int<T>(expr): authorized pointer forgery. The optional
            // type argument names the result type; without one it is *mut u8.
            if i.args.len == 0 as usize { return NO_SSA as u32; }
            let target_ty = if i.type_args.len > 0 as usize {
                self.resolver.resolve_type(i.type_args[0])
            } else {
                self.get_ptr_mut_type(self.get_primitive_type(ILPrimitive.U8))
            };
            let val = self.lower_expr(i.args[0]);
            return self.builder.emit_ptr_from_int(val, target_ty);
        }
        if is_str_eq(name_str, "alloca") {
            // @alloca<T>(1): allocate one T on the stack, return *mut T.
            // Only a literal count of 1 is implemented; the count used to be
            // silently ignored, corrupting the stack for counts > 1.
            if i.type_args.len == 0 as usize { return NO_SSA as u32; }
            if i.args.len > 0 as usize {
                let mut count_ok = false;
                let p_count: &Expr = &ast.exprs[i.args[0] as usize];
                match *p_count {
                    Expr.Literal(lit) => {
                        if lit.get_tag() == LITERAL_INT && lit.get_Int() == 1 as u64 {
                            count_ok = true;
                        }
                    },
                    _ => {},
                }
                if !count_ok {
                    let no_span = Span { start: 0, end: 0, line: 0, col: 0 };
                    self.report_error("@alloca<T>(count): only a literal count of 1 is supported; use an array type (e.g. @alloca<[T; N]>(1)) for fixed-size buffers", no_span);
                }
            }
            let ty = self.resolver.resolve_type(i.type_args[0]);
            let ptr_ty = self.get_ptr_mut_type(ty);
            return self.emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: ty, allocator: NO_SSA as u32 }), ptr_ty);
        }
        return NO_SSA as u32;
    }
}
