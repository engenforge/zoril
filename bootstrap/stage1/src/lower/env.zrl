import "core.zrl";
import "mem.zrl";
import "io.zrl";
import "ast.zrl";
import "il_type.zrl";
import "il_instr.zrl";
import "il_cfg.zrl";
import "resolve.zrl";
import "token.zrl";
import "lexer.zrl";
import "intern.zrl";
import "bytevec.zrl";
import "mono.zrl";
import "builder.zrl";
import "vec.zrl";


pub struct SymbolMapEntry {
    pub sym: usize,
    pub ssa: u64,
    pub addr_ssa: u64,
    pub ty: u32,
    pub is_implicit_aggregate_ptr: bool,
}

pub struct LoopBlocks {
    pub cond: BlockId,
    pub incr: BlockId,
    pub exit: BlockId,
}

pub struct MatchState {
    pub exit_block: BlockId,
    pub fail_block: BlockId,
    pub res_ty: u32,
    pub result_slot: u32,
    pub preds: *mut PhiPred,
    pub preds_len: usize,
    pub use_store_load: bool,
    pub val: SSAId,
    pub arm_idx: usize,
    pub max_arms: usize,
    pub next_arm_block: BlockId,
    pub body_block: BlockId,
    pub sub_i: usize,
    pub sub_count: usize,
    pub next_match_block: BlockId,
}

pub struct Lowerer {
    pub arena: *mut Arena,
    pub resolver: &mut Resolver,
    pub module: &mut ILModule,
    pub intern_table: &mut InternTable,
    pub mono: &mut Monomorphizer,
    pub builder: &mut ILBuilder,

    pub symbol_map: *mut SymbolMapEntry,
    pub symbol_map_len: usize,
    pub symbol_map_base: usize,
    pub symbol_map_cap: usize,

    pub loop_stack: *mut LoopBlocks,
    pub loop_stack_len: usize,
    pub loop_stack_cap: usize,
    pub loop_stack_base: usize,

    pub had_error: bool,
    pub ptr_id: u32,
    pub len_id: u32,
    pub sret_ssa: SSAId,
    pub memcpy_id: u32,
    pub closure_count: u32,
    pub file_path: [u8],
    pub current_fn_name: u32,
    pub sizing_depth: u32,

    // Defer list: deferred expressions emitted in LIFO order before returns.
    pub defer_list: *mut ExprId,
    pub defer_list_len: usize,
    pub defer_list_base: usize,
    pub defer_list_cap: usize,

    // Closure capture: pending captures set before instantiate_function, read in do_lower_fn
    pub pending_cap_names: *mut u32,   // intern IDs of captured var names
    pub pending_cap_ssas: *mut SSAId,  // SSA values of captured vars (in outer fn)
    pub pending_cap_tys: *mut u32,     // IL types of captured vars
    pub pending_cap_len: usize,
    pub pending_cap_env_ty: u32,       // IL type of *CaptureStruct

    // Closure cap table: maps func_addr_ssa to env_ptr SSA
    pub cap_func_ssas: *mut SSAId,     // FuncAddr SSA of capturing closure
    pub cap_env_ptrs: *mut SSAId,
    pub cap_table_len: usize,
    pub cap_table_cap: usize,

    pub scratch_stack: *mut u64,
    pub scratch_stack_len: usize,
    pub scratch_stack_cap: usize,

    pub current_match_state: *mut MatchState,

    // Set by lower_fn_instance to provide the self type for bare 'self' params (ty=0)
    pub implicit_self_ty: u32,
    // Set by lower_fn_instance for methods: length of the owning type's name within the function name.
    pub current_owner_len: u32,
    // Names referenced from the bodies of this TU's public generic functions. Those bodies are
    // instantiated in other TUs, so what they reference must be linkable (see is_local_fn).
    pub generic_private_refs: Vec<u32>,

    pub impl_target_types: Vec<u32>,
    pub impl_target_names: Vec<u32>,
    pub impl_decl_ids: Vec<u32>,
    pub impl_target_decl_ids: Vec<u32>,
    pub impl_is_generic: Vec<bool>,
    pub scratch_arena: *mut Arena,
    pub compile_only: bool,
    pub target_source_file: u32,
    pub is_specialization: bool,
}

impl Lowerer {
    pub fn is_copy_type_internal(self: &mut Lowerer, type_id: u32, depth: usize) -> bool {
        if type_id == 0 as u32 { return true; }
        if depth > 10 as usize { return true; }

        if self.is_implicit_aggregate_ptr(type_id) {
            let inner = self.get_ptr_inner_type(type_id);
            return self.is_copy_type_internal(inner, depth + 1 as usize);
        }

        // Check if the type implements Drop
        let drop_name_id = (*self.intern_table).intern("drop");
        let opt_decl = self.find_method_in_impls(type_id, drop_name_id);
        match opt_decl {
            Some(_) => { return false; },
            None => {}
        }

        let p_ty: &ILTypeDecl = &self.module.types[type_id as usize - 1 as usize];
        match (*p_ty).def {
            ILType.Primitive(_) | ILType.Ptr(_) | ILType.PtrMut(_) | ILType.Slice(_) |
            ILType.Fn(_) => { return true; },
            ILType.FD(_) | ILType.IORing => { return false; },
            ILType.Boxed(_) | ILType.BoxedMut(_) => { return false; },
            ILType.Array(a) => {
                return self.is_copy_type_internal(a.element, depth + 1 as usize);
            },
            ILType.Tuple(types) => {
                let mut i = 0 as usize;
                while i < types.len {
                    if !self.is_copy_type_internal(types[i], depth + 1 as usize) { return false; }
                    i = i + 1 as usize;
                }
                return true;
            },
            ILType.User(u) => {
                if u.id == 0 as u32 { return true; }
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                match *p_def {
                    ILTypeDef.Struct(s) => {
                        let mut i = 0 as usize;
                        while i < s.fields.len {
                            if !self.is_copy_type_internal(s.fields[i].ty, depth + 1 as usize) { return false; }
                            i = i + 1 as usize;
                        }
                        return true;
                    },
                    ILTypeDef.Enum(e) => {
                        let mut i = 0 as usize;
                        while i < e.variants.len {
                            if e.variants[i].payload != 0 as u32 {
                                if !self.is_copy_type_internal(e.variants[i].payload, depth + 1 as usize) { return false; }
                            }
                            i = i + 1 as usize;
                        }
                        return true;
                    },
                    ILTypeDef.Fn(_) => { return true; },
                }
            },
            ILType.Var(_) => { return false; },
        }
    }

    pub fn report_error(self: &mut Lowerer, msg: [u8], span: Span) {
        self.had_error = true;
        must_write(2, self.file_path);
        must_write(2, ":");
        write_u64(2, span.line as usize);
        must_write(2, ":");
        write_u64(2, span.col as usize);
        must_write(2, ": error: ");
        must_write(2, msg);
    }
    pub fn report_error_concat(self: &mut Lowerer, msg1: [u8], msg2: [u8], span: Span) {
        self.had_error = true;
        must_write(2, self.file_path);
        must_write(2, ":");
        write_u64(2, span.line as usize);
        must_write(2, ":");
        write_u64(2, span.col as usize);
        must_write(2, ": error: ");
        must_write(2, msg1);
        must_write(2, msg2);
    }

    pub fn push_scratch(self: &mut Lowerer, val: u64) {
        if self.scratch_stack_len >= self.scratch_stack_cap {
            ICE("scratch_stack overflow");
        }
        let off = self.scratch_stack_len * 8;
        unsafe { *( (self.scratch_stack as usize + off) as *mut u64 ) = val; }
        self.scratch_stack_len = self.scratch_stack_len + 1 as usize;
    }

    pub fn get_scratch(self: &Lowerer, idx: usize) -> u64 {
        let off = idx * 8;
        return unsafe { *( (self.scratch_stack as usize + off) as *mut u64 ) };
    }

    fn set_scratch(self: &mut Lowerer, idx: usize, val: u64) {
        let off = idx * 8;
        unsafe { *( (self.scratch_stack as usize + off) as *mut u64 ) = val; }
    }

    pub fn new(arena: *mut Arena, resolver: &mut Resolver, module: &mut ILModule, intern_table: &mut InternTable, mono: &mut Monomorphizer) -> *mut Lowerer {
        let scratch_arena = arena_init((1024 as u64) * 1024 * 4096);
        let l = zoril_allocator_alloc(arena, sizeof(Lowerer)) as *mut Lowerer;
        let builder = ILBuilder.new(arena, module);
        unsafe {
        *l = Lowerer {
            arena: arena,
            resolver: resolver,
            module: module,
            intern_table: intern_table,
            mono: mono,
            builder: &mut *builder,
            symbol_map: zoril_allocator_alloc(arena, 4096 * sizeof(SymbolMapEntry)) as *mut SymbolMapEntry,
            symbol_map_len: 0 as usize,
            symbol_map_base: 0 as usize,
            symbol_map_cap: 4096 as usize,
            loop_stack: zoril_allocator_alloc(arena, 256 * sizeof(LoopBlocks)) as *mut LoopBlocks,
            loop_stack_len: 0 as usize,
            loop_stack_cap: 256 as usize,
            loop_stack_base: 0 as usize,
            had_error: false,
            ptr_id: (*intern_table).intern("ptr"),
            len_id: (*intern_table).intern("len"),
            sret_ssa: NO_SSA as u32,
            memcpy_id: (*intern_table).intern("memcpy"),
            closure_count: 0 as u32,
            file_path: (*resolver).file_path,
            current_fn_name: 0 as u32,
            sizing_depth: 0 as u32,
            defer_list: zoril_allocator_alloc(arena, 256 * sizeof(ExprId)) as *mut ExprId,
            defer_list_len: 0 as usize,
            defer_list_base: 0 as usize,
            defer_list_cap: 256 as usize,
            pending_cap_names: 0 as *mut u32,
            pending_cap_ssas: 0 as *mut SSAId,
            pending_cap_tys: 0 as *mut u32,
            pending_cap_len: 0 as usize,
            pending_cap_env_ty: 0 as u32,
            cap_func_ssas: zoril_allocator_alloc(arena, 128 * sizeof(SSAId)) as *mut SSAId,
            cap_env_ptrs: zoril_allocator_alloc(arena, 128 * sizeof(SSAId)) as *mut SSAId,
            cap_table_len: 0 as usize,
            cap_table_cap: 128 as usize,
            scratch_stack: zoril_allocator_alloc(arena, 4096 * 8) as *mut u64,
            scratch_stack_len: 0 as usize,
            scratch_stack_cap: 4096 as usize,
            current_match_state: 0 as *mut MatchState,
            implicit_self_ty: 0 as u32,
            current_owner_len: 0 as u32,
            generic_private_refs: Vec::<u32>.new_in(arena),
            impl_target_types: Vec::<u32>.new_in(arena),
            impl_target_names: Vec::<u32>.new_in(arena),
            impl_decl_ids: Vec::<u32>.new_in(arena),
            impl_target_decl_ids: Vec::<u32>.new_in(arena),
            impl_is_generic: Vec::<bool>.new_in(arena),
            scratch_arena: scratch_arena,
            compile_only: false,
            target_source_file: 0 as u32,
            is_specialization: false,
        };
        }
        return l;
    }

    // Emit EndBorrow pseudo-instructions for all references in the current scope.
    pub fn emit_end_borrows(self: &mut Lowerer, old_len: usize) {
        let mut i = self.symbol_map_len;
        while i > old_len {
            i = i - 1 as usize;
            let off = i * sizeof(SymbolMapEntry);
            let p = (self.symbol_map as usize + off) as *mut SymbolMapEntry;

            // If the symbol is a reference (logical borrow), emit EndBorrow for its base variable.
            // We use the ssa field of the reference to find the borrow.
            let tag = unsafe { self.get_type_tag((*p).ty) };
            if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_SLICE {
                // The verifier will track active borrows by SSA handle.
                // We emit EndBorrow(ssa_of_reference) to signal that this handle is gone.
                unsafe { self.emit(ILInstr.EndBorrow((*p).ssa as u32)); }
            }
        }
    }

    // Emit all deferred expressions in LIFO order from current function's scope.
    pub fn emit_defers(self: &mut Lowerer) {
        let mut i = self.defer_list_len;
        while i > self.defer_list_base {
            i = i - 1 as usize;
            let expr_id = unsafe { *((self.defer_list as usize + i * sizeof(ExprId)) as *mut ExprId) };
            self.lower_expr(expr_id);
        }
    }

    pub fn get_primitive_type(self: &mut Lowerer, p: ILPrimitive) -> u32 {
        let tag = p.get_tag();
        return unsafe { *((self.resolver.primitives as usize + tag as usize * 4) as *mut u32) };
    }

    pub fn unify(self: &mut Lowerer, ast_ty_id: TypeId, il_ty_id: u32, inferred: *mut u32, type_params: [TypeParam]) {
        if ast_ty_id == 0 as u32 || il_ty_id == 0 as u32 { return; }
        let p_ast: &Type = &self.resolver.ast.types[ast_ty_id as usize];
        match *p_ast {
            Type.Var(v) => {
                let mut i = 0 as usize;
                while i < type_params.len {
                    if type_params[i].name == v {
                        unsafe { *((inferred as usize + i * 4) as *mut u32) = il_ty_id; }
                        return;
                    }
                    i = i + 1 as usize;
                }
            },
            Type.Path(p) => {
                let mut i = 0 as usize;
                while i < type_params.len {
                    if type_params[i].name == p.0 {
                        unsafe { *((inferred as usize + i * 4) as *mut u32) = il_ty_id; }
                        return;
                    }
                    i = i + 1 as usize;
                }

                if il_ty_id == 0 as u32 { ICE("get_type_decl 0 at env.zrl:330"); }
                let p_il: &ILTypeDecl = self.builder.get_type_decl(il_ty_id);
                if (*p_il).def.get_tag() == ILTYPE_USER {
                    let u = (*p_il).def.get_User();
                    let mut k = 0 as usize;
                    while k < p.1.len && k < u.type_args.len {
                        self.unify(p.1[k], u.type_args[k], inferred, type_params);
                        k = k + 1 as usize;
                    }
                }
            },
            Type.Ptr(inner) | Type.PtrMut(inner) | Type.Ref(inner) | Type.RefMut(inner) => {
                 if il_ty_id == 0 as u32 { ICE("get_type_decl 0 at env.zrl:341"); }
                 let p_il: &ILTypeDecl = self.builder.get_type_decl(il_ty_id);
                 let tag = (*p_il).def.get_tag();
                 if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
                     let inner_il = (*p_il).def.get_Ptr();
                     self.unify(inner, inner_il, inferred, type_params);
                 }
            },
            // Non-generic types don't need unification.
            Type.Primitive(_) | Type.Slice(_) | Type.SliceMut(_) | Type.Array(_) | Type.Tuple(_) | Type.Fn(_) => {},
        }
    }

    pub fn is_expr_ptr_value(self: &mut Lowerer, expr_id: ExprId, ssa_val: SSAId) -> bool {
        if expr_id == 0 as ExprId { return false; }
        let p_expr: &Expr = &self.resolver.ast.exprs[expr_id as usize];
        match *p_expr {
            Expr.Unary(u) => {
                match u.op {
                    UnaryOp.Ref | UnaryOp.RefMut | UnaryOp.Deref => { return true; },
                    UnaryOp.Neg | UnaryOp.Not => { return false; }
                }
            },
            Expr.Cast(_) | Expr.Call(_) => { return true; },
            Expr.MemberAccess(_) | Expr.Ident(_) | Expr.TupleAccess(_) | Expr.Index(_) |
            Expr.Block(_) | Expr.If(_) | Expr.Match(_) | Expr.Binary(_) => {
                let vt = self.get_type_tag(self.get_ssa_type(ssa_val));
                if vt == ILTYPE_PTRMUT || vt == ILTYPE_BOXED || vt == ILTYPE_BOXEDMUT {
                    return true;
                }
                return false;
            },
            Expr.Literal(_) | Expr.Generic(_) | Expr.Intrinsic(_) |
            Expr.StructLiteral(_) | Expr.Boxed(_) | Expr.ArrayLiteral(_) | Expr.ArrayRepeat(_) |
            Expr.TupleLiteral(_) | Expr.Closure(_) | Expr.Try(_) | Expr.Return(_) |
            Expr.Break | Expr.Continue | Expr.Sizeof(_) | Expr.Alignof(_) => { return false; }
        }
    }

    pub fn infer_type_args(self: &mut Lowerer, f: &FnDecl, args: &[SSAId], args_exprs: &[ExprId], expected_ret: u32) -> [u32] {
        let mut inferred = zoril_allocator_alloc(self.arena, f.type_params.len * 4) as *mut u32;
        let mut i = 0 as usize;
        while i < f.type_params.len {
            unsafe { *((inferred as usize + i * 4) as *mut u32) = 0 as u32; }
            i = i + 1 as usize;
        }

        let mut k = 0 as usize;
        while k < f.params.len && k < args.len {
            let p_ty_id = f.params[k].ty;
            let mut arg_ty = self.get_ssa_type(args[k]);

            let p_ast: &Type = &self.resolver.ast.types()[p_ty_id as usize];
            let p_tag = (*p_ast).get_tag();
            if p_tag != TYPE_PTR && p_tag != TYPE_PTRMUT && p_tag != TYPE_REF && p_tag != TYPE_REFMUT {
                let is_ptr = if k < args_exprs.len { self.is_expr_ptr_value(args_exprs[k], args[k]) } else { false };
                if !is_ptr {
                    let arg_inner = self.get_ptr_inner_type(arg_ty);
                    if arg_inner != 0 as u32 && self.is_aggregate(arg_inner) {
                        arg_ty = arg_inner;
                    }
                }
            }

            self.unify(p_ty_id, arg_ty, inferred, f.type_params);
            k = k + 1 as usize;
        }

        if expected_ret != 0 as u32 {
            let mut ret_ty_in = expected_ret;
            let p_ast_ret: &Type = &self.resolver.ast.types()[f.ret_ty as usize];
            let p_tag_ret = (*p_ast_ret).get_tag();
            if p_tag_ret != TYPE_PTR && p_tag_ret != TYPE_PTRMUT && p_tag_ret != TYPE_REF && p_tag_ret != TYPE_REFMUT {
                 let ret_inner = self.get_ptr_inner_type(ret_ty_in);
                 if ret_inner != 0 as u32 && self.is_aggregate(ret_inner) {
                     ret_ty_in = ret_inner;
                 }
            }
            self.unify(f.ret_ty, ret_ty_in, inferred, f.type_params);
        }

        let i32_ty = self.get_primitive_type(ILPrimitive.I32);
        i = 0 as usize;
        while i < f.type_params.len {
            let p_inf = (inferred as usize + i * 4) as *mut u32;
            if *p_inf == 0 as u32 { *p_inf = i32_ty; }
            i = i + 1 as usize;
        }
        return @slice(inferred, f.type_params.len);
    }

    pub fn emit_const_u64(self: &mut Lowerer, val: u64, ty: u32) -> SSAId {
        return self.builder.emit_const_u64(val, ty);
    }

    pub fn emit_const_f64(self: &mut Lowerer, bits: u64, ty: u32) -> SSAId {
        return self.builder.emit_const_f64(bits, ty);
    }

    // After wrapping arithmetic on narrow types (u8/i8/u16/i16), mask to the correct bit width
    // and sign-extend for signed types, since QBE uses 32-bit registers for all narrow types.
    pub fn emit_narrow_wrap_mask(self: &mut Lowerer, val: SSAId, ty: u32) -> SSAId {
        if ty == 0 as u32 { ICE("get_type_decl 0 at env.zrl:443"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty);
        match (*p_ty).def {
            ILType.Primitive(p) => {
                let u32_ty = self.get_primitive_type(ILPrimitive.U32);
                let i32_ty = self.get_primitive_type(ILPrimitive.I32);
                match p {
                    ILPrimitive.U8 => {
                        let mask = self.emit_const_u64(255 as u64, u32_ty);
                        return self.emit_with_type(ILInstr.And(ILBinaryOp { lhs: val, rhs: mask }), ty);
                    },
                    ILPrimitive.I8 => {
                        let mask = self.emit_const_u64(255 as u64, u32_ty);
                        let masked = self.emit_with_type(ILInstr.And(ILBinaryOp { lhs: val, rhs: mask }), u32_ty);
                        let shift = self.emit_const_u64(24 as u64, u32_ty);
                        let shl = self.emit_with_type(ILInstr.Shl(ILBinaryOp { lhs: masked, rhs: shift }), u32_ty);
                        let sar = self.emit_with_type(ILInstr.Shr(ILBinaryOp { lhs: shl, rhs: shift }), i32_ty);
                        return self.emit_cast(sar, ty);
                    },
                    ILPrimitive.U16 => {
                        let mask = self.emit_const_u64(65535 as u64, u32_ty);
                        return self.emit_with_type(ILInstr.And(ILBinaryOp { lhs: val, rhs: mask }), ty);
                    },
                    ILPrimitive.I16 => {
                        let mask = self.emit_const_u64(65535 as u64, u32_ty);
                        let masked = self.emit_with_type(ILInstr.And(ILBinaryOp { lhs: val, rhs: mask }), u32_ty);
                        let shift = self.emit_const_u64(16 as u64, u32_ty);
                        let shl = self.emit_with_type(ILInstr.Shl(ILBinaryOp { lhs: masked, rhs: shift }), u32_ty);
                        let sar = self.emit_with_type(ILInstr.Shr(ILBinaryOp { lhs: shl, rhs: shift }), i32_ty);
                        return self.emit_cast(sar, ty);
                    },
                    _ => { return val; },
                }
            },
            _ => { return val; },
        }
    }

    pub fn get_current_func(self: &mut Lowerer) -> *mut ILFunction {
        if self.builder.current_func_idx == NO_FUNC { return 0 as *mut ILFunction; }
        return &self.module.functions[self.builder.current_func_idx as usize];
    }

    pub fn next_id(self: &mut Lowerer) -> SSAId {
        return self.builder.next_id();
    }

    pub fn get_symbol_entry(self: &mut Lowerer, sym: &Symbol) -> *mut SymbolMapEntry {
        let mut i = self.symbol_map_base;
        let sz = sizeof(SymbolMapEntry);
        let target = sym as usize;
        while i < self.symbol_map_len {
            let off = i * sz;
            let p = (self.symbol_map as usize + off) as *mut SymbolMapEntry;
            if (*p).sym == target { return p; }
            i = i + 1 as usize;
        }
        return 0 as *mut SymbolMapEntry;
    }


    pub fn get_or_create_symbol_entry(self: &mut Lowerer, sym: &Symbol) -> *mut SymbolMapEntry {
        let p = self.get_symbol_entry(sym);
        if p != 0 as *mut SymbolMapEntry { return p; }
        
        if self.symbol_map_len >= self.symbol_map_cap {
             ICE("Lowerer.get_or_create_symbol_entry: symbol map overflow");
        }
        let sz = sizeof(SymbolMapEntry);
        let off = self.symbol_map_len * sz;
        let p_new = (self.symbol_map as usize + off) as *mut SymbolMapEntry;
        (*p_new).sym = sym as usize;
        (*p_new).ssa = 0 as u64;
        (*p_new).addr_ssa = 0 as u64;
        (*p_new).ty = 0 as u32;
        self.symbol_map_len = self.symbol_map_len + 1 as usize;
        return p_new;
    }

    pub fn set_symbol_ssa(self: &mut Lowerer, sym: &Symbol, ssa: SSAId) {
        let p = self.get_or_create_symbol_entry(sym);
        (*p).ssa = ssa as u64;
        if ssa != 0 as u32 && ssa != 0xffffffff as u32 {
            if self.builder.get_ssa_name(ssa) == 0 as u32 {
                self.builder.set_ssa_name(ssa, sym.name);
            }
        }
    }

    pub fn set_symbol_ssa_ptr(self: &mut Lowerer, sym: *mut Symbol, ssa: SSAId) {
        let mut i = self.symbol_map_base;
        let sz = sizeof(SymbolMapEntry);
        let target = sym as usize;
        let mut p = 0 as *mut SymbolMapEntry;
        unsafe {
        while i < self.symbol_map_len {
            let off = i * sz;
            let cand = (self.symbol_map as usize + off) as *mut SymbolMapEntry;
            if (*cand).sym == target { p = cand; break; }
            i = i + 1 as usize;
        }
        if p == 0 as *mut SymbolMapEntry {
            if self.symbol_map_len >= self.symbol_map_cap {
                ICE("Lowerer.get_or_create_symbol_entry: symbol map overflow");
            }
            let off = self.symbol_map_len * sz;
            p = (self.symbol_map as usize + off) as *mut SymbolMapEntry;
            (*p).sym = target;
            (*p).ssa = 0 as u64;
            (*p).addr_ssa = 0 as u64;
            (*p).ty = 0 as u32;
            self.symbol_map_len = self.symbol_map_len + 1 as usize;
        }
        (*p).ssa = ssa as u64;
        if ssa != 0 as u32 && ssa != 0xffffffff as u32 {
            if self.builder.get_ssa_name(ssa) == 0 as u32 {
                self.builder.set_ssa_name(ssa, (*sym).name);
            }
        }
        }
    }

    pub fn set_symbol_addr_ssa(self: &mut Lowerer, sym: &Symbol, slot: SSAId) {
        let p = self.get_or_create_symbol_entry(sym);
        (*p).addr_ssa = slot as u64;
        if slot != 0 as u32 && slot != 0xffffffff as u32 {
            self.builder.set_ssa_name(slot, sym.name);
        }
    }

    pub fn get_symbol_ssa(self: &mut Lowerer, sym: &Symbol) -> SSAId {
        let p = self.get_symbol_entry(sym);
        if p != 0 as *mut SymbolMapEntry {
            return (*p).ssa as SSAId;
        }
        return NO_SSA as u32;
    }

    pub fn set_ssa_type(self: &mut Lowerer, ssa: SSAId, ty: u32) {
        self.builder.set_ssa_type(ssa, ty);
    }

    pub fn get_ssa_type(self: &mut Lowerer, ssa: SSAId) -> u32 {
        return self.builder.get_ssa_type(ssa);
    }

    pub fn new_block(self: &mut Lowerer) -> BlockId {
        return self.builder.new_block();
    }

    pub fn switch_to_block(self: &mut Lowerer, id: BlockId) {
        self.builder.switch_to_block(id);
    }

    pub fn emit(self: &mut Lowerer, instr: ILInstr) -> SSAId {
        return self.builder.emit(instr);
    }

    pub fn types_match(self: &mut Lowerer, expected: u32, actual: u32) -> bool {
        if expected == actual { return true; }
        if expected == 0 as u32 || actual == 0 as u32 { return true; }

        // Aggregate duality: S in surface vs *S in IL SSA
        let inner_act = self.get_ptr_inner_type(actual);
        if inner_act == expected && self.is_aggregate(expected) { return true; }

        let inner_exp = self.get_ptr_inner_type(expected);
        if inner_exp == actual && self.is_aggregate(actual) { return true; }

        let p_ty_exp: &ILTypeDecl = &self.module.types[expected as usize - 1 as usize];
        let p_ty_act: &ILTypeDecl = &self.module.types[actual as usize - 1 as usize];
        let tag_exp = (*p_ty_exp).def.get_tag();
        let tag_act = (*p_ty_act).def.get_tag();


        // Pointer mutability duality
        if (tag_exp == ILTYPE_PTR || tag_exp == ILTYPE_PTRMUT) && (tag_act == ILTYPE_PTR || tag_act == ILTYPE_PTRMUT) {
            let inner_exp = self.get_ptr_inner_type(expected);
            let inner_act = self.get_ptr_inner_type(actual);
            if inner_exp == inner_act { return true; }
        }

        // Allow same-sized numeric types (e.g. i32 vs u32) for now to reduce regressions
        // if they are both primitives.
        if tag_exp == ILTYPE_PRIMITIVE && tag_act == ILTYPE_PRIMITIVE {
            if self.get_type_size(expected) == self.get_type_size(actual) { return true; }
        }

        return false;
    }

    pub fn is_ptr_depth_mismatch(self: &mut Lowerer, target_ty: u32, arg_ty: u32) -> bool {
        if target_ty == 0 as u32 || arg_ty == 0 as u32 { return false; }
        if target_ty == arg_ty { return false; }
        if target_ty == 0 as u32 { ICE("get_type_decl 0 at env.zrl:615"); }
        let p_tgt: &ILTypeDecl = self.builder.get_type_decl(target_ty);
        if arg_ty == 0 as u32 { ICE("get_type_decl 0 at env.zrl:616"); }
        let p_arg: &ILTypeDecl = self.builder.get_type_decl(arg_ty);
        let tgt_tag = (*p_tgt).def.get_tag();
        let arg_tag = (*p_arg).def.get_tag();
        let tgt_is_ptr = tgt_tag == ILTYPE_PTR || tgt_tag == ILTYPE_PTRMUT;
        let arg_is_ptr = arg_tag == ILTYPE_PTR || arg_tag == ILTYPE_PTRMUT;
        if !tgt_is_ptr || !arg_is_ptr { return false; }
        let tgt_inner = self.get_ptr_inner_type(target_ty);
        let arg_inner = self.get_ptr_inner_type(arg_ty);
        if tgt_inner == arg_inner { return false; }
        if tgt_inner == 0 as u32 { ICE("get_type_decl 0 at env.zrl:625"); }
        let p_tgt_inner: &ILTypeDecl = self.builder.get_type_decl(tgt_inner);
        if arg_inner == 0 as u32 { ICE("get_type_decl 0 at env.zrl:626"); }
        let p_arg_inner: &ILTypeDecl = self.builder.get_type_decl(arg_inner);
        let tgt_inner_tag = (*p_tgt_inner).def.get_tag();
        let arg_inner_tag = (*p_arg_inner).def.get_tag();
        let tgt_inner_is_ptr = tgt_inner_tag == ILTYPE_PTR || tgt_inner_tag == ILTYPE_PTRMUT;
        let arg_inner_is_ptr = arg_inner_tag == ILTYPE_PTR || arg_inner_tag == ILTYPE_PTRMUT;
        return tgt_inner_is_ptr != arg_inner_is_ptr;
    }

    pub fn is_ptr_to_non_ptr_mismatch(self: &mut Lowerer, target_ty: u32, arg_ty: u32) -> bool {
        if target_ty == 0 as u32 || arg_ty == 0 as u32 { return false; }
        if target_ty as usize > self.module.types.len { return false; }
        if arg_ty as usize > self.module.types.len { return false; }
        let p_tgt: &ILTypeDecl = &self.module.types[target_ty as usize - 1 as usize];
        let tgt_tag = (*p_tgt).def.get_tag();
        let is_ptr = tgt_tag == ILTYPE_PTR || tgt_tag == ILTYPE_PTRMUT;
        if !is_ptr { return false; }
        let p_arg: &ILTypeDecl = &self.module.types[arg_ty as usize - 1 as usize];
        let arg_tag = (*p_arg).def.get_tag();
        if arg_tag != ILTYPE_PRIMITIVE { return false; }
        let prim = (*p_arg).def.get_Primitive();
        let ptag = prim.get_tag();
        // usize is the canonical pointer address type; i32 is the default integer literal type
        if ptag == ILPRIM_USIZE || ptag == ILPRIM_I32 { return false; }
        return true;
    }

    pub fn emit_with_type(self: &mut Lowerer, instr: ILInstr, ty: u32) -> SSAId {
        let ssa = self.builder.emit_with_type(instr, ty);
        return ssa;
    }

    pub fn is_implicit_aggregate_ptr(self: &mut Lowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        if ty_id == 0 as u32 { ICE("get_type_decl 0 at env.zrl:660"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);
        let tag = (*p_ty).def.get_tag();
        if tag != ILTYPE_PTR && tag != ILTYPE_PTRMUT { return false; }
        if (*p_ty).name != 0 as u32 { return false; }
        let inner = self.get_ptr_inner_type(ty_id);
        return self.is_aggregate(inner);
    }

    pub fn is_compiler_aggregate_slot(self: &mut Lowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        if ty_id == 0 as u32 { ICE("get_type_decl 0 at env.zrl:670"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);
        // Compiler-generated aggregate slots use ILTYPE_PTR only.
        // User pointers (*mut T, &mut T) use ILTYPE_PTRMUT — never strip those.
        if (*p_ty).def.get_tag() != ILTYPE_PTR { return false; }
        let inner = self.get_ptr_inner_type(ty_id);
        return self.is_aggregate(inner);
    }

    pub fn get_ptr_inner_type(self: &mut Lowerer, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        if ty_id as usize > self.module.types.len {
             ICE("get_ptr_inner_type: ty_id out of bounds");
        }
        if ty_id == 0 as u32 { ICE("get_type_decl 0 at env.zrl:683"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);
        match (*p_ty).def {
            ILType.Ptr(inner) => { return inner; },
            ILType.PtrMut(inner) => { return inner; },
            ILType.Boxed(inner) => { return inner; },
            ILType.BoxedMut(inner) => { return inner; },
            ILType.Slice(s) => { return s.element; },
            ILType.Primitive(_) | ILType.Array(_) | ILType.Fn(_) | ILType.Tuple(_) | ILType.FD(_) |
            ILType.IORing | ILType.User(_) | ILType.Var(_) => { return 0 as u32; },
        }
    }

    pub fn get_type_tag(self: &mut Lowerer, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return NO_SSA as u32; }
        if ty_id == 0 as u32 { ICE("get_type_decl 0 at env.zrl:697"); }
        let p_ty: &ILTypeDecl = self.builder.get_type_decl(ty_id);

        return (*p_ty).def.get_tag();
    }

    pub fn get_ptr_type(self: &mut Lowerer, inner: u32) -> u32 {
        return self.builder.get_ptr_type(inner);
    }

    pub fn get_ptr_mut_type(self: &mut Lowerer, inner: u32) -> u32 {
        return self.builder.get_ptr_mut_type(inner);
    }

    pub fn get_slice_type(self: &mut Lowerer, elem: u32) -> u32 {
        return self.builder.get_slice_type(elem);
    }

    pub fn resolve_sym_type(self: &mut Lowerer, sym: &Symbol) -> u32 {
        let k_tag = sym.kind_tag as u32;
        let k_payload = sym.kind_payload as u32;
        match k_tag {
            SYM_GLOBAL => {
                let p_decl: &Decl = &self.resolver.ast.decls[k_payload as usize];
                let d_tag = (*p_decl).get_tag();
                if d_tag == DECL_FN {
                    let f = (*p_decl).get_Fn();
                    if f.type_params.len == 0 as usize {
                        let func_idx = self.mono.instantiate_function(k_payload, @slice(0 as *mut u32, 0 as usize));
                        let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                        let mut params = zoril_allocator_alloc(self.arena, (*p_func).params_len * 4) as *mut u32;
                        let mut pi = 0 as usize;
                        unsafe {
                            while pi < (*p_func).params_len {
                                let p_param = ((*p_func).params as usize + pi * 12 as usize) as *mut ILParam;
                                *((params as usize + pi * 4) as *mut u32) = (*p_param).ty;
                                pi = pi + 1 as usize;
                            }
                        }
                        let fn_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Fn(ILFn { params: unsafe { @slice(params, (*p_func).params_len) }, ret_ty: (*p_func).ret_ty, is_variadic: (*p_func).is_variadic }) });
                        return self.get_ptr_type(fn_ty);
                    }
                    return self.resolver.resolve_type(f.ret_ty); // Fallback
                } else if d_tag == DECL_CONST {
                    return self.resolver.resolve_type((*p_decl).get_Const().ty);
                } else if d_tag == DECL_STATIC {
                    return self.resolver.resolve_type((*p_decl).get_Static().ty);
                } else if d_tag == DECL_STRUCT {
                    return self.mono.instantiate_type(k_payload, @slice(0 as *mut u32, 0 as usize));
                } else if d_tag == DECL_ENUM {
                    return self.mono.instantiate_type(k_payload, @slice(0 as *mut u32, 0 as usize));
                } else if d_tag == DECL_TYPE_ALIAS {
                    return self.resolver.resolve_type((*p_decl).get_TypeAlias().target);
                } else {
                    ICE("resolve_sym_type: unhandled decl type");
                }
            },
            SYM_FUNCTION => {
                let p_func: &ILFunction = &self.module.functions[k_payload as usize];
                let mut params = zoril_allocator_alloc(self.arena, (*p_func).params_len * 4) as *mut u32;
                let mut pi = 0 as usize;
                unsafe {
                    while pi < (*p_func).params_len {
                        let p_param = ((*p_func).params as usize + pi * 12 as usize) as *mut ILParam;
                        *((params as usize + pi * 4) as *mut u32) = (*p_param).ty;
                        pi = pi + 1 as usize;
                    }
                }
                return self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Fn(ILFn { params: unsafe { @slice(params, (*p_func).params_len) }, ret_ty: (*p_func).ret_ty, is_variadic: (*p_func).is_variadic }) });
            },
            SYM_LOCAL => {
                let p_entry = self.get_symbol_entry(sym);
                if p_entry != 0 as *mut SymbolMapEntry {
                    if (*p_entry).ty != 0 as u32 { return (*p_entry).ty; }
                    return self.get_ssa_type((*p_entry).ssa as SSAId);
                }
                ICE("resolve_sym_type: missing symbol map entry for LOCAL");
                return 0 as u32;
            },
            SYM_PARAM => {
                let p_entry = self.get_symbol_entry(sym);
                if p_entry != 0 as *mut SymbolMapEntry {
                    if (*p_entry).ty != 0 as u32 { return (*p_entry).ty; }
                    return self.get_ssa_type((*p_entry).ssa as SSAId);
                }
                // Fallback to the old logic if for some reason it's not in the map
                // (though it should be, as do_lower_fn puts it there).
                return self.get_ssa_type(sym.kind_payload as u32 + 1 as u32);
            },
            SYM_TYPE => {
                return k_payload;
            },
            SYM_PRIMITIVE => {
                let mut res = 0 as u32;
                if k_payload == ILPRIM_U8 { res = self.get_primitive_type(ILPrimitive.U8); }
                else if k_payload == ILPRIM_U16 { res = self.get_primitive_type(ILPrimitive.U16); }
                else if k_payload == ILPRIM_U32 { res = self.get_primitive_type(ILPrimitive.U32); }
                else if k_payload == ILPRIM_U64 { res = self.get_primitive_type(ILPrimitive.U64); }
                else if k_payload == ILPRIM_USIZE { res = self.get_primitive_type(ILPrimitive.USize); }
                else if k_payload == ILPRIM_I8 { res = self.get_primitive_type(ILPrimitive.I8); }
                else if k_payload == ILPRIM_I16 { res = self.get_primitive_type(ILPrimitive.I16); }
                else if k_payload == ILPRIM_I32 { res = self.get_primitive_type(ILPrimitive.I32); }
                else if k_payload == ILPRIM_I64 { res = self.get_primitive_type(ILPrimitive.I64); }
                else if k_payload == ILPRIM_ISIZE { res = self.get_primitive_type(ILPrimitive.ISize); }
                else if k_payload == ILPRIM_F32 { res = self.get_primitive_type(ILPrimitive.F32); }
                else if k_payload == ILPRIM_F64 { res = self.get_primitive_type(ILPrimitive.F64); }
                else if k_payload == ILPRIM_BOOL { res = self.get_primitive_type(ILPrimitive.Bool); }
                else if k_payload == ILPRIM_CHAR { res = self.get_primitive_type(ILPrimitive.Char); }
                else if k_payload == ILPRIM_UNIT { res = self.get_primitive_type(ILPrimitive.Unit); }
                else if k_payload == ILPRIM_NEVER { res = self.get_primitive_type(ILPrimitive.Never); }
                else { ICE("resolve_sym_type: unhandled primitive tag"); }
                return res;
            },
            SYM_CONST => {
                let p_decl: &Decl = &self.resolver.ast.decls[k_payload as usize];
                match *p_decl {
                    Decl.Const(c) => { return self.resolver.resolve_type(c.ty); },
                    Decl.Fn(_) | Decl.Static(_) | Decl.Struct(_) | Decl.Enum(_) | Decl.Trait(_) |
                    Decl.Impl(_) | Decl.TypeAlias(_) | Decl.Import(_) | Decl.None => { ICE("resolve_sym_type: SYM_CONST not a Decl.Const"); },
                }
            },
            SYM_STATIC => {
                let p_decl: &Decl = &self.resolver.ast.decls[k_payload as usize];
                match *p_decl {
                    Decl.Static(s) => { return self.resolver.resolve_type(s.ty); },
                    Decl.Fn(_) | Decl.Const(_) | Decl.Struct(_) | Decl.Enum(_) | Decl.Trait(_) |
                    Decl.Impl(_) | Decl.TypeAlias(_) | Decl.Import(_) | Decl.None => { ICE("resolve_sym_type: SYM_STATIC not a Decl.Static"); },
                }
            },
            SYM_BUILTIN => {
                return 0 as u32; // Builtins don't have a simple type
            },
            _ => { ICE("resolve_sym_type: unhandled symbol kind"); },
        }
        return 0 as u32;
    }
}
