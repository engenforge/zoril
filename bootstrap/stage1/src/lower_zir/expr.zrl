import "zir.zrl";
import "ast.zrl";
import "resolve.zrl";
import "intern.zrl";
import "mono.zrl";
import "il_type.zrl";
import "il_instr.zrl";
import "vec.zrl";
import "bytevec.zrl";
import "core.zrl";
import "mem.zrl";
import "io.zrl";
import "str.zrl";

impl ZirLowerer {

    // Extracted from lower_expr's Expr.StructLiteral match arm: stage0-C's
    // verifier rejects lower_expr as "too large or complex" once this logic is
    // inlined (it is already near that ceiling from struct_field_expected_ty's own
    // extraction), so anything added to struct-literal lowering has to live in its
    // own function, not in the match arm itself.
    pub fn lower_struct_literal_expr(self: &mut ZirLowerer, s: &StructLiteralExpr, span: Span) -> Place {
            // s.struct_name is an intern_id (name), not a TypeId.
            // Look up the symbol by name, then instantiate the struct type.
            let opt_sym = self.resolver.resolve_ptr(s.struct_name);
            let mut resolved_ty = 0 as u32;
            let mut global_k_payload = 0 as u32;
            match opt_sym {
                Some(sym) => {
                    let k_tag = sym.kind_tag as u32;
                    let k_payload = sym.kind_payload as u32;
                    if k_tag == SYM_GLOBAL {
                        let mut actual_decl_id = k_payload;
                        let p_decl: &Decl = &self.resolver.ast.decls[k_payload as usize];
                        let d_tag = unsafe { p_decl.get_tag() };

                        if d_tag == DECL_TYPE_ALIAS {
                            let alias_target_ty = self.resolver.resolve_type(unsafe { p_decl.get_TypeAlias().target });
                            if alias_target_ty != 0 as u32 {
                                let p_ty_decl: &ILTypeDecl = self.get_type_decl(alias_target_ty);
                                if p_ty_decl.def.get_tag() == ILTYPE_USER {
                                    let user_ty = p_ty_decl.def.get_User();
                                    actual_decl_id = self.mono.get_typedef_origin(user_ty.id);
                                }
                            }
                        }
                        
                        if s.type_args.len > 0 as usize {
                            let resolved_args = self.resolver.resolve_type_list(s.type_args.ptr as *mut u32, s.type_args.len);
                            resolved_ty = self.mono.instantiate_type(actual_decl_id, resolved_args);
                        } else {
                            // Defer type resolution until after fields are lowered for inference
                            global_k_payload = actual_decl_id;
                        }
                    } else if k_tag == SYM_TYPE {
                        resolved_ty = k_payload;
                    }
                },
                None => {
                    self.report_error_with_symbol("unresolved symbol: ", s.struct_name, span);
                }
            }
            // Lower all field values first so their types are available for inference
            let mut val_places = zoril_allocator_alloc(self.arena, s.fields.len * sizeof(Place)) as *mut Place;
            let mut vi = 0 as usize;
            while vi < s.fields.len {
                let p = (val_places as usize + vi * sizeof(Place)) as *mut Place;
                // Give the field's declared type to the value, so `dummy: 1` on a
                // `u8` field types the literal as u8 instead of defaulting to i32
                // and then failing the narrowing check below. Only possible when
                // the struct type is already known: a generic literal's type args
                // are inferred *from* these values, so there is nothing to pass yet.
                let field_expected = self.struct_field_expected_ty(global_k_payload, resolved_ty, s.fields[vi].name);
                unsafe { *p = self.lower_expr(s.fields[vi].value, field_expected); }
                vi = vi + 1 as usize;
            }
            // If no explicit type args, infer from field value types
            if global_k_payload != 0 as u32 {
                let inferred_args = self.infer_generic_type_args_for_struct(global_k_payload, s.fields, val_places, s.fields.len);
                resolved_ty = self.mono.instantiate_type(global_k_payload, inferred_args);
            }
            // Place field values at correct positions
            let mut struct_field_count = s.fields.len;
            if resolved_ty != 0 as u32 {
                let p_ty: &ILTypeDecl = self.get_type_decl(resolved_ty);
                match p_ty.def {
                    ILType.User(u) => {
                        let p_def = &self.module.typedefs[u.id as usize];
                        match *p_def {
                            ILTypeDef.Struct(sd) => { struct_field_count = sd.fields.len; },
                            _ => {},
                        }
                    },
                    _ => {},
                }
            }

            let mut args = zoril_allocator_alloc(self.arena, struct_field_count * sizeof(Place)) as *mut Place;
            let mut ai = 0 as usize;
            while ai < struct_field_count {
                let p_arg = (args as usize + ai * sizeof(Place)) as *mut Place;
                unsafe {
                    (*p_arg).base = 0 as u32;
                    (*p_arg).projections = @slice(0 as *mut Projection, 0 as usize);
                }
                ai = ai + 1 as usize;
            }

            ai = 0 as usize;
            while ai < s.fields.len {
                let mut val_place = unsafe { *((val_places as usize + ai * sizeof(Place)) as *mut Place) };
                if resolved_ty != 0 as u32 {
                    self.check_field_visible(resolved_ty, s.fields[ai].name, span);
                    let field_idx = self.get_field_index(resolved_ty, s.fields[ai].name);
                    if field_idx != 0xffffffff as u32 && field_idx < struct_field_count as u32 {
                        // Struct-literal fields were not type-checked either, so
                        // `Holder { p: some_slice }` stored a two-word descriptor into a
                        // one-word `*mut T` field. Numeric literals still convert, matching
                        // the `let` and argument paths.
                        let decl_field_ty = self.get_field_type(resolved_ty, field_idx);
                        if decl_field_ty != 0 as u32 && val_place.base != 0 as u32 {
                            val_place = self.coerce_array_ref_to_slice(val_place, self.get_place_type(&val_place), decl_field_ty, span);
                            let val_ty = self.get_place_type(&val_place);
                            if val_ty != 0 as u32 && !self.types_match(decl_field_ty, val_ty)
                                && !self.implicit_conv_ok(decl_field_ty, val_ty) {
                                self.report_conv_or_type_mismatch(decl_field_ty, val_ty, span);
                            }
                        }
                        let p_dst = (args as usize + field_idx as usize * sizeof(Place)) as *mut Place;
                        unsafe { *p_dst = val_place; }
                        if decl_field_ty != 0 as u32 && !self.is_copy_type(decl_field_ty) {
                            self.consume_place_if_move(&val_place);
                        }
                    } else {
                        if ai < struct_field_count {
                            let p_dst = (args as usize + ai * sizeof(Place)) as *mut Place;
                            unsafe { *p_dst = val_place; }
                            let fty = self.get_place_type(&val_place);
                            if fty != 0 as u32 && !self.is_copy_type(fty) {
                                self.consume_place_if_move(&val_place);
                            }
                        }
                    }
                } else {
                    if ai < struct_field_count {
                        let p_dst = (args as usize + ai * sizeof(Place)) as *mut Place;
                        unsafe { *p_dst = val_place; }
                        let fty = self.get_place_type(&val_place);
                        if fty != 0 as u32 && !self.is_copy_type(fty) {
                            self.consume_place_if_move(&val_place);
                        }
                    }
                }
                ai = ai + 1 as usize;
            }

            if resolved_ty != 0 as u32 {
                self.check_struct_literal_complete(resolved_ty, args, struct_field_count, span);
            }

            let tmp = self.define_local(0 as *mut Symbol, resolved_ty, LOCAL_KIND_TMP);
            self.emit(ZirStmt.Let(tmp, ZirRvalue.StructLiteral(resolved_ty, unsafe { @slice(args, struct_field_count) }), span));
            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
    }

    pub fn lower_expr(self: &mut ZirLowerer, expr_id: ExprId, expected_ty: u32) -> Place {
        let closure_use_ok = self.closure_use_ok;
        self.closure_use_ok = false;
        let place = self.lower_expr_internal(expr_id, expected_ty);
        // Span of the expression just lowered, for diagnostics raised while consuming its value.
        self.cur_span = self.get_expr_span(expr_id);
        if !closure_use_ok && self.is_capturing_closure_place(&place) {
            self.report_error("capturing closure can only be bound with `let` or called directly (not passed, stored, returned or reassigned)", self.cur_span);
        }
        return place;
    }

    // Factored out of lower_expr_internal's Expr.If match arm (kept as its
    // own function rather than inlined - lower_expr_internal is already an
    // enormous match over every Expr variant, and inlining this pushed it
    // over stage0-C's per-function verification size limit; lower_match is
    // factored out the same way for the same reason).
    //
    // Walks the chain of nested Expr.If in the else-position into a flat
    // list, instead of recursing into lower_expr once per "else if" -
    // machine-generated code (e.g. FlatPrinter's state-machine lowering of
    // a function with many basic blocks, encoded as a single if-expression
    // chain) can produce thousands of "else if" branches, which previously
    // overflowed the stack one lower_expr/lower_expr_internal frame per
    // branch. Uses an iterative loop for the statement-level version of
    // this pattern.
    pub fn lower_if_expr(self: &mut ZirLowerer, i: &IfExpr, expected_ty: u32, span: Span) -> Place {
        let mut conds = Vec::<ExprId>.new_in(self.arena);
        let mut thens = Vec::<ExprId>.new_in(self.arena);
        let mut cur_cond = i.cond;
        let mut cur_then = i.then_block;
        let mut cur_else = i.else_block;
        let mut final_else = 0 as u32;
        loop {
            conds.push(cur_cond);
            thens.push(cur_then);
            if cur_else == 0 as u32 { final_else = 0 as u32; break; }
            let else_expr = self.get_expr(cur_else);
            let mut is_chain_link = false;
            match *else_expr {
                Expr.If(next_i) => {
                    cur_cond = next_i.cond;
                    cur_then = next_i.then_block;
                    cur_else = next_i.else_block;
                    is_chain_link = true;
                },
                _ => {},
            }
            if !is_chain_link { final_else = cur_else; break; }
        }
        let n = conds.len();

        // Emit one (cond, then) link at a time, each link's else-block
        // being where the next condition is checked (or, on the last link,
        // where the chain's trailing else - if any - is lowered).
        let mut then_ends = Vec::<u32>.new_in(self.arena);
        let mut then_vals = Vec::<Place>.new_in(self.arena);
        let mut k = 0 as usize;
        while k < n {
            let cond_place = self.lower_expr(conds[k], 0 as u32);
            self.check_condition(conds[k], &cond_place);
            let then_block_id = self.new_block("if_then");
            let next_else_block_id = self.new_block("if_else");
            self.terminate(ZirTerminator.Branch(cond_place, then_block_id, next_else_block_id));

            self.switch_to_block(then_block_id);
            let then_val = self.lower_expr(thens[k], expected_ty);
            then_vals.push(then_val);
            then_ends.push(self.current_block_idx as u32);

            self.switch_to_block(next_else_block_id);
            k = k + 1 as usize;
        }
        // Positioned in the last link's else-block: lower the chain's
        // trailing else-body, if the chain has one.
        let mut else_val = Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
        if final_else != 0 as u32 {
            else_val = self.lower_expr(final_else, expected_ty);
        }
        let else_end = self.current_block_idx as u32;

        let exit_block_id = self.new_block("if_exit");
        self.switch_to_block(exit_block_id);

        if final_else == 0 as u32 {
            let mut k2 = 0 as usize;
            while k2 < n {
                let te = then_ends[k2];
                if te != 0xffffffff as u32 {
                    let saved = self.current_block_idx as u32;
                    self.switch_to_block(te);
                    if !self.blocks[self.current_block_idx].is_terminated { self.terminate(ZirTerminator.Jmp(exit_block_id)); }
                    self.switch_to_block(saved);
                }
                k2 = k2 + 1 as usize;
            }
            if else_end != 0xffffffff as u32 {
                let saved2 = self.current_block_idx as u32;
                self.switch_to_block(else_end);
                if !self.blocks[self.current_block_idx].is_terminated { self.terminate(ZirTerminator.Jmp(exit_block_id)); }
                self.switch_to_block(saved2);
            }
            return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
        }

        let mut ty = expected_ty;
        if ty == 0 as u32 {
            let mut k3 = 0 as usize;
            while k3 < n && ty == 0 as u32 {
                let tv = then_vals[k3];
                ty = self.get_place_type(&tv);
                k3 = k3 + 1 as usize;
            }
            if ty == 0 as u32 { ty = self.get_place_type(&else_val); }
        }

        if ty != 0 as u32 {
            let tmp = self.define_local(0 as *mut Symbol, ty, LOCAL_KIND_TMP);
            let result_place = Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };

            let mut any_alive = false;
            let mut k4 = 0 as usize;
            while k4 < n {
                let te = then_ends[k4];
                if te != 0xffffffff as u32 {
                    let saved = self.current_block_idx as u32;
                    self.switch_to_block(te);
                    if !self.blocks[self.current_block_idx].is_terminated {
                        any_alive = true;
                        let tv = then_vals[k4];
                        self.emit(ZirStmt.Assign(result_place, ZirRvalue.Use(tv), span));
                        self.terminate(ZirTerminator.Jmp(exit_block_id));
                    }
                    self.switch_to_block(saved);
                }
                k4 = k4 + 1 as usize;
            }

            if else_end != 0xffffffff as u32 {
                let saved2 = self.current_block_idx as u32;
                self.switch_to_block(else_end);
                if !self.blocks[self.current_block_idx].is_terminated {
                    any_alive = true;
                    self.emit(ZirStmt.Assign(result_place, ZirRvalue.Use(else_val), span));
                    self.terminate(ZirTerminator.Jmp(exit_block_id));
                }
                self.switch_to_block(saved2);
            }

            if !any_alive {
                self.terminate(ZirTerminator.Unreachable);
            }

            return result_place;
        }

        // ty == 0: every branch is unit-typed; still need Jmp to exit block
        let mut any_alive = false;
        let mut k5 = 0 as usize;
        while k5 < n {
            let te = then_ends[k5];
            if te != 0xffffffff as u32 {
                let saved = self.current_block_idx as u32;
                self.switch_to_block(te);
                if !self.blocks[self.current_block_idx].is_terminated {
                    any_alive = true;
                    self.terminate(ZirTerminator.Jmp(exit_block_id));
                }
                self.switch_to_block(saved);
            }
            k5 = k5 + 1 as usize;
        }
        if else_end != 0xffffffff as u32 {
            let saved2 = self.current_block_idx as u32;
            self.switch_to_block(else_end);
            if !self.blocks[self.current_block_idx].is_terminated {
                any_alive = true;
                self.terminate(ZirTerminator.Jmp(exit_block_id));
            }
            self.switch_to_block(saved2);
        }

        if !any_alive {
            self.terminate(ZirTerminator.Unreachable);
        }

        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
    }

    // `@str("...")` builds a Str (str.zrl) from a string literal whose UTF-8
    // validity is checked here, at compile time, so no run-time check is needed.
    fn lower_str_intrinsic(self: &mut ZirLowerer, i: &IntrinsicExpr, span: Span) -> Place {
        let none = Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
        let p_arg = if i.args.len == 1 as usize { self.get_expr(i.args[0]) } else { 0 as *mut Expr };
        let is_literal = p_arg as usize != 0 as usize && unsafe { (*p_arg).get_tag() } == EXPR_LITERAL
            && unsafe { (*p_arg).get_Literal().get_tag() } == LITERAL_STRING;
        if !is_literal {
            self.report_error("@str expects one string literal", span);
            return none;
        }
        let bytes = self.intern_table.lookup(unsafe { (*p_arg).get_Literal().get_String() });
        if !utf8_valid(bytes) {
            self.report_error("@str literal is not valid UTF-8", span);
            return none;
        }
        let str_ty = self.lookup_struct_type(self.intern_table.intern("Str"));
        if str_ty == 0 as u32 {
            self.report_error("@str needs the Str type: import \"str.zrl\"", span);
            return none;
        }
        let lit_place = self.lower_expr(i.args[0], 0 as u32);
        let args = zoril_allocator_alloc(self.arena, sizeof(Place)) as *mut Place;
        unsafe { *args = lit_place; }
        let tmp = self.define_local(0 as *mut Symbol, str_ty, LOCAL_KIND_TMP);
        self.emit(ZirStmt.Let(tmp, ZirRvalue.StructLiteral(str_ty, unsafe { @slice(args, 1 as usize) }), span));
        return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
    }

    // The IL type of the non-generic struct named name, or 0 when none is in scope.
    fn lookup_struct_type(self: &mut ZirLowerer, name: u32) -> u32 {
        match self.resolver.resolve_ptr(name) {
            Some(sym) => {
                if sym.kind_tag as u32 == SYM_GLOBAL {
                    let decl_id = sym.kind_payload as u32;
                    if self.resolver.ast.decls[decl_id as usize].get_tag() == DECL_STRUCT {
                        return self.mono.instantiate_type(decl_id, @slice(0 as *mut u32, 0 as usize));
                    }
                }
            },
            None => {},
        }
        return 0 as u32;
    }

    pub fn lower_intrinsic(self: &mut ZirLowerer, i: &IntrinsicExpr, expected_ty: u32, span: Span) -> Place {
        let name_str = self.intern_table.lookup(i.name);
        if is_str_eq(name_str, "syscall") {
            let nargs = i.args.len;
            let mut args = zoril_allocator_alloc(self.arena, nargs * sizeof(Place)) as *mut Place;
            let mut j = 0 as usize;
            while j < nargs {
                let p_arg = (args as usize + j * sizeof(Place)) as *mut Place;
                unsafe { *p_arg = self.lower_expr(i.args[j], 0 as u32); }
                j = j + 1 as usize;
            }
            let res_ty = self.get_primitive_type(ILPrimitive.I64);
            let tmp = self.define_local(0 as *mut Symbol, res_ty, LOCAL_KIND_TMP);
            self.emit(ZirStmt.Let(tmp, ZirRvalue.Syscall(unsafe { @slice(args, nargs) }), span));
            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        if is_str_eq(name_str, "shl_wrap") || is_str_eq(name_str, "shr_wrap") {
            // The explicit opt-out from the shift-count check: the count is masked to the
            // operand's width (`@shl_wrap(x, 33)` on a u32 shifts by 1) and never traps.
            if i.args.len != 2 as usize {
                self.report_error("@shl_wrap and @shr_wrap take two arguments: a value and a count", span);
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            }
            let val_place = self.lower_expr(i.args[0], 0 as u32);
            let val_ty = self.get_place_type(&val_place);
            let cnt_place = self.lower_expr(i.args[1], val_ty);
            if self.integer_bit_width(val_ty) == 0 as u64 {
                self.report_error("@shl_wrap and @shr_wrap need an integer value", span);
            }
            let op = if is_str_eq(name_str, "shl_wrap") { BINARY_SHL_MASKED } else { BINARY_SHR_MASKED };
            let tmp = self.define_local(0 as *mut Symbol, val_ty, LOCAL_KIND_TMP);
            self.emit(ZirStmt.Let(tmp, ZirRvalue.BinaryOp(op, val_place, cnt_place), span));
            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        if is_str_eq(name_str, "slice") {
            let ptr_place = self.lower_expr(i.args[0], 0 as u32);
            let len_place = self.lower_expr(i.args[1], 0 as u32);
            self.check_slice_forge_is_marked(&ptr_place, i.args[1], span);
            let ptr_ty = self.get_place_type(&ptr_place);
            let inner_ty = self.get_ptr_inner_type(ptr_ty);
            // A slice over a `*mut T` / `&mut T` may write; over a `*T` / `&T` it may not.
            // An empty one (literal length 0) has nothing to write: it is `[T]` unless the
            // context asks for a `[mut T]`.
            let mut mutable = ptr_ty != 0 as u32 && self.get_type_decl(ptr_ty).def.get_tag() == ILTYPE_PTRMUT;
            if self.expr_is_literal_zero(i.args[1]) {
                mutable = expected_ty != 0 as u32 && self.get_type_decl(expected_ty).def.get_tag() == ILTYPE_SLICE
                    && self.get_type_decl(expected_ty).def.get_Slice().mutable;
            }
            let slice_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Slice(ILSlice { element: inner_ty, mutable: mutable }) , source_file: 0 as u32 });
            let usize_ty = self.get_usize_type();
            let tmp_len = self.define_local(0 as *mut Symbol, usize_ty, LOCAL_KIND_TMP);
            self.emit(ZirStmt.Let(tmp_len, ZirRvalue.Cast(len_place, usize_ty), span));
            let len_cast_place = Place { base: tmp_len, projections: @slice(0 as *mut Projection, 0 as usize) };
            let mut sl_args = zoril_allocator_alloc(self.arena, 2 as usize * sizeof(Place)) as *mut Place;
            unsafe {
                *sl_args = ptr_place;
                *((sl_args as usize + sizeof(Place)) as *mut Place) = len_cast_place;
            }
            let tmp = self.define_local(0 as *mut Symbol, slice_ty, LOCAL_KIND_TMP);
            self.emit(ZirStmt.Let(tmp, ZirRvalue.StructLiteral(slice_ty, unsafe { @slice(sl_args, 2 as usize) }), span));
            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        if is_str_eq(name_str, "str") {
            return self.lower_str_intrinsic(i, span);
        }
        if is_str_eq(name_str, "saturating_add") {
            let lhs_place = self.lower_expr(i.args[0], 0 as u32);
            let rhs_place = self.lower_expr(i.args[1], 0 as u32);
            let res_ty = self.get_place_type(&lhs_place);
            let mut intr_args = zoril_allocator_alloc(self.arena, 2 as usize * sizeof(Place)) as *mut Place;
            unsafe {
                *intr_args = lhs_place;
                *((intr_args as usize + sizeof(Place)) as *mut Place) = rhs_place;
            }
            let tmp = self.define_local(0 as *mut Symbol, res_ty, LOCAL_KIND_TMP);
            self.emit(ZirStmt.Let(tmp, ZirRvalue.Intrinsic(i.name, unsafe { @slice(intr_args, 2 as usize) }), span));
            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        if is_str_eq(name_str, "region_cast") {
            return self.lower_expr(i.args[0], 0 as u32);
        }
        if is_str_eq(name_str, "ptr_cast") || is_str_eq(name_str, "int_cast") {
            if self.unsafe_depth == 0 as u32 {
                self.report_error("call to intrinsic requires unsafe block", span);
            }
            if i.type_args.len == 0 as usize || i.args.len == 0 as usize {
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            }
            if self.resolver.is_enum_type(i.type_args[0]) {
                self.report_error("cannot cast to enum type: enum discriminants must be constructed via variant constructors", span);
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            }
            let target_ty = self.resolver.resolve_type(i.type_args[0]);
            let val_place = self.lower_expr(i.args[0], 0 as u32);
            let tmp = self.define_local(0 as *mut Symbol, target_ty, LOCAL_KIND_TMP);
            self.locals[tmp as usize - 1 as usize].is_raw_ptr = self.resolver.is_raw_ptr_type(i.type_args[0]);
            self.emit(ZirStmt.Let(tmp, ZirRvalue.Cast(val_place, target_ty), span));
            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        if is_str_eq(name_str, "ptr_from_int") {
            if self.unsafe_depth == 0 as u32 {
                self.report_error("call to intrinsic requires unsafe block", span);
            }
            if i.args.len == 0 as usize {
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            }
            let is_raw = if i.type_args.len > 0 as usize {
                self.resolver.is_raw_ptr_type(i.type_args[0])
            } else {
                true
            };
            let target_ty = if i.type_args.len > 0 as usize {
                self.resolver.resolve_type(i.type_args[0])
            } else {
                self.get_ptr_mut_type(self.get_primitive_type(ILPrimitive.U8))
            };
            let val_place = self.lower_expr(i.args[0], 0 as u32);
            let tmp = self.define_local(0 as *mut Symbol, target_ty, LOCAL_KIND_TMP);
            self.locals[tmp as usize - 1 as usize].is_raw_ptr = is_raw;
            self.emit(ZirStmt.Let(tmp, ZirRvalue.PtrFromInt(val_place, target_ty), span));
            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        if is_str_eq(name_str, "likely") || is_str_eq(name_str, "unlikely") {
            return self.lower_expr(i.args[0], 0 as u32);
        }
        if is_str_eq(name_str, "drop") {
            // Explicit drop: evaluate, invoke destructor, and remove from scope cleanup.
            if i.args.len > 0 as usize {
                let val_place = self.lower_expr(i.args[0], 0 as u32);
                if val_place.base != 0 as u32 {
                    // Tell the checker this drop is the user's: unlike a scope-exit drop, it
                    // must find the value definitely live. Otherwise `if c { sink(r); }
                    // @drop(r);` drops `r` twice. ZIL lowering ignores the marker.
                    if val_place.projections.len == 0 as usize {
                        let mut marked = Vec::<Place>.new_in(self.arena);
                        marked.push(val_place);
                        self.emit(ZirStmt.Intrinsic(self.intern_table.intern("explicit_drop"), marked.as_slice(), span));
                    }
                    // Emit the Drop ZirStmt (calls destructor if applicable)
                    self.emit(ZirStmt.Drop(val_place, span));
                    // A flagged local is dead from here on this path only: clear its flag. Other
                    // locals are removed from scope cleanup (all paths), as before.
                    let mut di = 0 as usize;
                    if val_place.projections.len == 0 as usize && self.drop_flag_of(val_place.base) != 0 as u32 {
                        self.set_drop_flag(val_place.base, 0 as u64, span);
                        di = self.scope_locals.len;
                    }
                    while di < self.scope_locals.len {
                        let lvec: &mut Vec<u32> = &mut self.scope_locals[di];
                        let mut li = 0 as usize;
                        while li < (*lvec).len {
                            if (*lvec)[li] == val_place.base {
                                (*lvec).set(li, 0 as u32); // mark as consumed
                            }
                            li = li + 1 as usize;
                        }
                        di = di + 1 as usize;
                    }
                }
            }
            return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        if is_str_eq(name_str, "alloca") {
            if i.type_args.len == 0 as usize {
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            }
            if i.args.len > 0 as usize {
                let mut count_ok = false;
                let p_arg_expr = self.get_expr(i.args[0]);
                match *p_arg_expr {
                    Expr.Literal(lit) => {
                        if lit.get_tag() == LITERAL_INT && lit.get_Int() == 1 as u64 {
                            count_ok = true;
                        }
                    },
                    _ => {},
                }
                if !count_ok {
                    self.report_error("@alloca<T>(count): only a literal count of 1 is supported; use an array type (e.g. @alloca<[T; N]>(1)) for fixed-size buffers", span);
                }
            }
            let ty = self.resolver.resolve_type(i.type_args[0]);
            let ptr_ty = self.get_ptr_mut_type(ty);
            let t_local = self.define_local(0 as *mut Symbol, ty, LOCAL_KIND_LETMUT);
            self.exempt_from_drop(t_local);
            let ptr_local = self.define_local(0 as *mut Symbol, ptr_ty, LOCAL_KIND_TMP);
            let t_place = Place { base: t_local, projections: @slice(0 as *mut Projection, 0 as usize) };
            self.emit(ZirStmt.Let(t_local, ZirRvalue.Const(0 as u64, ty), span));
            self.emit(ZirStmt.Let(ptr_local, ZirRvalue.RefMut(t_place, 1 as u32), span));
            return Place { base: ptr_local, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
    }

    // Factored out of lower_expr_internal (stage0-C's per-function verification size limit).
    fn lower_array_literal(self: &mut ZirLowerer, al: &ArrayLiteralExpr, expected_ty: u32, span: Span) -> Place {
        let mut args = zoril_allocator_alloc(self.arena, al.elements.len * sizeof(Place)) as *mut Place;
        let mut elem_ty = 0 as u32;
        if expected_ty != 0 as u32 {
            let p_target_ty: &ILTypeDecl = self.get_type_decl(expected_ty);
            if p_target_ty.def.get_tag() == ILTYPE_ARRAY {
                elem_ty = p_target_ty.def.get_Array().element;
            }
        }

        let mut i = 0 as usize;
        while i < al.elements.len {
            let p_arg = (args as usize + i * sizeof(Place)) as *mut Place;
            unsafe { *p_arg = self.lower_expr(al.elements[i], elem_ty); }
            if elem_ty == 0 as u32 {
                elem_ty = unsafe { self.get_place_type(&*p_arg) };
            }
            // The element moves into the array (and is dropped by the array's drop glue).
            let el_ty = unsafe { self.get_place_type(&*p_arg) };
            if el_ty != 0 as u32 && !self.is_copy_type(el_ty) {
                self.consume_place_if_move(unsafe { &*p_arg });
            }
            i = i + 1 as usize;
        }

        let resolved_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Array(ILArray { element: elem_ty, size: al.elements.len as u32 }) , source_file: 0 as u32 });
        let tmp = self.define_local(0 as *mut Symbol, resolved_ty, LOCAL_KIND_TMP);
        self.emit(ZirStmt.Let(tmp, ZirRvalue.Array(elem_ty, unsafe { @slice(args, al.elements.len) }), span));
        return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
    }

    // `[v; n]` up to this many elements is one store per element; above, a loop. Small
    // buffers initialized on every call (sha256's `[0 as u32; 64]` per block) are faster
    // straight-line: at 16, sha's instruction count rose 3%.
    const ARRAY_REPEAT_UNROLL_MAX: usize = 64 as usize;

    fn lower_array_repeat(self: &mut ZirLowerer, r: &ArrayRepeatExpr, expected_ty: u32, span: Span) -> Place {
        let mut elem_ty = 0 as u32;
        if expected_ty != 0 as u32 {
            let p_target_ty: &ILTypeDecl = self.get_type_decl(expected_ty);
            if p_target_ty.def.get_tag() == ILTYPE_ARRAY {
                elem_ty = p_target_ty.def.get_Array().element;
            }
        }
        let val_place = self.lower_expr(r.value, elem_ty);
        if elem_ty == 0 as u32 {
            elem_ty = self.get_place_type(&val_place);
        }

        // The length is a literal or a constant (`const N: usize = ..`).
        let mut count = 0 as usize;
        let len_place = self.lower_expr(r.len, self.get_usize_type());
        let mut len_const = ShiftConst { value: 0 as u64, negative: false };
        if len_place.projections.len == 0 as usize && self.const_temp_value(len_place.base, &mut len_const as *mut ShiftConst, 0 as usize) && !len_const.negative {
            count = len_const.value as usize;
        } else {
            self.report_error("the length of an array repeat `[v; n]` must be a constant", self.get_expr_span(r.len));
        }

        // `[v; n]` copies v n times; a value that needs dropping would then be dropped n times.
        if count > 1 as usize && elem_ty != 0 as u32 && self.type_needs_drop(elem_ty) {
            self.report_error("array repeat expression requires an element that does not need dropping; build the array element by element", span);
        }
        if elem_ty != 0 as u32 && !self.is_copy_type(elem_ty) {
            self.consume_place_if_move(&val_place);
        }
        // Above a handful of elements, one value and a loop (lower_zir_to_zil) rather than
        // one store per element: `[0; 1000000]` was a million instructions.
        if count > ZirLowerer.ARRAY_REPEAT_UNROLL_MAX {
            let rep_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Array(ILArray { element: elem_ty, size: count as u32 }) , source_file: 0 as u32 });
            let rep_tmp = self.define_local(0 as *mut Symbol, rep_ty, LOCAL_KIND_TMP);
            self.emit(ZirStmt.Let(rep_tmp, ZirRvalue.ArrayRepeat(val_place, elem_ty, count as u32), span));
            return Place { base: rep_tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        let mut args = zoril_allocator_alloc(self.arena, count * sizeof(Place)) as *mut Place;
        let mut k = 0 as usize;
        while k < count {
            let p_arg = (args as usize + k * sizeof(Place)) as *mut Place;
            unsafe { *p_arg = val_place; }
            k = k + 1 as usize;
        }

        let resolved_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Array(ILArray { element: elem_ty, size: count as u32 }) , source_file: 0 as u32 });
        let tmp = self.define_local(0 as *mut Symbol, resolved_ty, LOCAL_KIND_TMP);
        self.emit(ZirStmt.Let(tmp, ZirRvalue.Array(elem_ty, unsafe { @slice(args, count) }), span));
        return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
    }

    pub fn lower_expr_internal(self: &mut ZirLowerer, expr_id: ExprId, expected_ty: u32) -> Place {
        let p_expr = self.get_expr(expr_id);
        if p_expr as usize == 0 as usize {
            return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        let span = self.get_expr_span(expr_id);

        match *p_expr {
            Expr.Intrinsic(i) => {
                return self.lower_intrinsic(&i, expected_ty, span);
            },
            Expr.Literal(lit) => {
                let tag = lit.get_tag();
                if tag == LITERAL_STRING {
                    let id = lit.get_String();
                    let u8_ty = self.get_primitive_type(ILPrimitive.U8);
                    let slice_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Slice(ILSlice { element: u8_ty, mutable: false }) , source_file: 0 as u32 });
                    let tmp = self.define_local(0 as *mut Symbol, slice_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(tmp, ZirRvalue.StringConst(id), span));
                    return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                }

                let val_u64 = match tag {
                    LITERAL_INT => lit.get_Int(),
                    LITERAL_BOOL => if lit.get_Bool() { 1 as u64 } else { 0 as u64 },
                    LITERAL_CHAR => lit.get_Char() as u64,
                    LITERAL_FLOAT => { let fval = lit.get_Float(); unsafe { *( (&fval) as *u64 ) } },
                    _ => 0 as u64,
                };
                
                let ty = match tag {
                    LITERAL_INT => {
                        let v = lit.get_Int_full();
                        if v.1 != 0xffffffff as u32 {
                            self.get_primitive_type(self.resolver.map_primitive_tag(v.1))
                        } else if expected_ty != 0 as u32 && self.is_integer_primitive_type(expected_ty) {
                            expected_ty
                        } else if v.0 > 2147483647 as u64 {
                            self.get_primitive_type(ILPrimitive.I64)
                        } else {
                            self.get_primitive_type(ILPrimitive.I32)
                        }
                    },
                    LITERAL_BOOL => self.get_primitive_type(ILPrimitive.Bool),
                    LITERAL_CHAR => self.get_primitive_type(ILPrimitive.U8),
                    LITERAL_FLOAT => self.get_primitive_type(ILPrimitive.F64),
                    _ => 0 as u32,
                };

                let tmp = self.define_local(0 as *mut Symbol, ty, LOCAL_KIND_TMP);
                self.emit(ZirStmt.Let(tmp, ZirRvalue.Const(val_u64, ty), span));
                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.Ident(id) => {
                let opt_sym = self.resolver.resolve_ptr(id);
                match opt_sym {
                    Some(sym) => {
                        let local_id = self.get_local_by_symbol_ref(sym);
                        if local_id != 0 as u32 {
                            return Place { base: local_id, projections: @slice(0 as *mut Projection, 0 as usize) };
                        }
                        let k_tag = sym.kind_tag as u32;
                        let k_payload = sym.kind_payload as u32;
                        if k_tag == SYM_GLOBAL {
                            let p_decl: &Decl = &self.resolver.ast.decls[k_payload as usize];
                            let d_tag = unsafe { p_decl.get_tag() };
                            if d_tag == DECL_CONST {
                                let c = unsafe { p_decl.get_Const() };
                                // A const's DECLARED type is the truth about its
                                // type. Lowering only its initializer meant
                                // `const W: u64 = 4;` yielded an i32 -- the
                                // literal's default -- wherever the caller had no
                                // expectation, so `let x = W;` inferred i32.
                                // src/lower/expr.zrl already did this correctly.
                                let mut want = expected_ty;
                                if want == 0 as u32 { want = self.resolver.resolve_type(c.ty); }
                                return self.lower_expr(c.value, want);
                            } else if d_tag == DECL_STATIC {
                                let s = unsafe { p_decl.get_Static() };
                                let mut gi = 0 as usize;
                                while gi < self.module.globals.len {
                                    if self.module.globals[gi].name == s.name {
                                        let ty = self.module.globals[gi].ty;
                                        let ptr_ty = if s.is_mut { self.get_ptr_mut_type(ty) } else { self.get_ptr_type(ty) };
                                        let tmp = self.define_local(0 as *mut Symbol, ptr_ty, LOCAL_KIND_TMP);
                                        self.emit(ZirStmt.Let(tmp, ZirRvalue.GlobalAddr(gi as u32), span));

                                        let mut projs = zoril_allocator_alloc(self.arena, sizeof(Projection)) as *mut Projection;
                                        unsafe {
                                            *projs = Projection.Deref;
                                            return Place { base: tmp, projections: @slice(projs, 1 as usize) };
                                        }
                                    }
                                    gi = gi + 1 as usize;
                                }
                            } else if d_tag == DECL_FN {
                                let ff = p_decl.get_Fn();
                                let is_pub = ff.is_pub;
                                let sf = ff.source_file;
                                let cur_sf = self.current_source_file;
                                if !is_pub {
                                    if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                        self.report_error_with_symbol("cannot access private function: ", id, span);
                                        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                    }
                                }
                                let func_idx = self.mono.instantiate_function(k_payload, @slice(0 as *mut u32, 0 as usize));
                                let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                                let fn_ty = self.get_fn_type(p_func);
                                let ptr_fn_ty = self.get_ptr_type(fn_ty);
                                let tmp = self.define_local(0 as *mut Symbol, ptr_fn_ty, LOCAL_KIND_TMP);
                                self.emit(ZirStmt.Let(tmp, ZirRvalue.FuncAddr(func_idx), span));
                                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                            }
                        } else if k_tag == SYM_METHOD {
                            let impl_decl_id = k_payload >> 16;
                            let item_idx = k_payload & 0xffff as u32;
                            let p_decl: &Decl = &self.resolver.ast.decls[impl_decl_id as usize];
                            let imp = unsafe { p_decl.get_Impl() };
                            
                            // Check if it's a constant
                            if item_idx as usize < imp.constants.len {
                                let c = &imp.constants[item_idx as usize];
                                return self.lower_expr(c.value, expected_ty);
                            }
                            
                            // If it's a method used as a value
                            if item_idx as usize < imp.methods.len {
                                let f = &imp.methods[item_idx as usize];
                                let self_ty = self.resolver.resolve_type(imp.target_ty);
                                let func_idx = self.mono.instantiate_method(f, @slice(0 as *mut u32, 0 as usize), 0 as u32, f.name, imp, self_ty);
                                let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                                let fn_ty = self.get_fn_type(p_func);
                                let ptr_fn_ty = self.get_ptr_type(fn_ty);
                                let tmp = self.define_local(0 as *mut Symbol, ptr_fn_ty, LOCAL_KIND_TMP);
                                self.emit(ZirStmt.Let(tmp, ZirRvalue.FuncAddr(func_idx), span));
                                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                            }
                        } else if k_tag == SYM_FUNCTION {
                             let p_func: &ILFunction = &self.module.functions[k_payload as usize];
                             let is_pub = p_func.is_pub;
                             let sf = p_func.source_file;
                             let cur_sf = self.current_source_file;
                             if !is_pub {
                                 if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                     self.report_error_with_symbol("cannot access private function: ", id, span);
                                     return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                 }
                             }
                             let fn_ty = self.get_fn_type(p_func);
                             let ptr_fn_ty = self.get_ptr_type(fn_ty);
                             let tmp = self.define_local(0 as *mut Symbol, ptr_fn_ty, LOCAL_KIND_TMP);
                             self.emit(ZirStmt.Let(tmp, ZirRvalue.FuncAddr(k_payload), span));
                             return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                        }
                    },
                    None => {
                        self.report_error_with_symbol("unresolved symbol: ", id, span);
                    }
                }
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.StructLiteral(s) => { return self.lower_struct_literal_expr(&s, span); },
            Expr.TupleLiteral(tl) => {
                let mut args = zoril_allocator_alloc(self.arena, tl.elements.len * sizeof(Place)) as *mut Place;
                let mut types = zoril_allocator_alloc(self.persistent_arena, tl.elements.len * 4) as *mut u32;

                let mut target_tuple_types: *mut u32 = 0 as *mut u32;
                if expected_ty != 0 as u32 {
                    let p_target_ty: &ILTypeDecl = self.get_type_decl(expected_ty);
                    if p_target_ty.def.get_tag() == ILTYPE_TUPLE {
                        let t = p_target_ty.def.get_Tuple();
                        if t.len == tl.elements.len {
                            target_tuple_types = t.ptr;
                        }
                    }
                }

                let mut i = 0 as usize;
                while i < tl.elements.len {
                    let p_arg = (args as usize + i * sizeof(Place)) as *mut Place;
                    let mut elem_target = 0 as u32;
                    unsafe {
                        if target_tuple_types as usize != 0 as usize {
                            elem_target = *( (target_tuple_types as usize + i * 4) as *mut u32 );
                        };
                        *p_arg = self.lower_expr(tl.elements[i], elem_target);
                        let elem_ty = self.get_place_type(&*p_arg);
                        *( (types as usize + i * 4) as *mut u32 ) = elem_ty;
                        if elem_ty != 0 as u32 && !self.is_copy_type(elem_ty) {
                            self.consume_place_if_move(&*p_arg);
                        }
                    }
                    i = i + 1 as usize;
                }

                let resolved_ty = self.module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Tuple(unsafe { @slice(types, tl.elements.len) }) , source_file: 0 as u32 });
                let tmp = self.define_local(0 as *mut Symbol, resolved_ty, LOCAL_KIND_TMP);
                self.emit(ZirStmt.Let(tmp, ZirRvalue.Tuple(unsafe { @slice(args, tl.elements.len) }), span));
                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.ArrayLiteral(al) => {
                return self.lower_array_literal(&al, expected_ty, span);
            },
            Expr.ArrayRepeat(r) => {
                return self.lower_array_repeat(&r, expected_ty, span);
            },
            Expr.Unary(u) => {
                match u.op {
                    UnaryOp.Ref | UnaryOp.RefMut => {
                        let is_mut_ref = u.op.get_tag() != UNARY_REF;
                        let p_inner_expr = self.get_expr(u.expr);
                        if p_inner_expr as usize != 0 && unsafe { (*p_inner_expr).get_tag() } == EXPR_INDEX {
                            // &arr[i] / &mut arr[i] → IndexAddr: compute address without loading
                            let idx_expr = unsafe { (*p_inner_expr).get_Index() };
                            let base_place = self.lower_expr(idx_expr.expr, 0 as u32);
                            let idx_place = self.lower_expr(idx_expr.index, 0 as u32);
                            let base_ty = self.get_place_type(&base_place);
                            let elem_ty = self.get_slice_element_type(base_ty);
                            let ptr_ty = if is_mut_ref { self.get_ptr_mut_type(elem_ty) } else { self.get_ptr_type(elem_ty) };
                            let tmp = self.define_local(0 as *mut Symbol, ptr_ty, LOCAL_KIND_TMP);
                            self.emit(ZirStmt.Let(tmp, ZirRvalue.IndexAddr(base_place, idx_place), span));
                            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                        }
                        let inner_place = self.lower_expr(u.expr, 0 as u32);
                        let inner_ty = self.get_place_type(&inner_place);
                        let ptr_ty = if is_mut_ref { self.get_ptr_mut_type(inner_ty) } else { self.get_ptr_type(inner_ty) };
                        let reg = self.next_region_id;
                        self.next_region_id = self.next_region_id + 1 as u32;
                        let tmp = self.define_local(0 as *mut Symbol, ptr_ty, LOCAL_KIND_TMP);
                        if !is_mut_ref {
                            self.emit(ZirStmt.Let(tmp, ZirRvalue.Ref(inner_place, reg), span));
                        } else {
                            self.emit(ZirStmt.Let(tmp, ZirRvalue.RefMut(inner_place, reg), span));
                        }
                        return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                    },
                    UnaryOp.Deref => {
                        let mut inner_place = self.lower_expr(u.expr, 0 as u32);
                        if self.place_is_raw_ptr(&inner_place) && self.unsafe_depth == 0 as u32 {
                            self.report_error("dereference of raw pointer requires unsafe block", span);
                        }
                        // Append Deref projection
                        let mut new_projs = zoril_allocator_alloc(self.arena, (inner_place.projections.len + 1 as usize) * sizeof(Projection)) as *mut Projection;
                        unsafe {
                            if inner_place.projections.len > 0 as usize {
                                memcpy(new_projs as *mut u8, inner_place.projections.ptr as *u8, inner_place.projections.len * sizeof(Projection));
                            }
                            let p_last = (new_projs as usize + inner_place.projections.len * sizeof(Projection)) as *mut Projection;
                            *p_last = Projection.Deref;
                            inner_place.projections = @slice(new_projs, inner_place.projections.len + 1 as usize);
                        }
                        return inner_place;
                    },
                    _ => {
                        // Propagate the expected type into the operand. `-N` is unary
                        // minus over the literal `N`, so dropping it here typed
                        // `let x: i32 = -2147483648;` as i64 -- the magnitude does not
                        // fit in i32 even though the negated value does -- and the
                        // narrowing check then rejected i32::MIN spelled literally.
                        let inner_place = self.lower_expr(u.expr, expected_ty);
                        let operand_ty = self.get_place_type(&inner_place);
                        let tmp = self.define_local(0 as *mut Symbol, operand_ty, LOCAL_KIND_TMP);
                        self.emit(ZirStmt.Let(tmp, ZirRvalue.UnaryOp(u.op.get_tag(), inner_place), span));
                        return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                    }
                }
            },
            Expr.Binary(b) => {
                let op_tag = b.op.get_tag();
                if op_tag == BINARY_ASSIGN {
                    let lhs_place = self.lower_expr(b.lhs, 0 as u32);
                    let lhs_ty = self.get_place_type(&lhs_place);
                    let mut rhs_place = self.lower_expr(b.rhs, lhs_ty);
                    // Assignment was not type-checked at all: `let x: T = e` and `f(e)` and
                    // `return e` each verified the types, but `x = e` verified nothing, so a
                    // slice (two words) could be stored into a `*mut T` field (one word) with
                    // no diagnostic. Same rule as the `let` path in lower_zir/stmt.zrl,
                    // including its implicit numeric conversion, so widening still works.
                    if lhs_ty != 0 as u32 && rhs_place.base != 0 as u32 {
                        rhs_place = self.coerce_array_ref_to_slice(rhs_place, self.get_place_type(&rhs_place), lhs_ty, span);
                        let rhs_ty = self.get_place_type(&rhs_place);
                        if rhs_ty != 0 as u32 && !self.types_match(lhs_ty, rhs_ty) {
                            if !self.implicit_conv_ok(lhs_ty, rhs_ty) {
                                self.report_conv_or_type_mismatch(lhs_ty, rhs_ty, span);
                            } else {
                                rhs_place = self.emit_cast(rhs_place, lhs_ty, span);
                            }
                        }
                    }
                    self.handle_assign_drop_and_move(lhs_place, lhs_ty, &rhs_place, span);
                    self.emit(ZirStmt.Assign(lhs_place, ZirRvalue.Use(rhs_place), span));
                    return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                } else if op_tag >= 20 as u32 && op_tag <= 32 as u32 {
                    let mut base_op = 0 as u32;
                    if op_tag <= 27 as u32 {
                        base_op = op_tag - 20 as u32;
                    } else {
                        base_op = op_tag - 14 as u32;
                    }
                    let p_lhs_expr2 = self.get_expr(b.lhs);
                    if p_lhs_expr2 as usize != 0 && (*p_lhs_expr2).get_tag() == EXPR_INDEX {
                        let idx_expr2 = (*p_lhs_expr2).get_Index();
                        let base_place2 = self.lower_expr(idx_expr2.expr, 0 as u32);
                        if self.place_is_raw_ptr(&base_place2) && self.unsafe_depth == 0 as u32 {
                            self.report_error("indexing raw pointer requires unsafe block", span);
                        }
                        let idx_place2 = self.lower_expr(idx_expr2.index, 0 as u32);
                        let base_ty2 = self.get_place_type(&base_place2);
                        let elem_ty2 = self.get_slice_element_type(base_ty2);
                        let rhs_place2 = self.lower_expr(b.rhs, elem_ty2);
                        self.check_bool_operands(base_op, elem_ty2, self.get_place_type(&rhs_place2), span);
                        self.check_shift_count(base_op, elem_ty2, &rhs_place2, span);
                        let addr_tmp2 = self.define_local(0 as *mut Symbol, elem_ty2, LOCAL_KIND_TMP);
                        self.emit(ZirStmt.Let(addr_tmp2, ZirRvalue.IndexAddr(base_place2, idx_place2), span));
                        let addr_tmp2_place = Place { base: addr_tmp2, projections: @slice(0 as *mut Projection, 0 as usize) };
                        let result_tmp2 = self.define_local(0 as *mut Symbol, elem_ty2, LOCAL_KIND_TMP);
                        self.emit(ZirStmt.Let(result_tmp2, ZirRvalue.BinaryOp(base_op, addr_tmp2_place, rhs_place2), span));
                        let result_tmp2_place = Place { base: result_tmp2, projections: @slice(0 as *mut Projection, 0 as usize) };
                        self.emit(ZirStmt.Assign(addr_tmp2_place, ZirRvalue.Use(result_tmp2_place), span));
                        // Compound assignment is a statement: it yields no value.
                        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                    }
                    let lhs_place = self.lower_expr(b.lhs, 0 as u32);
                    let lhs_ty = self.get_place_type(&lhs_place);
                    let rhs_place = self.lower_expr(b.rhs, lhs_ty);
                    self.check_bool_operands(base_op, lhs_ty, self.get_place_type(&rhs_place), span);
                    self.check_shift_count(base_op, lhs_ty, &rhs_place, span);
                    self.check_aggregate_scalar_operands(lhs_ty, self.get_place_type(&rhs_place), span);
                    let tmp = self.define_local(0 as *mut Symbol, lhs_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(tmp, ZirRvalue.BinaryOp(base_op, lhs_place, rhs_place), span));
                    let tmp_place = Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                    self.emit(ZirStmt.Assign(lhs_place, ZirRvalue.Use(tmp_place), span));
                    return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                } else if op_tag == 33 as u32 || op_tag == 34 as u32 { // LAnd, LOr
                    let is_and = op_tag == 33 as u32;
                    let bool_ty = self.get_primitive_type(ILPrimitive.Bool);
                    let result_tmp = self.define_local(0 as *mut Symbol, bool_ty, LOCAL_KIND_TMP);
                    let result_place = Place { base: result_tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                    
                    let lhs_place = self.lower_expr(b.lhs, bool_ty);
                    let lhs_lty = self.get_place_type(&lhs_place);
                    if lhs_lty != 0 as u32 && !self.is_bool_type(lhs_lty) {
                        self.report_error("logical operator requires bool operands", span);
                    }
                    self.emit(ZirStmt.Assign(result_place, ZirRvalue.Use(lhs_place), span));
                    
                    let second_block = self.new_block("logic_rhs");
                    let join_block = self.new_block("logic_join");
                    
                    if is_and {
                        self.terminate(ZirTerminator.Branch(lhs_place, second_block, join_block));
                    } else {
                        self.terminate(ZirTerminator.Branch(lhs_place, join_block, second_block));
                    }
                    
                    self.switch_to_block(second_block);
                    let rhs_place = self.lower_expr(b.rhs, bool_ty);
                    let rhs_lty = self.get_place_type(&rhs_place);
                    if rhs_lty != 0 as u32 && !self.is_bool_type(rhs_lty) {
                        self.report_error("logical operator requires bool operands", span);
                    }
                    self.emit(ZirStmt.Assign(result_place, ZirRvalue.Use(rhs_place), span));
                    self.terminate(ZirTerminator.Jmp(join_block));
                    
                    self.switch_to_block(join_block);
                    return result_place;
                } else {
                    let lhs_place = self.lower_expr(b.lhs, 0 as u32);
                    let lhs_ty = self.get_place_type(&lhs_place);
                    let rhs_place = self.lower_expr(b.rhs, lhs_ty);
                    let lhs_ty = self.get_place_type(&lhs_place);
                    let rhs_ty = self.get_place_type(&rhs_place);
                    self.check_bool_operands(op_tag, lhs_ty, rhs_ty, span);
                    self.check_shift_count(op_tag, lhs_ty, &rhs_place, span);
                    self.check_aggregate_scalar_operands(lhs_ty, rhs_ty, span);
                    self.check_equality_operands(op_tag, lhs_ty, rhs_ty, span);
                    let bool_ty = self.get_primitive_type(ILPrimitive.Bool);
                    // Comparison ops (8-13) produce bool; arithmetic/bitwise produce lhs type
                    let res_ty = if op_tag >= 8 as u32 && op_tag <= 13 as u32 { bool_ty } else { lhs_ty };
                    let tmp = self.define_local(0 as *mut Symbol, res_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(tmp, ZirRvalue.BinaryOp(op_tag, lhs_place, rhs_place), span));
                    return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                }
            },
            Expr.Call(c) => {
                let mut callee_expr_id = c.callee;
                let mut p_callee: &Expr = &self.resolver.ast.exprs[callee_expr_id as usize];
                let mut type_args = c.type_args;
                
                if p_callee.get_tag() == EXPR_GENERIC {
                    let g = p_callee.get_Generic();
                    callee_expr_id = g.expr;
                    type_args = g.type_args;
                    p_callee = &self.resolver.ast.exprs[callee_expr_id as usize];
                }
                
                let resolved_type_args = self.resolver.resolve_type_list(type_args.ptr, type_args.len);

                if p_callee.get_tag() == EXPR_MEMBER_ACCESS {
                    let m = p_callee.get_MemberAccess();

                    let resolved_ty = self.lower_expr_as_type(m.expr);
                    if resolved_ty != 0 as u32 {
                        let p_ty: &ILTypeDecl = self.get_type_decl(resolved_ty);
                        let type_name_id = p_ty.name;
                        if type_name_id != 0 as u32 {
                            let opt_method_idx = self.find_method_in_impls(resolved_ty, m.member);
                            match opt_method_idx {
                                Some(decl_idx) => {
                                    let p_impl_decl: &Decl = &self.resolver.ast.decls[decl_idx as usize];
                                    let imp = p_impl_decl.get_Impl();
                                    let mut jk = 0 as usize;
                                    while jk < (*imp).methods.len {
                                        if (*imp).methods[jk].name == m.member {
                                            let m_fn = &(*imp).methods[jk];
                                            let is_pub = m_fn.is_pub;
                                            let sf = if m_fn.source_file != 0 as u32 { m_fn.source_file } else { p_impl_decl.get_Impl().source_file };
                                            let cur_sf = self.current_source_file;
                                            if !is_pub {
                                                if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                                    self.report_error_with_symbol("cannot access private function: ", m.member, span);
                                                    return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                                }
                                            }
                                            let func_idx = self.mono.instantiate_method(&(*imp).methods[jk], resolved_type_args, p_ty.name, m.member, imp, resolved_ty);
                                            let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                                            self.check_extern_call_is_marked(p_func.is_extern, p_func.name, span);
                                            
                                            let direct_sret_offset = self.get_zil_sret_offset(p_func);
                                            let direct_env_offset = if self.needs_env_ptr(p_func.is_extern, p_func.name) { 1 as usize } else { 0 as usize };
                                            let direct_param_base = direct_sret_offset + direct_env_offset;
                                            let direct_expected = if p_func.params_len >= direct_param_base { p_func.params_len - direct_param_base } else { 0 as usize };
                                            if p_func.is_variadic {
                                                if c.args.len < direct_expected {
                                                    self.report_error_with_args("wrong number of arguments (expected ", direct_expected, c.args.len, span);
                                                }
                                            } else {
                                                if c.args.len != direct_expected {
                                                    self.report_error_with_args("wrong number of arguments (expected ", direct_expected, c.args.len, span);
                                                }
                                            }

                                            let mut args = zoril_allocator_alloc(self.arena, c.args.len * sizeof(Place)) as *mut Place;
                                            let mut ai = 0 as usize;
                                            while ai < c.args.len {
                                                let p_arg = (args as usize + ai * sizeof(Place)) as *mut Place;
                                                let mut param_ty = 0 as u32;
                                                if (direct_param_base + ai) < p_func.params_len {
                                                    param_ty = p_func.param(direct_param_base + ai).ty;
                                                };
                                                unsafe { *p_arg = self.lower_expr(c.args[ai], param_ty); }
                                                
                                                if param_ty != 0 as u32 {
                                                    let arg_ty = self.get_place_type(unsafe { &*p_arg });
                                                    if arg_ty != 0 as u32 && !self.types_match(param_ty, arg_ty) {
                                                        if self.implicit_conv_ok(param_ty, arg_ty) {
                                                            unsafe { *p_arg = self.emit_cast(*p_arg, param_ty, span); }
                                                        } else if self.is_primitive_type(arg_ty) && self.is_primitive_type(param_ty) {
                                                            self.report_implicit_conv_error(param_ty, arg_ty, span);
                                                        } else {
                                                            self.maybe_coerce_array_to_slice(unsafe { &mut *p_arg }, arg_ty, param_ty, span);
                                                        }
                                                    }
                                                    
                                                    let final_arg_ty = self.get_place_type(unsafe { &*p_arg });
                                                    if final_arg_ty != 0 as u32 && !self.types_match(param_ty, final_arg_ty) {
                                                        self.report_type_mismatch(param_ty, final_arg_ty, span);
                                                    }
                                                    self.consume_arg_if_move(param_ty, unsafe { &*p_arg });
                                                }
                                                ai = ai + 1 as usize;
                                            }
                                            
                                            let ret_ty = self.get_zil_effective_ret_ty(p_func);
                                            let tmp = self.define_local(0 as *mut Symbol, ret_ty, LOCAL_KIND_TMP);
                                            self.emit(ZirStmt.Let(tmp, ZirRvalue.Call(func_idx, unsafe { @slice(args, c.args.len) }), span));
                                            if self.is_never_type(ret_ty) {
                                                self.terminate(ZirTerminator.Unreachable);
                                            }
                                            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                                        }
                                        jk = jk + 1 as usize;
                                    }
                                },
                                None => {
                                    match p_ty.def {
                                        ILType.User(u) => {
                                            let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                                            if p_def.get_tag() == IL_TYPEDEF_ENUM {
                                                let e = p_def.get_Enum();
                                                let mut v_idx = 0 as usize;
                                                while v_idx < e.variants.len {
                                                    if e.variants[v_idx].name == m.member {
                                                        let mut payload_place = Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                                        if c.args.len > 0 as usize {
                                                            if c.args.len > 1 as usize {
                                                                // Pack multi-args into a tuple
                                                                let variant_payload_ty = e.variants[v_idx].payload;
                                                                let args_mem = zoril_allocator_alloc(self.arena, c.args.len * sizeof(Place)) as *mut Place;
                                                                let mut ai = 0 as usize;
                                                                while ai < c.args.len {
                                                                    let p_a = (args_mem as usize + ai * sizeof(Place)) as *mut Place;
                                                                    let arg_expected = self.get_tuple_elem_type(variant_payload_ty, ai as u32);
                                                                    unsafe { *p_a = self.lower_expr(c.args[ai], arg_expected); }
                                                                    ai = ai + 1 as usize;
                                                                }
                                                                let tmp_payload = self.define_local(0 as *mut Symbol, variant_payload_ty, LOCAL_KIND_TMP);
                                                                self.emit(ZirStmt.Let(tmp_payload, ZirRvalue.Tuple(unsafe { @slice(args_mem, c.args.len) }), span));
                                                                payload_place = Place { base: tmp_payload, projections: @slice(0 as *mut Projection, 0 as usize) };
                                                            } else {
                                                                // Use expected variant payload type if available
                                                                let single_expected = self.get_variant_payload_type(expected_ty, v_idx as u32);
                                                                payload_place = self.lower_expr(c.args[0], single_expected);
                                                            }
                                                        }

                                                        let mut actual_enum_ty = resolved_ty;
if u.type_args.len == 0 as usize && resolved_type_args.len > 0 as usize {
    let u_orig = self.mono.get_typedef_origin(u.id);
    actual_enum_ty = self.mono.instantiate_type(u_orig, resolved_type_args);
} else if u.type_args.len == 0 as usize {
    let u_orig = self.mono.get_typedef_origin(u.id);
    let mut inf_args = @slice(0 as *mut u32, 0 as usize);
    let mut found_expected = false;
    if expected_ty != 0 as u32 {
        let p_exp: &ILTypeDecl = self.get_type_decl(expected_ty);
        if p_exp.def.get_tag() == ILTYPE_USER {
            let exp_user = p_exp.def.get_User();
            if self.mono.get_typedef_origin(exp_user.id) == u_orig {
                inf_args = exp_user.type_args;
                found_expected = true;
            }
        }
    }
    if !found_expected {
        inf_args = self.infer_generic_type_args_for_enum_variant(u_orig, m.member, payload_place);
    }
    actual_enum_ty = self.mono.instantiate_type(u_orig, inf_args);
}

                                                        if c.args.len > 0 as usize {
                                                            let payload_ty = self.get_variant_payload_type(actual_enum_ty, v_idx as u32);
                                                            if c.args.len > 1 as usize {
                                                                // Update tuple type properly
                                                                let p_loc = &mut self.locals[payload_place.base as usize - 1 as usize];
                                                                (*p_loc).ty = payload_ty;
                                                            } else {
                                                                let arg_ty = self.get_place_type(&payload_place);
                                                                if arg_ty != 0 as u32 && payload_ty != 0 as u32 && !self.types_match(payload_ty, arg_ty) {
                                                                    payload_place = self.emit_cast(payload_place, payload_ty, span);
                                                                }
                                                            }
                                                        }

                                                        let tmp = self.define_local(0 as *mut Symbol, actual_enum_ty, LOCAL_KIND_TMP);
                                                        self.emit(ZirStmt.Let(tmp, ZirRvalue.EnumVariant(actual_enum_ty, v_idx as u32, payload_place), span));
                                                        self.consume_place_if_move(&payload_place);
                                                        return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                                                    }
                                                    v_idx = v_idx + 1 as usize;
                                                }
                                            }
                                        },
                                        _ => {},
                                    }
                                }                            }
                        }
                    } else {
                        let receiver_place = self.lower_expr(m.expr, 0 as u32);
                        let mut current_place = receiver_place;
                        let mut current_ty = self.get_place_type(&current_place);
                        
                        let mut lookup_ty = current_ty;
                        let mut lookup_place = current_place;
                        let mut peeled_deref = false;
                        let mut peeled_place = Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                        while true {
                            if lookup_ty == 0 as u32 { break; }
                            let p_ty_it: &ILTypeDecl = self.get_type_decl(lookup_ty);
                            let ty_tag = p_ty_it.def.get_tag();
                            if ty_tag == ILTYPE_PTR || ty_tag == ILTYPE_PTRMUT || ty_tag == ILTYPE_BOXED || ty_tag == ILTYPE_BOXEDMUT {
                                let inner = self.get_ptr_inner_type(lookup_ty);
                                if inner == 0 as u32 { break; }
                                let p_ty_inner: &ILTypeDecl = self.get_type_decl(inner);
                                let inner_tag = p_ty_inner.def.get_tag();
                                if inner_tag == ILTYPE_USER || inner_tag == ILTYPE_TUPLE || inner_tag == ILTYPE_SLICE {
                                    lookup_ty = inner;
                                    break;
                                }
                                peeled_place = lookup_place;
                                peeled_deref = true;
                                self.check_raw_deref_is_marked(&lookup_place, span);
                                lookup_place = self.append_deref(&lookup_place);
                                lookup_ty = inner;
                            } else {
                                break;
                            }
                        }

                        let opt_method_idx = self.find_method_in_impls(lookup_ty, m.member);
                        match opt_method_idx {
                            Some(decl_idx) => {
                                current_place = lookup_place;
                                current_ty = lookup_ty;
                                
                                let p_impl_decl: &Decl = &self.resolver.ast.decls[decl_idx as usize];
                                let imp = p_impl_decl.get_Impl();
                                let mut jk = 0 as usize;
                                while jk < (*imp).methods.len {
                                    if (*imp).methods[jk].name == m.member {
                                        let method_type_args = resolved_type_args;
                                        let p_ty: &ILTypeDecl = self.get_type_decl(current_ty);
                                        
                                        let func_idx = self.mono.instantiate_method(&(*imp).methods[jk], method_type_args, p_ty.name, m.member, imp, current_ty);
                                        let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                                        
                                        let sret_offset = self.get_zil_sret_offset(p_func);
                                        let env_offset = if self.needs_env_ptr(p_func.is_extern, p_func.name) { 1 as usize } else { 0 as usize };
                                        self.check_extern_call_is_marked(p_func.is_extern, p_func.name, span);
                                        let direct_param_base = sret_offset + env_offset;
                                        let direct_expected = if p_func.params_len >= direct_param_base { p_func.params_len - direct_param_base } else { 0 as usize };
                                        let user_expected = if direct_expected > 0 as usize { direct_expected - 1 as usize } else { 0 as usize };
                                        if p_func.is_variadic {
                                            if c.args.len < user_expected {
                                                self.report_error_with_args("wrong number of arguments (expected ", user_expected, c.args.len, span);
                                            }
                                        } else {
                                            if c.args.len != user_expected {
                                                self.report_error_with_args("wrong number of arguments (expected ", user_expected, c.args.len, span);
                                            }
                                        }
                                        
                                        let recv_param = p_func.param(sret_offset + env_offset);
                                        let expected_recv_ty = recv_param.ty;

                                        // `q.method()` where `q: *mut P` and the callee declares
                                        // `self: &P` auto-derefs a raw pointer with no `Deref` node
                                        // to catch, because the IL erases `&T` and `*T` to the same
                                        // `Ptr` tag and `types_match` therefore lets the raw
                                        // receiver through. `ILParam.is_raw_ptr` is what tells the
                                        // two apart: flag only when the receiver is raw and the
                                        // callee's own receiver is not. A method that genuinely
                                        // declares `self: *mut T` (e.g. ByteVec.push) dereferences
                                        // nothing at the call site and must not be flagged. The
                                        // explicit `(*q).method()` form is already caught by the
                                        // deref check, so skip it here to avoid a double report.
                                        if !peeled_deref && !recv_param.is_raw_ptr
                                            && self.place_is_raw_ptr(&current_place)
                                            && self.unsafe_depth == 0 as u32 {
                                            self.report_error("dereference of raw pointer requires unsafe block", span);
                                        }

                                        // Decide autoref from the exact pointer relationship, not
                                        // from `types_match`: that one deliberately accepts an
                                        // aggregate `T` where `&T` is expected, which would pass a
                                        // struct receiver by value and so move it out of a
                                        // non-Copy local (tests/language/memory/method_autoref_no_move.zrl).
                                        // The place must itself hold the value: a raw-pointer
                                        // receiver keeps its pointer place with `current_ty` naming
                                        // the pointee, and is passed through unchanged.
                                        let mut receiver_final_place = current_place;
                                        let m_decl = &(*imp).methods[jk];
                                        let recv_by_ref = m_decl.params.len > 0 as usize
                                            && self.resolver.is_ref_or_ptr_type(m_decl.params[0].ty);
                                        let wants_ref = recv_by_ref && !peeled_deref
                                            && self.get_place_type(&current_place) == current_ty
                                            && self.get_ptr_inner_type(expected_recv_ty) == current_ty;
                                        if !wants_ref && !self.types_match(expected_recv_ty, current_ty) {
                                            if self.get_ptr_inner_type(expected_recv_ty) == current_ty {
                                                if peeled_deref {
                                                    receiver_final_place = peeled_place;
                                                }
                                            } else if self.get_ptr_inner_type(current_ty) == expected_recv_ty {
                                                self.check_raw_deref_is_marked(&current_place, span);
                                                receiver_final_place = self.append_deref(&current_place);
                                            }
                                        }

                                        let total_args_len = c.args.len + 1 as usize;
                                        let mut final_args = zoril_allocator_alloc(self.arena, total_args_len * sizeof(Place)) as *mut Place;
                                        unsafe { *( (final_args as usize) as *mut Place ) = receiver_final_place; }
                                        
                                        let sret_offset = self.get_zil_sret_offset(p_func);
                                        let env_offset = if self.needs_env_ptr(p_func.is_extern, p_func.name) { 1 as usize } else { 0 as usize };
                                        self.check_extern_call_is_marked(p_func.is_extern, p_func.name, span);
                                        let param_base_idx = sret_offset + env_offset + 1 as usize;

                                        let mut ai = 0 as usize;
                                        while ai < c.args.len {
                                            let p_arg = (final_args as usize + (ai + 1 as usize) * sizeof(Place)) as *mut Place;
                                            let mut param_ty = 0 as u32;
                                            if (param_base_idx + ai) < p_func.params_len {
                                                param_ty = p_func.param(param_base_idx + ai).ty;
                                            };
                                            unsafe { *p_arg = self.lower_expr(c.args[ai], param_ty); }
                                            
                                            if param_ty != 0 as u32 {
                                                let arg_ty = self.get_place_type(unsafe { &*p_arg });
                                                if arg_ty != 0 as u32 && !self.types_match(param_ty, arg_ty) {
                                                    if self.implicit_conv_ok(param_ty, arg_ty) {
                                                        unsafe { *p_arg = self.emit_cast(*p_arg, param_ty, span); }
                                                    } else if self.is_primitive_type(arg_ty) && self.is_primitive_type(param_ty) {
                                                        self.report_implicit_conv_error(param_ty, arg_ty, span);
                                                    } else {
                                                        self.maybe_coerce_array_to_slice(unsafe { &mut *p_arg }, arg_ty, param_ty, span);
                                                    }
                                                }
                                            
    let final_arg_ty = self.get_place_type(unsafe { &*p_arg });
    if final_arg_ty != 0 as u32 && !self.types_match(param_ty, final_arg_ty) {
        self.report_type_mismatch(param_ty, final_arg_ty, span);
    }
    self.consume_arg_if_move(param_ty, unsafe { &*p_arg });
}
                                            ai = ai + 1 as usize;
                                        }
                                        
                                        // The receiver borrow is taken only now, after the
                                        // arguments are evaluated (a two-phase borrow), so
                                        // `self.define(self.table.intern(..))` is accepted.
                                        if wants_ref {
                                            unsafe { *final_args = self.emit_receiver_ref(current_place, current_ty, expected_recv_ty, span); }
                                        }

                                        let ret_ty = self.get_zil_effective_ret_ty(p_func);
                                        let tmp = self.define_local(0 as *mut Symbol, ret_ty, LOCAL_KIND_TMP);
                                        self.emit(ZirStmt.Let(tmp, ZirRvalue.Call(func_idx, unsafe { @slice(final_args, total_args_len) }), span));
                                        if self.is_never_type(ret_ty) {
                                            self.terminate(ZirTerminator.Unreachable);
                                        }
                                        return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                                    }
                                    jk = jk + 1 as usize;
                                }
                            },
                            None => {}
                        }
                    }
                }

                let mut is_direct = false;
                let mut direct_func_idx = 0 as u32;

                // Pre-resolve the callee to get param types for argument type inference
                let mut pre_resolved_func_idx = 0xffffffff as u32;
                if p_callee.get_tag() == EXPR_IDENT {
                    let id = p_callee.get_Ident();
                    let opt_sym = self.resolver.resolve_ptr(id);
                    match opt_sym {
                        Some(sym) => {
                            let k_tag = sym.kind_tag as u32;
                            let k_payload = sym.kind_payload as u32;
                            if k_tag == SYM_FUNCTION {
                                let p_func: &ILFunction = &self.module.functions[k_payload as usize];
                                let is_pub = p_func.is_pub;
                                let sf = p_func.source_file;
                                let cur_sf = self.current_source_file;
                                if !is_pub {
                                    if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                        self.report_error_with_symbol("cannot access private function: ", id, span);
                                        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                    }
                                }
                                pre_resolved_func_idx = k_payload;
                            } else if k_tag == SYM_GLOBAL {
                                let p_dd: &Decl = &self.resolver.ast.decls[k_payload as usize];
                                if p_dd.get_tag() == DECL_FN {
                                    let ff = p_dd.get_Fn();
                                    let is_pub = ff.is_pub;
                                    let sf = ff.source_file;
                                    let cur_sf = self.current_source_file;
                                    if !is_pub {
                                        if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                            self.report_error_with_symbol("cannot access private function: ", id, span);
                                            return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                        }
                                    }
                                    if ff.type_params.len == 0 as usize {
                                        // Non-generic: safe to pre-instantiate
                                        let pfi = self.mono.instantiate_function(k_payload, @slice(0 as *mut u32, 0 as usize));
                                        pre_resolved_func_idx = pfi;
                                    }
                                }
                            } else if k_tag == SYM_METHOD {
                                let impl_decl_id = k_payload >> 16;
                                let method_idx = k_payload & 0xffff as u32;
                                let p_decl: &Decl = &self.resolver.ast.decls[impl_decl_id as usize];
                                let imp = p_decl.get_Impl();
                                let f = &imp.methods[method_idx as usize];
                                if f.type_params.len == 0 as usize {
                                    let self_ty = self.resolver.resolve_type(imp.target_ty);
                                    pre_resolved_func_idx = self.mono.instantiate_method(f, @slice(0 as *mut u32, 0 as usize), 0 as u32, f.name, imp, self_ty);
                                }
                            }
                        },
                        None => {}
                    }
                }

                let mut args = zoril_allocator_alloc(self.arena, c.args.len * sizeof(Place)) as *mut Place;
                let mut ai = 0 as usize;
                while ai < c.args.len {
                    let p_arg = (args as usize + ai * sizeof(Place)) as *mut Place;
                    let mut arg_expected = 0 as u32;
                    // If we pre-resolved the function, use its param types as expected types
                    if pre_resolved_func_idx != 0xffffffff as u32 {
                        let p_pf: &ILFunction = &self.module.functions[pre_resolved_func_idx as usize];
                        let sret_off = if self.requires_pass_by_ref(p_pf.ret_ty) { 1 as usize } else { 0 as usize };
                        let env_off = if self.needs_env_ptr(p_pf.is_extern, p_pf.name) { 1 as usize } else { 0 as usize };
                        let pb = sret_off + env_off;
                        if pb + ai < p_pf.params_len {
                            let pt = p_pf.param(pb + ai).ty;
                            // If param is PTR to aggregate, use the inner aggregate type as expected
                            let inner_pt = self.get_ptr_inner_type(pt);
                            if inner_pt != 0 as u32 && self.is_aggregate(inner_pt) {
                                arg_expected = inner_pt;
                            } else {
                                arg_expected = pt;
                            }
                        }
                    }
                    let lowered = self.lower_expr(c.args[ai], arg_expected);
                    unsafe { *p_arg = lowered; }
                    ai = ai + 1 as usize;
                }

                if p_callee.get_tag() == EXPR_IDENT {
                    let id = p_callee.get_Ident();
                    let opt_sym = self.resolver.resolve_ptr(id);
                    match opt_sym {
                        Some(sym) => {
                            let k_tag = sym.kind_tag as u32;
                            let k_payload = sym.kind_payload as u32;
                            if k_tag == SYM_FUNCTION {
                                let p_func: &ILFunction = &self.module.functions[k_payload as usize];
                                let is_pub = p_func.is_pub;
                                let sf = p_func.source_file;
                                let cur_sf = self.current_source_file;
                                if !is_pub {
                                    if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                        self.report_error_with_symbol("cannot access private function: ", id, span);
                                        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                    }
                                }
                                is_direct = true;
                                direct_func_idx = k_payload;
                            } else if k_tag == SYM_GLOBAL {
                                let p_dd: &Decl = &self.resolver.ast.decls[k_payload as usize];
                                if p_dd.get_tag() == DECL_FN {
                                    let ff = p_dd.get_Fn();
                                    let is_pub = ff.is_pub;
                                    let sf = ff.source_file;
                                    let cur_sf = self.current_source_file;
                                    if !is_pub {
                                        if sf != 0 as u32 && cur_sf != 0 as u32 && sf != cur_sf {
                                            self.report_error_with_symbol("cannot access private function: ", id, span);
                                            return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                        }
                                    }
                                }
                                is_direct = true;
                                let mut effective_type_args = resolved_type_args;
                                if effective_type_args.len == 0 as usize {
                                    effective_type_args = self.infer_generic_type_args_for_fn(k_payload, args, c.args.len);
                                }
                                if !self.check_fn_type_arg_bounds(k_payload, effective_type_args, span) {
                                    return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                }
                                direct_func_idx = self.mono.instantiate_function(k_payload, effective_type_args);
                            } else if k_tag == SYM_METHOD {
                                is_direct = true;
                                let impl_decl_id = k_payload >> 16;
                                let method_idx = k_payload & 0xffff as u32;
                                
                                let p_decl: &Decl = &self.resolver.ast.decls[impl_decl_id as usize];
                                let imp = p_decl.get_Impl();
                                let f = &imp.methods[method_idx as usize];
                                
                                let mut effective_type_args = resolved_type_args;
                                if effective_type_args.len == 0 as usize {
                                    // FIXME: this is tricky for methods as they have both self and method generics
                                    effective_type_args = @slice(0 as *mut u32, 0 as usize);
                                }
                                
                                // Get self_ty from the ImplDecl target_ty
                                let self_ty = self.resolver.resolve_type(imp.target_ty);
                                
                                direct_func_idx = self.mono.instantiate_method(f, effective_type_args, 0 as u32, f.name, imp, self_ty);
                            }
                        },
                        None => {}
                    }
                }

                if is_direct {
                    let p_func: &ILFunction = &self.module.functions[direct_func_idx as usize];

                    self.check_extern_call_is_marked(p_func.is_extern, p_func.name, span);
                    let direct_sret_offset = self.get_zil_sret_offset(p_func);
                    let direct_env_offset = if self.needs_env_ptr(p_func.is_extern, p_func.name) { 1 as usize } else { 0 as usize };
                    let direct_param_base = direct_sret_offset + direct_env_offset;
                    let direct_expected = if p_func.params_len >= direct_param_base { p_func.params_len - direct_param_base } else { 0 as usize };
                    if p_func.is_variadic {
                        if c.args.len < direct_expected {
                            self.report_error_with_args("wrong number of arguments (expected ", direct_expected, c.args.len, span);
                        }
                    } else {
                        if c.args.len != direct_expected {
                            self.report_error_with_args("wrong number of arguments (expected ", direct_expected, c.args.len, span);
                        }
                    }
                    let mut ai2 = 0 as usize;
                    while ai2 < c.args.len && (direct_param_base + ai2) < p_func.params_len {
                        let p_arg = (args as usize + ai2 * sizeof(Place)) as *mut Place;
                        let param_ty = p_func.param(direct_param_base + ai2).ty;
                        let arg_ty = self.get_place_type(unsafe { &*p_arg });
                        if arg_ty != 0 as u32 && param_ty != 0 as u32 && !self.types_match(param_ty, arg_ty) {
                            if self.implicit_conv_ok(param_ty, arg_ty) {
                                unsafe { *p_arg = self.emit_cast(*p_arg, param_ty, span); }
                            } else if self.is_primitive_type(arg_ty) && self.is_primitive_type(param_ty) {
                                self.report_implicit_conv_error(param_ty, arg_ty, span);
                            } else {
                                self.maybe_coerce_array_to_slice(unsafe { &mut *p_arg }, arg_ty, param_ty, span);
                            }
                        }
                        let final_arg_ty = self.get_place_type(unsafe { &*p_arg });
                        if final_arg_ty != 0 as u32 && param_ty != 0 as u32 && !self.types_match(param_ty, final_arg_ty) {
                            self.report_type_mismatch(param_ty, final_arg_ty, span);
                        }
                        self.consume_arg_if_move(param_ty, unsafe { &*p_arg });
                        ai2 = ai2 + 1 as usize;
                    }

                    let ret_ty = self.get_zil_effective_ret_ty(p_func);
                    let tmp = self.define_local(0 as *mut Symbol, ret_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(tmp, ZirRvalue.Call(direct_func_idx, unsafe { @slice(args, c.args.len) }), span));
                    if self.is_never_type(ret_ty) {
                        self.terminate(ZirTerminator.Unreachable);
                    }
                    return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                } else {
                    self.closure_use_ok = true;
                    let callee_place = self.lower_expr(callee_expr_id, 0 as u32);
                    let fn_ptr_ty = self.get_place_type(&callee_place);
                    let mut inner_ty = 0 as u32;
                    if fn_ptr_ty != 0 as u32 {
                        let p_fty: &ILTypeDecl = self.get_type_decl(fn_ptr_ty);
                        if p_fty.def.get_tag() == ILTYPE_FN {
                            inner_ty = fn_ptr_ty;
                        } else if p_fty.def.get_tag() == ILTYPE_PTR || p_fty.def.get_tag() == ILTYPE_PTRMUT {
                            let ptr_inner = self.get_ptr_inner_type(fn_ptr_ty);
                            if ptr_inner != 0 as u32 {
                                let p_pfty: &ILTypeDecl = self.get_type_decl(ptr_inner);
                                if p_pfty.def.get_tag() == ILTYPE_FN {
                                    inner_ty = ptr_inner;
                                }
                            }
                        }
                    }
                    
                    if inner_ty == 0 as u32 {
                         let callee_span = self.get_expr_span(callee_expr_id);
                         self.report_error("Failed to resolve callee", callee_span);
                         return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                    }
                    
                    let p_inner_ty: &ILTypeDecl = self.get_type_decl(inner_ty);
                    let f_def = p_inner_ty.def.get_Fn();
                    let ret_ty = f_def.ret_ty;
                    
                    let tmp = self.define_local(0 as *mut Symbol, ret_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(tmp, ZirRvalue.CallPtr(callee_place, unsafe { @slice(args, c.args.len) }), span));
                    if self.is_never_type(ret_ty) {
                        self.terminate(ZirTerminator.Unreachable);
                    }
                    return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                }
            },
            Expr.MemberAccess(m) => {
                let p_base_expr = self.get_expr(m.expr);
                if p_base_expr as usize != 0 as usize {
                    if (*p_base_expr).get_tag() == EXPR_IDENT || (*p_base_expr).get_tag() == EXPR_GENERIC {
                        // For Generic expressions (e.g., Option::<i32>), use lower_expr_as_type
                        // to get the resolved type, then look for enum variants
                        if (*p_base_expr).get_tag() == EXPR_GENERIC {
                            let resolved_ty = self.lower_expr_as_type(m.expr);
                            let pl = self.try_lower_enum_variant_member(resolved_ty, m.member, expected_ty, span);
                            if pl.base != 0 as u32 {
                                return pl;
                            }
                        }
                        let id = if (*p_base_expr).get_tag() == EXPR_IDENT {
                            (*p_base_expr).get_Ident()
                        } else {
                            // For Generic, get the inner ident for impl constant lookup
                            let g = (*p_base_expr).get_Generic();
                            let p_inner = self.get_expr(g.expr);
                            if p_inner as usize != 0 as usize && (*p_inner).get_tag() == EXPR_IDENT {
                                (*p_inner).get_Ident()
                            } else {
                                0 as u32
                            }
                        };
                        let opt_sym = if id != 0 as u32 { self.resolver.resolve_ptr(id) } else { Option.None };
                        match opt_sym {
                            Some(sym) => {
                                let k_tag = sym.kind_tag as u32;
                                if k_tag == SYM_GLOBAL || k_tag == SYM_TYPE || k_tag == SYM_PRIMITIVE {
                                    let resolved_ty = self.resolve_sym_type(sym);
                                    let pl = self.try_lower_enum_variant_member(resolved_ty, m.member, expected_ty, span);
                                    if pl.base != 0 as u32 {
                                        return pl;
                                    }
                                    let pl2 = self.try_lower_impl_constant(id, m.member, expected_ty);
                                    if pl2.base != 0 as u32 {
                                        return pl2;
                                    }
                                    // `K.Nope` on a type: there is no value to take a field of.
                                    if self.sym_names_type(sym) {
                                        self.report_prefix(span);
                                        must_write(2, "no variant or associated constant `");
                                        must_write(2, self.intern_table.lookup(m.member));
                                        must_write(2, "` in `");
                                        must_write(2, self.mono.type_display(resolved_ty));
                                        must_write(2, "`\n");
                                        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                                    }
                                }
                            },
                            None => {}
                        }
                    }
                }

                let inner_place = self.lower_expr(m.expr, 0 as u32);
                let array_len = self.array_len_of(self.get_place_type(&inner_place), m.member);
                if array_len != 0xffffffff as u32 {
                    let usize_ty = self.get_usize_type();
                    let tmp = self.define_local(0 as *mut Symbol, usize_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(tmp, ZirRvalue.Const(array_len as u64, usize_ty), span));
                    return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                }
                self.check_field_visible(self.get_place_type(&inner_place), m.member, span);
                return self.append_projection(&inner_place, Projection.Field(m.member));
            },
            Expr.TupleAccess(t) => {
                let inner_place = self.lower_expr(t.expr, 0 as u32);
                return self.append_projection(&inner_place, Projection.TupleIndex(t.index as u32));
            },
            Expr.Index(idx_expr) => {
                let base_place = self.lower_expr(idx_expr.expr, 0 as u32);
                // `p[i]` on a raw pointer is unchecked arithmetic plus a load, the same
                // operation as `*(p + i)`. The compound-assignment path already gated
                // this; plain reads and plain `p[i] = v` writes both come through here
                // and were escaping the check entirely.
                if self.place_is_raw_ptr(&base_place) && self.unsafe_depth == 0 as u32 {
                    self.report_error("indexing raw pointer requires unsafe block", span);
                }
                let idx_place = self.lower_expr(idx_expr.index, 0 as u32);
                
                let mut idx_local_id = 0 as u32;
                if idx_place.projections.len == 0 as usize {
                    idx_local_id = idx_place.base;
                } else {
                    let idx_ty = self.get_place_type(&idx_place);
                    idx_local_id = self.define_local(0 as *mut Symbol, idx_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(idx_local_id, ZirRvalue.Use(idx_place), span));
                }

                return self.append_projection(&base_place, Projection.Index(idx_local_id));
            },
            Expr.Cast(c) => {
                let inner_place = self.lower_expr(c.expr, 0 as u32);
                let target_ty = self.resolver.resolve_type(c.target_ty);
                self.check_cast_validity(&c, &inner_place, target_ty, span);
                let tmp = self.define_local(0 as *mut Symbol, target_ty, LOCAL_KIND_TMP);
                // A plain `expr as *mut T` produces a raw pointer just as much as the
                // `@ptr_cast` family does, and the temp it lands in is what a later
                // `let q = …;` copies its raw-ness from when the binding has no declared type.
                // Without this, `let q: *mut T = p as *mut T;` was caught but the inferred
                // `let q = p as *mut T;` was not, and every deref through `q` escaped the check.
                self.locals[tmp as usize - 1 as usize].is_raw_ptr = self.resolver.is_raw_ptr_type(c.target_ty);
                self.emit(ZirStmt.Let(tmp, ZirRvalue.Cast(inner_place, target_ty), span));
                self.consume_place_if_move(&inner_place);
                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.If(i) => {
                return self.lower_if_expr(&i, expected_ty, span);
            },
            Expr.Match(m) => {
                return self.lower_match(&m, expected_ty);
            },
            Expr.Try(try_expr_id) => {
                let val_place = self.lower_expr(try_expr_id, 0 as u32);
                let enum_ty = self.get_place_type(&val_place);

                let ok_name = self.intern_table.intern("Ok");
                let some_name = self.intern_table.intern("Some");
                let success_v_idx = match self.get_variant_index(enum_ty, ok_name) {
                    Some(idx) => idx,
                    None => match self.get_variant_index(enum_ty, some_name) {
                        Some(idx) => idx,
                        None => 0xffffffff as u32,
                    }
                };

                let bool_ty = self.get_primitive_type(ILPrimitive.Bool);
                let cond_tmp = self.define_local(0 as *mut Symbol, bool_ty, LOCAL_KIND_TMP);
                self.emit(ZirStmt.Let(cond_tmp, ZirRvalue.VariantCheck(val_place, enum_ty, success_v_idx), span));
                let cond_place = Place { base: cond_tmp, projections: @slice(0 as *mut Projection, 0 as usize) };

                let success_block = self.new_block("try_ok");
                let error_block = self.new_block("try_err");
                self.terminate(ZirTerminator.Branch(cond_place, success_block, error_block));

                self.switch_to_block(error_block);
                self.emit_scope_cleanup(0 as usize, span, 0 as u32);
                self.terminate(ZirTerminator.Ret(val_place));

                self.switch_to_block(success_block);
                let payload_ty = self.get_variant_payload_type(enum_ty, success_v_idx);
                if payload_ty != 0 as u32 && payload_ty != 0xffffffff as u32 {
                    let payload_ptr_ty = self.get_ptr_type(payload_ty);
                    let payload_tmp = self.define_local(0 as *mut Symbol, payload_ptr_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(payload_tmp, ZirRvalue.EnumPayload(val_place, enum_ty, success_v_idx), span));
                    let payload_base = Place { base: payload_tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                    return self.append_deref(&payload_base);
                }
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.Block(b) => {
                return self.lower_block(&b, expected_ty);
            },
            // `break` / `continue` as expressions (a match arm `_ => break`): the same jump as
            // the statements. Before, they lowered to nothing, and such a loop never ended.
            Expr.Break => {
                self.lower_loop_jump(true, span);
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.Continue => {
                self.lower_loop_jump(false, span);
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.Return(inner_id) => {
                let mut ret_place = if inner_id != 0 as ExprId {
                    self.lower_expr(inner_id, self.current_ret_ty)
                } else {
                    if self.is_void_main {
                        let i32_ty = self.get_primitive_type(ILPrimitive.I32);
                        let zero_local = self.define_local(0 as *mut Symbol, i32_ty, LOCAL_KIND_TMP);
                        self.emit(ZirStmt.Let(zero_local, ZirRvalue.Const(0 as u64, i32_ty), span));
                        Place { base: zero_local, projections: @slice(0 as *mut Projection, 0 as usize) }
                    } else {
                        Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) }
                    }
                };
                if self.current_ret_ty != 0 as u32 && ret_place.base != 0 as u32 {
                    let actual_ty = self.get_place_type(&ret_place);
                    if actual_ty != 0 as u32 && !self.types_match(self.current_ret_ty, actual_ty) {
                        if self.is_bool_type(actual_ty) != self.is_bool_type(self.current_ret_ty) {
                            self.report_error("cannot implicitly convert between bool and non-bool (use `as`)", span);
                        }
                        let tmp_cast = self.define_local(0 as *mut Symbol, self.current_ret_ty, LOCAL_KIND_TMP);
                        self.emit(ZirStmt.Let(tmp_cast, ZirRvalue.Cast(ret_place, self.current_ret_ty), span));
                        ret_place = Place { base: tmp_cast, projections: @slice(0 as *mut Projection, 0 as usize) };
                    }
                }
                self.emit_scope_cleanup(0 as usize, span, ret_place.base);
                self.terminate(ZirTerminator.Ret(ret_place));
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.Closure(c) => {
                // Build unique closure name "_closure_N"
                let closure_id = self.mono.closure_count;
                self.mono.closure_count = self.mono.closure_count + 1 as u32;
                let prefix = "_closure_";
                let prefix_bytes = prefix as [u8];
                let buf_ptr = zoril_allocator_alloc(self.arena, 20 as usize) as *mut u8;
                let mut buf = unsafe { @slice(buf_ptr, 20 as usize) };
                let mut bi = 0 as usize;
                while bi < 9 as usize {
                    buf[bi] = prefix_bytes[bi];
                    bi = bi + 1 as usize;
                }
                let mut tmp_id = closure_id;
                if tmp_id == 0 as u32 {
                    buf[bi] = '0' as u8;
                    bi = bi + 1 as usize;
                } else {
                    let mut digits = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
                    let mut di = 0 as usize;
                    while tmp_id > 0 as u32 {
                        digits[di] = (tmp_id % 10 as u32) as u8 + '0' as u8;
                        tmp_id = tmp_id / 10 as u32;
                        di = di + 1 as usize;
                    }
                    while di > 0 as usize {
                        di = di - 1 as usize;
                        buf[bi] = digits[di];
                        bi = bi + 1 as usize;
                    }
                }
                let c_name = self.intern_table.intern(unsafe { @slice(buf_ptr, bi) });

                // Collect free variables (captures) in the closure body
                let max_caps = 32 as usize;
                let free_names = zoril_allocator_alloc(self.arena, max_caps * 4) as *mut u32;
                let mut free_names_len = 0 as usize;
                self.collect_free_idents_expr(c.body, c.params, unsafe { @slice(free_names, max_caps) }, &mut free_names_len, max_caps);

                // If there are captures, set up env struct and store captured vars
                let mut env_local_id = 0 as u32;
                let mut cap_struct_ptr_ty = 0 as u32;
                if free_names_len > 0 as usize {
                    let cap_tys = zoril_allocator_alloc(self.arena, free_names_len * 4) as *mut u32;
                    let cap_type_ids_ptr = zoril_allocator_alloc(self.persistent_arena, free_names_len * 4) as *mut u32;
                    let val_places_ptr = zoril_allocator_alloc(self.arena, free_names_len * sizeof(Place)) as *mut Place;
                    let mut val_places = unsafe { @slice(val_places_ptr, free_names_len) };
                    let mut cap_tys_s = unsafe { @slice(cap_tys, free_names_len) };
                    let mut cap_type_ids = unsafe { @slice(cap_type_ids_ptr, free_names_len) };
                    
                    let free_names_s = unsafe { @slice(free_names, free_names_len) };
                    let mut fi = 0 as usize;
                    while fi < free_names_len {
                        let name = free_names_s[fi];
                        let opt_sym2 = self.resolver.resolve_ptr(name);
                        let mut local_id = 0 as u32;
                        match opt_sym2 {
                            Some(s2) => { local_id = self.get_local_by_symbol_ref(s2); },
                            None => {}
                        }
                        let cap_ty = self.locals[local_id as usize - 1 as usize].ty;
                        
                        cap_tys_s[fi] = cap_ty;
                        cap_type_ids[fi] = cap_ty;
                        
                        val_places[fi] = Place { base: local_id, projections: @slice(0 as *mut Projection, 0 as usize) };
                        
                        fi = fi + 1 as usize;
                    }
                    
                    let cap_struct_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Tuple(cap_type_ids) , source_file: 0 as u32 });
                    cap_struct_ptr_ty = self.get_ptr_type(cap_struct_ty);
                    
                    let env_local = self.define_local(0 as *mut Symbol, cap_struct_ty, LOCAL_KIND_TMP);
                    self.emit(ZirStmt.Let(env_local, ZirRvalue.Tuple(val_places), span));
                    
                    let env_ptr = self.define_local(0 as *mut Symbol, cap_struct_ptr_ty, LOCAL_KIND_TMP);
                    let env_local_place = Place { base: env_local, projections: @slice(0 as *mut Projection, 0 as usize) };
                    self.emit(ZirStmt.Let(env_ptr, ZirRvalue.Ref(env_local_place, 0 as u32), span));
                    
                    env_local_id = env_ptr;
                    
                    // Set pending captures in monomorphizer
                    self.mono.pending_cap_names = free_names;
                    self.mono.pending_cap_tys = cap_tys;
                    self.mono.pending_cap_len = free_names_len;
                    self.mono.pending_cap_env_ty = cap_struct_ptr_ty;
                }

                let f = FnDecl {
                    name: c_name,
                    params: c.params,
                    ret_ty: c.ret_ty,
                    body: c.body,
                    type_params: @slice(0 as *mut TypeParam, 0 as usize),
                    is_pub: false,
                    is_extern: false,
                    is_variadic: false,
                    must_use: false,
                    // A closure literal has no doc comment of its own (it is an
                    // expression, not a top-level declaration something could
                    // precede). Its source file, unlike an anonymous derived
                    // type, IS meaningful -- a closure is written inline in
                    // whatever file its enclosing function is, which is exactly
                    // self.file_path (empty falls back to "unknown": intern()
                    // returns 0 for an empty slice, matching that meaning).
                    doc_comment: 0 as u32,
                    source_file: self.intern_table.intern(self.file_path),
                    has_summary: false,
                    summary_escape: 0 as u64,
                    summary_stash: 0 as u64,
                    summary_storage: 0 as u64,
                    summary_stores: 0 as u64,
                    summary_into: 0 as u64,
                    summary_ret_stack: false,
                    summary_alloc: 0 as usize,
                    has_borrows: false,
                    borrows: @slice(0 as *mut u32, 0 as usize),
                    expr_start: 0 as u32,
                    expr_end: 0 as u32,
                };
                let func_idx = self.mono.lower_closure_fn(&f, c_name);
                
                if free_names_len > 0 as usize {
                    self.mono.register_zir_closure_env(func_idx, env_local_id);
                }
                
                let p_func: &ILFunction = &self.module.functions[func_idx as usize];
                let fn_ty = self.get_fn_type(p_func);
                let ptr_fn_ty = self.get_ptr_type(fn_ty);
                let tmp = self.define_local(0 as *mut Symbol, ptr_fn_ty, LOCAL_KIND_TMP);
                if free_names_len > 0 as usize {
                    self.local_is_capturing_closure[tmp as usize - 1 as usize] = true;
                }
                self.emit(ZirStmt.Let(tmp, ZirRvalue.FuncAddr(func_idx), span));
                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.Sizeof(ty_id) => {
                let actual_ty = self.resolver.resolve_type(ty_id);
                let usize_ty = self.get_usize_type();
                let tmp = self.define_local(0 as *mut Symbol, usize_ty, LOCAL_KIND_TMP);
                self.emit(ZirStmt.Let(tmp, ZirRvalue.Sizeof(actual_ty), span));
                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.Alignof(ty_id) => {
                let actual_ty = self.resolver.resolve_type(ty_id);
                let sz = self.get_type_align(actual_ty);
                let usize_ty = self.get_usize_type();
                let tmp = self.define_local(0 as *mut Symbol, usize_ty, LOCAL_KIND_TMP);
                self.emit(ZirStmt.Let(tmp, ZirRvalue.Const(sz, usize_ty), span));
                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            Expr.Boxed(b) => {
                let val_place = self.lower_expr(b.expr, 0 as u32);
                let mut ty = self.get_place_type(&val_place);
                let is_agg = self.is_implicit_aggregate_ptr(ty);
                if ty != 0 as u32 {
                    let p_ty: &ILTypeDecl = self.get_type_decl(ty);
                    let tag = p_ty.def.get_tag();
                    if is_agg && (tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT) {
                        ty = self.get_ptr_inner_type(ty);
                    }
                }
                let target_ty = self.module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.BoxedMut(ty) , source_file: 0 as u32 });
                let tmp = self.define_local(0 as *mut Symbol, target_ty, LOCAL_KIND_TMP);
                let mut alloc_local_id = 0 as u32;
                if b.allocator != 0 as ExprId {
                    let alloc_place = self.lower_expr(b.allocator, 0 as u32);
                    alloc_local_id = alloc_place.base;
                }
                self.emit(ZirStmt.Let(tmp, ZirRvalue.Boxed(val_place, alloc_local_id), span));
                self.consume_place_if_move(&val_place);
                return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
            },
            _ => {
                return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
            }
        }
    }


    pub fn lower_block(self: &mut ZirLowerer, b: &BlockExpr, expected_ty: u32) -> Place {
        self.push_scope();

        // `unsafe { … }` raises the ambient depth for everything lowered inside it, including
        // nested blocks and the tail expression. Depth, not a flag, because blocks nest: an inner
        // plain `{ … }` inside an `unsafe` block stays unsafe, and only the matching decrement
        // restores the outer state. The enumerated checks (raw-pointer deref/index, @ptr_cast /
        // @int_cast / @ptr_from_int, extern calls) consult this and stay silent while it is > 0 --
        // they do not switch off any other verification, per doc/spec/unsafe_policy.md §2.
        if b.is_unsafe { self.unsafe_depth = self.unsafe_depth + 1 as u32; }

        let stmts = b.stmts;
        let mut i = 0 as usize;
        while i < stmts.len {
            if self.blocks[self.current_block_idx].is_terminated { break; }
            self.lower_stmt(stmts[i]);
            i = i + 1 as usize;
        }

        let mut res = Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
        if !self.blocks[self.current_block_idx].is_terminated && b.tail_expr != 0 as ExprId {
            res = self.lower_expr(b.tail_expr, expected_ty);
        }

        if b.is_unsafe { self.unsafe_depth = self.unsafe_depth - 1 as u32; }

        let block_span = Span { start: 0, end: 0, line: 0, col: 0 }; // FIXME
        self.pop_scope_exclude(block_span, res.base);

        return res;
    }

    fn try_lower_enum_variant_member(self: &mut ZirLowerer, resolved_ty: u32, member_name: u32, expected_ty: u32, span: Span) -> Place {
        if resolved_ty == 0 as u32 {
            return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        let p_ty: &ILTypeDecl = self.get_type_decl(resolved_ty);
        match p_ty.def {
            ILType.User(u) => {
                let p_def: &ILTypeDef = &self.module.typedefs[u.id as usize];
                if p_def.get_tag() == IL_TYPEDEF_ENUM {
                    let e = p_def.get_Enum();
                    let mut v_idx = 0 as usize;
                    while v_idx < e.variants.len {
                        let p_var: &ILVariant = &e.variants[v_idx];
                        if p_var.name == member_name {
                            let mut actual_enum_ty = resolved_ty;
                            if u.type_args.len == 0 as usize {
                                let res_orig = self.mono.get_typedef_origin(u.id);
                                // Try expected_ty first (most specific context)
                                if expected_ty != 0 as u32 {
                                    let p_exp_ty: &ILTypeDecl = self.get_type_decl(expected_ty);
                                    if p_exp_ty.def.get_tag() == ILTYPE_USER {
                                        let exp_u_id = p_exp_ty.def.get_User().id;
                                        let exp_orig = self.mono.get_typedef_origin(exp_u_id);
                                        if res_orig == exp_orig && res_orig != 0 as u32 {
                                            actual_enum_ty = expected_ty;
                                        }
                                    }
                                }
                                // Fall back to return type
                                if actual_enum_ty == resolved_ty && self.current_ret_ty != 0 as u32 {
                                    let p_ret_ty: &ILTypeDecl = self.get_type_decl(self.current_ret_ty);
                                    if p_ret_ty.def.get_tag() == ILTYPE_USER {
                                        let ret_u_id = p_ret_ty.def.get_User().id;
                                        let ret_orig = self.mono.get_typedef_origin(ret_u_id);
                                        if res_orig == ret_orig && res_orig != 0 as u32 {
                                            actual_enum_ty = self.current_ret_ty;
                                        }
                                    }
                                }
                            }
                            let tmp = self.define_local(0 as *mut Symbol, actual_enum_ty, LOCAL_KIND_TMP);
                            let payload_place = Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
                            self.emit(ZirStmt.Let(tmp, ZirRvalue.EnumVariant(actual_enum_ty, v_idx as u32, payload_place), span));
                            return Place { base: tmp, projections: @slice(0 as *mut Projection, 0 as usize) };
                        }
                        v_idx = v_idx + 1 as usize;
                    }
                }
            },
            _ => {},
        }
        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
    }

    fn try_lower_impl_constant(self: &mut ZirLowerer, id: u32, member_name: u32, expected_ty: u32) -> Place {
        if id == 0 as u32 {
            return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
        }
        let type_name_s = self.intern_table.lookup(id);
        let member_name_s = self.intern_table.lookup(member_name);
        let mut full_name_v = ByteVec.new(self.arena);
        full_name_v.push_slice(type_name_s);
        full_name_v.push('_' as u8);
        full_name_v.push_slice(member_name_s);
        let full_id = self.intern_table.intern(full_name_v.as_slice());
        let opt_impl_sym = self.resolver.resolve_ptr(full_id);
        match opt_impl_sym {
            Some(impl_sym) => {
                let ik_tag = impl_sym.kind_tag as u32;
                let ik_payload = impl_sym.kind_payload as u32;
                if ik_tag == SYM_GLOBAL {
                    let p_idecl: &Decl = &self.resolver.ast.decls[ik_payload as usize];
                    match *p_idecl {
                        Decl.Impl(imp) => {
                            let mut ci = 0 as usize;
                            while ci < imp.constants.len {
                                if imp.constants[ci].name == member_name {
                                    return self.lower_expr(imp.constants[ci].value, 0 as u32);
                                }
                                ci = ci + 1 as usize;
                            }
                        },
                        Decl.Const(c) => {
                            // A const's DECLARED type is the truth about its type;
                            // lowering only its initializer meant `const W: u64 = 4;`
                            // produced an i32 (the literal's default) wherever the
                            // caller had no expectation, so `let x = W;` inferred i32.
                            let mut want = expected_ty;
                            if want == 0 as u32 { want = self.resolver.resolve_type(c.ty); }
                            return self.lower_expr(c.value, want);
                        },
                        _ => {}
                    }
                } else if ik_tag == SYM_METHOD {
                    // Impl-block constants are registered as SYM_METHOD with a packed
                    // (impl_decl_id << 16) | item_idx payload, same as methods.
                    let impl_decl_id = ik_payload >> 16;
                    let item_idx = ik_payload & 0xffff as u32;
                    let p_idecl: &Decl = &self.resolver.ast.decls[impl_decl_id as usize];
                    let imp = p_idecl.get_Impl();
                    if item_idx as usize < imp.constants.len {
                        let c = &imp.constants[item_idx as usize];
                        return self.lower_expr(c.value, expected_ty);
                    }
                }
            },
            None => {}
        }
        return Place { base: 0, projections: @slice(0 as *mut Projection, 0 as usize) };
    }


    // The size of the fixed array TY (or the array TY refers to) when MEMBER is `len`, else
    // 0xffffffff: an array's `len` is a constant, not a field.
    fn array_len_of(self: &mut ZirLowerer, ty: u32, member: u32) -> u32 {
        if ty == 0 as u32 || member != self.intern_table.intern("len") { return 0xffffffff as u32; }
        let mut arr_ty = ty;
        let tag = self.get_type_decl(ty).def.get_tag();
        if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT { arr_ty = self.get_ptr_inner_type(ty); }
        if arr_ty == 0 as u32 { return 0xffffffff as u32; }
        let p_arr = self.get_type_decl(arr_ty);
        if p_arr.def.get_tag() != ILTYPE_ARRAY { return 0xffffffff as u32; }
        return p_arr.def.get_Array().size;
    }
}
