// Zoril ZIR to ZIL Translation (ZIR -> ZIL Lowering)

import "zir.zrl";
import "ast.zrl";
import "il_instr.zrl";
import "il_type.zrl";
import "builder.zrl";
import "resolve.zrl";
import "mono.zrl";
import "bytevec.zrl";

pub struct ZirToZilLowerer {
    pub scratch_arena: *mut Arena,
    pub persistent_arena: *mut Arena,
    pub resolver: &mut Resolver,
    pub mono: &mut Monomorphizer,
    pub intern_table: &mut InternTable,
    pub zir_module: &mut ZirModule,
    pub zil_module: &mut ILModule,
    pub builder: &mut ILBuilder,
    pub current_func: *mut ZirFunction,
    pub sret_ssa: u32,
    pub arg_start_idx: u32,
    pub had_error: bool,
}

impl ZirToZilLowerer {
    pub fn new(scratch_arena: *mut Arena, persistent_arena: *mut Arena, resolver: &mut Resolver, mono: &mut Monomorphizer, intern_table: &mut InternTable, zir_module: &mut ZirModule, zil_module: &mut ILModule, builder: &mut ILBuilder, sret_ssa: u32, arg_start_idx: u32) -> ZirToZilLowerer {
        return ZirToZilLowerer {
            scratch_arena: scratch_arena,
            persistent_arena: persistent_arena,
            resolver: resolver,
            mono: mono,
            intern_table: intern_table,
            zir_module: zir_module,
            zil_module: zil_module,
            builder: builder,
            current_func: 0 as *mut ZirFunction,
            sret_ssa: sret_ssa,
            arg_start_idx: arg_start_idx,
            had_error: false,
        };
    }

    // `current_func` is set for the whole of `lower_function` and is only read
    // from code reached through it, so this is the single marked forge; callers
    // that can run before it is set check it against null themselves.
    fn cur_func(self: &ZirToZilLowerer) -> &ZirFunction {
        return unsafe { &*self.current_func };
    }

    fn get_closure_env_ssa_for_place(self: &ZirToZilLowerer, fn_place: &Place, local_slots: *mut u32, local_closure_func_idxs: *mut u32) -> u32 {
        let local_id = fn_place.base;
        if local_id == 0 as u32 { return NO_SSA as u32; }

        let func_idx = unsafe { local_closure_func_idxs[local_id as usize] };
        if func_idx == 0xffffffff as u32 { return NO_SSA as u32; }

        let env_local_id = self.mono.lookup_zir_closure_env(func_idx);
        if env_local_id == 0 as u32 { return NO_SSA as u32; }

        let env_ssa = unsafe { local_slots[env_local_id as usize] };
        if env_ssa == 0 as u32 || env_ssa == 0xffffffff as u32 { return NO_SSA as u32; }

        return env_ssa;
    }

    fn get_rvalue_func_idx(self: &ZirToZilLowerer, rv: &ZirRvalue, local_closure_func_idxs: *mut u32) -> u32 {
        match rv.get_tag() {
            ZIR_RV_FUNC_ADDR => {
                return rv.get_FuncAddr_id();
            },
            ZIR_RV_USE => {
                let place = rv.get_Use();
                if place.projections.len == 0 as usize {
                    let local_id = place.base;
                    if local_id != 0 as u32 {
                        return unsafe { local_closure_func_idxs[local_id as usize] };
                    }
                }
            },
            _ => {},
        }
        return 0xffffffff as u32;
    }

    fn get_closure_env_ssa(self: &ZirToZilLowerer, fn_val: u32) -> u32 {
        let legacy_lowerer = self.mono.lowerer;
        if legacy_lowerer as usize != 0 as usize {
            let mut ci = 0 as usize;
            while ci < (*legacy_lowerer).cap_table_len {
                if *(((*legacy_lowerer).cap_func_ssas as usize + ci * sizeof(SSAId)) as *mut SSAId) == fn_val {
                    return *(((*legacy_lowerer).cap_env_ptrs as usize + ci * sizeof(SSAId)) as *mut SSAId);
                }
                ci = ci + 1 as usize;
            }
        }
        return NO_SSA as u32;
    }

    pub fn lower(self: &mut ZirToZilLowerer) -> u32 {
        let func = &self.zir_module.funcs[0];
        self.current_func = func as usize as *mut ZirFunction;
        (*self.builder).set_span(func.span);
        let u64_ty = self.get_primitive_type(ILPRIM_U64);
        
        // 1. Allocate ZIL block IDs for all ZIR blocks
        let blocks_len = func.blocks.len;
        if blocks_len == 0 as usize { return NO_SSA as u32; }
        // NOTE: there used to be `if blocks_len > 10000 { return NO_SSA; }` here (and matching
        // locals/statements ceilings below). Those silently DROPPED the entire function body,
        // emitting only the entry block + an implicit `ret` - a silent miscompilation, not a
        // diagnostic. Any function with more than ~10000 locals (e.g. a large match
        // dispatcher) was corrupted this way. The scratch
        // allocations below are linear in blocks_len/locals_len and lower_stmt is non-recursive
        // in those counts, so there is no size-related hazard - removed the ceilings entirely.
        let zil_blocks = zoril_allocator_alloc(self.scratch_arena, blocks_len * 4) as *mut u32;
        let mut zil_blocks_s = unsafe { @slice(zil_blocks, blocks_len) };

        let zil_start_block = (*self.builder).current_block_idx;
        zil_blocks_s[0] = zil_start_block;
        if func.blocks[0].name_hint != 0 as u32 {
            (*self.builder).set_block_name(zil_start_block, func.blocks[0].name_hint);
        }

        let mut bi = 1 as usize;
        while bi < blocks_len {
            let new_id = (*self.builder).new_block();
            zil_blocks_s[bi] = new_id;
            if func.blocks[bi].name_hint != 0 as u32 {
                (*self.builder).set_block_name(new_id, func.blocks[bi].name_hint);
            }
            bi = bi + 1 as usize;
        }
        
        // 2. Allocate stack slots for all ZIR locals
        let locals_len = func.locals.len;
        // (former `if locals_len > 10000 { return NO_SSA; }` ceiling removed - see note above)
        let local_slots = zoril_allocator_alloc(self.scratch_arena, (locals_len + 1 as usize) * 4) as *mut u32;
        let local_types = zoril_allocator_alloc(self.scratch_arena, (locals_len + 1 as usize) * 4) as *mut u32;
        let local_closure_func_idxs = zoril_allocator_alloc(self.scratch_arena, (locals_len + 1 as usize) * 4) as *mut u32;
        
        unsafe {
            memset(local_slots as *mut u8, 0xff, (locals_len + 1 as usize) * 4);
            memset(local_types as *mut u8, 0, (locals_len + 1 as usize) * 4);
            memset(local_closure_func_idxs as *mut u8, 0xff, (locals_len + 1 as usize) * 4);
        }
        
        // Switch to the function's alloc_block (which is the entry block for allocations)
        let alloc_blk = (*self.builder).entry_block_idx;
        let saved_current_blk = (*self.builder).current_block_idx;
        
        (*self.builder).switch_to_block(alloc_blk);
        
        let mut li = 0 as usize;
        let mut arg_idx = self.arg_start_idx;
        let zil_f = self.zil_module.get_function_mut((*self.builder).current_func_idx as usize);

        while li < locals_len {
            let loc = &func.locals[li];
            let p_slot = (local_slots as usize + loc.id as usize * 4) as *mut u32;
            let p_ty = (local_types as usize + loc.id as usize * 4) as *mut u32;
            
            let mut loc_ty = loc.ty;
            if loc_ty == 0 as u32 {
                loc_ty = u64_ty;
            };
            unsafe { p_ty[0] = loc_ty; }
            
            // Allocate slot in alloc_block
            let ptr_ty = (*self.builder).get_ptr_type(loc_ty);
            let slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: loc_ty, allocator: NO_SSA as u32 }), ptr_ty);
            unsafe { p_slot[0] = slot; }
            if loc.name_id != 0 as u32 {
                (*self.builder).set_ssa_name(slot, loc.name_id);
            }

            if loc.kind == LOCAL_KIND_ARG {
                // If it is a parameter, we need to store the parameter value into the slot.
                let saved = (*self.builder).current_block_idx;
                (*self.builder).switch_to_block(zil_start_block);
                
                let is_agg = self.is_aggregate(loc_ty);
                if is_agg {
                    // For aggregate parameters (passed by pointer), copy from param pointer to stack slot
                    let param_ptr_ty = (*self.builder).get_ptr_type(loc_ty);
                    let param_val = (*self.builder).emit_with_type(ILInstr.Param(arg_idx), param_ptr_ty);
                    
                    // Update ILFunction.params[arg_idx].ssa so the backend knows where the param value is.
                    if (arg_idx as usize) < zil_f.params_len {
                        // Writing back into ILFunction's raw param array.
                        unsafe {
                            let p_param = (zil_f.params as usize + arg_idx as usize * sizeof(ILParam)) as *mut ILParam;
                            (*p_param).ssa = param_val;
                        }
                    }

                    // Use memcpy to copy the aggregate from the pointer arg to the local slot
                    let prolog_size = self.get_type_size(loc_ty);
                    self.emit_memcpy(slot, param_val, prolog_size);
                } else {
                    let param_val = (*self.builder).emit_with_type(ILInstr.Param(arg_idx), loc_ty);
                    
                    // Update ILFunction.params[arg_idx].ssa so the backend knows where the param value is.
                    if (arg_idx as usize) < zil_f.params_len {
                        // Writing back into ILFunction's raw param array.
                        unsafe {
                            let p_param = (zil_f.params as usize + arg_idx as usize * sizeof(ILParam)) as *mut ILParam;
                            (*p_param).ssa = param_val;
                        }
                    }

                    if self.get_type_size(loc_ty) > 0 as u64 {
                        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: slot, val: param_val }));
                    }
                }
                
                (*self.builder).switch_to_block(saved);
                arg_idx = arg_idx + 1 as u32;
            }
            
            li = li + 1 as usize;
        }
        
        // Switch back to start block to begin lowering function body blocks
        (*self.builder).switch_to_block(zil_start_block);
        
        // 3. Lower each block
        let mut bi2 = 0 as usize;
        while bi2 < blocks_len {
            let b = &func.blocks[bi2];
            let zil_b = zil_blocks_s[bi2];
            (*self.builder).switch_to_block(zil_b);

            // Lower statements (formerly guarded by `if stmts_len <= 10000` - a block with more
            // than 10000 statements would have had ALL its statements silently dropped; removed,
            // same rationale as the blocks/locals ceilings above)
            let mut si = 0 as usize;
            let stmts_len = b.statements.len;
            while si < stmts_len {
                let stmt = &b.statements[si];
                let literal_comment = b.literal_comments[si];
                self.lower_stmt(stmt, literal_comment, local_slots, local_types, local_closure_func_idxs);
                si = si + 1 as usize;
            }

            // Lower terminator
            self.lower_terminator(&b.terminator, &zil_blocks_s, local_slots, local_types);

            bi2 = bi2 + 1 as usize;
        }
        
        return NO_SSA as u32;
    }

    // The address a reference to PLACE takes. A non-aggregate temporary has no memory of its
    // own (it is an SSA value), so `&(a + b)` or `&(&x)` first stores it in a fresh slot;
    // resolve_place_addr would hand back the value itself.
    fn ref_place_addr(self: &mut ZirToZilLowerer, place: &Place, local_slots: *mut u32, local_types: *mut u32) -> u32 {
        if place.base != 0 as u32 && place.projections.len == 0 as usize {
            let ty = unsafe { local_types[place.base as usize] };
            let kind = self.cur_func().locals[place.base as usize - 1 as usize].kind;
            if kind == 1 as u32 && !self.is_aggregate(ty) {
                let ptr_ty = (*self.builder).get_ptr_type(ty);
                let saved = (*self.builder).current_block_idx;
                (*self.builder).switch_to_block((*self.builder).entry_block_idx);
                let slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: ty, allocator: NO_SSA as u32 }), ptr_ty);
                (*self.builder).switch_to_block(saved);
                let val = unsafe { local_slots[place.base as usize] };
                (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: slot, val: val }));
                return slot;
            }
        }
        return self.resolve_place_addr(place, local_slots, local_types);
    }

    fn resolve_place_addr(self: &mut ZirToZilLowerer, place: &Place, local_slots: *mut u32, local_types: *mut u32) -> u32 {
        if place.base == 0 as u32 { return 0xffffffff as u32; }
        let base_slot = unsafe { local_slots[place.base as usize] };
        let mut ptr = base_slot;
        let mut curr_ty = unsafe { local_types[place.base as usize] };
        
        let kind = self.cur_func().locals[place.base as usize - 1 as usize].kind;
        let mut is_value = if kind == 1 as u32 && !self.is_aggregate(curr_ty) { true } else { false };
        
        let mut pi = 0 as usize;
        while pi < place.projections.len {
            let proj = &place.projections[pi];
            let tag = proj.get_tag();
            
            if tag == 0 as u32 { // Field
                let field_name = proj.get_Field();
                // Auto-deref: if curr_ty is a pointer, load the pointer value first
                let curr_tag = if curr_ty != 0 as u32 { self.builder.get_type_decl(curr_ty).def.get_tag() } else { 0 as u32 };
                let mut struct_ptr = ptr;
                let mut struct_ty = curr_ty;
                if curr_tag == ILTYPE_PTR || curr_tag == ILTYPE_PTRMUT || curr_tag == ILTYPE_BOXED || curr_tag == ILTYPE_BOXEDMUT {
                    if is_value {
                        struct_ptr = ptr;
                        is_value = false;
                    } else {
                        struct_ptr = (*self.builder).emit_with_type(ILInstr.Load(ptr), curr_ty);
                    }
                    struct_ty = self.get_ptr_inner_type(curr_ty);
                }
                let field_idx = self.get_field_index(struct_ty, field_name);
                let field_ty = self.get_field_type(struct_ty, field_idx);
                let ptr_ty = (*self.builder).get_ptr_type(field_ty);
                ptr = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: struct_ptr, field_idx: field_idx }), ptr_ty);
                curr_ty = field_ty;
                is_value = false;
            } else if tag == 1 as u32 { // TupleIndex
                let idx = proj.get_TupleIndex();
                // Auto-deref, exactly as the Field arm above does. Without this,
                // `p.0` where p is a *mut (A, B) applies FieldAddr to the POINTER
                // rather than to the tuple, and reads the pointer's own bytes.
                // `p.a` on a *mut S has always worked; the tuple case was simply
                // missing the same block.
                let curr_tag_t = if curr_ty != 0 as u32 { self.builder.get_type_decl(curr_ty).def.get_tag() } else { 0 as u32 };
                let mut tuple_ptr = ptr;
                let mut tuple_ty = curr_ty;
                if curr_tag_t == ILTYPE_PTR || curr_tag_t == ILTYPE_PTRMUT || curr_tag_t == ILTYPE_BOXED || curr_tag_t == ILTYPE_BOXEDMUT {
                    if is_value {
                        tuple_ptr = ptr;
                        is_value = false;
                    } else {
                        tuple_ptr = (*self.builder).emit_with_type(ILInstr.Load(ptr), curr_ty);
                    }
                    tuple_ty = self.get_ptr_inner_type(curr_ty);
                }
                let elem_ty = self.get_tuple_elem_type(tuple_ty, idx);
                let ptr_ty = (*self.builder).get_ptr_type(elem_ty);
                ptr = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: tuple_ptr, field_idx: idx }), ptr_ty);
                curr_ty = elem_ty;
                is_value = false;
            } else if tag == 2 as u32 { // Deref
                let inner_ty = self.get_ptr_inner_type(curr_ty);
                if is_value {
                    is_value = false;
                } else {
                    ptr = (*self.builder).emit_with_type(ILInstr.Load(ptr), curr_ty);
                }
                curr_ty = inner_ty;
            } else if tag == 3 as u32 { // Index
                let idx_local_id = proj.get_Index();
                let p_idx = Place { base: idx_local_id, projections: @slice(0 as *mut Projection, 0 as usize) };
                let idx_val = self.load_place(&p_idx, local_slots, local_types);
                
                let curr_tag = if curr_ty != 0 as u32 { self.builder.get_type_decl(curr_ty).def.get_tag() } else { 0 as u32 };
                let mut base_ptr = ptr;
                let mut effective_ty = curr_ty;
                if curr_tag == ILTYPE_PTR || curr_tag == ILTYPE_PTRMUT || curr_tag == ILTYPE_BOXED || curr_tag == ILTYPE_BOXEDMUT {
                    if is_value {
                        base_ptr = ptr;
                        is_value = false;
                    } else {
                        base_ptr = (*self.builder).emit_with_type(ILInstr.Load(ptr), curr_ty);
                    }
                    effective_ty = self.get_ptr_inner_type(curr_ty);
                }

                // Element type / stride for the index offset:
                //   - `*mut Vec<T>`: a mutable raw pointer to a Vec strides by
                //     sizeof(Vec<T>) (it is an array of Vecs), NOT sizeof(T);
                //     get_slice_element_type(Vec<T>) wrongly returns T here. This is
                //     the array-of-Vecs case (e.g. `preds: *mut Vec<u32>`).
                //   - Every other base (slice/array/&Vec/&[T]/*mut [T]/*mut scalar/
                //     struct): get_slice_element_type gives the inner element type.
                let elem_ty = if curr_tag == ILTYPE_PTRMUT && self.is_vec_type(effective_ty) {
                    effective_ty
                } else {
                    self.get_slice_element_type(effective_ty)
                };
                let elem_size = self.get_type_size(elem_ty);
                let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
                let ptr_elem_ty = (*self.builder).get_ptr_type(elem_ty);

                let idx_usize = (*self.builder).emit_cast(idx_val, usize_ty);
                let elem_size_ssa = (*self.builder).emit_const_u64(elem_size, usize_ty);
                let offset = (*self.builder).emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: idx_usize, rhs: elem_size_ssa }), usize_ty);
                
                let p_eff_ty = self.builder.get_type_decl(effective_ty);
                let is_slice = p_eff_ty.def.get_tag() == ILTYPE_SLICE;
                let is_array = p_eff_ty.def.get_tag() == ILTYPE_ARRAY;
                let is_vec = curr_tag != ILTYPE_PTRMUT && self.is_vec_type(effective_ty);
                if is_slice || is_array || is_vec {
                    let bool_ty = self.get_primitive_type(ILPRIM_BOOL);
                    let u64_ty = self.get_primitive_type(ILPRIM_U64);
                    let i64_ty = self.get_primitive_type(ILPRIM_I64);
                    if is_slice || is_vec {
                        (*self.builder).emit_slice_bounds_check(base_ptr, idx_usize, usize_ty, bool_ty, u64_ty, i64_ty);
                    } else {
                        let arr_len = p_eff_ty.def.get_Array().size;
                        (*self.builder).emit_array_bounds_check(idx_usize, arr_len as u64, usize_ty, bool_ty, u64_ty, i64_ty);
                    }
                }
                if is_slice || is_vec {
                    let ptr_field_ptr_ty = (*self.builder).get_ptr_type(ptr_elem_ty);
                    let ptr_field_addr = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: base_ptr, field_idx: 0 as u32 }), ptr_field_ptr_ty);
                    base_ptr = (*self.builder).emit_with_type(ILInstr.Load(ptr_field_addr), ptr_elem_ty);
                }
                
                ptr = (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: base_ptr, rhs: offset }), ptr_elem_ty);
                curr_ty = elem_ty;
                is_value = false;
            }
            pi = pi + 1 as usize;
        }
        return ptr;
    }

    fn load_place(self: &mut ZirToZilLowerer, place: &Place, local_slots: *mut u32, local_types: *mut u32) -> u32 {
        if place.base == 0 as u32 { return NO_SSA as u32; }
        if place.base as usize > self.cur_func().locals.len { return NO_SSA as u32; }
        let kind = self.cur_func().locals[place.base as usize - 1 as usize].kind;
        if place.projections.len == 0 as usize && kind == 1 as u32 { // TMP
            let slot_val = unsafe { local_slots[place.base as usize] };
            let slot_ty = (*self.builder).get_ssa_type(slot_val);
            if slot_ty != 0 as u32 {
                let slot_tag = self.builder.get_type_decl(slot_ty).def.get_tag();
                if slot_tag == ILTYPE_PTR {
                    let place_ty = unsafe { local_types[place.base as usize] };
                    let inner_ty = self.get_ptr_inner_type(slot_ty);
                    if inner_ty == place_ty {
                        if self.is_aggregate(place_ty) {
                            return (*self.builder).emit_with_type(ILInstr.Move(slot_val), slot_ty);
                        }
                        return (*self.builder).emit_with_type(ILInstr.Load(slot_val), place_ty);
                    }
                } else if self.is_aggregate(slot_ty) {
                    // TMP holds an aggregate value (e.g. from ArrayConstruct) but the
                    // local's declared type is Ptr(aggregate). The aggregate SSA is actually
                    // an alloc pointer; reinterpret it as the declared pointer type so that
                    // downstream stores emit storel instead of memcpy.
                    let place_ty = unsafe { local_types[place.base as usize] };
                    if place_ty != 0 as u32 {
                        let place_tag = self.builder.get_type_decl(place_ty).def.get_tag();
                        if place_tag == ILTYPE_PTR || place_tag == ILTYPE_PTRMUT {
                            let inner_ty = self.get_ptr_inner_type(place_ty);
                            if inner_ty == slot_ty {
                                return (*self.builder).emit_with_type(ILInstr.Move(slot_val), place_ty);
                            }
                        }
                    }
                }
            }
            return slot_val;
        }

        let addr = self.resolve_place_addr(place, local_slots, local_types);
        let place_ty = self.get_place_type(place, local_types);
        if self.is_aggregate(place_ty) {
            return (*self.builder).emit_with_type(ILInstr.Move(addr), (*self.builder).get_ptr_type(place_ty));
        }
        return (*self.builder).emit_with_type(ILInstr.Load(addr), place_ty);
    }

    fn get_place_type(self: &mut ZirToZilLowerer, place: &Place, local_types: *mut u32) -> u32 {
        let mut curr_ty = unsafe { local_types[place.base as usize] };
        
        let mut pi = 0 as usize;
        while pi < place.projections.len {
            let proj = &place.projections[pi];
            let tag = proj.get_tag();
            
            if tag == 0 as u32 { // Field
                let field_name = proj.get_Field();
                let field_idx = self.get_field_index(curr_ty, field_name);
                curr_ty = self.get_field_type(curr_ty, field_idx);
            } else if tag == 1 as u32 { // TupleIndex
                let idx = proj.get_TupleIndex();
                curr_ty = self.get_tuple_elem_type(curr_ty, idx);
            } else if tag == 2 as u32 { // Deref
                curr_ty = self.get_ptr_inner_type(curr_ty);
            } else if tag == 3 as u32 { // Index
                curr_ty = self.get_slice_element_type(curr_ty);
            }
            pi = pi + 1 as usize;
        }
        return curr_ty;
    }

    fn is_aggregate(self: &mut ZirToZilLowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_USER { return true; }
        return tag == ILTYPE_TUPLE || tag == ILTYPE_ARRAY || tag == ILTYPE_SLICE;
    }

    // A place whose declared type is a pointer holds a pointer value, never an implicit
    // stack-slot address for an aggregate.
    fn is_pointer_valued(self: &mut ZirToZilLowerer, place_ty: u32) -> bool {
        if place_ty == 0 as u32 { return false; }
        let tag = self.builder.get_type_decl(place_ty).def.get_tag();
        return tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT;
    }

    fn is_implicit_aggregate_ptr(self: &mut ZirToZilLowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        // PtrMut<T> is always an explicit user pointer value (*mut T / &mut T),
        // never an implicit stack-slot address. Only Ptr<T> can be a stack slot.
        if tag != ILTYPE_PTR { return false; }
        if p_ty.name != 0 as u32 { return false; }
        let inner = self.get_ptr_inner_type(ty_id);
        return self.is_aggregate(inner);
    }

    fn is_enum_type(self: &mut ZirToZilLowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.builder.get_type_decl(ty_id);
        if p_ty.def.get_tag() != ILTYPE_USER { return false; }
        let uid = p_ty.def.get_User().id;
        if uid < (*self.resolver.ast).decls.len as u32 {
            self.mono.lower_typedef(uid);
        }
        let p_def = self.zil_module.get_typedef_mut(uid as usize);
        return p_def.get_tag() == IL_TYPEDEF_ENUM;
    }

    fn is_ptr_to_enum(self: &mut ZirToZilLowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        if tag != ILTYPE_PTR && tag != ILTYPE_PTRMUT { return false; }
        let inner = self.get_ptr_inner_type(ty_id);
        if inner == 0 as u32 { return false; }
        if !self.is_aggregate(inner) { return false; }
        let p_inner = self.builder.get_type_decl(inner);
        if p_inner.def.get_tag() != ILTYPE_USER { return false; }
        let uid = p_inner.def.get_User().id;
        // Ensure the typedef is populated before checking its tag.
        if uid < (*self.resolver.ast).decls.len as u32 {
            self.mono.lower_typedef(uid);
        }
        let p_def = self.zil_module.get_typedef_mut(uid as usize);
        return p_def.get_tag() == IL_TYPEDEF_ENUM;
    }

    fn get_primitive_type(self: &ZirToZilLowerer, prim: u32) -> u32 {
        let mut i = 0 as usize;
        while i < self.zil_module.types.len {
            let p_t = &self.zil_module.types[i];
            if p_t.def.get_tag() == ILTYPE_PRIMITIVE {
                if p_t.def.get_Primitive().get_tag() == prim {
                    return p_t.id;
                }
            }
            i = i + 1 as usize;
        }
        ICE("ZirToZilLowerer.get_primitive_type: primitive type not found");
        return 0 as u32;
    }

    fn get_field_index(self: &mut ZirToZilLowerer, ty_id: u32, field_name: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        
        let mut curr_ty = ty_id;
        let mut p_ty = self.builder.get_type_decl(curr_ty);
        let mut tag = p_ty.def.get_tag();
        
        while tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            curr_ty = self.get_ptr_inner_type(curr_ty);
            if curr_ty == 0 as u32 { break; }
            p_ty = self.builder.get_type_decl(curr_ty);
            tag = p_ty.def.get_tag();
        }
        
        if tag == ILTYPE_SLICE {
            let ptr_id = self.intern_table.intern("ptr");
            let data_id = self.intern_table.intern("data");
            let len_id = self.intern_table.intern("len");
            if field_name == ptr_id || field_name == data_id { return 0 as u32; }
            if field_name == len_id { return 1 as u32; }
            return 0xffffffff as u32;
        }

        let mut user_id = 0xffffffff as u32;
        if tag == ILTYPE_USER {
            user_id = p_ty.def.get_User().id;
        }

        if user_id != 0xffffffff as u32 {
            if user_id < (*self.resolver.ast).decls.len as u32 {
                self.mono.lower_typedef(user_id);
            }
            let p_def = self.zil_module.get_typedef_mut(user_id as usize);
            if p_def.get_tag() == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                let mut i = 0 as usize;
                while i < s.fields.len {
                    if s.fields[i].name == field_name {
                        return i as u32;
                    }
                    i = i + 1 as usize;
                }
                must_write(2, "\nFailed to find field: ");
                must_write(2, InternTable.lookup((*self).intern_table, field_name));
                must_write(2, " among fields: ");
                let mut j = 0 as usize;
                while j < s.fields.len {
                    must_write(2, InternTable.lookup((*self).intern_table, s.fields[j].name));
                    must_write(2, ", ");
                    j = j + 1 as usize;
                }
                must_write(2, "\n");
            }
        }
        must_write(2, " tag: "); write_u64_hex(2, tag as u64); must_write(2, " name: "); must_write(2, InternTable.lookup((*self).intern_table, field_name)); must_write(2, "\n"); ICE("ZirToZilLowerer.get_field_index: field not found");
        return 0xffffffff as u32;
    }

    fn get_field_type(self: &mut ZirToZilLowerer, ty_id: u32, field_idx: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        
        let mut curr_ty = ty_id;
        let mut p_ty = self.builder.get_type_decl(curr_ty);
        let mut tag = p_ty.def.get_tag();
        
        while tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            curr_ty = self.get_ptr_inner_type(curr_ty);
            if curr_ty == 0 as u32 { break; }
            p_ty = self.builder.get_type_decl(curr_ty);
            tag = p_ty.def.get_tag();
        }

        if tag == ILTYPE_SLICE {
            if field_idx == 0 as u32 {
                let elem_ty = p_ty.def.get_Slice().element;
                return (*self.builder).get_ptr_type(elem_ty);
            }
            if field_idx == 1 as u32 {
                return self.get_primitive_type(3 as u32); // U64
            }
            return 0 as u32;
        }

        let mut user_id = 0xffffffff as u32;
        if tag == ILTYPE_USER {
            user_id = p_ty.def.get_User().id;
        }

        if user_id != 0xffffffff as u32 {
            if user_id < (*self.resolver.ast).decls.len as u32 {
                self.mono.lower_typedef(user_id);
            }
            let p_def = self.zil_module.get_typedef_mut(user_id as usize);
            if p_def.get_tag() == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                if (field_idx as usize) < s.fields.len {
                    return s.fields[field_idx as usize].ty;
                }
            }
        }
        ICE("ZirToZilLowerer.get_field_type: field type not found");
        return 0 as u32;
    }

    fn get_primitive_type(self: &ZirToZilLowerer, tag: u32) -> u32 {
        return *((self.resolver.primitives as usize + tag as usize * 4) as *mut u32);
    }

    fn get_tuple_elem_type(self: &ZirToZilLowerer, ty_id: u32, idx: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        let mut base_ty = p_ty;
        if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT {
            let inner_ty = p_ty.def.get_Ptr();
            base_ty = self.builder.get_type_decl(inner_ty);
        }

        let base_tag = (*base_ty).def.get_tag();
        if base_tag == ILTYPE_TUPLE {
            let elements = (*base_ty).def.get_Tuple();
            if (idx as usize) < elements.len {
                return elements[idx as usize];
            }
        }
        ICE("ZirToZilLowerer.get_tuple_elem_type: not a tuple or out of bounds");
        return 0 as u32;
    }
    fn get_ptr_inner_type(self: &ZirToZilLowerer, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            return p_ty.def.get_Ptr();
        }
        return 0 as u32;
    }

    fn get_fn_type(self: &mut ZirToZilLowerer, f: &ILFunction) -> u32 {
        // Strip sret and env_ptr to expose only the source-visible parameters
        let sret_offset = if self.is_aggregate(f.ret_ty) { 1 as usize } else { 0 as usize };
        let env_offset = if self.needs_env_ptr(f.is_extern, f.name) { 1 as usize } else { 0 as usize };
        let param_base = sret_offset + env_offset;
        let visible_count = if f.params_len >= param_base { f.params_len - param_base } else { 0 as usize };
        let param_tys_ptr = zoril_allocator_alloc(self.persistent_arena, (visible_count + 1 as usize) * 4) as *mut u32;
        let mut param_tys = unsafe { @slice(param_tys_ptr, visible_count) };
        let mut i = 0 as usize;
        while i < visible_count {
            param_tys[i] = f.param(param_base + i).ty;
            i = i + 1 as usize;
        }

        let fn_def = ILFn {
            params: param_tys,
            ret_ty: f.ret_ty,
            is_variadic: f.is_variadic,
        };
        
        // Find existing fn type or allocate new
        let mut j = 0 as usize;
        while j < self.zil_module.types.len {
            let p_t = self.zil_module.get_type_mut(j);
            if p_t.def.get_tag() == ILTYPE_FN {
                let existing = p_t.def.get_Fn();
                if existing.ret_ty == fn_def.ret_ty {
                    if existing.is_variadic == fn_def.is_variadic {
                        if existing.params.len == fn_def.params.len {
                            let mut match_params = true;
                            let mut k = 0 as usize;
                            while k < existing.params.len {
                                if existing.params[k] != fn_def.params[k] { match_params = false; break; }
                                k = k + 1 as usize;
                            }
                            if match_params { return p_t.id; }
                        }
                    }
                }
            }
            j = j + 1 as usize;
        }
        
        return self.zil_module.alloc_type(ILTypeDecl { id: 0 as u32, name: 0 as u32, def: ILType.Fn(fn_def) , source_file: 0 as u32 });
    }

    fn is_vec_type(self: &ZirToZilLowerer, ty_id: u32) -> bool {
        if ty_id == 0 as u32 { return false; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_USER {
            let user = p_ty.def.get_User();
            let name_str = (*self.intern_table).lookup(user.name);
            let is_vec = (name_str.len == 3 as usize && name_str[0] == 'V' as u8 && name_str[1] == 'e' as u8 && name_str[2] == 'c' as u8) ||
                         (name_str.len > 3 as usize && name_str[0] == 'V' as u8 && name_str[1] == 'e' as u8 && name_str[2] == 'c' as u8 && name_str[3] == '_' as u8);
            return is_vec && user.type_args.len > 0 as usize;
        }
        return false;
    }

    fn get_slice_element_type(self: &ZirToZilLowerer, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_SLICE {
            return p_ty.def.get_Slice().element;
        } else if tag == ILTYPE_ARRAY {
            return p_ty.def.get_Array().element;
        } else if tag == ILTYPE_USER {
            let user = p_ty.def.get_User();
            let name_str = (*self.intern_table).lookup(user.name);
            let is_vec = (name_str.len == 3 as usize && name_str[0] == 'V' as u8 && name_str[1] == 'e' as u8 && name_str[2] == 'c' as u8) ||
                         (name_str.len > 3 as usize && name_str[0] == 'V' as u8 && name_str[1] == 'e' as u8 && name_str[2] == 'c' as u8 && name_str[3] == '_' as u8);
            if is_vec && user.type_args.len > 0 as usize {
                return user.type_args[0];
            }
        } else if tag == ILTYPE_PTR {
            let inner = self.get_ptr_inner_type(ty_id);
            if inner != 0 as u32 {
                let p_inner = self.builder.get_type_decl(inner);
                let inner_tag = p_inner.def.get_tag();
                if inner_tag == ILTYPE_SLICE || inner_tag == ILTYPE_ARRAY || inner_tag == ILTYPE_USER {
                    let elem = self.get_slice_element_type(inner);
                    if elem != inner {
                        return elem;
                    }
                }
                return inner;
            }
        } else if tag == ILTYPE_PTRMUT {
            let inner = self.get_ptr_inner_type(ty_id);
            if inner != 0 as u32 {
                let p_inner = self.builder.get_type_decl(inner);
                let inner_tag = p_inner.def.get_tag();
                if inner_tag == ILTYPE_SLICE || inner_tag == ILTYPE_ARRAY {
                    let elem = self.get_slice_element_type(inner);
                    if elem != inner {
                        return elem;
                    }
                }
                return inner;
            }
        }
        return ty_id;
    }

    fn get_type_size(self: &mut ZirToZilLowerer, ty_id: u32) -> u64 {
        let mut result = self.get_type_size_internal(ty_id, 0 as usize);
        return result;
    }

    fn get_type_size_internal(self: &mut ZirToZilLowerer, ty_id: u32, depth: usize) -> u64 {
        if ty_id == 0 as u32 { return 0 as u64; }
        let p_ty_inner = self.builder.get_type_decl(ty_id);
        let raw_tag = p_ty_inner.def.get_tag();
        if depth > 100 as usize {
            must_write(2, "error: recursive type detected (recursive types must be behind a pointer)\n");
            @syscall(60, 1 as u64);
        }
        let p_ty = self.builder.get_type_decl(ty_id);

        if raw_tag == ILTYPE_USER {
            let u = p_ty_inner.def.get_User();
            let p_def = self.zil_module.get_typedef_mut((*u).id as usize);
            if p_def.get_tag() == IL_TYPEDEF_STRUCT {
                let s = p_def.get_Struct();
                let mut size = 0 as u64;
                let mut align = 1 as u64;
                let mut i = 0 as usize;
                while i < (*s).fields.len {
                    let f_ty = (*s).fields[i].ty;
                    let f_size = self.get_type_size_internal(f_ty, depth + 1 as usize);
                    let f_align = self.get_type_align_internal(f_ty, depth + 1 as usize);
                    if f_align > align { align = f_align; }
                    size = (size + f_align - 1 as u64) / f_align * f_align;
                    size = size + f_size;
                    i = i + 1 as usize;
                }
                size = (size + align - 1 as u64) / align * align;
                return size;
            } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
                let e = p_def.get_Enum();
                let mut max_payload_size = 0 as u64;
                let mut max_payload_align = 1 as u64;
                let mut i = 0 as usize;
                while i < e.variants.len {
                    let p_var: &ILVariant = &e.variants[i];
                    if p_var.payload != 0 as u32 {
                        let v_size = self.get_type_size_internal(p_var.payload, depth + 1 as usize);
                        let v_align = self.get_type_align_internal(p_var.payload, depth + 1 as usize);
                        if v_size > max_payload_size { max_payload_size = v_size; }
                        if v_align > max_payload_align { max_payload_align = v_align; }
                    }
                    i = i + 1 as usize;
                }
                if max_payload_size == 0 as u64 { return ENUM_TAG_SIZE; }
                let mut enum_align = ENUM_TAG_SIZE;
                if max_payload_align > ENUM_TAG_SIZE { enum_align = max_payload_align; }
                let mut total_size = enum_align + max_payload_size;
                let mut final_size = (total_size + enum_align - 1 as u64) / enum_align * enum_align;
                return final_size;
            } else {
                return 8 as u64; // ILTypeDef.Fn
            }
        }
        match p_ty.def {
            ILType.Primitive(p) => {
                match p {
                    ILPrimitive.U8 => { return 1 as u64; },
                    ILPrimitive.U16 => { return 2 as u64; },
                    ILPrimitive.U32 => { return 4 as u64; },
                    ILPrimitive.U64 => { return 8 as u64; },
                    ILPrimitive.USize => { return 8 as u64; },
                    ILPrimitive.I8 => { return 1 as u64; },
                    ILPrimitive.I16 => { return 2 as u64; },
                    ILPrimitive.I32 => { return 4 as u64; },
                    ILPrimitive.I64 => { return 8 as u64; },
                    ILPrimitive.ISize => { return 8 as u64; },
                    ILPrimitive.F32 => { return 4 as u64; },
                    ILPrimitive.F64 => { return 8 as u64; },
                    ILPrimitive.Bool => { return 1 as u64; },
                    ILPrimitive.Char => { return 4 as u64; },
                    ILPrimitive.Unit => { return 0 as u64; },
                    ILPrimitive.Never => { return 0 as u64; },
                }
            },
            ILType.Ptr(_) => { return 8 as u64; },
            ILType.PtrMut(_) => { return 8 as u64; },
            ILType.Boxed(_) => { return 8 as u64; },
            ILType.BoxedMut(_) => { return 8 as u64; },
            ILType.Slice(_) => { return 16 as u64; },
            ILType.Array(a) => {
                return (a.size as u64) * self.get_type_size_internal(a.element, depth + 1 as usize);
            },
            ILType.Fn(_) => { return 8 as u64; },
            ILType.Tuple(types) => {
                let mut size = 0 as u64;
                let mut align = 1 as u64;
                let mut i = 0 as usize;
                while i < types.len {
                    let f_ty = types[i];
                    let f_size = self.get_type_size_internal(f_ty, depth + 1 as usize);
                    let f_align = self.get_type_align_internal(f_ty, depth + 1 as usize);
                    if f_align > align { align = f_align; }
                    size = (size + f_align - 1 as u64) / f_align * f_align;
                    size = size + f_size;
                    i = i + 1 as usize;
                }
                size = (size + align - 1 as u64) / align * align;
                return size;
            },
            ILType.User(u) => {
                let p_def = self.zil_module.get_typedef_mut(u.id as usize);
                match *p_def {
                    ILTypeDef.Struct(s) => {
                        let mut size = 0 as u64;
                        let mut align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < s.fields.len {
                            let f_ty = s.fields[i].ty;
                            let f_size = self.get_type_size_internal(f_ty, depth + 1 as usize);
                            let f_align = self.get_type_align_internal(f_ty, depth + 1 as usize);
                            if f_align > align { align = f_align; }
                            size = (size + f_align - 1 as u64) / f_align * f_align;
                            size = size + f_size;
                            i = i + 1 as usize;
                        }
                        size = (size + align - 1 as u64) / align * align;
                        return size;
                    },
                    ILTypeDef.Enum(e) => {
                        let mut max_payload_size = 0 as u64;
                        let mut max_payload_align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < e.variants.len {
                            let p_var: &ILVariant = &e.variants[i];
                            if p_var.payload != 0 as u32 {
                                let v_size = self.get_type_size_internal(p_var.payload, depth + 1 as usize);
                                let v_align = self.get_type_align_internal(p_var.payload, depth + 1 as usize);
                                if v_size > max_payload_size { max_payload_size = v_size; }
                                if v_align > max_payload_align { max_payload_align = v_align; }
                            }
                            i = i + 1 as usize;
                        }

                        if max_payload_size == 0 as u64 { return ENUM_TAG_SIZE; }
                        let enum_align = if max_payload_align > ENUM_TAG_SIZE { max_payload_align } else { ENUM_TAG_SIZE };
                        let total_size = enum_align + max_payload_size;
                        return (total_size + enum_align - 1 as u64) / enum_align * enum_align;
                    },
                    ILTypeDef.Fn(_) => { return 8 as u64; },
                }
            },
            ILType.FD(_) => { return 8 as u64; },
            ILType.IORing => { return 8 as u64; },
            ILType.Var(_) => { return 8 as u64; },
        }
    }

    fn get_type_align(self: &mut ZirToZilLowerer, ty_id: u32) -> u64 {
        let mut result = self.get_type_align_internal(ty_id, 0 as usize);
        return result;
    }

    fn get_type_align_internal(self: &mut ZirToZilLowerer, ty_id: u32, depth: usize) -> u64 {
        if ty_id == 0 as u32 { return 1 as u64; }
        if depth > 100 as usize {
            must_write(2, "error: recursive type detected (recursive types must be behind a pointer)\n");
            @syscall(60, 1 as u64);
        }
        let p_ty = self.builder.get_type_decl(ty_id);
        let align_tag = p_ty.def.get_tag();

        match p_ty.def {
            ILType.User(u) => {
                let p_def = self.zil_module.get_typedef_mut(u.id as usize);
                if p_def.get_tag() == IL_TYPEDEF_STRUCT {
                    let s = p_def.get_Struct();
                    let mut align = 1 as u64;
                    let mut i = 0 as usize;
                    while i < (*s).fields.len {
                        let f_align = self.get_type_align_internal((*s).fields[i].ty, depth + 1 as usize);
                        if f_align > align { align = f_align; }
                        i = i + 1 as usize;
                    }
                    return align;
                } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
                    let e = p_def.get_Enum();
                    let mut max_payload_align = 1 as u64;
                    let mut i = 0 as usize;
                    while i < e.variants.len {
                        let p_var: &ILVariant = &e.variants[i];
                        if p_var.payload != 0 as u32 {
                            let v_align = self.get_type_align_internal(p_var.payload, depth + 1 as usize);
                            if v_align > max_payload_align { max_payload_align = v_align; }
                        }
                        i = i + 1 as usize;
                    }
                    let mut align_result2 = ENUM_TAG_SIZE;
                    if max_payload_align > ENUM_TAG_SIZE { align_result2 = max_payload_align; }
                    return align_result2;
                } else {
                    return 8 as u64; // ILTypeDef.Fn
                }
            },
            ILType.Primitive(p) => {
                match p {
                    ILPrimitive.U8 => { return 1 as u64; },
                    ILPrimitive.U16 => { return 2 as u64; },
                    ILPrimitive.U32 => { return 4 as u64; },
                    ILPrimitive.U64 => { return 8 as u64; },
                    ILPrimitive.USize => { return 8 as u64; },
                    ILPrimitive.I8 => { return 1 as u64; },
                    ILPrimitive.I16 => { return 2 as u64; },
                    ILPrimitive.I32 => { return 4 as u64; },
                    ILPrimitive.I64 => { return 8 as u64; },
                    ILPrimitive.ISize => { return 8 as u64; },
                    ILPrimitive.F32 => { return 4 as u64; },
                    ILPrimitive.F64 => { return 8 as u64; },
                    ILPrimitive.Bool => { return 1 as u64; },
                    ILPrimitive.Char => { return 4 as u64; },
                    ILPrimitive.Unit => { return 1 as u64; },
                    ILPrimitive.Never => { return 1 as u64; },
                }
            },
            ILType.Ptr(_) => { return 8 as u64; },
            ILType.PtrMut(_) => { return 8 as u64; },
            ILType.Boxed(_) => { return 8 as u64; },
            ILType.BoxedMut(_) => { return 8 as u64; },
            ILType.Slice(_) => { return 8 as u64; },
            ILType.Array(a) => { return self.get_type_align_internal(a.element, depth + 1 as usize); },
            ILType.Fn(_) => { return 8 as u64; },
            ILType.Tuple(types) => {
                let mut align = 1 as u64;
                let mut i = 0 as usize;
                while i < types.len {
                    let f_align = self.get_type_align_internal(types[i], depth + 1 as usize);
                    if f_align > align { align = f_align; }
                    i = i + 1 as usize;
                }
                return align;
            },
            ILType.User(u) => {
                let p_def = self.zil_module.get_typedef_mut(u.id as usize);
                match *p_def {
                    ILTypeDef.Struct(s) => {
                        let mut align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < s.fields.len {
                            let f_align = self.get_type_align_internal(s.fields[i].ty, depth + 1 as usize);
                            if f_align > align { align = f_align; }
                            i = i + 1 as usize;
                        }
                        return align;
                    },
                    ILTypeDef.Enum(e) => {
                        let mut max_payload_align = 1 as u64;
                        let mut i = 0 as usize;
                        while i < e.variants.len {
                            let p_var: &ILVariant = &e.variants[i];
                            if p_var.payload != 0 as u32 {
                                let v_align = self.get_type_align_internal(p_var.payload, depth + 1 as usize);
                                if v_align > max_payload_align { max_payload_align = v_align; }
                            }
                            i = i + 1 as usize;
                        }
                        let mut align_result = ENUM_TAG_SIZE;
                        if max_payload_align > ENUM_TAG_SIZE { align_result = max_payload_align; }
                        return align_result;
                    },
                    ILTypeDef.Fn(_) => { return 8 as u64; },
                }
            },
            ILType.FD(_) => { return 8 as u64; },
            ILType.IORing => { return 8 as u64; },
            ILType.Var(_) => { return 8 as u64; },
        }
    }

    // Calls `fn_idx` (a type's drop function) on the value at `addr_ssa`. A drop function never
    // calls itself: dropping `self` inside `T::drop` is skipped.
    fn emit_drop_call(self: &mut ZirToZilLowerer, fn_idx: u32, addr_ssa: u32) {
        let p_f = self.zil_module.get_function_mut(fn_idx as usize);
        if self.current_func != 0 as *mut ZirFunction {
            if self.cur_func().name == p_f.name { return; }
        }
        let needs_env = self.needs_env_ptr(p_f.is_extern, p_f.name);
        let unit_ptr_ty = (*self.builder).get_ptr_type(self.get_primitive_type(ILPRIM_UNIT));
        let arg_count = if needs_env { 2 as usize } else { 1 as usize };
        let arg_ptr = zoril_allocator_alloc(self.persistent_arena, arg_count * sizeof(SSAId)) as *mut SSAId;
        let mut args = unsafe { @slice(arg_ptr, arg_count) };
        let mut dst = 0 as usize;
        if needs_env {
            args[0] = (*self.builder).emit_const_u64(0 as u64, unit_ptr_ty);
            dst = 1 as usize;
        }
        args[dst] = addr_ssa;
        let unit_ty = self.get_primitive_type(ILPRIM_UNIT);
        (*self.builder).emit_with_type(ILInstr.Call(CallInstr { args: args, name_id: p_f.name, is_extern: p_f.is_extern }), unit_ty);
    }

    // Mirrors ZirLowerer.type_needs_drop: own drop function, or an owned (by-value) field, enum
    // payload, tuple element or array element that needs dropping.
    fn zil_type_needs_drop(self: &mut ZirToZilLowerer, ty_id: u32, depth: usize) -> bool {
        if ty_id == 0 as u32 || depth > 10 as usize { return false; }
        let tag = self.builder.get_type_decl(ty_id).def.get_tag();
        if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT { return false; }
        if tag == ILTYPE_ARRAY {
            let elem = self.builder.get_type_decl(ty_id).def.get_Array().element;
            return self.zil_type_needs_drop(elem, depth + 1 as usize);
        }
        if tag == ILTYPE_TUPLE {
            let elements = self.builder.get_type_decl(ty_id).def.get_Tuple();
            let mut i = 0 as usize;
            while i < elements.len {
                if self.zil_type_needs_drop(elements[i], depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
            return false;
        }
        if tag != ILTYPE_USER { return false; }
        if self.find_drop_fn(ty_id) != 999999 as u32 { return true; }
        let u = self.builder.get_type_decl(ty_id).def.get_User();
        let p_def = self.zil_module.get_typedef_mut((*u).id as usize);
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            let st = p_def.get_Struct();
            let mut i = 0 as usize;
            while i < (*st).fields.len {
                if self.zil_type_needs_drop((*st).fields[i].ty, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            let en = p_def.get_Enum();
            let mut i = 0 as usize;
            while i < en.variants.len {
                let payload = en.variants[i].payload;
                if payload != 0 as u32 && self.zil_type_needs_drop(payload, depth + 1 as usize) { return true; }
                i = i + 1 as usize;
            }
        }
        return false;
    }

    // Drop glue for the value at `addr` of type `ty`: its own drop function first (it may still use
    // its fields), then every owned field, enum payload (for the active variant), tuple element and
    // array element that needs dropping, recursively.
    fn emit_drop_glue(self: &mut ZirToZilLowerer, addr: u32, ty: u32, depth: usize) {
        if depth > 10 as usize { return; }
        let own = self.find_drop_fn(ty);
        if own != 999999 as u32 { self.emit_drop_call(own, addr); }
        let tag = self.builder.get_type_decl(ty).def.get_tag();
        if tag == ILTYPE_TUPLE {
            let elements = self.builder.get_type_decl(ty).def.get_Tuple();
            let mut i = 0 as usize;
            while i < elements.len {
                let et = elements[i];
                if self.zil_type_needs_drop(et, depth + 1 as usize) {
                    let et_ptr = (*self.builder).get_ptr_type(et);
                    let ea = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: addr, field_idx: i as u32 }), et_ptr);
                    self.emit_drop_glue(ea, et, depth + 1 as usize);
                }
                i = i + 1 as usize;
            }
            return;
        }
        if tag == ILTYPE_ARRAY {
            let arr = self.builder.get_type_decl(ty).def.get_Array();
            if self.zil_type_needs_drop(arr.element, depth + 1 as usize) {
                self.emit_array_drop_loop(addr, arr.element, arr.size as u64, depth);
            }
            return;
        }
        if tag != ILTYPE_USER { return; }
        let u = self.builder.get_type_decl(ty).def.get_User();
        let p_def = self.zil_module.get_typedef_mut((*u).id as usize);
        if p_def.get_tag() == IL_TYPEDEF_STRUCT {
            let st = p_def.get_Struct();
            let mut i = 0 as usize;
            while i < (*st).fields.len {
                let ft = (*st).fields[i].ty;
                if self.zil_type_needs_drop(ft, depth + 1 as usize) {
                    let ft_ptr = (*self.builder).get_ptr_type(ft);
                    let fa = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: addr, field_idx: i as u32 }), ft_ptr);
                    self.emit_drop_glue(fa, ft, depth + 1 as usize);
                }
                i = i + 1 as usize;
            }
        } else if p_def.get_tag() == IL_TYPEDEF_ENUM {
            let en = p_def.get_Enum();
            let n = en.variants.len;
            let mut v = 0 as usize;
            while v < n {
                let payload = en.variants[v].payload;
                if payload != 0 as u32 && self.zil_type_needs_drop(payload, depth + 1 as usize) {
                    let bool_ty = self.get_primitive_type(ILPRIM_BOOL);
                    let is_v = (*self.builder).emit_with_type(ILInstr.VariantMatch(VariantMatchInstr { val: addr, type_id: ty, variant_idx: v as u32 }), bool_ty);
                    let then_b = (*self.builder).new_block();
                    let join_b = (*self.builder).new_block();
                    (*self.builder).emit(ILInstr.Branch(BranchInstr { cond: is_v, then_block: then_b, else_block: join_b }));
                    (*self.builder).switch_to_block(then_b);
                    let pay_ptr = (*self.builder).get_ptr_type(payload);
                    let pa = (*self.builder).emit_with_type(ILInstr.Unwrap(addr), pay_ptr);
                    self.emit_drop_glue(pa, payload, depth + 1 as usize);
                    (*self.builder).emit(ILInstr.Jmp(join_b));
                    (*self.builder).switch_to_block(join_b);
                }
                v = v + 1 as usize;
            }
        }
    }

    // The address of the enum PLACE holds, or points at when it is a reference. A reference
    // is read with load_place, which knows a temporary's value is the pointer itself; taking
    // its address and loading through it read the enum's bytes as a pointer (`match &o`).
    fn enum_address(self: &mut ZirToZilLowerer, place: &Place, local_slots: *mut u32, local_types: *mut u32) -> u32 {
        let place_ty = self.get_place_type(place, local_types);
        if place_ty != 0 as u32 {
            let tag = self.builder.get_type_decl(place_ty).def.get_tag();
            if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
                return self.load_place(place, local_slots, local_types);
            }
        }
        return self.resolve_place_addr(place, local_slots, local_types);
    }

    // for i in 0..len { arr[i] = val }: VAL is the element, or for an aggregate element a
    // pointer to it.
    fn emit_array_fill_loop(self: &mut ZirToZilLowerer, addr: u32, elem: u32, val: u32, len: u64) {
        let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
        let bool_ty = self.get_primitive_type(ILPRIM_BOOL);
        let idx_ptr_ty = (*self.builder).get_ptr_type(usize_ty);
        let elem_size = self.get_type_size(elem);
        let elem_is_agg = self.is_aggregate(elem);
        let saved = (*self.builder).current_block_idx;
        (*self.builder).switch_to_block((*self.builder).entry_block_idx);
        let idx_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: usize_ty, allocator: NO_SSA as u32 }), idx_ptr_ty);
        (*self.builder).switch_to_block(saved);
        let zero = (*self.builder).emit_const_u64(0 as u64, usize_ty);
        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: idx_slot, val: zero }));
        let cond_b = (*self.builder).new_block();
        let body_b = (*self.builder).new_block();
        let exit_b = (*self.builder).new_block();
        (*self.builder).emit(ILInstr.Jmp(cond_b));
        (*self.builder).switch_to_block(cond_b);
        let i_val = (*self.builder).emit_with_type(ILInstr.Load(idx_slot), usize_ty);
        let len_ssa = (*self.builder).emit_const_u64(len, usize_ty);
        let more = (*self.builder).emit_with_type(ILInstr.CmpLt(ILBinaryOp { lhs: i_val, rhs: len_ssa }), bool_ty);
        (*self.builder).emit(ILInstr.Branch(BranchInstr { cond: more, then_block: body_b, else_block: exit_b }));
        (*self.builder).switch_to_block(body_b);
        let size_ssa = (*self.builder).emit_const_u64(elem_size as u64, usize_ty);
        let off = (*self.builder).emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: i_val, rhs: size_ssa }), usize_ty);
        let elem_ptr_ty = (*self.builder).get_ptr_type(elem);
        let ea = (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: addr, rhs: off }), elem_ptr_ty);
        if elem_size > 0 as usize {
            if elem_is_agg {
                self.emit_memcpy(ea, val, elem_size as u64);
            } else {
                (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: ea, val: val }));
            }
        }
        let one = (*self.builder).emit_const_u64(1 as u64, usize_ty);
        let next = (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: i_val, rhs: one }), usize_ty);
        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: idx_slot, val: next }));
        (*self.builder).emit(ILInstr.Jmp(cond_b));
        (*self.builder).switch_to_block(exit_b);
    }

    // for i in 0..len { glue(&arr[i]) }
    fn emit_array_drop_loop(self: &mut ZirToZilLowerer, addr: u32, elem: u32, len: u64, depth: usize) {
        let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
        let bool_ty = self.get_primitive_type(ILPRIM_BOOL);
        let idx_ptr_ty = (*self.builder).get_ptr_type(usize_ty);
        let saved = (*self.builder).current_block_idx;
        (*self.builder).switch_to_block((*self.builder).entry_block_idx);
        let idx_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: usize_ty, allocator: NO_SSA as u32 }), idx_ptr_ty);
        (*self.builder).switch_to_block(saved);
        let zero = (*self.builder).emit_const_u64(0 as u64, usize_ty);
        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: idx_slot, val: zero }));
        let cond_b = (*self.builder).new_block();
        let body_b = (*self.builder).new_block();
        let exit_b = (*self.builder).new_block();
        (*self.builder).emit(ILInstr.Jmp(cond_b));
        (*self.builder).switch_to_block(cond_b);
        let i_val = (*self.builder).emit_with_type(ILInstr.Load(idx_slot), usize_ty);
        let len_ssa = (*self.builder).emit_const_u64(len, usize_ty);
        let more = (*self.builder).emit_with_type(ILInstr.CmpLt(ILBinaryOp { lhs: i_val, rhs: len_ssa }), bool_ty);
        (*self.builder).emit(ILInstr.Branch(BranchInstr { cond: more, then_block: body_b, else_block: exit_b }));
        (*self.builder).switch_to_block(body_b);
        let size_ssa = (*self.builder).emit_const_u64(self.get_type_size(elem), usize_ty);
        let off = (*self.builder).emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: i_val, rhs: size_ssa }), usize_ty);
        let elem_ptr_ty = (*self.builder).get_ptr_type(elem);
        let ea = (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: addr, rhs: off }), elem_ptr_ty);
        self.emit_drop_glue(ea, elem, depth + 1 as usize);
        let one = (*self.builder).emit_const_u64(1 as u64, usize_ty);
        let next = (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: i_val, rhs: one }), usize_ty);
        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: idx_slot, val: next }));
        (*self.builder).emit(ILInstr.Jmp(cond_b));
        (*self.builder).switch_to_block(exit_b);
    }

    fn find_drop_fn(self: &mut ZirToZilLowerer, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 { return 999999 as u32; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let mut base_ty = ty_id;
        let vt_tag = p_ty.def.get_tag();
        if vt_tag == ILTYPE_PTR || vt_tag == ILTYPE_PTRMUT || vt_tag == ILTYPE_BOXED || vt_tag == ILTYPE_BOXEDMUT {
            base_ty = p_ty.def.get_Ptr();
        }
        if base_ty == 0 as u32 { return 999999 as u32; }
        let p_base = self.builder.get_type_decl(base_ty);
        let type_name_id = (*p_base).name;

        if type_name_id == 0 as u32 {
            return 999999 as u32;
        }

        let type_str = self.intern_table.lookup(type_name_id);

        let name_len = type_str.len + 6 as usize;
        let name_buf_ptr = zoril_allocator_alloc(self.scratch_arena, name_len) as *mut u8;
        let mut name_buf = unsafe { @slice(name_buf_ptr, name_len) };
        unsafe { memcpy(name_buf_ptr, type_str.ptr, type_str.len as u64); }
        name_buf[type_str.len] = ':' as u8;
        name_buf[type_str.len + 1 as usize] = ':' as u8;
        name_buf[type_str.len + 2 as usize] = 'd' as u8;
        name_buf[type_str.len + 3 as usize] = 'r' as u8;
        name_buf[type_str.len + 4 as usize] = 'o' as u8;
        name_buf[type_str.len + 5 as usize] = 'p' as u8;

        let mangled = self.intern_table.intern(name_buf);

        let name_len_us = type_str.len + 5 as usize;
        let name_buf_ptr_us = zoril_allocator_alloc(self.scratch_arena, name_len_us) as *mut u8;
        let mut name_buf_us = unsafe { @slice(name_buf_ptr_us, name_len_us) };
        unsafe { memcpy(name_buf_ptr_us, type_str.ptr, type_str.len as u64); }
        name_buf_us[type_str.len] = '_' as u8;
        name_buf_us[type_str.len + 1 as usize] = 'd' as u8;
        name_buf_us[type_str.len + 2 as usize] = 'r' as u8;
        name_buf_us[type_str.len + 3 as usize] = 'o' as u8;
        name_buf_us[type_str.len + 4 as usize] = 'p' as u8;

        let mangled_us = self.intern_table.intern(name_buf_us);

        let mut fi = 0 as usize;
        while fi < self.zil_module.functions.len {
            let p_func = self.zil_module.get_function_mut(fi);
            if p_func.name == mangled || p_func.name == mangled_us {
                return fi as u32;
            }
            fi = fi + 1 as usize;
        }
        return 999999 as u32;
    }
    fn emit_narrow_wrap_mask(self: &mut ZirToZilLowerer, val: u32, ty: u32) -> u32 {
        if ty == 0 as u32 { return val; }
        let p_ty = self.builder.get_type_decl(ty);
        let tag = p_ty.def.get_tag();
        if tag == ILTYPE_PRIMITIVE {
            let prim = p_ty.def.get_Primitive().get_tag();
            let u32_ty = self.get_primitive_type(ILPRIM_U32);
            let i32_ty = self.get_primitive_type(ILPRIM_I32);
            if prim == ILPRIM_U8 {
                let mask = (*self.builder).emit_const_u64(255 as u64, u32_ty);
                return (*self.builder).emit_with_type(ILInstr.And(ILBinaryOp { lhs: val, rhs: mask }), ty);
            } else if prim == ILPRIM_I8 {
                let mask = (*self.builder).emit_const_u64(255 as u64, u32_ty);
                let masked = (*self.builder).emit_with_type(ILInstr.And(ILBinaryOp { lhs: val, rhs: mask }), u32_ty);
                let shift = (*self.builder).emit_const_u64(24 as u64, u32_ty);
                let shl = (*self.builder).emit_with_type(ILInstr.Shl(ILBinaryOp { lhs: masked, rhs: shift }), u32_ty);
                let sar = (*self.builder).emit_with_type(ILInstr.Shr(ILBinaryOp { lhs: shl, rhs: shift }), i32_ty);
                return (*self.builder).emit_cast(sar, ty);
            } else if prim == ILPRIM_U16 {
                let mask = (*self.builder).emit_const_u64(65535 as u64, u32_ty);
                return (*self.builder).emit_with_type(ILInstr.And(ILBinaryOp { lhs: val, rhs: mask }), ty);
            } else if prim == ILPRIM_I16 {
                let mask = (*self.builder).emit_const_u64(65535 as u64, u32_ty);
                let masked = (*self.builder).emit_with_type(ILInstr.And(ILBinaryOp { lhs: val, rhs: mask }), u32_ty);
                let shift = (*self.builder).emit_const_u64(16 as u64, u32_ty);
                let shl = (*self.builder).emit_with_type(ILInstr.Shl(ILBinaryOp { lhs: masked, rhs: shift }), u32_ty);
                let sar = (*self.builder).emit_with_type(ILInstr.Shr(ILBinaryOp { lhs: shl, rhs: shift }), i32_ty);
                return (*self.builder).emit_cast(sar, ty);
            }
        }
        return val;
    }

    // `==` / `!=` on slices: equal lengths and equal contents, via the runtime's
    // zoril_slice_eq. check_equality_operands admits only slices whose elements compare
    // correctly byte by byte (integers, bool, char, pointers), so a byte compare is exact.
    fn emit_slice_eq(self: &mut ZirToZilLowerer, op: u32, lhs: &Place, rhs: &Place, slice_ty: u32, local_slots: *mut u32, local_types: *mut u32) -> u32 {
        let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
        let bool_ty = self.get_primitive_type(ILPRIM_BOOL);
        let elem_size = self.get_type_size(self.get_slice_element_type(slice_ty));

        let lhs_addr = self.resolve_place_addr(lhs, local_slots, local_types);
        let rhs_addr = self.resolve_place_addr(rhs, local_slots, local_types);
        let lhs_ptr = self.load_slice_data_ptr(lhs_addr);
        let rhs_ptr = self.load_slice_data_ptr(rhs_addr);
        let lhs_len = self.load_slice_len(lhs_addr, usize_ty);
        let rhs_len = self.load_slice_len(rhs_addr, usize_ty);
        let size_ssa = (*self.builder).emit_const_u64(elem_size, usize_ty);
        let nbytes = (*self.builder).emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs_len, rhs: size_ssa }), usize_ty);

        let args_ptr = zoril_allocator_alloc(self.persistent_arena, 5 * 4) as *mut u32;
        let mut args = unsafe { @slice(args_ptr, 5 as usize) };
        args[0] = lhs_ptr;
        args[1] = rhs_ptr;
        args[2] = lhs_len;
        args[3] = rhs_len;
        args[4] = nbytes;
        let name_id = self.intern_table.intern("zoril_slice_eq");
        let equal = (*self.builder).emit_with_type(ILInstr.Call(CallInstr { args: args, name_id: name_id, is_extern: true }), bool_ty);
        if op == 8 as u32 { return equal; }
        let false_ssa = (*self.builder).emit_const_u64(0 as u64, bool_ty);
        return self.emit_binary_op(8 as u32, equal, false_ssa, bool_ty);
    }

    // A slice is addressed as a pointer to its {ptr, len} pair: ptr at offset 0, len at 8.
    fn load_slice_data_ptr(self: &mut ZirToZilLowerer, slice_addr: u32) -> u32 {
        let u8_ptr_ty = (*self.builder).get_ptr_type(self.get_primitive_type(ILPRIM_U8));
        let field_ptr = (*self.builder).emit_cast(slice_addr, (*self.builder).get_ptr_type(u8_ptr_ty));
        return (*self.builder).emit_with_type(ILInstr.Load(field_ptr), u8_ptr_ty);
    }

    fn load_slice_len(self: &mut ZirToZilLowerer, slice_addr: u32, usize_ty: u32) -> u32 {
        let len_off = (*self.builder).emit_const_u64(8 as u64, usize_ty);
        let len_ptr = (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: slice_addr, rhs: len_off }), (*self.builder).get_ptr_type(usize_ty));
        return (*self.builder).emit_with_type(ILInstr.Load(len_ptr), usize_ty);
    }

    // Is this local a temporary defined by a constant (or a cast or negation of one)?
    fn is_const_temp(self: &mut ZirToZilLowerer, local_id: u32, depth: usize) -> bool {
        if local_id == 0 as u32 || depth > 8 as usize || self.current_func as usize == 0 as usize { return false; }
        let blocks = unsafe { (*self.current_func).blocks };
        let mut bi = 0 as usize;
        while bi < blocks.len {
            let stmts = blocks[bi].statements;
            let mut si = 0 as usize;
            while si < stmts.len {
                let st = &stmts[si];
                if st.get_tag() == 0 as u32 && st.get_Let_id() == local_id { // Let
                    let rv = st.get_Let_rv();
                    let tag = rv.get_tag();
                    if tag == 3 as u32 { return true; } // Const
                    if tag == 12 as u32 { // Cast
                        let pl = rv.get_Cast_pl();
                        return (*pl).projections.len == 0 as usize && self.is_const_temp((*pl).base, depth + 1 as usize);
                    }
                    if tag == 5 as u32 && rv.get_UnaryOp_op() == 0 as u32 { // Neg
                        let pl = rv.get_UnaryOp_arg();
                        return (*pl).projections.len == 0 as usize && self.is_const_temp((*pl).base, depth + 1 as usize);
                    }
                    return false;
                }
                si = si + 1 as usize;
            }
            bi = bi + 1 as usize;
        }
        return false;
    }

    fn shift_width(self: &mut ZirToZilLowerer, ty: u32) -> u64 {
        if ty == 0 as u32 || self.builder.get_type_decl(ty).def.get_tag() != ILTYPE_PRIMITIVE { return 0 as u64; }
        return self.get_type_size(ty) * 8 as u64;
    }

    // Trap (exit 134, like a failed bounds check) unless 0 <= count < width. The count
    // is compared unsigned, so a negative count lands above the width and traps too.
    fn emit_shift_count_check(self: &mut ZirToZilLowerer, count: u32, ty: u32) {
        let width = self.shift_width(ty);
        if width == 0 as u64 { return; }
        let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
        let width_ssa = (*self.builder).emit_const_u64(width, usize_ty);
        (*self.builder).emit_bounds_check_against(count, width_ssa, usize_ty,
            self.get_primitive_type(ILPRIM_BOOL), self.get_primitive_type(ILPRIM_U64), self.get_primitive_type(ILPRIM_I64));
    }

    fn mask_shift_count(self: &mut ZirToZilLowerer, count: u32, ty: u32) -> u32 {
        let width = self.shift_width(ty);
        if width == 0 as u64 { return count; }
        let mask = (*self.builder).emit_const_u64(width - 1 as u64, ty);
        return (*self.builder).emit_with_type(ILInstr.And(ILBinaryOp { lhs: count, rhs: mask }), ty);
    }

    fn emit_binary_op(self: &mut ZirToZilLowerer, op: u32, lhs: u32, rhs: u32, res_ty: u32) -> u32 {
        let lhs_ty = (*self.builder).get_ssa_type(lhs);
        let rhs_ty = (*self.builder).get_ssa_type(rhs);
        let lhs_tag = if lhs_ty != 0 as u32 { self.builder.get_type_decl(lhs_ty).def.get_tag() } else { 0xffffffff as u32 };
        let rhs_tag = if rhs_ty != 0 as u32 { self.builder.get_type_decl(rhs_ty).def.get_tag() } else { 0xffffffff as u32 };
        let is_lhs_ptr = lhs_tag == ILTYPE_PTR || lhs_tag == ILTYPE_PTRMUT || lhs_tag == ILTYPE_BOXED || lhs_tag == ILTYPE_BOXEDMUT;
        let is_rhs_ptr = rhs_tag == ILTYPE_PTR || rhs_tag == ILTYPE_PTRMUT || rhs_tag == ILTYPE_BOXED || rhs_tag == ILTYPE_BOXEDMUT;

        let b = ILBinaryOp { lhs: lhs, rhs: rhs };

        match op {
            BINARY_ADD => {
                if is_lhs_ptr {
                    let inner = self.get_ptr_inner_type(lhs_ty);
                    let sz = self.get_type_size(inner);
                    let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
                    let sz_val = (*self.builder).emit_const_u64(sz, usize_ty);
                    let scaled_rhs = (*self.builder).emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: rhs, rhs: sz_val }), usize_ty);
                    return (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: lhs, rhs: scaled_rhs }), res_ty);
                } else if is_rhs_ptr {
                    let inner = self.get_ptr_inner_type(rhs_ty);
                    let sz = self.get_type_size(inner);
                    let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
                    let sz_val = (*self.builder).emit_const_u64(sz, usize_ty);
                    let scaled_lhs = (*self.builder).emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: lhs, rhs: sz_val }), usize_ty);
                    return (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: scaled_lhs, rhs: rhs }), rhs_ty);
                }
                return self.emit_narrow_wrap_mask((*self.builder).emit_with_type(ILInstr.Add(b), res_ty), res_ty);
            },
            BINARY_SUB => {
                if is_lhs_ptr && is_rhs_ptr {
                    let inner = self.get_ptr_inner_type(lhs_ty);
                    let sz = self.get_type_size(inner);
                    let isize_ty = self.get_primitive_type(ILPRIM_ISIZE);
                    let diff = (*self.builder).emit_with_type(ILInstr.Sub(b), isize_ty);
                    let sz_val = (*self.builder).emit_const_u64(sz, isize_ty);
                    return (*self.builder).emit_with_type(ILInstr.Div(ILBinaryOp { lhs: diff, rhs: sz_val }), isize_ty);
                } else if is_lhs_ptr {
                    let inner = self.get_ptr_inner_type(lhs_ty);
                    let sz = self.get_type_size(inner);
                    let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
                    let sz_val = (*self.builder).emit_const_u64(sz, usize_ty);
                    let scaled_rhs = (*self.builder).emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: rhs, rhs: sz_val }), usize_ty);
                    return (*self.builder).emit_with_type(ILInstr.Sub(ILBinaryOp { lhs: lhs, rhs: scaled_rhs }), res_ty);
                }
                return self.emit_narrow_wrap_mask((*self.builder).emit_with_type(ILInstr.Sub(b), res_ty), res_ty);
            },
            // u8/u16 arithmetic happens in a 32-bit register, so a result that
            // overflows the declared width has to be masked back down or it escapes
            // its own type: `200u8 + 100u8` was 300 as a temporary and 44 once
            // stored, and the two compared unequal. The wrapping operators below
            // always did this; the plain ones did not. `emit_narrow_wrap_mask` is a
            // no-op for every type wider than 16 bits. Signed division needs it too:
            // `-128i8 / -1i8` is 128, which is not an i8.
            BINARY_MUL => { return self.emit_narrow_wrap_mask((*self.builder).emit_with_type(ILInstr.Mul(b), res_ty), res_ty); },
            BINARY_DIV => { return self.emit_narrow_wrap_mask((*self.builder).emit_with_type(ILInstr.Div(b), res_ty), res_ty); },
            BINARY_MOD => { return (*self.builder).emit_with_type(ILInstr.Rem(b), res_ty); },
            BINARY_ADDWRAP => {
                let r = (*self.builder).emit_with_type(ILInstr.WrappingAdd(b), res_ty);
                return self.emit_narrow_wrap_mask(r, res_ty);
            },
            BINARY_SUBWRAP => {
                let r = (*self.builder).emit_with_type(ILInstr.Sub(b), res_ty);
                return self.emit_narrow_wrap_mask(r, res_ty);
            },
            BINARY_MULWRAP => {
                let r = (*self.builder).emit_with_type(ILInstr.Mul(b), res_ty);
                return self.emit_narrow_wrap_mask(r, res_ty);
            },
            BINARY_EQ  => { return (*self.builder).emit_with_type(ILInstr.CmpEq(b), res_ty); },
            BINARY_NE  => { return (*self.builder).emit_with_type(ILInstr.CmpNe(b), res_ty); },
            BINARY_LT  => { return (*self.builder).emit_with_type(ILInstr.CmpLt(b), res_ty); },
            BINARY_LE  => { return (*self.builder).emit_with_type(ILInstr.CmpLe(b), res_ty); },
            BINARY_GT  => { return (*self.builder).emit_with_type(ILInstr.CmpGt(b), res_ty); },
            BINARY_GE  => { return (*self.builder).emit_with_type(ILInstr.CmpGe(b), res_ty); },
            BINARY_AND => { return (*self.builder).emit_with_type(ILInstr.And(b), res_ty); },
            BINARY_OR  => { return (*self.builder).emit_with_type(ILInstr.Or(b), res_ty); },
            BINARY_XOR => { return (*self.builder).emit_with_type(ILInstr.Xor(b), res_ty); },
            BINARY_SHL => { return self.emit_narrow_wrap_mask((*self.builder).emit_with_type(ILInstr.Shl(b), res_ty), res_ty); },
            BINARY_SHR => { return (*self.builder).emit_with_type(ILInstr.Shr(b), res_ty); },
            BINARY_SHL_MASKED => {
                let masked = self.mask_shift_count(rhs, res_ty);
                return self.emit_narrow_wrap_mask((*self.builder).emit_with_type(ILInstr.Shl(ILBinaryOp { lhs: lhs, rhs: masked }), res_ty), res_ty);
            },
            BINARY_SHR_MASKED => {
                let masked = self.mask_shift_count(rhs, res_ty);
                return (*self.builder).emit_with_type(ILInstr.Shr(ILBinaryOp { lhs: lhs, rhs: masked }), res_ty);
            },
            _ => { ICE("ZirToZilLowerer.emit_binary_op: unknown binary op"); },
        }
    }
    fn needs_env_ptr(self: &mut ZirToZilLowerer, is_extern: bool, name: u32) -> bool {
        if is_extern { return false; }
        if name == self.intern_table.intern("main") { return false; }
        let name_slice = self.intern_table.lookup(name);
        if name_slice.len >= 16 as usize {
            if name_slice[0] == '_' as u8 && name_slice[1] == '_' as u8 && name_slice[2] == 'z' as u8 {
                return false;
            }
        }
        return true;
    }

    fn lower_rvalue(self: &mut ZirToZilLowerer, rv: &ZirRvalue, local_slots: *mut u32, local_types: *mut u32, local_closure_func_idxs: *mut u32) -> u32 {
        let tag = rv.get_tag();
        let addr = rv as usize;
        let u64_ty = self.get_primitive_type(ILPRIM_U64);
        
        if tag == 0 as u32 { // Use(Place)
            let place = rv.get_Use();
            return self.load_place(place, local_slots, local_types);
        } else if tag == 1 as u32 { // Ref(Place, u32)
            let place = rv.get_Ref();
            return self.ref_place_addr(place, local_slots, local_types);
        } else if tag == 2 as u32 { // RefMut(Place, u32)
            let place = rv.get_RefMut();
            return self.ref_place_addr(place, local_slots, local_types);
        } else if tag == 3 as u32 { // Const(u64, u32)
            let val = rv.get_Const_val();
            let mut ty = rv.get_Const_ty();
            if ty == 0 as u32 {
                ty = u64_ty;
            }
            let p_ty = self.builder.get_type_decl(ty);
            if p_ty.def.get_tag() == ILTYPE_PRIMITIVE {
                let prim = p_ty.def.get_Primitive().get_tag();
                if prim == ILPRIM_F64 || prim == ILPRIM_F32 {
                    return (*self.builder).emit_const_f64(val, ty);
                }
            }
            return (*self.builder).emit_const_u64(val, ty);
        } else if tag == 4 as u32 { // BinaryOp(u32, Place, Place)
            let op = rv.get_BinaryOp_op();
            let lhs = rv.get_BinaryOp_lhs();
            let rhs = rv.get_BinaryOp_rhs();
            let mut lhs_val = self.load_place(lhs, local_slots, local_types);
            let mut rhs_val = self.load_place(rhs, local_slots, local_types);

            let mut res_ty = self.get_place_type(lhs, local_types);
            if res_ty == 0 as u32 {
                res_ty = u64_ty;
            }

            if op == 8 as u32 || op == 9 as u32 {
                let lhs_slice_ty = self.get_place_type(lhs, local_types);
                if lhs_slice_ty != 0 as u32 && self.builder.get_type_decl(lhs_slice_ty).def.get_tag() == ILTYPE_SLICE {
                    return self.emit_slice_eq(op, lhs, rhs, lhs_slice_ty, local_slots, local_types);
                }
            }

            // For equality/ordering comparisons on enums, compare discriminants.
            // Use declared place types (from local_types) for detection because SSA types
            // for aggregate values (e.g. SumConstruct results) may not be reliable.
            if op >= 8 as u32 && op <= 13 as u32 {
                let u32_ty = self.get_primitive_type(ILPRIM_U32);
                let lhs_place_ty = self.get_place_type(lhs, local_types);
                if lhs_place_ty != 0 as u32 && (self.is_ptr_to_enum(lhs_place_ty) || self.is_enum_type(lhs_place_ty)) {
                    lhs_val = (*self.builder).emit_with_type(ILInstr.Load(lhs_val), u32_ty);
                    res_ty = u32_ty;
                } else {
                    let lhs_raw_ty = (*self.builder).get_ssa_type(lhs_val);
                    if lhs_raw_ty != 0 as u32 && (self.is_ptr_to_enum(lhs_raw_ty) || self.is_enum_type(lhs_raw_ty)) {
                        lhs_val = (*self.builder).emit_with_type(ILInstr.Load(lhs_val), u32_ty);
                        res_ty = u32_ty;
                    }
                }
                let rhs_place_ty = self.get_place_type(rhs, local_types);
                if rhs_place_ty != 0 as u32 && (self.is_ptr_to_enum(rhs_place_ty) || self.is_enum_type(rhs_place_ty)) {
                    rhs_val = (*self.builder).emit_with_type(ILInstr.Load(rhs_val), u32_ty);
                    res_ty = u32_ty;
                } else {
                    let rhs_raw_ty = (*self.builder).get_ssa_type(rhs_val);
                    if rhs_raw_ty != 0 as u32 && (self.is_ptr_to_enum(rhs_raw_ty) || self.is_enum_type(rhs_raw_ty)) {
                        rhs_val = (*self.builder).emit_with_type(ILInstr.Load(rhs_val), u32_ty);
                        res_ty = u32_ty;
                    }
                }
                // load_place for aggregate locals returns Ptr<T>; we need T for the comparison.
                // But a place whose own type is a pointer (`p: *Counter`) holds a pointer
                // VALUE: compare the addresses. Loading through it dereferenced `0 as *T`.
                if self.is_implicit_aggregate_ptr((*self.builder).get_ssa_type(lhs_val))
                    && !self.is_pointer_valued(self.get_place_type(lhs, local_types)) {
                    let inner = self.get_ptr_inner_type((*self.builder).get_ssa_type(lhs_val));
                    lhs_val = (*self.builder).emit_with_type(ILInstr.Load(lhs_val), inner);
                }
                if self.is_implicit_aggregate_ptr((*self.builder).get_ssa_type(rhs_val))
                    && !self.is_pointer_valued(self.get_place_type(rhs, local_types)) {
                    let inner = self.get_ptr_inner_type((*self.builder).get_ssa_type(rhs_val));
                    rhs_val = (*self.builder).emit_with_type(ILInstr.Load(rhs_val), inner);
                }
                let final_lhs = (*self.builder).emit_cast(lhs_val, res_ty);
                let final_rhs = (*self.builder).emit_cast(rhs_val, res_ty);
                return self.emit_binary_op(op, final_lhs, final_rhs, self.get_primitive_type(ILPRIM_BOOL));
            }

            // load_place for aggregate locals returns Ptr<T>; we need T for the operation
            // (not for a place whose own type is a pointer: see the comparison case above).
            if self.is_implicit_aggregate_ptr((*self.builder).get_ssa_type(lhs_val))
                && !self.is_pointer_valued(self.get_place_type(lhs, local_types)) {
                let inner = self.get_ptr_inner_type((*self.builder).get_ssa_type(lhs_val));
                lhs_val = (*self.builder).emit_with_type(ILInstr.Load(lhs_val), inner);
            }
            if self.is_implicit_aggregate_ptr((*self.builder).get_ssa_type(rhs_val))
                && !self.is_pointer_valued(self.get_place_type(rhs, local_types)) {
                let inner = self.get_ptr_inner_type((*self.builder).get_ssa_type(rhs_val));
                rhs_val = (*self.builder).emit_with_type(ILInstr.Load(rhs_val), inner);
            }
            let final_lhs = (*self.builder).emit_cast(lhs_val, res_ty);
            let final_rhs = (*self.builder).emit_cast(rhs_val, res_ty);
            // A shift count outside [0, width) traps instead of being masked by the
            // hardware to the register width. A constant count was range-checked at
            // compile time (check_shift_count), so it costs nothing here.
            if (op == BINARY_SHL || op == BINARY_SHR) && !self.is_const_temp(rhs.base, 0 as usize) {
                self.emit_shift_count_check(final_rhs, res_ty);
            }
            return self.emit_binary_op(op, final_lhs, final_rhs, res_ty);
        } else if tag == 5 as u32 { // UnaryOp(u32, Place)
            let op = rv.get_UnaryOp_op();
            let operand = rv.get_UnaryOp_arg();
            let val = self.load_place(operand, local_slots, local_types);
            let mut res_ty = self.get_place_type(operand, local_types);
            if res_ty == 0 as u32 {
                res_ty = u64_ty;
            }
            
            // Same width rule as `emit_binary_op`: a u8/i8/u16/i16 result is
            // evaluated in a 32-bit register, so it has to be masked back down to
            // its declared width or the temporary and the stored value disagree
            // (`!0u8` is 0xffffffff unmasked, 255 once stored). `-(-128i8)` is the
            // signed case. `emit_narrow_wrap_mask` is a no-op above 16 bits and for
            // `bool`, so `!flag` and all wider negations are untouched.
            if op == 0 as u32 { // UNARY_NEG
                return self.emit_narrow_wrap_mask((*self.builder).emit_with_type(ILInstr.Neg(val), res_ty), res_ty);
            } else { // UNARY_NOT
                return self.emit_narrow_wrap_mask((*self.builder).emit_with_type(ILInstr.Not(val), res_ty), res_ty);
            }
        } else if tag == 6 as u32 { // Call(u32, [Place])
            let fn_idx = rv.get_Call_id();
            let args_places = rv.get_Call_args();
            
            let p_f = self.zil_module.get_function_mut(fn_idx as usize);
            let ret_ty = p_f.ret_ty;
            let needs_sret = self.is_aggregate(ret_ty);
            let needs_env = self.needs_env_ptr(p_f.is_extern, p_f.name);
            
            let mut zil_args_len = args_places.len;
            if needs_sret { zil_args_len = zil_args_len + 1 as usize; }
            if needs_env { zil_args_len = zil_args_len + 1 as usize; }
            
            let zil_args_ptr = zoril_allocator_alloc(self.persistent_arena, zil_args_len * 4) as *mut u32;
            let mut zil_args = unsafe { @slice(zil_args_ptr, zil_args_len) };
            
            let mut sret_temp_slot = NO_SSA as u32;
            let mut dst_idx = 0 as usize;
            if needs_sret {
                let ptr_ty = (*self.builder).get_ptr_type(ret_ty);
                let saved = (*self.builder).current_block_idx;
                (*self.builder).switch_to_block((*self.builder).entry_block_idx);
                sret_temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: ret_ty, allocator: NO_SSA as u32 }), ptr_ty);
                (*self.builder).switch_to_block(saved);
                
                zil_args[0] = sret_temp_slot;
                dst_idx = 1 as usize;
            }
            
            if needs_env {
                let unit_ptr_ty = (*self.builder).get_ptr_type(self.get_primitive_type(ILPRIM_UNIT));
                let env_val = (*self.builder).emit_const_u64(0 as u64, unit_ptr_ty);
                zil_args[dst_idx] = env_val;
                dst_idx = dst_idx + 1 as usize;
            }

            let mut ai = 0 as usize;
            while ai < args_places.len {
                let arg_place = &args_places[ai];
                let arg_val = self.load_place(arg_place, local_slots, local_types);
                zil_args[dst_idx] = arg_val;
                dst_idx = dst_idx + 1 as usize;
                ai = ai + 1 as usize;
            }
            
            let call_res_ty = if needs_sret { self.get_primitive_type(ILPRIM_UNIT) } else { ret_ty };
            let call_ssa = (*self.builder).emit_with_type(ILInstr.Call(CallInstr { args: zil_args, name_id: p_f.name, is_extern: p_f.is_extern }), call_res_ty);
            
            if needs_sret {
                return sret_temp_slot;
            }
            return call_ssa;
        } else if tag == 7 as u32 { // CallPtr(Place, [Place])
            let fn_place = rv.get_CallPtr_pl();
            let args_places = rv.get_CallPtr_args();

            let fn_val = self.load_place(fn_place, local_slots, local_types);
            let fn_ptr_ty = self.get_place_type(fn_place, local_types);
            let mut inner_ty = self.get_ptr_inner_type(fn_ptr_ty);
            // fn(T)->U parameters are stored directly as ILType.Fn, not Ptr<Fn>
            if inner_ty == 0 as u32 && fn_ptr_ty != 0 as u32 {
                let p_fty = self.builder.get_type_decl(fn_ptr_ty);
                if (*p_fty).def.get_tag() == ILTYPE_FN {
                    inner_ty = fn_ptr_ty;
                }
            }
            if inner_ty == 0 as u32 { return NO_SSA as u32; }
            let p_fn_type = self.builder.get_type_decl(inner_ty);
            let fn_def = (*p_fn_type).def.get_Fn();
            let ret_ty = fn_def.ret_ty;
            let needs_sret = self.is_aggregate(ret_ty);
            let needs_env = true; // All function pointers are closures
            
            let mut zil_args_len = args_places.len;
            if needs_sret { zil_args_len = zil_args_len + 1 as usize; }
            if needs_env { zil_args_len = zil_args_len + 1 as usize; }

            let zil_args_ptr = zoril_allocator_alloc(self.persistent_arena, zil_args_len * 4) as *mut u32;
            let mut zil_args = unsafe { @slice(zil_args_ptr, zil_args_len) };
            
            let mut sret_temp_slot = NO_SSA as u32;
            let mut dst_idx = 0 as usize;
            if needs_sret {
                let ptr_ty = (*self.builder).get_ptr_type(ret_ty);
                let saved = (*self.builder).current_block_idx;
                (*self.builder).switch_to_block((*self.builder).entry_block_idx);
                sret_temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: ret_ty, allocator: NO_SSA as u32 }), ptr_ty);
                (*self.builder).switch_to_block(saved);
                
                zil_args[0] = sret_temp_slot;
                dst_idx = 1 as usize;
            }
            
            let env_ssa = self.get_closure_env_ssa_for_place(fn_place, local_slots, local_closure_func_idxs);
            if needs_env {
                let env_val = if env_ssa != NO_SSA as u32 { env_ssa } else {
                    let unit_ptr_ty = (*self.builder).get_ptr_type(self.get_primitive_type(ILPRIM_UNIT));
                    (*self.builder).emit_const_u64(0 as u64, unit_ptr_ty)
                };
                zil_args[dst_idx] = env_val;
                dst_idx = dst_idx + 1 as usize;
            }

            let mut ai = 0 as usize;
            while ai < args_places.len {
                let arg_place = &args_places[ai];
                let arg_val = self.load_place(arg_place, local_slots, local_types);
                zil_args[dst_idx] = arg_val;
                dst_idx = dst_idx + 1 as usize;
                ai = ai + 1 as usize;
            }
            
            let call_res_ty = if needs_sret { self.get_primitive_type(ILPRIM_UNIT) } else { ret_ty };
            let call_ssa = (*self.builder).emit_with_type(ILInstr.CallPtr(CallPtrInstr { args: zil_args, func_ptr: fn_val, env_ssa: env_ssa }), call_res_ty);
            
            if needs_sret {
                return sret_temp_slot;
            }
            return call_ssa;
        } else if tag == 8 as u32 { // StructLiteral(u32, [Place])
            let struct_ty = rv.get_StructLiteral_ty();
            let vals = rv.get_StructLiteral_args();
            
            let ptr_ty = (*self.builder).get_ptr_type(struct_ty);
            let saved = (*self.builder).current_block_idx;
            (*self.builder).switch_to_block((*self.builder).entry_block_idx);
            let temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: struct_ty, allocator: NO_SSA as u32 }), ptr_ty);
            (*self.builder).switch_to_block(saved);
            
            let mut vi = 0 as usize;
            while vi < vals.len {
                let f_val = self.load_place(&vals[vi], local_slots, local_types);
                let f_ty = self.get_field_type(struct_ty, vi as u32);
                let f_ptr_ty = (*self.builder).get_ptr_type(f_ty);
                let f_addr = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: temp_slot, field_idx: vi as u32 }), f_ptr_ty);
                let f_size = self.get_type_size(f_ty);
                if f_size > 0 as u64 {
                    if self.is_aggregate(f_ty) {
                        // f_val is a pointer to the aggregate; use memcpy to copy bytes
                        self.emit_memcpy(f_addr, f_val, f_size);
                    } else {
                        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: f_addr, val: f_val }));
                    }
                }
                vi = vi + 1 as usize;
            }
            return temp_slot;
        } else if tag == 9 as u32 { // EnumVariant(enum_ty, variant_idx, payload_place)
            let enum_ty = rv.get_EnumVariant_ty();
            let variant_idx = rv.get_EnumVariant_idx();
            let payload_place = rv.get_EnumVariant_payload();
            
            let mut payload_ssa = NO_SSA as u32;
            if (*payload_place).base != 0 as u32 {
                payload_ssa = self.load_place(payload_place, local_slots, local_types);
            }

            let ptr_ty = (*self.builder).get_ptr_type(enum_ty);
            let saved = (*self.builder).current_block_idx;
            (*self.builder).switch_to_block((*self.builder).entry_block_idx);
            let temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: enum_ty, allocator: NO_SSA as u32 }), ptr_ty);
            (*self.builder).switch_to_block(saved);

            let disc = self.get_variant_discriminant(enum_ty, variant_idx);
            let disc_val = (*self.builder).emit_const_u64(disc as u64, self.get_primitive_type(ILPRIM_U32));
            (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: temp_slot, val: disc_val }));
            
            if payload_ssa != NO_SSA as u32 {
                let val_ty = self.get_variant_payload_type(enum_ty, variant_idx);
                let payload_ptr_ty = (*self.builder).get_ptr_type(val_ty);
                let payload_addr = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: temp_slot, field_idx: 1 as u32 }), payload_ptr_ty);
                
                let payload_size = self.get_type_size(val_ty);
                if payload_size > 0 as u64 {
                    if self.is_aggregate(val_ty) {
                        // payload_ssa is a pointer to the aggregate; copy bytes
                        self.emit_memcpy(payload_addr, payload_ssa, payload_size);
                    } else {
                        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: payload_addr, val: payload_ssa }));
                    }
                }
            }

            return temp_slot;
        } else if tag == 10 as u32 { // Field(place, field_name)
            let place = rv.get_Field_pl();
            let field_name = rv.get_Field_name();
            
            // Growing the projection list is raw arena work; the result is handed
            // back as a bounds-checked slice.
            let new_projs_len = place.projections.len + 1 as usize;
            let new_projs = zoril_allocator_alloc(self.scratch_arena, new_projs_len * sizeof(Projection)) as *mut Projection;
            let new_projs_slice = unsafe {
                if place.projections.len > 0 as usize {
                    memcpy(new_projs as *mut u8, place.projections.ptr as *u8, place.projections.len * sizeof(Projection));
                }
                let p_last = (new_projs as usize + place.projections.len * sizeof(Projection)) as *mut Projection;
                *p_last = Projection.Field(field_name);
                @slice(new_projs, new_projs_len)
            };
            let temp_place = Place { base: place.base, projections: new_projs_slice };
            return self.load_place(&temp_place, local_slots, local_types);
        } else if tag == 11 as u32 { // Index(place, index_place)
            let place = rv.get_Index_pl();
            let idx_place = rv.get_Index_idx();

            let base_val = self.load_place(place, local_slots, local_types);
            let idx_val = self.load_place(idx_place, local_slots, local_types);

            let base_ty = self.get_place_type(place, local_types);
            if base_ty == 0 as u32 { return NO_SSA as u32; }
            // Auto-deref Ptr(Slice)/PtrMut(Slice) to treat as slice indexing
            let p_base_ty = self.builder.get_type_decl(base_ty);
            let base_tag = (*p_base_ty).def.get_tag();
            let mut effective_ty = base_ty;
            if base_tag == ILTYPE_PTR || base_tag == ILTYPE_PTRMUT {
                let inner = self.get_ptr_inner_type(base_ty);
                if inner != 0 as u32 {
                    let inner_tag = self.builder.get_type_decl(inner).def.get_tag();
                    if inner_tag == ILTYPE_SLICE || inner_tag == ILTYPE_ARRAY {
                        effective_ty = inner;
                    }
                }
            }
            let elem_ty = self.get_slice_element_type(effective_ty);
            let p_eff_ty = self.builder.get_type_decl(effective_ty);
            let is_slice = p_eff_ty.def.get_tag() == ILTYPE_SLICE;

            if is_slice {
                return (*self.builder).emit_with_type(ILInstr.SliceLoad(IndexInstr { base: base_val, idx: idx_val }), elem_ty);
            } else {
                return (*self.builder).emit_with_type(ILInstr.ArrayLoad(IndexInstr { base: base_val, idx: idx_val }), elem_ty);
            }
        } else if tag == 12 as u32 { // Cast(place, target_ty)
            let place = rv.get_Cast_pl();
            let mut target_ty = rv.get_Cast_ty();
            if target_ty == 0 as u32 {
                target_ty = u64_ty;
            }

            let mut val = self.load_place(place, local_slots, local_types);
            // For enum-to-integer casts: load_place returns the aggregate address
            // (implicit ptr-to-enum), and we must load the discriminant word so the
            // cast operates on a scalar.
            //
            // CRITICAL: we must distinguish between two SSA-level identical cases:
            //   (a) `e as u32` where `e: SomeEnum` — load_place returns the alloc
            //       pointer holding the enum; we MUST load the discriminant.
            //   (b) `p as usize` where `p: *mut SomeEnum` — `p` is a genuine
            //       pointer to memory; we MUST NOT dereference it.
            // The SSA type of `val` is `*SomeEnum` in BOTH cases. Disambiguate by
            // consulting the *declared* place type from local_types — a real ptr-
            // to-enum field shows up there as `*mut SomeEnum`; an enum value shows
            // up as `SomeEnum`.
            let place_ty = self.get_place_type(place, local_types);
            let mut is_enum_by_value = false;
            let mut is_slice = false;
            if place_ty != 0 as u32 {
                let p_place_ty = self.builder.get_type_decl(place_ty);
                let place_tag = (*p_place_ty).def.get_tag();
                if place_tag == ILTYPE_USER {
                    let user_id = (*p_place_ty).def.get_User().id;
                    if user_id < (*self.resolver.ast).decls.len as u32 {
                        self.mono.lower_typedef(user_id);
                    }
                    let p_def = self.zil_module.get_typedef_mut(user_id as usize);
                    if p_def.get_tag() == IL_TYPEDEF_ENUM {
                        is_enum_by_value = true;
                    }
                } else if place_tag == ILTYPE_SLICE {
                    is_slice = true;
                }
            }
            if is_enum_by_value {
                let val_ty = (*self.builder).get_ssa_type(val);
                if val_ty != 0 as u32 && self.is_implicit_aggregate_ptr(val_ty) {
                    let u32_ty = self.get_primitive_type(ILPRIM_U32);
                    val = (*self.builder).emit_with_type(ILInstr.Load(val), u32_ty);
                }
            } else if is_slice {
                let p_target_ty = self.builder.get_type_decl(target_ty);
                let target_tag = (*p_target_ty).def.get_tag();
                let mut is_target_ptr_like = false;
                if target_tag == ILTYPE_PTR || target_tag == ILTYPE_PTRMUT {
                    is_target_ptr_like = true;
                } else if target_tag == ILTYPE_PRIMITIVE {
                    let prim = (*p_target_ty).def.get_Primitive();
                    let prim_tag = prim.get_tag();
                    if prim_tag == ILPRIM_U64 || prim_tag == ILPRIM_USIZE || prim_tag == ILPRIM_I64 || prim_tag == ILPRIM_ISIZE {
                        is_target_ptr_like = true;
                    }
                }
                if is_target_ptr_like {
                    let elem_ty = self.get_slice_element_type(place_ty);
                    let ptr_ty = (*self.builder).get_ptr_type(elem_ty);
                    val = (*self.builder).emit_with_type(ILInstr.Load(val), ptr_ty);
                }
            }
            // A cast whose source is a pointer to exactly the target aggregate
            // type (e.g. `@ptr_cast<[u8]>(p)` where `p: *[u8]`) means "treat
            // this pointer as addressing the aggregate value" - aggregates are
            // represented throughout this lowering by their address (see
            // load_place above), so this is a passthrough Move that keeps the
            // pointer type, not a Load that produces a value of the aggregate
            // type itself. A raw Cast here would try to squeeze an 8-byte
            // pointer into a larger aggregate-typed SSA slot, which downstream
            // codegen has no defined behavior for.
            if self.is_aggregate(target_ty) {
                let val_ty = (*self.builder).get_ssa_type(val);
                if val_ty != 0 as u32 && self.get_ptr_inner_type(val_ty) == target_ty {
                    return (*self.builder).emit_with_type(ILInstr.Move(val), val_ty);
                }
            }
            return (*self.builder).emit_cast(val, target_ty);
        } else if tag == 13 as u32 { // Sizeof(ty)
            let mut ty = rv.get_Sizeof_ty();
            if ty == 0 as u32 {
                ty = u64_ty;
            }
            let sz = self.get_type_size(ty);
            let usize_ty = self.get_primitive_type(ILPRIM_USIZE);
            return (*self.builder).emit_const_u64(sz, usize_ty);
        } else if tag == 14 as u32 { // Syscall([Place]); args[0]=num, args[1..]=args
            let args_places = rv.get_Syscall_args();

            let u64_ty = self.get_primitive_type(ILPRIM_U64);
            let num_val = self.load_place(&args_places[0], local_slots, local_types);
            let num_ssa = (*self.builder).emit_cast(num_val, u64_ty);

            let nargs = args_places.len - 1 as usize;
            let zil_args_ptr = zoril_allocator_alloc(self.persistent_arena, nargs * 4) as *mut u32;
            let mut zil_args = unsafe { @slice(zil_args_ptr, nargs) };
            let mut ai = 0 as usize;
            while ai < nargs {
                let arg_val = self.load_place(&args_places[ai + 1 as usize], local_slots, local_types);
                let casted = (*self.builder).emit_cast(arg_val, u64_ty);
                zil_args[ai] = casted;
                ai = ai + 1 as usize;
            }
            let res_ty = self.get_primitive_type(ILPRIM_I64);
            return (*self.builder).emit_with_type(ILInstr.Syscall(SyscallInstr { num: num_ssa, args: zil_args }), res_ty);
        } else if tag == 26 as u32 { // PtrFromInt(place, target_ty) - @ptr_from_int<T>
            // Same lowering as Cast, but emitted through emit_ptr_from_int so the
            // authorization reaches the IL. Never short-circuits on a same-type
            // source, since the instruction is the marker.
            let pfi_place = rv.get_PtrFromInt_pl();
            let mut pfi_target_ty = rv.get_PtrFromInt_ty();
            if pfi_target_ty == 0 as u32 {
                pfi_target_ty = u64_ty;
            }
            let pfi_val = self.load_place(pfi_place, local_slots, local_types);
            return (*self.builder).emit_ptr_from_int(pfi_val, pfi_target_ty);
        } else if tag == 15 as u32 { // Intrinsic(u32, [Place])
            let name_id = rv.get_Intrinsic_id();
            let args_places = rv.get_Intrinsic_args();
            let name_str = self.intern_table.lookup(name_id);
            if is_str_eq(name_str, "saturating_add") {
                let lhs = self.load_place(&args_places[0], local_slots, local_types);
                let rhs = self.load_place(&args_places[1], local_slots, local_types);
                let res_ty = self.get_place_type(&args_places[0], local_types);
                return (*self.builder).emit_with_type(ILInstr.SaturatingAdd(ILBinaryOp { lhs: lhs, rhs: rhs }), res_ty);
            }
            return NO_SSA as u32;
        } else if tag == 16 as u32 { // StringConst(id)
            let id = rv.get_StringConst_id();
            let str_slice = self.intern_table.lookup(id);
            let u8_ty = self.get_primitive_type(ILPRIM_U8);
            let slice_ty = (*self.builder).get_slice_type(u8_ty);
            let ptr_ty = (*self.builder).get_ptr_type(slice_ty);
            let usize_ty = self.get_primitive_type(ILPRIM_USIZE);

            // Allocate a {ptr, len} slice struct on the stack (in the entry block)
            let saved_blk = (*self.builder).current_block_idx;
            (*self.builder).switch_to_block((*self.builder).entry_block_idx);
            let slice_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: slice_ty, allocator: NO_SSA as u32 }), ptr_ty);
            (*self.builder).switch_to_block(saved_blk);

            // Store ptr field (offset 0): the intern table address of the string data.
            // The field-address pointers below are cast to point at their actual field
            // type (not the whole slice_ty aggregate), so each store is a plain field
            // store rather than a 16-byte aggregate copy.
            let str_ptr_ssa = (*self.builder).emit_with_type(ILInstr.StringConst(str_slice), (*self.builder).get_ptr_type(u8_ty));
            let ptr_field_ptr_ty = (*self.builder).get_ptr_type((*self.builder).get_ptr_type(u8_ty));
            let ptr_field_ptr = (*self.builder).emit_cast(slice_slot, ptr_field_ptr_ty);
            (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: ptr_field_ptr, val: str_ptr_ssa }));

            // Store len field (offset 8)
            let len_off = (*self.builder).emit_const_u64(8 as u64, usize_ty);
            let usize_ptr_ty = (*self.builder).get_ptr_type(usize_ty);
            let len_ptr = (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: slice_slot, rhs: len_off }), usize_ptr_ty);
            let len_val = (*self.builder).emit_const_u64(str_slice.len as u64, usize_ty);
            (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: len_ptr, val: len_val }));

            // Return pointer to the slice struct (type *[u8], passed as 'l' in calls)
            return slice_slot;
        } else if tag == 17 as u32 { // VariantCheck(place, enum_ty, variant_idx)
            let place = rv.get_VariantCheck_pl();
            let enum_ty = rv.get_VariantCheck_ty();
            let variant_idx = rv.get_VariantCheck_idx();
            let enum_ptr = self.enum_address(place, local_slots, local_types);
            return (*self.builder).emit_with_type(ILInstr.VariantMatch(VariantMatchInstr { val: enum_ptr, type_id: enum_ty, variant_idx: variant_idx }), self.get_primitive_type(ILPRIM_BOOL));
        } else if tag == 18 as u32 { // EnumPayload(place, enum_ty, variant_idx)
            let place = rv.get_EnumPayload_pl();
            let enum_ty = rv.get_EnumPayload_ty();
            let variant_idx = rv.get_EnumPayload_idx();
            let enum_ptr = self.enum_address(place, local_slots, local_types);
            let payload_ty = self.get_variant_payload_type(enum_ty, variant_idx);
            let ptr_ty = (*self.builder).get_ptr_type(payload_ty);
            return (*self.builder).emit_with_type(ILInstr.Unwrap(enum_ptr), ptr_ty);
        } else if tag == 19 as u32 { // GlobalAddr(id)
            let id = rv.get_GlobalAddr_id();
            let p_g = self.zil_module.get_global_mut(id as usize);
            let ptr_ty = (*self.builder).get_ptr_type(p_g.ty);
            return (*self.builder).emit_with_type(ILInstr.GlobalAddr(id), ptr_ty);
        } else if tag == 20 as u32 { // FuncAddr(id)
            let id = rv.get_FuncAddr_id();
            let p_f = self.zil_module.get_function_mut(id as usize);
            let fn_ty = self.get_fn_type(p_f);
            let ptr_ty = (*self.builder).get_ptr_type(fn_ty);
            let func_ssa = (*self.builder).emit_with_type(ILInstr.FuncAddr(p_f.id), ptr_ty);
            
            let env_local_id = self.mono.lookup_zir_closure_env(id);
            if env_local_id != 0 as u32 {
                let env_ssa = unsafe { local_slots[env_local_id as usize] };
                if env_ssa != 0 as u32 && env_ssa != 0xffffffff as u32 {
                    let legacy_lowerer = self.mono.lowerer;
                    if legacy_lowerer as usize != 0 as usize {
                        // Non-null per the check above; `Monomorphizer.lowerer` is a
                        // nullable back-pointer to the other lowering pass, whose
                        // capture table is a pair of raw parallel arrays.
                        let ll: &mut Lowerer = unsafe { &mut *legacy_lowerer };
                        if ll.cap_table_len < ll.cap_table_cap {
                            let mut func_ssas = unsafe { @slice(ll.cap_func_ssas, ll.cap_table_cap) };
                            let mut env_ptrs = unsafe { @slice(ll.cap_env_ptrs, ll.cap_table_cap) };
                            func_ssas[ll.cap_table_len] = func_ssa;
                            env_ptrs[ll.cap_table_len] = env_ssa;
                            ll.cap_table_len = ll.cap_table_len + 1 as usize;
                        }
                    }
                }
            }
            return func_ssa;
        } else if tag == 21 as u32 { // Tuple([Place])
            let args_places = rv.get_Tuple_elements();
            let mut ai = 0 as usize;
            let elem_types_ptr = zoril_allocator_alloc(self.persistent_arena, args_places.len * 4) as *mut u32;
            let mut elem_types = unsafe { @slice(elem_types_ptr, args_places.len) };
            while ai < args_places.len {
                elem_types[ai] = self.get_place_type(&args_places[ai], local_types);
                ai = ai + 1 as usize;
            }
            let tuple_ty = self.zil_module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Tuple(elem_types) , source_file: 0 as u32 });
            
            let ptr_ty = (*self.builder).get_ptr_type(tuple_ty);
            let saved = (*self.builder).current_block_idx;
            (*self.builder).switch_to_block((*self.builder).entry_block_idx);
            let temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: tuple_ty, allocator: NO_SSA as u32 }), ptr_ty);
            (*self.builder).switch_to_block(saved);

            ai = 0 as usize;
            while ai < args_places.len {
                let arg_val = self.load_place(&args_places[ai], local_slots, local_types);
                let f_ty = elem_types[ai];
                let f_ptr_ty = (*self.builder).get_ptr_type(f_ty);
                let f_addr = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: temp_slot, field_idx: ai as u32 }), f_ptr_ty);
                let f_size = self.get_type_size(f_ty);
                if f_size > 0 as u64 {
                    if self.is_aggregate(f_ty) {
                        self.emit_memcpy(f_addr, arg_val, f_size);
                    } else {
                        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: f_addr, val: arg_val }));
                    }
                }
                ai = ai + 1 as usize;
            }
            return temp_slot;
        } else if tag == 22 as u32 { // Array(u32, [Place])
            let elem_ty = rv.get_Array_ty();
            let args_places = rv.get_Array_elements();
            
            let array_ty = self.zil_module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Array(ILArray { element: elem_ty, size: args_places.len as u32 }) , source_file: 0 as u32 });
            let ptr_ty = (*self.builder).get_ptr_type(array_ty);
            let saved = (*self.builder).current_block_idx;
            (*self.builder).switch_to_block((*self.builder).entry_block_idx);
            let temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: array_ty, allocator: NO_SSA as u32 }), ptr_ty);
            (*self.builder).switch_to_block(saved);

            let mut ai = 0 as usize;
            let elem_size = self.get_type_size(elem_ty);
            let elem_is_agg = self.is_aggregate(elem_ty);
            while ai < args_places.len {
                let arg_val = self.load_place(&args_places[ai], local_slots, local_types);
                let f_ptr_ty = (*self.builder).get_ptr_type(elem_ty);

                // Manual address arithmetic for array elements
                let off = (*self.builder).emit_const_u64((ai * elem_size) as u64, self.get_primitive_type(ILPRIM_USIZE));
                let f_addr = (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: temp_slot, rhs: off }), f_ptr_ty);

                if elem_size > 0 as usize {
                    if elem_is_agg {
                        // arg_val is a pointer to the aggregate; copy its bytes
                        self.emit_memcpy(f_addr, arg_val, elem_size as u64);
                    } else {
                        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: f_addr, val: arg_val }));
                    }
                }
                ai = ai + 1 as usize;
            }
            return temp_slot;
        } else if tag == ZIR_RV_ARRAY_REPEAT { // ArrayRepeat(value, elem_ty, count): fill by a loop
            let elem_ty = rv.get_ArrayRepeat_ty();
            let count = rv.get_ArrayRepeat_count();
            let array_ty = self.zil_module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.Array(ILArray { element: elem_ty, size: count }) , source_file: 0 as u32 });
            let ptr_ty = (*self.builder).get_ptr_type(array_ty);
            let saved = (*self.builder).current_block_idx;
            (*self.builder).switch_to_block((*self.builder).entry_block_idx);
            let temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: array_ty, allocator: NO_SSA as u32 }), ptr_ty);
            (*self.builder).switch_to_block(saved);
            let val = self.load_place(rv.get_ArrayRepeat_val(), local_slots, local_types);
            self.emit_array_fill_loop(temp_slot, elem_ty, val, count as u64);
            return temp_slot;
        } else if tag == 23 as u32 { // IndexAddr(base_place, idx_place) → pointer to element
            let base_place = rv.get_IndexAddr_base();
            let idx_place = rv.get_IndexAddr_idx();

            let base_val = self.load_place(base_place, local_slots, local_types);
            let idx_val = self.load_place(idx_place, local_slots, local_types);

            let base_ty = self.get_place_type(base_place, local_types);
            if base_ty == 0 as u32 { return NO_SSA as u32; }

            let p_base_ty = self.builder.get_type_decl(base_ty);
            let base_tag = (*p_base_ty).def.get_tag();
            let mut effective_ty = base_ty;

            if base_tag == ILTYPE_PTR || base_tag == ILTYPE_PTRMUT {
                let inner = self.get_ptr_inner_type(base_ty);
                if inner != 0 as u32 {
                    let inner_tag = self.builder.get_type_decl(inner).def.get_tag();
                    if inner_tag == ILTYPE_SLICE || inner_tag == ILTYPE_ARRAY || (base_tag != ILTYPE_PTRMUT && self.is_vec_type(inner)) {
                        effective_ty = inner;
                    }
                }
            }

            let p_eff_ty = self.builder.get_type_decl(effective_ty);
            let is_slice = p_eff_ty.def.get_tag() == ILTYPE_SLICE;
            let is_array = p_eff_ty.def.get_tag() == ILTYPE_ARRAY;
            let is_vec = base_tag != ILTYPE_PTRMUT && self.is_vec_type(effective_ty);
            let elem_ty = self.get_slice_element_type(effective_ty);
            let elem_size = self.get_type_size(elem_ty);
            let ptr_elem_ty = (*self.builder).get_ptr_type(elem_ty);
            let usize_ty = self.get_primitive_type(ILPRIM_USIZE);

            let idx_usize = (*self.builder).emit_cast(idx_val, usize_ty);
            let elem_size_ssa = (*self.builder).emit_const_u64(elem_size, usize_ty);
            let offset = (*self.builder).emit_with_type(ILInstr.Mul(ILBinaryOp { lhs: idx_usize, rhs: elem_size_ssa }), usize_ty);

            if is_slice || is_array || is_vec {
                let bool_ty = self.get_primitive_type(ILPRIM_BOOL);
                let u64_ty = self.get_primitive_type(ILPRIM_U64);
                let i64_ty = self.get_primitive_type(ILPRIM_I64);
                if is_slice || is_vec {
                    (*self.builder).emit_slice_bounds_check(base_val, idx_usize, usize_ty, bool_ty, u64_ty, i64_ty);
                } else {
                    let arr_len = p_eff_ty.def.get_Array().size;
                    (*self.builder).emit_array_bounds_check(idx_usize, arr_len as u64, usize_ty, bool_ty, u64_ty, i64_ty);
                }
            }

            let mut array_ptr = base_val;
            if is_slice || is_vec {
                let ptr_field_ptr_ty = (*self.builder).get_ptr_type(ptr_elem_ty);
                let ptr_field_addr = (*self.builder).emit_with_type(ILInstr.FieldAddr(FieldAddrInstr { val: base_val, field_idx: 0 as u32 }), ptr_field_ptr_ty);
                array_ptr = (*self.builder).emit_with_type(ILInstr.Load(ptr_field_addr), ptr_elem_ty);
            }

            return (*self.builder).emit_with_type(ILInstr.Add(ILBinaryOp { lhs: array_ptr, rhs: offset }), ptr_elem_ty);
        } else if tag == 24 as u32 { // Boxed(Place, u32)
            let val_place = rv.get_Boxed_val();
            let alloc_local_id = rv.get_Boxed_alloc();
            let val = self.load_place(val_place, local_slots, local_types);
            let mut ty = (*self.builder).get_ssa_type(val);
            let is_agg = self.is_implicit_aggregate_ptr(ty) && self.builder.get_type_decl(ty).def.get_tag() == ILTYPE_PTR;
            if is_agg { ty = self.get_ptr_inner_type(ty); }
            let target_ty = self.zil_module.alloc_type(ILTypeDecl { id: 0, name: 0, def: ILType.BoxedMut(ty) , source_file: 0 as u32 });
            let mut alloc_ssa = NO_SSA as u32;
            let mut region = Region.Heap;
            if alloc_local_id != 0 as u32 {
                alloc_ssa = unsafe { local_slots[alloc_local_id as usize] };
                region = Region.Local;
            }
            let ptr = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: region, ty: ty, allocator: alloc_ssa }), target_ty);
            if self.is_aggregate(ty) {
                let agg_size = self.get_type_size(ty);
                self.emit_memcpy(ptr, val, agg_size);
            } else {
                (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: ptr, val: val }));
            }
            return ptr;
        } else if tag == 25 as u32 { // GetEnv
            let env_ty = self.mono.pending_cap_env_ty;
            return (*self.builder).emit_with_type(ILInstr.GetEnv, env_ty);
        }
        return NO_SSA as u32;
    }

    fn get_variant_payload_type(self: &mut ZirToZilLowerer, ty_id: u32, variant_idx: u32) -> u32 {
        if ty_id == 0 as u32 { return 0 as u32; }
        let p_ty = self.builder.get_type_decl(ty_id);
        let tag = p_ty.def.get_tag();
        let mut user_id = 0xffffffff as u32;
        if tag == ILTYPE_USER {
            user_id = p_ty.def.get_User().id;
        } else if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT {
            let inner_ty = self.get_ptr_inner_type(ty_id);
            let p_inner = self.builder.get_type_decl(inner_ty);
            if p_inner.def.get_tag() == ILTYPE_USER {
                user_id = p_inner.def.get_User().id;
            }
        }

        if user_id != 0xffffffff as u32 {
            let p_def = self.zil_module.get_typedef_mut(user_id as usize);
            match *p_def {
                ILTypeDef.Enum(e) => {
                    if variant_idx as usize < e.variants.len {
                        return e.variants[variant_idx as usize].payload;
                    }
                },
                _ => {}
            }
        }
        return 0 as u32;
    }

    fn is_const_zero(self: &mut ZirToZilLowerer, ssa: u32) -> bool {
        if ssa == 0 as u32 || ssa == 0xffffffff as u32 {
            return true;
        }
        if (*self.builder).current_func_idx == 0xffffffff as u32 {
            return false;
        }
        let p_func = self.zil_module.get_function_mut((*self.builder).current_func_idx as usize);
        let mut b_idx = 0 as usize;
        while b_idx < p_func.blocks_len {
            let func_blocks = unsafe { @slice(p_func.blocks, p_func.blocks_len) };
            let block_id = func_blocks[b_idx];
            let p_block = self.zil_module.get_block_mut(block_id as usize);
            let mut i_idx = 0 as usize;
            while i_idx < p_block.instructions_len {
                let ssa_results = unsafe { @slice(p_block.ssa_results, p_block.instructions_len) };
                let res_ssa = ssa_results[i_idx];
                if res_ssa == ssa {
                    let instrs = unsafe { @slice(p_block.instructions, p_block.instructions_len) };
                    let instr_idx = instrs[i_idx];
                    let p_instr = self.zil_module.get_instr_mut(instr_idx as usize);
                    match *p_instr {
                        ILInstr.Const(c) => {
                            match c.val {
                                ConstValue.U64(v) => { if v == 0 as u64 { return true; } },
                                ConstValue.I64(v) => { if v == 0 as i64 { return true; } },
                                ConstValue.Bool(v) => { if v == 0 as u64 { return true; } },
                                _ => {}
                            }
                        },
                        // Cast(zero, T) — e.g. @ptr_cast<[u8]>(0) for zero-init of aggregate
                        // locals — is semantically a zero value; treat it the same so that
                        // emit_memcpy uses memset(0) rather than memcpy(null_ptr).
                        ILInstr.Cast(c) => { if self.is_const_zero(c.val) { return true; } },
                        _ => {}
                    }
                    return false;
                }
                i_idx = i_idx + 1 as usize;
            }
            b_idx = b_idx + 1 as usize;
        }
        return false;
    }

    fn emit_memset(self: &mut ZirToZilLowerer, dest: u32, val: u32, size: u64) {
        let i32_ty = self.get_primitive_type(ILPRIM_I32);
        let val_ssa = (*self.builder).emit_const_u64(val as u64, i32_ty);
        let u64_ty = self.get_primitive_type(ILPRIM_U64);
        let size_ssa = (*self.builder).emit_const_u64(size, u64_ty);
        let mut args_ptr = zoril_allocator_alloc(self.persistent_arena, 3 * 4) as *mut u32;
        let mut args = unsafe { @slice(args_ptr, 3 as usize) };
        args[0] = dest;
        args[1] = val_ssa;
        args[2] = size_ssa;
        let name_id = self.intern_table.intern("memset");
        let mut instr = CallInstr {
            args: args,
            name_id: name_id,
            is_extern: true,
        };
        (*self.builder).emit_with_type(ILInstr.Call(instr), 0 as u32);
    }

    fn emit_memcpy(self: &mut ZirToZilLowerer, dest: u32, src: u32, size: u64) {
        if self.is_const_zero(src) {
            self.emit_memset(dest, 0 as u32, size);
            return;
        }
        let u64_ty = self.get_primitive_type(ILPRIM_U64);
        let size_ssa = (*self.builder).emit_const_u64(size, u64_ty);
        let mut args_ptr = zoril_allocator_alloc(self.persistent_arena, 3 * 4) as *mut u32;
        let mut args = unsafe { @slice(args_ptr, 3 as usize) };
        args[0] = dest;
        args[1] = src;
        args[2] = size_ssa;
        let name_id = self.intern_table.intern("memcpy");
        let mut instr = CallInstr {
            args: args,
            name_id: name_id,
            is_extern: true,
        };
        (*self.builder).emit_with_type(ILInstr.Call(instr), 0 as u32);
    }

    fn comment_push_decimal(self: &mut ZirToZilLowerer, out: &mut ByteVec, val: u64) {
        if val == 0 as u64 {
            out.push('0' as u8);
            return;
        }
        let buf_ptr = zoril_allocator_alloc(self.scratch_arena, 20 as usize) as *mut u8;
        let mut buf = unsafe { @slice(buf_ptr, 20 as usize) };
        let mut n = 0 as usize;
        let mut v = val;
        while v > 0 as u64 {
            buf[n] = (v % 10 as u64) as u8 + '0' as u8;
            v = v / 10 as u64;
            n = n + 1 as usize;
        }
        let mut i = n;
        while i > 0 as usize {
            i = i - 1 as usize;
            out.push(buf[i]);
        }
    }

    fn format_local_name(self: &mut ZirToZilLowerer, out: &mut ByteVec, local_id: u32) {
        if local_id == 0 as u32 {
            out.push_slice("()");
            return;
        }
        let loc = &self.cur_func().locals[local_id as usize - 1 as usize];
        if loc.name_id != 0 as u32 {
            out.push_slice(self.intern_table.lookup(loc.name_id));
        } else {
            out.push_slice("_t");
            self.comment_push_decimal(out, local_id as u64);
        }
    }

    fn format_args(self: &mut ZirToZilLowerer, out: &mut ByteVec, args: [Place]) {
        out.push('(' as u8);
        let mut i = 0 as usize;
        while i < args.len {
            if i > 0 as usize { out.push_slice(", "); }
            self.format_place(out, &args[i]);
            i = i + 1 as usize;
        }
        out.push(')' as u8);
    }

    fn binop_str(self: &ZirToZilLowerer, op: u32) -> [u8] {
        if op == 0 as u32 { return "+"; }
        if op == 1 as u32 { return "-"; }
        if op == 2 as u32 { return "*"; }
        if op == 3 as u32 { return "/"; }
        if op == 4 as u32 { return "%"; }
        if op == 5 as u32 { return "+%"; }
        if op == 6 as u32 { return "-%"; }
        if op == 7 as u32 { return "*%"; }
        if op == 8 as u32 { return "=="; }
        if op == 9 as u32 { return "!="; }
        if op == 10 as u32 { return "<"; }
        if op == 11 as u32 { return "<="; }
        if op == 12 as u32 { return ">"; }
        if op == 13 as u32 { return ">="; }
        if op == 14 as u32 { return "&"; }
        if op == 15 as u32 { return "|"; }
        if op == 16 as u32 { return "^"; }
        if op == 17 as u32 { return "<<"; }
        if op == 18 as u32 { return ">>"; }
        if op == 33 as u32 { return "&&"; }
        if op == 34 as u32 { return "||"; }
        if op == BINARY_SHL_MASKED { return "<<%"; }
        if op == BINARY_SHR_MASKED { return ">>%"; }
        return "<binop>";
    }

    fn unop_prefix_str(self: &ZirToZilLowerer, op: u32) -> [u8] {
        if op == 0 as u32 { return "-"; }
        if op == 1 as u32 { return "!"; }
        if op == 2 as u32 { return "*"; }
        if op == 3 as u32 { return "&"; }
        if op == 4 as u32 { return "&mut "; }
        return "<unop>";
    }

    fn format_place(self: &mut ZirToZilLowerer, out: &mut ByteVec, place: &Place) {
        let name_bv = ByteVec.new(self.scratch_arena);
        self.format_local_name(name_bv, place.base);
        let mut current = name_bv.as_slice();
        let mut has_op = false;
        let mut prefixed = false;

        let mut i = 0 as usize;
        while i < place.projections.len {
            let proj = &place.projections[i];
            let tag = proj.get_tag();
            if tag == 2 as u32 { // Deref
                let new_bv = ByteVec.new(self.scratch_arena);
                if has_op {
                    new_bv.push_slice("(*");
                    new_bv.push_slice(current);
                    new_bv.push_slice(")");
                    prefixed = false;
                } else {
                    new_bv.push('*' as u8);
                    new_bv.push_slice(current);
                    prefixed = true;
                }
                current = new_bv.as_slice();
                has_op = true;
            } else {
                let new_bv = ByteVec.new(self.scratch_arena);
                if prefixed {
                    new_bv.push('(' as u8);
                    new_bv.push_slice(current);
                    new_bv.push(')' as u8);
                } else {
                    new_bv.push_slice(current);
                }
                if tag == 0 as u32 { // Field
                    new_bv.push('.' as u8);
                    new_bv.push_slice(self.intern_table.lookup(proj.get_Field()));
                } else if tag == 1 as u32 { // TupleIndex
                    new_bv.push('.' as u8);
                    self.comment_push_decimal(new_bv, proj.get_TupleIndex() as u64);
                } else if tag == 3 as u32 { // Index
                    new_bv.push('[' as u8);
                    self.format_local_name(new_bv, proj.get_Index());
                    new_bv.push(']' as u8);
                }
                current = new_bv.as_slice();
                prefixed = false;
                has_op = true;
            }
            i = i + 1 as usize;
        }

        out.push_slice(current);
    }

    fn format_rvalue(self: &mut ZirToZilLowerer, out: &mut ByteVec, rv: &ZirRvalue) {
        let tag = rv.get_tag();
        if tag == 0 as u32 { // Use
            self.format_place(out, rv.get_Use());
        } else if tag == 1 as u32 { // Ref
            out.push('&' as u8);
            self.format_place(out, rv.get_Ref());
        } else if tag == 2 as u32 { // RefMut
            out.push_slice("&mut ");
            self.format_place(out, rv.get_RefMut());
        } else if tag == 3 as u32 { // Const
            self.comment_push_decimal(out, rv.get_Const_val());
        } else if tag == 4 as u32 { // BinaryOp
            self.format_place(out, rv.get_BinaryOp_lhs());
            out.push(' ' as u8);
            out.push_slice(self.binop_str(rv.get_BinaryOp_op()));
            out.push(' ' as u8);
            self.format_place(out, rv.get_BinaryOp_rhs());
        } else if tag == 5 as u32 { // UnaryOp
            out.push_slice(self.unop_prefix_str(rv.get_UnaryOp_op()));
            self.format_place(out, rv.get_UnaryOp_arg());
        } else if tag == 6 as u32 { // Call
            let p_f = self.zil_module.get_function_mut(rv.get_Call_id() as usize);
            out.push_slice(self.intern_table.lookup(p_f.name));
            self.format_args(out, rv.get_Call_args());
        } else if tag == 7 as u32 { // CallPtr
            self.format_place(out, rv.get_CallPtr_pl());
            self.format_args(out, rv.get_CallPtr_args());
        } else if tag == 10 as u32 { // Field
            self.format_place(out, rv.get_Field_pl());
            out.push('.' as u8);
            out.push_slice(self.intern_table.lookup(rv.get_Field_name()));
        } else if tag == 11 as u32 { // Index
            self.format_place(out, rv.get_Index_pl());
            out.push('[' as u8);
            self.format_place(out, rv.get_Index_idx());
            out.push(']' as u8);
        } else if tag == 12 as u32 { // Cast
            self.format_place(out, rv.get_Cast_pl());
            out.push_slice(" as <ty>");
        } else if tag == ZIR_RV_ARRAY_REPEAT {
            out.push('[' as u8);
            self.format_place(out, rv.get_ArrayRepeat_val());
            out.push_slice("; ");
            self.comment_push_decimal(out, rv.get_ArrayRepeat_count() as u64);
            out.push(']' as u8);
        } else if tag == 26 as u32 { // PtrFromInt
            out.push_slice("@ptr_from_int<ty>(");
            self.format_place(out, rv.get_PtrFromInt_pl());
            out.push(')' as u8);
        } else if tag == 16 as u32 { // StringConst
            out.push_slice("\"...\"");
        } else if tag == 19 as u32 { // GlobalAddr
            out.push_slice("&<global>");
        } else if tag == 20 as u32 { // FuncAddr
            let p_f = self.zil_module.get_function_mut(rv.get_FuncAddr_id() as usize);
            out.push('&' as u8);
            out.push_slice(self.intern_table.lookup(p_f.name));
        } else if tag == 25 as u32 { // GetEnv
            out.push_slice("<env>");
        } else {
            out.push_slice("<expr>");
        }
    }

    fn build_stmt_comment(self: &mut ZirToZilLowerer, stmt: &ZirStmt) -> u32 {
        let tag = stmt.get_tag();
        if tag == 9 as u32 { return 0 as u32; } // Nop
        let bv = ByteVec.new(self.scratch_arena);

        if tag == 0 as u32 { // Let
            bv.push_slice("let ");
            self.format_local_name(bv, stmt.get_Let_id());
            bv.push_slice(" = ");
            self.format_rvalue(bv, stmt.get_Let_rv());
        } else if tag == 1 as u32 { // Assign
            self.format_place(bv, stmt.get_Assign_pl());
            bv.push_slice(" = ");
            self.format_rvalue(bv, stmt.get_Assign_rv());
        } else if tag == 2 as u32 || tag == 10 as u32 { // Drop, DropIfLive
            bv.push_slice("drop ");
            self.format_place(bv, stmt.get_Drop_pl());
        } else if tag == 3 as u32 { // Call
            let p_f = self.zil_module.get_function_mut(stmt.get_Call_id() as usize);
            bv.push_slice(self.intern_table.lookup(p_f.name));
            self.format_args(bv, stmt.get_Call_args());
        } else if tag == 4 as u32 { // CallPtr
            self.format_place(bv, stmt.get_CallPtr_pl());
            self.format_args(bv, stmt.get_CallPtr_args());
        } else if tag == 5 as u32 { // Intrinsic
            bv.push('@' as u8);
            bv.push_slice(self.intern_table.lookup(stmt.get_Intrinsic_id()));
            self.format_args(bv, stmt.get_Intrinsic_args());
        } else if tag == 6 as u32 { // Borrow
            bv.push_slice("let ");
            self.format_local_name(bv, stmt.get_Borrow_id());
            bv.push_slice(" = &");
            self.format_place(bv, stmt.get_Borrow_pl());
        } else if tag == 7 as u32 { // BorrowMut
            bv.push_slice("let ");
            self.format_local_name(bv, stmt.get_BorrowMut_id());
            bv.push_slice(" = &mut ");
            self.format_place(bv, stmt.get_BorrowMut_pl());
        } else if tag == 8 as u32 { // EndBorrow
            bv.push_slice("end borrow ");
            self.format_local_name(bv, stmt.get_EndBorrow_id());
        } else {
            return 0 as u32;
        }

        return self.intern_table.intern(bv.as_slice());
    }

    // Combines the literal source comment (verbatim text the user wrote
    // immediately before this statement, 0 if none) with the synthesized
    // statement description, literal first, separated by a newline -
    // ZilPrinter/FlatPrinter's existing comment emission already splits
    // on embedded newlines into separate "// <line>: ..." lines, so no
    // printer changes are needed to show both.
    fn combine_comments(self: &mut ZirToZilLowerer, literal: u32, synthesized: u32) -> u32 {
        if literal == 0 as u32 { return synthesized; }
        if synthesized == 0 as u32 { return literal; }
        let bv = ByteVec.new(self.scratch_arena);
        bv.push_slice(self.intern_table.lookup(literal));
        bv.push('\n' as u8);
        bv.push_slice(self.intern_table.lookup(synthesized));
        return self.intern_table.intern(bv.as_slice());
    }

    fn lower_stmt(self: &mut ZirToZilLowerer, stmt: &ZirStmt, literal_comment: u32, local_slots: *mut u32, local_types: *mut u32, local_closure_func_idxs: *mut u32) {
        let tag = stmt.get_tag();
        let addr = stmt as usize;
        let span = stmt.get_span();
        (*self.builder).set_span(span);
        (*self.builder).set_comment(self.combine_comments(literal_comment, self.build_stmt_comment(stmt)));

        if tag == 0 as u32 { // Let(local_id, rvalue, span)
            let local_id = stmt.get_Let_id();
            let rvalue = (addr + 16) as *ZirRvalue;
            let val_ssa = self.lower_rvalue(rvalue, local_slots, local_types, local_closure_func_idxs);
            
            let func_idx = self.get_rvalue_func_idx(rvalue, local_closure_func_idxs);
            unsafe { local_closure_func_idxs[local_id as usize] = func_idx; }
            
            let loc = &self.cur_func().locals[local_id as usize - 1 as usize];
            if loc.kind == 1 as u32 { // TMP
                unsafe { local_slots[local_id as usize] = val_ssa; }
            } else {
                let slot = unsafe { local_slots[local_id as usize] };
                if val_ssa != NO_SSA as u32 {
                    if self.is_aggregate(loc.ty) {
                        let let_size = self.get_type_size(loc.ty);
                        self.emit_memcpy(slot, val_ssa, let_size);
                    } else {
                        let ty = (*self.builder).get_ssa_type(val_ssa);
                        if self.get_type_size(ty) > 0 as u64 {
                            (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: slot, val: val_ssa }));
                        }
                    }
                }
            }
        } else if tag == 1 as u32 { // Assign(place, rvalue, span)
            let place = stmt.get_Assign_pl();
            let rvalue = (addr + 32) as *ZirRvalue;
            let val_ssa = self.lower_rvalue(rvalue, local_slots, local_types, local_closure_func_idxs);
            
            if (*place).projections.len == 0 as usize {
                let dest_local_id = (*place).base;
                if dest_local_id != 0 as u32 {
                    let func_idx = self.get_rvalue_func_idx(rvalue, local_closure_func_idxs);
                    unsafe { local_closure_func_idxs[dest_local_id as usize] = func_idx; }
                }
            }
            
            let dest_ptr = self.resolve_place_addr(place, local_slots, local_types);
            let dest_ty = self.get_place_type(place, local_types);
            if val_ssa != NO_SSA as u32 {
                if self.is_aggregate(dest_ty) {
                    let assign_size = self.get_type_size(dest_ty);
                    self.emit_memcpy(dest_ptr, val_ssa, assign_size);
                } else {
                    let ty = (*self.builder).get_ssa_type(val_ssa);
                    if self.get_type_size(ty) > 0 as u64 {
                        (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: dest_ptr, val: val_ssa }));
                    }
                }
            }
        } else if tag == 2 as u32 || tag == 10 as u32 { // Drop / DropIfLive(place, span)
            let place = stmt.get_Drop_pl();
            let place_ty = self.get_place_type(place, local_types);
            let mut is_ptr = false;
            if place_ty != 0 as u32 {
                let pt = self.builder.get_type_decl(place_ty).def.get_tag();
                is_ptr = pt == ILTYPE_PTR || pt == ILTYPE_PTRMUT || pt == ILTYPE_BOXED || pt == ILTYPE_BOXEDMUT;
            }
            if is_ptr {
                // A pointer-typed place keeps the historical behaviour: only the pointee type's own
                // drop function, called with the place's address. Glue never follows pointers.
                let opt_drop_fn = self.find_drop_fn(place_ty);
                if opt_drop_fn != 999999 as u32 {
                    let addr_ssa = self.resolve_place_addr(place, local_slots, local_types);
                    self.emit_drop_call(opt_drop_fn, addr_ssa);
                }
            } else if self.zil_type_needs_drop(place_ty, 0 as usize) {
                let addr_ssa = self.resolve_place_addr(place, local_slots, local_types);
                self.emit_drop_glue(addr_ssa, place_ty, 0 as usize);
            }
        } else if tag == 3 as u32 { // Call(fn_id, args, span)
            let fn_id = stmt.get_Call_id();
            let args_places = stmt.get_Call_args();
            
            let p_f = self.zil_module.get_function_mut(fn_id as usize);
            let ret_ty = p_f.ret_ty;
            let needs_sret = self.is_aggregate(ret_ty);
            let needs_env = self.needs_env_ptr(p_f.is_extern, p_f.name);
            
            let mut zil_args_len = args_places.len;
            if needs_sret { zil_args_len = zil_args_len + 1 as usize; }
            if needs_env { zil_args_len = zil_args_len + 1 as usize; }
            
            let zil_args_ptr = zoril_allocator_alloc(self.persistent_arena, zil_args_len * 4) as *mut u32;
            let mut zil_args = unsafe { @slice(zil_args_ptr, zil_args_len) };
            
            let mut sret_temp_slot = NO_SSA as u32;
            let mut dst_idx = 0 as usize;
            if needs_sret {
                let ptr_ty = (*self.builder).get_ptr_type(ret_ty);
                let saved = (*self.builder).current_block_idx;
                (*self.builder).switch_to_block((*self.builder).entry_block_idx);
                sret_temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: ret_ty, allocator: NO_SSA as u32 }), ptr_ty);
                (*self.builder).switch_to_block(saved);
                
                zil_args[0] = sret_temp_slot;
                dst_idx = 1 as usize;
            }
            
            if needs_env {
                let unit_ptr_ty = (*self.builder).get_ptr_type(self.get_primitive_type(ILPRIM_UNIT));
                let env_val = (*self.builder).emit_const_u64(0 as u64, unit_ptr_ty);
                zil_args[dst_idx] = env_val;
                dst_idx = dst_idx + 1 as usize;
            }

            let mut ai = 0 as usize;
            while ai < args_places.len {
                let arg_place = &args_places[ai];
                let arg_val = self.load_place(arg_place, local_slots, local_types);
                zil_args[dst_idx] = arg_val;
                dst_idx = dst_idx + 1 as usize;
                ai = ai + 1 as usize;
            }
            
            let call_res_ty = if needs_sret { self.get_primitive_type(ILPRIM_UNIT) } else { ret_ty };
            (*self.builder).emit_with_type(ILInstr.Call(CallInstr { args: zil_args, name_id: p_f.name, is_extern: p_f.is_extern }), call_res_ty);
        } else if tag == 4 as u32 { // CallPtr(fn_place, args, span)
            let fn_place = stmt.get_CallPtr_pl();
            let args_places = stmt.get_CallPtr_args();
            
            let fn_val = self.load_place(fn_place, local_slots, local_types);
            let fn_ptr_ty = self.get_place_type(fn_place, local_types);
            let inner_ty = self.get_ptr_inner_type(fn_ptr_ty);
            if inner_ty == 0 as u32 { return; }
            let p_fn_type = self.builder.get_type_decl(inner_ty);
            let fn_def = (*p_fn_type).def.get_Fn();
            let ret_ty = fn_def.ret_ty;
            let needs_sret = self.is_aggregate(ret_ty);
            let needs_env = true; // All function pointers are closures

            let mut zil_args_len = args_places.len;
            if needs_sret { zil_args_len = zil_args_len + 1 as usize; }
            if needs_env { zil_args_len = zil_args_len + 1 as usize; }
            
            let zil_args_ptr = zoril_allocator_alloc(self.persistent_arena, zil_args_len * 4) as *mut u32;
            let mut zil_args = unsafe { @slice(zil_args_ptr, zil_args_len) };
            
            let mut sret_temp_slot = NO_SSA as u32;
            let mut dst_idx = 0 as usize;
            if needs_sret {
                let ptr_ty = (*self.builder).get_ptr_type(ret_ty);
                let saved = (*self.builder).current_block_idx;
                (*self.builder).switch_to_block((*self.builder).entry_block_idx);
                sret_temp_slot = (*self.builder).emit_with_type(ILInstr.Alloc(AllocInstr { region: Region.Local, ty: ret_ty, allocator: NO_SSA as u32 }), ptr_ty);
                (*self.builder).switch_to_block(saved);
                
                zil_args[0] = sret_temp_slot;
                dst_idx = 1 as usize;
            }
            
            let env_ssa = self.get_closure_env_ssa_for_place(fn_place, local_slots, local_closure_func_idxs);
            if needs_env {
                let env_val = if env_ssa != NO_SSA as u32 { env_ssa } else {
                    let unit_ptr_ty = (*self.builder).get_ptr_type(self.get_primitive_type(ILPRIM_UNIT));
                    (*self.builder).emit_const_u64(0 as u64, unit_ptr_ty)
                };
                zil_args[dst_idx] = env_val;
                dst_idx = dst_idx + 1 as usize;
            }

            let mut ai = 0 as usize;
            while ai < args_places.len {
                let arg_place = &args_places[ai];
                let arg_val = self.load_place(arg_place, local_slots, local_types);
                zil_args[dst_idx] = arg_val;
                dst_idx = dst_idx + 1 as usize;
                ai = ai + 1 as usize;
            }
            
            let call_res_ty = if needs_sret { self.get_primitive_type(ILPRIM_UNIT) } else { ret_ty };
            (*self.builder).emit_with_type(ILInstr.CallPtr(CallPtrInstr { args: zil_args, func_ptr: fn_val, env_ssa: env_ssa }), call_res_ty);
        }
    }


    fn get_enum_payload_offset(self: &mut ZirToZilLowerer, ty_id: u32) -> usize {
        let align = self.get_type_align(ty_id);
        if align > 4 as u64 { return align as usize; }
        return 4 as usize;
    }

    fn get_variant_discriminant(self: &mut ZirToZilLowerer, ty_id: u32, variant_idx: u32) -> u32 {
        let p_ty = self.builder.get_type_decl(ty_id);
        let user = p_ty.def.get_User();
        let def = self.zil_module.get_typedef_mut(user.id as usize);
        let e = def.get_Enum();
        return e.variants[variant_idx as usize].discriminant;
    }

    fn get_variant_payload_type(self: &mut ZirToZilLowerer, ty_id: u32, variant_idx: u32) -> u32 {
        let p_ty = self.builder.get_type_decl(ty_id);
        let user = p_ty.def.get_User();
        let def = self.zil_module.get_typedef_mut(user.id as usize);
        let e = def.get_Enum();
        return e.variants[variant_idx as usize].payload;
    }

    // `zil_blocks` is the ZIR-block -> ZIL-block map, indexed by block id. It
    // arrives as a slice so every lookup here is bounds-checked; `&[u32]` rather
    // than `[u32]` because the caller passes it from inside a loop.
    fn lower_terminator(self: &mut ZirToZilLowerer, term: &ZirTerminator, zil_blocks: &[u32], local_slots: *mut u32, local_types: *mut u32) {
        (*self.builder).set_comment(0 as u32);
        let tag = term.get_tag();

        if tag == 0 as u32 { // Jmp(dst_id)
            let dst_id = term.get_Jmp();
            let zil_dst = zil_blocks[dst_id as usize];
            (*self.builder).emit(ILInstr.Jmp(zil_dst));
        } else if tag == 1 as u32 { // Branch(cond_place, true_id, false_id)
            let cond_place = term.get_Branch_cond();
            let true_id = term.get_Branch_then();
            let false_id = term.get_Branch_else();
            let cond_val = self.load_place(cond_place, local_slots, local_types);
            let zil_true = zil_blocks[true_id as usize];
            let zil_false = zil_blocks[false_id as usize];

            (*self.builder).emit(ILInstr.Branch(BranchInstr { cond: cond_val, then_block: zil_true, else_block: zil_false }));
        } else if tag == 2 as u32 { // Ret(Place)
            let place = term.get_Ret();
            (*self.builder).set_span(self.cur_func().span);
            let mut ret_val = NO_SSA as u32;
            if place.base != 0 as u32 {
                ret_val = self.load_place(place, local_slots, local_types);
            }
            
            if self.sret_ssa != NO_SSA as u32 && ret_val != NO_SSA as u32 {
                let ty = (*self.builder).get_ssa_type(ret_val);
                let inner_ty = self.get_ptr_inner_type(ty);
                if inner_ty != 0 as u32 && self.is_aggregate(inner_ty) {
                    // ret_val is a *AggregateType pointer from load_place.
                    // Copy the aggregate bytes from ret_val into the sret slot.
                    let ret_size = self.get_type_size(inner_ty);
                    self.emit_memcpy(self.sret_ssa, ret_val, ret_size);
                    (*self.builder).emit(ILInstr.Ret(NO_SSA as u32));
                } else if self.is_aggregate(ty) {
                    // ret_val is an aggregate value directly (unusual); store it
                    (*self.builder).emit(ILInstr.Store(StoreInstr { ptr: self.sret_ssa, val: ret_val }));
                    (*self.builder).emit(ILInstr.Ret(NO_SSA as u32));
                } else {
                    (*self.builder).emit(ILInstr.Ret(ret_val));
                }
            } else {
                (*self.builder).emit(ILInstr.Ret(ret_val));
            }
        } else if tag == 3 as u32 { // Unreachable
            let abort_name = self.intern_table.intern("zoril_abort");
            (*self.builder).emit(ILInstr.Call(CallInstr { args: @slice(0 as *mut u32, 0 as usize), name_id: abort_name, is_extern: true }));
            (*self.builder).emit(ILInstr.Unreachable);
        }
    }
}
