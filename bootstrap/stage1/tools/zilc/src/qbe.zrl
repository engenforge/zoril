            let val = instr.get_Unwrap(); // same layout
            let tmp = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(tmp); qbe_write(self.fd, " =w loaduw "); self.emit_ssa(val); qbe_write(self.fd, "\n");
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =w cnew "); self.emit_ssa(tmp); qbe_write(self.fd, ", 0\n");
        } else if tag == IL_INSTR_SYSCALL {
            let s = instr.get_Syscall();
            // Use __zoril_syscall_N where N = number of data arguments
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l call $__zoril_syscall_");
            write_u64(self.fd as u64, s.args.len as u64);
            qbe_write(self.fd, "(l ");
            self.emit_ssa(s.num);
            let mut j = 0 as usize;
            while j < s.args.len {
                qbe_write(self.fd, ", l ");
                self.emit_ssa(s.args[j]);
                j = j + 1 as usize;
            }
            qbe_write(self.fd, ")\n");
        } else if tag == IL_INSTR_PHI {
            let p = instr.get_Phi();
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " ="); self.emit_abi_class(res_ty); qbe_write(self.fd, " phi ");
            let mut j = 0 as usize;
            while j < p.preds.len {
                if j > 0 as usize { qbe_write(self.fd, ", "); }
                self.emit_block_label(p.preds[j].block);
                qbe_write(self.fd, " "); self.emit_ssa(p.preds[j].val);
                j = j + 1 as usize;
            }
            qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_JMP {
            qbe_write(self.fd, "    jmp "); self.emit_block_label(instr.get_Jmp()); qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_UNREACHABLE {
            qbe_write(self.fd, "    hlt\n");
        } else if tag == IL_INSTR_BRANCH {
            let b = instr.get_Branch();
            qbe_write(self.fd, "    jnz "); self.emit_ssa(b.cond);
            qbe_write(self.fd, ", "); self.emit_block_label(b.then_block);
            qbe_write(self.fd, ", "); self.emit_block_label(b.else_block);
            qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_RET {
            let val = instr.get_Ret();
            let ret_ty = self.cur_func().ret_ty;
            let is_sret = self.requires_pass_by_ref(ret_ty);
            if val == 0xffffffff as u32 || self.is_unit_type(ret_ty) || is_sret {
                qbe_write(self.fd, "    ret\n");
            } else {
