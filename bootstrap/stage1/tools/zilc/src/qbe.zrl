            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l call $__zoril_syscall_6(l 426, l ");
            self.emit_ssa(e.ring); qbe_write(self.fd, ", l ");
            write_u64(self.fd as u64, e.to_submit as u64); qbe_write(self.fd, ", l ");
            write_u64(self.fd as u64, e.min_complete as u64); qbe_write(self.fd, ", l 0, l 0, l 0)\n");
        } else if tag == IL_INSTR_IORING_CLOSE {
            let fd = instr.get_IORingClose();
            qbe_write(self.fd, "    call $__zoril_syscall_1(l 3, l "); self.emit_ssa(fd); qbe_write(self.fd, ")\n");
        } else if tag == IL_INSTR_PARAM {
            let param_idx = instr.get_Param() as usize;
            if param_idx < self.cur_func().params_len {
                let param_ssa = self.cur_func().param(param_idx).ssa;
                if ssa != param_ssa {
                    qbe_write(self.fd, "    ");
                    self.emit_ssa(ssa);
                    qbe_write(self.fd, " =");
                    self.emit_abi_class(self.get_ssa_type(ssa));
                    qbe_write(self.fd, " copy ");
                    self.emit_ssa(param_ssa);
                    qbe_write(self.fd, "\n");
                }
            }
        } else {
            // Unhandled instruction tag: emit ICE to make missing cases visible
            qbe_write(self.fd, "    # ICE: unhandled IL instruction tag ");
            write_u64(self.fd as u64, tag as u64);
            qbe_write(self.fd, "\n");
            qbe_write(self.fd, "    call $abort()\n");
        }
    }

    fn is_w_tag(self: &QBEEmitter, tag: u32) -> bool {
        return tag == ILPRIM_U8 || tag == ILPRIM_U16 || tag == ILPRIM_U32 || 
               tag == ILPRIM_I8 || tag == ILPRIM_I16 || tag == ILPRIM_I32 || 
               tag == ILPRIM_BOOL || tag == ILPRIM_CHAR || tag == ILPRIM_UNIT ||
               tag == ILPRIM_NEVER;
    }

    fn emit_cast_op(self: &QBEEmitter, from_ty: u32, to_ty: u32) {
        let from_tag = self.get_prim_tag(from_ty);
        let to_tag = self.get_prim_tag(to_ty);

        let from_is_f32 = from_tag == ILPRIM_F32;
        let from_is_f64 = from_tag == ILPRIM_F64;
        let to_is_f32 = to_tag == ILPRIM_F32;
        let to_is_f64 = to_tag == ILPRIM_F64;

        // Float conversions
        if from_is_f64 && to_is_f32 { qbe_write(self.fd, "truncd"); return; }
        if from_is_f32 && to_is_f64 { qbe_write(self.fd, "exts"); return; }
        // Integer to float: swtof/uwtof (i32/u32) or sltof/ultof (i64/u64), works for both f32 and f64 result
        if to_is_f32 || to_is_f64 {
            let from_is_long = from_tag == ILPRIM_I64 || from_tag == ILPRIM_U64 || from_tag == ILPRIM_ISIZE || from_tag == ILPRIM_USIZE;
            if from_is_long { if self.is_signed_prim(from_ty) { qbe_write(self.fd, "sltof"); } else { qbe_write(self.fd, "ultof"); } }
            else { if self.is_signed_prim(from_ty) { qbe_write(self.fd, "swtof"); } else { qbe_write(self.fd, "uwtof"); } }
            return;
        }
        // Float to integer: stosi (f32) or dtosi (f64), works for both i32 and i64 result
        if from_is_f32 { qbe_write(self.fd, "stosi"); return; }
        if from_is_f64 { qbe_write(self.fd, "dtosi"); return; }

        let from_is_w = self.is_w_tag(from_tag);
        let to_is_w = self.is_w_tag(to_tag);

        if from_is_w && !to_is_w {
            if self.is_signed_prim(from_ty) { qbe_write(self.fd, "extsw"); }
            else { qbe_write(self.fd, "extuw"); }
        } else if !from_is_w && to_is_w {
            qbe_write(self.fd, "copy"); // Truncation is implicit in QBE copy from l to w
        } else {
            qbe_write(self.fd, "copy");
        }
    }

    fn emit_memcpy(self: &QBEEmitter, dest: SSAId, src: SSAId, size: u64, tag: u32, ssa: SSAId, instr_idx: usize) {
        if size == 0 as u64 { return; }
        if size <= BLIT_MAX {
            // QBE expands `blit` into loads and stores, and can merge the slots it copies
            // between, which explicit loads and stores through computed addresses defeat.
            qbe_write(self.fd, "    blit "); self.emit_ssa(src); qbe_write(self.fd, ", "); self.emit_ssa(dest);
            qbe_write(self.fd, ", "); write_u64(self.fd as u64, size); qbe_write(self.fd, "\n");
            return;
        }
        qbe_write(self.fd, "    call ");
        self.emit_func_sym("memcpy", true);
        qbe_write(self.fd, "(l "); self.emit_ssa(dest); qbe_write(self.fd, ", l "); self.emit_ssa(src); qbe_write(self.fd, ", l "); write_u64(self.fd as u64, size); qbe_write(self.fd, ")\n");
    }

    fn get_ssa_type(self: &QBEEmitter, id: SSAId) -> u32 {
        if id == 0xffffffff as u32 { return 0 as u32; }
        if id >= 1000000 as u32 { return 0 as u32; } // Temporaries
        return self.ssa_type_at(id as usize);
    }

    fn is_signed_prim(self: &QBEEmitter, ty_id: u32) -> bool {
        let tag = self.get_prim_tag(ty_id);
        return tag == ILPRIM_I8 || tag == ILPRIM_I16 || tag == ILPRIM_I32 || tag == ILPRIM_I64 || tag == ILPRIM_ISIZE;
    }

    fn get_prim_tag(self: &QBEEmitter, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 || ty_id == 0xffffffff as u32 || ty_id as usize > self.module.types.len { return 0xffffffff as u32; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        if (*p_ty).def.get_tag() == ILTYPE_PRIMITIVE {
            return (*p_ty).def.get_Primitive().get_tag();
        }
        return 0xffffffff as u32;
    }

    fn get_field_offset(self: &QBEEmitter, ty_id: u32, field_idx: u32) -> usize {
        if ty_id == 0 as u32 || ty_id == 0xffffffff as u32 || ty_id as usize > self.module.types.len { return 0 as usize; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        let tag = (*p_ty).def.get_tag();
        if tag == ILTYPE_USER {
            let user = (*p_ty).def.get_User();
            let def = &self.module.typedefs[user.id as usize];
            match *def {
                ILTypeDef.Struct(s) => {
                    let mut off = 0 as usize;
                    let mut i = 0 as usize;
                    while i < field_idx as usize {
                        let fty = s.fields[i].ty;
                        let align = self.get_type_align(fty);
                        off = (off + align - 1 as usize) / align * align;
                        off = off + self.get_type_size(fty);
                        i = i + 1 as usize;
                    }
                    if field_idx as usize >= s.fields.len { return off; }
                    let target_fty = s.fields[field_idx as usize].ty;
                    let target_align = self.get_type_align(target_fty);
                    return (off + target_align - 1 as usize) / target_align * target_align;
                },
                ILTypeDef.Enum(_) => {
                    if field_idx == 0 as u32 { return 0 as usize; } // tag
                    return self.get_enum_payload_offset(ty_id);
                },
                ILTypeDef.Fn(_) => {}, // function typedefs have no fields
            }
        }
        if tag == ILTYPE_TUPLE {
            let types = (*p_ty).def.get_Tuple();
            let mut off = 0 as usize;
            let mut i = 0 as usize;
            while i < field_idx as usize {
                let fty = types[i];
                let align = self.get_type_align(fty);
                off = (off + align - 1 as usize) / align * align;
                off = off + self.get_type_size(fty);
                i = i + 1 as usize;
            }
            let target_fty = types[field_idx as usize];
            let target_align = self.get_type_align(target_fty);
            return (off + target_align - 1 as usize) / target_align * target_align;
        }
        if tag == ILTYPE_SLICE {
            if field_idx == 1 as u32 { return 8 as usize; }
            return 0 as usize;
        }
        return 0 as usize;
    }

    pub fn get_ptr_inner_type(self: &QBEEmitter, ty_id: u32) -> u32 {
        if ty_id == 0 as u32 || ty_id == 0xffffffff as u32 || ty_id as usize > self.module.types.len { return 0 as u32; }
        let p_ty = &self.module.types[ty_id as usize - 1 as usize];
        let tag = (*p_ty).def.get_tag();
        if tag == ILTYPE_PTR || tag == ILTYPE_PTRMUT || tag == ILTYPE_BOXED || tag == ILTYPE_BOXEDMUT {
            return (*p_ty).def.get_Ptr();
        }
        return 0 as u32;
    }

    fn needs_env_ptr(self: &QBEEmitter, is_extern: bool, name_id: u32) -> bool {
        if is_extern { return false; }
        let name = self.intern_table.lookup(name_id);
        // Builtins or special functions might not need env
        if is_str_eq(name, "main") { return false; }
        if is_str_eq(name, "malloc") || is_str_eq(name, "free") || is_str_eq(name, "memcpy") { return false; }
        return true;
    }
}

fn qbe_write(fd: u32, s: [u8]) {
    must_write(fd as u64, s);
}
