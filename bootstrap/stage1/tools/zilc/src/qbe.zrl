        } else if tag == IL_INSTR_VARIANT_MATCH {
            let v = instr.get_VariantMatch();
            // Use a fresh temporary to avoid redefining the same SSA register
            let tmp = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(tmp); qbe_write(self.fd, " =w loaduw "); self.emit_ssa(v.val); qbe_write(self.fd, "\n");
            let disc = self.get_variant_discriminant(v.type_id, v.variant_idx);
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =w ceqw "); self.emit_ssa(tmp); qbe_write(self.fd, ", "); write_u64(self.fd as u64, disc as u64); qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_UNWRAP {
            let val = instr.get_Unwrap();
            let enum_ptr_ty = self.get_ssa_type(val);
            let enum_ty = self.get_ptr_inner_type(enum_ptr_ty);
            let offset = self.get_enum_payload_offset(enum_ty);
            
            if self.is_aggregate(res_ty) || self.is_pointer_like(res_ty) {
                qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l add "); self.emit_ssa(val); qbe_write(self.fd, ", "); write_u64(self.fd as u64, offset as u64); qbe_write(self.fd, "\n");
            } else {
                let tmp = self.next_id();
                qbe_write(self.fd, "    "); self.emit_ssa(tmp); qbe_write(self.fd, " =l add "); self.emit_ssa(val); qbe_write(self.fd, ", "); write_u64(self.fd as u64, offset as u64); qbe_write(self.fd, "\n");
                
                qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " ="); self.emit_abi_class(res_ty); qbe_write(self.fd, " load");
                self.emit_load_suffix(res_ty); qbe_write(self.fd, " "); self.emit_ssa(tmp); qbe_write(self.fd, "\n");
            }
