            // No-op for now unless it's a linear resource that needs closing
        } else if tag == IL_INSTR_BORROW || tag == IL_INSTR_REGION_CAST || tag == IL_INSTR_LIKELY || tag == IL_INSTR_UNLIKELY || tag == IL_INSTR_END_BORROW {
