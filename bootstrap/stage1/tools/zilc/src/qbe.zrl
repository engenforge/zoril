                } else {
                    qbe_write(self.fd, "    store"); self.emit_store_suffix(elem_ty); qbe_write(self.fd, " "); self.emit_ssa(f_ssa); qbe_write(self.fd, ", "); self.emit_ssa(addr); qbe_write(self.fd, "\n");
                }
                k = k + 1 as usize;
            }
        } else if tag == IL_INSTR_STRING_CONST {
            let id = instr.get_StringConst();
            // Look up the sequential string ID assigned during emit_string_data_sections
            let str_ptr = id.ptr as u64;
            let mut seq_id = 0 as u32;
            let mut si2 = 0 as u32;
            while si2 < self.string_count {
                if self.string_ptr_at(si2 as usize) == str_ptr {
                    seq_id = si2;
                    break;
                }
                si2 = si2 + 1 as u32;
            }
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l copy $S"); write_u64(self.fd as u64, seq_id as u64); qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_GLOBAL_ADDR {
            let gi = instr.get_GlobalAddr();
            let g = &self.module.globals[gi as usize];
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l copy ");
            self.emit_func_sym(self.intern_table.lookup(g.name), g.is_extern);
            qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_FUNC_ADDR {
            let func_id = instr.get_FuncAddr();
            let p_fa = &self.module.functions[func_id as usize];
            let fa_name = self.intern_table.lookup((*p_fa).name);
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l copy ");
            self.emit_func_sym(fa_name, (*p_fa).is_extern);
            qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_GETENV {
            // Self-hosted closures pass env as second param (after sret)
            let ret_ty = self.cur_func().ret_ty;
            let sret_offset = if self.requires_pass_by_ref(ret_ty) { 1 as usize } else { 0 as usize };
            let env_param_idx = sret_offset as u32 + 1 as u32;
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l copy "); self.emit_ssa(env_param_idx); qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_SLICE_LOAD {
            let s = instr.get_SliceLoad();
            let ptr_reg = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(ptr_reg); qbe_write(self.fd, " =l loadl "); self.emit_ssa(s.base); qbe_write(self.fd, "\n");
            let off_reg = self.next_id();
            let elem_sz = self.get_type_size(res_ty);
            qbe_write(self.fd, "    "); self.emit_ssa(off_reg); qbe_write(self.fd, " =l mul "); self.emit_ssa(s.idx); qbe_write(self.fd, ", "); write_u64(self.fd as u64, elem_sz as u64); qbe_write(self.fd, "\n");
            let addr_reg = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(addr_reg); qbe_write(self.fd, " =l add "); self.emit_ssa(ptr_reg); qbe_write(self.fd, ", "); self.emit_ssa(off_reg); qbe_write(self.fd, "\n");
            if self.is_aggregate(res_ty) {
                self.emit_memcpy(ssa, addr_reg, self.get_type_size(res_ty) as u64, tag, ssa, instr_idx);
            } else {
                qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " ="); self.emit_class(res_ty); qbe_write(self.fd, " load"); self.emit_load_suffix(res_ty); qbe_write(self.fd, " "); self.emit_ssa(addr_reg); qbe_write(self.fd, "\n");
            }
        } else if tag == IL_INSTR_ARRAY_LOAD {
            let s = instr.get_ArrayLoad();
            let off_reg = self.next_id();
            let elem_sz = self.get_type_size(res_ty);
            qbe_write(self.fd, "    "); self.emit_ssa(off_reg); qbe_write(self.fd, " =l mul "); self.emit_ssa(s.idx); qbe_write(self.fd, ", "); write_u64(self.fd as u64, elem_sz as u64); qbe_write(self.fd, "\n");
            let addr_reg = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(addr_reg); qbe_write(self.fd, " =l add "); self.emit_ssa(s.base); qbe_write(self.fd, ", "); self.emit_ssa(off_reg); qbe_write(self.fd, "\n");
            if self.is_aggregate(res_ty) {
                self.emit_memcpy(ssa, addr_reg, self.get_type_size(res_ty) as u64, tag, ssa, instr_idx);
            } else {
                qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " ="); self.emit_class(res_ty); qbe_write(self.fd, " load"); self.emit_load_suffix(res_ty); qbe_write(self.fd, " "); self.emit_ssa(addr_reg); qbe_write(self.fd, "\n");
            }
        } else if tag == IL_INSTR_SLICE_STORE {
            let s = instr.get_SliceStore();
            let ptr_reg = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(ptr_reg); qbe_write(self.fd, " =l loadl "); self.emit_ssa(s.base); qbe_write(self.fd, "\n");
            let off_reg = self.next_id();
            let val_ty = self.get_ssa_type(s.val);
            let elem_sz = self.get_type_size(val_ty);
            qbe_write(self.fd, "    "); self.emit_ssa(off_reg); qbe_write(self.fd, " =l mul "); self.emit_ssa(s.idx); qbe_write(self.fd, ", "); write_u64(self.fd as u64, elem_sz as u64); qbe_write(self.fd, "\n");
            let addr_reg = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(addr_reg); qbe_write(self.fd, " =l add "); self.emit_ssa(ptr_reg); qbe_write(self.fd, ", "); self.emit_ssa(off_reg); qbe_write(self.fd, "\n");
            if self.is_aggregate(val_ty) {
                self.emit_memcpy(addr_reg, s.val, self.get_type_size(val_ty) as u64, tag, ssa, instr_idx);
            } else {
                qbe_write(self.fd, "    store"); self.emit_store_suffix(val_ty); qbe_write(self.fd, " "); self.emit_ssa(s.val); qbe_write(self.fd, ", "); self.emit_ssa(addr_reg); qbe_write(self.fd, "\n");
            }
        } else if tag == IL_INSTR_ARRAY_STORE {
            let s = instr.get_ArrayStore();
            let off_reg = self.next_id();
            let val_ty = self.get_ssa_type(s.val);
            let elem_sz = self.get_type_size(val_ty);
            qbe_write(self.fd, "    "); self.emit_ssa(off_reg); qbe_write(self.fd, " =l mul "); self.emit_ssa(s.idx); qbe_write(self.fd, ", "); write_u64(self.fd as u64, elem_sz as u64); qbe_write(self.fd, "\n");
            let addr_reg = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(addr_reg); qbe_write(self.fd, " =l add "); self.emit_ssa(s.base); qbe_write(self.fd, ", "); self.emit_ssa(off_reg); qbe_write(self.fd, "\n");
            if self.is_aggregate(val_ty) {
                self.emit_memcpy(addr_reg, s.val, self.get_type_size(val_ty) as u64, tag, ssa, instr_idx);
            } else {
                qbe_write(self.fd, "    store"); self.emit_store_suffix(val_ty); qbe_write(self.fd, " "); self.emit_ssa(s.val); qbe_write(self.fd, ", "); self.emit_ssa(addr_reg); qbe_write(self.fd, "\n");
            }
        } else if tag == IL_INSTR_CAST {
            let c = instr.get_Cast();
            let from_ty = self.get_ssa_type(c.val);
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " ="); self.emit_abi_class(res_ty); qbe_write(self.fd, " ");
