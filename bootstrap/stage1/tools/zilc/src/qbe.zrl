        } else if tag == IL_INSTR_BOUNDS_CHECK {
            // No-op in QBE emitter
        } else if tag == IL_INSTR_SLICE_LEN {
            let base = instr.get_SliceLen();
            let addr_reg = self.next_id();
            qbe_write(self.fd, "    "); self.emit_ssa(addr_reg); qbe_write(self.fd, " =l add "); self.emit_ssa(base); qbe_write(self.fd, ", 8\n");
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l loadl "); self.emit_ssa(addr_reg); qbe_write(self.fd, "\n");
        } else if tag == IL_INSTR_FDOPEN {
            let o = instr.get_FDOpen();
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l call $__zoril_syscall_4(l 257, l -100, l ");
            self.emit_ssa(o.path); qbe_write(self.fd, ", l ");
            write_u64(self.fd as u64, o.flags); qbe_write(self.fd, ", l ");
            write_u64(self.fd as u64, o.mode); qbe_write(self.fd, ")\n");
        } else if tag == IL_INSTR_FDCLOSE {
            let fd = instr.get_FDClose();
            qbe_write(self.fd, "    call $__zoril_syscall_1(l 3, l "); self.emit_ssa(fd); qbe_write(self.fd, ")\n");
        } else if tag == IL_INSTR_FDREAD {
            let io = instr.get_FDRead();
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l call $__zoril_syscall_3(l 0, l ");
            self.emit_ssa(io.fd); qbe_write(self.fd, ", l "); self.emit_ssa(io.buf); qbe_write(self.fd, ", l "); self.emit_ssa(io.count); qbe_write(self.fd, ")\n");
        } else if tag == IL_INSTR_FDWRITE {
            let io = instr.get_FDWrite();
            qbe_write(self.fd, "    "); self.emit_ssa(ssa); qbe_write(self.fd, " =l call $__zoril_syscall_3(l 1, l ");
            self.emit_ssa(io.fd); qbe_write(self.fd, ", l "); self.emit_ssa(io.buf); qbe_write(self.fd, ", l "); self.emit_ssa(io.count); qbe_write(self.fd, ")\n");
        } else if tag == IL_INSTR_IORING_SETUP {
