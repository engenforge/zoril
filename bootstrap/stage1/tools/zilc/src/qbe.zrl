            let fields = instr.get_TupleConstruct();
            let p_ty = &self.module.types[res_ty as usize - 1 as usize];
            let field_types = (*p_ty).def.get_Tuple();
            
            let mut k = 0 as usize;
            let mut cur_off = 0 as usize;
            while k < fields.len {
                let f_ssa = fields[k];
                let f_ty = field_types[k];
                if self.get_type_size(f_ty) > 0 as usize {
                    let align = self.get_type_align(f_ty);
                    cur_off = (cur_off + align - 1 as usize) / align * align;
                    let addr = self.next_id();
                    qbe_write(self.fd, "    "); self.emit_ssa(addr); qbe_write(self.fd, " =l add "); self.emit_ssa(ssa); qbe_write(self.fd, ", "); write_u64(self.fd as u64, cur_off as u64); qbe_write(self.fd, "\n");
                    if self.is_aggregate(f_ty) {
                        self.emit_memcpy(addr, f_ssa, self.get_type_size(f_ty) as u64, tag, ssa, instr_idx);
                    } else {
                        qbe_write(self.fd, "    store"); self.emit_store_suffix(f_ty); qbe_write(self.fd, " "); self.emit_ssa(f_ssa); qbe_write(self.fd, ", "); self.emit_ssa(addr); qbe_write(self.fd, "\n");
                    }
