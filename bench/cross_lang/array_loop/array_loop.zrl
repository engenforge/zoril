fn main() -> i32 {
    let mut a: [i32; 4096] = [0 as i32; 4096];
    let mut iter: i32 = 0;
    while iter < 500000 {
        let mut i: usize = 0;
        while i < 4096 as usize {
            a[i] = a[i] + 1;
            i = i + 1 as usize;
        }
        iter = iter + 1;
    }
    if a[0] != 500000 { return 1; }
    return 0;
}
