// name: A closure storing a captured frame address into a global, handed to a function that calls it
// expected: compile_reject
// Refused by the provenance closure rule where the closure value is made.
static mut G: *i32 = 0 as *i32;
fn run(f: fn() -> unit) { f(); }
fn clobber_stack() -> i32 { let arr = [77; 16]; return arr[0]; }
fn stash() {
    let x = 42;
    let r = &x;
    run(|| { G = r as *i32; });
}
fn main() -> i32 {
    stash();
    let _ = clobber_stack();
    return unsafe { *G };
}
