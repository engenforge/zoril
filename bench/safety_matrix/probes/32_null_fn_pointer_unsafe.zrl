// name: Call through null function pointer (inside unsafe)
// expected: runtime_fault
// The escape hatch half of 26_null_fn_pointer.zrl.
struct Vt {
    call: fn(i64) -> i64,
}

fn main() -> i32 {
    let buf: [u8; 16] = [0 as u8; 16];
    let v: *Vt = &buf[0] as *Vt;
    let f = unsafe { (*v).call };
    return f(1 as i64) as i32;
}
