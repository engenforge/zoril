// name: Option.clone of an Option holding a view of this frame is returned
// expected: known_gap
// gap: Clone for Option<T> declares no #[borrows()], so o.clone() is tied to the local o by the &self default, but the default build's return rule does not follow that tie to the view of a stack array o holds: the clone of Some(s) is returned and the caller reads the dead frame; returning o itself is refused, and so is the clone under --provenance (return rule)
// observed: exit 7
import "core.zrl";
import "clone.zrl";
fn view() -> Option<[u8]> { let buf = [42 as u8; 16]; let s: [u8] = &buf; let o = Option.Some(s); return o.clone(); }
fn smash(n: i32) -> i32 { let junk = [7 as u8; 256]; if n > 0 { return smash(n - 1) + junk[3] as i32; } return 0; }
fn main() -> i32 { let o = view(); let _ = smash(8); match o { Some(s) => { return s[0] as i32; }, None => { return 1; } } }
