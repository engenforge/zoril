// name: Linear fd closed in only one if branch
// expected: compile_reject
// Leaked on the other path. Accepted until 2026-10-02: no scope-exit drop is emitted for a
// value moved in a branch, so the drop-time check never ran.
extern fn open_r(path: *u8) -> fd<r>;
extern fn open_w(path: *u8) -> fd<w>;
extern fn open_rw(path: *u8) -> fd<rw>;
extern fn close_r(f: fd<r>);
extern fn close_w(f: fd<w>);
extern fn close_rw(f: fd<rw>);
extern fn write_to(f: &fd<w>, b: *u8, n: u64) -> i64;
extern fn read_from(f: &fd<r>, b: *mut u8, n: u64) -> i64;
fn main() -> i32 {
    let f = unsafe { open_w("x".ptr) };
    let c = 1;
    if c == 1 { unsafe { close_w(f); } }
    return 0;
}
