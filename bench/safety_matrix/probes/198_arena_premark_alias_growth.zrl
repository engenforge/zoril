// name: Container pre-mark alias growth rejected on Arena.reset_to
// expected: compile_reject
// Mutating a pre-mark container through an alias created before the mark updates
// the container's epoch so that it cannot survive an Arena.reset_to.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn main() -> i32 {
    let mut a = Arena.new(65536 as u64).unwrap();
    let mut v = Vec::<u64>.new_in(&a);
    let r = &mut v;
    let m = a.mark();
    r.push(42);
    a.reset_to(m);
    return v.len() as i32;
}
