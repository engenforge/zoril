// name: An accessor matching through its reference parameter returns into a caller's local enum
// expected: compile_reject
// Refused by the provenance return rule: the accessor's summary ties its result to its reference parameter.
struct P { a: i32 }
enum E { A(P), B(i32) }
fn pick(r: &E) -> &P { return match r { E.A(x) => x, E.B(_) => { return pick(r); } }; }
fn leak(n: i32) -> &P {
    let e = E.A(P { a: n });
    return pick(&e);
}
fn clobber_stack() -> i32 { let arr = [77; 64]; return arr[0]; }
fn main() -> i32 {
    let p = leak(42);
    let c = clobber_stack();
    return p.a + c * 0;
}
