// name: `?` on a three-variant enum with `Ok` and `Err` reinterprets the third variant as `Err`
// expected: known_gap
// gap: `e?` branches on `is_Ok` alone and reads the `Err` payload in the other arm without checking that `e`'s enum has only `Ok` and `Err`, so `Bad.Forge(Pair)` in a function returning `Result<i32, [u8]>` hands the caller a slice whose pointer and length are the `Pair`'s two integers; here the length 42 comes back
// observed: exit 42
import "core.zrl";
struct Pair { a: i64, b: i64 }
enum Bad { Forge(Pair), Ok(i32), Err([u8]) }
fn inner() -> Bad { return Bad.Forge(Pair { a: 4096 as i64, b: 42 as i64 }); }
fn outer() -> Result<i32, [u8]> {
    let v = inner()?;
    return Result.Ok(v);
}
fn main() -> i32 {
    return match outer() {
        Ok(_) => 1,
        Err(s) => s.len as i32,
    };
}
