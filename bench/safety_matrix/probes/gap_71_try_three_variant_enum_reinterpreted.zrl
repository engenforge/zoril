// name: `?` on a three-variant enum with `Ok` and `Err` reinterprets the third variant as `Err`
// expected: compile_reject
// Refused by the lowering of `?`: `Bad` has three variants, not the two of `Result` or `Option`. It used to branch on `is_Ok` alone and read the third variant's `Pair` payload as `Err([u8])`.
import "core.zrl";
struct Pair { a: i64, b: i64 }
enum Bad { Forge(Pair), Ok(i32), Err([u8]) }
fn inner() -> Bad { return Bad.Forge(Pair { a: 4096 as i64, b: 42 as i64 }); }
fn outer() -> Result<i32, [u8]> {
    let v = inner()?;
    return Result.Ok(v);
}
fn main() -> i32 {
    return match outer() {
        Ok(_) => 1,
        Err(s) => s.len as i32,
    };
}
