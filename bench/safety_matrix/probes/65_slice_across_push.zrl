// name: Slice from Vec::as_slice kept across a reallocating push
// expected: compile_reject
// The slice borrows v, so a push that may reallocate v's buffer conflicts with it. A known
// gap until 2026-10-03.

import "vec.zrl";
import "mem.zrl";
use mem::Arena;
use vec::Vec;
fn main() -> i32 {
    let arena = match Arena.new(65536) {
        Ok(arena) => arena,
        Err(_) => { return 1; },
    };
    let mut v = Vec::<i32>.new_in(&arena);
    v.push(7);
    let s = v.as_slice();
    let mut i = 0;
    while i < 1000 { v.push(i); i = i + 1; }
    if s[0] != 7 { return 1; }
    return 0;
}
