// name: Branch-conditional borrow of arena slice erased at CFG join
// expected: compile_reject
import "mem.zrl";
import "vec.zrl";
import "core.zrl";
use mem::Arena;
use vec::Vec;
use core::Option;

fn main() -> i32 {
    let mut a = Arena.new(65536 as u64).unwrap();
    let mut v = Vec::<u64>.new_in(&a);
    let mut i0 = 0 as u64;
    while i0 < 64 { v.push(7); i0 = i0 + 1; }
    let cond = v.len() > 0;
    let mut opt: Option<[u64]> = Option.None;
    if cond { opt = Option.Some(v.as_slice()); }
    a.reset();
    let mut z = Vec::<u64>.new_in(&a);
    let mut j = 0 as u64;
    while j < 64 { z.push(99); j = j + 1; }
    // opt.unwrap()[0] reads 99 instead of 7
    return opt.unwrap()[0] as i32;
}
