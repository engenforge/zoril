// name: A closure forwards a captured frame view to a callee that stores it through the closure's parameter
// expected: known_gap
// gap: cl(out) with cl = |o: &mut [i32]| { put(o, view); } and fn put(o: &mut [i32], v: [i32]) { *o = v; }: inside the closure the view is Env and o a parameter, so its body is clean, and the call through the closure value at cl(out) is not checked against what the environment holds; closed under --provenance by the unknown-call rule (Z-0048)
// observed: exit 77
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;
fn put(o: &mut [i32], view: [i32]) { *o = view; }
fn escape_storer(out: &mut [i32]) {
    let a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return; } };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    let view = v.as_slice();
    let mut cl = |o: &mut [i32]| { put(o, view); };
    cl(out);
}
fn main() -> i32 {
    let mut dest: [i32] = @slice(0 as *i32, 0);
    escape_storer(&mut dest);
    let a2 = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v2 = Vec::<i32>.new_in(&a2);
    v2.push(77);
    return dest[0];
}
