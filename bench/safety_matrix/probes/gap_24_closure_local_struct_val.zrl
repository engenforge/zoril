// name: Stack-capturing closure stored out via by-value struct
// expected: compile_reject
// Rejected by the interprocedural summary pass, which every build enforces and which reads what a call returns through its aggregate result and through the memory its arguments point at.
struct Carrier { v: fn() -> i32 }
fn extract_carrier_val(co: Carrier) -> fn() -> i32 { return co.v; }
fn default_fn() -> i32 { return 0; }
fn clobber_stack() -> i32 { let arr = [77; 16]; return arr[0]; }
fn escape_storer(out: &mut fn() -> i32) {
    let x = 42;
    let src_val = || -> i32 { return x; };
    let carrier_obj = Carrier { v: src_val };
    let carried = extract_carrier_val(carrier_obj);
    let routed = carried;
    *out = routed;
}
fn main() -> i32 {
    let mut dest_val: fn() -> i32 = default_fn;
    escape_storer(&mut dest_val);
    let _ = clobber_stack();
    return dest_val();
}
