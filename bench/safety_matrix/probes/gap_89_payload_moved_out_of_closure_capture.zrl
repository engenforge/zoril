// name: A closure moves an enum payload out of a value it captured, and the environment drops it again
// expected: known_gap
// gap: check_zir refuses a move out of a closure capture only when the whole capture alias is moved (check_place_use, projections.len == 0); a by-value pattern, a field or tuple projection, or ? on the capture moves a part out through a projection or an EnumPayload pointer temporary, which no rule ties to the capture, so the closure body drops the part and the captured value's owner drops it again
// observed: exit 77
struct S { p: *mut i32 }
impl Drop for S {
    fn drop(self: &mut S) {
        unsafe {
            if *self.p == 1 { *self.p = 77; }
            else { *self.p = *self.p + 1; }
        }
    }
}
enum Q { A(S), B }

fn main() -> i32 {
    let mut drops: i32 = 0;
    {
        let e = Q.A(S { p: &mut drops as *mut i32 });
        let f = || { match e { Q.A(s) => {}, Q.B => {} } };
        f();
    }
    return drops;
}
