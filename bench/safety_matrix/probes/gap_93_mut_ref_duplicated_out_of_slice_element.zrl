// name: A &mut is read twice out of a slice element, and a view taken through one copy is written after the other grows the Vec
// expected: known_gap
// gap: a by-value read of a slice element whose type is not Copy (here a `&mut Vec<i32>`) is accepted as a move although the slice still holds the value, so the same element can be read out again; the two `&mut` are live together, and a view taken through one is not ended by a push through the other, which reallocates the buffer the view points into
// observed: exit 77
import "vec.zrl";
use vec::Vec;

fn dup(a: [mut &mut Vec<i32>]) -> i32 {
    let r = a[0];
    let q = a[0];
    let view = r.as_mut_slice();
    let mut i = 0;
    while i < 64 {
        q.push(i);
        i = i + 1;
    }
    view[0] = 99;
    if q.as_slice()[0] == 41 { return 77; }
    return 0;
}

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(41);
    let mut a = [&mut v];
    let n = dup(&mut a);
    v.free();
    return n;
}
