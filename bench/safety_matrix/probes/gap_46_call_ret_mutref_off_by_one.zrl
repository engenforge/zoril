// name: Frame view stored through a &mut returned by a call, when that result is the last local
// expected: known_gap
// gap: storage_walk_zir and note_call_stores_zir index the 0-based locals with the 1-based Local.id, so when the call result dst is the last local the store through it (*dst = s) leaves stash's store summary empty and the escape is accepted; a dead `let _keep: &i32 = &n;` after dst makes the same program refused
// observed: exit 77
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;
struct Slot { out: &mut [i32], }
fn unwrap_slot(h: Slot) -> &mut [i32] { return h.out; }
fn stash(h: Slot, s: [i32]) {
    let dst = unwrap_slot(h);
    *dst = s;
}
fn f(out: &mut [i32]) {
    let a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return; } };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    stash(Slot { out: out }, v.as_slice());
}
fn main() -> i32 {
    let mut dest: [i32] = @slice(0 as *i32, 0);
    f(&mut dest);
    let a2 = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v2 = Vec::<i32>.new_in(&a2);
    v2.push(77);
    return dest[0];
}
