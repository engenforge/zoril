// name: `?` on an `Option` in a function returning a `Result`
// expected: compile_reject
// Refused by the lowering of `?`: `Result<i32, i32>` has no `None` variant. It used to return the `Option` whole, so its `None` reached the caller as an `Ok`.
import "core.zrl";
fn inner() -> Option<i32> { return Option.None; }
fn outer() -> Result<i32, i32> {
    let v = inner()?;
    return Result.Ok(v + 1);
}
fn main() -> i32 {
    return match outer() {
        Ok(_) => 7,
        Err(_) => 9,
    };
}
