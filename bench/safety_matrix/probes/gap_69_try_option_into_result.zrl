// name: `?` on an `Option` in a function returning a `Result`
// expected: known_gap
// gap: `e?` on an `Option<i32>` returned the `Option` whole from a function returning `Result<i32, i32>`, so its `None` reaches the caller as an `Ok` whose payload nothing wrote; the probe returns 7 for that `Ok`
// observed: exit 7
import "core.zrl";
fn inner() -> Option<i32> { return Option.None; }
fn outer() -> Result<i32, i32> {
    let v = inner()?;
    return Result.Ok(v + 1);
}
fn main() -> i32 {
    return match outer() {
        Ok(_) => 7,
        Err(_) => 9,
    };
}
