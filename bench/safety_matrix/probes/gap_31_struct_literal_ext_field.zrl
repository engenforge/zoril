// name: Arena inside struct literal beside external field treated as external
// expected: compile_reject
// Rejected by the interprocedural summary pass, which every build enforces and which reads what a call returns through its aggregate result and through the memory its arguments point at.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct Bundle { ext_tag: i32, a: Arena }

fn f(out: &mut [i32], tag: i32) {
    let a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return; } };
    let b = Bundle { ext_tag: tag, a: a };
    let mut v = Vec::<i32>.new_in(&b.a);
    v.push(42);
    *out = v.as_slice();
}

fn main() -> i32 {
    let mut s: [i32] = @slice(0 as *i32, 0);
    f(&mut s, 1);
    let a2 = match Arena.new(65536) { Result.Ok(a2) => a2, Result.Err(_) => { return 1; } };
    let mut v2 = Vec::<i32>.new_in(&a2);
    v2.push(77);
    return s[0];
}
