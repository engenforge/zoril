// name: A view of a closure's owned Vec stored through a captured &mut across calls is rejected
// expected: compile_reject
// Storing a view of an owned Vec through a captured &mut on one call and freeing on the next is rejected.
import "vec.zrl";
use vec::Vec;

fn main() -> i32 {
    let e: [i32] = @slice(0 as *i32, 0);
    let mut s = e;
    let out = &mut s;
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut f = |k: i32| {
        if k == 0 {
            *out = v.as_slice();
        } else {
            v.free();
        }
    };
    f(0);
    f(1);
    return s[0];
}
