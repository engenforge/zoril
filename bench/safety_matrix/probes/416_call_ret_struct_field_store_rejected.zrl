// name: Frame view stored through a field of a returned struct
// expected: compile_reject
// Storing a frame-owned view through a field of a returned struct (*d.out = s) is rejected.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct Slot {
    out: &mut [i32],
}

fn pass_slot(h: Slot) -> Slot {
    return h;
}

fn stash(h: Slot, s: [i32]) {
    let d = pass_slot(h);
    *d.out = s;
}

fn f(out: &mut [i32]) {
    let a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => {
            return;
        }
    };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    stash(Slot { out: out }, v.as_slice());
}

fn main() -> i32 {
    let mut dest: [i32] = @slice(0 as *i32, 0);
    f(&mut dest);
    let a2 = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => {
            return 1;
        }
    };
    let mut v2 = Vec::<i32>.new_in(&a2);
    v2.push(77);
    return dest[0];
}
