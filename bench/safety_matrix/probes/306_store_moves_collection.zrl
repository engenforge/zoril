// name: Storing a Vec into a struct field moves it out of the local
// expected: compile_reject
// `h.v = v;` transfers ownership of the buffer to `h`; reading or dropping `v` afterwards is a
// use after move.
import "vec.zrl";
use vec::Vec;

struct Holder {
    v: Vec<i32>,
}

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(7);
    let mut h = Holder { v: Vec::<i32>.new() };
    h.v = v;
    return v.len() as i32;
}
