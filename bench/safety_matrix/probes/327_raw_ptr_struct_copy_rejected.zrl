// name: A struct directly containing a raw pointer is not Copy by default
// expected: compile_reject
// Under Copy option A+, a struct directly containing a raw pointer field in its declaration
// is Move-only unless it explicitly declares `impl Copy for T {}`.
struct Buf {
    data: *mut u8,
    len: usize,
}

fn consume(b: Buf) -> usize {
    return b.len;
}

fn main() -> i32 {
    let b1 = Buf { data: 0 as *mut u8, len: 10 };
    let b2 = b1;
    let _ = consume(b1);
    return consume(b2) as i32;
}
