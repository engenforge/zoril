// name: Shared borrow passed as a mutable slice
// expected: compile_reject
// `&a` gives a `[T]`; only `&mut a` gives the `[mut T]` that f may write through, so a
// non-`mut` array, shared with r, cannot be changed under r.
fn f(s: [mut u8]) { s[0] = 9 as u8; }
fn main() -> i32 {
    let a: [u8; 3] = [1, 2, 3];
    let r = &a;
    f(&a);
    return r[0] as i32;
}
