// name: A cloned collection has its own buffer, yet the original cannot change while the clone lives
// expected: compile_reject
// A correct program refused while the analysis is imprecise (doc/vision/why_zoril.md, design
// principle 1): `clone()` allocates a new buffer, so the two values are independent owners, but
// the `&self` default ties the clone to `v1` itself rather than to what `v1` points into (its
// arena and its elements), so `v1.push(2)` conflicts with `v2`'s borrow. The tie is what refuses
// gap_77 (a clone of a Vec holding frame views, returned). It flips back to `accept` when a clone
// is tied only to what the original points into.
import "vec.zrl";
import "clone.zrl";
use vec::Vec;

fn main() -> i32 {
    let mut v1 = Vec::<u8>.new();
    v1.push(1);
    let mut v2 = v1.clone();
    v1.push(2);
    v2.push(3);
    if v1.len() != 2 { return 1; }
    if v2.len() != 2 { return 2; }
    return (*v1.get(1).unwrap() + *v2.get(1).unwrap()) as i32 - 5;
}
