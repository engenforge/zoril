// name: Method of an impl for one instance called on another
// expected: compile_reject
// `impl W<&i32>` has no methods for W<i64>. Methods were found by the type's name alone, so
// this read the integer 4096 as a reference and dereferenced it, in safe code.
struct W<T> { v: T }
impl W<&i32> { fn deref(self: &W<&i32>) -> i32 { return *self.v; } }
fn main() -> i32 {
    let w = W { v: 4096 as i64 };
    return w.deref();
}
