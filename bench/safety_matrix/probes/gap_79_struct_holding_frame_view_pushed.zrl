// name: A struct holding a view of this frame is pushed into the caller's Vec
// expected: compile_reject
// Refused by the provenance call store rule: the struct literal carries the frame view pushed into out.
import "vec.zrl";
use vec::Vec;
struct H { s: [u8] }
fn fill(out: &mut Vec<H>) {
    let buf = [42 as u8; 16];
    let s: [u8] = &buf;
    out.push(H { s: s });
}
fn clobber_stack() -> u8 { let arr = [77 as u8; 512]; return arr[0]; }
fn main() -> i32 {
    let mut v: Vec<H> = Vec.new();
    fill(&mut v);
    let c = clobber_stack();
    return v[0].s[0] as i32 + (c as i32) * 0;
}
