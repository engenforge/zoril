// name: Closure handed to a function that calls it stores a frame view through a captured &mut
// expected: known_gap
// gap: call_it(|| { *out = s; }) with fn call_it(g: fn()) { g(); } is accepted, with and without --provenance: inside call_it the call through g stores the environment into itself (parameter 0 into parameter 0), which call_it's store summary (from the old storage walk) does not record, so the caller never checks what the closure captured; Z-0010's summary from the origin sets is expected to close it
// observed: exit 77
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;
fn call_it(g: fn()) { g(); }
fn escape_storer(out: &mut [i32]) {
    let a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return; } };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    let s = v.as_slice();
    call_it(|| { *out = s; });
}
fn main() -> i32 {
    let mut dest: [i32] = @slice(0 as *i32, 0);
    escape_storer(&mut dest);
    let a2 = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v2 = Vec::<i32>.new_in(&a2);
    v2.push(77);
    return dest[0];
}
