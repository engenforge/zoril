// name: Use of a whole struct after one of its fields was moved out
// expected: compile_reject
struct D { a: Box<i32>, b: i32 }
fn take(x: Box<i32>) -> i32 { return *x; }
fn use_d(d: D) -> i32 { return d.b; }
fn main() -> i32 {
    let d = D { a: box 1, b: 2 };
    let n = take(d.a);
    return use_d(d) + n - 3;
}
