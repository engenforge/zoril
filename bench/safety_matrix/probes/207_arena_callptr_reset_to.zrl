// name: Function pointer call with &mut container skips post-mark epoch advance
// expected: compile_reject
import "mem.zrl";
import "vec.zrl";
import "core.zrl";
use mem::Arena;
use vec::Vec;
use core::Option;

fn grow_vec(w: &mut Vec<u64>) {
    let mut i = 0 as u64;
    while i < 64 { w.push(7); i = i + 1; }
}

fn main() -> i32 {
    let mut a = Arena.new(65536 as u64).unwrap();
    let mut v = Vec::<u64>.new_in(&a);
    let f: fn(&mut Vec<u64>) = grow_vec;
    let vm = &mut v;
    let m = a.mark();
    f(vm);
    a.reset_to(m);
    let mut z = Vec::<u64>.new_in(&a);
    let mut j = 0 as u64;
    while j < 64 { z.push(99); j = j + 1; }
    // v.as_slice()[0] reads 99 instead of 7
    return v.as_slice()[0] as i32;
}
