// name: Arena reset after a method writes a field through self
// expected: compile_reject
// Refused at a.reset(): holder three (§3.1) applies the method's store summary so the caller's struct holds v's release-tier borrow of a while w.s is read afterwards.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct W { s: [i32], t: i32, }

fn mk() -> W { return W { s: @slice(0 as *i32, 0), t: 0 }; }

impl W { fn set(self: &mut W, s: [i32]) { self.s = s; } }

fn main() -> i32 {
    let mut a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    let mut w = mk();
    w.set(v.as_slice());
    a.reset();
    let mut v2 = Vec::<i32>.new_in(&a);
    v2.push(77);
    return w.s[0];
}
