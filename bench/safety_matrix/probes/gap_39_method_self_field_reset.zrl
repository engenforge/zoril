// name: Arena reset after a method writes a field through self
// expected: known_gap
// gap: a value written into a local's field through self in a &mut self method is not recorded as a borrow the caller's struct holds: the write is through a pointer, which check_assign skips (place_writes_through_pointer), so the reset passes while the field is read afterwards
// observed: exit 77
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct W { s: [i32], t: i32, }

fn mk() -> W { return W { s: @slice(0 as *i32, 0), t: 0 }; }

impl W { fn set(self: &mut W, s: [i32]) { self.s = s; } }

fn main() -> i32 {
    let mut a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    let mut w = mk();
    w.set(v.as_slice());
    a.reset();
    let mut v2 = Vec::<i32>.new_in(&a);
    v2.push(77);
    return w.s[0];
}
