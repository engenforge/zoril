// name: Arena reset while field-assigned slice lives in local struct
// expected: compile_reject
// Rejected by ZirVerifier.check_assign, which records the borrows of a value written into a field, element or tuple slot of a local on that local, so the arena reset cannot pass while the field is read afterwards.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct W {
    s: [i32],
}

fn main() -> i32 {
    let mut a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => {
            return 1;
        }
    };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    let mut w = W { s: @slice(0 as *i32, 0) };
    w.s = v.as_slice();
    a.reset();
    let mut v2 = Vec::<i32>.new_in(&a);
    v2.push(77);
    return w.s[0];
}
