// name: A safe function copies a view of the caller's frame with memcpy through a raw pointer it was given, undeclared
// expected: known_gap
// gap: put passes s.p, a raw pointer to the caller's h.r, to memcpy, a bare extern with no declared effect, with &src as the source, and declares no #[stores(..)], so no summary records that r is stored: leak passes &local, h.r keeps a pointer into leak's dead frame, and main reads it; the default build and --provenance both accept it; the planned rule makes a safe function that passes a pointer from a parameter to a bare extern declare #[stores(..)]
// observed: exit 77
struct H { r: &i32 }
struct Slot { p: *mut &i32 }
static G: i32 = 7;
extern fn memcpy(d: *mut u8, s: *u8, n: u64) -> *mut u8;
fn slot_of(h: &mut H) -> Slot { return Slot { p: &mut h.r as *mut &i32 }; }
fn put(s: &Slot, r: &i32) {
    let src = r;
    unsafe { let _ = memcpy(s.p as *mut u8, &src as *&i32 as *u8, 8 as u64); }
}
fn leak(h: &mut H) { let local = 42; let s = slot_of(h); put(&s, &local); }
fn smash(n: i32) -> i32 { let junk = [77 as i32; 256]; if n > 0 { return smash(n - 1) + junk[3]; } return 0; }
fn main() -> i32 { let mut h = H { r: &G }; leak(&mut h); let _ = smash(8); return *h.r; }
