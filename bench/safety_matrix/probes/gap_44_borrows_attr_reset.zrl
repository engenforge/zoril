// name: Arena reset after a #[borrows()] method returns a view of its receiver
// expected: known_gap
// gap: a #[borrows()] method returning a slice its receiver holds (text_from returns self.source, a view of a Vec in arena a) gives a result that holds no borrow: a.reset() is accepted while the result is read afterwards; without the attribute the same program is refused at the reset (cannot mutably borrow 'a')
// observed: exit 77
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;
struct Lex { source: [u8], pos: usize }
impl Lex {
    #[borrows()]
    fn text_from(self: &Lex) -> [u8] { return self.source; }
}
fn main() -> i32 {
    let mut a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v = Vec::<u8>.new_in(&a);
    v.push(42 as u8);
    let lex = Lex { source: v.as_slice(), pos: 0 };
    let s = lex.text_from();
    a.reset();
    let mut v2 = Vec::<u8>.new_in(&a);
    v2.push(77 as u8);
    return s[0] as i32;
}
