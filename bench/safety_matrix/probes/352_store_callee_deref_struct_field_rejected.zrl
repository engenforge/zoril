// name: A frame-owned view stored from a struct field read through a reference parameter is rejected
// expected: compile_reject
// Storing a struct field slice read through a reference parameter into a parameter is rejected.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct Slot {
    s: [i32],
}

fn copy_slot(dst: &mut Slot, src: &Slot) {
    dst.s = src.s;
}

fn f(out: &mut Slot) {
    let a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => { return; }
    };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(7);
    let local = Slot { s: v.as_slice() };
    copy_slot(out, &local);
}

fn main() -> i32 {
    let e: [i32] = @slice(0 as *i32, 0);
    let mut out = Slot { s: e };
    f(&mut out);
    return out.s[0];
}
