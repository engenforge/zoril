// name: A generic function's instance named with type arguments and used as a value
// expected: accept
// Lowered as the instance's function address, as a non-generic function named as a value is, so the call reaches id::<i32> and returns 3; once, the initializer was dropped and the call jumped through an unwritten slot.
fn id<T>(x: T) -> T { return x; }
fn main() -> i32 {
    let f: fn(i32) -> i32 = id::<i32>;
    return f(3) - 3;
}
