// name: A raw pointer dereferenced after a generic identity (no unsafe)
// expected: compile_reject
// closed: the dereference check now decides from the IL type, which keeps `RawPtr`/`RawPtrMut`
// through a generic identity - so this program is a located type error instead of a silent hole.
fn id<T>(t: T) -> T { return t; }

fn main() -> i32 {
    let mut x: u32 = 7;
    let p: *mut u32 = &mut x as *mut u32;
    let q = id(p);
    *q = 9;
    if x != 9 { return 1; }
    return 0;
}
