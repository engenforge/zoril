// name: Sub-word arithmetic wraps to its declared width
// expected: accept
// `200 + 100` in u8 wraps to 44, and does so identically whether the result is
// still a temporary or has been stored into a declared u8. Those two disagreed
// until 2026-09-28: sub-word arithmetic ran in a 32-bit register and was never
// masked back down, so the temporary held 300. See surface_syntax.md 11.2.6.
fn main() -> i32 {
    let a: u8 = 200 as u8;
    let stored: u8 = a + 100 as u8;
    if stored != 44 as u8 { return 1; }
    if a + 100 as u8 != 44 as u8 { return 2; }
    if a + 100 as u8 != stored { return 3; }
    // every non-wrapping operator, at both signednesses
    if a *% 2 as u8 != a * 2 as u8 { return 4; }
    if a - 201 as u8 != 255 as u8 { return 5; }
    let b: u16 = 60000 as u16;
    if b + 10000 as u16 != 4464 as u16 { return 6; }
    let c: i8 = 127 as i8;
    if c + 1 as i8 != -128 as i8 { return 7; }
    // A bit shifted out of a u8 is gone (an in-range count; a count >= 8 traps, probe 19).
    let top: u8 = 128 as u8;
    let one_bit: u8 = 1 as u8;
    if top << one_bit != 0 as u8 { return 8; }
    return 0;
}
