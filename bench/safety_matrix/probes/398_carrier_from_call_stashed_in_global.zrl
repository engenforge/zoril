// name: A carrier built by a call and handed to a callee that stashes it in a global
// expected: compile_reject
// A by-value aggregate that a call returned holds the pointer the call was given, so passing it on
// carries a pointer to the frame's local out of the frame: the summary pass reads what the call's
// result carries (`returns`/`returns_via` bits) into the slot the call wrote.
struct Carrier { v: &i32 }
fn mk(r: &i32) -> Carrier { return Carrier { v: r }; }
static mut KEEP: usize = 0 as usize;
fn keep(c: Carrier) { KEEP = c.v as *i32 as usize; }
fn leak() { let x = 42; keep(mk(&x)); }
fn main() -> i32 { leak(); return 0; }
