// name: Raw pointer laundered through closure capture
// expected: compile_reject
// closed: the dereference, field access and index checks decide from the IL type, which
// keeps `RawPtr`/`RawPtrMut` through this route - so the program is a located type error.
fn main() -> i32 {
    let mut x: i32 = 42;
    let p = &mut x as *mut i32;
    let cl = || -> i32 { *p };
    let v = cl();
    if v == 42 { return 0; }
    return 1;
}
