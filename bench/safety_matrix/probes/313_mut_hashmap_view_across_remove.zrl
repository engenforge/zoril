// name: A view into a HashMap cannot outlive remove()
// expected: compile_reject
// A reference obtained from a HashMap keeps the map borrowed; removing an entry
// while holding a reference into the map is rejected at compile time.
import "mem.zrl";
import "hashmap.zrl";
use mem::Arena;
use hashmap::HashMap;

fn evil(m: &mut HashMap<i32, i32>) -> i32 {
    let k = 1;
    let r = m.get(&k).unwrap();
    m.remove(&k);
    return *r;
}

fn main() -> i32 {
    let mut a = Arena.new(65536).unwrap();
    let mut m = HashMap::<i32, i32>.new(&a);
    let k = 1;
    m.insert(k, 42);
    return evil(&mut m);
}
