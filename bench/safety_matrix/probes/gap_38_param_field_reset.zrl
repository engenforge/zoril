// name: Arena reset after a callee writes a field through a &mut parameter
// expected: compile_reject
// Refused at a.reset(): holder three (§3.1) applies the callee's store summary so the caller's struct holds v's release-tier borrow of a until w is dead.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct W { s: [i32], t: i32, }

fn mk() -> W { return W { s: @slice(0 as *i32, 0), t: 0 }; }

fn set_fn(w: &mut W, s: [i32]) { w.s = s; }

fn main() -> i32 {
    let mut a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    let mut w = mk();
    set_fn(&mut w, v.as_slice());
    a.reset();
    let mut v2 = Vec::<i32>.new_in(&a);
    v2.push(77);
    return w.s[0];
}
