// name: Callee storing a frame-owned view into a &mut destination returned by a helper is rejected
// expected: compile_reject
// Storing a frame-owned view by passing a helper-returned &mut destination to a stashing callee is rejected.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct H {
    s: [i32],
}

fn slot(h: &mut H) -> &mut [i32] {
    return &mut h.s;
}

fn fill(r: &mut [i32], s: [i32]) {
    *r = s;
}

fn f(h: &mut H) {
    let a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => { return; },
    };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(7);
    fill(slot(h), v.as_slice());
}

fn main() -> i32 {
    let e: [i32] = @slice(0 as *i32, 0);
    let mut h = H { s: e };
    f(&mut h);
    return 0;
}
