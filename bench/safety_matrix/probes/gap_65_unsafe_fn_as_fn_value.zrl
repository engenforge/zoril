// name: An unsafe fn made into a fn value is called from safe code with no unsafe block
// expected: compile_reject
// Rejected in lowering: making an unsafe fn into a value requires an unsafe block, the claim that every call through the value meets its precondition (Z-0095).
unsafe fn rd(p: *i32) -> i32 { return *p; }
fn call(f: fn(*i32) -> i32) -> i32 { return f(16 as *i32); }
fn main() -> i32 {
    let f: fn(*i32) -> i32 = rd;
    return call(f);
}
