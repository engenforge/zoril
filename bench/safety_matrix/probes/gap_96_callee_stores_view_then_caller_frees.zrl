// name: A callee stores a view of one argument into another; the caller then frees the first
// expected: compile_reject
// Refused at kill(&mut v): holder three (§3.1) records v's release-tier borrow on s from put's store summary, which conflicts with the releasing call kill(&mut v) while s is read afterwards.
import "vec.zrl";
use vec::Vec;

fn put(out: &mut [i32], v: &Vec<i32>) { *out = v.as_slice(); }

fn kill(v: &mut Vec<i32>) { v.free(); }

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut s: [i32] = @slice(0 as *i32, 0);
    put(&mut s, &v);
    kill(&mut v);
    let mut w = Vec::<i32>.new();
    w.push(77);
    return s[0];
}
