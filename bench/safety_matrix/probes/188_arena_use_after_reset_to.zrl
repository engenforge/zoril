// name: Arena memory used after the arena is reset to a mark
// expected: compile_reject
// A value allocated in an arena after a mark borrows the arena.
// Calling `a.reset_to(mark)` requires a mutable borrow of `a`, so attempting
// to use the value after `reset_to` is rejected at compile time.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn main() -> i32 {
    let mut a = match Arena.new(65536) {
        Ok(arena) => arena,
        Err(_) => { return 1; },
    };
    let m = a.mark();
    let mut v = Vec::<u64>.new_in(&a);
    v.push(42);
    a.reset_to(m); // rejected: `v` borrows `a`
    v.push(99);
    return 0;
}
