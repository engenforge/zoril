// name: Parameter view stored through a &mut returned by a call
// expected: accept
// The accepted twin of gap_46: storing a parameter view through a call-returned &mut is legal because parameter storage outlives this frame.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct Slot {
    out: &mut [i32],
}

fn unwrap_slot(h: Slot) -> &mut [i32] {
    return h.out;
}

fn stash(h: Slot, s: [i32]) {
    let dst = unwrap_slot(h);
    *dst = s;
}

fn f(out: &mut [i32], a: &Arena) {
    let mut v = Vec::<i32>.new_in(a);
    v.push(42);
    stash(Slot { out: out }, v.as_slice());
}

fn main() -> i32 {
    let a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => {
            return 1;
        }
    };
    let mut dest: [i32] = @slice(0 as *i32, 0);
    f(&mut dest, &a);
    if dest.len == 1 as usize && dest[0] == 42 {
        return 0;
    }
    return 1;
}
