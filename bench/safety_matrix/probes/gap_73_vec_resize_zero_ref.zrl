// name: Vec.resize pads with zero bytes, a null reference read from safe code
// expected: known_gap
// gap: Vec.resize (through ensure_len) fills new slots with zero bytes, which are not a value of every element type: a Vec<&i32> grown by resize holds a null reference, and reading through it faults; a T: Copy bound would not close it, &i32 is Copy (Z-0171; fixed by Z-0174)
// observed: runtime_fault
import "vec.zrl";
use vec::Vec;
fn main() -> i32 {
    let mut v = Vec::<&i32>.new();
    v.resize(1);
    let r: &i32 = *v.get(0).unwrap();
    return *r;
}
