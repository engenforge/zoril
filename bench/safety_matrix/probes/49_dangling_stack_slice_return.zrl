// name: Dangling stack ptr — slice of a local array returned
// expected: compile_reject
// A slice built over a local array is returned.
fn leak() -> [i32] {
    let mut a = [1, 2, 3];
    return @slice(&mut a[0], 3 as u64);
}
fn main() -> i32 { let s = leak(); if s.len != 3 as usize { return 1; } return 0; }
