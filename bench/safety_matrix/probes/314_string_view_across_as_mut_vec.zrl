// name: A view into a String cannot outlive mutation through as_mut_vec()
// expected: compile_reject
// A slice of a String keeps the String borrowed; calling as_mut_vec() to mutate
// the underlying buffer while the slice is live is rejected at compile time.
import "string.zrl";
use string::String;

fn evil(s: &mut String) -> u8 {
    let slice = s.as_slice();
    s.as_mut_vec().push(65 as u8);
    return slice[0];
}

fn main() -> i32 {
    let mut s = String.new();
    s.push_str("hello");
    return evil(&mut s) as i32;
}
