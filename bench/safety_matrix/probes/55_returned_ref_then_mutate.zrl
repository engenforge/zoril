// name: Mutation while a returned reference is live
// expected: compile_reject
// A reference returned by a method points into its receiver; mutating the receiver while it
// is live was accepted until 2026-10-02.
struct C { v: i32 }
impl C {
    fn get(self: &C) -> &i32 { return &self.v; }
    fn set(self: &mut C, x: i32) { self.v = x; }
}
fn main() -> i32 {
    let mut c = C { v: 1 };
    let r = c.get();
    c.set(2);
    if *r != 1 { return 1; }
    return 0;
}
