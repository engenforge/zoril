// name: A view of a parameter's Vec stored through another parameter outlives a free() in the callee
// expected: compile_reject
// Refused at v.free(): storing v.as_slice() through out gives v's release-tier borrow to the frame's outside holder (§3.1, holder two), which conflicts with the releasing call v.free().
import "vec.zrl";
use vec::Vec;

fn k2(out: &mut [i32], v: &mut Vec<i32>) { *out = v.as_slice(); v.free(); }

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut s: [i32] = @slice(0 as *i32, 0);
    k2(&mut s, &mut v);
    let mut w = Vec::<i32>.new();
    w.push(77);
    return s[0];
}
