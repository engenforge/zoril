// name: Dereference of a value that is not a pointer
// expected: compile_reject
// `**x` with `x: &i32` compiled in safe code until 2026-10-05, reading through the integer.
fn big(x: &i32) -> bool { return **x > 1; }
fn main() -> i32 {
    let a: i32 = 5;
    if big(&a) { return 1; }
    return 0;
}
