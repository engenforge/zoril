// name: A variant built from several arguments drops each argument once
// expected: accept
// The payload tuple owns each argument, as a tuple literal does, so P.A(a, b) drops a and b once each, with the enum; once, their drop flags stayed set and each was dropped twice (4 drops for 2 values).
struct S { p: *mut u8 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.p = *self.p + 1 as u8; } } }
enum P { A(S, S), B }
fn main() -> i32 {
    let mut flag = 0 as u8;
    let fp = &mut flag as *mut u8;
    {
        let a = S { p: fp };
        let b = S { p: fp };
        let e = P.A(a, b);
    }
    if flag == 2 as u8 { return 0; }
    return flag as i32;
}
