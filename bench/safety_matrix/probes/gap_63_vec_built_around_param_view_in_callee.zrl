// name: A callee builds a Vec around a view of a caller-local Vec's buffer and stores it into the caller's slot
// expected: compile_reject
// Refused by the provenance call store rule: leak_vec's summary records ParamContents(v) stored into out.
import "vec.zrl";
use vec::Vec;
fn leak_vec(out: &mut Vec<[i32]>, v: &Vec<i32>) {
    let mut tmp = Vec::<[i32]>.new();
    tmp.push(v.as_slice());
    *out = tmp;
}
fn f(out: &mut Vec<[i32]>) {
    let mut v = Vec::<i32>.new();
    v.push(42);
    leak_vec(out, &v);
}
fn main() -> i32 {
    let mut out: Vec<[i32]> = Vec.new();
    f(&mut out);
    return out[0][0];
}
