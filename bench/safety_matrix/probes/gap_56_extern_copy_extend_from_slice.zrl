// name: Vec.extend_from_slice copies a slice of frame views into the caller's Vec through memcpy, a store no summary records
// expected: known_gap
// gap: out.extend_from_slice(&views) with views = [s] and s a view of fill's stack array: extend_from_slice copies the elements with memcpy, a bare extern with no declared effect, and declares no #[stores], so neither the old rules nor --provenance see the elements of slice stored into self (Z-0060)
// observed: exit 77
import "vec.zrl";
use vec::Vec;
fn fill(out: &mut Vec<[u8]>) {
    let buf = [42 as u8; 16];
    let s: [u8] = &buf;
    let views = [s];
    out.extend_from_slice(&views);
}
fn clobber_stack() -> u8 { let arr = [77 as u8; 64]; return arr[0]; }
fn main() -> i32 {
    let mut v: Vec<[u8]> = Vec.new();
    fill(&mut v);
    let c = clobber_stack();
    return v[0][0] as i32 + (c as i32) * 0;
}
