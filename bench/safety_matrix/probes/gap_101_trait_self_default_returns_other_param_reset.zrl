// name: Arena reset after a trait impl's unannotated &self method returns its other parameter
// expected: known_gap
// gap: the trait form of gap_100: Pick.pick(self: &Self, x: [u8]) -> [u8] is implemented by a body returning x, and the &self default ties the result to self alone, so a.reset() is accepted while s.pick(v.as_slice()) is read, and the read sees the arena's next allocation; route class: an elision default narrower than the body's ties, on a trait method
// observed: exit 77
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;
trait Pick { fn pick(self: &Self, x: [u8]) -> [u8]; }
struct S { k: i32 }
impl Pick for S {
    fn pick(self: &S, x: [u8]) -> [u8] { return x; }
}
fn main() -> i32 {
    let mut a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v = Vec::<u8>.new_in(&a);
    v.push(42 as u8);
    let s = S { k: 1 };
    let r = s.pick(v.as_slice());
    a.reset();
    let mut v2 = Vec::<u8>.new_in(&a);
    v2.push(77 as u8);
    return r[0] as i32;
}
