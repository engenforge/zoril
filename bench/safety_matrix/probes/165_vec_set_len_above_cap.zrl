// name: Vec::set_len above the capacity
// expected: runtime_trap
// `set_len` is the one direct length setter, and it must not accept a length the allocation
// cannot hold: it traps (134) instead of handing out a forged length.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn main() -> i32 {
    let a = Arena.new(4096).unwrap();
    let mut v = Vec::<u64>.new_in(&a);
    v.push(1 as u64);
    unsafe { v.set_len(1 as usize << 40) };
    return 0;
}
