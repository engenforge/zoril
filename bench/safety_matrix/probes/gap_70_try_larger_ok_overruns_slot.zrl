// name: `?` on a `Result` larger than the function's return type writes past the return slot
// expected: known_gap
// gap: `e?` copied `e` whole into the caller's return slot, so a `Result<[i64; 8], i64>` propagated out of a function returning `Result<u8, i64>` writes 72 bytes into a 16-byte slot and overwrites the caller's frame; here the write faults
// observed: runtime_fault
import "core.zrl";
fn inner() -> Result<[i64; 8], i64> { return Result.Err(5 as i64); }
fn outer() -> Result<u8, i64> {
    let v = inner()?;
    return Result.Ok(v[0] as u8);
}
fn probe() -> i64 {
    let canary = [7 as i64; 8];
    let r = outer();
    let mut sum = 0 as i64;
    let mut i = 0 as usize;
    while i < 8 as usize { sum = sum + canary[i]; i = i + 1; }
    return match r { Ok(_) => 100 as i64, Err(e) => sum + e };
}
fn main() -> i32 {
    return if probe() == 61 as i64 { 0 } else { 1 };
}
