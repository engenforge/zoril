// name: A binding of a match on a reference to a local enum is returned
// expected: compile_reject
// Refused by the provenance return rule: matching through a reference binds the payload with the scrutinee's frame origin.
struct P { a: i32 }
enum E { A(P), B(i32) }
fn leak(n: i32) -> &P {
    let e = E.A(P { a: n });
    let r = &e;
    return match r { E.A(x) => x, E.B(_) => { return leak(n); } };
}
fn clobber_stack() -> i32 { let arr = [77; 64]; return arr[0]; }
fn main() -> i32 {
    let p = leak(42);
    let c = clobber_stack();
    return p.a + c * 0;
}
