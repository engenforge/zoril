// name: A frame-owned view stored through a callee function is rejected
// expected: compile_reject
// Storing a view of a frame-owned arena buffer through a callee function is rejected: callee summary tracks parameter slice stores.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn stash(out: &mut [i32], s: [i32]) {
    *out = s;
}

fn f(out: &mut [i32]) {
    let a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => { return; }
    };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(7);
    stash(out, v.as_slice());
}

fn main() -> i32 {
    let e: [i32] = @slice(0 as *i32, 0);
    let mut s = e;
    f(&mut s);
    return s[0];
}
