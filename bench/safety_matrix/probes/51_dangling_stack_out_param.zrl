// name: Dangling stack ptr — written through an out-parameter
// expected: compile_reject
// A local's address is written into the caller's memory through a parameter.
fn leak(out: &mut *mut i32) {
    let mut x: i32 = 42;
    *out = &mut x;
}
fn main() -> i32 {
    let mut p: *mut i32 = 0 as *mut i32;
    leak(&mut p);
    if p as usize == 0 as usize { return 1; }
    return 0;
}
