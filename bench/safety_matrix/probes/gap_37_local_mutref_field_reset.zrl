// name: Arena reset after a field write through a local &mut to the struct
// expected: compile_reject
// Refused at a.reset(): storing v.as_slice() through a local &mut to w gives v's borrow to w (§3.1, holder one), so w keeps a borrowed while w.s is still read after the reset.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct W { s: [i32], t: i32, }

fn mk() -> W { return W { s: @slice(0 as *i32, 0), t: 0 }; }

fn main() -> i32 {
    let mut a = match Arena.new(65536) { Result.Ok(a) => a, Result.Err(_) => { return 1; } };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(42);
    let mut w = mk();
    { let r = &mut w; r.s = v.as_slice(); }
    a.reset();
    let mut v2 = Vec::<i32>.new_in(&a);
    v2.push(77);
    return w.s[0];
}
