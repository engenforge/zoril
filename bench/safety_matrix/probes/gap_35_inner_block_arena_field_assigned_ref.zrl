// name: Inner block arena dropped while field-assigned reference lives in local struct
// expected: known_gap
// gap: ZirVerifier.check_assign drops RHS borrows when assigning to struct field of local, permitting inner-block arena drop while field reference is live
// observed: exit 77
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

struct W {
    r: &i32,
}

fn main() -> i32 {
    let seed = 0;
    let mut w = W { r: &seed };
    {
        let a = match Arena.new(65536) {
            Result.Ok(a) => a,
            Result.Err(_) => {
                return 1;
            }
        };
        let mut v = Vec::<i32>.new_in(&a);
        v.push(42);
        w.r = &v.as_slice()[0];
    }
    let a2 = match Arena.new(65536) {
        Result.Ok(a2) => a2,
        Result.Err(_) => {
            return 2;
        }
    };
    let mut v2 = Vec::<i32>.new_in(&a2);
    v2.push(77);
    return *w.r;
}
