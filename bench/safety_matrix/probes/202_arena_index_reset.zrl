// name: Arena reset while index reference into arena slice is live
// expected: compile_reject
import "mem.zrl";
import "vec.zrl";
import "core.zrl";
use mem::Arena;
use vec::Vec;
use core::Option;

fn main() -> i32 {
    let mut a = Arena.new(65536 as u64).unwrap();
    let mut v = Vec::<u64>.new_in(&a);
    let mut i0 = 0 as u64;
    while i0 < 64 { v.push(7); i0 = i0 + 1; }
    let s: [u64] = v.as_slice();
    let r: &u64 = &s[0];
    a.reset();
    let mut z = Vec::<u64>.new_in(&a);
    let mut j = 0 as u64;
    while j < 64 { z.push(99); j = j + 1; }
    // *r reads 99 instead of 7
    return *r as i32;
}
