// name: View of by-value collection parameter stored out
// expected: compile_reject
// Refused by the provenance store rule: a by-value owning parameter owns Frame(v) storage.
import "vec.zrl";
use vec::Vec;

fn store_view(out: &mut [i32], v: Vec<i32>) {
    *out = v.as_slice();
}

fn main() -> i32 {
    let mut s: [i32] = @slice(0 as *i32, 0);
    let mut v = Vec::<i32>.new();
    v.push(42);
    store_view(&mut s, v);
    return s[0];
}
