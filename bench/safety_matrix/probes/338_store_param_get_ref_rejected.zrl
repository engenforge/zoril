// name: A reference into a local arena buffer stored through an Option parameter outlives the buffer
// expected: compile_reject
// Storing an Option<&i32> derived from a frame-owned collection into a parameter outlives the frame.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn f(out: &mut Option<&i32>) {
    let a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => { return; }
    };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(7);
    *out = v.get(0);
}

fn main() -> i32 {
    let mut opt: Option<&i32> = Option.None;
    f(&mut opt);
    return 0;
}
