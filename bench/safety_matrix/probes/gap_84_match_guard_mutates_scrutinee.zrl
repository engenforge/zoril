// name: A match guard that assigns to the scrutinee is rejected
// expected: compile_reject
// EXPECT: cannot assign to the matched value in a match guard
// The arm's by-value bindings are made before the guard runs, so assigning to the scrutinee drops the payload those bindings still hold.
struct S { p: *mut u8 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.p = *self.p + 1 as u8; } } }
enum Q { A(S), B }
fn main() -> i32 {
    let mut flag = 0 as u8;
    let fp = &mut flag as *mut u8;
    {
        let mut e = Q.A(S { p: fp });
        match e { Q.A(s) if { e = Q.B; true } => { let n = 1; }, Q.A(_) => {}, Q.B => {}, }
    }
    if flag == 1 as u8 { return 0; }
    return 7;
}
