// name: A local Vec holding views of this frame is pushed into the caller's Vec
// expected: compile_reject
// Refused by the provenance call store rule: O(w) carries the frame views pushed into w.
import "vec.zrl";
use vec::Vec;
fn f(out: &mut Vec<Vec<[i32]>>) {
    let buf = [42; 16];
    let s: [i32] = &buf;
    let mut w = Vec::<[i32]>.new();
    w.push(s);
    out.push(w);
}
fn clobber_stack() -> i32 { let arr = [77; 256]; return arr[0]; }
fn main() -> i32 {
    let mut v: Vec<Vec<[i32]>> = Vec.new();
    f(&mut v);
    let c = clobber_stack();
    return v[0][0][0] + c * 0;
}
