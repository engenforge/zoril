// name: A local Vec holding views of this frame is pushed into the caller's Vec
// expected: known_gap
// gap: out.push(w) with w a local Vec<[i32]> holding a view of the stack array buf: the old rules see w as an owner moved out and not the frame views it holds, so the store into the caller's Vec<Vec<[i32]>> is accepted; refused under --provenance by the call store rule (Z-0062)
// observed: exit 77
import "vec.zrl";
use vec::Vec;
fn f(out: &mut Vec<Vec<[i32]>>) {
    let buf = [42; 16];
    let s: [i32] = &buf;
    let mut w = Vec::<[i32]>.new();
    w.push(s);
    out.push(w);
}
fn clobber_stack() -> i32 { let arr = [77; 256]; return arr[0]; }
fn main() -> i32 {
    let mut v: Vec<Vec<[i32]>> = Vec.new();
    f(&mut v);
    let c = clobber_stack();
    return v[0][0][0] + c * 0;
}
