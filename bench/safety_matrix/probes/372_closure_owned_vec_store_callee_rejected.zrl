// name: A view of a closure's owned Vec stored via a callee is rejected
// expected: compile_reject
// Storing a view of a closure's owned Vec through a callee helper into a captured &mut is rejected.
import "vec.zrl";
use vec::Vec;

#[stores(src -> dst)]
fn stash(dst: &mut [i32], src: [i32]) {
    *dst = src;
}

fn main() -> i32 {
    let e: [i32] = @slice(0 as *i32, 0);
    let mut s = e;
    let out = &mut s;
    let mut v = Vec::<i32>.new();
    v.push(42);
    let mut f = || {
        stash(&mut *out, v.as_slice());
    };
    f();
    return s[0];
}
