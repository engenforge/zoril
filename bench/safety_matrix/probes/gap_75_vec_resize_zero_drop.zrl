// name: Vec.resize pads with zero bytes, and set drops the zero value
// expected: known_gap
// gap: Vec.resize fills new slots with zero bytes, and set drops the slot's old value before writing: for a type whose safe Drop writes through a &mut field, the zero value's drop writes through null (Z-0171; fixed by Z-0174)
// observed: runtime_fault
import "vec.zrl";
use vec::Vec;
struct S { r: &mut i32 }
impl Drop for S { fn drop(self: &mut S) { *self.r = 1; } }
fn main() -> i32 {
    let mut n = 0;
    let mut v = Vec::<S>.new();
    v.resize(1);
    v.set(0, S { r: &mut n });
    return n;
}
