// name: A safe function stores a view of the caller's frame through a raw pointer, undeclared
// expected: known_gap
// gap: put's body stores r through the raw pointer s.p in an unsafe block and declares no #[stores(..)], so no summary records the store: leak passes &local, h.r keeps a pointer into leak's dead frame, and main reads it; the default build and --provenance both accept it; the planned rule makes a safe function that stores through a raw pointer declare #[stores(..)], which callers then obey
// observed: exit 77
struct H { r: &i32 }
struct Slot { p: *mut &i32 }
static G: i32 = 7;
fn slot_of(h: &mut H) -> Slot { return Slot { p: &mut h.r as *mut &i32 }; }
fn put(s: &Slot, r: &i32) { unsafe { *s.p = r; } }
fn leak(h: &mut H) { let local = 42; let s = slot_of(h); put(&s, &local); }
fn smash(n: i32) -> i32 { let junk = [77 as i32; 256]; if n > 0 { return smash(n - 1) + junk[3]; } return 0; }
fn main() -> i32 { let mut h = H { r: &G }; leak(&mut h); let _ = smash(8); return *h.r; }
