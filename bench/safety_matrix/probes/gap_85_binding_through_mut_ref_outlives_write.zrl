// name: A write through a &mut reference while a binding made through it is live is rejected
// expected: compile_reject
// EXPECT: cannot assign to 'e' because it is borrowed
// A binding made by matching through a &mut reference points into the referent, so the write would drop or replace what the binding still points at.
struct S { p: *mut u8 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.p = *self.p + 1 as u8; } } }
enum Q { A(S), B }
fn bump(s: &S) { unsafe { *s.p = *s.p + 10 as u8; } }
fn g(e: &mut Q, p2: *mut u8) {
    match e { Q.A(s) => { *e = Q.A(S { p: p2 }); bump(s); }, Q.B => {}, }
}
fn main() -> i32 {
    let mut first = 0 as u8;
    let mut second = 0 as u8;
    let fp = &mut first as *mut u8;
    let sp = &mut second as *mut u8;
    {
        let mut q = Q.A(S { p: fp });
        g(&mut q, sp);
        if first == 1 as u8 && second == 10 as u8 { return 77; }
    }
    return 0;
}
