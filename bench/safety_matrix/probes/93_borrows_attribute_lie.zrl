// name: #[borrows] claim contradicted by the function body
// expected: compile_reject
// #[borrows(b)] says the result points into b only; returning &a.v is the visible lie the
// compiler checks. (Results loaded through a parameter, the arena case, stay a trusted claim.)
struct T { v: i32 }
#[borrows(b)]
fn pick(a: &T, b: &T) -> &i32 { return &a.v; }
fn main() -> i32 { let x = T { v: 1 }; let y = T { v: 2 }; return *pick(&x, &y); }
