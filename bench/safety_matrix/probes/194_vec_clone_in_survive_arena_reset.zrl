// name: Vec::clone_in result tied to target Arena parameter
// expected: compile_reject
// Vec::clone_in returns a clone allocated in target Arena `a`. The returned Vec borrows
// `a` and cannot remain live across `a.reset()`.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn main() -> i32 {
    let mut a1 = Arena.new(4096 as u64).unwrap();
    let mut a2 = Arena.new(4096 as u64).unwrap();
    let mut v = Vec::<i32>.new_in(&a1);
    v.push(42);
    let v2 = v.clone_in(&a2);
    a2.reset();
    return v2.len() as i32;
}
