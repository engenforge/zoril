// name: A view of a closure's owned Vec stored through a captured struct &mut field is rejected
// expected: compile_reject
// A view of a closure's owned Vec cannot be stored through a struct field reached via a captured &mut.
import "vec.zrl";
use vec::Vec;

struct Holder {
    s: [i32],
}

fn main() -> i32 {
    let e: [i32] = @slice(0 as *i32, 0);
    let mut h = Holder { s: e };
    let hr = &mut h;
    let mut v = Vec::<i32>.new();
    v.push(5);
    let mut f = || {
        hr.s = v.as_slice();
        v.free();
    };
    f();
    return h.s[0];
}
