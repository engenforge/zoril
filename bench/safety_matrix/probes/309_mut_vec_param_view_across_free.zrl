// name: A view through a &mut Vec parameter cannot outlive a free()
// expected: compile_reject
// A view taken through a &mut Vec parameter keeps the reference borrowed; calling
// free() on the reference while the view is live is rejected at compile time.
import "vec.zrl";
use vec::Vec;

fn evil(v: &mut Vec<i32>) -> i32 {
    let r = v.get(0).unwrap();
    v.free();
    return *r;
}

fn main() -> i32 {
    let mut v = Vec::<i32>.new();
    v.push(42);
    return evil(&mut v);
}
