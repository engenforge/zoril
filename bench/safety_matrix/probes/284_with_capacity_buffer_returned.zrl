// name: A reference into a local Vec's with_capacity buffer returned from the frame
// expected: compile_reject
// `with_capacity` is not one of the constructors the old buffer-view list named; the rule is
// default-deny, so a local whose type owns storage cannot hand a reference into it out.
import "vec.zrl";
use vec::Vec;

fn view() -> &i32 {
    let mut v = Vec::<i32>.with_capacity(4);
    v.push(77);
    return v.get(0).unwrap();
}

fn main() -> i32 {
    return *view();
}
