// name: Raw pointer returned by function dereferenced outside unsafe
// expected: compile_reject
// A raw pointer returned by a function call retains its raw status; dereferencing it
// in safe code requires an unsafe block.
fn make_ptr() -> *mut i32 {
    return 0 as *mut i32;
}
fn main() -> i32 {
    let p = make_ptr();
    return *p;
}
