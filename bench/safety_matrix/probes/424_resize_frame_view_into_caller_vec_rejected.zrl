// name: Vec.resize fills the caller's Vec with a view of this frame
// expected: compile_reject
// resize stores clones of its value into self, and a clone of a view is the same view, so filling the caller's Vec<[u8]> with a view of a stack array is refused, as extend_from_slice's twin (418) is. resize's own summary records the store (extend_from_slice needs #[stores], resize does not: Z-0174).
import "vec.zrl";
use vec::Vec;
fn fill(out: &mut Vec<[u8]>) {
    let buf = [42 as u8; 16];
    let s: [u8] = &buf;
    out.resize(2, s);
}
fn main() -> i32 {
    let mut v: Vec<[u8]> = Vec.new();
    fill(&mut v);
    return 0;
}
