// name: A struct with a raw pointer in a tuple field is Copy when Copy is declared
// expected: accept
// Under Copy option A+, `impl Copy for Buf {}` opts back into Copy for a raw-pointer tuple struct.
struct Buf {
    p: (*mut u8, usize),
}

impl Copy for Buf {}

fn consume(b: Buf) -> usize {
    return b.p.1;
}

fn main() -> i32 {
    let b1 = Buf { p: (0 as *mut u8, 4) };
    let b2 = b1;
    if consume(b1) != 4 { return 1; }
    if consume(b2) != 4 { return 2; }
    return 0;
}
