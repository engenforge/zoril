// name: Unary minus on a reference is rejected
// expected: compile_reject
// `-r` converts a reference to a number implicitly; it is rejected with the other operator
// operand checks (check_unary_numeric_operand), so no address can be forged from it.
fn main() -> i32 {
    let mut x: u64 = 7;
    let r: &mut u64 = &mut x;
    let p = -r;
    *p = 9;
    return x as i32;
}
