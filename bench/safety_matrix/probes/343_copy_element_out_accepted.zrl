// name: An element copied out of a local arena buffer and pushed into a parameter is accepted
// expected: accept
// Dereferencing a reference to a Copy type copies the value; storing the copied value carries no borrow.
import "mem.zrl";
import "vec.zrl";
use mem::Arena;
use vec::Vec;

fn f(out: &mut Vec<i32>) {
    let a = match Arena.new(65536) {
        Result.Ok(a) => a,
        Result.Err(_) => { return; }
    };
    let mut v = Vec::<i32>.new_in(&a);
    v.push(77);
    out.push(*v.get(0).unwrap());
}

fn main() -> i32 {
    let mut out = Vec::<i32>.new();
    f(&mut out);
    if out.len() == 1 as usize && *out.get(0).unwrap() == 77 {
        return 0;
    }
    return 1;
}
