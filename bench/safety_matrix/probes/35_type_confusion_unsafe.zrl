// name: Type confusion via raw pointer cast (inside unsafe)
// expected: accept
// The escape hatch half of 27_type_confusion.zrl.
struct A { x: i64 }
struct B { y: *mut i64 }
fn main() -> i32 { let a = A { x: 4096 as i64 }; let p = (&a as *A) as *B; let q = unsafe { (*p).y }; if q as i64 == 0 as i64 { return 1; } return 0; }
