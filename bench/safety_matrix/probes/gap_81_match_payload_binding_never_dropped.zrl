// name: A value moved out of an enum by a by-value match is never dropped
// expected: known_gap
// gap: match e { E.A(s) => { .. }, E.B => {} } with S: Drop runs S's drop 0 times where 1 is due: the arm's bindings are dropped when its scope ends, after the arm's jump to the match exit, so the drops are lost, and every arm marks e moved, also one that binds nothing (E.B, _, E.A(_)); if let, a nested pattern, a struct or tuple payload, a temporary or by-value parameter scrutinee, and match x { y => .. } on a struct take the same route
// observed: exit 7
struct S { p: *mut u8 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.p = *self.p + 1 as u8; } } }
enum E { A(S), B }
fn main() -> i32 {
    let mut flag = 0 as u8;
    let fp = &mut flag as *mut u8;
    {
        let e = E.A(S { p: fp });
        match e { E.A(s) => { let n = 1; }, E.B => {}, }
    }
    if flag == 1 as u8 { return 0; }
    return 7;
}
