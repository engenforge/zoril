// A bytecode interpreter: enum instructions dispatched by match in a hot loop.
const SCALE: i64 = 30000000; // gate: 300000
enum Op { Push(i64), Add, Dup, Dec, JumpIfNonZero(usize), Pop, Halt }
fn run(code: [Op], n: i64) -> i64 {
    let mut stack: [i64; 64] = [0 as i64; 64];
    let mut sp = 0 as usize;
    let mut pc = 0 as usize;
    let mut acc = 0 as i64;
    stack[0] = n;
    sp = 1 as usize;
    while true {
        match code[pc] {
            Op.Push(v) => { stack[sp] = v; sp = sp + 1 as usize; pc = pc + 1 as usize; },
            Op.Add => { sp = sp - 1 as usize; stack[sp - 1 as usize] = stack[sp - 1 as usize] + stack[sp]; pc = pc + 1 as usize; },
            Op.Dup => { stack[sp] = stack[sp - 1 as usize]; sp = sp + 1 as usize; pc = pc + 1 as usize; },
            Op.Dec => { stack[sp - 1 as usize] = stack[sp - 1 as usize] - 1 as i64; pc = pc + 1 as usize; },
            Op.JumpIfNonZero(t) => { sp = sp - 1 as usize; if stack[sp] != 0 as i64 { pc = t; } else { pc = pc + 1 as usize; } },
            Op.Pop => { sp = sp - 1 as usize; acc = acc + stack[sp]; pc = pc + 1 as usize; },
            Op.Halt => { return acc + stack[0]; },
        }
    }
    return 0 as i64;
}
fn main() -> i32 {
    // loop: counter; dup; push 3; add; pop (acc += counter + 3); dec; dup; jnz loop
    let code: [Op; 8] = [Op.Dup, Op.Push(3 as i64), Op.Add, Op.Pop, Op.Dec, Op.Dup, Op.JumpIfNonZero(0 as usize), Op.Halt];
    let r = run(&code, SCALE);
    return (r % 251 as i64) as i32;
}
